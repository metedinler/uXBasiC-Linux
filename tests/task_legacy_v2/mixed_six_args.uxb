THREAD Mix(a AS I64, b AS F32, c AS F64, d AS I32, e AS F64, f AS F32) AS F64
    RETURN a + b + c + d + e + f
END THREAD
DIM t AS TASK OF F64 = SPAWN Mix(10, 1.25, 2.5, 20, 3.75, 4.5)
PRINT t.JOIN()
PRINT t.RESULT
THREAD Single(x AS F32) AS F32
    RETURN x + 0.25
END THREAD
DIM s AS TASK OF F32 = SPAWN Single(1.5)
PRINT s.JOIN()
PRINT s.RESULT
