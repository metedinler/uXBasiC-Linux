    ASSERT Near(uxraylib.MatrixElement(a, 5), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), -0.64421767) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), 0.764842212) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixRotateXYZ(0.1, 0.2, 0.3)
    ASSERT Near(uxraylib.MatrixElement(a, 0), 0.936293423) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 1), -0.289629489) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 2), 0.198669329) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 3), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 4), 0.312991828) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 5), 0.944702566) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), -0.0978434011) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), -0.159345075) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0.153792009) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), 0.975170374) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixRotateZYX(0.1, 0.2, 0.3)
    ASSERT Near(uxraylib.MatrixElement(a, 0), 0.936293423) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 1), -0.27509585) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 2), 0.218350679) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 3), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 4), 0.289629489) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 5), 0.95642513) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), -0.0369570181) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), -0.198669329) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0.0978434011) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), 0.975170374) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixTranslate(1, 2, 3)
    b = uxraylib.MatrixScale(2, 3, 4)
    c = uxraylib.MatrixMultiply(a, b)
    ASSERT Near(uxraylib.MatrixElement(c, 0), 2) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 3), 2) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 5), 3) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 7), 6) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 10), 4) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 11), 12) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(b)
    uxraylib.MatrixRelease(c)
    a = uxraylib.MatrixTranslate(1, 2, 3)
    b = uxraylib.MatrixScale(2, 3, 4)
    c = uxraylib.MatrixAdd(a, b)
    ASSERT Near(uxraylib.MatrixElement(c, 0), 3) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 3), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 5), 4) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 7), 2) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 10), 5) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 11), 3) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 15), 2) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(b)
    uxraylib.MatrixRelease(c)
    a = uxraylib.MatrixTranslate(1, 2, 3)
    b = uxraylib.MatrixScale(2, 3, 4)
    c = uxraylib.MatrixSubtract(a, b)
    ASSERT Near(uxraylib.MatrixElement(c, 0), -1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 3), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 5), -2) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 7), 2) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 10), -3) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 11), 3) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 15), 0) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(b)
    uxraylib.MatrixRelease(c)
    a = uxraylib.MatrixTranslate(1, 2, 3)
    c = uxraylib.MatrixInvert(a)
    ASSERT Near(uxraylib.MatrixElement(c, 0), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 3), -1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 5), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 7), -2) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 10), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 11), -3) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(c)
    a = uxraylib.MatrixRotateY(0.5)
    c = uxraylib.MatrixTranspose(a)
    ASSERT Near(uxraylib.MatrixElement(c, 0), 0.87758255) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 2), -0.47942555) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 3), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 5), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 8), 0.47942555) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 10), 0.87758255) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 11), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(c, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(c)
    a = uxraylib.MatrixLookAt(0, 2, 5, 0, 0, 0, 0, 1, 0)
    ASSERT Near(uxraylib.MatrixElement(a, 0), 0.99999994) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 3), -0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 5), 0.928476632) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), -0.371390641) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), -1.1920929e-07) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0.371390671) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), 0.928476691) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), -5.38516474) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixPerspective(1.0471976, 1.5, 0.1, 100)
    ASSERT Near(uxraylib.MatrixElement(a, 0), 1.15470052) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 3), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 5), 1.73205078) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), -1.002002) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), -0.2002002) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), -1) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 0) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixOrtho(-4, 4, -3, 3, 0.1, 50)
    ASSERT Near(uxraylib.MatrixElement(a, 0), 0.25) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 3), -0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 5), 0.333333343) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), -0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), -0.0400801599) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), -1.00400794) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 1) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixFrustum(-1, 1, -0.75, 0.75, 0.5, 20)
    ASSERT Near(uxraylib.MatrixElement(a, 0), 0.5) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 1), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 3), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 4), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 5), 0.666666687) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 10), -1.05128205) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 11), -1.02564108) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 14), -1) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 15), 0) = 1
    uxraylib.MatrixRelease(a)
    q = uxraylib.QuaternionToMatrix(0, 0, 0.70710678, 0.70710678)
    ASSERT Near(uxraylib.MatrixElement(q, 0), 5.96046448e-08) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 1), -0.99999994) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 2), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 3), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 4), 0.99999994) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 5), 5.96046448e-08) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 6), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 7), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 8), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 9), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 10), 1) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 11), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 12), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 13), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 14), 0) = 1
    ASSERT Near(uxraylib.MatrixElement(q, 15), 1) = 1
    uxraylib.MatrixRelease(q)
    ' --- matris -> skaler
    a = uxraylib.MatrixScale(2, 3, 4)
    ASSERT Near(uxraylib.MatrixDeterminant(a), 24) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixScale(2, 3, 4)
    ASSERT Near(uxraylib.MatrixTrace(a), 10) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixRotateXYZ(0.1, 0.2, 0.3)
    ASSERT Near(uxraylib.MatrixDeterminant(a), 1.00000012) = 1
    uxraylib.MatrixRelease(a)
    ' --- matris -> vektor
    a = uxraylib.MatrixTranslate(1, 2, 3)
    uxraylib.Vector3Transform(1, 1, 1, a)
    ASSERT Near(uxraylib.ResX(), 2) = 1
    ASSERT Near(uxraylib.ResY(), 3) = 1
    ASSERT Near(uxraylib.ResZ(), 4) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixRotateZ(1.5707963)
    uxraylib.Vector3Transform(1, 0, 0, a)
    ASSERT Near(uxraylib.ResX(), 7.54979013e-08) = 1
    ASSERT Near(uxraylib.ResY(), 1) = 1
    ASSERT Near(uxraylib.ResZ(), 0) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixScale(2, 3, 4)
    uxraylib.Vector2Transform(1, 1, a)
    ASSERT Near(uxraylib.ResX(), 2) = 1
    ASSERT Near(uxraylib.ResY(), 3) = 1
    uxraylib.MatrixRelease(a)
    a = uxraylib.MatrixRotateY(0.4)
    uxraylib.QuaternionTransform(0, 0, 0, 1, a)
    ASSERT Near(uxraylib.ResX(), 0) = 1
    ASSERT Near(uxraylib.ResY(), 0) = 1
    ASSERT Near(uxraylib.ResZ(), 0) = 1
    ASSERT Near(uxraylib.ResW(), 1) = 1
    uxraylib.MatrixRelease(a)
    p = uxraylib.MatrixPerspective(1.0471976, 1.5, 0.1, 100)
    v = uxraylib.MatrixLookAt(0, 2, 5, 0, 0, 0, 0, 1, 0)
    uxraylib.Vector3Unproject(0.1, -0.2, 0.5, p, v)
    ASSERT Near(uxraylib.ResX(), 0.0345373936) = 1
    ASSERT Near(uxraylib.ResY(), 1.80913246) = 1
    ASSERT Near(uxraylib.ResZ(), 4.64682388) = 1
    uxraylib.MatrixRelease(p)
    uxraylib.MatrixRelease(v)
    a = uxraylib.MatrixRotateXYZ(0.3, 0.4, 0.5)
    u = uxraylib.MatrixCopy(a)
    b = uxraylib.MatrixTranslate(0, 0, 0)
    uxraylib.Vector3Transform(1, 2, 3, u)
    ASSERT Near(uxraylib.ResX(), 1.09340167) = 1
    ASSERT Near(uxraylib.ResY(), 1.3088572) = 1
    ASSERT Near(uxraylib.ResZ(), 3.33037019) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(b)
    uxraylib.MatrixRelease(u)

    ' --- yardimci islevler: yuvalar, birden cok sonuc, cikis parametreli islevler
    uxraylib.Vector3OrthoNormalize(3, 0, 0, 1, 2, 0)
    ASSERT Near(uxraylib.ResGet(0, 0), 1.0) = 1
    ASSERT Near(uxraylib.ResGet(0, 1), 0.0) = 1
    ASSERT Near(uxraylib.ResGet(1, 0), 0.0) = 1
    ASSERT Near(uxraylib.ResGet(1, 1), 1.0) = 1
    uxraylib.VectorSlotSet(0, 0.0, 0.0, 0.0, 0.0)
    uxraylib.VectorSlotSet(1, 1.0, 0.0, 0.0, 0.0)
    uxraylib.VectorSlotSet(2, 4.0, 0.0, 0.0, 0.0)
    uxraylib.VectorSlotSet(3, 1.0, 0.0, 0.0, 0.0)
    uxraylib.Vector3CubicHermiteSlots(0, 1, 2, 3, 0.5)
    ASSERT Near(uxraylib.ResX(), 2.0) = 1
    ASSERT Near(uxraylib.ResY(), 0.0) = 1
    uxraylib.VectorSlotSet(4, 1.0, 1.0, 0.0, 0.0)
    uxraylib.VectorSlotSet(5, 0.0, 0.0, 0.0, 0.0)
    uxraylib.VectorSlotSet(6, 4.0, 0.0, 0.0, 0.0)
    uxraylib.VectorSlotSet(7, 0.0, 4.0, 0.0, 0.0)
    uxraylib.Vector3BarycenterSlots(4, 5, 6, 7)
    ASSERT Near(uxraylib.ResX(), 0.5) = 1
    ASSERT Near(uxraylib.ResY(), 0.25) = 1
    ASSERT Near(uxraylib.ResZ(), 0.25) = 1
    DIM angle AS F64
    angle = uxraylib.QuaternionToAxisAngle(0, 0, 0.70710678, 0.70710678)
    ASSERT Near(angle, 1.5707963) = 1
    ASSERT Near(uxraylib.ResZ(), 1.0) = 1
    a = uxraylib.MatrixScale(2, 3, 4)
    b = uxraylib.MatrixTranslate(5, 6, 7)
    c = uxraylib.MatrixMultiply(a, b)
    uxraylib.MatrixDecompose(c)
    ASSERT Near(uxraylib.ResGet(0, 0), 5.0) = 1
    ASSERT Near(uxraylib.ResGet(0, 1), 6.0) = 1
    ASSERT Near(uxraylib.ResGet(0, 2), 7.0) = 1
    ASSERT Near(uxraylib.ResGet(2, 0), 2.0) = 1
    ASSERT Near(uxraylib.ResGet(2, 1), 3.0) = 1
    ASSERT Near(uxraylib.ResGet(2, 2), 4.0) = 1
    ASSERT Near(uxraylib.ResGet(1, 3), 1.0) = 1
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(b)
    uxraylib.MatrixRelease(c)
    ' --- tutamac yasam dongusu ve hata bildirimi
    ASSERT uxraylib.MatrixLiveCount() = 0
    a = uxraylib.MatrixIdentity()
    ASSERT a <> 0
    ASSERT uxraylib.MatrixLiveCount() = 1
    b = uxraylib.MatrixCopy(a)
    ASSERT b <> a
    ASSERT uxraylib.MatrixSetElement(b, 12, 9.5) = 1
    ASSERT Near(uxraylib.MatrixElement(b, 12), 9.5) = 1
    ASSERT Near(uxraylib.MatrixElement(a, 12), 0.0) = 1
    ASSERT Near(uxraylib.MatrixAt(a, 3, 3), 1.0) = 1
    ASSERT Near(uxraylib.MatrixAt(b, 0, 3), 9.5) = 1
    uxraylib.MathClearError()
    ASSERT uxraylib.MathLastError() = 0
    ASSERT Near(uxraylib.MatrixElement(999, 0), 1.0) = 1
    ASSERT uxraylib.MathLastError() = 1
    uxraylib.MathClearError()
    uxraylib.MatrixRelease(a)
    uxraylib.MatrixRelease(b)
    uxraylib.MatrixRelease(b)
    ASSERT uxraylib.MatrixLiveCount() = 0
    PRINT "RAYMATH_PASS"
END MAIN
