' ADIM30 POSITIVE 01 — core syntax / arithmetic / control flow / functions
DIM A AS I32
DIM B AS I32
DIM I AS I32
A = 10
B = 20
PRINT "CORE-BEGIN"
PRINT A + B
IF B > A THEN
    PRINT "B-GT-A"
ELSE
    PRINT "BAD"
END IF
FOR I = 1 TO 3
    PRINT I
NEXT
FUNCTION ADD2(X AS I32, Y AS I32) AS I32
    RETURN X + Y
END FUNCTION
PRINT ADD2(A, B)
PRINT "CORE-END"
