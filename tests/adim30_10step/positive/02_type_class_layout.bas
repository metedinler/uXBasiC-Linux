' ADIM30 POSITIVE 02 — TYPE / CLASS / layout / method surface
TYPE VEC2
    X AS F64
    Y AS F64
END TYPE

CLASS COUNTER
PUBLIC:
    VALUE AS I32
    FUNCTION INC(BY AS I32) AS I32
        VALUE = VALUE + BY
        RETURN VALUE
    END FUNCTION
END CLASS

DIM V AS VEC2
V.X = 1.5
V.Y = 2.5
PRINT "TYPE-CLASS"
PRINT V.X + V.Y
