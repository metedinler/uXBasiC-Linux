EVENT OnTick
    PRINT "EVENT TICK"
END EVENT

THREAD Worker
    PRINT "THREAD WORKER"
END THREAD

PIPE DataPipe
    PRINT "PIPE DATA"
END PIPE

PARALEL Job
    PRINT "PARALEL JOB"
END PARALEL

SLOT EVENT <U8 1>
SLOT THREAD <U8 1>
SLOT PIPE <U8 1>
SLOT PARALEL <U8 1>

ON THREAD Worker SLOT <U8 1>
TRIGGER EVENT OnTick
OFF THREAD Worker SLOT <U8 1>

PRINT "EVENT_PIPE_MEMORY_OK"
