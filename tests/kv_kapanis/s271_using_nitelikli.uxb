' S-271: nitelikli cagri belirsiz degildir.
NAMESPACE A
    FUNCTION Topla(x AS I32, y AS I32) AS I32
        RETURN x + y
    END FUNCTION
END NAMESPACE
NAMESPACE B
    FUNCTION Topla(x AS I32, y AS I32) AS I32
        RETURN x * y
    END FUNCTION
END NAMESPACE
USING A
USING B
PRINT A.Topla(3, 4)
PRINT B.Topla(3, 4)
