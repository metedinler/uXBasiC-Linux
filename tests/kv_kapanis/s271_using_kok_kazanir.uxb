' S-271: kok duzeyi gercek islev USING'ten gelenlerle belirsiz sayilmaz, onlari golgeler.
FUNCTION Topla(x AS I32, y AS I32) AS I32
    RETURN 100
END FUNCTION
NAMESPACE A
    FUNCTION Topla(x AS I32, y AS I32) AS I32
        RETURN x + y
    END FUNCTION
END NAMESPACE
NAMESPACE B
    FUNCTION Topla(x AS I32, y AS I32) AS I32
        RETURN x * y
    END FUNCTION
END NAMESPACE
USING A
USING B
PRINT Topla(3, 4)
