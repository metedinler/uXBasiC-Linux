' S-271: cakisma calismayan dalda da derleme hatasidir.
NAMESPACE A
    FUNCTION Topla(x AS I32, y AS I32) AS I32
        RETURN x + y
    END FUNCTION
END NAMESPACE
NAMESPACE B
    FUNCTION Topla(x AS I32, y AS I32) AS I32
        RETURN x * y
    END FUNCTION
END NAMESPACE
USING A
USING B
IF 0 THEN
    PRINT Topla(3, 4)
END IF
PRINT "ok"
