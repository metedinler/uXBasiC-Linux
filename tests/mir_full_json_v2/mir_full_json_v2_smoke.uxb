CLASS AgirlikPuani
PUBLIC
    METHOD Hesapla(BYVAL agirlik AS I32) AS I32
        RETURN agirlik * 4
    END METHOD
END CLASS

FUNCTION BasamakToplami(BYVAL deger AS I32) AS I32
    IF deger < 10 THEN
        RETURN deger
    END IF
    RETURN (deger MOD 10) + BasamakToplami(deger \ 10)
END FUNCTION

MAIN
    DIM puanlayici AS AgirlikPuani
    DIM puan AS I32
    DIM toplam AS I32

    puanlayici = NEW AgirlikPuani()
    puan = puanlayici.Hesapla(9)
    toplam = BasamakToplami(7308)

    ASSERT puan = 36
    ASSERT toplam = 18
    PRINT "MIR_FULL_JSON_V2_PASS"
END MAIN
