CLASS Cell
 PUBLIC
 value AS I32
END CLASS
DIM a(0 TO 1, 0 TO 1) AS Cell
a(1,1) = NEW Cell()
a(1,1).value = 7
FUNCTION LocalValue(n AS I32) AS I32
 DIM a(-1 TO n, 2 TO 2) AS Cell
 a(-1,2) = NEW Cell()
 a(-1,2).value = 33
 REDIM PRESERVE a(-2 TO n+1, 1 TO 3) AS Cell
 RETURN a(-1,2).value
END FUNCTION
PRINT LocalValue(2)
PRINT a(1,1).value
PRINT SIZEOF(a)
