CLASS Cell
 PUBLIC
 value AS I32
END CLASS
FUNCTION Grow(items AS Cell[]) AS I32
 REDIM PRESERVE items(-1 TO 2, 1 TO 3) AS Cell
 items(-1,1) = NEW Cell()
 items(-1,1).value = 47
 RETURN items(0,2).value
END FUNCTION
DIM n AS I32 = 1
DIM a(0 TO n, 2 TO 2) AS Cell
a(0,2) = NEW Cell()
a(0,2).value = 8
PRINT Grow(a)
PRINT a(-1,1).value
PRINT a(0,2).value
PRINT SIZEOF(a)
