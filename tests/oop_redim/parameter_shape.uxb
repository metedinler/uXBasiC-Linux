CLASS Cell
 PUBLIC
 value AS I32
END CLASS
FUNCTION ReadCell(items AS Cell[]) AS I32
 PRINT LBOUND(items,1)
 PRINT UBOUND(items,2)
 PRINT SIZEOF(items)
 RETURN items(1,2).value
END FUNCTION
DIM n AS I32 = 1
DIM a(0 TO n, 2 TO 2) AS Cell
a(1,2) = NEW Cell()
a(1,2).value = 8
PRINT ReadCell(a)
REDIM PRESERVE a(-1 TO 2, 1 TO 3) AS Cell
PRINT ReadCell(a)
