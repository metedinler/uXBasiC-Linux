DIM calls AS I32 = 0
FUNCTION NextByte() AS I32
 calls = calls + 1
 RETURN 255
END FUNCTION
FUNCTION Signed8(n AS I8) AS I32
 RETURN n
END FUNCTION
FUNCTION Unsigned8(n AS U8) AS I32
 RETURN n
END FUNCTION
FUNCTION Signed16(n AS I16) AS I32
 RETURN n
END FUNCTION
FUNCTION Unsigned16(n AS U16) AS I32
 RETURN n
END FUNCTION
PRINT Signed8(NextByte())
PRINT calls
PRINT Unsigned8(257)
PRINT Signed16(65535)
PRINT Unsigned16(65537)
