DIM sharedText AS STRING = "old"
DIM calls AS I32 = 0
FUNCTION ChangeText() AS I32
    calls += 1
    sharedText = "AB" + CHR(0) + "CD"
    RETURN 7
END FUNCTION
FUNCTION CheckText(value AS STRING, lengthValue AS I32, marker AS I32) AS I32
    PRINT LEN(value)
    PRINT ASC(MID(value, 3, 1))
    PRINT lengthValue
    RETURN marker
END FUNCTION
THREAD Worker() AS I32
    RETURN CheckText(sharedText + "!", LEN(sharedText), ChangeText())
END THREAD
DIM work AS TASK OF I32 = SPAWN Worker()
PRINT work.JOIN()
PRINT calls
