DIM sharedText AS STRING = "AB" + CHR(0) + "CD"
THREAD Writer() AS I32
    DIM i AS I32
    FOR i = 1 TO 200
        sharedText += "x"
    NEXT
    RETURN 200
END THREAD
DIM first AS TASK OF I32 = SPAWN Writer()
DIM second AS TASK OF I32 = SPAWN Writer()
PRINT first.JOIN()
PRINT second.JOIN()
PRINT LEN(sharedText)
PRINT ASC(MID(sharedText, 3, 1))
