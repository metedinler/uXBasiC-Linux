DIM sharedValue AS I32 = 1
FUNCTION MakeText() AS STRING
    RETURN "AB" + CHR(0) + "CD"
END FUNCTION
FUNCTION Churn() AS I32
    DIM scratch AS STRING
    DIM i AS I32
    FOR i = 1 TO 128
        scratch = STR(i) + "-temporary"
    NEXT
    sharedValue = 9
    RETURN 128
END FUNCTION
FUNCTION CheckText(value AS STRING, count AS I32, marker AS I32) AS I32
    PRINT LEN(value)
    PRINT ASC(MID(value, 3, 1))
    PRINT count
    RETURN marker
END FUNCTION
THREAD Worker() AS I32
    RETURN CheckText(MakeText(), Churn(), sharedValue)
END THREAD
DIM work AS TASK OF I32 = SPAWN Worker()
PRINT work.JOIN()
