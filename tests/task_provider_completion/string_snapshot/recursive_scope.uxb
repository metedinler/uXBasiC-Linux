DIM sharedText AS STRING = "old"
DIM calls AS I32 = 0
FUNCTION ChangeText() AS I32
    calls += 1
    sharedText = "AB" + CHR(0) + "CD"
    RETURN 7
END FUNCTION
FUNCTION ReadText(value AS STRING, marker AS I32) AS I32
    PRINT LEN(value)
    PRINT ASC(MID(value, 3, 1))
    RETURN marker
END FUNCTION
FUNCTION Recursive(depth AS I32) AS I32
    IF depth = 0 THEN RETURN ChangeText()
    RETURN ReadText(sharedText, Recursive(depth - 1))
END FUNCTION
THREAD Worker() AS I32
    RETURN Recursive(3)
END THREAD
DIM work AS TASK OF I32 = SPAWN Worker()
PRINT work.JOIN()
PRINT calls
