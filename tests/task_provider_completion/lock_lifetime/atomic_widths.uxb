DIM ATOMIC a AS I8 = 127
DIM ATOMIC b AS U8 = 255
DIM ATOMIC c AS I16 = 32767
DIM ATOMIC d AS U16 = 65535
DIM ATOMIC e AS I32 = 2147483647
DIM ATOMIC f AS U32 = 4294967295
DIM ATOMIC g AS I64 = 40
DIM ATOMIC h AS U64 = 40
PRINT a.ADD(1)
PRINT b.ADD(1)
PRINT c.ADD(1)
PRINT d.ADD(1)
PRINT e.ADD(1)
PRINT f.ADD(1)
PRINT g.ADD(2)
PRINT h.ADD(2)
PRINT a.EXCHANGE(127)
PRINT a.CAS(127, 128)
PRINT a.LOAD()
