DIM metin AS STRING = "old"
DIM calls AS I32 = 0
THREAD Touch() AS I32
    RETURN LEN(metin) + calls
END THREAD
FUNCTION Change() AS STRING
    calls += 1
    metin = "new"
    RETURN "!"
END FUNCTION
DIM t AS TASK OF I32 = SPAWN Touch()
DIM joined AS I32 = t.JOIN()
IF -1 ANDALSO metin + Change() = "new!" THEN PRINT "and branch"
metin = "old"
IF 0 ORELSE metin + Change() = "new!" THEN PRINT "or branch"
metin = "old"
PRINT -1 ? metin + Change() : "wrong"
metin = "old"
PRINT 0 ? "wrong" : metin + Change()
PRINT calls
