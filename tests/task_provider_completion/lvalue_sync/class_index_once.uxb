CLASS Box
    PUBLIC
    n AS I32
    f AS F64
END CLASS
DIM a(0 TO 1) AS Box
a(0) = NEW Box()
a(0).n = 10
a(0).f = 0.25
DIM calls AS I32 = 0
FUNCTION NextIndex() AS I32
    calls += 1
    RETURN 0
END FUNCTION
DIM old AS I32 = a(NextIndex()).n++
PRINT old
PRINT a(0).n
PRINT calls
DIM f AS F64 = ++a(NextIndex()).f
PRINT f
PRINT calls
a(NextIndex()).n--
PRINT a(0).n
PRINT calls
