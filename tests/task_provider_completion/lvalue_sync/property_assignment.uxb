CLASS Box
    PUBLIC
    backing AS F64
    readCount AS I32
    writeCount AS I32
    PROPERTY Amount AS F64
        GET
            THIS.readCount += 1
            RETURN THIS.backing
        END GET
        SET
            THIS.writeCount += 1
            THIS.backing = VALUE
        END SET
END CLASS
DIM b AS Box = NEW Box()
b.Amount = 0.5
PRINT b.Amount
PRINT b.writeCount
b.Amount = b.Amount + 1.0
PRINT b.backing
PRINT b.readCount
PRINT b.writeCount
