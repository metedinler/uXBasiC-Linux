DIM total AS I64 = 0
FUNCTION Fib(n AS I64) AS I64
 IF n < 2 THEN RETURN n
 RETURN Fib(n-1) + Fib(n-2)
END FUNCTION
THREAD Work() AS I64
 DIM i AS I64
 FOR i = 1 TO 20
 total = total + Fib(8)
 NEXT
 RETURN 0
END THREAD
DIM a AS TASK OF I64 = SPAWN Work()
DIM b AS TASK OF I64 = SPAWN Work()
a.JOIN()
b.JOIN()
PRINT total
