DIM f AS F32 = 0
DIM d AS F64 = 0
FUNCTION Quarter() AS F32
 RETURN 0.25
END FUNCTION
FUNCTION Half() AS F64
 RETURN 0.5
END FUNCTION
THREAD Work() AS I64
 DIM i AS I64
 FOR i = 1 TO 1000
 f += Quarter()
 d += Half()
 NEXT
 RETURN 0
END THREAD
DIM a AS TASK OF I64 = SPAWN Work()
DIM b AS TASK OF I64 = SPAWN Work()
a.JOIN()
b.JOIN()
PRINT f
PRINT d
