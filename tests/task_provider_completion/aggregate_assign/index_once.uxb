DIM a(0 TO 2) AS I32
DIM calls AS I32 = 0
DIM trace AS I32 = 0
FUNCTION NextIndex() AS I32
    calls += 1
    trace = trace * 10 + 1
    RETURN 0
END FUNCTION
FUNCTION RightValue() AS I32
    trace = trace * 10 + 2
    RETURN 3
END FUNCTION
a(0) = 10
a(NextIndex()) += RightValue()
PRINT a(0)
PRINT calls
PRINT trace
