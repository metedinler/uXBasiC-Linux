TYPE Record
    text AS STRING
END TYPE
DIM records(0 TO 1) AS Record
DIM calls AS I32 = 0
DIM trace AS I32 = 0
FUNCTION NextIndex() AS I32
    DIM scratch AS STRING
    DIM i AS I32
    FOR i = 1 TO 128
        scratch = STR(i) + "-temporary"
    NEXT
    calls += 1
    trace = trace * 10 + 1
    RETURN 0
END FUNCTION
FUNCTION RightValue() AS STRING
    trace = trace * 10 + 2
    RETURN "AB" + CHR(0) + "CD"
END FUNCTION
records(NextIndex()).text = RightValue()
PRINT LEN(records(0).text)
PRINT ASC(MID(records(0).text, 3, 1))
PRINT calls
PRINT trace
