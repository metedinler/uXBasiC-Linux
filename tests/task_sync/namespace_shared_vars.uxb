' S-162: NAMESPACE degiskenleri: disaridan nitelikli (ns.v), iceriden nitelenmemis erisim; STRING, dizi;
' gorevler NAMESPACE degiskenine dokununca otomatik kilit (Model D).
NAMESPACE sayac
    DIM toplam AS I64
    DIM ad AS STRING
    DIM kutu(3) AS I32
    FUNCTION Ekle(n AS I64) AS I64
        toplam = toplam + n
        kutu(1) = kutu(1) + 1
        RETURN toplam
    END FUNCTION
END NAMESPACE
THREAD Isci(n AS I64) AS I64
    DIM i AS I64
    FOR i = 1 TO n
        sayac.toplam += 1
    NEXT i
    RETURN n
END THREAD
sayac.ad = "sayac"
PRINT sayac.Ekle(5)
sayac.kutu(2) = 7
DIM g AS TASKGROUP
DIM k AS I64
FOR k = 1 TO 4
    g.ADD(SPAWN Isci(2500))
NEXT k
g.JOIN()
PRINT sayac.ad; " "; sayac.toplam; " "; sayac.kutu(1); " "; sayac.kutu(2)
