    ' Oda baglantileri. Kilitli cikislar KILITLI - renk olarak saklanir;
    ' ayni renkli anahtar o cikisi acar.
    '   [01]  [02]==[03]  [04]==[05]
    '    :O    ||    ||          :Y
    '   [06]=={07}  [08]==[09]==[10]
    '    ||
    '   [11]==[12]  #13#  [14]  #15#  E
    '          ||          :R
    '   <16>  [17]==[18]==[19]==[20]
    '    :V                       :G
    '   [21]:I[22]:B[23]==[24]==[25]
    room(1).s = TRUE
    room(2).s = TRUE
    room(2).e = TRUE
    room(3).s = TRUE
    room(3).w = TRUE
    room(4).e = TRUE
