    room(16).s = TRUE
    room(17).n = TRUE
    room(17).e = TRUE
    room(18).w = TRUE
    room(18).e = TRUE
    room(19).n = KILITLI - 12
    room(19).w = TRUE
    room(19).e = TRUE
    room(20).s = KILITLI - 10
    room(20).w = TRUE
    room(21).n = KILITLI - 5
    room(21).e = TRUE
    room(22).w = KILITLI - 1
    room(22).e = TRUE
    room(23).w = KILITLI - 9
    room(23).e = TRUE
    room(24).w = TRUE
    room(24).e = TRUE
    room(25).n = TRUE
    room(25).w = TRUE
END SUB
' map: 5x5 labirent haritasi. Ziyaret edilen odalar ve kilitli
' cikislar kendi renkleriyle cizilir. Orijinaldeki boole-aritmetigi
' (r - 5) * -(r >= 5) acik IF ile komsu hesabina cevrildi.
SUB map()
    DIM y AS I32
    DIM x AS I32
    DIM r AS I32
    DIM kn AS I32
    DIM dg AS I32
    cprint CHR(&H87), 8
    FOR y = 0 TO 4
        FOR x = 1 TO 5
            r = x + y * 5
            IF r >= 5 THEN
                kn = r - 5
            ELSE
                kn = 0
            END IF
            IF room(r).n = TRUE AND room(kn).s = TRUE AND (room(r).v = TRUE OR room(kn).v = TRUE) THEN
                cprint "  " + CHR(&H87) + "||  ", 8
            ELSEIF room(r).n <= KILITLI AND room(r).v = TRUE THEN
                cprint "  " + clr(-room(r).n - 2) + "||  ", 8
            ELSEIF room(kn).s <= KILITLI AND room(kn).v = TRUE THEN
                cprint "  " + clr(-room(kn).s - 2) + "||  ", 8
            ELSE
                cprint "      ", 8
            END IF
        NEXT x
        PRINT
        cprint " ", 8
        FOR x = 1 TO 5
            r = x + y * 5
            IF r < 25 THEN
                dg = r + 1
            ELSE
                dg = 0
            END IF
            IF r = inroom THEN
                cprint clr(15), 8
            ELSEIF room(r).v = TRUE THEN
                cprint clr(7), 8
            ELSE
                cprint CHR(&H87), 8
            END IF
            cprint "[", 8
            IF r < 10 THEN
                cprint "0", 8
            END IF
            cprint LTRIM(STR(r)) + "]" + CHR(&H87), 8
            IF room(r).e = TRUE AND room(dg).w = TRUE AND (room(r).v = TRUE OR room(dg).v = TRUE) THEN
                cprint CHR(&H87) + "==", 8
            ELSEIF room(r).e <= KILITLI AND room(r).v = TRUE THEN
                cprint clr(-room(r).e - 2) + "==", 8
            ELSEIF room(dg).w <= KILITLI AND room(dg).v = TRUE THEN
                cprint clr(-room(dg).w - 2) + "==", 8
            ELSE
                cprint "  ", 8
            END IF
        NEXT x
        PRINT
    NEXT y
    cprint CHR(&H86), 8
END SUB
' ievent: esya olaylari. Olay numarasi e: 0 vur, 1 incele, 2 al,
' 3 konus, 4 kullan. Anahtar dogrulanmis "CASE deger[, deger]"
' listesiyle yinelenen unlocke satirlari tek case'e toplandi.
SUB ievent(e AS I32, i AS I32)
    SELECT CASE (i * 10) + e
        CASE 0
            cprint "** You attacked and killed " + nic(i) + ".", 4
            cprint "Well, that was stupid of you, wasn't it.", 4
            inroom = 0
        CASE 1
            IF item(21).oda = -1 THEN
                cprint "You look beautiful today.", 4
            ELSE
                cprint "You could look at " + nic(i) + " if you had a " + clr(15) + "MIRROR" + clr(7) + ".", 4
            END IF
        CASE 3
            cprint "Talking to " + nic(i) + " is the first sign of insanity...", 4
        CASE 14, 24, 34, 44, 54, 64, 74
            unlocke(i)
        CASE 80
            IF wpn < 0 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 81
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 0 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 90
            IF wpn < 15 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 91
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 15 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 100
            IF wpn < 15 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 101
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 15 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 110
            IF wpn < 16 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 111
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 16 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 120
            IF wpn < 16 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 121
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 16 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 130
            IF wpn < 17 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 131
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 17 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 140
            IF wpn < 17 THEN
                cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
                cprint "It easily over-powers you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
                inroom = 13
                move = TRUE
            ELSE
                IF trollquest(e, i) THEN
                    cprint "** You attack " + nic(i) + ", and it disintigrates, leaving behind " + nic(i - 7) + ".", 4
                    item(i - 7).cantada = FALSE
                    item(i - 7).alinir = TRUE
                    item(i).oda = 0
                END IF
            END IF
        CASE 141
            cprint nic(i) + " appears to be holding " + nic(i - 7) + ".", 4
            IF wpn < 17 THEN
                cprint "You won't be able to defeat " + nic(i) + " with " + nic(wpn) + ".", 4
            END IF
        CASE 152
            IF wpn = 0 THEN
                cprint "** You got a " + nic(i) + ".", 4
                cprint "You finally have a weapon!", 4
                item(i).oda = -1
            ELSE
                cprint "You can only carry one weapon.", 4
            END IF
        CASE 154
            cprint "** You shine your " + nic(i) + ".", 4
        CASE 162
            IF wpn = 0 THEN
                cprint "You got a " + nic(i) + ".", 4
                cprint "You now have a more powerful weapon!", 4
                item(i).oda = -1
            ELSE
                cprint "You can only carry one weapon.", 4
            END IF
        CASE 164
            cprint "** You swing your " + nic(i) + " at the air.", 4
        CASE 172
            IF wpn = 0 THEN
                cprint "** You got a " + nic(i) + ".", 4
                cprint "You now have the ultimate weapon!", 4
                item(i).oda = -1
            ELSE
                cprint "You can only carry one weapon.", 4
            END IF
        CASE 174
            cprint "** You shoot your " + nic(i) + " at the wall.", 4
            cprint "You made a large hole in the wall!", 4
        CASE 201
            cprint nic(i) + " is redheaded and Irish, and appears to be a normal human being.  He", 4
            cprint "claims to be a lepricon and allegedly has a pot of gold waiting for you at", 4
            cprint "the end of a " + clr(12) + "r" + clr(6) + "a" + clr(14) + "i" + clr(10) + "n" + clr(9) + "b" + clr(1) + "o" + clr(5) + "w" + clr(7) + ".", 4
        CASE 202
            cprint "** " + nic(i) + " kicks you in the shins", 4
            cprint "@#&%! That hurts!", 4
        CASE 203
            cprint nic(i) + ": The TROLLS stole my keys!!! Help me get them back, please!", 4
        CASE 211
            cprint "It's a nice shiney " + nic(i) + ".  You see " + nic(0) + " in the " + clr(15) + "reflection" + clr(7) + ".", 4
        CASE 222
            cprint "** You got " + nic(i), 4
            cprint "** You cheated", 4
            cheat = TRUE
        CASE 232
            cprint "You can't get ye " + nic(i) + ".", 4
            cprint "And you'll just have to sit there and imagine why on Earth you can't get ye", 4
            cprint nic(i) + "! Because this game's certainly not going to tell you.", 4
            cprint "And there's no precious graphics to help you out, either.", 4
            cprint "Graphics, shmaphics...", 4
        CASE 241
            cprint "These are probably the " + nic(i) + " that " + nic(20) + " is looking for.", 4
        CASE 251
            cprint "This looks like a " + clr(8) + "KEY" + clr(7) + " to a " + clr(15) + "CLOSET" + clr(7) + ".", 4
        CASE 254
            unlocke(i)
            item(i).oda = -1
        CASE ELSE
            PRINT "error", (e * 10) + i
    END SELECT
END SUB
' trollquest: troll bilgmece sorusu. Dogru cevap TRUE dondurur;
' yanlis cevap oyuncuyu dolaba gonderir (orijinal akisin aynisi).
' Fonksiyon degeri RETURN ile dondurulur; cevap/dogru ayri
' degiskenlerdir (QB'daki dizeye -1 atama hilesi turgu dikkate
' almadan acik IF bicimine tasindi).
FUNCTION trollquest(e AS I32, i AS I32) AS I32
    DIM cevap AS STRING
    DIM dogru AS I32
    cevap = ""
    dogru = FALSE
    SELECT CASE (i * 10) + e
        CASE 80
            cprint " a) red, yellow, blue", 4
            cprint " b) red, green, blue", 4
            cprint " c) red, white, blue", 4
            cprint " d) cyan, magenta, yellow", 4
            cprint "Which of the above are the primary colors of light? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "b" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE 90
            cprint " a) radio waves", 4
            cprint " b) infrared light", 4
            cprint " c) ultraviolet light", 4
            cprint " d) gamma rays", 4
            cprint "Which of the above can cause sunburn? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "c" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE 100
            cprint " a) red light", 4
            cprint " b) green light", 4
            cprint " c) yellow light", 4
            cprint " d) blue light", 4
            cprint "Which of the above has a longer wavelength than orange light? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "a" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE 110
            cprint " a) radio waves", 4
            cprint " b) microwaves", 4
            cprint " c) visible light", 4
            cprint " d) x-rays", 4
            cprint "Which of the above is used in microwaves to cook food? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "b" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE 120
            cprint " a) microwaves", 4
            cprint " b) gamma rays", 4
            cprint " c) visible light", 4
            cprint " d) infrared light", 4
            cprint "Which of the above is used for 'night vision'? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "d" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE 130
            cprint " a) total internal refraction", 4
            cprint " b) total internal confusion", 4
            cprint " c) total internal reflection", 4
            cprint " d) your mom", 4
            cprint "Which of the above are used in fiber optics? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "c" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE 140
            cprint " a) 186,282.4 miles per second", 4
            cprint " b) 136646 miles per second", 4
            cprint " c) 670.57 million miles per hour", 4
            cprint " d) 299,792,458 meters per second", 4
            cprint "Which of the above is the speed of light in a vacuum? ", 0
            DO WHILE LTRIM(RTRIM(cevap)) = ""
                INPUT cevap
                IF LTRIM(RTRIM(LCASE(cevap))) = "d" OR LTRIM(RTRIM(LCASE(cevap))) = "a" THEN
                    dogru = TRUE
                END IF
            LOOP
        CASE ELSE
            cprint "missing question" + STR(e), 4
    END SELECT
    IF dogru = FALSE THEN
        PRINT
        PRINT
        cprint "** You attacked " + nic(i) + " with " + nic(wpn) + ".", 4
        cprint "Since you could not correctly answer the queston, it easily over-powers", 4
        cprint "you and banishes you to the " + clr(15) + "CLOSET" + clr(7) + ".", 4
        inroom = 13
        move = TRUE
        RETURN FALSE
    END IF
    PRINT
    PRINT
    RETURN TRUE
END FUNCTION
' unlocke: eldeki anahtar, ayni renkteki kilitli cikisi acar.
SUB unlocke(i AS I32)
    IF item(i).oda = -1 THEN
        IF room(inroom).n = KILITLI - item(i).renk THEN
            cprint "** You used " + nic(i) + " to unlock " + clr(-room(inroom).n - 2) + "NORTH" + clr(7) + " exit.", 4
            room(inroom).n = TRUE
            item(i).oda = 0
        ELSEIF room(inroom).s = KILITLI - item(i).renk THEN
            cprint "** You used " + nic(i) + " to unlock " + clr(-room(inroom).s - 2) + "SOUTH" + clr(7) + " exit.", 4
            room(inroom).s = TRUE
            item(i).oda = 0
        ELSEIF room(inroom).w = KILITLI - item(i).renk THEN
            cprint "** You used " + nic(i) + " to unlock " + clr(-room(inroom).w - 2) + "WEST" + clr(7) + " exit.", 4
            room(inroom).w = TRUE
            item(i).oda = 0
        ELSEIF room(inroom).e = KILITLI - item(i).renk THEN
            cprint "** You used " + nic(i) + " to unlock " + clr(-room(inroom).e - 2) + "EAST" + clr(7) + " exit.", 4
            room(inroom).e = TRUE
            item(i).oda = 0
        ELSE
            cprint nic(i) + " won't open any of these exits.", 4
        END IF
    END IF
END SUB
' viewroom: oda icergi, gorunur cikislar ve kilitli yonler.
' QB statik yerel birikimine karsi sayaclari her giriste sifirlar.
SUB viewroom()
    DIM i AS I32
    DIM nitems AS I32
    DIM litems AS I32
    DIM exits AS I32
    DIM ld AS STRING
    item(0).oda = inroom
    PRINT
    IF inroom = 13 THEN
        cprint "You are in the " + clr(15) + "CLOSET" + clr(7) + ".", 4
        cprint "You'll probably be here a while since there's almost no way out.", 4
    ELSE
        cprint "You are in room " + STR(inroom) + ".", 4
    END IF
    nitems = 0
    litems = 0
    exits = 0
    ld = ""
    FOR i = 0 TO ESYA_SAYISI
        IF item(i).oda = inroom AND item(i).cantada = FALSE THEN
            nitems = nitems + 1
        END IF
    NEXT i
    IF nitems > 0 THEN
        cprint "In the room you see", 0
        FOR i = 0 TO ESYA_SAYISI
            IF item(i).oda = inroom AND item(i).cantada = FALSE THEN
                cprint clr(item(i).renk) + UCASE(itemn(i)), 0
                litems = litems + 1
                IF litems <> nitems THEN
                    PRINT ",";
                END IF
            END IF
        NEXT i
        cprint ".", 4 + 8
    END IF
    cprint "Obvious exits are" + clr(15), 0
    IF room(inroom).n = TRUE THEN
        cprint "NORTH", 0
        exits = exits + 1
    END IF
    IF room(inroom).s = TRUE THEN
        cprint "SOUTH", 0
        exits = exits + 1
    END IF
    IF room(inroom).e = TRUE THEN
        cprint "EAST", 0
        exits = exits + 1
    END IF
    IF room(inroom).w = TRUE THEN
        cprint "WEST", 0
        exits = exits + 1
    END IF
    cprint clr(7), 8
    IF exits = 0 THEN
        cprint "none", 0
    END IF
    cprint ".", 4 + 8
    IF room(inroom).n <= KILITLI THEN
        ld = ld + clr(-room(inroom).n - 2) + "NORTH "
    END IF
    IF room(inroom).s <= KILITLI THEN
        ld = ld + clr(-room(inroom).s - 2) + "SOUTH "
    END IF
    IF room(inroom).w <= KILITLI THEN
        ld = ld + clr(-room(inroom).w - 2) + "WEST "
    END IF
    IF room(inroom).e <= KILITLI THEN
        ld = ld + clr(-room(inroom).e - 2) + "EAST "
    END IF
    IF ld <> "" THEN
        cprint "The " + ld + clr(7) + "exit is locked.", 4
    END IF
END SUB
' wtd: "what to do" komut cozumleyici. Orijinaldeki oz-yinelemeli
' bos giris dalgasi DO/LOOP WHILE bicimine cevrildi; kelime esleme
' (LEFT/RIGHT/INSTR), hile komutlari ve olay sevkleri aynen kalir.
SUB wtd()
    DIM wdo AS STRING
    DIM want AS STRING
    DIM act AS I32
    DIM ld AS STRING
    DIM nitems AS I32
    DIM inv AS I32
    DIM i AS I32
    act = FALSE
    ld = ""
    move = FALSE
    DO
        PRINT
        INPUT " >", wdo
        wdo = LTRIM(RTRIM(LCASE(wdo)))
    LOOP WHILE wdo = ""
    IF wdo = "warp" THEN
        INPUT " to", inroom
        move = TRUE
        cprint "** You cheated", 4
        cheat = TRUE
    END IF
    IF wdo = "warp here" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF item(i).oda > 0 THEN
                item(i).oda = inroom
            END IF
        NEXT i
        act = TRUE
        cprint "** You cheated", 4
        cheat = TRUE
        cprint "All items warped.", 4
    END IF
    IF wdo = "give me" THEN
        INPUT " what? ", want
        FOR i = 0 TO ESYA_SAYISI
            IF itemn(i) = want THEN
                item(i).oda = -1
                cprint nic(i) + " given.", 4
                IF item(i).silah = TRUE THEN
                    wpn = i
                END IF
            END IF
        NEXT i
        act = TRUE
        cprint "** You cheated", 4
        cheat = TRUE
    END IF
    IF wdo = "see all" THEN
        FOR i = 1 TO ODA_SAYISI
            room(i).v = TRUE
        NEXT i
        act = TRUE
        cprint "** You cheated", 4
        cheat = TRUE
    END IF
    IF wdo = "help" THEN
        cprint clr(15) + "  attack          examine", 4
        cprint "  get " + clr(7) + "/" + clr(15) + " drop      inventory", 4
        cprint "  talk to         use", 4
        cprint "  go " + clr(7) + "[direction]" + clr(15) + "  look", 4
        cprint "  map             quit" + clr(7), 4
        act = TRUE
    END IF
    IF wdo = "map" THEN
        map()
        act = TRUE
    END IF
    IF wdo = "look" THEN
        move = TRUE
    END IF
    IF LEFT(wdo, 4) = "quit" THEN
        cprint "You are a coward to shy away from such a simple task.", 4
        act = TRUE
        bitti = TRUE
    END IF
    IF INSTR(wdo, "inventory") > 0 THEN
        nitems = 0
        inv = 0
        cprint "You are currently carrying", 0
        FOR i = 0 TO ESYA_SAYISI
            IF item(i).oda = -1 THEN
                nitems = nitems + 1
            END IF
        NEXT i
        FOR i = 0 TO ESYA_SAYISI
            IF item(i).oda = -1 THEN
                cprint nic(i), 0
                inv = inv + 1
                IF inv <> nitems THEN
                    PRINT ",";
                END IF
            END IF
        NEXT i
        IF inv = 0 THEN
            cprint "nothing", 0
        END IF
        cprint ".", 4 + 8
        act = TRUE
    END IF
    IF LEFT(wdo, 4) = "drop" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF item(i).silah = TRUE THEN
                wpn = 0
            END IF
            IF RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND item(i).oda = -1 THEN
                cprint "** You dropped " + nic(i) + ".", 4
                item(i).oda = inroom
                item(i).alinir = 1
                act = TRUE
            END IF
        NEXT i
    END IF
    IF LEFT(wdo, 7) = "pick up" OR LEFT(wdo, 3) = "get" OR LEFT(wdo, 4) = "take" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND item(i).oda = inroom THEN
                IF item(i).alinir = TRUE THEN
                    cprint "You got " + nic(i) + ".", 4
                    item(i).oda = -1
                END IF
                IF item(i).alinir = FALSE THEN
                    cprint "You can't get " + nic(i) + ".", 4
                END IF
                IF item(i).alinir <= OLAY_X THEN
                    ievent(2, i)
                END IF
                IF item(i).alinir = OLAY_A THEN
                    item(i).oda = -1
                END IF
                IF item(i).silah = TRUE AND wpn = 0 THEN
                    wpn = i
                END IF
                act = TRUE
            END IF
        NEXT i
    END IF
    IF LEFT(wdo, 6) = "attack" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND item(i).oda = inroom THEN
                IF item(i).saldiri = TRUE THEN
                    cprint "You attacked " + nic(i) + ", but nothing happened.", 4
                END IF
                IF item(i).saldiri = FALSE THEN
                    cprint "You can't attack " + nic(i) + ".", 4
                END IF
                IF item(i).saldiri <= OLAY_X THEN
                    ievent(0, i)
                END IF
                act = TRUE
            END IF
        NEXT i
    END IF
    IF LEFT(wdo, 3) = "use" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND item(i).oda = -1 THEN
                IF item(i).kullanir = TRUE THEN
                    cprint "You used " + nic(i) + ", but nothing happened.", 4
                END IF
                IF item(i).kullanir = FALSE THEN
                    cprint "You can't use " + nic(i) + ".", 4
                END IF
                IF item(i).kullanir <= OLAY_X THEN
                    ievent(4, i)
                END IF
                act = TRUE
            END IF
            IF act = FALSE AND RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND item(i).oda <> -1 THEN
                cprint "You have no " + nic(i) + " to use.", 4
                act = TRUE
            END IF
        NEXT i
    END IF
    IF LEFT(wdo, 7) = "look at" OR LEFT(wdo, 7) = "examine" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND (item(i).oda = inroom OR item(i).oda = -1) THEN
                IF item(i).incelenir = FALSE THEN
                    cprint "It looks like every other " + nic(i) + ".", 4
                END IF
                IF item(i).incelenir <= OLAY_X THEN
                    ievent(1, i)
                END IF
                act = TRUE
            END IF
        NEXT i
    END IF
    IF LEFT(wdo, 7) = "talk to" OR LEFT(wdo, 10) = "speak with" THEN
        FOR i = 0 TO ESYA_SAYISI
            IF RIGHT(wdo, LEN(itemn(i))) = itemn(i) AND (item(i).oda = inroom OR item(i).oda = -1) THEN
                IF item(i).konusur = TRUE THEN
                    cprint nic(i) + " talks to you.", 4
                END IF
                IF item(i).konusur = FALSE THEN
                    cprint nic(i) + " won't talk to you.", 4
                END IF
                IF item(i).konusur <= OLAY_X THEN
                    ievent(3, i)
                END IF
                act = TRUE
            END IF
        NEXT i
    END IF
    IF RIGHT(wdo, 5) = "north" AND room(inroom).n <= KILITLI THEN
        ld = clr(-room(inroom).n - 2) + "NORTH"
        act = TRUE
    END IF
    IF RIGHT(wdo, 5) = "south" AND room(inroom).s <= KILITLI THEN
        ld = clr(-room(inroom).s - 2) + "SOUTH"
        act = TRUE
    END IF
    IF RIGHT(wdo, 4) = "west" AND room(inroom).w <= KILITLI THEN
        ld = clr(-room(inroom).w - 2) + "WEST"
        act = TRUE
    END IF
    IF RIGHT(wdo, 4) = "east" AND room(inroom).e <= KILITLI THEN
        ld = clr(-room(inroom).e - 2) + "EAST"
        act = TRUE
    END IF
    IF ld <> "" THEN
        cprint "You can't go " + ld + clr(7) + ", because the exit is locked.", 4
    END IF
    IF RIGHT(wdo, 5) = "north" AND room(inroom).n = TRUE THEN
        inroom = inroom - 5
        move = TRUE
    END IF
    IF RIGHT(wdo, 5) = "south" AND room(inroom).s = TRUE THEN
        inroom = inroom + 5
        move = TRUE
    END IF
    IF RIGHT(wdo, 4) = "east" AND room(inroom).e = TRUE THEN
        inroom = inroom + 1
        move = TRUE
    END IF
    IF RIGHT(wdo, 4) = "west" AND room(inroom).w = TRUE THEN
        inroom = inroom - 1
        move = TRUE
    END IF
    IF item(24).oda = 2 THEN
        item(24).oda = 0
        cprint nic(20) + ": Thanks!", 4
    END IF
    IF act = FALSE AND move = FALSE THEN
        cprint "You can't " + wdo + ".", 4
    END IF
    IF move = TRUE THEN
        viewroom()
    END IF
END SUB
' ---------------------------------------------------------------------
' Ana akis. QB'daki COMMAND$/PALETTE/VIEW PRINT satirlarinin karsiligi
' yoktur: intro her calismada acilir, oyun dogrudan baslar.
MAIN
    DIM i AS I32
    DIM metin AS STRING
    inroom = 7
    intro()
    CLS
    roomsitems()
    cprint "Welcome to " + nic(18) + " " + CHR(&H8E) + "Quest" + CHR(&H86) + "!", 4
    cprint "As you can probably guess, you are on the quest for the " + nic(18) + ".", 4
    PRINT
    cprint "You are in a 5x5 maze which you will need to navigate to find the", 4
    cprint nic(18) + ".  Along the way you will encounter " + clr(15) + "TROLLS" + clr(7) + " which will question", 4
    cprint "your knowledge of " + clr(4) + "/" + clr(9) + "S" + clr(1) + "/" + clr(9) + "C" + clr(1) + "/" + clr(9) + "I" + clr(1) + "/" + clr(9) + "E" + clr(1) + "/" + clr(9) + "N" + clr(1) + "/" + clr(9) + "C" + clr(1) + "/" + clr(9) + "E" + clr(4) + "/" + clr(7), 4
    PRINT
    cprint "Your quest begins now...", 4
    PRINT
    cprint "You awake to find yourself in a dark room.", 4
    viewroom()
    DO WHILE item(19).oda <> -1 AND bitti = FALSE
        room(inroom).v = TRUE
        wtd()
        IF inroom = 0 AND bitti = FALSE THEN
            gameover()
        END IF
    LOOP
    IF bitti = FALSE THEN
        PRINT
        cprint "Congrats! You won the game!", 4
        INPUT " What is your name", pname
        OPEN "hs.txt" FOR APPEND AS #1
        FOR i = 1 TO LEN(pname)
            PRINT #1, HEX(ASC(MID(pname, i, 1)));
        NEXT i
        IF cheat = TRUE THEN
            metin = " (cheater)"
            FOR i = 1 TO LEN(metin)
                PRINT #1, HEX(ASC(MID(metin, i, 1)));
            NEXT i
        END IF
        metin = " won the game @ " + STR(TIMER()) + " saniye."
        FOR i = 1 TO LEN(metin)
            PRINT #1, HEX(ASC(MID(metin, i, 1)));
        NEXT i
        PRINT #1, "0D0A";
        CLOSE #1
    END IF
END MAIN
