' =====================================================================
' PRISM QUEST - uXBasic surumu
' Kaynak: QBasic/FreeBASIC "Prism Quest" (Mindless) - kullanici FB
'         kodunu ceviri icin verdi; oyun mantigi 1:1 korunmustur.
' Hedef: uXBasic v1.06 (src 27.10 anlik goruntusu); yalnizca kaynak
'         kodda satir satir dogrulanmis ifadeler kullanilmistir.
' Calistirma: uxbasic run prism_quest.uxb
'             uxbasic bld prism_quest.uxb --build-x64-out bin
'
' FB -> uXBasic ceviri kararlarinin tam listesi:
'  1. Tip sonekleri ($ % ! &) kaldirildi; uXBasic sonek kabul etmez.
'     itemn$->itemn, clr$->clr, nic$->nic, wdo$->wdo, pname$->pname.
'  2. AS INTEGER -> AS I32 (uXBasic kanonik tip adi).
'  3. DECLARE bloklari atildi (cok gecisli derleyicide one bildirim
'     gerekmez); bildirilip tanimsiz birakilan rollup atildi.
'  4. SCREENres/PALETTE/LINE...BF grafikleri ve DATA/READ uXBasic
'     konsol dilinde yok: intro'daki 22x20 prizma bitmap'i ve wipe
'     animasyonu cikarildi; intro metin banner ile acilir.
'  5. VIEW PRINT 2 TO 49 ve PALETTE 6,38 atildi (karsiligi yok).
'  6. COMMAND$ yok: intro her calismada acilir. TIME$/DATE$ yok:
'     hs.txt kaydinda TIMER() saniyesi kullanilir. SLEEP yok:
'     beklemeler INPUT ile yapilir.
'  7. INKEY$ donguleri INPUT beklemesine cevrildi; uXBasic'te
'     INKEY(n) hata ayiklama tus kuyrugu okur, terminal beklemesi
'     degildir.
'  8. Tek argumanli LOCATE ve CSRLIN yok: cprint merkezleme/saga
'     yaslamayi on bosluklarla yapar; LOCATE hep "satir, sutun".
'  9. COLOR iki argumanlidir: COLOR onplan, arkaplan (0 = siyah).
' 10. QB ":" deyim ayiraci kullanilmadi; her deyim kendi satirinda.
' 11. uXBasic'te ^ operatoru yoktur: 2^0..2^3 bit maskeleri 1/2/4/8
'     olarak yazildi. EXIT SUB olmadigi icin akis IF/ELSE ile
'     yeniden kuruldu. Fonksiyon degeri RETURN ile doner.
' 12. NEXT degiskeni zorunludur: NEXT i bicimi kullanildi.
' 13. QB statik yerel degisken birikimi (viewroom/wtd sayaclari
'     cagri between deger tasiyordu) her giriste acik sifirlama ile
'     giderildi; bu bilincli bir duzeltmedir, oyun kurallari aynidir.
' 14. Sus susleri aynen korundu: CHR(174)/CHR(175) << >> basar;
'     128..143 araligi cprint icinde renk kodu olarak harcanir
'     (ekrana cikmaz). CP437'ye ozgu 254 ve 247 karakerleri Unicode
'     konsolda baska gorunecegi icin "*" ve "/" ile degistirildi.
' 15. titem alanlari acik adlara tasindi; GET ayirtci sozcuk
'     oldugu icin karismayi onler: r=oda c=renk atk=saldiri
'     get=alinir use=kullanir exa=incelenir tlk=konusur wpn=silah
'     inv=cantada. troom yon harflerini korur: n kuzey s guney
'     e dogu w bati v goruldu.
' Kullanilan ve dogrulanan yuzey (kaynak: src2710 derin taramasi):
'   ' yorum; CONST ad AS I32 = ...; TYPE/END TYPE; DIM dizi(sinir)
'   (tek sinir = dahil ust sinir, alt sinir 0, sinir ifadesi
'   calisma zamaninda degerlendirilir); MAIN/END MAIN; SUB/END SUB;
'   FUNCTION ... AS tip + RETURN; IF/ELSEIF/ELSE/END IF;
'   SELECT CASE/CASE a,b/CASE ELSE/END SELECT; FOR/NEXT;
'   DO WHILE/LOOP; LOOP WHILE; EXIT DO; PRINT (== bitistirir,
'   sondaki ; satir atlatmaz); PRINT # (sondaki ; CRLF basmaz);
'   INPUT [istem,] hedef (sayisal hedef ValInt ile okunur);
'   OPEN yol FOR APPEND AS #1; CLOSE #1; CLS; COLOR on,arka;
'   LOCATE satir,sutun; LEN MID ASC CHR LEFT RIGHT INSTR LTRIM
'   RTRIM LCASE UCASE STR SPACE STRING HEX TIMER; TRUE/FALSE (-1/0);
'   AND OR; = <> < >; \ tamsayi bolme; + dizge birlestirme.
' =====================================================================
' Olay sabitleri: esya alanlarina yazilan ozel degerler.
' KILITLI - renk kodu biciminde kilitli cikis saklanir.
CONST KILITLI AS I32 = -2
CONST OLAY_X AS I32 = -2
CONST OLAY_A AS I32 = -3
CONST ODA_SAYISI AS I32 = 26
CONST ESYA_SAYISI AS I32 = 30
' cprint kip bitleri (orijinal bitmask'in aynisi):
' 1 = ortala, 2 = saga yasla, 4 = satir atla, 8 = on bosluk koyma.
TYPE troom
    n AS I32
    s AS I32
    e AS I32
    w AS I32
    v AS I32
END TYPE
TYPE titem
    oda AS I32
    renk AS I32
    saldiri AS I32
    alinir AS I32
    kullanir AS I32
    incelenir AS I32
    konusur AS I32
    silah AS I32
    cantada AS I32
END TYPE
DIM room(ODA_SAYISI) AS troom
DIM item(ESYA_SAYISI) AS titem
DIM itemn(ESYA_SAYISI) AS STRING
DIM inroom AS I32
DIM wpn AS I32
DIM prism AS I32
DIM move AS I32
DIM cheat AS I32
DIM bitti AS I32
DIM pname AS STRING
' ---------------------------------------------------------------------
' cprint: renk gomulu metin yazici. 127+k (128..143) karakterleri
' ekrana cikmaz; COLOR k, 0 kurar. Orijinalin mekanizmasinin aynisi.
SUB cprint(metin AS STRING, a AS I32)
    DIM s AS STRING
    DIM i AS I32
    DIM l AS I32
    DIM k AS I32
    DIM bosluk AS I32
    s = metin
    l = 0
    k = 0
    bosluk = 0
    FOR i = 1 TO LEN(s)
        k = ASC(MID(s, i, 1))
        IF k <= 127 OR k > 143 THEN
            l = l + 1
        END IF
    NEXT i
    IF (a AND 1) <> 0 THEN
        IF (a AND 2) <> 0 THEN
            bosluk = 80 - l
        ELSE
            bosluk = (80 - l) \ 2
        END IF
        IF bosluk > 0 THEN
            s = SPACE(bosluk) + s
        END IF
    ELSE
        IF (a AND 8) = 0 THEN
            s = " " + s
        END IF
    END IF
    FOR i = 1 TO LEN(s)
        k = ASC(MID(s, i, 1))
        IF k > 127 AND k < 143 THEN
            COLOR k - 127, 0
        ELSE
            PRINT MID(s, i, 1);
        END IF
    NEXT i
    IF (a AND 4) <> 0 THEN
        PRINT
    END IF
END SUB
' clr: renk kodu karakterini uretir (127 + k gomulu renk duzeni).
FUNCTION clr(c AS I32) AS STRING
    RETURN CHR(127 + c)
END FUNCTION
' nic: esyanin renkli, buyuk harfli adini uretir.
FUNCTION nic(i AS I32) AS STRING
    DIM j AS I32
    j = i
    IF j < 0 THEN
        j = 0
    END IF
    RETURN clr(item(j).renk) + UCASE(itemn(j)) + clr(7)
END FUNCTION
' intro: acilis ekrani. Orijinaldeki grafik prizma ve wipe yok;
' renkli metin banner aynen korunur (128..143 kodlari renk verir).
SUB intro()
    DIM beklet AS STRING
    LOCATE 10, 1
    cprint " " + CHR(&H8E) + CHR(&HAE) + CHR(&H86) + CHR(&HAE) + CHR(&H8E) + CHR(&HAE) + " " + CHR(&H8B) + "P" + CHR(&H8D) + "r" + CHR(&H89) + "i" + CHR(&H88) + "s" + CHR(&H84) + "m  " + CHR(&H8E) + "Quest " + CHR(&HAF) + CHR(&H86) + CHR(&HAF) + CHR(&H8E) + CHR(&HAF), 1 + 4
    cprint CHR(&H86) + " by Mindless - uXBasic surumu *", 1 + 4
    LOCATE 23, 1
    cprint CHR(&H87) + "programmed entirely   ", 1 + 2 + 4
    cprint "in mom's basement    " + CHR(&H86), 1 + 2
    LOCATE 15, 1
    cprint clr(8) + "Disclaimer: 'Anything contained in this game may or may not be true;", 1 + 4
    cprint "     in either case, we cannot be held responsible.'" + CHR(&H86), 1 + 4
    LOCATE 13, 1
    cprint " press enter to start ", 1
    INPUT beklet
END SUB
' gameover: dolaba gonderildiginde oyun biter.
' Orijinalin INKEY$ ile yanan blink dongusu yerine tek cerceve +
' INPUT beklemesi kullanilir; bitis bitti bayragiyla MAIN'e bildirilir.
SUB gameover()
    DIM beklet AS STRING
    LOCATE 11, 1
    cprint SPACE(21), 1
    LOCATE 13, 1
    cprint SPACE(21), 1
    LOCATE 12, 1
    cprint "  " + CHR(&H8E) + CHR(&HAE) + CHR(&H86) + CHR(&HAE) + CHR(&H8B) + CHR(&HAE) + " game over " + CHR(&HAF) + CHR(&H86) + CHR(&HAF) + CHR(&H8E) + CHR(&HAF) + "  ", 1
    PRINT
    PRINT
    cprint "press enter...", 4
    INPUT beklet
    bitti = TRUE
END SUB
