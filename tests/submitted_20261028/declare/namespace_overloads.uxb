NAMESPACE Calc
    DECLARE FUNCTION Mix(x AS I32) AS I32
    DECLARE FUNCTION Mix(x AS I32, y AS I32) AS F64
    FUNCTION Mix(x AS I32) AS I32
        RETURN x + 1
    END FUNCTION
    FUNCTION Mix(x AS I32, y AS I32) AS F64
        RETURN CDBL(x + y) + 0.5
    END FUNCTION
END NAMESPACE
PRINT Calc.Mix(2)
PRINT Calc.Mix(2, 3)
