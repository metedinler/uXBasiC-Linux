INTERFACE IOku
    METHOD Deger() AS I32
END INTERFACE
CLASS Bir IMPLEMENTS IOku
    PUBLIC
    METHOD Deger() AS I32
        RETURN 11
    END METHOD
END CLASS
CLASS Iki IMPLEMENTS IOku
    PUBLIC
    VIRTUAL METHOD Diger() AS I32
        RETURN 99
    END METHOD
    METHOD Deger() AS I32
        RETURN 22
    END METHOD
END CLASS
FUNCTION Oku(o AS IOku) AS I32
    RETURN o.Deger()
END FUNCTION
DIM a AS Bir = NEW Bir()
DIM b AS Iki = NEW Iki()
PRINT Oku(a)
PRINT Oku(b)
