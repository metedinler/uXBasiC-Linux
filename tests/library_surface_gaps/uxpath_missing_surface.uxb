        PRINT uxpath.HasExtension("", "")
        PRINT uxpath.IsAbsolute("")
        PRINT uxpath.IsInside("", "")
        PRINT uxpath.Join("", "")
        PRINT uxpath.Normalize("")
        PRINT uxpath.Stem("")
    END IF
    PRINT "PASS_LIBRARY_SURFACE_UXPATH"
END MAIN
