MAIN
    IF FALSE THEN
        PRINT uxpath.ChangeExtension("", "")
        PRINT uxpath.Combine3("", "", "")
        PRINT uxpath.DirectoryName("")
        PRINT uxpath.ErrorText()
        PRINT uxpath.Extension("")
        PRINT uxpath.FileName("")
