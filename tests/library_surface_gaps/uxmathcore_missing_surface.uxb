INCLUDE "include/modules/uxmathcore.uxmh"

MAIN
    IF FALSE THEN
        PRINT UXMC_BufferAppend(0, 0)
        PRINT UXMC_BufferByteSize(0)
        PRINT UXMC_BufferCapacity(0)
        PRINT UXMC_BufferCast(0, 0)
        PRINT UXMC_BufferClear(0)
        PRINT UXMC_BufferClone(0)
        PRINT UXMC_BufferCount(0)
        PRINT UXMC_BufferCreateCapacity(0, 0, 0)
        PRINT UXMC_BufferDataPtr(0)
        PRINT UXMC_BufferElemSize(0)
        PRINT UXMC_BufferFillZero(0)
        PRINT UXMC_BufferReserve(0, 0)
        PRINT UXMC_BufferResize(0, 0)
        PRINT UXMC_BufferSlice(0, 0, 0)
        PRINT UXMC_BufferType(0)
        PRINT UXMC_FillF64(0, 0.0)
        PRINT UXMC_PushByte(0, 0)
        PRINT UXMC_PushI64(0, 0)
        PRINT UXMC_PushU64(0, 0)
        PRINT UXMC_SetByte(0, 0, 0)
        PRINT UXMC_SetF64(0, 0, 0.0)
        PRINT UXMC_SetI64(0, 0, 0)
        PRINT UXMC_SetU64(0, 0, 0)
        PRINT UXMC_TYPE_F32()
        PRINT UXMC_TYPE_I16()
        PRINT UXMC_TYPE_I32()
        PRINT UXMC_TYPE_I64()
        PRINT UXMC_TYPE_I8()
        PRINT UXMC_TYPE_U16()
        PRINT UXMC_TYPE_U32()
        PRINT UXMC_TYPE_U64()
        PRINT UXMC_TYPE_U8()
        PRINT UXMC_TypeSize(0)
        PRINT UXMC_VecAxpyF64(0.0, 0, 0, 0)
        PRINT UXMC_VecDivF64(0, 0, 0)
        PRINT UXMC_VecL1NormF64(0)
        PRINT UXMC_VecMaxF64(0)
        PRINT UXMC_VecMinF64(0)
        PRINT UXMC_VecMulF64(0, 0, 0)
        PRINT UXMC_VecNormalizeL2F64(0, 0)
        PRINT UXMC_VecScaleF64(0, 0.0, 0)
        PRINT UXMC_VecSubF64(0, 0, 0)
        PRINT UXMC_Version()
    END IF
    PRINT "PASS_LIBRARY_SURFACE_UXMATHCORE"
END MAIN
