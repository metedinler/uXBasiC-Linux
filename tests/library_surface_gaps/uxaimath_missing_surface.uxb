INCLUDE "include/modules/uxtensor.uxmh"
INCLUDE "include/modules/uxaimath.uxmh"

MAIN
    IF FALSE THEN
        uxaimath.ApplyELUPtr(0, 0, 0.0)
        uxaimath.ApplyGELUPtr(0, 0)
        uxaimath.ApplyLeakyReLUPtr(0, 0, 0.0)
        uxaimath.ApplyReLUPtr(0, 0)
        uxaimath.ApplySigmoidPtr(0, 0)
        uxaimath.ApplySwishPtr(0, 0)
        uxaimath.ApplyTanhPtr(0, 0)
        PRINT uxaimath.ArgMax(0, 0)
        uxaimath.BCEGrad(0, 0, 0, 0)
        PRINT uxaimath.Backend()
        PRINT uxaimath.BinaryAccuracy(0, 0, 0, 0.0)
        PRINT uxaimath.BinaryCrossEntropy(0, 0, 0)
        PRINT uxaimath.CategoricalCrossEntropy(0, 0, 0)
        uxaimath.ClipNorm(0, 0, 0.0)
        uxaimath.ClipValue(0, 0, 0.0, 0.0)
        uxaimath.DenseBatchForward(0, 0, 0, 0, 0, 0, 0)
        uxaimath.DenseForward(0, 0, 0, 0, 0, 0)
        PRINT uxaimath.ELU(0.0, 0.0)
        uxaimath.FillNormal(0, 0, 0.0, 0.0)
        uxaimath.FillOnes(0, 0)
        uxaimath.FillUniform(0, 0, 0.0, 0.0)
        uxaimath.FillZeros(0, 0)
        PRINT uxaimath.GELU(0.0)
        uxaimath.HeUniform(0, 0, 0)
        PRINT uxaimath.Huber(0, 0, 0, 0.0)
        PRINT uxaimath.LeakyReLU(0.0, 0.0)
        PRINT uxaimath.MAE(0, 0, 0)
        PRINT uxaimath.MSE(0, 0, 0)
        uxaimath.MSEGrad(0, 0, 0, 0)
        uxaimath.MomentumUpdate(0, 0, 0, 0, 0.0, 0.0)
        PRINT uxaimath.ReLU(0.0)
        uxaimath.SGDUpdate(0, 0, 0, 0.0)
        uxaimath.SoftmaxInPlacePtr(0, 0)
        uxaimath.SoftmaxPtr(0, 0, 0)
        PRINT uxaimath.Softplus(0.0)
        PRINT uxaimath.Swish(0.0)
        uxaimath.TensorGELU(0)
        uxaimath.TensorLeakyReLU(0, 0.0)
        uxaimath.TensorSigmoid(0)
        uxaimath.TensorTanh(0)
        uxaimath.XavierUniform(0, 0, 0, 0)
    END IF
    PRINT "PASS_LIBRARY_SURFACE_UXAIMATH"
END MAIN
