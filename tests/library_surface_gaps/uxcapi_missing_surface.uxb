INCLUDE "include/modules/uxcapi.uxmh"

MAIN
    IF FALSE THEN
        PRINT uxcapi.ArgF32(0, 0.0)
        PRINT uxcapi.ArgF64(0, 0.0)
        PRINT uxcapi.ArgI16(0, 0)
        PRINT uxcapi.ArgI32(0, 0)
        PRINT uxcapi.ArgI64(0, 0)
        PRINT uxcapi.ArgI8(0, 0)
        PRINT uxcapi.ArgLongDouble(0, 0.0)
        PRINT uxcapi.ArgPtr(0, 0)
        PRINT uxcapi.ArgString(0, "")
        PRINT uxcapi.ArgU16(0, 0)
        PRINT uxcapi.ArgU32(0, 0)
        PRINT uxcapi.ArgU64(0, 0)
        PRINT uxcapi.ArgU8(0, 0)
        PRINT uxcapi.ArgWString(0, "")
        PRINT uxcapi.ArgsAddF32(0, 0.0)
        PRINT uxcapi.ArgsAddF64(0, 0.0)
        PRINT uxcapi.ArgsAddI16(0, 0)
        PRINT uxcapi.ArgsAddI32(0, 0)
        PRINT uxcapi.ArgsAddI64(0, 0)
        PRINT uxcapi.ArgsAddI8(0, 0)
        PRINT uxcapi.ArgsAddLongDouble(0, 0.0)
        PRINT uxcapi.ArgsAddPtr(0, 0)
        PRINT uxcapi.ArgsAddString(0, "")
        PRINT uxcapi.ArgsAddU16(0, 0)
        PRINT uxcapi.ArgsAddU32(0, 0)
        PRINT uxcapi.ArgsAddU64(0, 0)
        PRINT uxcapi.ArgsAddU8(0, 0)
        PRINT uxcapi.ArgsAddWString(0, "")
        PRINT uxcapi.ArgsClear(0)
        uxcapi.ArgsFree(0)
        PRINT uxcapi.ArgsNew()
        PRINT uxcapi.CallAppendArgs(0, 0)
        PRINT uxcapi.CallClearArguments(0)
        PRINT uxcapi.CallError(0)
        uxcapi.CallFree(0)
        PRINT uxcapi.CallNew("", "", 0, 0, 0)
        PRINT uxcapi.CallbackAddArg(0, 0)
        PRINT uxcapi.CallbackBuild(0)
        uxcapi.CallbackFree(0)
        PRINT uxcapi.CallbackNew(0, 0, 0.0)
        PRINT uxcapi.CallbackNext(0)
        PRINT uxcapi.CallbackPending(0)
        PRINT uxcapi.CallbackPointer(0)
        PRINT uxcapi.EventArgCount(0)
        PRINT uxcapi.EventArgF64(0, 0)
        PRINT uxcapi.EventArgKind(0, 0)
        PRINT uxcapi.EventArgString(0, 0)
        PRINT uxcapi.EventArgU64(0, 0)
        uxcapi.EventFree(0)
        PRINT uxcapi.Invoke(0)
        PRINT uxcapi.LastError()
        PRINT uxcapi.MemoryAlloc(0)
        PRINT uxcapi.MemoryCalloc(0, 0)
        PRINT uxcapi.MemoryCopy(0, 0, 0)
        uxcapi.MemoryFree(0)
        PRINT uxcapi.MemoryReadF32(0, 0)
        PRINT uxcapi.MemoryReadF64(0, 0)
        PRINT uxcapi.MemoryReadI16(0, 0)
        PRINT uxcapi.MemoryReadI32(0, 0)
        PRINT uxcapi.MemoryReadI64(0, 0)
        PRINT uxcapi.MemoryReadI8(0, 0)
        PRINT uxcapi.MemoryReadPtr(0, 0)
        PRINT uxcapi.MemoryReadString(0, 0)
        PRINT uxcapi.MemoryReadU16(0, 0)
        PRINT uxcapi.MemoryReadU32(0, 0)
        PRINT uxcapi.MemoryReadU64(0, 0)
        PRINT uxcapi.MemoryReadU8(0, 0)
        PRINT uxcapi.MemoryRealloc(0, 0)
        PRINT uxcapi.MemoryWriteF32(0, 0, 0.0)
        PRINT uxcapi.MemoryWriteF64(0, 0, 0.0)
        PRINT uxcapi.MemoryWriteI16(0, 0, 0)
        PRINT uxcapi.MemoryWriteI32(0, 0, 0)
        PRINT uxcapi.MemoryWriteI64(0, 0, 0)
        PRINT uxcapi.MemoryWriteI8(0, 0, 0)
        PRINT uxcapi.MemoryWritePtr(0, 0, 0)
        PRINT uxcapi.MemoryWriteString(0, 0, "", 0)
        PRINT uxcapi.MemoryWriteU16(0, 0, 0)
        PRINT uxcapi.MemoryWriteU32(0, 0, 0)
        PRINT uxcapi.MemoryWriteU64(0, 0, 0)
        PRINT uxcapi.MemoryWriteU8(0, 0, 0)
        PRINT uxcapi.MemoryZero(0, 0)
        PRINT uxcapi.ResultF64(0)
        PRINT uxcapi.ResultI32(0)
        PRINT uxcapi.ResultI64(0)
        PRINT uxcapi.ResultPtr(0)
        PRINT uxcapi.ResultString(0)
        PRINT uxcapi.ResultU32(0)
        PRINT uxcapi.ResultU64(0)
        uxcapi.Shutdown()
        PRINT uxcapi.SymbolAddress("", "")
    END IF
    PRINT "PASS_LIBRARY_SURFACE_UXCAPI"
END MAIN
