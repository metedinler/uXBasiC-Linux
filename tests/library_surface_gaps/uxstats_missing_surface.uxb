INCLUDE "include/modules/uxstats.uxmh"
INCLUDE "include/modules/uxstats2.uxmh"

MAIN
    IF FALSE THEN
        PRINT UXSTATS2_ADFP(0)
        PRINT UXSTATS2_ADFStat(0)
        PRINT UXSTATS2_AncovaBinaryF(0, 0, 0, 0.0, 0.0)
        PRINT UXSTATS2_AncovaBinaryP(0, 0, 0, 0.0, 0.0)
        PRINT UXSTATS2_AnovaOneWayF(0, 0)
        PRINT UXSTATS2_BreuschGodfreyLM(0, 0)
        PRINT UXSTATS2_BreuschGodfreyP(0, 0)
        PRINT UXSTATS2_ChiSquare2x2P(0.0, 0.0, 0.0, 0.0)
        PRINT UXSTATS2_ChiSquare2x2Stat(0.0, 0.0, 0.0, 0.0)
        PRINT UXSTATS2_ChiSquareGOFP(0, 0)
        PRINT UXSTATS2_ChiSquareGOFStat(0, 0)
        PRINT UXSTATS2_ChiSquareP(0.0, 0.0)
        PRINT UXSTATS2_CovarianceSamp(0, 0)
        PRINT UXSTATS2_DurbinWatson(0)
        PRINT UXSTATS2_FP(0.0, 0.0, 0.0)
        PRINT UXSTATS2_FVarianceP(0, 0)
        PRINT UXSTATS2_FVarianceStat(0, 0)
        PRINT UXSTATS2_HotellingP_2D(0, 0, 0, 0.0, 0.0)
        PRINT UXSTATS2_HotellingT2_2D(0, 0, 0, 0.0, 0.0)
        PRINT UXSTATS2_NormalCDF(0.0)
        PRINT UXSTATS2_NormalP2(0.0)
        PRINT UXSTATS2_OnePropZP(0, 0, 0.0)
        PRINT UXSTATS2_OnePropZStat(0, 0, 0.0)
        PRINT UXSTATS2_OneSampleTStat(0, 0.0)
        PRINT UXSTATS2_OneSampleZP(0, 0.0, 0.0)
        PRINT UXSTATS2_OneSampleZStat(0, 0.0, 0.0)
        PRINT UXSTATS2_PairedTP(0, 0)
        PRINT UXSTATS2_PairedTStat(0, 0)
        PRINT UXSTATS2_PooledTP(0, 0)
        PRINT UXSTATS2_PooledTStat(0, 0)
        PRINT UXSTATS2_PosthocBonferroniTP(0, 0, 0.0, 0.0, 0)
        PRINT UXSTATS2_PosthocScheffeF(0, 0, 0.0, 0.0)
        PRINT UXSTATS2_PosthocTukeyQ(0, 0, 0.0, 0.0)
        PRINT UXSTATS2_RegressionF(0, 0)
        PRINT UXSTATS2_RegressionFP(0, 0)
        PRINT UXSTATS2_RegressionIntercept(0, 0)
        PRINT UXSTATS2_RegressionR2(0, 0)
        PRINT UXSTATS2_RegressionSlope(0, 0)
        PRINT UXSTATS2_TP2(0.0, 0.0)
        PRINT UXSTATS2_TwoPropZP(0, 0, 0, 0)
        PRINT UXSTATS2_TwoPropZStat(0, 0, 0, 0)
        PRINT UXSTATS2_TwoSampleZP(0, 0, 0.0, 0.0)
        PRINT UXSTATS2_TwoSampleZStat(0, 0, 0.0, 0.0)
        PRINT UXSTATS2_VIFPair(0, 0)
        PRINT UXSTATS2_VecCount(0)
        PRINT UXSTATS2_VecGet(0, 0)
        PRINT UXSTATS2_VecSet(0, 0, 0.0)
        PRINT UXSTATS2_Version()
        PRINT UXSTATS2_WelchTStat(0, 0)
    END IF
    PRINT "PASS_LIBRARY_SURFACE_UXSTATS"
END MAIN
