' S-079: SIZEOF is the PAYLOAD size, from one ABI table, in every engine.
PRINT SIZEOF(I8)
PRINT SIZEOF(U16)
PRINT SIZEOF(I32)
PRINT SIZEOF(I64)
PRINT SIZEOF(F32)
PRINT SIZEOF(F64)
PRINT SIZEOF(F80)
PRINT SIZEOF(PTR)
TYPE P
X AS I32
Y AS F64
END TYPE
PRINT SIZEOF(P)
DIM a(9) AS I32
PRINT SIZEOF(a)
DIM e(3) AS F80
PRINT SIZEOF(e)
DIM d(2) AS F64
PRINT SIZEOF(d)
