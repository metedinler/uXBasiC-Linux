CLASS Kutu
    PUBLIC
    DIM v AS I32
    CONSTRUCTOR(a AS I32)
        v = a
    END CONSTRUCTOR
    DESTRUCTOR()
        PRINT 7
    END DESTRUCTOR
    SUB Say()
        PRINT v
    END SUB
END CLASS

' S-574 / S-472: reading a field through a dead alias is a clear run-time error (the object was destroyed), never stale data.
DIM a AS Kutu = NEW Kutu(3)
DIM b AS Kutu = a
DELETE a
PRINT b.v
