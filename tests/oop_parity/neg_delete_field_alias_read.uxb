CLASS Ic
    PUBLIC
    DIM n AS I32
    DESTRUCTOR()
        PRINT 5
    END DESTRUCTOR
END CLASS
CLASS Kap
    PUBLIC
    DIM ic AS Ic
    DIM n AS I32
END CLASS
' S-615 / S-574: reading through the dead alias of a DELETEd field is the null-object error.
DIM c AS Kap = NEW Kap()
c.ic = NEW Ic()
DIM keep AS Ic = c.ic
DELETE c.ic
PRINT keep.n
