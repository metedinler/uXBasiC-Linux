' S-484: a bare call of a virtual method inside a base-class method is a virtual call (template method pattern).
CLASS Taban
    PUBLIC
    VIRTUAL METHOD Adim() AS I32
        RETURN 1
    END METHOD
    METHOD Toplam() AS I32
        RETURN Adim() + Adim()
    END METHOD
END CLASS
CLASS Alt EXTENDS Taban
    PUBLIC
    OVERRIDE METHOD Adim() AS I32
        RETURN 5
    END METHOD
END CLASS
DIM x AS Alt = NEW Alt()
PRINT x.Toplam()
DIM y AS Taban = NEW Taban()
PRINT y.Toplam()
