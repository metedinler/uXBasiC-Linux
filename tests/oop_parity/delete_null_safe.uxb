CLASS Kutu
    PUBLIC
    DIM v AS I32
    CONSTRUCTOR(a AS I32)
        v = a
    END CONSTRUCTOR
    DESTRUCTOR()
        PRINT 7
    END DESTRUCTOR
END CLASS

' S-574: DELETE of an empty reference (never assigned, or NOTHING) is harmless on every engine.
DIM k AS Kutu
DELETE k
k = NOTHING
DELETE k
PRINT 5
