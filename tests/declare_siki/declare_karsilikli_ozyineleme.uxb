' S-544: mutual recursion: the routine defined later is announced with DECLARE first.
DECLARE FUNCTION Cift(n AS I32) AS I32
FUNCTION Tek(n AS I32) AS I32
    IF n = 0 THEN RETURN 0
    RETURN Cift(n - 1)
END FUNCTION
FUNCTION Cift(n AS I32) AS I32
    IF n = 0 THEN RETURN 1
    RETURN Tek(n - 1)
END FUNCTION
PRINT Cift(10)
PRINT Tek(7)
PRINT Cift(7)
