FUNCTION Small() AS I8
  RETURN -128
END FUNCTION
FUNCTION WholeToFloat() AS F64
  RETURN 7
END FUNCTION
FUNCTION RoundedFloat() AS F32
  RETURN 0.3333333333333333
END FUNCTION
FUNCTION Wide() AS I64
  RETURN 2147483648
END FUNCTION
FUNCTION TextValue() AS STRING
  RETURN "typed"
END FUNCTION
PRINT Small()
PRINT WholeToFloat()
PRINT RoundedFloat()
PRINT Wide()
PRINT TextValue()
