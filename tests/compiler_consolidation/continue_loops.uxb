' Every CONTINUE must advance, preserve the matching loop, and skip the remainder.
DIM i AS I32
DIM j AS I32
FOR i = 1 TO 5
    IF i = 3 THEN CONTINUE
    PRINT i
NEXT i
FOR i = 3 TO 1 STEP -1
    IF i = 2 THEN CONTINUE FOR
    PRINT i + 10
NEXT i
i = 0
DO
    i += 1
    IF i < 3 THEN CONTINUE DO
    PRINT i + 20
LOOP UNTIL i = 3
i = 0
WHILE i < 3
    i += 1
    DO
        CONTINUE WHILE
        PRINT 999
    LOOP
    PRINT 998
WEND
PRINT i + 30
FOR i = 1 TO 2
    j = 0
    DO
        j += 1
        CONTINUE FOR
        PRINT 997
    LOOP
    PRINT 996
NEXT i
PRINT i + j + 40
FOR EACH i IN 1, 2, 3
    IF i = 2 THEN CONTINUE
    PRINT i + 50
NEXT
DO EACH i IN 1, 2, 3
    IF i = 2 THEN CONTINUE DO
    PRINT i + 60
LOOP
