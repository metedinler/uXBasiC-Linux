%%DEFINE CASE_ID 27
%%IF CASE_ID
PRINT "PP_OK"
%%ENDIF
DIM a AS I32
DIM b AS I64
DIM c AS F64
DIM s AS STRING
a = CASE_ID
b = 100
c = 3.14
s = "taz"
DECLARE FUNCTION puts CDECL LIB "msvcrt.dll" ALIAS "puts" (BYVAL x AS STRPTR) AS I32
PRINT ABS(-5)
PRINT LEN(s)
PRINT UCASE(s)
PRINT STR(a)
PRINT VAL("12")
