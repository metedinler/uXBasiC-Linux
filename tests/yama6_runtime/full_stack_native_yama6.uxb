PIPE Donustur deger AS I32
    PRINT "PIPE_RUN"
    PRINT INPUT
    RETURN INPUT
END PIPE

THREAD Isci
    PRINT "THREAD_RUN"
END THREAD

PARALEL Grup
    PRINT "PARALEL_RUN"
END PARALEL

EVENT VeriGeldi
    PRINT "EVENT_INPUT"
    PRINT INPUT
END EVENT

EVENT Kapali
    PRINT "SHOULD_NOT_PRINT"
END EVENT

SLOT
    Hat 7 ON PIPE Donustur
    Is 8 ON THREAD Isci
    Par 9 ON PARALEL Grup
    Kaydet 5 ON EVENT VeriGeldi
    S1 10 OFF EVENT Kapali
END SLOT

TRIGGER Donustur, 3
TRIGGER Isci
TRIGGER Grup
TRIGGER VeriGeldi, 42
TRIGGER Kapali

DIM cevap AS STRING
DIM hata AS STRING
DIM kod AS I32
SHELL "cmd /c echo SHELL_OK" TIMEOUT 10000 OUTVAR cevap ERRVAR hata CODEVAR kod
PRINT cevap
PRINT kod
PRINT "FULL_STACK_DONE"
