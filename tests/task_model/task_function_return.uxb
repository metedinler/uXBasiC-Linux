' S-030: TASK donduren FUNCTION'un sonucu dogrudan alici olabilir.
THREAD Worker(x AS I32)
    RETURN x + 100
END THREAD

FUNCTION Start(v AS I32) AS TASK
    DIM t AS TASK = SPAWN Worker(v)
    RETURN t
END FUNCTION

PRINT Start(5).JOIN()
' Faz 2A: gercek eszamanlilikta STATUS ancak WAIT/JOIN sonrasi kesindir (senkron referansta gorev SPAWN aninda biter).
DIM s6 AS TASK = Start(6)
s6.WAIT()
PRINT s6.STATUS
DIM k AS TASK
k = Start(7)
PRINT k.RESULT
