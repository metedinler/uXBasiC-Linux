PIPE Donustur deger AS I32
    PRINT "PIPE_RUN"
    PRINT INPUT
    RETURN INPUT
END PIPE

THREAD Isci
    PRINT "THREAD_RUN"
END THREAD

PARALEL Grup
    PRINT "PARALEL_RUN"
END PARALEL

SLOT
    Hat 7 ON PIPE Donustur
    Is  8 ON THREAD Isci
    Par 9 ON PARALEL Grup
END SLOT

TRIGGER Donustur, 3
TRIGGER Isci
TRIGGER Grup
