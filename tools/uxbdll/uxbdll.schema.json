{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "uXBasic DLL product manifest",
  "type": "object",
  "required": ["name", "build_dir", "exports"],
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "project_root": {"type": "string"},
    "build_dir": {"type": "string"},
    "output_dir": {"type": "string"},
    "dll_name": {"type": "string", "pattern": "\\.dll$"},
    "namespace": {"type": "string"},
    "wrapper_bas": {"type": "string"},
    "wrapper_uxmh": {"type": "string"},
    "build_program": {"type": "boolean"},
    "runtime_dependencies": {"type": "array", "items": {"type": "string"}},
    "linker_flags": {"type": "array", "items": {"type": "string"}},
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["public", "internal", "return"],
        "properties": {
          "public": {"type": "string"},
          "internal": {"type": "string"},
          "return": {"type": "string"},
          "wrapper_return": {"type": "string"},
          "calling_convention": {"type": "string"},
          "args": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {"type": "string"},
                    "type": {"type": "string"},
                    "uxb_type": {"type": "string"}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
