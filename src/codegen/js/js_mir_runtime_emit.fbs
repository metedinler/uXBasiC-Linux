#ifndef UXB_JS_MIR_RUNTIME_EMIT_FBS
#define UXB_JS_MIR_RUNTIME_EMIT_FBS

#include once "runtime/js_runtime_writer.fbs"

Public Function UXBJsEmitPreamble(ByRef wasmPath As String) As String
    Dim outText As String
    outText = UXBJsRuntimeText() & Chr(10)
    outText &= "const uxb = globalThis.uxb;" & Chr(10)
    outText &= "if (!uxb || !uxb.compat) throw new Error('UXB_GLOBALTHIS_UXB_RUNTIME_MISSING');" & Chr(10)
    outText &= "const ux = uxb.compat;" & Chr(10)
    If Trim(wasmPath) <> "" Then
        outText &= "async function loadUxWasm(path) {" & Chr(10)
        outText &= "  const response = await fetch(path);" & Chr(10)
        outText &= "  if (!response.ok) throw new Error('WASM load failed: ' + response.status);" & Chr(10)
        outText &= "  const loaded = await WebAssembly.instantiate(await response.arrayBuffer(), {});" & Chr(10)
        outText &= "  return loaded.instance.exports;" & Chr(10)
        outText &= "}" & Chr(10)
    End If
    outText &= Chr(10)
    Return outText
End Function

Public Function UXBJsEmitMainFooter() As String
    Return "if (!globalThis.uxb || globalThis.uxb.autoRun !== false) { main().catch(err => { if (err && err.uxbProgramEnd) return; const message = 'uXBasic runtime error: ' + (err && err.message ? err.message : String(err)); if (globalThis.uxb && globalThis.uxb.console) globalThis.uxb.console.println(message); else if (typeof console !== 'undefined' && console.error) console.error(err); if (typeof process !== 'undefined' && process) process.exitCode = 1; else throw err; }); }" & Chr(10)
End Function

#endif
