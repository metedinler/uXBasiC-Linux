#ifndef UXB_WAT_MEMORY_FBS
#define UXB_WAT_MEMORY_FBS

Function UXBWatDefaultMemory() As String
    Dim s As String
    ' Pages 0-15 are the VIRTUAL sandbox, page 16 is the read-sequence
    ' scratch area, and pages 17-19 reserve compile-time UNION cells.
    ' UNION roots are assigned 256-byte cells starting at 1114112 by the
    ' emitter. Keeping this space outside VIRTUAL prevents overlay writes
    ' from changing user-visible raw memory.
    s = "  (memory $memory 20)" & Chr(10)
    s &= "  (export " & Chr(34) & "memory" & Chr(34) & " (memory $memory))" & Chr(10)
    ' S-070: the low 1 MiB of linear memory is the VIRTUAL sandbox (the 64K
    ' scratch page above it belongs to read_sequence). Its usable size starts
    ' at the full 1 MiB and is narrowed by the VIRTUAL statement, matching
    ' the other engines' bounded-VIRTUAL behavior. AUTO(0)/VIRTUAL(1) are
    ' bounds-checked; NATIVE(2) is rejected by every helper (wasm has no
    ' process memory). A violation traps (unreachable) instead of silently
    ' reading/writing past the region.
    s &= "  (global $uxb_mem_virtual_size (mut i32) (i32.const 1048576))" & Chr(10)
    s &= "  (func $uxb_mem_check (param $mode i32) (param $addr i32) (param $len i64)" & Chr(10)
    s &= "    (if (i32.ne (local.get $mode) (i32.const 2)) (then" & Chr(10)
    s &= "      (if (i64.gt_u (i64.add (i64.extend_i32_u (local.get $addr)) (local.get $len)) (i64.extend_i32_u (global.get $uxb_mem_virtual_size))) (then unreachable))))" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_virtual_init (param $total i32) (result i32)" & Chr(10)
    s &= "    (memory.fill (i32.const 0) (i32.const 0) (i32.const 1048576))" & Chr(10)
    s &= "    (global.set $uxb_mem_virtual_size (local.get $total))" & Chr(10)
    s &= "    i32.const 1" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_load (param $mode i32) (param $addr i32) (param $width i32) (result i32)" & Chr(10)
    s &= "    (if (i32.eq (local.get $mode) (i32.const 2)) (then unreachable))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $addr) (i64.extend_i32_u (local.get $width)))" & Chr(10)
    s &= "    (if (result i32) (i32.eq (local.get $width) (i32.const 1))" & Chr(10)
    s &= "      (then (i32.load8_u (local.get $addr)))" & Chr(10)
    s &= "      (else (if (result i32) (i32.eq (local.get $width) (i32.const 2))" & Chr(10)
    s &= "        (then (i32.load16_u (local.get $addr)))" & Chr(10)
    s &= "        (else (if (result i32) (i32.eq (local.get $width) (i32.const 4))" & Chr(10)
    s &= "          (then (i32.load (local.get $addr)))" & Chr(10)
    s &= "          (else unreachable))))))" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_store (param $mode i32) (param $addr i32) (param $value i32) (param $width i32) (result i32)" & Chr(10)
    s &= "    (if (i32.eq (local.get $mode) (i32.const 2)) (then unreachable))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $addr) (i64.extend_i32_u (local.get $width)))" & Chr(10)
    s &= "    (if (i32.eq (local.get $width) (i32.const 1))" & Chr(10)
    s &= "      (then (i32.store8 (local.get $addr) (local.get $value)))" & Chr(10)
    s &= "      (else (if (i32.eq (local.get $width) (i32.const 2))" & Chr(10)
    s &= "        (then (i32.store16 (local.get $addr) (local.get $value)))" & Chr(10)
    s &= "        (else (if (i32.eq (local.get $width) (i32.const 4))" & Chr(10)
    s &= "          (then (i32.store (local.get $addr) (local.get $value)))" & Chr(10)
    s &= "          (else unreachable))))))" & Chr(10)
    s &= "    i32.const 1" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_copy (param $mode i32) (param $src i32) (param $dst i32) (param $count i32) (param $width i32) (result i32)" & Chr(10)
    s &= "    (if (i32.eq (local.get $mode) (i32.const 2)) (then unreachable))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $src) (i64.mul (i64.extend_i32_u (local.get $count)) (i64.extend_i32_u (local.get $width))))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $dst) (i64.mul (i64.extend_i32_u (local.get $count)) (i64.extend_i32_u (local.get $width))))" & Chr(10)
    s &= "    (memory.copy (local.get $dst) (local.get $src) (i32.mul (local.get $count) (local.get $width)))" & Chr(10)
    s &= "    i32.const 1" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_fill (param $mode i32) (param $dst i32) (param $value i32) (param $count i32) (param $width i32) (result i32)" & Chr(10)
    s &= "    (local $i i32)" & Chr(10)
    s &= "    (if (i32.eq (local.get $mode) (i32.const 2)) (then unreachable))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $dst) (i64.mul (i64.extend_i32_u (local.get $count)) (i64.extend_i32_u (local.get $width))))" & Chr(10)
    s &= "    i32.const 0" & Chr(10)
    s &= "    local.set $i" & Chr(10)
    s &= "    block $done" & Chr(10)
    s &= "      loop $fill" & Chr(10)
    s &= "        (br_if $done (i32.ge_u (local.get $i) (local.get $count)))" & Chr(10)
    s &= "        (if (i32.eq (local.get $width) (i32.const 1)) (then" & Chr(10)
    s &= "          (i32.store8 (i32.add (local.get $dst) (local.get $i)) (local.get $value))" & Chr(10)
    s &= "        ) (else (if (i32.eq (local.get $width) (i32.const 2)) (then" & Chr(10)
    s &= "          (i32.store16 (i32.add (local.get $dst) (i32.mul (local.get $i) (i32.const 2))) (local.get $value))" & Chr(10)
    s &= "        ) (else (if (i32.eq (local.get $width) (i32.const 4)) (then" & Chr(10)
    s &= "          (i32.store (i32.add (local.get $dst) (i32.mul (local.get $i) (i32.const 4))) (local.get $value))" & Chr(10)
    s &= "        ) (else unreachable))))))" & Chr(10)
    s &= "        (local.set $i (i32.add (local.get $i) (i32.const 1)))" & Chr(10)
    s &= "        br $fill" & Chr(10)
    s &= "      end" & Chr(10)
    s &= "    end" & Chr(10)
    s &= "    i32.const 1" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_read_sequence (param $mode i32) (param $addr i32) (param $length i32) (result i32)" & Chr(10)
    s &= "    (if (i32.eq (local.get $mode) (i32.const 2)) (then unreachable))" & Chr(10)
    s &= "    (if (i32.gt_u (local.get $length) (i32.const 65535)) (then unreachable))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $addr) (i64.extend_i32_u (local.get $length)))" & Chr(10)
    s &= "    (memory.copy (i32.const 1048576) (local.get $addr) (local.get $length))" & Chr(10)
    s &= "    (i32.store8 (i32.add (i32.const 1048576) (local.get $length)) (i32.const 0))" & Chr(10)
    s &= "    i32.const 1048576" & Chr(10)
    s &= "  )" & Chr(10)
    s &= "  (func $uxb_mem_write_sequence (param $mode i32) (param $dst i32) (param $src i32) (param $length i32) (result i32)" & Chr(10)
    s &= "    (if (i32.eq (local.get $mode) (i32.const 2)) (then unreachable))" & Chr(10)
    s &= "    (call $uxb_mem_check (local.get $mode) (local.get $dst) (i64.extend_i32_u (local.get $length)))" & Chr(10)
    s &= "    (memory.copy (local.get $dst) (local.get $src) (local.get $length))" & Chr(10)
    s &= "    i32.const 1" & Chr(10)
    s &= "  )" & Chr(10)
    Return s
End Function

#endif
