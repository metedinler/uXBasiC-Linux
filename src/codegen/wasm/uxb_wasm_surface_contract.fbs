Function UXBWasmSurfaceTargetStatus(ByRef surfaceText As String) As String
    Dim s As String
    s = UCase(Trim(surfaceText))
    Select Case s
    Case "CALL_DLL", "CALL(API)", "CALL(DLL)", "CALL_API", "DECLARE LIB", "DECLARE_LIB", "DLL", "API", "INLINE ASM", "ASM", "PEEK", "PEEKB", "PEEKW", "PEEKD", "PEEKQ", "POKE", "POKEB", "POKEW", "POKED", "POKEQ", "POKES", "MEMCOPYB", "MEMCOPYW", "MEMCOPYD", "MEMCOPYQ", "MEMFILLB", "MEMFILLW", "MEMFILLD", "MEMFILLQ"
        Return "NATIVE_ONLY_UNSUPPORTED_ON_WASM"
    Case "HOST", "HOST_CALL", "WASM_IMPORT", "BROWSER", "CANVAS", "WEBGPU", "HTTP", "FETCH", "GETKEY", "INKEY", "INPUT", "PRINT", "CLS", "LOCATE", "COLOR"
        Return "HOST_IMPORT_REQUIRED"
    Case "JS_CALL", "BROWSER_CALL"
        Return "SHIM_REQUIRED"
    End Select

    Dim layerStatus As String
    layerStatus = UXBWasmSurfaceContractStatus(surfaceText)
    If layerStatus = "MISSING" Then Return "SHIM_REQUIRED"
    Return "SUPPORTED"
End Function

Private Function UXBWasmSurfaceCsvEscape(ByRef rawText As String) As String
    Dim t As String
    t = rawText
    Dim outText As String
    outText = ""
    Dim i As Integer
    For i = 1 To Len(t)
        Dim ch As String
        ch = Mid(t, i, 1)
        If ch = Chr(34) Then outText &= Chr(34) & Chr(34) Else outText &= ch
    Next i
    Return Chr(34) & outText & Chr(34)
End Function

Function UXBWasmSurfaceMatrixCsv(ByRef csvOut As String) As Integer
    Dim items(0 To 15) As String
    items(0) = "CALL(DLL)"
    items(1) = "CALL(API)"
    items(2) = "DECLARE_LIB"
    items(3) = "INLINE ASM"
    items(4) = "PEEK"
    items(5) = "POKE"
    items(6) = "MEMCOPYB"
    items(7) = "MEMFILLB"
    items(8) = "PRINT"
    items(9) = "INPUT"
    items(10) = "GETKEY"
    items(11) = "INKEY"
    items(12) = "JS_CALL"
    items(13) = "BROWSER_CALL"
    items(14) = "WASM_IMPORT"
    items(15) = "HOST_CALL"
    csvOut = "surface,target_status,layer_status,diagnostic" & Chr(10)
    Dim i As Integer
    For i = 0 To 15
        Dim st As String
        st = UXBWasmSurfaceTargetStatus(items(i))
        csvOut &= UXBWasmSurfaceCsvEscape(items(i)) & "," & UXBWasmSurfaceCsvEscape(st) & "," & UXBWasmSurfaceCsvEscape(UXBWasmSurfaceContractStatus(items(i))) & ","
        If st = "NATIVE_ONLY_UNSUPPORTED_ON_WASM" Then
            csvOut &= UXBWasmSurfaceCsvEscape("UXB_WASM_OPCODE_UNSUPPORTED")
        Else
            csvOut &= UXBWasmSurfaceCsvEscape("")
        End If
        csvOut &= Chr(10)
    Next i
    Return 1
End Function


