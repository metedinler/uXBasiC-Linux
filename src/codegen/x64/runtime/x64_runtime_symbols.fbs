#ifndef UXB_X64_RUNTIME_SYMBOLS_FBS
#define UXB_X64_RUNTIME_SYMBOLS_FBS

Function UXBX64RuntimeSymbol(ByVal serviceName As String) As String
    Dim s As String
    s = UCase(Trim(serviceName))
    Select Case s
    Case "PRINT", "RT_PRINT", "PRINT_I64": Return "__uxb_rt_print_i64"
    Case "PRINT_CSTR", "RT_PRINT_CSTR": Return "__uxb_rt_print_cstr"
    Case "PRINTLN", "NEWLINE", "RT_PRINT_NEWLINE": Return "__uxb_rt_print_newline"
    Case "INPUT", "RT_INPUT", "INPUT_I64": Return "__uxb_rt_input_i64"
    Case "CLS", "RT_CLS": Return "__uxb_rt_cls"
    Case "LOCATE", "RT_LOCATE": Return "__uxb_rt_locate"
    Case "COLOR", "RT_COLOR": Return "__uxb_rt_color"
    Case "GETKEY", "RT_GETKEY": Return "__uxb_rt_getkey_i64"
    Case "INKEY", "RT_INKEY": Return "__uxb_rt_inkey_i64"
    Case "RND", "RT_RND": Return "__uxb_rt_rnd_i64"
    Case "TIMER", "RT_TIMER": Return "__uxb_rt_timer_f64"   ' S-624: F64 (XMM0)
    Case "RANDOMIZE", "RT_RANDOMIZE": Return "__uxb_rt_randomize"
    Case "STR_LEN", "LEN", "RT_STR_LEN": Return "__uxb_rt_strlen"
    Case "VAL", "RT_VAL": Return "__uxb_rt_val_i64"
    Case "STR", "STR$", "RT_STR": Return "__uxb_rt_str_i64"
    Case "LEFT", "LEFT$": Return "__uxb_rt_left"
    Case "RIGHT", "RIGHT$": Return "__uxb_rt_right"
    Case "MID", "MID$": Return "__uxb_rt_mid"
    Case "INSTR": Return "__uxb_rt_instr"
    Case "STR_CONCAT", "CONCAT": Return "__uxb_rt_str_concat"
    Case "STR_COMPARE": Return "__uxb_rt_str_compare"
    Case "MEM_COPY", "MEMCOPY", "RT_MEM_COPY": Return "__uxb_rt_memcopy"
    Case "MEM_FILL", "MEMFILL", "RT_MEM_FILL": Return "__uxb_rt_memfill"
    Case "PEEK": Return "__uxb_rt_peek_i64"
    Case "MEM_READ_SEQUENCE", "RT_MEM_READ_SEQUENCE": Return "__uxb_rt_mem_read_sequence"
    Case "MEM_WRITE_SEQUENCE", "RT_MEM_WRITE_SEQUENCE": Return "__uxb_rt_mem_write_sequence"
    Case "POKE": Return "__uxb_rt_poke_i64"
    Case "FILE_OPEN", "OPEN", "RT_FILE_OPEN": Return "__uxb_rt_file_open"
    Case "FILE_CLOSE", "CLOSE", "RT_FILE_CLOSE": Return "__uxb_rt_file_close"
    Case "FILE_SEEK", "SEEK": Return "__uxb_rt_file_seek"
    Case "FILE_EOF", "EOF": Return "__uxb_rt_file_eof"
    Case "FILE_LOF", "LOF": Return "__uxb_rt_file_lof"
    Case "FILE_GET", "GET": Return "__uxb_rt_file_get"
    Case "FILE_PUT", "PUT": Return "__uxb_rt_file_put"
    Case "FILE_DELETE", "DELETE_FILE", "KILL": Return "__uxb_rt_file_delete"
    Case "HOST", "RT_HOST_CALL", "LIBRARY", "RT_LIBRARY_CALL": Return "__uxb_rt_host_call4"
    End Select
    Return "__uxb_rt_host_call4"
End Function

Function UXBX64RuntimeExternBlock() As String
    Dim s As String
    s = "extern __uxb_rt_print_i64" & Chr(10)
    s &= "extern __uxb_rt_print_cstr" & Chr(10)
    s &= "extern __uxb_rt_print_newline" & Chr(10)
    s &= "extern __uxb_rt_input_i64" & Chr(10)
    s &= "extern __uxb_rt_cls" & Chr(10)
    s &= "extern __uxb_rt_locate" & Chr(10)
    s &= "extern __uxb_rt_color" & Chr(10)
    s &= "extern __uxb_rt_getkey_i64" & Chr(10)
    s &= "extern __uxb_rt_inkey_i64" & Chr(10)
    s &= "extern __uxb_rt_rnd_i64" & Chr(10)
    s &= "extern __uxb_rt_timer_i64" & Chr(10)
    s &= "extern __uxb_rt_timer_f64" & Chr(10)
    s &= "extern __uxb_rt_randomize" & Chr(10)
    s &= "extern __uxb_rt_strlen" & Chr(10)
    s &= "extern __uxb_rt_val_i64" & Chr(10)
    s &= "extern __uxb_rt_str_i64" & Chr(10)
    s &= "extern __uxb_rt_left" & Chr(10)
    s &= "extern __uxb_rt_right" & Chr(10)
    s &= "extern __uxb_rt_mid" & Chr(10)
    s &= "extern __uxb_rt_instr" & Chr(10)
    s &= "extern __uxb_rt_str_concat" & Chr(10)
    s &= "extern __uxb_rt_str_compare" & Chr(10)
    s &= "extern __uxb_rt_memcopy" & Chr(10)
    s &= "extern __uxb_rt_memfill" & Chr(10)
    s &= "extern __uxb_rt_peek_i64" & Chr(10)
    s &= "extern __uxb_rt_poke_i64" & Chr(10)
    s &= "extern __uxb_rt_mem_read_sequence" & Chr(10)
    s &= "extern __uxb_rt_mem_write_sequence" & Chr(10)
    s &= "extern __uxb_rt_file_open" & Chr(10)
    s &= "extern __uxb_rt_file_close" & Chr(10)
    s &= "extern __uxb_rt_file_seek" & Chr(10)
    s &= "extern __uxb_rt_file_eof" & Chr(10)
    s &= "extern __uxb_rt_file_lof" & Chr(10)
    s &= "extern __uxb_rt_file_get" & Chr(10)
    s &= "extern __uxb_rt_file_put" & Chr(10)
    s &= "extern __uxb_rt_file_delete" & Chr(10)
    s &= "extern __uxb_rt_host_call4" & Chr(10)
    Return s
End Function

#endif
