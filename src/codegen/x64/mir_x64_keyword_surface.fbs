#ifndef UXB_MIR_X64_KEYWORD_SURFACE_FBS
#define UXB_MIR_X64_KEYWORD_SURFACE_FBS

#include once "../../surface/uxb_surface_layer_bridge.fbs"

Function MIRX64KeywordCounterpartStatus(ByRef keywordText As String) As String
    Dim k As String = UCase(Trim(keywordText))
    If UXBSurfaceKnown(k) = 0 Then Return "missing_from_mir_x64_surface"
    Dim emitKind As String = UXBSurfaceX64EmitKind(k)
    Select Case emitKind
    Case "NO_EMIT": Return "compiletime_no_emit_or_type"
    Case "NATIVE_EMIT": Return "native_operator_or_punctuation"
    Case "RUNTIME_CALL": Return "native_runtime_or_builtin"
    Case "HOST_CALL": Return "native_runtime_host_or_library"
    Case "NATIVE": Return "native_only"
    End Select
    Return "native_runtime_guard"
End Function

Function MIRX64KeywordHasCounterpart(ByRef keywordText As String) As Integer
    Return UXBSurfaceKnown(keywordText)
End Function

Function MIRX64KeywordIsNativeReady(ByRef keywordText As String) As Integer
    If UXBSurfaceKnown(keywordText) = 0 Then Return 0
    Dim k As String = UXBSurfaceX64EmitKind(keywordText)
    If k = "MISSING" Then Return 0
    Return 1
End Function

Function MIRX64KeywordDiagnosticText(ByRef keywordText As String) As String
    If UXBSurfaceKnown(keywordText) = 0 Then Return "MIR x64 keyword surface not mapped: " & UCase(Trim(keywordText))
    Return ""
End Function

Function MIRX64KeywordSurfaceCount() As Integer
    Return UXBSurfaceKnownCount()
End Function

#endif


' ADIM07: canonical x64 MIR surface contract evidence bridge.
