#ifndef UXB_MIR_X64_SOURCE_EMIT_FBS
#define UXB_MIR_X64_SOURCE_EMIT_FBS

Function MIRX64AsmCommentEscape(ByRef s As String) As String
    Dim outText As String
    Dim i As Integer
    Dim ch As String
    outText = ""
    For i = 1 To Len(s)
        ch = Mid(s, i, 1)
        Select Case Asc(ch)
        Case 0 To 31, 127
            outText &= " "
        Case Else
            outText &= ch
        End Select
    Next i
    Return outText
End Function

Sub MIRX64EmitInstructionSourceComment(ByRef cg As MIRX64Context, ByRef ins As MIRIRInstruction)
    Dim c As String
    c = ""
    If Trim(ins.srcLoc.filePath) <> "" Then c &= Trim(ins.srcLoc.filePath)
    If ins.srcLoc.lineNo > 0 Then
        If c <> "" Then c &= ":"
        c &= LTrim(Str(ins.srcLoc.lineNo))
        If ins.srcLoc.colNo > 0 Then c &= ":" & LTrim(Str(ins.srcLoc.colNo))
    End If
    If Trim(ins.comment) <> "" Then
        If c <> "" Then c &= " "
        c &= Trim(ins.comment)
    End If
    If Trim(ins.srcLoc.lexemeSnippet) <> "" Then c &= " [" & Trim(ins.srcLoc.lexemeSnippet) & "]"
    If c <> "" Then MIRX64Emit cg, "    ; src " & MIRX64AsmCommentEscape(c)
End Sub

#endif
