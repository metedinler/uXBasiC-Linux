#ifndef UXB_MIR_X64_CAPABILITY_FBS
#define UXB_MIR_X64_CAPABILITY_FBS

#include once "mir_x64_keyword_surface.fbs"

Function MIRX64EmitterAvailable() As Integer
    Return 1
End Function

Function MIRX64CanonicalEmitterOpcode(ByRef opcodeText As String) As String
    Dim op As String
    op = UCase(Trim(opcodeText))
    If Left(op, 4) = "MIR_" Then op = Mid(op, 5)

    Select Case op
    Case "NOP": Return "NOP"
    Case "TRUE", "ONE": Return "TRUE"
    Case "FALSE", "ZERO": Return "FALSE"
    Case "MOVE", "ASSIGN": Return "MOVE"
    Case "LOAD_CONST": Return "LOAD_CONST"
    Case "CONST", "STRING_CONST": Return "CONST"
    Case "LOCAL_DECL", "GLOBAL_DECL", "PARAM_DECL", "DIM", "DECLARE", "AS": Return "DIM"
    Case "LOAD_LOCAL", "LOAD_GLOBAL", "LOAD_VAR", "LOAD": Return "LOAD_VAR"
    Case "STORE_LOCAL", "STORE_GLOBAL", "STORE_VAR", "STORE": Return "STORE_VAR"
    Case "+", "ADD": Return "ADD"
    Case "-", "SUB": Return "SUB"
    Case "*", "MUL": Return "MUL"
    Case "/", "DIV": Return "DIV"
    Case "\", "IDIV": Return "IDIV"
    Case "%", "MOD": Return "MOD"
    Case "&", "BAND", "BITAND": Return "AND"
    Case "BAND": Return "AND"
    Case "BOR", "|": Return "OR"
    Case "BXOR", "^XOR": Return "XOR"
    Case "BNOT", "!", "~", "BIT_NOT": Return "BIT_NOT"
    Case "++": Return "INC"
    Case "--": Return "DEC"
    Case "+=": Return "ADD_ASSIGN"
    Case "-=": Return "SUB_ASSIGN"
    Case "*=": Return "MUL_ASSIGN"
    Case "/=": Return "DIV_ASSIGN"
    Case "\=": Return "IDIV_ASSIGN"
    Case "%=": Return "MOD_ASSIGN"
    Case "<<", "SHL": Return "SHL"
    Case ">>", "SHR": Return "SHR"
    Case ">>>", "USHR": Return "USHR"
    Case "<<=": Return "SHL_ASSIGN"
    Case ">>=": Return "SHR_ASSIGN"
    Case "&=": Return "AND_ASSIGN"
    Case "|=": Return "OR_ASSIGN"
    Case "**", "POW": Return "POW"
    Case "^", "BXOR", "BITXOR": Return "XOR"
    Case "**=": Return "POW_ASSIGN"
    Case "^=": Return "XOR_ASSIGN"
    Case "=", "==": Return "EQ"
    Case "<>", "!=": Return "NE"
    Case "<": Return "LT"
    Case "<=": Return "LE"
    Case ">": Return "GT"
    Case ">=": Return "GE"
    Case "JMP_IF_FALSE", "JZ": Return "JZ"
    Case "JMP_IF_TRUE", "JNZ": Return "JNZ"
    Case "RETURN", "RET", "EXIT": Return "RET"
    Case "CALL_BUILTIN", "CALL_RUNTIME", "CALL_EXTERNAL", "CALL_USER": Return "CALL"
    Case "CALL_DLL": Return "CALL_DLL"
    Case "CALL_API": Return "CALL_API"
    Case "ARRAY_LOAD": Return "LOAD_INDEXED"
    Case "ARRAY_STORE": Return "STORE_INDEXED"
    Case "ARRAY_FIELD_LOAD": Return "MIR_ARRAY_FIELD_LOAD"
    Case "ARRAY_FIELD_STORE": Return "MIR_ARRAY_FIELD_STORE"
    Case "VIRTUAL_INIT": Return "VIRTUAL_INIT"
    Case "ARRAY_NEW", "ARRAY", "REDIM": Return "REDIM"
    Case "OBJECT_NEW", "NEW": Return "NEW"
    Case "METHOD_CALL": Return "METHOD_CALL"
    Case "VIRTUAL_CALL": Return "VIRTUAL_CALL"
    Case "DELETE_OBJECT", "DELETE": Return "DELETE_OBJECT"
    Case "FIELD_LOAD": Return "LOAD_FIELD"
    Case "FIELD_STORE": Return "STORE_FIELD"
    Case "UNION_FIELD_LOAD": Return "UNION_FIELD_LOAD"
    Case "UNION_FIELD_STORE": Return "UNION_FIELD_STORE"
    Case "MEMORY_READ_SEQUENCE", "PEEKS": Return "MEMORY_READ_SEQUENCE"
    Case "MEMORY_WRITE_SEQUENCE", "POKES": Return "MEMORY_WRITE_SEQUENCE"
    Case "MEMORY_LOAD", "MEM_LOAD", "PEEK", "PEEKB", "PEEKW", "PEEKD", "PEEKQ": Return "MEMORY_LOAD"
    Case "MEMORY_STORE", "MEM_STORE", "POKE", "POKEB", "POKEW", "POKED", "POKEQ", "POKES": Return "MEMORY_STORE"
    Case "MEMORY_COPY", "MEM_COPY", "MEMCOPY", "MEMCOPYB", "MEMCOPYW", "MEMCOPYD", "MEMCOPYQ": Return "MEMORY_COPY"
    Case "MEMORY_FILL", "MEM_FILL", "MEMFILL", "MEMFILLB", "MEMFILLW", "MEMFILLD", "MEMFILLQ": Return "MEMORY_FILL"
    Case "FILE_OPEN", "OPEN": Return "OPEN"
    Case "FILE_CLOSE", "CLOSE": Return "CLOSE"
    Case "FILE_READ", "GET": Return "GET"
    Case "FILE_WRITE", "PUT": Return "PUT"
    Case "FILE_SEEK", "SEEK": Return "SEEK"
    Case "FILE_DELETE": Return "DELETE_FILE"
    Case "FILE_EOF", "EOF": Return "EOF"
    Case "FILE_LOF", "LOF": Return "LOF"
    Case "STR_LEN": Return "LEN"
    Case "STR_LEFT": Return "LEFT"
    Case "STR_RIGHT": Return "RIGHT"
    Case "STR_MID": Return "MID"
    Case "STR_COMPARE": Return "STR_COMPARE"
    Case "CONCAT", "STR_CONCAT": Return "STR_CONCAT"
    Case "@", "ADDR_OF", "VARPTR", "SADD": Return "ADDR_OF"
    Case "CODEPTR": Return "CODEPTR"
    Case "LPTR": Return "LPTR"
    Case "SIZEOF": Return "SIZEOF"
    Case "OFFSETOF": Return "OFFSETOF"
    Case "TYPEOF": Return "TYPEOF"
    Case "TYPE_DECL", "CLASS_DECL", "METHOD_DECL", "INTERFACE_DECL", "PROPERTY_DECL", "OPERATOR_DECL", "CONSTRUCTOR_DECL", "DESTRUCTOR_DECL", "IMPLEMENTS_DECL": Return op
    Case "CLASS", "TYPE", "INTERFACE", "METHOD", "PROPERTY", "OPERATOR", "CONSTRUCTOR", "DESTRUCTOR", "IMPLEMENTS": Return op & "_DECL"
    Case "ABSTRACT", "FINAL", "SEALED": Return "COMPILE_TIME_CONTRACT"
    Case "ALIAS", "BYREF", "BYVAL", "CDECL", "FRIEND", "IMMUTABLE", "IMPORT", "INCLUDE", "MODULE", "MUTABLE", "NAMESPACE", "PRIVATE", "PROTECTED", "PUBLIC", "READONLY", "RESTRICTED", "STATIC", "STDCALL", "USING", "MAIN", "DEFBYT", "DEFDBL", "DEFEXT", "DEFINT", "DEFLNG", "DEFSNG", "DEFSTR", ".AST.JSON", ".BAS", ".BI", ".H", ".HX", ".JS", ".JSON", ".MIR.JSON", ".UXB", ".UXBASIC", ".UXM", ".UXMH", ".WASM", ".WAT": Return "METADATA_ONLY"
    Case "BOOLEAN", "BYTE", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64", "F80", "F128", "BALL", "BIGD", "BIGF", "BIGINT", "OBJECT", "PTR", "STRING", "STRPTR", "ANY", "VARIANT", "VOID", "LIST", "DICT", "SET": Return "TYPE_DECL"
    Case "CASE", "ELSE", "ELSEIF", "END", "FOR", "DO", "LOOP", "NEXT", "SELECT", "THEN", "TO", "STEP", "WHILE", "IN", "IS", "[", "]", "(", ")", ",", ":", ".": Return "METADATA_ONLY"
    Case "DECORATOR", "MAGIC", "MAGIC", "MIXIN", "OVERRIDE", "VIRTUAL", "PARALEL", "PARALEL", "THREAD": Return op
    Case "TRY": Return "TRY"
    Case "CATCH": Return "CATCH"
    Case "FINALLY": Return "FINALLY"
    Case "THROW": Return "THROW"
    Case "ASSERT": Return "ASSERT"
    Case "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER", "ON", "OFF": Return op
    Case "JSON", "REGEX", "HTTP", "OS", "STRINGX", "LLAMA", "LUA", "PROLOG", "SQLITE", "CURL", "CRYPTO", "ARCHIVE", "IMAGE", "AUDIO", "MATH", "GRAPHICS", "SERVER", "ONNX", "WEBGPU", "BROWSER", "CANVAS": Return "LIBRARY_CALL"
    Case "HOST_CALL", "LIBRARY_CALL", "JS_CALL", "BROWSER_CALL", "EXTFP_CALL", "WASM_IMPORT", "WASM_EXPORT": Return op
    Case "NATIVE_ONLY", "WASM_UNSUPPORTED", "DIAGNOSTIC_ONLY", "RESERVED_NODE", "BROKEN_NODE": Return op
    End Select

    Return op
End Function


Function MIRX64OpcodeHasEmitterRoute(ByRef opcodeText As String) As Integer
    Dim op As String
    op = MIRX64CanonicalEmitterOpcode(opcodeText)

    Select Case op
    Case "NOP", "METADATA_ONLY"
        Return 1
    Case "TRUE", "FALSE", "MOVE", "ASSIGN", "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "DIM", "REDIM", "CONST", "DEF_TYPE", "SETSTRINGSIZE"
        Return 1
    Case "ADD", "SUB", "MUL", "DIV", "IDIV", "MOD", "NEG", "INC", "DEC", "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB", "NOT", "BIT_NOT", "SHL", "SHR", "USHR", "UIDIV", "UMOD", "ULT", "ULE", "UGT", "UGE", "ROL", "ROR", "POW"
        Return 1
    Case "ADD_ASSIGN", "SUB_ASSIGN", "MUL_ASSIGN", "DIV_ASSIGN", "IDIV_ASSIGN", "MOD_ASSIGN", "SHL_ASSIGN", "SHR_ASSIGN", "AND_ASSIGN", "OR_ASSIGN", "XOR_ASSIGN", "POW_ASSIGN", "STR_CONCAT_ASSIGN"
        Return 1
    Case "FADD", "FSUB", "FMUL", "FDIV", "FNEG"
        Return 1
    Case "CAST", "COERCE", "CONV", "CONVERT", "TYPEOF", "SIZEOF", "OFFSETOF", "CODEPTR", "LPTR", "ADDR_OF", "LOAD_ADDR"
        Return 1
    Case "LABEL", "JMP", "JZ", "JNZ", "RET", "GOTO", "GOSUB", "FOR_EACH_BEGIN", "FOR_EACH_NEXT", "UNTIL_CHECK", "BREAK", "CONTINUE", "TRY", "CATCH", "FINALLY", "THROW", "ASSERT"
        Return 1
    Case "CALL", "CALL_USER", "METHOD_CALL", "VIRTUAL_CALL", "CALL_DLL", "CALL_API", "IMPORT", "INLINE", "HOST_CALL", "LIBRARY_CALL", "EXTFP_CALL"
        Return 1
    Case "PRINT", "INPUT", "INPUTF", "CLS", "COLOR", "LOCATE", "RANDOMIZE", "TIMER", "RND", "GETKEY", "INKEY", "ON", "OFF"
        Return 1
    Case "ASC", "CHR", "VAL", "STR", "CINT", "CLNG", "CSNG", "CDBL", "FIX", "INT", "SGN", "ABS", "SQR", "SQRT", "SIN", "COS", "TAN", "ATN", "LOG", "EXP", "LEN", "LCASE", "UCASE", "LTRIM", "RTRIM", "TRIM", "SPACE", "INSTR", "HEX", "OCT", "BIN", "BIGINIT"
        Return 1
    Case "STR_NEW", "STR_ASSIGN", "STR_CONCAT", "STR_COMPARE", "LEFT", "RIGHT", "MID"
        Return 1
    Case "LOAD_INDEXED", "STORE_INDEXED", "ARRAY_FIELD_LOAD", "ARRAY_FIELD_STORE", "MIR_ARRAY_FIELD_LOAD", "MIR_ARRAY_FIELD_STORE", "VIRTUAL_INIT", "MIR_VIRTUAL_INIT", "NEW", "LOAD_FIELD", "STORE_FIELD", "UNION_FIELD_LOAD", "UNION_FIELD_STORE", "TYPE_DECL", "CLASS_DECL", "INTERFACE_DECL", "METHOD_DECL", "PROPERTY_DECL", "OPERATOR_DECL", "CONSTRUCTOR_DECL", "DESTRUCTOR_DECL", "IMPLEMENTS_DECL", "DELETE_OBJECT"
        Return 1
    Case "MEMORY_LOAD", "MEMORY_STORE", "MEMORY_COPY", "MEMORY_FILL", "MEMORY_READ_SEQUENCE", "MEMORY_WRITE_SEQUENCE", "MEMORY_REF", "ARRAY_SIZEOF", "ARRAY_LBOUND", "ARRAY_UBOUND", "VARPTR", "MEMCOPY", "MEMFILL", "PEEK", "POKE", "SETNEWOFFSET"
        Return 1
    Case "OPEN", "CLOSE", "GET", "PUT", "SEEK", "DELETE", "DELETE_FILE", "EOF", "LOF", "PRINT_FILE", "INPUT_FILE", "LINE_INPUT_FILE"
        Return 1
    Case "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER"
        Return 1
    Case "DECORATOR", "MAGIC", "MIXIN", "OVERRIDE", "VIRTUAL", "PARALEL_HINT"
        Return 1
    End Select

    If UXBSurfaceKnown(op) <> 0 Then
        Dim emitKind As String
        emitKind = UXBSurfaceX64EmitKind(op)
        Select Case emitKind
        Case "NO_EMIT", "RUNTIME_CALL", "HOST_CALL"
            Return 1
        Case "NATIVE", "NATIVE_EMIT"
            Dim mappedOpcode As String
            mappedOpcode = UXBSurfaceMirOpcode(op)
            If mappedOpcode <> "" And UCase(Trim(mappedOpcode)) <> op Then Return MIRX64OpcodeHasEmitterRoute(mappedOpcode)
        End Select
    End If

    Return 0
End Function

Function MIRX64OpcodeSupported(ByRef opcodeText As String) As Integer
    Dim op As String
    op = MIRX64CanonicalEmitterOpcode(opcodeText)

    If MIRX64OpcodeHasEmitterRoute(op) <> 0 Then Return 1

    Select Case op
    Case "NOP", "MOVE", "ASSIGN", "LOAD_CONST", "LOAD_VAR", "STORE_VAR", "DIM", "CONST", "DEF_TYPE", "SETSTRINGSIZE", "METADATA_ONLY"
        Return 1
    Case "ADD", "SUB", "MUL", "DIV", "IDIV", "MOD", "NEG", "INC", "DEC", "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB", "NOT", "BIT_NOT", "SHL", "SHR", "USHR", "UIDIV", "UMOD", "ULT", "ULE", "UGT", "UGE", "ROL", "ROR", "POW", "STR_CONCAT"
        Return 1
    Case "ADD_ASSIGN", "SUB_ASSIGN", "MUL_ASSIGN", "DIV_ASSIGN", "IDIV_ASSIGN", "MOD_ASSIGN", "SHL_ASSIGN", "SHR_ASSIGN", "AND_ASSIGN", "OR_ASSIGN", "XOR_ASSIGN", "POW_ASSIGN", "STR_CONCAT_ASSIGN"
        Return 1
    Case "FADD", "FSUB", "FMUL", "FDIV", "FNEG"
        Return 1
    Case "CAST", "COERCE", "CONV", "CONVERT", "TYPEOF", "SIZEOF", "OFFSETOF", "CODEPTR", "LPTR", "ADDR_OF", "LOAD_ADDR"
        Return 1
    Case "LABEL", "JMP", "JZ", "JNZ", "RET", "FOR_EACH_BEGIN", "FOR_EACH_NEXT", "UNTIL_CHECK", "GOTO", "GOSUB", "BREAK", "CONTINUE", "TRY", "CATCH", "FINALLY", "THROW", "ASSERT"
        Return 1
    Case "CALL", "CALL_USER", "METHOD_CALL", "VIRTUAL_CALL", "CALL_DLL", "CALL_API", "IMPORT", "INLINE", "HOST_CALL", "LIBRARY_CALL", "EXTFP_CALL", "JS_CALL", "BROWSER_CALL", "WASM_IMPORT", "WASM_EXPORT"
        Return 1
    Case "PRINT", "INPUT", "INPUTF", "CLS", "COLOR", "LOCATE", "RANDOMIZE", "TIMER", "RND", "GETKEY", "INKEY", "ON", "OFF"
        Return 1
    Case "ASC", "CHR", "VAL", "STR", "CINT", "CLNG", "CSNG", "CDBL", "FIX", "INT", "SGN", "ABS", "SQR", "SQRT", "SIN", "COS", "TAN", "ATN", "LOG", "EXP", "LEN", "LCASE", "UCASE", "LTRIM", "RTRIM", "TRIM", "SPACE", "INSTR", "HEX", "OCT", "BIN", "BIGINIT"
        Return 1
    Case "STR_NEW", "STR_ASSIGN", "STR_CONCAT", "STR_COMPARE", "LEFT", "RIGHT", "MID"
        Return 1
    Case "LOAD_INDEXED", "STORE_INDEXED", "REDIM", "NEW", "LOAD_FIELD", "STORE_FIELD", "UNION_FIELD_LOAD", "UNION_FIELD_STORE", "METHOD_CALL", "VIRTUAL_CALL", "TYPE_DECL", "CLASS_DECL", "INTERFACE_DECL", "METHOD_DECL", "PROPERTY_DECL", "OPERATOR_DECL", "CONSTRUCTOR_DECL", "DESTRUCTOR_DECL", "IMPLEMENTS_DECL", "DELETE_OBJECT"
        Return 1
    Case "MEMORY_LOAD", "MEMORY_STORE", "MEMORY_COPY", "MEMORY_FILL", "MEMORY_READ_SEQUENCE", "MEMORY_WRITE_SEQUENCE", "MEMORY_REF", "ARRAY_SIZEOF", "ARRAY_LBOUND", "ARRAY_UBOUND", "VARPTR", "MEMCOPY", "MEMFILL", "PEEK", "POKE", "SETNEWOFFSET"
        Return 1
    Case "OPEN", "CLOSE", "GET", "PUT", "SEEK", "DELETE", "DELETE_FILE", "EOF", "LOF", "PRINT_FILE", "INPUT_FILE", "LINE_INPUT_FILE"
        Return 1
    Case "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER"
        Return 1
    Case "DECORATOR", "MAGIC", "MAGIC", "MIXIN", "OVERRIDE", "VIRTUAL", "PARALEL", "PARALEL", "THREAD", "PARALEL_HINT"
        Return 1
    Case "NATIVE_ONLY", "WASM_UNSUPPORTED", "DIAGNOSTIC_ONLY", "RESERVED_NODE", "BROKEN_NODE"
        Return 1
    End Select

    If MIRX64KeywordHasCounterpart(op) <> 0 Then Return 1
    Return 0
End Function

Function MIRX64CallTargetSupported(ByRef targetText As String) As Integer
    Dim t As String
    t = UCase(Trim(targetText))
    If t = "CSRLIN" Or t = "POS" Then Return 1

    Select Case t
    Case "PRINT", "PRINTLN", "CONSOLE_PRINT", "CONSOLE_PRINTLN", "PRINT_SEP_COMMA", "PRINT_SEP_SPACE", "PRINT_SEP_SEMICOLON"
        Return 1
    Case "CLS", "LOCATE", "COLOR", "INPUT", "INPUTF", "RANDOMIZE", "TIMER", "RND", "GETKEY", "INKEY", "ON", "OFF"
        Return 1
    Case "ABS", "INT", "FIX", "SGN", "CINT", "CLNG", "CSNG", "CDBL", "VAL", "LEN", "ASC", "CPLEN", "CHR", "CHR$", "STR", "STR$", "LEFT", "LEFT$", "RIGHT", "RIGHT$", "MID", "MID$", "INSTR", "LCASE", "LCASE$", "UCASE", "UCASE$", "LTRIM", "LTRIM$", "RTRIM", "RTRIM$", "TRIM", "TRIM$", "SPACE", "SPACE$", "HEX", "HEX$", "OCT", "OCT$", "BIN", "BIN$"
        Return 1
    Case "SQR", "SQRT", "SIN", "COS", "TAN", "ATN", "LOG", "EXP", "BIGINIT"
        Return 1
    Case "OPEN", "CLOSE", "EOF", "LOF", "SEEK", "GET", "PUT", "DELETE", "PRINT_FILE", "INPUT_FILE", "LINE_INPUT_FILE"
        Return 1
    Case "MEMORY_LOAD", "MEMORY_STORE", "MEMORY_COPY", "MEMORY_FILL", "MEMORY_READ_SEQUENCE", "MEMORY_WRITE_SEQUENCE", "MEMORY_REF", "ARRAY_SIZEOF", "ARRAY_LBOUND", "ARRAY_UBOUND", "PEEK", "PEEKS", "PEEKB", "PEEKW", "PEEKD", "PEEKQ", "POKE", "POKEB", "POKEW", "POKED", "POKEQ", "POKES", "MEMCOPY", "MEMCOPYB", "MEMCOPYW", "MEMCOPYD", "MEMCOPYQ", "MEMFILL", "MEMFILLB", "MEMFILLW", "MEMFILLD", "MEMFILLQ", "SETNEWOFFSET", "VARPTR", "SADD", "CODEPTR", "LPTR", "SIZEOF", "OFFSETOF", "TYPEOF"
        Return 1
    Case "JSON", "REGEX", "HTTP", "OS", "STRINGX", "LLAMA", "LUA", "PROLOG", "SQLITE", "CURL", "CRYPTO", "ARCHIVE", "IMAGE", "AUDIO", "MATH", "GRAPHICS", "SERVER", "ONNX", "WEBGPU", "BROWSER", "CANVAS"
        Return 1
    Case "EVENT", "THREAD", "PIPE", "SLOT", "TRIGGER", "ASSERT", "THROW"
        Return 1
    Case "SLOT_DEF", "SLOT_BIND", "SLOT_CAP", "SLOT_ON", "SLOT_OFF", "TASK_TRIGGER"
        Return 1
    Case "SHELL", "SHELL_NOWAIT", "SHELL_TIMEOUT", "SHELL_RUNPATH", "SHELL_OUTPATH", "SHELL_ERRPATH", "SHELL_OUTVAR", "SHELL_ERRVAR", "SHELL_CODEVAR"
        Return 1
    ' S-019: native LIST/DICT/SET, real emitter in mir_x64_collections.fbs
    ' backed by native/uxb_runtime's __uxb_rt_list_*/dict_*/set_* C ABI --
    ' added to the whitelist only now that the emitter + runtime + a real
    ' compiled-and-run EXE test all exist (per the "no whitelist entry ahead of
    ' a working emitter" rule). DICTKEYAT/DICTVALUEAT/SETMEMBERAT are not part
    ' of the user-facing 19-name language surface -- they are internal MIR_CALL
    ' targets MIRLowerDictEachLoop/MIRLowerSetEachLoop (iterator_lowering.fbs)
    ' emit for FOR EACH/DO EACH, so they need the same whitelist entry.
    Case "LIST_NEW", "DICT_NEW", "SET_NEW", "LISTLEN", "LISTGET", "LISTSET", "LISTADD", "LISTREMOVE", "LISTCLEAR", "DICTLEN", "DICTHAS", "DICTGET", "DICTSET", "DICTCLEAR", "SETLEN", "SETHAS", "SETADD", "SETREMOVE", "SETCLEAR", "DICTKEYAT", "DICTVALUEAT", "SETMEMBERAT"
        Return 1
    Case Else
        If MIRX64KeywordHasCounterpart(t) <> 0 Then Return 1
        Return 0
    End Select
End Function

Function MIRX64CallTargetDiagnosticOnly(ByRef targetText As String) As Integer
    Dim t As String
    t = UCase(Trim(targetText))
    Select Case t
    Case "NATIVE_ONLY", "WASM_UNSUPPORTED", "DIAGNOSTIC_ONLY", "RESERVED_NODE", "BROKEN_NODE"
        Return 1
    Case Else
        If MIRX64CallTargetSupported(t) <> 0 Then Return 0
        Return 1
    End Select
End Function

Function MIRX64OpcodeDiagnosticOnly(ByRef opcodeText As String) As Integer
    Dim op As String
    op = MIRX64CanonicalEmitterOpcode(opcodeText)

    Select Case op
    Case "NATIVE_ONLY", "WASM_UNSUPPORTED", "DIAGNOSTIC_ONLY", "RESERVED_NODE", "BROKEN_NODE", "JS_CALL", "BROWSER_CALL", "WASM_IMPORT", "WASM_EXPORT"
        Return 1
    End Select

    Return 0
End Function

#endif
