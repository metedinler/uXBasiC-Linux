' S-618: 2048 -> 4096 entries. The program-wide table holds every local of every routine; since S-599 each FUNCTION also owns a result slot named after it,
' which consumed one entry of the user's budget (a function with exactly 2048 locals no longer fit: tests/compiler_consolidation/large_local_frame).
Type VarMapping
    count As Integer
    keys(0 To 4095) As String
    offsets(0 To 4095) As Integer
    slots(0 To 4095) As Integer
End Type

Private Function VarMappingMakeKey(ByRef routineLabel As String, ByRef varName As String) As String
    Dim scopeKey As String
    scopeKey = UCase(Trim(routineLabel))
    If scopeKey = "" Then scopeKey = "__GLOBAL"

    Dim nameKey As String
    nameKey = UCase(Trim(varName))
    If nameKey = "" Then nameKey = "__UXB_LOCAL"

    Return scopeKey & "::" & nameKey
End Function

Private Function VarMappingFindIndex(ByRef vm As VarMapping, ByRef keyText As String) As Integer
    Dim i As Integer
    For i = 0 To vm.count - 1
        If vm.keys(i) = keyText Then Return i
    Next i
    Return -1
End Function

Sub VarMappingInit(ByRef vm As VarMapping)
    vm.count = 0

    Dim i As Integer
    For i = 0 To 4095
        vm.keys(i) = ""
        vm.offsets(i) = 0
        vm.slots(i) = 0
    Next i
End Sub

Function VarMappingAddLocalChecked(ByRef vm As VarMapping, ByVal routineLabel As String, ByVal varName As String, ByVal offset As Integer, ByVal slotCount As Integer, ByRef errText As String) As Integer
    errText = ""
    If slotCount < 1 Then slotCount = 1

    Dim keyText As String
    keyText = VarMappingMakeKey(routineLabel, varName)

    Dim idx As Integer
    idx = VarMappingFindIndex(vm, keyText)
    If idx <> -1 Then
        vm.offsets(idx) = offset
        vm.slots(idx) = slotCount
        Return 1
    End If

    If vm.count > 4095 Then
        errText = "X64_VAR_MAPPING_CAPACITY_EXCEEDED: " & keyText
        Return 0
    End If

    vm.keys(vm.count) = keyText
    vm.offsets(vm.count) = offset
    vm.slots(vm.count) = slotCount
    vm.count += 1
    Return 1
End Function

Sub VarMappingAddLocal(ByRef vm As VarMapping, ByVal routineLabel As String, ByVal varName As String, ByVal offset As Integer, ByVal slotCount As Integer)
    Dim ignoredErr As String
    If VarMappingAddLocalChecked(vm, routineLabel, varName, offset, slotCount, ignoredErr) = 0 Then
        ' Eski Sub imzası geriye uyumluluk için korunur; yeni x64 codegen çağrıları checked fonksiyonu kullanmalıdır.
    End If
End Sub

Private Function VarMappingTryGetLocalOffset(ByRef vm As VarMapping, ByRef routineLabel As String, ByRef varName As String, ByRef offsetOut As Integer) As Integer
    Dim keyText As String
    keyText = VarMappingMakeKey(routineLabel, varName)

    Dim idx As Integer
    idx = VarMappingFindIndex(vm, keyText)
    If idx = -1 Then
        offsetOut = 0
        Return 0
    End If

    offsetOut = vm.offsets(idx)
    Return 1
End Function

Private Function VarMappingFormatRbpRef(ByVal offset As Integer) As String
    If offset < 0 Then
        Return "[rbp - " & LTrim(Str(-offset)) & "]"
    ElseIf offset > 0 Then
        Return "[rbp + " & LTrim(Str(offset)) & "]"
    End If

    Return "[rbp]"
End Function

Function VarMappingEmitLoad(ByRef vm As VarMapping, ByRef routineLabel As String, ByRef varName As String, ByRef textSection As String) As Integer
    If Trim(routineLabel) = "" Then Return 0

    Dim localOffset As Integer
    If VarMappingTryGetLocalOffset(vm, routineLabel, varName, localOffset) = 0 Then Return 0

    textSection &= "    mov rax, " & VarMappingFormatRbpRef(localOffset) & Chr(10)
    Return 1
End Function

Function VarMappingEmitLoadXmm(ByRef vm As VarMapping, ByRef routineLabel As String, ByRef varName As String, ByRef textSection As String) As Integer
    If Trim(routineLabel) = "" Then Return 0

    Dim localOffset As Integer
    If VarMappingTryGetLocalOffset(vm, routineLabel, varName, localOffset) = 0 Then Return 0

    textSection &= "    movsd xmm0, " & VarMappingFormatRbpRef(localOffset) & Chr(10)
    Return 1
End Function
