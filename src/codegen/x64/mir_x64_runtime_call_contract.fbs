#ifndef UXB_MIR_X64_RUNTIME_CALL_CONTRACT_FBS
#define UXB_MIR_X64_RUNTIME_CALL_CONTRACT_FBS

Const UXB_RT_FAMILY_CONSOLE = 1
Const UXB_RT_FAMILY_STRING = 2
Const UXB_RT_FAMILY_FILE = 3
Const UXB_RT_FAMILY_MEMORY = 4
Const UXB_RT_FAMILY_EXTFP = 5
Const UXB_RT_FAMILY_MATH = 6
Const UXB_RT_FAMILY_HOST = 7
Const UXB_RT_FAMILY_GENERIC = 0

Function MIRX64RuntimeFamilyName(ByVal fam As Integer) As String
    Select Case fam
    Case UXB_RT_FAMILY_CONSOLE: Return "console"
    Case UXB_RT_FAMILY_STRING: Return "string"
    Case UXB_RT_FAMILY_FILE: Return "file"
    Case UXB_RT_FAMILY_MEMORY: Return "memory"
    Case UXB_RT_FAMILY_EXTFP: Return "extfp"
    Case UXB_RT_FAMILY_MATH: Return "math"
    Case UXB_RT_FAMILY_HOST: Return "host"
    Case Else: Return "generic"
    End Select
End Function

Function MIRX64RuntimeSymbolForOpcode(ByRef opcodeText As String, ByRef callTarget As String) As String
    Dim op As String
    Dim target As String
    op = UCase(Trim(opcodeText))
    If Left(op, 4) = "MIR_" Then op = Mid(op, 5)
    target = UCase(Trim(callTarget))

    Select Case op
    Case "PRINT": Return "__uxb_rt_print_i64"
    Case "PRINTLN": Return "__uxb_rt_print_newline"
    Case "INPUT": Return "__uxb_rt_input_i64"
    Case "CLS": Return "__uxb_rt_cls"
    Case "CSRLIN": Return "__uxb_rt_csrlin"
    Case "POS": Return "__uxb_rt_pos"
    Case "LOCATE": Return "__uxb_rt_locate"
    Case "COLOR": Return "__uxb_rt_color"
    Case "RANDOMIZE": Return "__uxb_rt_randomize"
    Case "TIMER": Return "__uxb_rt_timer_f64"   ' S-624: F64 (XMM0)
    Case "RND": Return "__uxb_rt_rnd_i64"
    Case "GETKEY": Return "__uxb_rt_getkey_i64"
    Case "INKEY": Return "__uxb_rt_inkey_i64"
    Case "OPEN", "FILE_OPEN": Return "__uxb_rt_file_open"
    Case "CLOSE", "FILE_CLOSE": Return "__uxb_rt_file_close"
    Case "EOF", "FILE_EOF": Return "__uxb_rt_file_eof"
    Case "LOF", "FILE_LOF": Return "__uxb_rt_file_lof"
    Case "SEEK", "FILE_SEEK": Return "__uxb_rt_file_seek"
    Case "GET", "FILE_READ": Return "__uxb_rt_file_get"
    Case "PUT", "FILE_WRITE": Return "__uxb_rt_file_put"
    Case "DELETE", "FILE_DELETE": Return "__uxb_rt_file_delete"
    Case "MEMCOPY", "MEM_COPY": Return "__uxb_rt_memcopy"
    Case "MEMFILL", "MEM_FILL": Return "__uxb_rt_memfill"
    Case "PEEK", "MEM_LOAD": Return "__uxb_rt_peek_i64"
    Case "POKE", "MEM_STORE": Return "__uxb_rt_poke_i64"
    Case "MEMORY_READ_SEQUENCE", "MEM_READ_SEQUENCE": Return "__uxb_rt_mem_read_sequence"
    Case "MEMORY_WRITE_SEQUENCE", "MEM_WRITE_SEQUENCE": Return "__uxb_rt_mem_write_sequence"
    Case "STR_CONCAT": Return "__uxb_rt_str_concat"
    Case "STR_COMPARE": Return "__uxb_rt_str_compare"
    Case "CALL", "CALL_RUNTIME", "CALL_BUILTIN", "HOST_CALL", "LIBRARY_CALL", "EXTFP_CALL"
        Select Case target
        Case "CSRLIN": Return "__uxb_rt_csrlin"
        Case "POS": Return "__uxb_rt_pos"
        Case "LEN", "STR_LEN": Return "__uxb_rt_strlen"
        Case "ASC": Return "__uxb_rt_asc"
        Case "CHR", "CHR$": Return "__uxb_rt_chr"
        Case "VAL": Return "__uxb_rt_val_i64"
        Case "STR", "STR$": Return "__uxb_rt_str_i64"
        Case "LEFT", "LEFT$": Return "__uxb_rt_left"
        Case "RIGHT", "RIGHT$": Return "__uxb_rt_right"
        Case "MID", "MID$": Return "__uxb_rt_mid"
        Case "INSTR": Return "__uxb_rt_instr"
        Case "LCASE", "LCASE$": Return "__uxb_rt_lcase"
        Case "UCASE", "UCASE$": Return "__uxb_rt_ucase"
        Case "LTRIM", "LTRIM$": Return "__uxb_rt_ltrim"
        Case "RTRIM", "RTRIM$": Return "__uxb_rt_rtrim"
        Case "TRIM", "TRIM$": Return "__uxb_rt_trim"
        Case "SPACE", "SPACE$": Return "__uxb_rt_space"
        Case "HEX", "HEX$": Return "__uxb_rt_hex"
        Case "OCT", "OCT$": Return "__uxb_rt_oct"
        Case "BIN", "BIN$": Return "__uxb_rt_bin"
        Case "SQR", "SQRT": Return "__uxb_rt_sqrt_i64"
        Case "SIN": Return "__uxb_rt_sin_i64"
        Case "COS": Return "__uxb_rt_cos_i64"
        Case "TAN": Return "__uxb_rt_tan_i64"
        Case "ATN": Return "__uxb_rt_atn_i64"
        Case "LOG": Return "__uxb_rt_log_i64"
        Case "EXP": Return "__uxb_rt_exp_i64"
        Case "POW": Return "__uxb_rt_pow_i64"
        Case "BIGINIT": Return "__uxb_rt_biginit"
        Case "JSON", "REGEX", "HTTP", "OS", "STRINGX", "LLAMA", "LUA", "PROLOG", "SQLITE", "CURL", "CRYPTO", "ARCHIVE", "IMAGE", "AUDIO", "MATH", "GRAPHICS", "SERVER", "ONNX", "WEBGPU", "BROWSER", "CANVAS", "DLL", "API", "IMPORT", "INLINE"
            Return "__uxb_rt_host_call"
        Case Else
            Return "__uxb_rt_host_call"
        End Select
    End Select
    Return ""
End Function

Function MIRX64RuntimeFamilyForSymbol(ByRef symbolName As String) As Integer
    Dim s As String
    s = LCase(Trim(symbolName))
    If Left(s, 15) = "__uxb_rt_print" Or Left(s, 14) = "__uxb_rt_input" Or s = "__uxb_rt_cls" Or s = "__uxb_rt_locate" Or s = "__uxb_rt_color" Or InStr(s, "getkey") > 0 Or InStr(s, "inkey") > 0 Then Return UXB_RT_FAMILY_CONSOLE
    If Left(s, 12) = "__uxb_rt_str" Or InStr(s, "strlen") > 0 Or InStr(s, "_left") > 0 Or InStr(s, "_right") > 0 Or InStr(s, "_mid") > 0 Or InStr(s, "_instr") > 0 Or InStr(s, "case") > 0 Or InStr(s, "trim") > 0 Then Return UXB_RT_FAMILY_STRING
    If Left(s, 13) = "__uxb_rt_file" Then Return UXB_RT_FAMILY_FILE
    If InStr(s, "mem") > 0 Or InStr(s, "peek") > 0 Or InStr(s, "poke") > 0 Then Return UXB_RT_FAMILY_MEMORY
    If InStr(s, "sqrt") > 0 Or InStr(s, "sin") > 0 Or InStr(s, "cos") > 0 Or InStr(s, "tan") > 0 Or InStr(s, "log") > 0 Or InStr(s, "exp") > 0 Or InStr(s, "pow") > 0 Then Return UXB_RT_FAMILY_MATH
    If InStr(s, "f80") > 0 Or InStr(s, "f128") > 0 Or InStr(s, "big") > 0 Or InStr(s, "ball") > 0 Then Return UXB_RT_FAMILY_EXTFP
    If InStr(s, "host") > 0 Then Return UXB_RT_FAMILY_HOST
    Return UXB_RT_FAMILY_GENERIC
End Function

#endif
