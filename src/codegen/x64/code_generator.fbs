' Float kind constants
Private Const UXF_UNKNOWN = 0
Private Const UXF_F32 = 1
Private Const UXF_F64 = 2
Private Const UXF_F80 = 3
Private Const UXF_F128 = 4

Private Function X64VarTypeKey(ByRef cg As X64CodegenContext, ByRef varName As String) As String
    Dim n As String
    n = X64Upper(Trim(varName))
    If n = "" Then Return ""

    If cg.currentRoutineLabel <> "" Then
        Return X64Upper(cg.currentRoutineLabel) & "::" & n
    End If

    Return "__GLOBAL::" & n
End Function

Private Sub X64RegisterVarType(ByRef cg As X64CodegenContext, ByRef varName As String, ByRef typeName As String)
    Dim key As String
    key = X64VarTypeKey(cg, varName)
    If key = "" Then Exit Sub

    Dim i As Integer
    For i = 0 To gX64VarTypeCount - 1
        If gX64VarTypeKeys(i) = key Then
            gX64VarTypeNames(i) = X64Upper(Trim(typeName))
            Exit Sub
        End If
    Next

    If gX64VarTypeCount > 4095 Then Exit Sub

    gX64VarTypeKeys(gX64VarTypeCount) = key
    gX64VarTypeNames(gX64VarTypeCount) = X64Upper(Trim(typeName))
    gX64VarTypeCount += 1
End Sub

' Interface dispatch slots are separate from class-local virtual slots. Two
' implementing classes may have different virtual layouts or nonvirtual
' implementations; neither a global method-name guess nor the first class
' implementation is a valid runtime dispatch rule.
Private Function X64InterfaceSlotBase(ByRef ps As ParseState) As Integer
    Dim largest As Integer = -1
    Dim n As Integer
    For n = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(n).kind) = "CLASS_METHOD_SLOT" Then
            Dim s As Integer = Val(ps.ast.nodes(n).value)
            If s > largest Then largest = s
        End If
    Next n
    Return largest + 1
End Function

Private Function X64InterfaceMethodNode(ByRef ps As ParseState, ByRef interfaceType As String, ByRef methodName As String) As Integer
    Dim n As Integer
    For n = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(n).kind) <> "INTERFACE_METHOD_DECL" Then Continue For
        Dim owner As Integer = ps.ast.nodes(n).parent
        If owner < 0 Then Continue For
        If X64Upper(Trim(ps.ast.nodes(owner).value)) = X64Upper(Trim(interfaceType)) AndAlso X64Upper(Trim(ps.ast.nodes(n).value)) = X64Upper(Trim(methodName)) Then Return n
    Next n
    Return -1
End Function

Private Function X64FindInterfaceMethodSlot(ByRef ps As ParseState, ByRef interfaceType As String, ByRef methodName As String, ByRef slotOut As Integer) As Integer
    slotOut = -1
    Dim wanted As Integer = X64InterfaceMethodNode(ps, interfaceType, methodName)
    If wanted = -1 Then Return 0
    Dim ordinal As Integer = X64InterfaceSlotBase(ps)
    Dim n As Integer
    For n = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(n).kind) <> "INTERFACE_METHOD_DECL" Then Continue For
        If n = wanted Then slotOut = ordinal: Return 1
        ordinal += 1
    Next n
    Return 0
End Function

Private Function X64ClassHasInterface(ByRef ps As ParseState, ByRef classType As String, ByRef interfaceType As String) As Integer
    Dim currentType As String = classType
    Dim depth As Integer
    For depth = 0 To 63
        Dim node As Integer = X64FindClassDeclNode(ps, currentType)
        If node = -1 Then Exit For
        Dim nextType As String = ""
        Dim child As Integer = ps.ast.nodes(node).firstChild
        Do While child <> -1
            Dim kind As String = X64Upper(ps.ast.nodes(child).kind)
            If kind = "CLASS_IMPLEMENTS_REF" AndAlso X64Upper(Trim(ps.ast.nodes(child).value)) = X64Upper(Trim(interfaceType)) Then Return 1
            If kind = "CLASS_BASE_REF" Then nextType = ps.ast.nodes(child).value
            child = ps.ast.nodes(child).nextSibling
        Loop
        If nextType = "" Then Exit For
        currentType = nextType
    Next depth
    Return 0
End Function

Private Function X64InterfaceMethodABI(ByRef ps As ParseState, ByRef interfaceType As String, ByRef methodName As String) As String
    ' A representative implementation supplies only ABI metadata (e.g. F64
    ' arguments). The emitted call still selects the actual object's slot.
    Dim n As Integer
    For n = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(n).kind) <> "CLASS_STMT" Then Continue For
        Dim candidate As String = ps.ast.nodes(n).value
        If X64ClassHasInterface(ps, candidate, interfaceType) = 0 Then Continue For
        Dim owner As String = candidate
        If X64ResolveMethodOwnerType(ps, candidate, methodName, owner) <> 0 Then
            Dim rawSymbol As String = owner & "_" & methodName
            Dim exact As String
            If X64FindRoutineSymbolName(ps, rawSymbol, exact) <> 0 Then Return exact
            Return LCase(rawSymbol)
        End If
    Next n
    Return ""
End Function

' Build and emit vtable for a class (base-first ordering)
Private Function X64EmitClassVTable(ByRef ps As ParseState, ByVal classNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    errText = ""
    If classNode < 0 Or classNode >= ps.ast.count Then Return 1

    Dim className As String
    className = X64Upper(Trim(ps.ast.nodes(classNode).value))
    If className = "" Then Return 1

    ' Already registered?
    Dim ci As Integer
    For ci = 0 To gX64VTableClassCount - 1
        If gX64VTableClassKeys(ci) = className Then Return 1
    Next ci

    ' Build vtable from semantic CLASS_METHOD_SLOT metadata (base-first; overrides replace implementer)
    Dim typesList() As String
    Dim typeCount As Integer
    typeCount = 0

    Dim curType As String
    curType = className
    Do While curType <> ""
        If typeCount = 0 Then
            ReDim typesList(0)
        Else
            ReDim Preserve typesList(typeCount)
        End If
        typesList(typeCount) = X64Upper(Trim(curType))
        typeCount += 1

        Dim cnode As Integer
        cnode = X64FindClassDeclNode(ps, typesList(typeCount - 1))
        If cnode = -1 Then Exit Do
        Dim baseNode As Integer
        baseNode = X64FindChildByKind(ps, cnode, "CLASS_BASE_REF")
        If baseNode = -1 Then Exit Do
        curType = ps.ast.nodes(baseNode).value
    Loop

    ' Determine max slot
    Dim maxSlot As Integer
    maxSlot = -1
    Dim ti As Integer
    For ti = typeCount - 1 To 0 Step -1
        Dim cnode2 As Integer
        cnode2 = X64FindClassDeclNode(ps, typesList(ti))
        If cnode2 = -1 Then Continue For
        Dim ch As Integer
        ch = ps.ast.nodes(cnode2).firstChild
        Do While ch <> -1
            If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_METHOD_DECL" Then
                Dim mch As Integer
                mch = X64FindChildByKind(ps, ch, "CLASS_METHOD_SLOT")
                If mch <> -1 Then
                    Dim si As Integer
                    si = Val(ps.ast.nodes(mch).value)
                    If si > maxSlot Then maxSlot = si
                End If
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
    Next ti

    Dim slotCount As Integer
    If maxSlot < 0 Then
        slotCount = 0
    Else
        slotCount = maxSlot + 1
    End If
    Dim regularSlotCount As Integer = slotCount
    Dim interfaceEnd As Integer = X64InterfaceSlotBase(ps)
    Dim interfaceIndex As Integer
    For interfaceIndex = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(interfaceIndex).kind) = "INTERFACE_METHOD_DECL" Then interfaceEnd += 1
    Next interfaceIndex
    If interfaceEnd > slotCount Then slotCount = interfaceEnd

    Dim vtblLabel As String
    vtblLabel = X64ClassVTableLabel(className)

    If slotCount = 0 Then
        X64EmitData cg, vtblLabel & ": dq 0"
    Else
        Dim implOwner() As String
        Dim implMethod() As String
        ReDim implOwner(slotCount - 1)
        ReDim implMethod(slotCount - 1)

        ' base-first: later (derived) entries overwrite earlier (base) entries
        For ti = typeCount - 1 To 0 Step -1
            Dim cn As Integer
            cn = X64FindClassDeclNode(ps, typesList(ti))
            If cn = -1 Then Continue For
            Dim ch2 As Integer
            ch2 = ps.ast.nodes(cn).firstChild
            Do While ch2 <> -1
                If X64Upper(ps.ast.nodes(ch2).kind) = "CLASS_METHOD_DECL" Then
                    Dim mname As String
                    mname = X64Upper(Trim(ps.ast.nodes(ch2).value))
                    Dim slotMeta As Integer
                    slotMeta = X64FindChildByKind(ps, ch2, "CLASS_METHOD_SLOT")
                    If slotMeta <> -1 Then
                        Dim sidx As Integer
                        sidx = Val(ps.ast.nodes(slotMeta).value)
                        If sidx >= 0 And sidx < slotCount Then
                            implOwner(sidx) = typesList(ti)
                            implMethod(sidx) = mname
                        End If
                    End If
                End If
                ch2 = ps.ast.nodes(ch2).nextSibling
            Loop
        Next ti

        Dim interfaceSlot As Integer = X64InterfaceSlotBase(ps)
        For interfaceIndex = 0 To ps.ast.count - 1
            If X64Upper(ps.ast.nodes(interfaceIndex).kind) <> "INTERFACE_METHOD_DECL" Then Continue For
            Dim interfaceOwner As Integer = ps.ast.nodes(interfaceIndex).parent
            Dim interfaceType As String = ps.ast.nodes(interfaceOwner).value
            If X64ClassHasInterface(ps, className, interfaceType) <> 0 Then
                Dim interfaceMethod As String = X64Upper(ps.ast.nodes(interfaceIndex).value)
                Dim implementationOwner As String = className
                If X64ResolveMethodOwnerType(ps, className, interfaceMethod, implementationOwner) <> 0 Then
                    implOwner(interfaceSlot) = implementationOwner
                    implMethod(interfaceSlot) = interfaceMethod
                End If
            End If
            interfaceSlot += 1
        Next interfaceIndex

        Dim entriesText As String
        entriesText = ""
        Dim si2 As Integer
        For si2 = 0 To slotCount - 1
            Dim implKey As String
            implKey = ""
            If implOwner(si2) <> "" And implMethod(si2) <> "" Then
                implKey = implOwner(si2) & "_" & implMethod(si2)
            End If
            Dim emitSym As String
            emitSym = "0"
            If implKey <> "" Then
                Dim exact As String
                If X64FindRoutineSymbolName(ps, implKey, exact) <> 0 Then
                    emitSym = exact
                Else
                    emitSym = LCase(implKey)
                End If
            End If

            If entriesText <> "" Then entriesText &= ", "
            entriesText &= emitSym
        Next si2

        X64EmitData cg, vtblLabel & ": dq " & entriesText

        ' register class index and entries
        Dim classIdx As Integer
        classIdx = gX64VTableClassCount
        gX64VTableClassKeys(classIdx) = className
        gX64VTableClassSlots(classIdx) = slotCount
        gX64VTableClassCount = gX64VTableClassCount + 1

        If slotCount > 0 Then
            Dim kidx As Integer
            For si2 = 0 To slotCount - 1
                If si2 >= regularSlotCount Then Continue For
                Dim entryKey As String
                entryKey = className & "_" & UCase(Trim(implMethod(si2)))
                kidx = gX64VTableEntryCount
                gX64VTableEntryKeys(kidx) = X64Upper(Trim(entryKey))
                gX64VTableEntrySlots(kidx) = si2
                gX64VTableEntryClassIndex(kidx) = classIdx
                gX64VTableEntryCount = gX64VTableEntryCount + 1
            Next si2
        End If
    End If

    Return 1
End Function



' FIX14_CANONICAL_MAGIC_DISPATCH_20260611: x64 method lookup helper.
Private Function X64MagicFallbackMethodName(ByRef methodNameRaw As String) As String
    Dim m As String
    m = X64Upper(Trim(methodNameRaw))
    If m = "" Then Return ""
    If Left(m, 6) = "MAGIC_" Then Return ""
    If Left(m, 2) = "__" Then
        Dim d As String
        d = Mid(m, 3)
        If d = "" Then Return ""
        Return "MAGIC_" & d
    End If
    Return "MAGIC_" & m
End Function

Private Function X64FindVTableSlot(ByRef cg As X64CodegenContext, ByRef className As String, ByRef methodName As String, ByRef slotOut As Integer) As Integer
    slotOut = -1
    Dim classUpper As String
    Dim methodUpper As String
    classUpper = X64Upper(Trim(className))
    methodUpper = X64Upper(Trim(methodName))
    If classUpper = "" Or methodUpper = "" Then Return 0

    Dim lookupNames(0 To 1) As String
    lookupNames(0) = methodUpper
    lookupNames(1) = X64MagicFallbackMethodName(methodUpper)

    Dim pass As Integer
    For pass = 0 To 1
        Dim wanted As String
        wanted = lookupNames(pass)
        If wanted = "" Then Continue For

        Dim key As String
        key = X64Upper(Trim(classUpper & "_" & wanted))
        Dim i As Integer
        For i = 0 To gX64VTableEntryCount - 1
            If gX64VTableEntryKeys(i) = key Then
                slotOut = gX64VTableEntrySlots(i)
                Return 1
            End If
        Next i
    Next pass

    Return 0
End Function

Private Function X64FindMethodSlotGlobal(ByRef ps As ParseState, ByRef methodNameRaw As String, ByRef slotOut As Integer) As Integer
    slotOut = -1
    Dim methodName As String
    methodName = X64Upper(Trim(methodNameRaw))
    If methodName = "" Then Return 0

    Dim found As Integer
    found = 0

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If X64Upper(Trim(ps.ast.nodes(i).kind)) <> "CLASS_METHOD_DECL" Then Continue For
        If X64Upper(Trim(ps.ast.nodes(i).value)) <> methodName Then Continue For

        Dim slotNode As Integer
        slotNode = X64FindChildByKind(ps, i, "CLASS_METHOD_SLOT")
        If slotNode = -1 Then Continue For

        Dim s As Integer
        s = Val(ps.ast.nodes(slotNode).value)
        If found = 0 Then
            slotOut = s
            found = 1
        ElseIf slotOut <> s Then
            slotOut = -1
            Return 0
        End If
    Next i

    Return found
End Function

Private Function X64RegisterClassVTable(ByRef ps As ParseState, ByVal classNodeIdx As Integer, ByRef cg As X64CodegenContext) As Integer
    Dim errText As String
    If classNodeIdx < 0 Or classNodeIdx >= ps.ast.count Then Return 1
    X64EmitClassVTable ps, classNodeIdx, cg, errText
    Return IIf(errText = "", 1, 0)
End Function

Private Function X64TryGetVarType(ByRef cg As X64CodegenContext, ByRef varName As String, ByRef typeNameOut As String) As Integer
    Dim key As String
    key = X64VarTypeKey(cg, varName)

    Dim i As Integer
    For i = 0 To gX64VarTypeCount - 1
        If gX64VarTypeKeys(i) = key Then
            typeNameOut = gX64VarTypeNames(i)
            Return 1
        End If
    Next

    key = "__GLOBAL::" & X64Upper(Trim(varName))
    For i = 0 To gX64VarTypeCount - 1
        If gX64VarTypeKeys(i) = key Then
            typeNameOut = gX64VarTypeNames(i)
            Return 1
        End If
    Next

    typeNameOut = ""
    Return 0
End Function

Private Function X64TypeNameIsUnsignedInteger(ByVal typeNameRaw As String) As Integer
    Dim t As String
    t = X64Upper(Trim(UXBStep3StorageType(typeNameRaw)))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)
    Select Case t
    Case "U8", "U16", "U32", "U64", "UBYTE", "USHORT", "UINTEGER", "ULONG", "ULONGINT"
        Return 1
    End Select
    Return 0
End Function

Private Function X64CoreScalarCastType(ByVal callNameRaw As String, ByRef typeOut As String) As Integer
    Dim t As String
    t = X64Upper(Trim(UXBStep3StorageType(callNameRaw)))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)
    If t = "BOOL" Then t = "BOOLEAN"
    Select Case t
    Case "BOOLEAN", "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "PTR"
        typeOut = t
        Return 1
    End Select
    typeOut = ""
    Return 0
End Function

Private Function X64ExprIsUnsignedInteger(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    Dim typeName As String
    typeName = Trim(ps.ast.nodes(nodeIdx).typeName)
    Dim k As String
    k = X64Upper(Trim(ps.ast.nodes(nodeIdx).kind))
    If k = "IDENT" Or k = "IDENTIFIER" Or k = "VAR" Or k = "NAME" Or k = "VAR_REF" Or k = "KEYWORD_REF" Then
        If X64TryGetVarType(cg, ps.ast.nodes(nodeIdx).value, typeName) = 0 Then
            X64FindDeclaredTypeName ps, ps.ast.nodes(nodeIdx).value, typeName
        End If
    End If
    Return X64TypeNameIsUnsignedInteger(typeName)
End Function

Private Sub X64EmitLoadIntegerMemory(ByRef cg As X64CodegenContext, ByVal memoryRef As String, ByVal loadBytes As Integer, ByVal isUnsigned As Integer)
    Select Case loadBytes
    Case 1
        If isUnsigned <> 0 Then X64EmitText cg, "    movzx rax, byte " & memoryRef Else X64EmitText cg, "    movsx rax, byte " & memoryRef
    Case 2
        If isUnsigned <> 0 Then X64EmitText cg, "    movzx rax, word " & memoryRef Else X64EmitText cg, "    movsx rax, word " & memoryRef
    Case 4
        If isUnsigned <> 0 Then X64EmitText cg, "    mov eax, dword " & memoryRef Else X64EmitText cg, "    movsxd rax, dword " & memoryRef
    Case Else
        X64EmitText cg, "    mov rax, " & memoryRef
    End Select
End Sub

Private Sub X64EmitIntegerPowRaxRbx(ByRef cg As X64CodegenContext)
    Dim negativeLabel As String
    Dim loopLabel As String
    Dim skipMultiplyLabel As String
    Dim doneLabel As String
    negativeLabel = X64NextLabel(cg, "pow_negative")
    loopLabel = X64NextLabel(cg, "pow_loop")
    skipMultiplyLabel = X64NextLabel(cg, "pow_skip_multiply")
    doneLabel = X64NextLabel(cg, "pow_done")
    X64EmitText cg, "    test rbx, rbx"
    X64EmitText cg, "    js " & negativeLabel
    X64EmitText cg, "    mov rcx, rbx"
    X64EmitText cg, "    mov rdx, rax"
    X64EmitText cg, "    mov rax, 1"
    X64EmitLabel cg, loopLabel
    X64EmitText cg, "    test rcx, rcx"
    X64EmitText cg, "    jz " & doneLabel
    X64EmitText cg, "    test rcx, 1"
    X64EmitText cg, "    jz " & skipMultiplyLabel
    X64EmitText cg, "    imul rax, rdx"
    X64EmitLabel cg, skipMultiplyLabel
    X64EmitText cg, "    shr rcx, 1"
    X64EmitText cg, "    jz " & doneLabel
    X64EmitText cg, "    imul rdx, rdx"
    X64EmitText cg, "    jmp " & loopLabel
    X64EmitLabel cg, negativeLabel
    X64EmitText cg, "    xor rax, rax"
    X64EmitLabel cg, doneLabel
End Sub

Private Function X64TypeToFloatKind(ByRef typeName As String) As Integer
    Dim t As String
    t = X64Upper(Trim(typeName))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)
    If t = "" Then Return UXF_UNKNOWN
    Select Case t
    Case "F32", "SINGLE", "SNG", "SNGLE"
        Return UXF_F32
    Case "F64", "DOUBLE", "DBL", "DBLE"
        Return UXF_F64
    Case "F80", "EXTENDED", "EXT"
        Return UXF_F80
    Case "F128", "FLOAT128", "QUAD"
        Return UXF_F128
    End Select
    Return UXF_UNKNOWN
End Function


' X64_DLL_CALL_RETURN_TYPE_FIX_20260711:
' CALL(DLL/API, ...) expressions carry their return signature in the AST child list,
' not in the routine signature table.  Float expression emission must see that type
' before rejecting a CALL_EXPR as "return type unknown".
Private Function X64NormalizeDllReturnType(ByRef sigText As String) As String
    Dim t As String
    t = X64Upper(Trim(sigText))
    Select Case t
    Case "F32", "SINGLE", "SNG", "SNGLE"
        Return "F32"
    Case "F64", "DOUBLE", "DBL", "DBLE"
        Return "F64"
    Case "I8", "BYTE", "I16", "SHORT", "I32", "INTEGER", "LONG", "U8", "U16", "U32"
        Return "I32"
    Case "I64", "LONGINT", "U64", "PTR", "HANDLE", "DLL_HANDLE"
        Return "U64"
    Case "STRPTR", "STRING", "ZSTRING", "CSTRING", "LPSTR", "LPCSTR"
        Return "STRING"
    Case "VOID", "SUB"
        Return "VOID"
    End Select
    Return t
End Function

Private Function X64TryResolveDllCallReturnTypeFromAst(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef returnTypeOut As String) As Integer
    returnTypeOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim nodeKind As String
    nodeKind = X64Upper(Trim(ps.ast.nodes(nodeIdx).kind))

    Dim callName As String
    callName = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))

    Dim sigPos As Integer
    sigPos = -1

    ' X64_FFI_CODEGEN_RESOLVER_SYNC_FIX_20260712:
    ' Lowered CALL_DLL_STMT/CALL_API_STMT carries the same child layout as DLL/API
    ' calls: lib, symbol, return signature, [convention], [arg type list], args...
    ' Include it in return-type inference so codegen and resolver share one model.
    If nodeKind = "CALL_DLL_STMT" Or nodeKind = "CALL_API_STMT" Then
        sigPos = 2
    ElseIf nodeKind <> "CALL_EXPR" And nodeKind <> "CALL_STMT" And nodeKind <> "CALL" Then
        Return 0
    ElseIf callName = "DLL" Or callName = "API" Then
        ' DLL("lib", "symbol", F64, ...)
        sigPos = 2
    ElseIf callName = "CALL" Then
        ' CALL(DLL, "lib", "symbol", F64, ...)
        Dim markerNode As Integer
        markerNode = X64ChildAt(ps, nodeIdx, 0)
        If markerNode = -1 Then Return 0
        Dim markerKind As String
        markerKind = X64Upper(Trim(ps.ast.nodes(markerNode).kind))
        If markerKind <> "IDENT" And markerKind <> "IDENTIFIER" And markerKind <> "KEYWORD_REF" And markerKind <> "VAR_REF" Then Return 0
        Dim markerValue As String
        markerValue = X64Upper(Trim(ps.ast.nodes(markerNode).value))
        If markerValue <> "DLL" And markerValue <> "API" Then Return 0
        sigPos = 3
    Else
        Return 0
    End If

    Dim sigNode As Integer
    sigNode = X64ChildAt(ps, nodeIdx, sigPos)
    If sigNode = -1 Then Return 0

    Dim sigKind As String
    sigKind = X64Upper(Trim(ps.ast.nodes(sigNode).kind))
    If sigKind <> "KEYWORD_REF" And sigKind <> "IDENT" And sigKind <> "IDENTIFIER" And sigKind <> "TYPE_REF" And sigKind <> "VAR_REF" Then Return 0

    returnTypeOut = X64NormalizeDllReturnType(ps.ast.nodes(sigNode).value)
    Return IIf(Trim(returnTypeOut) <> "", 1, 0)
End Function

Private Function X64GetElemBytesForType(ByRef ps As ParseState, ByRef typeName As String) As Integer
    Dim t As String
    t = X64Upper(Trim(typeName))
    If t = "" Then Return 8

    Dim sizeOut As Integer
    Dim terr As String
    terr = ""
    If TypeLayoutSizeOf(ps, t, sizeOut, terr) <> 0 Then
        If sizeOut > 0 Then Return sizeOut
    End If

    Select Case X64TypeToFloatKind(typeName)
    Case UXF_F32
        Return 4
    Case UXF_F64
        Return 8
    Case UXF_F80
        Return 10
    End Select

    Select Case t
    Case "I8", "U8", "BYTE", "BOOLEAN"
        Return 1
    Case "I16", "U16", "SHORT"
        Return 2
    Case "I32", "U32", "INTEGER", "LONG"
        Return 4
    Case "I64", "U64", "LONGINT", "PTR", "STRING"
        Return 8
    End Select

    Return 8
End Function

Private Function X64GetElemBytesForDeclaredType(ByRef ps As ParseState, ByRef typeName As String) As Integer
    Return X64GetElemBytesForType(ps, typeName)
End Function

Private Function X64IsFloatKind(ByVal k As Integer) As Integer
    Return IIf(k = UXF_F32 Or k = UXF_F64 Or k = UXF_F80 Or k = UXF_F128, 1, 0)
End Function

Private Function X64ElemBytesForFloatKind(ByVal k As Integer) As Integer
    Select Case k
    Case UXF_F32
        Return 4
    Case UXF_F80
        Return 10
    Case UXF_F128
        Return 16
    Case Else
        Return 8
    End Select
End Function

Private Function X64CreateFloatConstant(ByRef cg As X64CodegenContext, ByRef rawNumber As String, ByVal kind As Integer) As String
    Dim lbl As String
    If rawNumber = "" Then rawNumber = "0.0"
    Dim normalizedNumber As String
    normalizedNumber = rawNumber
    If InStr(normalizedNumber, ".") = 0 And InStr(UCase(normalizedNumber), "E") = 0 Then
        normalizedNumber &= ".0"
    End If
    Select Case kind
    Case UXF_F64
        lbl = X64NextLabel(cg, "dbl")
        X64EmitData cg, lbl & ": dq " & normalizedNumber
        Return lbl
    Case UXF_F32
        lbl = X64NextLabel(cg, "flt")
        X64EmitData cg, lbl & ": dd " & normalizedNumber
        Return lbl
    Case UXF_F80
        ' DİKKAT: F80 için 10-byte (tword) depolama kullan.
        ' NASM/YASM 'dt' directive: define tword (10 bytes)
        lbl = X64NextLabel(cg, "ext")
        X64EmitData cg, lbl & ": dt " & normalizedNumber
        Return lbl
    End Select
    lbl = X64NextLabel(cg, "dbl")
    X64EmitData cg, lbl & ": dq " & normalizedNumber
    Return lbl
End Function

Private Function X64EmitLoadFloatVarToXmm0As(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal kind As Integer, ByRef errText As String) As Integer
    If kind = UXF_F80 Then
        errText = "x64-codegen: F80 variable load requires x87/ST0 path"
        Return 0
    End If

    Dim localOffset As Integer
    Dim slotCount As Integer
    Dim labelText As String

    If cg.currentRoutineLabel <> "" Then
        If X64TryFindLocalInfo(cg, varName, localOffset, slotCount) <> 0 Then
            If kind = UXF_F32 Then
                X64EmitText cg, "    movss xmm0, " & X64FormatRbpRef(localOffset)
            Else
                X64EmitText cg, "    movsd xmm0, " & X64FormatRbpRef(localOffset)
            End If
            Return 1
        End If
    End If

    If X64TryFindGlobalInfo(cg, varName, labelText, slotCount) <> 0 Then
        If kind = UXF_F32 Then
            X64EmitText cg, "    movss xmm0, [rel " & labelText & "]"
        Else
            X64EmitText cg, "    movsd xmm0, [rel " & labelText & "]"
        End If
        Return 1
    End If

    errText = "x64-codegen: unknown float variable " & varName
    Return 0
End Function

Private Function X64EmitLoadFloatVarToXmm0(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal kind As Integer, ByRef errText As String) As Integer
    Return X64EmitLoadFloatVarToXmm0As(ps, cg, varName, kind, errText)
End Function

Private Function X64EmitStoreXmm0ToFloatVarAs(ByRef cg As X64CodegenContext, ByRef varName As String, ByVal kind As Integer, ByRef errText As String) As Integer
    If kind = UXF_F80 Then
        errText = "x64-codegen: F80 variable store requires x87/ST0 path"
        Return 0
    End If

    Dim localOffset As Integer
    Dim labelText As String
    Dim slotCount As Integer

    If cg.currentRoutineLabel <> "" Then
        If X64TryFindLocalInfo(cg, varName, localOffset, slotCount) <> 0 Then
            If kind = UXF_F32 Then
                X64EmitText cg, "    movss " & X64FormatRbpRef(localOffset) & ", xmm0"
            Else
                X64EmitText cg, "    movsd " & X64FormatRbpRef(localOffset) & ", xmm0"
            End If
            Return 1
        End If
    End If

    If X64TryFindGlobalInfo(cg, varName, labelText, slotCount) <> 0 Then
        If kind = UXF_F32 Then
            X64EmitText cg, "    movss [rel " & labelText & "], xmm0"
        Else
            X64EmitText cg, "    movsd [rel " & labelText & "], xmm0"
        End If
        Return 1
    End If

    If cg.currentRoutineLabel <> "" Then
        localOffset = X64EnsureLocalSlot(cg, varName, 1, X64ElemBytesForFloatKind(kind))
        If kind = UXF_F32 Then
            X64EmitText cg, "    movss " & X64FormatRbpRef(localOffset) & ", xmm0"
        Else
            X64EmitText cg, "    movsd " & X64FormatRbpRef(localOffset) & ", xmm0"
        End If
        Return 1
    End If

    labelText = X64EnsureGlobalSymbol(cg, varName, 1, X64ElemBytesForFloatKind(kind))
    If labelText <> "" Then
        If kind = UXF_F32 Then
            X64EmitText cg, "    movss [rel " & labelText & "], xmm0"
        Else
            X64EmitText cg, "    movsd [rel " & labelText & "], xmm0"
        End If
        Return 1
    End If

    errText = "x64-codegen: cannot store float variable " & varName
    Return 0
End Function


Private Function X64EmitExprToXmm0(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Return X64EmitExprToXmm0As(ps, nodeIdx, cg, UXF_F64, errText)
End Function

Private Function X64EmitCallNodeToXmm0(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByVal targetKind As Integer, ByRef errText As String) As Integer
    Return X64EmitCallNodeToXmm0As(ps, nodeIdx, cg, targetKind, errText)
End Function

Private Function X64SlotResolveDeclNode(ByRef ps As ParseState, ByRef laneKindRaw As String, ByVal targetExprIdx As Integer, ByRef declNodeOut As Integer, ByRef errText As String) As Integer
    declNodeOut = -1
    errText = ""

    If targetExprIdx < 0 Or targetExprIdx >= ps.ast.count Then
        errText = "x64-codegen: slot target missing"
        Return 0
    End If

    Dim nodeKindNeed As String
    If X64SlotNodeKindFromLaneKind(laneKindRaw, nodeKindNeed) = 0 Then
        errText = "x64-codegen: invalid slot lane kind " & laneKindRaw
        Return 0
    End If

    Dim preferId As Integer
    Dim targetId As Integer
    Dim targetName As String
    preferId = 0
    targetId = -1
    targetName = ""

    Dim targetKind As String
    targetKind = X64Upper(ps.ast.nodes(targetExprIdx).kind)
    Select Case targetKind
    Case "IDENT", "IDENTIFIER", "KEYWORD_REF", "STRING"
        targetName = X64Upper(Trim(ps.ast.nodes(targetExprIdx).value))
        If targetName = "" Then
            errText = "x64-codegen: slot target name cannot be empty"
            Return 0
        End If
    Case Else
        If X64TryConstIntExpr(ps, targetExprIdx, targetId) = 0 Then
            errText = "x64-codegen: slot target must be constant name/id"
            Return 0
        End If
        preferId = 1
    End Select

    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then
        errText = "x64-codegen: invalid program root for slot lookup"
        Return 0
    End If

    Dim ch As Integer
    ch = ps.ast.nodes(ps.rootNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = nodeKindNeed Then
            If preferId <> 0 Then
                Dim declId As Integer
                If X64SlotTryConstHeaderId(ps, ch, declId) <> 0 Then
                    If declId = targetId Then
                        declNodeOut = ch
                        Return 1
                    End If
                End If
            Else
                If X64Upper(Trim(ps.ast.nodes(ch).value)) = targetName Then
                    declNodeOut = ch
                    Return 1
                End If
            End If
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    errText = "x64-codegen: slot target not found (" & X64Upper(laneKindRaw) & ")"
    Return 0
End Function


Private Function X64TryResolveCallReturnType(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef returnTypeOut As String) As Integer
    returnTypeOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim taskSym As String, taskRecv As Integer, taskArgs As Integer
    If X64TaskMemberInfo(ps, nodeIdx, cg, taskSym, returnTypeOut, taskRecv, taskArgs) <> 0 Then Return 1
    If X64TryResolveDllCallReturnTypeFromAst(ps, nodeIdx, returnTypeOut) <> 0 Then Return 1

    Dim atomicRecv As Integer = ps.ast.nodes(nodeIdx).left
    If atomicRecv >= 0 Then
        Dim atomicKind As String = UCase(ps.ast.nodes(atomicRecv).kind)
        If atomicKind = "IDENT" Or atomicKind = "IDENTIFIER" Then
            Dim atomicDecl As Integer = UXBAtomicDeclFor(ps, ps.ast.nodes(atomicRecv).value, atomicRecv)
            If atomicDecl >= 0 Then
                returnTypeOut = UXBAtomicDeclType(ps, atomicDecl)
                If UCase(X64MethodLeafName(ps.ast.nodes(nodeIdx).value)) = "CAS" Then returnTypeOut = "BOOL"
                Return 1
            End If
        End If
    End If

    Dim callName As String
    callName = Trim(ps.ast.nodes(nodeIdx).value)
    If callName = "" Then Return 0

    If X64CoreScalarCastType(callName, returnTypeOut) <> 0 Then Return 1

    Dim lookupName As String
    lookupName = callName

    Dim namespaceRoutineSymbol As String
    Dim isNamespaceRoutine As Integer
    namespaceRoutineSymbol = ""
    isNamespaceRoutine = X64ResolveNamespaceRoutineSymbol(ps, callName, namespaceRoutineSymbol)
    If isNamespaceRoutine <> 0 Then lookupName = namespaceRoutineSymbol

    If isNamespaceRoutine = 0 And ps.ast.nodes(nodeIdx).left <> -1 And InStr(callName, ".") > 0 Then
        Dim chainMethodName As String
        chainMethodName = X64MethodLeafName(callName)

        Dim chainReceiverType As String
        Dim chainErr As String
        chainReceiverType = ""
        chainErr = ""
        Dim chainReceiverResolved As Integer
        chainReceiverResolved = 0
        If chainMethodName <> "" Then
            ' S-609 (2026-10-17): a receiver that is the NAME OF A CLASS (`Say.Selam("x")`, a STATIC method) is the class itself; without this
            ' the result type of such a call stayed unknown and PRINT formatted a returned STRING pointer as a number.
            Dim chainRecvNode As Integer
            chainRecvNode = ps.ast.nodes(nodeIdx).left
            If chainRecvNode >= 0 And chainRecvNode < ps.ast.count Then
                Dim chainRecvKind As String
                chainRecvKind = X64Upper(ps.ast.nodes(chainRecvNode).kind)
                If chainRecvKind = "IDENT" Or chainRecvKind = "KEYWORD_REF" Then
                    Dim chainRecvName As String
                    chainRecvName = X64Upper(Trim(ps.ast.nodes(chainRecvNode).value))
                    If chainRecvName <> "" And chainRecvName <> "THIS" And chainRecvName <> "ME" And chainRecvName <> "SUPER" Then
                        If X64FindClassDeclNode(ps, chainRecvName) <> -1 Then
                            chainReceiverType = chainRecvName
                            chainReceiverResolved = 1
                        End If
                    End If
                End If
            End If
            If chainReceiverResolved = 0 Then
                If X64TryResolveReceiverExprType(ps, ps.ast.nodes(nodeIdx).left, cg, chainReceiverType, chainErr) > 0 Then chainReceiverResolved = 1
            End If
        End If
        If chainMethodName <> "" And chainReceiverResolved <> 0 Then
            Dim chainOwner As String
            chainOwner = X64Upper(Trim(chainReceiverType))
            Dim interfaceReturnNode As Integer = X64InterfaceMethodNode(ps, chainOwner, chainMethodName)
            If interfaceReturnNode <> -1 Then
                returnTypeOut = X64ExtractRoutineReturnType(ps, interfaceReturnNode)
                If returnTypeOut <> "" Then Return 1
            End If
            If chainOwner <> "" And X64FindClassDeclNode(ps, chainOwner) <> -1 Then
                Dim resolvedChainOwner As String
                resolvedChainOwner = chainOwner
                If X64ResolveMethodOwnerType(ps, chainOwner, chainMethodName, resolvedChainOwner) = 0 Then resolvedChainOwner = chainOwner
                lookupName = resolvedChainOwner & "_" & chainMethodName
            End If
        End If
    End If

    Dim methodOwner As String
    Dim methodName As String
    If isNamespaceRoutine = 0 And ps.ast.nodes(nodeIdx).left = -1 And X64SplitMethodCallName(callName, methodOwner, methodName) <> 0 Then
        Dim ownerUpper As String
        Dim methodUpper As String
        ownerUpper = X64Upper(Trim(methodOwner))
        methodUpper = X64Upper(Trim(methodName))

        Dim receiverType As String
        receiverType = ""

        If X64FindClassDeclNode(ps, ownerUpper) <> -1 Then
            receiverType = ownerUpper
        Else
            If X64FindDeclaredTypeName(ps, ownerUpper, receiverType) = 0 Then
                If X64TryGetVarType(cg, ownerUpper, receiverType) = 0 Then
                    If ownerUpper = "THIS" Or ownerUpper = "ME" Then
                        If X64ResolveCurrentReceiverClass(ps, cg, receiverType) = 0 Then receiverType = ""
                    End If
                End If
            End If
            receiverType = X64Upper(Trim(receiverType))
        End If

        If receiverType <> "" And X64FindClassDeclNode(ps, receiverType) <> -1 Then
            Dim resolvedOwner As String
            resolvedOwner = receiverType
            If X64ResolveMethodOwnerType(ps, receiverType, methodUpper, resolvedOwner) = 0 Then resolvedOwner = receiverType
            lookupName = resolvedOwner & "_" & methodUpper
        Else
            lookupName = ownerUpper & "_" & methodUpper
        End If
    End If

    If X64TryGetRoutineReturnType(cg, lookupName, returnTypeOut) <> 0 Then Return 1
    If X64Upper(Trim(lookupName)) <> X64Upper(Trim(callName)) Then
        If X64TryGetRoutineReturnType(cg, callName, returnTypeOut) <> 0 Then Return 1
    End If

    Dim builtinName As String
    builtinName = X64Upper(callName)
        Select Case builtinName
        Case "ABS"
            Dim absArg As Integer
            absArg = X64ChildAt(ps, nodeIdx, 0)
            If absArg <> -1 Then
                ' This routine returns success and writes a type, never a float-kind enum.
                Select Case X64InferFloatKindOfExpr(ps, absArg, cg)
                Case UXF_F32: returnTypeOut = "F32"
                Case UXF_F64: returnTypeOut = "F64"
                Case UXF_F80: returnTypeOut = "F80"
                Case UXF_F128: returnTypeOut = "F128"
                Case Else
                    returnTypeOut = ps.ast.nodes(absArg).typeName
                    If returnTypeOut = "" Then returnTypeOut = "I32"
                End Select
                Return 1
            End If
            Return 0
        Case "SQR", "SIN", "COS", "TAN", "ATN", "EXP", "LOG", "RND", "TIMER", "CDBL", "VAL", "INPUTF"
            returnTypeOut = "F64"
            Return 1
        Case "CSNG"
            returnTypeOut = "F32"
            Return 1
        Case "FIX"
            ' S-508: FIX is a numeric I32-producing builtin.  It must be
            ' visible to the legacy call resolver as well as the shared type
            ' registry, otherwise a FIX expression assigned to F64/F32 is
            ' rejected before the integer-to-float bridge can run.
            returnTypeOut = "I32"
            Return 1
    End Select

    Return 0
End Function

Private Function X64EmitCallNodeToXmm0As(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByVal targetKind As Integer, ByRef errText As String) As Integer
    Dim retType As String
    retType = ""
    If X64TryResolveCallReturnType(ps, nodeIdx, cg, retType) = 0 Then
        errText = "x64-codegen: cannot use CALL_EXPR as float; return type unknown"
        Return 0
    End If

    Dim retKind As Integer
    retKind = X64TypeToFloatKind(retType)

    Select Case retKind
    Case UXF_F80
        errText = "x64-codegen: F80 call return requires x87/ST0 path"
        Return 0
    Case UXF_F32, UXF_F64
        ' supported
    Case Else
        If UXBStep3TypeIsInteger(retType) <> 0 Then
            If X64EmitCallNode(ps, nodeIdx, cg, errText) = 0 Then Return 0
            If targetKind = UXF_F32 Then X64EmitText cg, "    cvtsi2ss xmm0, rax" Else X64EmitText cg, "    cvtsi2sd xmm0, rax"
            Return 1
        End If
        errText = "x64-codegen: CALL_EXPR does not return a numeric value"
        Return 0
    End Select

    If X64EmitCallNode(ps, nodeIdx, cg, errText) = 0 Then Return 0

    If targetKind = UXF_F32 And retKind = UXF_F64 Then
        X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
    ElseIf targetKind = UXF_F64 And retKind = UXF_F32 Then
        X64EmitText cg, "    cvtss2sd xmm0, xmm0"
    End If

    Return 1
End Function

Private Function X64EmitFloatBinaryAs(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByVal kind As Integer, ByRef errText As String) As Integer
    If X64IsExtFpKind(kind) <> 0 Then
        errText = "x64-codegen: " & X64FloatKindToExtFpTypeName(kind) & " arithmetic must use external FP runtime call path; native float binary path is forbidden"
        Return 0
    End If

    Dim lhs As Integer
    Dim rhs As Integer
    lhs = ps.ast.nodes(nodeIdx).left
    rhs = ps.ast.nodes(nodeIdx).right

    If lhs = -1 Then lhs = X64ChildAt(ps, nodeIdx, 0)
    If rhs = -1 Then rhs = X64ChildAt(ps, nodeIdx, 1)

    If lhs = -1 Or rhs = -1 Then
        errText = "x64-codegen: float binary expression missing operand"
        Return 0
    End If

    Dim lhsKind As Integer
    Dim rhsKind As Integer
    Dim opKind As Integer
    lhsKind = X64InferFloatKindOfExpr(ps, lhs, cg)
    rhsKind = X64InferFloatKindOfExpr(ps, rhs, cg)

    opKind = kind
    If lhsKind = UXF_F64 Or rhsKind = UXF_F64 Then
        opKind = UXF_F64
    ElseIf lhsKind = UXF_F32 Or rhsKind = UXF_F32 Then
        opKind = UXF_F32
    End If

    If X64EmitExprToXmm0As(ps, lhs, cg, opKind, errText) = 0 Then Return 0

    X64EmitText cg, "    sub rsp, 16"
    If opKind = UXF_F32 Then
        X64EmitText cg, "    movss [rsp], xmm0"
    Else
        X64EmitText cg, "    movsd [rsp], xmm0"
    End If

    If X64EmitExprToXmm0As(ps, rhs, cg, opKind, errText) = 0 Then
        X64EmitText cg, "    add rsp, 16"
        Return 0
    End If

    If opKind = UXF_F32 Then
        X64EmitText cg, "    movss xmm1, xmm0"
        X64EmitText cg, "    movss xmm0, [rsp]"
    Else
        X64EmitText cg, "    movsd xmm1, xmm0"
        X64EmitText cg, "    movsd xmm0, [rsp]"
    End If

    X64EmitText cg, "    add rsp, 16"

    Dim opKey As String
    opKey = X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
    If opKey = "" Then opKey = X64Upper(ps.ast.nodes(nodeIdx).kind)

    Select Case opKey
    Case "+", "ADD"
        If opKind = UXF_F32 Then
            X64EmitText cg, "    addss xmm0, xmm1"
        Else
            X64EmitText cg, "    addsd xmm0, xmm1"
        End If
    Case "-", "SUB"
        If opKind = UXF_F32 Then
            X64EmitText cg, "    subss xmm0, xmm1"
        Else
            X64EmitText cg, "    subsd xmm0, xmm1"
        End If
    Case "*", "MUL"
        If opKind = UXF_F32 Then
            X64EmitText cg, "    mulss xmm0, xmm1"
        Else
            X64EmitText cg, "    mulsd xmm0, xmm1"
        End If
    Case "/", "DIV"
        If opKind = UXF_F32 Then
            X64EmitText cg, "    divss xmm0, xmm1"
        Else
            X64EmitText cg, "    divsd xmm0, xmm1"
        End If
    Case "%", "MOD"
        If opKind = UXF_F32 Then
            X64EmitText cg, "    cvttss2si rax, xmm0"
            X64EmitText cg, "    cvttss2si rbx, xmm1"
        Else
            X64EmitText cg, "    cvttsd2si rax, xmm0"
            X64EmitText cg, "    cvttsd2si rbx, xmm1"
        End If
        X64EmitText cg, "    cqo"
        X64EmitText cg, "    idiv rbx"
        X64EmitText cg, "    mov rax, rdx"
        If opKind = UXF_F32 Then
            X64EmitText cg, "    cvtsi2ss xmm0, rax"
        Else
            X64EmitText cg, "    cvtsi2sd xmm0, rax"
        End If
    Case Else
        errText = "x64-codegen: unsupported float binary operator " & opKey
        Return 0
    End Select

    If kind = UXF_F32 And opKind = UXF_F64 Then
        X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
    ElseIf kind = UXF_F64 And opKind = UXF_F32 Then
        X64EmitText cg, "    cvtss2sd xmm0, xmm0"
    End If

    Return 1
End Function

' S-525: rax (an integer value) -> xmm0 in the requested float width. An unsigned 64 bit value at or above 2^63 has its top bit
' set, so `cvtsi2sd` read it as a negative number (`f = u` with u = 2^64-1 gave -1 instead of 1.8446744073709552e19); it is
' converted by its unsigned magnitude (halve keeping the low bit, convert, double) as the SELECT comparison already did.
Private Sub X64EmitIntRaxToXmm0(ByRef cg As X64CodegenContext, ByVal targetKind As Integer, ByVal unsigned64 As Integer)
    If unsigned64 <> 0 Then
        Dim unsignedLow As String = X64NextLabel(cg, "u64_to_f_low")
        Dim unsignedDone As String = X64NextLabel(cg, "u64_to_f_done")
        X64EmitText cg, "    test rax, rax"
        X64EmitText cg, "    jns " & unsignedLow
        X64EmitText cg, "    mov rdx, rax"
        X64EmitText cg, "    and eax, 1"
        X64EmitText cg, "    shr rdx, 1"
        X64EmitText cg, "    or rax, rdx"
        X64EmitText cg, "    cvtsi2sd xmm0, rax"
        X64EmitText cg, "    addsd xmm0, xmm0"
        X64EmitText cg, "    jmp " & unsignedDone
        X64EmitLabel cg, unsignedLow
        X64EmitText cg, "    cvtsi2sd xmm0, rax"
        X64EmitLabel cg, unsignedDone
        If targetKind = UXF_F32 Then X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
        Exit Sub
    End If
    If targetKind = UXF_F32 Then X64EmitText cg, "    cvtsi2ss xmm0, rax" Else X64EmitText cg, "    cvtsi2sd xmm0, rax"
End Sub

Private Function X64EmitExprToXmm0As(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByVal targetKind As Integer, ByRef errText As String) As Integer
    If X64SyncCachedValue(nodeIdx, cg, targetKind) <> 0 Then Return 1
    Dim atomicHandled As Integer
    If X64AtomicEmitValue(ps, nodeIdx, cg, targetKind, atomicHandled, errText) = 0 Then Return 0
    If atomicHandled <> 0 Then Return 1
    Dim taskSym As String, taskType As String, taskRecv As Integer, taskArgs As Integer
    If X64TaskMemberInfo(ps, nodeIdx, cg, taskSym, taskType, taskRecv, taskArgs) <> 0 Then
        Dim taskHandled As Integer
        If X64TaskEmitValue(ps, nodeIdx, cg, taskHandled, errText) = 0 Then Return 0
        If X64TypeToFloatKind(taskType) <> 0 Then
            X64EmitText cg, "    movq xmm0, rax"
        Else
            X64EmitText cg, "    cvtsi2sd xmm0, rax"
        End If
        If targetKind = UXF_F32 Then X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
        Return 1
    End If
    If X64IsExtFpKind(targetKind) <> 0 Then
        errText = "x64-codegen: " & X64FloatKindToExtFpTypeName(targetKind) & " expression must use external FP runtime call path; XMM/native register path is invalid"
        Return 0
    End If

    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "x64-codegen: invalid expr node"
        Return 0
    End If

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)

    Select Case nodeKind
    Case "INCDEC_EXPR"
        Return X64EmitLValueUpdate(ps, nodeIdx, cg, targetKind, errText)
    Case "UNARY"
        Dim unaryOp As String = X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
        If unaryOp = "-" Or unaryOp = "+" Or unaryOp = "" Then
            Dim unaryOperand As Integer = ps.ast.nodes(nodeIdx).left
            If unaryOperand = -1 Then unaryOperand = ps.ast.nodes(nodeIdx).right
            If unaryOperand = -1 Then unaryOperand = X64ChildAt(ps, nodeIdx, 0)
            If X64EmitExprToXmm0As(ps, unaryOperand, cg, targetKind, errText) = 0 Then Return 0
            If unaryOp = "-" Then
                ' IEEE sign-bit inversion preserves signed zero and NaN payloads.
                If targetKind = UXF_F32 Then
                    X64EmitText cg, "    mov eax, 0x80000000"
                    X64EmitText cg, "    movd xmm1, eax"
                    X64EmitText cg, "    xorps xmm0, xmm1"
                Else
                    X64EmitText cg, "    mov rax, 0x8000000000000000"
                    X64EmitText cg, "    movq xmm1, rax"
                    X64EmitText cg, "    xorpd xmm0, xmm1"
                End If
            End If
            Return 1
        End If
        ' Logical/bitwise unary expressions have integer results even with a float context.
        If X64EmitExprToRax(ps, nodeIdx, cg, errText) = 0 Then Return 0
        If targetKind = UXF_F32 Then X64EmitText cg, "    cvtsi2ss xmm0, rax" Else X64EmitText cg, "    cvtsi2sd xmm0, rax"
        Return 1
    Case "TERNARY_EXPR"
        Dim conditionNode As Integer = ps.ast.nodes(nodeIdx).left
        Dim trueNode As Integer = X64ChildAt(ps, nodeIdx, 0)
        Dim falseNode As Integer = ps.ast.nodes(nodeIdx).right
        If conditionNode = -1 Or trueNode = -1 Or falseNode = -1 Then errText = "x64-codegen: ternary expression incomplete": Return 0
        Dim trueLabel As String = X64NextLabel(cg, "tern_float_true")
        Dim falseLabel As String = X64NextLabel(cg, "tern_float_false")
        Dim endLabel As String = X64NextLabel(cg, "tern_float_end")
        If X64InferFloatKindOfExpr(ps, conditionNode, cg) <> UXF_UNKNOWN Then
            If X64EmitExprToXmm0As(ps, conditionNode, cg, UXF_F64, errText) = 0 Then Return 0
            X64EmitText cg, "    pxor xmm1, xmm1"
            X64EmitText cg, "    ucomisd xmm0, xmm1"
            X64EmitText cg, "    jp " & trueLabel
            X64EmitText cg, "    je " & falseLabel
        Else
            If X64EmitExprToRax(ps, conditionNode, cg, errText) = 0 Then Return 0
            X64EmitText cg, "    test rax, rax"
            X64EmitText cg, "    jz " & falseLabel
        End If
        X64EmitLabel cg, trueLabel
        If X64EmitExprToXmm0As(ps, trueNode, cg, targetKind, errText) = 0 Then Return 0
        X64EmitText cg, "    jmp " & endLabel
        X64EmitLabel cg, falseLabel
        If X64EmitExprToXmm0As(ps, falseNode, cg, targetKind, errText) = 0 Then Return 0
        X64EmitLabel cg, endLabel
        Return 1
    Case "NUMBER", "INTEGER", "INT", "INT_LITERAL"
        Dim rawNumber As String
        rawNumber = Trim(ps.ast.nodes(nodeIdx).value)
        If rawNumber = "" Then rawNumber = "0"
        Dim lbl As String
        lbl = X64CreateFloatConstant(cg, rawNumber, targetKind)
        If targetKind = UXF_F32 Then
            X64EmitText cg, "    movss xmm0, [rel " & lbl & "]"
        Else
            X64EmitText cg, "    movsd xmm0, [rel " & lbl & "]"
        End If
        Return 1
    Case "BINARY", "BINARY_EXPR", "BINOP", "OP", "ADD", "SUB", "MUL", "DIV"
        Dim opKey As String
        opKey = X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
        If opKey = "" Then opKey = nodeKind

        If opKey = "+" Or opKey = "ADD" Or opKey = "-" Or opKey = "SUB" Or opKey = "*" Or opKey = "MUL" Or opKey = "/" Or opKey = "DIV" Then
            Return X64EmitFloatBinaryAs(ps, nodeIdx, cg, targetKind, errText)
        End If
        ' S-675: integer-valued operators (\, MOD, AND, OR, XOR, shifts, comparisons) inside a floating context used to fall out of
        ' this Select without a result or a message ("x64 build basarisiz:" and nothing else). Evaluate as an integer, then widen.
        If X64EmitExprToRax(ps, nodeIdx, cg, errText) = 0 Then Return 0
        X64EmitIntRaxToXmm0 cg, targetKind, UXBExprIsU64(ps, nodeIdx)
        Return 1
    Case "STRING", "STRING_LITERAL"
        errText = "x64-codegen: cannot use string as float"
        Return 0
    Case "IDENT", "IDENTIFIER", "VAR", "NAME", "VAR_REF", "KEYWORD_REF"
        Dim identName As String
        identName = Trim(ps.ast.nodes(nodeIdx).value)
        If X64Upper(identName) = "TRUE" Then
            If targetKind = UXF_F32 Then
                X64EmitText cg, "    mov eax, -1"
                X64EmitText cg, "    cvtsi2ss xmm0, eax"
            Else
                X64EmitText cg, "    mov rax, -1"
                X64EmitText cg, "    cvtsi2sd xmm0, rax"
            End If
            Return 1
        ElseIf X64Upper(identName) = "FALSE" Then
            If targetKind = UXF_F32 Then
                X64EmitText cg, "    xor eax, eax"
                X64EmitText cg, "    cvtsi2ss xmm0, eax"
            Else
                X64EmitText cg, "    xor rax, rax"
                X64EmitText cg, "    cvtsi2sd xmm0, rax"
            End If
            Return 1
        Else
            Dim declType As String
            declType = ""
            Dim haveDeclType As Integer = X64TryGetVarType(cg, identName, declType)
            If haveDeclType = 0 Then haveDeclType = X64FindDeclaredTypeName(ps, identName, declType)
            If haveDeclType <> 0 Then
                Dim declKind As Integer
                declKind = X64TypeToFloatKind(declType)
                If declKind = UXF_F80 Then
                    errText = "x64-codegen: F80 variable load requires x87/ST0 path"
                    Return 0
                End If

                If declKind = UXF_F32 Or declKind = UXF_F64 Then
                    If X64EmitLoadFloatVarToXmm0As(ps, cg, identName, declKind, errText) = 0 Then Return 0
                    If declKind = UXF_F32 And targetKind = UXF_F64 Then
                        X64EmitText cg, "    cvtss2sd xmm0, xmm0"
                    ElseIf declKind = UXF_F64 And targetKind = UXF_F32 Then
                        X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
                    End If
                    Return 1
                End If
            ElseIf VarMappingEmitLoadXmm(cg.localVars, cg.currentRoutineLabel, identName, cg.textSection) <> 0 Then
                ' S-526: a frame slot is read as a double only when nothing is known about its type (compiler temporaries).
                ' The shortcut used to run FIRST: a routine-local I32/I64 was loaded with `movsd`, i.e. its bit pattern was read
                ' as a double (`v * k` -> 4.69e-320, `v / k` -> inf) and an F32 local was read at the wrong width.
                Return 1
            End If

            ' integer variable: load as integer and convert numerically
            X64EmitLoadVar cg, identName
            X64EmitIntRaxToXmm0 cg, targetKind, UXBExprIsU64(ps, nodeIdx)
            Return 1
        End If
    Case "FIELD_EXPR"
        ' S-095: a float TYPE field is loaded straight into xmm0 by X64EmitLoadFieldExpr.
        ' It used to reach the generic fallback below, which called that (correct) load
        ' and then ran `cvtsi2sd xmm0, rax` over it, replacing the field's value with the
        ' converted FIELD ADDRESS (PRINT q.B showed 1.4e14 for 1.5).
        Dim fieldXmmKind As Integer
        fieldXmmKind = X64InferFloatKindOfExpr(ps, nodeIdx, cg)
        If fieldXmmKind = UXF_F32 Or fieldXmmKind = UXF_F64 Then
            If X64EmitLoadFieldExpr(ps, nodeIdx, cg, errText) = 0 Then Return 0
            If fieldXmmKind = UXF_F32 And targetKind = UXF_F64 Then
                X64EmitText cg, "    cvtss2sd xmm0, xmm0"
            ElseIf fieldXmmKind = UXF_F64 And targetKind = UXF_F32 Then
                X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
            End If
            Return 1
        End If
        If X64EmitExprToRax(ps, nodeIdx, cg, errText) = 0 Then Return 0
        If targetKind = UXF_F32 Then
            X64EmitText cg, "    cvtsi2ss xmm0, rax"
        Else
            X64EmitText cg, "    cvtsi2sd xmm0, rax"
        End If
        Return 1
    Case "CALL_EXPR"
        Dim indexedBaseName As String
        Dim indexedExpr As Integer
        If X64TryExtractIndexedTarget(ps, nodeIdx, indexedBaseName, indexedExpr) <> 0 Then
            ' S-502: indexed XMM loaders preserve the array element width.  A
            ' F32 element therefore arrives in xmm0 as a single, but callers
            ' such as PRINT/STR/F64 request the expression in F64 form.  The
            ' old path treated the 32-bit payload as an already-valid double,
            ' producing zero or a tiny denormal instead of the element value.
            Dim indexedSourceKind As Integer
            indexedSourceKind = X64InferFloatKindOfExpr(ps, nodeIdx, cg)
            If indexedSourceKind <> UXF_F32 And indexedSourceKind <> UXF_F64 Then
                ' Integer array cells must be numerically widened, never read
                ' through MOVSS/MOVSD as if their integer bits were IEEE values.
                If X64EmitExprToRax(ps, nodeIdx, cg, errText) = 0 Then Return 0
                If targetKind = UXF_F32 Then X64EmitText cg, "    cvtsi2ss xmm0, rax" Else X64EmitText cg, "    cvtsi2sd xmm0, rax"
                Return 1
            End If
            If cg.currentRoutineLabel <> "" And X64EmitLoadIndexedLocalXmm(ps, cg, indexedBaseName, indexedExpr, errText) <> 0 Then
                If indexedSourceKind = UXF_F32 And targetKind = UXF_F64 Then
                    X64EmitText cg, "    cvtss2sd xmm0, xmm0"
                ElseIf indexedSourceKind = UXF_F64 And targetKind = UXF_F32 Then
                    X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
                End If
                Return 1
            End If
            If X64EmitLoadIndexedGlobalXmm(ps, cg, indexedBaseName, indexedExpr, errText) <> 0 Then
                If indexedSourceKind = UXF_F32 And targetKind = UXF_F64 Then
                    X64EmitText cg, "    cvtss2sd xmm0, xmm0"
                ElseIf indexedSourceKind = UXF_F64 And targetKind = UXF_F32 Then
                    X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
                End If
                Return 1
            End If
        End If

        ' handle builtin float calls and math
        Dim callName As String
        callName = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))
        Dim argNode As Integer
        argNode = X64ChildAt(ps, nodeIdx, 0)
        If callName = "CDBL" Or callName = "CSNG" Then
            If argNode < 0 OrElse ps.ast.nodes(argNode).nextSibling >= 0 Then errText = "x64-codegen: floating conversion requires one argument": Return 0
            Dim conversionKind As Integer = IIf(callName = "CSNG", UXF_F32, UXF_F64)
            If X64EmitExprToXmm0As(ps, argNode, cg, conversionKind, errText) = 0 Then Return 0
            If conversionKind = UXF_F32 And targetKind = UXF_F64 Then X64EmitText cg, "    cvtss2sd xmm0, xmm0"
            If conversionKind = UXF_F64 And targetKind = UXF_F32 Then X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
            Return 1
        ElseIf callName = "ABS" Then
            If argNode <> -1 Then
                If X64EmitExprToXmm0As(ps, argNode, cg, targetKind, errText) = 0 Then Return 0
            Else
                X64EmitText cg, "    xorps xmm0, xmm0"
            End If
            If targetKind = UXF_F32 Then
                X64EmitText cg, "    movd eax, xmm0"
                X64EmitText cg, "    and eax, 2147483647"
                X64EmitText cg, "    movd xmm0, eax"
            Else
                X64EmitText cg, "    movq rax, xmm0"
                X64EmitText cg, "    btr rax, 63"
                X64EmitText cg, "    movq xmm0, rax"
            End If
            Return 1
        ElseIf callName = "SQR" Then
            If argNode <> -1 Then
                If X64EmitExprToXmm0As(ps, argNode, cg, targetKind, errText) = 0 Then Return 0
            Else
                X64EmitText cg, "    xorps xmm0, xmm0"
            End If
            If targetKind = UXF_F32 Then
                X64EmitText cg, "    sqrtss xmm0, xmm0"
            Else
                X64EmitText cg, "    sqrtsd xmm0, xmm0"
            End If
            Return 1
        ElseIf callName = "SIN" Or callName = "COS" Or callName = "TAN" Or callName = "ATN" Or callName = "EXP" Or callName = "LOG" Then
            If argNode <> -1 Then
                If X64EmitExprToXmm0As(ps, argNode, cg, targetKind, errText) = 0 Then Return 0
            Else
                X64EmitText cg, "    xorps xmm0, xmm0"
            End If
            ' S-144: aligned at run time (a pending `push` of an enclosing binary expression leaves RSP 8 mod 16)
            ' S-538: the arc tangent is ATN in the language and `atan` in the C library; the assembler stopped with "symbol `atn' not defined".
            Dim mathLibSymbol As String = LCase(Trim(ps.ast.nodes(nodeIdx).value))
            If mathLibSymbol = "atn" Then mathLibSymbol = "atan"
            X64EmitCall0 cg, mathLibSymbol
            Return 1
        ElseIf callName = "FIX" Then
            ' FIX returns an integer, but it can appear in a floating target
            ' expression (for example: DIM f AS F64 : f = FIX(p)). Evaluate
            ' through the normal integer builtin path, then widen explicitly.
            If X64EmitExprToRax(ps, nodeIdx, cg, errText) = 0 Then Return 0
            If targetKind = UXF_F32 Then
                X64EmitText cg, "    cvtsi2ss xmm0, rax"
            Else
                X64EmitText cg, "    cvtsi2sd xmm0, rax"
            End If
            Return 1
        End If

        ' generic call - consult routine registry
        If X64EmitCallNodeToXmm0As(ps, nodeIdx, cg, targetKind, errText) = 0 Then Return 0
        Return 1
    Case Else
        ' fallback: evaluate to integer and convert
        If X64EmitExprToRax(ps, nodeIdx, cg, errText) = 0 Then Return 0
        X64EmitIntRaxToXmm0 cg, targetKind, UXBExprIsU64(ps, nodeIdx)
        Return 1
    End Select
End Function

Private Sub X64EmitStoreVarXmm(ByRef cg As X64CodegenContext, ByRef varName As String)
    Dim errText As String
    errText = ""
    If X64EmitStoreXmm0ToFloatVarAs(cg, varName, UXF_F64, errText) = 0 Then
        X64EmitComment cg, errText
    End If
End Sub

Private Function X64EmitStoreIndexedLocalXmm(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal indexExpr As Integer, ByRef errText As String) As Integer
    Dim localOffset As Integer
    Dim slotCount As Integer
    If X64TryFindLocalInfo(cg, varName, localOffset, slotCount) = 0 Then Return 0
    If X64SdaKind(ps, varName) <> 0 Then
        If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
        If X64EmitSdaElementAddr(ps, cg, varName) = 0 Then Return 0
        X64EmitText cg, IIf(X64SdaStride(ps, varName) = 4, "    movss [rcx], xmm0", "    movsd [rcx], xmm0")
        Return 1
    End If
    If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
    Dim lowerBoundXL As LongInt
    lowerBoundXL = X64LocalArrayLowerBoundOf(ps, cg, varName)
    If lowerBoundXL <> 0 Then X64EmitText cg, "    sub rax, " & LTrim(Str(lowerBoundXL))
    X64EmitClassArrayIndexCheck ps, cg, varName, slotCount
    X64EmitText cg, "    mov rbx, rax"
    Dim strideL As Integer
    strideL = 8
    If X64TryGetLocalElemBytes(cg, varName, strideL) = 0 Then strideL = 8
    Dim idxOverflowL As String
    idxOverflowL = X64NextLabel(cg, "idx_overflow")
    Dim idxScaledL As String
    idxScaledL = X64NextLabel(cg, "idx_scaled")
    X64EmitText cg, "    imul rbx, " & X64ToStr(strideL)
    X64EmitText cg, "    jno " & idxScaledL
    X64EmitText cg, "    mov rbx, 0"
    X64EmitText cg, "    jmp " & idxOverflowL
    X64EmitLabel cg, idxScaledL
    X64EmitLocalArrayBaseToRcx ps, cg, varName, localOffset
    X64EmitText cg, "    add rcx, rbx"
    If strideL = 4 Then
        X64EmitText cg, "    movss [rcx], xmm0"
    ElseIf strideL = 8 Then
        X64EmitText cg, "    movsd [rcx], xmm0"
    ElseIf strideL = 10 Then
        errText = "x64-codegen: F80 indexed XMM load/store is invalid"
        Return 0
    Else
        X64EmitText cg, "    movsd [rcx], xmm0"
    End If
    X64EmitLabel cg, idxOverflowL
    Return 1
End Function

Private Function X64EmitStoreIndexedGlobalXmm(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal indexExpr As Integer, ByRef errText As String) As Integer
    Dim labelText As String
    Dim slotCount As Integer
    If X64TryFindGlobalInfo(cg, varName, labelText, slotCount) = 0 Then Return 0
    If X64SdaKind(ps, varName) <> 0 Then
        If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
        If X64EmitSdaElementAddr(ps, cg, varName) = 0 Then Return 0
        X64EmitText cg, IIf(X64SdaStride(ps, varName) = 4, "    movss [rcx], xmm0", "    movsd [rcx], xmm0")
        Return 1
    End If
    If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
    Dim lowerBoundXG As LongInt
    lowerBoundXG = X64ArrayLowerBoundOf(ps, varName)
    If lowerBoundXG <> 0 Then X64EmitText cg, "    sub rax, " & LTrim(Str(lowerBoundXG))
    X64EmitClassArrayIndexCheck ps, cg, varName, slotCount
    X64EmitText cg, "    mov rbx, rax"
    Dim gStrideX As Integer
    gStrideX = 8
    If X64TryGetGlobalElemBytes(cg, varName, gStrideX) = 0 Then gStrideX = 8
    Dim idxOverflowG As String
    idxOverflowG = X64NextLabel(cg, "idx_overflow")
    Dim idxScaledG As String
    idxScaledG = X64NextLabel(cg, "idx_scaled")
    X64EmitText cg, "    imul rbx, " & X64ToStr(gStrideX)
    X64EmitText cg, "    jno " & idxScaledG
    X64EmitText cg, "    mov rbx, 0"
    X64EmitText cg, "    jmp " & idxOverflowG
    X64EmitLabel cg, idxScaledG
    X64EmitText cg, "    lea rcx, [rel " & labelText & "]"
    X64EmitText cg, "    add rcx, rbx"
    If gStrideX = 4 Then
        X64EmitText cg, "    movss [rcx], xmm0"
    ElseIf gStrideX = 8 Then
        X64EmitText cg, "    movsd [rcx], xmm0"
    ElseIf gStrideX = 10 Then
        errText = "x64-codegen: F80 indexed XMM load/store is invalid"
        Return 0
    Else
        X64EmitText cg, "    movsd [rcx], xmm0"
    End If
    X64EmitLabel cg, idxOverflowG
    Return 1
End Function

Private Function X64EmitLoadIndexedLocalXmm(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal indexExpr As Integer, ByRef errText As String) As Integer
    Dim baseOffset As Integer
    Dim slotCount As Integer
    If X64TryFindLocalInfo(cg, varName, baseOffset, slotCount) = 0 Then Return 0
    If X64SdaKind(ps, varName) <> 0 Then
        If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
        If X64EmitSdaElementAddr(ps, cg, varName) = 0 Then Return 0
        X64EmitText cg, IIf(X64SdaStride(ps, varName) = 4, "    movss xmm0, [rcx]", "    movsd xmm0, [rcx]")
        Return 1
    End If

    If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
    Dim lowerBoundXLL As LongInt
    lowerBoundXLL = X64LocalArrayLowerBoundOf(ps, cg, varName)
    If lowerBoundXLL <> 0 Then X64EmitText cg, "    sub rax, " & LTrim(Str(lowerBoundXLL))
    X64EmitClassArrayIndexCheck ps, cg, varName, slotCount

    X64EmitText cg, "    mov rbx, rax"
    Dim strideLL As Integer
    strideLL = 8
    If X64TryGetLocalElemBytes(cg, varName, strideLL) = 0 Then strideLL = 8
    Dim idxOverflowLL As String
    idxOverflowLL = X64NextLabel(cg, "idx_overflow")
    Dim idxScaledLL As String
    idxScaledLL = X64NextLabel(cg, "idx_scaled")
    X64EmitText cg, "    imul rbx, " & X64ToStr(strideLL)
    X64EmitText cg, "    jno " & idxScaledLL
    X64EmitText cg, "    mov rbx, 0"
    X64EmitText cg, "    jmp " & idxOverflowLL
    X64EmitLabel cg, idxScaledLL
    X64EmitLocalArrayBaseToRcx ps, cg, varName, baseOffset
    X64EmitText cg, "    add rcx, rbx"
    If strideLL = 4 Then
        X64EmitText cg, "    movss xmm0, [rcx]"
    ElseIf strideLL = 8 Then
        X64EmitText cg, "    movsd xmm0, [rcx]"
    ElseIf strideLL = 10 Then
        errText = "x64-codegen: F80 indexed XMM load/store is invalid"
        Return 0
    Else
        X64EmitText cg, "    movsd xmm0, [rcx]"
    End If
    X64EmitLabel cg, idxOverflowLL
    Return 1
End Function

Private Function X64EmitLoadIndexedGlobalXmm(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal indexExpr As Integer, ByRef errText As String) As Integer
    Dim labelText As String
    Dim slotCount As Integer
    If X64TryFindGlobalInfo(cg, varName, labelText, slotCount) = 0 Then Return 0
    If X64SdaKind(ps, varName) <> 0 Then
        If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
        If X64EmitSdaElementAddr(ps, cg, varName) = 0 Then Return 0
        X64EmitText cg, IIf(X64SdaStride(ps, varName) = 4, "    movss xmm0, [rcx]", "    movsd xmm0, [rcx]")
        Return 1
    End If
    If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
    Dim lowerBoundXGG As LongInt
    lowerBoundXGG = X64ArrayLowerBoundOf(ps, varName)
    If lowerBoundXGG <> 0 Then X64EmitText cg, "    sub rax, " & LTrim(Str(lowerBoundXGG))
    X64EmitClassArrayIndexCheck ps, cg, varName, slotCount
    X64EmitText cg, "    mov rbx, rax"
    Dim gStrideXX As Integer
    gStrideXX = 8
    If X64TryGetGlobalElemBytes(cg, varName, gStrideXX) = 0 Then gStrideXX = 8
    Dim idxOverflowGG As String
    idxOverflowGG = X64NextLabel(cg, "idx_overflow")
    Dim idxScaledGG As String
    idxScaledGG = X64NextLabel(cg, "idx_scaled")
    X64EmitText cg, "    imul rbx, " & X64ToStr(gStrideXX)
    X64EmitText cg, "    jno " & idxScaledGG
    X64EmitText cg, "    mov rbx, 0"
    X64EmitText cg, "    jmp " & idxOverflowGG
    X64EmitLabel cg, idxScaledGG
    X64EmitText cg, "    lea rcx, [rel " & labelText & "]"
    X64EmitText cg, "    add rcx, rbx"
    If gStrideXX = 4 Then
        X64EmitText cg, "    movss xmm0, [rcx]"
    ElseIf gStrideXX = 8 Then
        X64EmitText cg, "    movsd xmm0, [rcx]"
    ElseIf gStrideXX = 10 Then
        errText = "x64-codegen: F80 indexed XMM load/store is invalid"
        Return 0
    Else
        X64EmitText cg, "    movsd xmm0, [rcx]"
    End If
    X64EmitLabel cg, idxOverflowGG
    Return 1
End Function

Private Function X64TryGetNumberLiteral(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef rawOut As String) As Integer
    rawOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim k As String
    k = X64Upper(ps.ast.nodes(nodeIdx).kind)
    If k <> "NUMBER" And k <> "INTEGER" And k <> "INT" And k <> "INT_LITERAL" Then Return 0

    rawOut = Trim(ps.ast.nodes(nodeIdx).value)
    If rawOut = "" Then rawOut = "0.0"
    If InStr(rawOut, ".") = 0 And InStr(UCase(rawOut), "E") = 0 Then rawOut = rawOut & ".0"
    Return 1
End Function

Private Sub X64EmitStoreF80FromLabelAtRcX(ByRef cg As X64CodegenContext, ByRef srcLabel As String)
    X64EmitText cg, "    lea rdx, [rel " & srcLabel & "]"
    X64EmitText cg, "    mov rax, [rdx]"
    X64EmitText cg, "    mov [rcx], rax"
    X64EmitText cg, "    mov ax, [rdx + 8]"
    X64EmitText cg, "    mov [rcx + 8], ax"
End Sub

Private Function X64EmitStoreF80LiteralVar(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByRef rawNumber As String, ByRef errText As String) As Integer
    Dim litLabel As String
    litLabel = X64CreateFloatConstant(cg, rawNumber, UXF_F80)

    Dim localOffset As Integer
    Dim slotCount As Integer
    If cg.currentRoutineLabel <> "" Then
        If X64TryFindLocalInfo(cg, varName, localOffset, slotCount) <> 0 Then
            X64EmitText cg, "    lea rcx, " & X64FormatRbpRef(localOffset)
            X64EmitStoreF80FromLabelAtRcX(cg, litLabel)
            Return 1
        End If
    End If

    Dim globalLabel As String
    If X64TryFindGlobalInfo(cg, varName, globalLabel, slotCount) <> 0 Then
        X64EmitText cg, "    lea rcx, [rel " & globalLabel & "]"
        X64EmitStoreF80FromLabelAtRcX(cg, litLabel)
        Return 1
    End If

    If cg.currentRoutineLabel <> "" And X64HasTopLevelGlobalDecl(ps, varName) = 0 Then
        localOffset = X64EnsureLocalSlot(cg, varName, 1, 10)
        X64EmitText cg, "    lea rcx, " & X64FormatRbpRef(localOffset)
        X64EmitStoreF80FromLabelAtRcX(cg, litLabel)
        Return 1
    End If

    globalLabel = X64EnsureGlobalSymbol(cg, varName, 1, 10)
    X64EmitText cg, "    lea rcx, [rel " & globalLabel & "]"
    X64EmitStoreF80FromLabelAtRcX(cg, litLabel)
    Return 1
End Function

Private Function X64EmitStoreIndexedLocalF80Literal(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal indexExpr As Integer, ByRef rawNumber As String, ByRef errText As String) As Integer
    Dim baseOffset As Integer
    Dim slotCount As Integer
    If X64TryFindLocalInfo(cg, varName, baseOffset, slotCount) = 0 Then Return 0
    If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
    Dim lowerBoundF80L As LongInt
    lowerBoundF80L = X64LocalArrayLowerBoundOf(ps, cg, varName)
    If lowerBoundF80L <> 0 Then X64EmitText cg, "    sub rax, " & LTrim(Str(lowerBoundF80L))
    X64EmitClassArrayIndexCheck ps, cg, varName, slotCount

    Dim strideBytes As Integer
    strideBytes = 10
    If X64TryGetLocalElemBytes(cg, varName, strideBytes) = 0 Then strideBytes = 10
    If strideBytes <> 10 Then Return 0

    Dim litLabel As String
    litLabel = X64CreateFloatConstant(cg, rawNumber, UXF_F80)

    X64EmitText cg, "    mov rbx, rax"
    X64EmitText cg, "    imul rbx, " & X64ToStr(strideBytes)
    X64EmitLocalArrayBaseToRcx ps, cg, varName, baseOffset
    X64EmitText cg, "    add rcx, rbx"
    X64EmitStoreF80FromLabelAtRcX(cg, litLabel)
    Return 1
End Function

Private Function X64EmitStoreIndexedGlobalF80Literal(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef varName As String, ByVal indexExpr As Integer, ByRef rawNumber As String, ByRef errText As String) As Integer
    Dim labelText As String
    Dim slotCount As Integer
    If X64TryFindGlobalInfo(cg, varName, labelText, slotCount) = 0 Then Return 0
    If X64EmitExprToRax(ps, indexExpr, cg, errText) = 0 Then Return 0
    Dim lowerBoundF80G As LongInt
    lowerBoundF80G = X64ArrayLowerBoundOf(ps, varName)
    If lowerBoundF80G <> 0 Then X64EmitText cg, "    sub rax, " & LTrim(Str(lowerBoundF80G))
    X64EmitClassArrayIndexCheck ps, cg, varName, slotCount

    Dim strideBytes As Integer
    strideBytes = 10
    If X64TryGetGlobalElemBytes(cg, varName, strideBytes) = 0 Then strideBytes = 10
    If strideBytes <> 10 Then Return 0

    Dim litLabel As String
    litLabel = X64CreateFloatConstant(cg, rawNumber, UXF_F80)

    X64EmitText cg, "    mov rbx, rax"
    X64EmitText cg, "    imul rbx, " & X64ToStr(strideBytes)
    X64EmitText cg, "    lea rcx, [rel " & labelText & "]"
    X64EmitText cg, "    add rcx, rbx"
    X64EmitStoreF80FromLabelAtRcX(cg, litLabel)
    Return 1
End Function


Private Function X64FloatKindToExtFpTypeName(ByVal kind As Integer) As String
    Select Case kind
    Case UXF_F80
        Return "F80"
    Case UXF_F128
        Return "F128"
    Case Else
        Return ""
    End Select
End Function

Private Function X64IsExtFpKind(ByVal kind As Integer) As Integer
    If kind = UXF_F80 Or kind = UXF_F128 Then Return 1
    Return 0
End Function

Private Function X64CStringDbBytes(ByRef rawText As String) As String
    Dim As String outText
    outText = ""
    Dim As Integer i
    For i = 1 To Len(rawText)
        If Len(outText) > 0 Then outText &= ", "
        outText &= LTrim(Str(Asc(Mid(rawText, i, 1))))
    Next
    Return outText
End Function

Private Function X64CreateCStringConstant(ByRef cg As X64CodegenContext, ByRef rawText As String, ByRef stemText As String) As String
    Dim As String lbl
    lbl = X64NextLabel(cg, stemText)
    Dim As String bytesText
    bytesText = X64CStringDbBytes(rawText)
    If bytesText = "" Then
        X64EmitData cg, lbl & ": db 0"
    Else
        X64EmitData cg, lbl & ": db " & bytesText & ", 0"
    End If
    If InStr(rawText, Chr(0)) > 0 Then
        cg.literalSpans &= "    dq " & lbl & ", " & LTrim(Str(Len(rawText))) & Chr(10)
        cg.literalSpanCount += 1
    End If
    Return lbl
End Function

Private Function X64ExtFpStrideBytes(ByVal kind As Integer) As Integer
    Select Case kind
    Case UXF_F80
        Return 10
    Case UXF_F128
        Return 16
    Case Else
        Return 8
    End Select
End Function

Private Function X64EmitExtFpAddrOfExprToRax(ByRef ps As ParseState, ByVal exprNode As Integer, ByRef cg As X64CodegenContext, ByVal kind As Integer, ByRef errText As String) As Integer
    If exprNode < 0 Or exprNode >= ps.ast.count Then
        errText = "x64-codegen: external FP expression address node is invalid"
        Return 0
    End If

    Dim As String exprKind
    exprKind = X64Upper(ps.ast.nodes(exprNode).kind)

    If exprKind = "FIELD_EXPR" Or (exprKind = "CALL_EXPR" And InStr(Trim(ps.ast.nodes(exprNode).value), ".") > 0) Then
        Dim As String fieldType
        Dim As Integer fieldSize
        If X64EmitAddrOfFieldExpr(ps, exprNode, cg, fieldType, fieldSize, errText) = 0 Then Return 0
        If X64TypeToFloatKind(fieldType) <> kind Then
            errText = "x64-codegen: external FP field type mismatch; expected " & X64FloatKindToExtFpTypeName(kind) & " got " & fieldType
            Return 0
        End If
        Return 1
    End If

    Dim As String baseName
    Dim As Integer indexExpr
    baseName = ""
    indexExpr = -1
    If X64TryExtractIndexedTarget(ps, exprNode, baseName, indexExpr) <> 0 Then
        Dim As Integer strideBytes
        strideBytes = X64ExtFpStrideBytes(kind)
        If cg.currentRoutineLabel <> "" Then
            If X64EmitAddrOfIndexedLocal(ps, cg, baseName, indexExpr, strideBytes, errText) <> 0 Then Return 1
        End If
        If X64EmitAddrOfIndexedGlobal(ps, cg, baseName, indexExpr, strideBytes, errText) <> 0 Then Return 1
        errText = "x64-codegen: external FP indexed address failed for " & baseName
        Return 0
    End If

    If exprKind = "IDENT" Or exprKind = "IDENTIFIER" Or exprKind = "VAR" Or exprKind = "VAR_REF" Or exprKind = "KEYWORD_REF" Then
        Return X64EmitAddrOfVar(cg, Trim(ps.ast.nodes(exprNode).value), errText)
    End If

    errText = "x64-codegen: external FP expression path is not addressable yet: " & exprKind
    Return 0
End Function

Private Function X64EmitExtFpStoreLiteralToAddress(ByRef ps As ParseState, ByVal rhs As Integer, ByRef cg As X64CodegenContext, ByVal kind As Integer, ByRef dstAddressExpr As String, ByRef errText As String) As Integer
    Dim As String rawText
    rawText = ""
    If X64TryGetNumberLiteral(ps, rhs, rawText) = 0 Then
        errText = "x64-codegen: external FP literal assignment requires numeric literal source"
        Return 0
    End If
    Dim As String lbl
    lbl = X64CreateCStringConstant(cg, rawText, "extfp_lit")
    Return UXBX64EmitExtFpFromStringCall(cg.textSection, X64FloatKindToExtFpTypeName(kind), lbl, dstAddressExpr, errText)
End Function

Private Function X64EmitExtFpAssignToPreparedAddress(ByRef ps As ParseState, ByVal rhs As Integer, ByRef cg As X64CodegenContext, ByVal kind As Integer, ByRef dstAddressExpr As String, ByRef errText As String) As Integer
    If rhs < 0 Or rhs >= ps.ast.count Then
        errText = "x64-codegen: external FP assignment source missing"
        Return 0
    End If

    Dim As String rhsKind
    rhsKind = X64Upper(ps.ast.nodes(rhs).kind)

    If rhsKind = "NUMBER" Or rhsKind = "FLOAT" Or rhsKind = "DOUBLE" Or rhsKind = "REAL" Or rhsKind = "INTEGER" Or rhsKind = "INT" Or rhsKind = "INT_LITERAL" Then
        Return X64EmitExtFpStoreLiteralToAddress(ps, rhs, cg, kind, dstAddressExpr, errText)
    End If

    If rhsKind = "BINARY" Or rhsKind = "BINARY_EXPR" Or rhsKind = "BINOP" Or rhsKind = "OP" Or rhsKind = "ADD" Or rhsKind = "SUB" Or rhsKind = "MUL" Or rhsKind = "DIV" Then
        Dim As Integer lhsNode
        Dim As Integer rhsNode
        lhsNode = ps.ast.nodes(rhs).left
        rhsNode = ps.ast.nodes(rhs).right
        If lhsNode = -1 Then lhsNode = X64ChildAt(ps, rhs, 0)
        If rhsNode = -1 Then rhsNode = X64ChildAt(ps, rhs, 1)
        If lhsNode = -1 Or rhsNode = -1 Then
            errText = "x64-codegen: external FP binary assignment missing operand"
            Return 0
        End If

        If X64EmitExtFpAddrOfExprToRax(ps, lhsNode, cg, kind, errText) = 0 Then Return 0
        X64EmitText cg, "    mov r10, rax"
        If X64EmitExtFpAddrOfExprToRax(ps, rhsNode, cg, kind, errText) = 0 Then Return 0
        X64EmitText cg, "    mov r11, rax"

        Dim As String opName
        opName = Trim(ps.ast.nodes(rhs).op)
        If opName = "" Then opName = X64Upper(ps.ast.nodes(rhs).kind)
        Return UXBX64EmitExtFpBinaryCall(cg.textSection, X64FloatKindToExtFpTypeName(kind), opName, "[r10]", "[r11]", dstAddressExpr, errText)
    End If

    If X64EmitExtFpAddrOfExprToRax(ps, rhs, cg, kind, errText) = 0 Then Return 0
    X64EmitText cg, "    mov r10, rax"
    Return UXBX64EmitExtFpCopyCall(cg.textSection, X64FloatKindToExtFpTypeName(kind), "[r10]", dstAddressExpr, errText)
End Function

Private Function X64EmitExtFpAssignStmtCore(ByRef ps As ParseState, ByVal lhs As Integer, ByVal rhs As Integer, ByRef cg As X64CodegenContext, ByVal kind As Integer, ByRef errText As String) As Integer
    If X64EmitExtFpAddrOfExprToRax(ps, lhs, cg, kind, errText) = 0 Then Return 0
    X64EmitText cg, "    mov r9, rax"
    Return X64EmitExtFpAssignToPreparedAddress(ps, rhs, cg, kind, "[r9]", errText)
End Function

Private Function X64EmitExtFpPrintExpr(ByRef ps As ParseState, ByVal exprNode As Integer, ByRef cg As X64CodegenContext, ByVal kind As Integer, ByRef errText As String) As Integer
    If X64EmitExtFpAddrOfExprToRax(ps, exprNode, cg, kind, errText) = 0 Then Return 0
    X64EmitText cg, "    mov r10, rax"
    If UXBX64EmitExtFpToStringCall(cg.textSection, X64FloatKindToExtFpTypeName(kind), "[r10]", "[rel __uxb_extfp_str_buf]", 512, errText) = 0 Then Return 0
    X64EmitText cg, "    lea rcx, [rel __uxb_extfp_str_buf]"
    X64EmitText cg, "    call __uxb_runtime_print"
    Return 1
End Function

Private Function X64ToStr(ByVal n As Integer) As String
    Return LTrim(Str(n))
End Function

Declare Sub X64RegisterRoutineSymbol(ByVal nameText As String)

Private Function X64NormalizeTextLine(ByRef lineText As String) As String
    Dim raw As String
    raw = RTrim(lineText)

    Dim t As String
    t = Trim(raw)
    If t = "" Then Return ""

    Dim k As String
    k = X64Upper(t)

    If Left(k, 5) = "BITS " Then Return "bits " & Trim(Mid(t, 6))
    If Left(k, 8) = "DEFAULT " Then Return "default " & Trim(Mid(t, 9))
    If Left(k, 8) = "SECTION " Then Return "section " & Trim(Mid(t, 9))
    If Left(k, 7) = "GLOBAL " Then Return "global " & Trim(Mid(t, 8))
    If Left(k, 7) = "EXTERN " Then Return "extern " & Trim(Mid(t, 8))

    If Right(t, 1) = ":" Then Return t

    If Left(t, 1) = ";" Then Return "    ; " & Trim(Mid(t, 2))

    Dim p As Integer
    p = InStr(t, " ")
    If p = 0 Then Return "    " & LCase(t)

    Dim opText As String
    Dim argText As String
    opText = LCase(Left(t, p - 1))
    argText = Trim(Mid(t, p + 1))

    If argText = "" Then Return "    " & opText
    Return "    " & opText & " " & argText
End Function

Private Function X64NormalizeDataLine(ByRef lineText As String) As String
    Dim t As String
    t = Trim(RTrim(lineText))
    If t = "" Then Return ""

    If Left(t, 1) = ";" Then Return "    ; " & Trim(Mid(t, 2))

    Dim p As Integer
    p = InStr(t, ":")
    If p > 0 Then
        Dim labelText As String
        Dim restText As String
        labelText = Trim(Left(t, p))
        restText = Trim(Mid(t, p + 1))
        If restText = "" Then Return labelText
        Return labelText & " " & restText
    End If

    Return t
End Function

Private Function X64CompactBlankLines(ByRef textIn As String) As String
    Dim outText As String
    Dim prevBlank As Integer
    prevBlank = 0

    Dim i As Integer
    i = 1
    Do While i <= Len(textIn)
        Dim j As Integer
        j = InStr(i, textIn, Chr(10))

        Dim lineText As String
        If j = 0 Then
            lineText = Mid(textIn, i)
            i = Len(textIn) + 1
        Else
            lineText = Mid(textIn, i, j - i)
            i = j + 1
        End If

        lineText = RTrim(lineText)
        If Trim(lineText) = "" Then
            If prevBlank = 0 Then
                outText &= Chr(10)
                prevBlank = 1
            End If
        Else
            outText &= lineText & Chr(10)
            prevBlank = 0
        End If
    Loop

    Do While Len(outText) > 1 And Right(outText, 2) = Chr(10) & Chr(10)
        outText = Left(outText, Len(outText) - 1)
    Loop

    Return outText
End Function

Private Function X64Align16(ByVal n As Integer) As Integer
    If n <= 0 Then Return 0
    Return ((n + 15) \ 16) * 16
End Function

Private Function X64SanitizeSymbol(ByRef rawText As String) As String
    Dim src As String
    src = Trim(rawText)
    If src = "" Then Return "sym"

    Dim outText As String
    Dim i As Integer
    For i = 1 To Len(src)
        Dim ch As String
        ch = Mid(src, i, 1)
        Dim code As Integer
        code = Asc(ch)
        If (code >= Asc("A") And code <= Asc("Z")) Or _
           (code >= Asc("a") And code <= Asc("z")) Or _
           (code >= Asc("0") And code <= Asc("9")) Or _
           ch = "_" Then
            outText &= ch
        Else
            outText &= "_"
        End If
    Next i

    If Len(outText) = 0 Then outText = "sym"
    If Mid(outText, 1, 1) >= "0" And Mid(outText, 1, 1) <= "9" Then outText = "_" & outText
    Return outText
End Function

Private Function X64ClassVTableLabel(ByRef className As String) As String
    Dim s As String
    s = X64SanitizeSymbol(LCase(Trim(className)))
    Return "__uxb_vtbl_" & s
End Function

Private Function X64ScopedLabelSymbol(ByRef cg As X64CodegenContext, ByRef rawLabel As String) As String
    Dim scopeText As String
    scopeText = cg.currentRoutineLabel
    If Trim(scopeText) = "" Then scopeText = "__uxb_main"
    Return "__uxb_label_" & X64SanitizeSymbol(scopeText) & "_" & X64SanitizeSymbol(rawLabel)
End Function

Private Sub X64EmitText(ByRef cg As X64CodegenContext, ByRef lineText As String)
    cg.textSection &= X64NormalizeTextLine(lineText) & Chr(10)
End Sub

Private Sub X64EmitData(ByRef cg As X64CodegenContext, ByRef lineText As String)
    cg.dataSection &= X64NormalizeDataLine(lineText) & Chr(10)
End Sub

Private Sub X64EmitBss(ByRef cg As X64CodegenContext, ByRef lineText As String)
    cg.bssSection &= lineText & Chr(10)
End Sub

Private Sub X64EmitComment(ByRef cg As X64CodegenContext, ByRef commentText As String)
    X64EmitText cg, "; " & commentText
End Sub

Private Sub X64EmitCallRaw(ByRef cg As X64CodegenContext, ByRef symbolName As String)
    ' S-144: align the stack at run time. The emitter keeps intermediate values with `push rax` while it
    ' evaluates the right-hand side of a binary expression, so at a nested call RSP is often 8 mod 16;
    ' `"x=" + STR(7)` called the runtime with a misaligned stack and crashed inside it (an SSE aligned
    ' access), while `STR(7) + "x"` (nothing pushed) worked. r11 keeps the old RSP across the aligned
    ' 32-byte shadow area; rax (the value being passed/returned) is untouched.
    X64EmitText cg, "    mov r11, rsp"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    and rsp, -16"
    X64EmitText cg, "    mov qword [rsp + 32], r11"
    X64EmitText cg, "    call " & symbolName
    X64EmitText cg, "    mov rsp, qword [rsp + 32]"
End Sub

Private Sub X64EmitCall0(ByRef cg As X64CodegenContext, ByRef symbolName As String)
    If gX64ProgramHasFileIo = 0 OrElse (Left(symbolName, 11) <> "__uxb_file_" And symbolName <> "__uxb_builtin_freefile") Then
        X64EmitCallRaw cg, symbolName
        Exit Sub
    End If
    ' FILE owns a channel table and scratch cells. Serialize the complete
    ' service operation, like the common runtime's file_mutex. User argument
    ' expressions have already run; this scope never calls user routines.
    X64EmitText cg, "    sub rsp, 64"
    Dim regs(0 To 3) As String = {"rcx", "rdx", "r8", "r9"}
    For i As Integer = 0 To 3
        X64EmitText cg, "    mov [rsp+" & X64ToStr(i * 8) & "], " & regs(i)
    Next
    X64EmitText cg, "    lea rcx, [rel __uxb_file_mutex_id]"
    X64EmitText cg, "    mov edx, 1"
    X64EmitText cg, "    lea r8, [rel __uxb_empty_text]"
    X64EmitText cg, "    xor r9d, r9d"
    X64EmitCallRaw cg, "__uxb_rt_sync_enter"
    For i As Integer = 0 To 3
        X64EmitText cg, "    mov " & regs(i) & ", [rsp+" & X64ToStr(i * 8) & "]"
    Next
    X64EmitCallRaw cg, symbolName
    X64EmitText cg, "    mov [rsp+32], rax"
    X64EmitText cg, "    movq [rsp+40], xmm0"
    X64EmitText cg, "    lea rcx, [rel __uxb_file_mutex_id]"
    X64EmitText cg, "    mov edx, 1"
    X64EmitText cg, "    xor r8d, r8d"
    X64EmitCallRaw cg, "__uxb_rt_sync_leave"
    X64EmitText cg, "    mov rax, [rsp+32]"
    X64EmitText cg, "    movq xmm0, [rsp+40]"
    X64EmitText cg, "    add rsp, 64"
End Sub

Private Sub X64EmitCall1(ByRef cg As X64CodegenContext, ByRef symbolName As String)
    X64EmitText cg, "    mov rcx, rax"
    X64EmitText cg, "    xor rdx, rdx"
    X64EmitText cg, "    xor r8, r8"
    X64EmitCall0 cg, symbolName
End Sub

Private Sub X64EmitCall2(ByRef cg As X64CodegenContext, ByRef symbolName As String)
    X64EmitText cg, "    mov rdx, rax"
    X64EmitText cg, "    pop rcx"
    X64EmitText cg, "    xor r8, r8"
    X64EmitCall0 cg, symbolName
End Sub

' xmm0 holds a double. The common formatter owns the returned text in the
' current thread's temporary ring, preserving F32/F64 digit and NaN rules.
Private Sub X64EmitFloatToStrBuf(ByRef cg As X64CodegenContext, ByVal isSingle As Integer)
    If isSingle <> 0 Then
        X64EmitText cg, "    cvtsd2ss xmm0, xmm0"
        X64EmitText cg, "    cvtss2sd xmm0, xmm0"
    End If
    ' S-691: a NaN prints as "nan" in every engine (inf and -inf already match); the C runtime's sprintf wrote "-nan(ind)" for the
    ' x86 default NaN of 0 / 0. ucomisd sets the parity flag when either operand is a NaN.
    Dim nanLabel As String = X64NextLabel(cg, "f64_nan")
    Dim doneLabel As String = X64NextLabel(cg, "f64_done")
    X64EmitText cg, "    ucomisd xmm0, xmm0"
    X64EmitText cg, "    jp " & nanLabel
    Dim formatter As String = IIf(isSingle <> 0, "__uxb_rt_str_f32", "__uxb_rt_str_f64")
    X64EmitCall0 cg, formatter
    X64EmitText cg, "    jmp " & doneLabel
    X64EmitLabel cg, nanLabel
    X64EmitText cg, "    lea rax, [rel __uxb_text_nan]"
    X64EmitLabel cg, doneLabel
End Sub

Private Sub X64EmitCall3(ByRef cg As X64CodegenContext, ByRef symbolName As String)
    X64EmitText cg, "    mov r8, rax"
    X64EmitText cg, "    pop rdx"
    X64EmitText cg, "    pop rcx"
    X64EmitCall0 cg, symbolName
End Sub

Private Function X64BuiltinCallSymbol(ByRef callName As String) As String
    Select Case X64Upper(Trim(callName))
    Case "CSRLIN": Return "__uxb_rt_csrlin"
    Case "POS": Return "__uxb_rt_pos"
    Case "INKEY"
        Return "__uxb_builtin_inkey"
    Case "GETKEY"
        Return "__uxb_builtin_getkey"
    Case "ABS"
        Return "__uxb_builtin_abs"
    Case "INT"
        Return "__uxb_builtin_int"
    Case "FIX"
        Return "__uxb_builtin_fix"
    Case "CINT"
        Return "__uxb_builtin_cint"
    Case "CLNG"
        Return "__uxb_builtin_clng"
    Case "SGN"
        Return "__uxb_builtin_sgn"
    Case "VAL"
        Return "__uxb_builtin_val"
    Case "ASC"
        Return "__uxb_builtin_asc"
    Case "RND"
        Return "__uxb_builtin_rnd"
    Case "SQR"
        Return "__uxb_builtin_sqr"
    Case "SIN"
        Return "__uxb_builtin_sin"
    Case "COS"
        Return "__uxb_builtin_cos"
    Case "TAN"
        Return "__uxb_builtin_tan"
    Case "ATN"
        Return "__uxb_builtin_atn"
    Case "EXP"
        Return "__uxb_builtin_exp"
    Case "LOG"
        Return "__uxb_builtin_log"
    Case "GETKEY"
        Return "__uxb_builtin_getkey"
    Case "TIMER"
        Return "__uxb_builtin_timer"
    Case "LTRIM"
        Return "__uxb_builtin_ltrim"
    Case "RTRIM"
        Return "__uxb_builtin_rtrim"
    Case "TRIM"
        Return "__uxb_rt_trim"
    Case "SPACE"
        Return "__uxb_builtin_space"
    Case "HEX": Return "__uxb_rt_hex"
    Case "OCT": Return "__uxb_rt_oct"
    Case "BIN": Return "__uxb_rt_bin"
    Case "STRING"
        Return "__uxb_builtin_string"
    Case "LEFT", "LEFT$"
        Return "__uxb_rt_left"
    Case "RIGHT", "RIGHT$"
        Return "__uxb_rt_right"
    Case "MID", "MID$"
        Return "__uxb_rt_mid"
    Case "INSTR"
        Return "__uxb_builtin_instr"
    Case "UCASE"
        Return "__uxb_builtin_ucase"
    Case "LCASE"
        Return "__uxb_builtin_lcase"
    Case "STR"
        Return "__uxb_builtin_str"
    Case "CHR"
        Return "__uxb_builtin_chr"
    Case "LEN"
        Return "__uxb_builtin_len"
    Case "LOF"
        Return "__uxb_builtin_lof"
    Case "EOF"
        Return "__uxb_builtin_eof"
    End Select

    Return ""
End Function

' S-143: 1 when `nodeIdx` sits (through parent links) inside `ancestorIdx`
Private Function X64NodeIsInside(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal ancestorIdx As Integer) As Integer
    Dim guard As Integer
    Dim cur As Integer
    guard = 0
    cur = nodeIdx
    Do While cur >= 0 And cur < ps.ast.count And guard < 256
        If cur = ancestorIdx Then Return 1
        cur = ps.ast.nodes(cur).parent
        guard += 1
    Loop
    Return 0
End Function

' S-143: 1 when the node sits inside any SUB/FUNCTION/method (not in the main program or a namespace body)
Private Function X64NodeIsInsideAnyRoutine(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim guard As Integer
    Dim cur As Integer
    guard = 0
    cur = ps.ast.nodes(nodeIdx).parent
    Do While cur >= 0 And cur < ps.ast.count And guard < 256
        Select Case X64Upper(ps.ast.nodes(cur).kind)
        Case "SUB_STMT", "FUNCTION_STMT", "CLASS_METHOD_DECL", "CLASS_OPERATOR_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT"
            Return 1
        End Select
        cur = ps.ast.nodes(cur).parent
        guard += 1
    Loop
    Return 0
End Function

' Declared type of a variable by name. It used to take the FIRST declaration of that name anywhere in the
' program, so `FUNCTION F(a AS I32)` and `SUB S(w AS F64)` decided the type of an unrelated `DIM a AS I64`
' / `DIM w AS I64` in MAIN (an I64 came out truncated to 32 bits, another printed as a float). The
' declaration inside the routine being emitted wins, then a program-level (non-routine) one, and only then
' any declaration (the old behaviour, kept for code that reaches a name the scoped passes do not see).
Private Function X64FindDeclaredTypeName(ByRef ps As ParseState, ByRef varName As String, ByRef typeNameOut As String) As Integer
    typeNameOut = ""

    Dim targetName As String
    targetName = X64Upper(Trim(varName))
    If targetName = "" Then Return 0

    Dim passNo As Integer
    For passNo = 1 To 3
        If passNo = 1 And gX64CurrentRoutineNode < 0 Then Continue For
        Dim i As Integer
        For i = 0 To ps.ast.count - 1
            Dim kindText As String
            kindText = X64Upper(ps.ast.nodes(i).kind)
            If kindText <> "DIM_DECL" And kindText <> "REDIM_DECL" And kindText <> "PARAM_DECL" Then Continue For
            If X64Upper(Trim(ps.ast.nodes(i).value)) <> targetName Then Continue For
            If passNo = 1 Then
                If X64NodeIsInside(ps, i, gX64CurrentRoutineNode) = 0 Then Continue For
            ElseIf passNo = 2 Then
                If X64NodeIsInsideAnyRoutine(ps, i) <> 0 Then Continue For
            End If

            Dim ch As Integer
            ch = ps.ast.nodes(i).firstChild
            Do While ch <> -1
                If X64Upper(ps.ast.nodes(ch).kind) = "TYPE_REF" Then
                    typeNameOut = X64Upper(Trim(ps.ast.nodes(ch).value))
                    If typeNameOut <> "" Then Return 1
                End If
                ch = ps.ast.nodes(ch).nextSibling
            Loop
        Next i
    Next passNo

    Return 0
End Function
Private Function X64FindClassDeclNode(ByRef ps As ParseState, ByRef classTypeName As String) As Integer
    Dim targetName As String
    targetName = X64Upper(Trim(classTypeName))
    If targetName = "" Then Return -1

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(i).kind) = "CLASS_STMT" Then
            If X64Upper(Trim(ps.ast.nodes(i).value)) = targetName Then Return i
        End If
    Next i

    Return -1
End Function

Private Function X64GetClassBaseTypeName(ByRef ps As ParseState, ByRef classTypeName As String, ByRef baseTypeOut As String) As Integer
    baseTypeOut = ""

    Dim classNode As Integer
    classNode = X64FindClassDeclNode(ps, classTypeName)
    If classNode = -1 Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(classNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_BASE_REF" Then
            baseTypeOut = X64Upper(Trim(ps.ast.nodes(ch).value))
            Return IIf(baseTypeOut <> "", 1, 0)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function X64FindClassMethodDeclNode(ByRef ps As ParseState, ByRef classTypeName As String, ByRef methodName As String) As Integer
    Dim classNode As Integer
    classNode = X64FindClassDeclNode(ps, classTypeName)
    If classNode = -1 Then Return -1

    Dim methodUpper As String
    methodUpper = X64Upper(Trim(methodName))
    If methodUpper = "" Then Return -1

    Dim magicFallback As String
    magicFallback = X64MagicFallbackMethodName(methodUpper)
    Dim magicCandidate As Integer
    magicCandidate = -1

    Dim ch As Integer
    ch = ps.ast.nodes(classNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_METHOD_DECL" Then
            Dim candidate As String
            candidate = X64Upper(Trim(ps.ast.nodes(ch).value))
            If candidate = methodUpper Then Return ch
            If magicCandidate = -1 And magicFallback <> "" Then
                If candidate = magicFallback Then magicCandidate = ch
            End If
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return magicCandidate
End Function

Private Function X64FindClassOperatorDeclNode(ByRef ps As ParseState, ByRef classTypeName As String, ByRef opSuffixRaw As String) As Integer
    Dim classNode As Integer
    classNode = X64FindClassDeclNode(ps, classTypeName)
    If classNode = -1 Then Return -1

    Dim opSuffix As String
    opSuffix = X64Upper(Trim(opSuffixRaw))
    If opSuffix = "" Then Return -1

    Dim ch As Integer
    ch = ps.ast.nodes(classNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_OPERATOR_DECL" Then
            Dim candidate As String
            If X64OperatorTokenToRoutineSuffix(ps.ast.nodes(ch).value, candidate) <> 0 Then
                If X64Upper(Trim(candidate)) = opSuffix Then Return ch
            End If
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return -1
End Function

Private Function X64ResolveMethodOwnerType(ByRef ps As ParseState, ByRef startTypeName As String, ByRef methodName As String, ByRef ownerTypeOut As String) As Integer
    ownerTypeOut = ""

    Dim curType As String
    curType = X64Upper(Trim(startTypeName))
    Dim methodUpper As String
    methodUpper = X64Upper(Trim(methodName))

    If curType = "" Or methodUpper = "" Then Return 0

    Dim hopGuard As Integer
    Do While curType <> ""
        hopGuard += 1
        If hopGuard > 64 Then Exit Do

        If X64FindClassMethodDeclNode(ps, curType, methodUpper) <> -1 Then
            ownerTypeOut = curType
            Return 1
        End If

        Dim baseType As String
        If X64GetClassBaseTypeName(ps, curType, baseType) = 0 Then Exit Do
        curType = X64Upper(Trim(baseType))
    Loop

    Return 0
End Function



' FIX14_CANONICAL_MAGIC_DISPATCH_20260611:
' Resolve both owner class and actual routine suffix. If obj.HASH() targets a
' custom MAGIC HASH method, this returns CLASS_MAGIC_HASH, not CLASS_HASH.
Private Function X64ResolveMethodRoutineNameFromType(ByRef ps As ParseState, ByRef startTypeName As String, ByRef methodName As String, ByRef routineNameOut As String, ByRef ownerTypeOut As String, ByRef resolvedMethodOut As String) As Integer
    routineNameOut = ""
    ownerTypeOut = ""
    resolvedMethodOut = ""

    Dim curType As String
    curType = X64Upper(Trim(startTypeName))
    Dim methodUpper As String
    methodUpper = X64Upper(Trim(methodName))
    If curType = "" Or methodUpper = "" Then Return 0

    Dim hopGuard As Integer
    Do While curType <> ""
        hopGuard += 1
        If hopGuard > 64 Then Exit Do

        Dim methodNode As Integer
        methodNode = X64FindClassMethodDeclNode(ps, curType, methodUpper)
        If methodNode <> -1 Then
            Dim resolvedMethod As String
            resolvedMethod = X64Upper(Trim(ps.ast.nodes(methodNode).value))
            If resolvedMethod = "" Then resolvedMethod = methodUpper
            ownerTypeOut = curType
            resolvedMethodOut = resolvedMethod
            routineNameOut = curType & "_" & resolvedMethod
            Return 1
        End If

        Dim baseType As String
        If X64GetClassBaseTypeName(ps, curType, baseType) = 0 Then Exit Do
        curType = X64Upper(Trim(baseType))
    Loop

    Return 0
End Function

Private Function X64FindOwningClassName(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef classNameOut As String) As Integer
    classNameOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim p As Integer
    p = ps.ast.nodes(nodeIdx).parent
    Do While p >= 0 And p < ps.ast.count
        If X64Upper(ps.ast.nodes(p).kind) = "CLASS_STMT" Then
            classNameOut = X64Upper(Trim(ps.ast.nodes(p).value))
            Return IIf(classNameOut <> "", 1, 0)
        End If
        p = ps.ast.nodes(p).parent
    Loop

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(i).kind) <> "CLASS_STMT" Then Continue For
        Dim ch As Integer
        ch = ps.ast.nodes(i).firstChild
        Do While ch <> -1
            If ch = nodeIdx Then
                classNameOut = X64Upper(Trim(ps.ast.nodes(i).value))
                Return IIf(classNameOut <> "", 1, 0)
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
    Next i

    Return 0
End Function

Private Function X64ClassTypeId(ByRef ps As ParseState, ByRef classTypeName As String) As Integer
    Dim targetName As String
    targetName = X64Upper(Trim(classTypeName))
    If targetName = "" Then Return 0
    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then Return 0

    Dim classId As Integer
    classId = 0

    Dim ch As Integer
    ch = ps.ast.nodes(ps.rootNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_STMT" Then
            classId += 1
            If X64Upper(Trim(ps.ast.nodes(ch).value)) = targetName Then Return classId
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function X64MagicOperatorRoutineNameBySuffix(ByRef suffixRaw As String, ByRef magicOut As String) As Integer
    Dim suffixUpper As String
    suffixUpper = X64Upper(Trim(suffixRaw))
    magicOut = ""

    Select Case suffixUpper
    Case "OP_ADD"
        magicOut = "MAGIC_ADD"
    Case "OP_SUB"
        magicOut = "MAGIC_SUB"
    Case "OP_MUL"
        magicOut = "MAGIC_MUL"
    Case "OP_DIV"
        magicOut = "MAGIC_DIV"
    Case "OP_IDIV"
        magicOut = "MAGIC_IDIV"
    Case "OP_MOD"
        magicOut = "MAGIC_MOD"
    Case "OP_AND", "OP_BAND"
        magicOut = "MAGIC_AND"
    Case "OP_OR", "OP_BOR"
        magicOut = "MAGIC_OR"
    Case "OP_XOR"
        magicOut = "MAGIC_XOR"
    Case "OP_SHL"
        magicOut = "MAGIC_SHL"
    Case "OP_SHR"
        magicOut = "MAGIC_SHR"
    Case "OP_ROL"
        magicOut = "MAGIC_ROL"
    Case "OP_ROR"
        magicOut = "MAGIC_ROR"
    Case "OP_EQ"
        magicOut = "MAGIC_EQ"
    Case "OP_NE"
        magicOut = "MAGIC_NE"
    Case "OP_LT"
        magicOut = "MAGIC_LT"
    Case "OP_LE"
        magicOut = "MAGIC_LE"
    Case "OP_GT"
        magicOut = "MAGIC_GT"
    Case "OP_GE"
        magicOut = "MAGIC_GE"
    End Select

    Return IIf(magicOut <> "", 1, 0)
End Function

Private Function X64MagicRoutineDunderAlias(ByRef magicRaw As String, ByRef aliasOut As String) As Integer
    Dim magicUpper As String
    magicUpper = X64Upper(Trim(magicRaw))
    aliasOut = ""

    If Left(magicUpper, 6) <> "MAGIC_" Then Return 0
    aliasOut = "__" & Mid(magicUpper, 7)
    Return 1
End Function

Private Function X64NormalizeMagicHookName(ByRef hookNameRaw As String, ByRef magicNameOut As String) As Integer
    Dim h As String
    h = X64Upper(Trim(hookNameRaw))
    magicNameOut = ""
    If h = "" Then Return 0

    If Left(h, 2) = "__" Then
        h = Mid(h, 3)
    ElseIf Left(h, 6) = "MAGIC_" Then
        h = Mid(h, 7)
    End If
    If h = "" Then Return 0

    Dim i As Integer
    For i = 1 To Len(h)
        Dim ch As String
        ch = Mid(h, i, 1)
        If (ch >= "A" And ch <= "Z") Or (ch >= "0" And ch <= "9") Or ch = "_" Then
            Continue For
        End If
        Return 0
    Next i

    magicNameOut = "MAGIC_" & h
    Return 1
End Function

Private Function X64ResolveNamedMagicOwnerType(ByRef ps As ParseState, ByRef startTypeName As String, ByRef hookNameRaw As String, ByRef ownerTypeOut As String, ByRef routineSuffixOut As String) As Integer
    ownerTypeOut = ""
    routineSuffixOut = ""

    Dim curType As String
    curType = X64Upper(Trim(startTypeName))
    If curType = "" Then Return 0

    Dim magicName As String
    If X64NormalizeMagicHookName(hookNameRaw, magicName) = 0 Then Return 0

    Dim dunderAlias As String
    dunderAlias = ""
    Dim dunderOk As Integer
    dunderOk = X64MagicRoutineDunderAlias(magicName, dunderAlias)

    Dim hopGuard As Integer
    Do While curType <> ""
        hopGuard += 1
        If hopGuard > 64 Then Exit Do

        If X64FindClassMethodDeclNode(ps, curType, magicName) <> -1 Then
            ownerTypeOut = curType
            routineSuffixOut = magicName
            Return 1
        End If

        If dunderAlias <> "" Then
            If X64FindClassMethodDeclNode(ps, curType, dunderAlias) <> -1 Then
                ownerTypeOut = curType
                routineSuffixOut = dunderAlias
                Return 1
            End If
        End If

        Dim baseType As String
        If X64GetClassBaseTypeName(ps, curType, baseType) = 0 Then Exit Do
        curType = X64Upper(Trim(baseType))
    Loop

    Return 0
End Function

Private Function X64ResolveOperatorOwnerType(ByRef ps As ParseState, ByRef startTypeName As String, ByRef opSuffixRaw As String, ByRef ownerTypeOut As String, ByRef routineSuffixOut As String) As Integer
    ownerTypeOut = ""
    routineSuffixOut = ""

    Dim curType As String
    curType = X64Upper(Trim(startTypeName))
    Dim opSuffix As String
    opSuffix = X64Upper(Trim(opSuffixRaw))

    If curType = "" Or opSuffix = "" Then Return 0

    Dim hopGuard As Integer
    Do While curType <> ""
        hopGuard += 1
        If hopGuard > 64 Then Exit Do

        If X64FindClassOperatorDeclNode(ps, curType, opSuffix) <> -1 Then
            ownerTypeOut = curType
            routineSuffixOut = opSuffix
            Return 1
        End If

        If X64FindClassMethodDeclNode(ps, curType, opSuffix) <> -1 Then
            ownerTypeOut = curType
            routineSuffixOut = opSuffix
            Return 1
        End If

        Dim magicMethod As String
        magicMethod = ""
        If X64MagicOperatorRoutineNameBySuffix(opSuffix, magicMethod) <> 0 Then
            If X64FindClassMethodDeclNode(ps, curType, magicMethod) <> -1 Then
                ownerTypeOut = curType
                routineSuffixOut = magicMethod
                Return 1
            End If

            Dim dunderMagic As String
            dunderMagic = ""
            If X64MagicRoutineDunderAlias(magicMethod, dunderMagic) <> 0 Then
                If X64FindClassMethodDeclNode(ps, curType, dunderMagic) <> -1 Then
                    ownerTypeOut = curType
                    routineSuffixOut = dunderMagic
                    Return 1
                End If
            End If
        End If

        If opSuffix = "OP_ADD" And X64FindClassMethodDeclNode(ps, curType, "ADD") <> -1 Then
            ownerTypeOut = curType
            routineSuffixOut = "ADD"
            Return 1
        End If

        Dim baseType As String
        If X64GetClassBaseTypeName(ps, curType, baseType) = 0 Then Exit Do
        curType = X64Upper(Trim(baseType))
    Loop

    Return 0
End Function

Private Function X64OperatorTokenToRoutineSuffix(ByRef opRaw As String, ByRef suffixOut As String) As Integer
    Dim opText As String
    opText = X64Upper(Trim(opRaw))
    suffixOut = ""

    Select Case opText
    Case "+", "ADD", "OP_ADD"
        suffixOut = "OP_ADD"
    Case "-", "SUB", "OP_SUB"
        suffixOut = "OP_SUB"
    Case "*", "MUL", "OP_MUL"
        suffixOut = "OP_MUL"
    Case "/", "DIV", "OP_DIV"
        suffixOut = "OP_DIV"
    Case "\", "IDIV", "OP_IDIV"
        suffixOut = "OP_IDIV"
    Case "%", "MOD", "OP_MOD"
        suffixOut = "OP_MOD"
    Case "&", "BAND", "OP_BAND"
        suffixOut = "OP_BAND"
    Case "|", "BOR", "OP_BOR"
        suffixOut = "OP_BOR"
    Case "AND", "OP_AND"
        suffixOut = "OP_AND"
    Case "OR", "OP_OR"
        suffixOut = "OP_OR"
    Case "XOR", "OP_XOR", "^"
        suffixOut = "OP_XOR"
    Case "<<", "SHL", "OP_SHL"
        suffixOut = "OP_SHL"
    Case ">>", "SHR", "OP_SHR"
        suffixOut = "OP_SHR"
    Case "ROL", "OP_ROL"
        suffixOut = "OP_ROL"
    Case "ROR", "OP_ROR"
        suffixOut = "OP_ROR"
    Case "=", "==", "OP_EQ"
        suffixOut = "OP_EQ"
    Case "<>", "!=", "OP_NE"
        suffixOut = "OP_NE"
    Case "<", "OP_LT"
        suffixOut = "OP_LT"
    Case "<=", "OP_LE"
        suffixOut = "OP_LE"
    Case ">", "OP_GT"
        suffixOut = "OP_GT"
    Case ">=", "OP_GE"
        suffixOut = "OP_GE"
    End Select

    If suffixOut = "" Then
        Dim cleaned As String
        cleaned = ""
        Dim i As Integer
        For i = 1 To Len(opText)
            Dim ch As String
            ch = Mid(opText, i, 1)
            If (ch >= "A" And ch <= "Z") Or (ch >= "0" And ch <= "9") Then cleaned &= ch
        Next i
        If cleaned <> "" Then suffixOut = "OP_" & cleaned
    End If

    Return IIf(suffixOut <> "", 1, 0)
End Function

Private Function X64CountRoutineParams(ByRef ps As ParseState, ByVal routineNode As Integer) As Integer
    If routineNode < 0 Or routineNode >= ps.ast.count Then Return 0

    Dim paramCount As Integer
    Dim ch As Integer
    ch = ps.ast.nodes(routineNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) <> "PARAM_DECL" Then Exit Do
        paramCount += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return paramCount
End Function

Private Function X64NodeHasReturnType(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "RETURN_TYPE" Then Return 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function X64IsStmtLikeNode(ByRef kindRaw As String) As Integer
    Dim k As String
    k = X64Upper(Trim(kindRaw))
    If Right(k, 5) = "_STMT" Then Return 1
    Select Case k
    Case "PRINT", "IF", "FOR", "DO", "CALL", "RETURN", "EXIT", "LET", "DIM", "REDIM", "DELETE", "SELECT", "NEXT", "GOTO", "GOSUB"
        Return 1
    End Select
    Return 0
End Function

' S-603 (2026-10-17): is this CLASS_METHOD_DECL a STATIC method (no hidden receiver parameter, no THIS / ME / SUPER)?
Private Function X64ClassMethodIsStatic(ByRef ps As ParseState, ByVal routineNode As Integer) As Integer
    If routineNode < 0 Or routineNode >= ps.ast.count Then Return 0
    If X64Upper(Trim(ps.ast.nodes(routineNode).kind)) <> "CLASS_METHOD_DECL" Then Return 0
    Dim ch As Integer
    ch = ps.ast.nodes(routineNode).firstChild
    Do While ch <> -1
        If X64Upper(Trim(ps.ast.nodes(ch).kind)) = "CLASS_METHOD_FLAG" Then
            If X64Upper(Trim(ps.ast.nodes(ch).value)) = "STATIC" Then Return 1
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Function X64ClassRoutineHasBody(ByRef ps As ParseState, ByVal routineNode As Integer) As Integer
    If routineNode < 0 Or routineNode >= ps.ast.count Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(routineNode).firstChild
    Do While ch <> -1
        If X64IsStmtLikeNode(ps.ast.nodes(ch).kind) <> 0 Then Return 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function X64ResolveClassRoutineName(ByRef ps As ParseState, ByVal routineNode As Integer, ByRef routineNameOut As String) As Integer
    routineNameOut = ""
    If routineNode < 0 Or routineNode >= ps.ast.count Then Return 0

    Dim k As String
    k = X64Upper(Trim(ps.ast.nodes(routineNode).kind))

    Dim className As String
    If X64FindOwningClassName(ps, routineNode, className) = 0 Then Return 0

    Select Case k
    Case "CLASS_METHOD_DECL"
        Dim methodName As String
        methodName = X64Upper(Trim(ps.ast.nodes(routineNode).value))
        If methodName = "" Then Return 0
        routineNameOut = className & "_" & methodName
        Return 1
    Case "CLASS_OPERATOR_DECL"
        Dim opSuffix As String
        If X64OperatorTokenToRoutineSuffix(ps.ast.nodes(routineNode).value, opSuffix) = 0 Then Return 0
        routineNameOut = className & "_" & opSuffix
        Return 1
    Case "CLASS_CONSTRUCTOR_DECL"
        routineNameOut = className & "_CTOR"
        Return 1
    Case "CLASS_DESTRUCTOR_DECL"
        routineNameOut = className & "_DTOR"
        Return 1
    Case "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT"
        Dim propertyNode As Integer
        propertyNode = ps.ast.nodes(routineNode).parent
        If propertyNode < 0 Or propertyNode >= ps.ast.count Then Return 0
        If X64Upper(ps.ast.nodes(propertyNode).kind) <> "CLASS_PROPERTY_DECL" Then Return 0

        Dim propertyName As String
        propertyName = X64Upper(Trim(ps.ast.nodes(propertyNode).value))
        If propertyName = "" Then Return 0

        Dim accessorTag As String
        accessorTag = IIf(k = "CLASS_PROPERTY_GET_STMT", "GET", "SET")
        routineNameOut = className & "_PROP" & accessorTag & "_" & propertyName
        Return 1
    End Select

    Return 0
End Function

Private Sub X64ClearRoutineParamTypes(ByVal routineIndex As Integer)
    If routineIndex < 0 Or routineIndex > 1023 Then Exit Sub
    Dim i As Integer
    For i = 0 To 63
        gX64RoutineParamTypes(routineIndex, i) = ""
    Next i
End Sub

Private Sub X64RegisterRoutineSignatureDirect(ByRef cg As X64CodegenContext, ByRef routineName As String, ByVal argCount As Integer, ByVal isFunction As Integer, ByRef returnType As String)
    Dim routineKey As String
    routineKey = X64Upper(Trim(routineName))
    If routineKey = "" Then Exit Sub

    If argCount < 0 Then argCount = 0

    Dim i As Integer
    i = X64FindRoutine(cg, routineKey)
    If i <> -1 Then
        gX64RoutineArgCounts(i) = argCount
        gX64RoutineIsFunction(i) = isFunction
        gX64RoutineReturnTypes(i) = X64Upper(Trim(returnType))
        X64ClearRoutineParamTypes i
        Exit Sub
    End If

    If cg.routineCount > 1023 Then Exit Sub
    gX64RoutineKeys(cg.routineCount) = routineKey
    gX64RoutineArgCounts(cg.routineCount) = argCount
    gX64RoutineIsFunction(cg.routineCount) = isFunction
    gX64RoutineReturnTypes(cg.routineCount) = X64Upper(Trim(returnType))
    X64ClearRoutineParamTypes cg.routineCount
    cg.routineCount += 1
End Sub

Private Sub X64RegisterClassRoutineParamTypes(ByRef ps As ParseState, ByVal routineNode As Integer, ByRef cg As X64CodegenContext, ByRef routineName As String, ByRef receiverClassType As String, ByRef propertyValueType As String)
    Dim routineIndex As Integer
    routineIndex = X64FindRoutine(cg, X64Upper(Trim(routineName)))
    If routineIndex = -1 Then Exit Sub

    X64ClearRoutineParamTypes routineIndex
    Dim outIndex As Integer
    If X64ClassMethodIsStatic(ps, routineNode) <> 0 Then
        outIndex = 0      ' S-603: a STATIC method has no receiver slot: its first parameter is index 0
    Else
        gX64RoutineParamTypes(routineIndex, 0) = X64Upper(Trim(receiverClassType))
        outIndex = 1
    End If
    Dim ch As Integer
    ch = ps.ast.nodes(routineNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) <> "PARAM_DECL" Then Exit Do
        If outIndex <= 63 Then gX64RoutineParamTypes(routineIndex, outIndex) = X64ExtractParamType(ps, ch)
        outIndex += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If propertyValueType <> "" And outIndex <= 63 Then
        gX64RoutineParamTypes(routineIndex, outIndex) = X64Upper(Trim(propertyValueType))
    End If
End Sub

Private Sub X64RegisterClassRoutineSignature(ByRef ps As ParseState, ByVal routineNode As Integer, ByRef cg As X64CodegenContext)
    Dim routineName As String
    If X64ResolveClassRoutineName(ps, routineNode, routineName) = 0 Then Exit Sub

    Dim argCount As Integer
    argCount = X64CountRoutineParams(ps, routineNode) + 1
    Dim kindUpper As String
    kindUpper = X64Upper(ps.ast.nodes(routineNode).kind)
    If kindUpper = "CLASS_PROPERTY_SET_STMT" Then argCount = 2
    ' S-603: a STATIC method takes no hidden receiver
    If X64ClassMethodIsStatic(ps, routineNode) <> 0 Then argCount -= 1

    Dim isFn As Integer
    isFn = 0
    If kindUpper = "CLASS_METHOD_DECL" Or kindUpper = "CLASS_OPERATOR_DECL" Then
        isFn = IIf(X64NodeHasReturnType(ps, routineNode) <> 0, 1, 0)
    ElseIf kindUpper = "CLASS_PROPERTY_GET_STMT" Then
        isFn = 1
    End If

    Dim returnTypeText As String
    returnTypeText = X64ExtractRoutineReturnType(ps, routineNode)
    If returnTypeText = "" And (kindUpper = "CLASS_PROPERTY_GET_STMT" Or kindUpper = "CLASS_PROPERTY_SET_STMT") Then
        Dim propertyNode As Integer
        propertyNode = ps.ast.nodes(routineNode).parent
        If propertyNode >= 0 And propertyNode < ps.ast.count Then
            returnTypeText = X64ExtractPropertyType(ps, propertyNode)
        End If
    End If

    X64RegisterRoutineSignatureDirect cg, routineName, argCount, isFn, returnTypeText
    Dim receiverTypeForParams As String
    receiverTypeForParams = ""
    X64FindOwningClassName ps, routineNode, receiverTypeForParams
    If receiverTypeForParams = "" Then receiverTypeForParams = "PTR"
    Dim propertyValueTypeForParams As String
    propertyValueTypeForParams = ""
    If kindUpper = "CLASS_PROPERTY_SET_STMT" Then propertyValueTypeForParams = returnTypeText
    X64RegisterClassRoutineParamTypes ps, routineNode, cg, routineName, receiverTypeForParams, propertyValueTypeForParams
End Sub

Private Function X64InferRoutineReceiverClass(ByRef ps As ParseState, ByRef routineNameRaw As String, ByRef classNameOut As String) As Integer
    classNameOut = ""

    Dim routineName As String
    routineName = X64Upper(Trim(routineNameRaw))
    If routineName = "" Then Return 0

    Dim sepPos As Integer
    sepPos = InStr(routineName, "_")
    If sepPos <= 1 Then Return 0

    Dim className As String
    className = Left(routineName, sepPos - 1)
    If className = "" Then Return 0
    If X64FindClassDeclNode(ps, className) = -1 Then Return 0

    classNameOut = className
    Return 1
End Function

Private Function X64ResolveCurrentReceiverClass(ByRef ps As ParseState, ByRef cg As X64CodegenContext, ByRef classNameOut As String) As Integer
    classNameOut = ""

    If X64TryGetVarType(cg, "THIS", classNameOut) <> 0 Then
        classNameOut = X64Upper(Trim(classNameOut))
        If classNameOut <> "" And X64FindClassDeclNode(ps, classNameOut) <> -1 Then Return 1
    End If

    Return X64InferRoutineReceiverClass(ps, cg.currentRoutineLabel, classNameOut)
End Function

Private Function X64HasTopLevelGlobalDecl(ByRef ps As ParseState, ByRef symbolNameRaw As String) As Integer
    Dim targetName As String = X64Upper(Trim(symbolNameRaw))
    If targetName = "" Then Return 0
    For declaration As Integer = 0 To ps.ast.count - 1
        Dim kindText As String = ps.ast.nodes(declaration).kind
        If kindText <> "DIM_DECL" And kindText <> "CONST_DECL" Then Continue For
        If UCase(ps.ast.nodes(declaration).value) <> targetName Then Continue For
        Dim owner As Integer = ps.ast.nodes(declaration).parent, inRoutine As Integer = 0
        Do While owner >= 0
            Select Case ps.ast.nodes(owner).kind
            Case "SUB_STMT", "FUNCTION_STMT", "CLASS_METHOD_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", "CLASS_OPERATOR_DECL", "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "THREAD_STMT", "EVENT_STMT", "PARALEL_STMT", "PIPE_STMT"
                inRoutine = 1: Exit Do
            End Select
            owner = ps.ast.nodes(owner).parent
        Loop
        If inRoutine = 0 Then Return 1
    Next declaration
    Return 0
End Function

Private Function X64FindRoutineSymbolName(ByRef ps As ParseState, ByRef routineNameRaw As String, ByRef symbolOut As String) As Integer
    symbolOut = ""

    Dim targetName As String
    targetName = X64Upper(Trim(routineNameRaw))
    If targetName = "" Then Return 0

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim kindText As String
        kindText = X64Upper(ps.ast.nodes(i).kind)
        If kindText <> "SUB_STMT" And kindText <> "FUNCTION_STMT" Then Continue For
        If X64Upper(Trim(ps.ast.nodes(i).value)) <> targetName Then Continue For

        symbolOut = Trim(ps.ast.nodes(i).value)
        Return IIf(symbolOut <> "", 1, 0)
    Next i

    For i = 0 To ps.ast.count - 1
        Dim classRoutineKind As String
        classRoutineKind = X64Upper(ps.ast.nodes(i).kind)
        If classRoutineKind <> "CLASS_METHOD_DECL" And classRoutineKind <> "CLASS_OPERATOR_DECL" And classRoutineKind <> "CLASS_CONSTRUCTOR_DECL" And classRoutineKind <> "CLASS_DESTRUCTOR_DECL" And classRoutineKind <> "CLASS_PROPERTY_GET_STMT" And classRoutineKind <> "CLASS_PROPERTY_SET_STMT" Then Continue For

        Dim classRoutineName As String
        classRoutineName = ""
        If X64ResolveClassRoutineName(ps, i, classRoutineName) = 0 Then Continue For
        If X64Upper(Trim(classRoutineName)) <> targetName Then Continue For

        symbolOut = classRoutineName
        Return 1
    Next i

    Return 0
End Function

Private Function X64SplitMethodCallName(ByRef callNameRaw As String, ByRef ownerOut As String, ByRef methodOut As String) As Integer
    Dim callName As String
    callName = Trim(callNameRaw)

    Dim dotPos As Integer
    dotPos = InStr(callName, ".")
    If dotPos <= 1 Then Return 0

    ownerOut = Trim(Left(callName, dotPos - 1))
    methodOut = Trim(Mid(callName, dotPos + 1))
    If ownerOut = "" Or methodOut = "" Then Return 0
    If InStr(methodOut, ".") > 0 Then Return 0
    Return 1
End Function

Private Function X64ResolveNamespaceRoutineSymbol(ByRef ps As ParseState, ByRef callNameRaw As String, ByRef symbolOut As String) As Integer
    symbolOut = ""
    If InStr(callNameRaw, ".") = 0 Then
        If gX64CurrentNamespace <> "" Then
            If X64ResolveNamespaceRoutineSymbol(ps, gX64CurrentNamespace & "." & Trim(callNameRaw), symbolOut) <> 0 Then Return 1
        End If
        Dim globalNode As Integer = ps.ast.nodes(ps.rootNode).firstChild
        Do While globalNode <> -1
            Dim globalKind As String = X64Upper(ps.ast.nodes(globalNode).kind)
            If globalKind = "SUB_STMT" Or globalKind = "FUNCTION_STMT" Then
                If X64Upper(Trim(ps.ast.nodes(globalNode).value)) = X64Upper(Trim(callNameRaw)) Then Return 0
            End If
            globalNode = ps.ast.nodes(globalNode).nextSibling
        Loop
        Dim importedSymbol As String = ""
        Dim usingNode As Integer = ps.ast.nodes(ps.rootNode).firstChild
        Do While usingNode <> -1
            If X64Upper(ps.ast.nodes(usingNode).kind) = "USING_STMT" Then
                Dim usingItem As Integer = ps.ast.nodes(usingNode).firstChild
                Do While usingItem <> -1
                    Dim candidateSymbol As String
                    Dim qualifiedName As String = ps.ast.nodes(usingItem).value & "." & Trim(callNameRaw)
                    If X64ResolveNamespaceRoutineSymbol(ps, qualifiedName, candidateSymbol) <> 0 Then
                        If importedSymbol <> "" And importedSymbol <> candidateSymbol Then Return 0
                        importedSymbol = candidateSymbol
                    End If
                    usingItem = ps.ast.nodes(usingItem).nextSibling
                Loop
            End If
            usingNode = ps.ast.nodes(usingNode).nextSibling
        Loop
        symbolOut = importedSymbol
        Return IIf(symbolOut <> "", 1, 0)
    End If
    Dim ownerName As String
    Dim routineName As String
    If X64SplitMethodCallName(callNameRaw, ownerName, routineName) = 0 Then Return 0

    Dim ownerUpper As String
    Dim routineUpper As String
    ownerUpper = X64Upper(Trim(ownerName))
    routineUpper = X64Upper(Trim(routineName))

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim containerKind As String
        containerKind = X64Upper(ps.ast.nodes(i).kind)
        If containerKind <> "NAMESPACE_STMT" And containerKind <> "MODULE_STMT" Then Continue For
        If X64Upper(Trim(ps.ast.nodes(i).value)) <> ownerUpper Then Continue For

        Dim ch As Integer
        ch = ps.ast.nodes(i).firstChild
        Do While ch <> -1
            Dim routineKind As String
            routineKind = X64Upper(ps.ast.nodes(ch).kind)
            If routineKind = "SUB_STMT" Or routineKind = "FUNCTION_STMT" Or routineKind = "DECLARE_SUB_STMT" Or routineKind = "DECLARE_FUNCTION_STMT" Then
                If X64Upper(Trim(ps.ast.nodes(ch).value)) = routineUpper Then
                    symbolOut = LCase(X64SanitizeSymbol(ownerUpper & "_" & routineUpper))
                    Return 1
                End If
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
    Next i
    Return 0
End Function

Private Function X64MethodLeafName(ByRef callNameRaw As String) As String
    Dim s As String
    s = X64Upper(Trim(callNameRaw))
    If s = "" Then Return ""

    Dim i As Integer
    For i = Len(s) To 1 Step -1
        If Mid(s, i, 1) = "." Then
            If i >= Len(s) Then Return ""
            Return X64Upper(Trim(Mid(s, i + 1)))
        End If
    Next i

    Return s
End Function

Private Function X64ExprReturnsString(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)

    Select Case nodeKind
    Case "STRING", "STRING_LITERAL"
        Return 1
    Case "IDENT", "IDENTIFIER", "VAR", "NAME", "VAR_REF", "KEYWORD_REF"
        Dim declType As String
        If X64FindDeclaredTypeName(ps, ps.ast.nodes(nodeIdx).value, declType) <> 0 Then
            If declType = "STRING" Then Return 1
        End If
    Case "CALL_EXPR"
        Dim callName As String
        callName = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))
        Select Case callName
        Case "STR", "CHR", "UCASE", "LCASE", "LTRIM", "RTRIM", "SPACE", "STRING", "MID", "PEEKS"
            Return 1
        End Select
    End Select

    Return 0
End Function

#include once "helpers/x64_codegen_builtin_support_helpers.fbs"

Private Sub X64EmitBuiltinSupport(ByRef cg As X64CodegenContext)
    X64EmitBuiltinSupportCoreA cg
    X64EmitBuiltinSupportCoreB cg
End Sub

#include once "helpers/x64_codegen_symbol_table_helpers.fbs"

#include once "helpers/x64_codegen_runtime_emit_helpers.fbs"
#include once "helpers/x64_codegen_dynamic_class_arrays.fbs"

Private Function X64TryResolveReceiverExprType(ByRef ps As ParseState, ByVal receiverNodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef receiverTypeOut As String, ByRef errText As String) As Integer
    receiverTypeOut = ""
    If receiverNodeIdx < 0 Or receiverNodeIdx >= ps.ast.count Then
        errText = "x64-codegen: invalid method receiver expression"
        Return 0
    End If

    Dim rk As String
    rk = X64Upper(Trim(ps.ast.nodes(receiverNodeIdx).kind))

    Select Case rk
    Case "IDENT", "IDENTIFIER", "VAR", "VAR_REF", "KEYWORD_REF"
        Dim receiverName As String
        receiverName = X64Upper(Trim(ps.ast.nodes(receiverNodeIdx).value))
        If receiverName = "" Then receiverName = X64Upper(Trim(ps.ast.nodes(receiverNodeIdx).symbolName))
        If receiverName = "" Then
            errText = "x64-codegen: method receiver name missing"
            Return 0
        End If
        If receiverName = "SUPER" Then Return -1
        If X64FindClassDeclNode(ps, receiverName) <> -1 Then Return -1

        If X64TryGetVarType(cg, receiverName, receiverTypeOut) = 0 Then
            X64FindDeclaredTypeName ps, receiverName, receiverTypeOut
        End If
        If receiverTypeOut = "" And (receiverName = "THIS" Or receiverName = "ME") Then
            X64ResolveCurrentReceiverClass ps, cg, receiverTypeOut
        End If
        receiverTypeOut = X64Upper(Trim(receiverTypeOut))
        If receiverTypeOut = "" Then
            errText = "x64-codegen: unknown method receiver type " & receiverName
            Return 0
        End If
        Return 1

    Case "FIELD_EXPR", "MEMBER_EXPR"
        Dim rootName As String
        Dim pathText As String
        Dim rootNode As Integer
        Dim rootType As String
        Dim fieldOffset As Integer
        Dim fieldType As String
        Dim fieldSize As Integer
        Dim resolveErr As String
        If X64ResolveFieldInfo(ps, receiverNodeIdx, cg, rootName, pathText, rootNode, rootType, fieldOffset, fieldType, fieldSize, resolveErr) = 0 Then
            errText = "x64-codegen: method receiver field type unresolved: " & resolveErr
            Return 0
        End If
        receiverTypeOut = X64Upper(Trim(fieldType))
        Return IIf(receiverTypeOut <> "", 1, 0)

    Case "CALL_EXPR"
        ' S-617: indexing a declared class array returns a class reference,
        ' although the AST represents indexing with CALL_EXPR.
        Dim indexedReceiverName As String, indexedReceiverIndex As Integer
        If X64TryExtractIndexedTarget(ps, receiverNodeIdx, indexedReceiverName, indexedReceiverIndex) <> 0 Then
            Dim indexedReceiverType As String
            If X64FindDeclaredTypeName(ps, indexedReceiverName, indexedReceiverType) <> 0 Then
                If X64FindClassDeclNode(ps, indexedReceiverType) <> -1 Then
                    receiverTypeOut = X64Upper(Trim(indexedReceiverType))
                    Return 1
                End If
            End If
        End If
        If X64TryResolveCallReturnType(ps, receiverNodeIdx, cg, receiverTypeOut) = 0 Then
            errText = "x64-codegen: method receiver call return type unresolved"
            Return 0
        End If
        receiverTypeOut = X64Upper(Trim(receiverTypeOut))
        Return IIf(receiverTypeOut <> "", 1, 0)

    Case "NEW_EXPR"
        receiverTypeOut = X64Upper(Trim(ps.ast.nodes(receiverNodeIdx).value))
        Return IIf(receiverTypeOut <> "", 1, 0)
    End Select

    errText = "x64-codegen: unsupported method receiver expression kind " & rk
    Return 0
End Function

Private Function GenerateExpression(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Return X64EmitExprToRax(ps, nodeIdx, cg, errText)
End Function

' S-098: the frame size cannot be known when the prologue is written. The pre-pass
' (X64CollectRoutineLocals) sizes declared variables, but statements such as FOR
' (limit/step temporaries), SELECT (selector temporary) and others create frame slots
' LAZILY while the body is emitted. With a numeric `sub rsp, N` computed before the
' body those slots lay BELOW rsp, where every push/call of the body overwrote them --
' e.g. a FOR loop in a FUNCTION with `AS I32` locals ran one iteration only. The
' prologue now subtracts a NASM EQU symbol whose value is written by the epilogue,
' after the whole body (and every lazily created slot) is known.
' frameBytes stays as the lower bound the caller already computed.
Private Sub EmitFunctionProlog(ByRef cg As X64CodegenContext, ByVal frameBytes As Integer)
    Dim frameSym As String
    frameSym = X64NextLabel(cg, "frame")
    If gX64FrameSymbolDepth < 16 Then gX64FrameSymbols(gX64FrameSymbolDepth) = frameSym
    gX64FrameSymbolDepth += 1
    X64EmitText cg, "    push rbp"
    X64EmitText cg, "    mov rbp, rsp"
    ' Frame size is finalized after emission; probe dynamically without
    ' clobbering incoming argument registers.
    Dim probeLoop As String = X64NextLabel(cg, "frame_probe")
    Dim probeTail As String = X64NextLabel(cg, "frame_probe_tail")
    X64EmitText cg, "    mov r10, " & frameSym
    X64EmitText cg, "    mov r11, rsp"
    X64EmitLabel cg, probeLoop
    X64EmitText cg, "    cmp r10, 4096"
    X64EmitText cg, "    jb " & probeTail
    X64EmitText cg, "    sub r11, 4096"
    X64EmitText cg, "    test byte [r11], 0"
    X64EmitText cg, "    sub r10, 4096"
    X64EmitText cg, "    jmp " & probeLoop
    X64EmitLabel cg, probeTail
    X64EmitText cg, "    sub r11, r10"
    X64EmitText cg, "    test byte [r11], 0"
    X64EmitText cg, "    sub rsp, " & frameSym
    For localIdx As Integer = 0 To cg.localCount - 1
        If Left(gX64LocalKeys(localIdx), Len("_UXB_DCA_")) = "_UXB_DCA_" And gX64LocalSlots(localIdx) = 3 Then
            X64EmitText cg, "    mov qword " & X64FormatRbpRef(gX64LocalOffsets(localIdx)) & ", 0"
            X64EmitText cg, "    mov qword " & X64FormatRbpRef(gX64LocalOffsets(localIdx)+8) & ", 0"
            X64EmitText cg, "    mov qword " & X64FormatRbpRef(gX64LocalOffsets(localIdx)+16) & ", -1"
        End If
    Next localIdx
    Dim abiRegs(0 To 6) As String = {"rbx", "rsi", "rdi", "r12", "r13", "r14", "r15"}
    For abiIdx As Integer = 0 To 6
        X64EmitText cg, "    mov qword [rbp - " & frameSym & " + " & X64ToStr(abiIdx * 8) & "], " & abiRegs(abiIdx)
    Next abiIdx
    If gX64ProgramHasLocks <> 0 Then
        ' The last word of the existing ABI tail is a per-invocation lock
        ' mark. Preserve incoming integer and float arguments while taking it.
        X64EmitText cg, "    sub rsp, 64"
        Dim argRegs(0 To 3) As String = {"rcx", "rdx", "r8", "r9"}
        For ai As Integer = 0 To 3
            X64EmitText cg, "    mov [rsp+" & X64ToStr(ai * 8) & "], " & argRegs(ai)
            X64EmitText cg, "    movq [rsp+" & X64ToStr(32 + ai * 8) & "], xmm" & X64ToStr(ai)
        Next
        X64EmitCall0 cg, "__uxb_rt_lock_mark"
        X64EmitText cg, "    mov [rbp - " & frameSym & " + 56], rax"
        For ai As Integer = 0 To 3
            X64EmitText cg, "    mov " & argRegs(ai) & ", [rsp+" & X64ToStr(ai * 8) & "]"
            X64EmitText cg, "    movq xmm" & X64ToStr(ai) & ", [rsp+" & X64ToStr(32 + ai * 8) & "]"
        Next
        X64EmitText cg, "    add rsp, 64"
    End If
End Sub

' S-675: the node being emitted when a node emitter fails without a message (GenerateX64Code names it in the fallback message).
Private Dim Shared gX64LastEmitNode As Integer = -1

' %%SECSTACK ON: before the routine returns every tracked local slot is cleared. Only memory-immediate stores and the scratch registers
' r10 / r11 are used, so the result in rax / xmm0 survives. A slot is cleared byte-exact: the frame above it holds the saved rbp.
Private Sub X64EmitSecStackWipe(ByRef cg As X64CodegenContext)
    If gLastPreprocessResult.secStack = 0 Then Exit Sub
    Dim wipeIdx As Integer
    For wipeIdx = 0 To cg.localCount - 1
        Dim slotBytes As Integer = gX64LocalSlots(wipeIdx) * gX64LocalElemBytes(wipeIdx)
        Dim slotOffset As Integer = gX64LocalOffsets(wipeIdx)
        If slotBytes <= 0 Or slotOffset >= 0 Or slotOffset + slotBytes > 0 Then Continue For
        If slotBytes > 128 Then
            Dim wipeLoop As String = X64NextLabel(cg, "secstack_wipe")
            Dim wordCount As Integer = slotBytes \ 8
            X64EmitText cg, "    lea r11, " & X64FormatRbpRef(slotOffset)
            X64EmitText cg, "    mov r10, " & X64ToStr(wordCount)
            X64EmitLabel cg, wipeLoop
            X64EmitText cg, "    mov qword [r11], 0"
            X64EmitText cg, "    add r11, 8"
            X64EmitText cg, "    dec r10"
            X64EmitText cg, "    jnz " & wipeLoop
            Dim tailAt As Integer = wordCount * 8
            Dim tailLeft As Integer = slotBytes - tailAt
            If tailLeft >= 4 Then X64EmitText cg, "    mov dword " & X64FormatRbpRef(slotOffset + tailAt) & ", 0": tailAt += 4: tailLeft -= 4
            If tailLeft >= 2 Then X64EmitText cg, "    mov word " & X64FormatRbpRef(slotOffset + tailAt) & ", 0": tailAt += 2: tailLeft -= 2
            If tailLeft >= 1 Then X64EmitText cg, "    mov byte " & X64FormatRbpRef(slotOffset + tailAt) & ", 0"
        Else
            Dim wipeAt As Integer = 0
            Do While wipeAt + 8 <= slotBytes
                X64EmitText cg, "    mov qword " & X64FormatRbpRef(slotOffset + wipeAt) & ", 0"
                wipeAt += 8
            Loop
            If slotBytes - wipeAt >= 4 Then X64EmitText cg, "    mov dword " & X64FormatRbpRef(slotOffset + wipeAt) & ", 0": wipeAt += 4
            If slotBytes - wipeAt >= 2 Then X64EmitText cg, "    mov word " & X64FormatRbpRef(slotOffset + wipeAt) & ", 0": wipeAt += 2
            If slotBytes - wipeAt >= 1 Then X64EmitText cg, "    mov byte " & X64FormatRbpRef(slotOffset + wipeAt) & ", 0"
        End If
    Next wipeIdx
End Sub

Private Sub EmitFunctionEpilog(ByRef cg As X64CodegenContext)
    If gX64FrameSymbolDepth > 0 And gX64FrameSymbolDepth <= 16 Then
        Dim abiFrame As String = gX64FrameSymbols(gX64FrameSymbolDepth - 1)
        If gX64ProgramHasLocks <> 0 Then
            ' Normal return, propagated failure and cooperative cancellation
            ' all pass this epilogue. Never leave a callee's explicit lock held.
            X64EmitText cg, "    sub rsp, 16"
            X64EmitText cg, "    mov [rsp], rax"
            X64EmitText cg, "    movq [rsp+8], xmm0"
            X64EmitText cg, "    mov rcx, [rbp - " & abiFrame & " + 56]"
            X64EmitCall0 cg, "__uxb_rt_lock_release_to"
            X64EmitText cg, "    mov rax, [rsp]"
            X64EmitText cg, "    movq xmm0, [rsp+8]"
            X64EmitText cg, "    add rsp, 16"
        End If
        Dim abiRegs(0 To 6) As String = {"rbx", "rsi", "rdi", "r12", "r13", "r14", "r15"}
        For abiIdx As Integer = 0 To 6
            X64EmitText cg, "    mov " & abiRegs(abiIdx) & ", qword [rbp - " & abiFrame & " + " & X64ToStr(abiIdx * 8) & "]"
        Next abiIdx
    End If
    X64EmitText cg, "    leave"
    X64EmitText cg, "    ret"
    If gX64FrameSymbolDepth > 0 Then
        gX64FrameSymbolDepth -= 1
        If gX64FrameSymbolDepth < 16 Then
            ' The extra aligned tail holds saved registers below all existing locals.
            X64EmitText cg, gX64FrameSymbols(gX64FrameSymbolDepth) & " equ " & X64ToStr(X64Align16(cg.localFrameBytes) + 64)
        End If
    End If
End Sub

Private Function X64ChildByRole(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef roleRaw As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1

    Dim wanted As String
    wanted = X64Upper(roleRaw)

    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).role) = wanted Then Return ch
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return -1
End Function

Private Function X64RuntimeTaskTypeId(ByRef laneKindRaw As String) As Integer
    Select Case X64Upper(laneKindRaw)
    Case "EVENT"
        Return 1
    Case "PIPE"
        Return 2
    Case "THREAD"
        Return 3
    Case "PARALEL"
        Return 4
    End Select
    Return 0
End Function

Private Function X64RuntimeTriggerSymbol(ByRef laneKindRaw As String, ByRef symbolOut As String) As Integer
    symbolOut = ""
    Select Case X64Upper(laneKindRaw)
    Case "EVENT"
        symbolOut = "uxb_task_trigger"
        Return 1
    Case "PIPE"
        symbolOut = "uxb_pipe_run"
        Return 1
    Case "THREAD"
        symbolOut = "uxb_thread_start"
        Return 1
    Case "PARALEL"
        symbolOut = "uxb_parallel_run"
        Return 1
    End Select
    Return 0
End Function

Private Function X64SlotCallbackLabelForNode(ByVal nodeIdx As Integer) As String
    Return "__uxb_slot_cb_" & LTrim(Str(nodeIdx))
End Function

Private Sub X64EmitNativeRuntimeExterns(ByRef cg As X64CodegenContext)
    X64EmitText cg, "extern uxb_rt_init"
    X64EmitText cg, "extern uxb_rt_shutdown"
    X64EmitText cg, "extern uxb_task_register"
    X64EmitText cg, "extern uxb_slot_bind"
    X64EmitText cg, "extern uxb_task_set_callback"
    X64EmitText cg, "extern uxb_slot_control"
    X64EmitText cg, "extern uxb_task_trigger"
    X64EmitText cg, "extern uxb_thread_start"
    X64EmitText cg, "extern uxb_pipe_run"
    X64EmitText cg, "extern uxb_parallel_run"
    X64EmitText cg, "extern uxb_shell_run"
    X64EmitText cg, "extern uxb_shell_start"
    X64EmitText cg, "extern uxb_text_file_write"
End Sub

Private Sub X64EmitNativeRuntimeAbort(ByRef cg As X64CodegenContext)
    X64EmitText cg, "    mov ecx, 1"
    X64EmitCall0 cg, "exit"
    X64EmitText cg, "    ud2"
End Sub

Private Sub X64EmitNativeRuntimeCheckEax(ByRef cg As X64CodegenContext)
    Dim okLabel As String
    okLabel = X64NextLabel(cg, "rt_ok")
    X64EmitText cg, "    test eax, eax"
    X64EmitText cg, "    jne " & okLabel
    X64EmitNativeRuntimeAbort cg
    X64EmitLabel cg, okLabel
End Sub

Private Sub X64EmitNativeRuntimeInit(ByRef cg As X64CodegenContext)
    X64EmitComment cg, "uxb_runtime.dll init"
    X64EmitCall0 cg, "uxb_rt_init"
    X64EmitNativeRuntimeCheckEax cg
End Sub

Private Sub X64EmitNativeRuntimeShutdown(ByRef cg As X64CodegenContext)
    X64EmitComment cg, "uxb_runtime.dll shutdown"
    X64EmitCall0 cg, "uxb_rt_shutdown"
    X64EmitNativeRuntimeCheckEax cg
    X64EmitText cg, "    xor eax, eax"
End Sub

Private Function X64AstUsesNativeRuntimeSlots(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)
    Select Case nodeKind
    Case "SHELL_STMT", "SLOT_TABLE_STMT", "SLOT_BIND_ENTRY", "SLOT_CONTROL_STMT", "TRIGGER_STMT"
        Return 1
    Case "EVENT_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT"
        Dim headerSlotId As Integer
        If X64SlotTryConstHeaderId(ps, nodeIdx, headerSlotId) <> 0 Then Return 1
    End Select

    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If X64AstUsesNativeRuntimeSlots(ps, ch) <> 0 Then Return 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Function X64SlotResolveAnyDeclNode(ByRef ps As ParseState, ByVal targetExprIdx As Integer, ByRef declNodeOut As Integer, ByRef laneKindOut As String, ByRef errText As String) As Integer
    declNodeOut = -1
    laneKindOut = ""

    Dim kinds(0 To 3) As String
    kinds(0) = "EVENT"
    kinds(1) = "PIPE"
    kinds(2) = "THREAD"
    kinds(3) = "PARALEL"

    Dim foundCount As Integer
    Dim i As Integer
    For i = 0 To 3
        Dim candidate As Integer
        Dim candidateErr As String
        candidateErr = ""
        If X64SlotResolveDeclNode(ps, kinds(i), targetExprIdx, candidate, candidateErr) <> 0 Then
            declNodeOut = candidate
            laneKindOut = kinds(i)
            foundCount += 1
        End If
    Next

    If foundCount = 1 Then Return 1
    If foundCount > 1 Then
        errText = "x64-codegen: slot target is ambiguous"
    Else
        errText = "x64-codegen: slot target not found"
    End If
    Return 0
End Function

Private Function X64SlotFindBoundSlotIdForDeclNode(ByRef ps As ParseState, ByVal declNodeIdx As Integer, ByRef slotIdOut As Integer) As Integer
    slotIdOut = -1
    If declNodeIdx < 0 Or declNodeIdx >= ps.ast.count Then Return 0

    Dim declLaneKind As String
    If X64SlotLaneKindFromNodeKind(ps.ast.nodes(declNodeIdx).kind, declLaneKind) = 0 Then Return 0

    Dim found As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If X64Upper(ps.ast.nodes(i).kind) = "SLOT_CONTROL_STMT" AndAlso X64Upper(Trim(ps.ast.nodes(i).op)) = "ON" Then
            Dim controlKind As String
            controlKind = X64Upper(Trim(ps.ast.nodes(i).value))
            If controlKind <> declLaneKind Then Continue For
            Dim controlTarget As Integer
            controlTarget = X64ChildAt(ps, i, 0)
            Dim controlId As Integer
            controlId = X64ChildAt(ps, i, 1)
            If controlTarget = -1 OrElse controlId = -1 Then Continue For
            Dim controlDecl As Integer
            Dim controlErr As String
            controlErr = ""
            If X64SlotResolveDeclNode(ps, controlKind, controlTarget, controlDecl, controlErr) = 0 Then Continue For
            If controlDecl <> declNodeIdx Then Continue For
            Dim parsedControlId As Integer
            If X64TryConstIntExpr(ps, controlId, parsedControlId) = 0 Then Continue For
            slotIdOut = parsedControlId
            found = 1
            Continue For
        End If

        If X64Upper(ps.ast.nodes(i).kind) <> "SLOT_BIND_ENTRY" Then Continue For

        Dim entryLaneKind As String
        entryLaneKind = X64Upper(Trim(ps.ast.nodes(i).typeName))
        If entryLaneKind = "" Then entryLaneKind = declLaneKind
        If entryLaneKind <> declLaneKind Then Continue For

        Dim targetIdx As Integer
        targetIdx = X64ChildByRole(ps, i, "TARGET")
        If targetIdx = -1 Then Continue For

        Dim resolvedDecl As Integer
        Dim resolveErr As String
        resolveErr = ""
        If X64SlotResolveDeclNode(ps, entryLaneKind, targetIdx, resolvedDecl, resolveErr) = 0 Then Continue For
        If resolvedDecl <> declNodeIdx Then Continue For

        Dim idIdx As Integer
        idIdx = X64ChildByRole(ps, i, "SLOT_ID")
        If idIdx = -1 Then Continue For

        Dim parsedId As Integer
        If X64TryConstIntExpr(ps, idIdx, parsedId) = 0 Then Continue For
        slotIdOut = parsedId
        found = 1
    Next

    If found <> 0 Then Return 1
    Return X64SlotTryConstHeaderId(ps, declNodeIdx, slotIdOut)
End Function

Private Function X64EmitNativeRuntimeCallbackThunk(ByRef ps As ParseState, ByVal blockNodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim laneKind As String
    If X64SlotLaneKindFromNodeKind(ps.ast.nodes(blockNodeIdx).kind, laneKind) = 0 Then Return 1

    Dim inputLabel As String
    inputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_INPUT_NAME, 1, 8)
    Dim outputLabel As String
    outputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_RESULT_NAME, 1, 8)

    Dim callbackLabel As String
    callbackLabel = X64SlotCallbackLabelForNode(blockNodeIdx)
    Dim routineLabel As String
    routineLabel = X64SlotRoutineLabelForNode(blockNodeIdx)

    X64EmitText cg, "global " & callbackLabel
    X64EmitLabel cg, callbackLabel
    X64EmitText cg, "    push rbp"
    X64EmitText cg, "    mov rbp, rsp"
    X64EmitText cg, "    sub rsp, 48"
    X64EmitText cg, "    mov [rbp - 8], r8"
    X64EmitText cg, "    movsxd rax, edx"
    X64EmitText cg, "    mov [rel " & inputLabel & "], rax"
    X64EmitText cg, "    mov qword [rel " & outputLabel & "], 0"
    X64EmitText cg, "    call " & routineLabel
    X64EmitText cg, "    mov r10, [rbp - 8]"
    X64EmitText cg, "    test r10, r10"
    Dim noOutputLabel As String
    noOutputLabel = X64NextLabel(cg, "slot_cb_no_output")
    X64EmitText cg, "    je " & noOutputLabel
    X64EmitText cg, "    mov eax, dword [rel " & outputLabel & "]"
    X64EmitText cg, "    mov dword [r10], eax"
    X64EmitLabel cg, noOutputLabel
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    leave"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""
    Return 1
End Function

Private Function X64EmitNativeRuntimeBindSlot(ByRef ps As ParseState, ByVal slotId As Integer, ByRef laneKindRaw As String, ByVal declNodeIdx As Integer, ByRef registerNameRaw As String, ByRef bindNameRaw As String, ByVal activeValue As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If slotId < 0 Or slotId > 255 Then
        errText = "x64-codegen: runtime slot id out of range"
        Return 0
    End If

    Dim taskType As Integer
    taskType = X64RuntimeTaskTypeId(laneKindRaw)
    If taskType = 0 Then
        errText = "x64-codegen: invalid runtime slot kind " & laneKindRaw
        Return 0
    End If

    Dim registerName As String
    registerName = Trim(registerNameRaw)
    If registerName = "" And declNodeIdx >= 0 And declNodeIdx < ps.ast.count Then registerName = Trim(ps.ast.nodes(declNodeIdx).value)
    If registerName = "" Then
        errText = "x64-codegen: runtime slot task name missing"
        Return 0
    End If

    Dim bindName As String
    bindName = Trim(bindNameRaw)
    If bindName = "" Then bindName = registerName

    Dim registerLabel As String
    registerLabel = X64CreateCStringConstant(cg, registerName, "slot_task_name")
    Dim bindLabel As String
    bindLabel = X64CreateCStringConstant(cg, bindName, "slot_bind_name")

    Dim callbackLabel As String
    callbackLabel = X64SlotCallbackLabelForNode(declNodeIdx)

    cg.nativeRuntimeUsed = 1
    X64EmitComment cg, "uxb_runtime slot bind " & X64Upper(laneKindRaw) & " id " & X64ToStr(slotId)
    X64EmitText cg, "    mov ecx, " & X64ToStr(slotId)
    X64EmitText cg, "    mov edx, " & X64ToStr(taskType)
    X64EmitText cg, "    lea r8, [rel " & registerLabel & "]"
    X64EmitCall0 cg, "uxb_task_register"
    X64EmitNativeRuntimeCheckEax cg

    X64EmitText cg, "    mov ecx, " & X64ToStr(slotId)
    X64EmitText cg, "    mov edx, " & X64ToStr(taskType)
    X64EmitText cg, "    lea r8, [rel " & bindLabel & "]"
    X64EmitCall0 cg, "uxb_slot_bind"
    X64EmitNativeRuntimeCheckEax cg

    X64EmitText cg, "    mov ecx, " & X64ToStr(slotId)
    X64EmitText cg, "    lea rdx, [rel " & callbackLabel & "]"
    X64EmitText cg, "    xor r8d, r8d"
    X64EmitCall0 cg, "uxb_task_set_callback"
    X64EmitNativeRuntimeCheckEax cg

    X64EmitText cg, "    mov ecx, " & X64ToStr(slotId)
    X64EmitText cg, "    mov edx, " & X64ToStr(IIf(activeValue <> 0, 1, 0))
    X64EmitCall0 cg, "uxb_slot_control"
    X64EmitNativeRuntimeCheckEax cg

    If declNodeIdx >= 0 And declNodeIdx < ps.ast.count Then
        Dim activeLabel As String
        activeLabel = X64EnsureGlobalSymbol(cg, X64SlotActiveSymbolName(declNodeIdx), 1, 4)
        X64EmitText cg, "    mov dword [rel " & activeLabel & "], " & X64ToStr(IIf(activeValue <> 0, 1, 0))
    End If

    Return 1
End Function

Private Function X64EmitNativeRuntimeSlotBindEntry(ByRef ps As ParseState, ByVal entryNodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim idIdx As Integer
    idIdx = X64ChildByRole(ps, entryNodeIdx, "SLOT_ID")
    If idIdx = -1 Then
        errText = "x64-codegen: SLOT table id missing"
        Return 0
    End If

    Dim slotId As Integer
    If X64TryConstIntExpr(ps, idIdx, slotId) = 0 Then
        errText = "x64-codegen: SLOT table id must be constant integer"
        Return 0
    End If

    Dim targetIdx As Integer
    targetIdx = X64ChildByRole(ps, entryNodeIdx, "TARGET")
    If targetIdx = -1 Then
        errText = "x64-codegen: SLOT table target missing"
        Return 0
    End If

    Dim laneKind As String
    laneKind = X64Upper(Trim(ps.ast.nodes(entryNodeIdx).typeName))

    Dim declNode As Integer
    If laneKind = "" Then
        If X64SlotResolveAnyDeclNode(ps, targetIdx, declNode, laneKind, errText) = 0 Then Return 0
    Else
        If X64SlotResolveDeclNode(ps, laneKind, targetIdx, declNode, errText) = 0 Then Return 0
    End If

    Dim opText As String
    opText = X64Upper(Trim(ps.ast.nodes(entryNodeIdx).op))
    Dim activeValue As Integer
    If opText = "OFF" Then
        activeValue = 0
    ElseIf opText = "ON" Then
        activeValue = 1
    Else
        errText = "x64-codegen: SLOT table entry op must be ON/OFF"
        Return 0
    End If

    Dim slotName As String
    slotName = Trim(ps.ast.nodes(entryNodeIdx).value)
    Dim taskName As String
    taskName = Trim(ps.ast.nodes(declNode).symbolName)
    If taskName = "" Then taskName = Trim(ps.ast.nodes(declNode).value)

    Return X64EmitNativeRuntimeBindSlot(ps, slotId, laneKind, declNode, taskName, slotName, activeValue, cg, errText)
End Function

Private Function X64EmitNativeRuntimeSlotControl(ByVal slotId As Integer, ByVal activeValue As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If slotId < 0 Or slotId > 255 Then
        errText = "x64-codegen: slot control id out of range"
        Return 0
    End If
    cg.nativeRuntimeUsed = 1
    X64EmitText cg, "    mov ecx, " & X64ToStr(slotId)
    X64EmitText cg, "    mov edx, " & X64ToStr(IIf(activeValue <> 0, 1, 0))
    X64EmitCall0 cg, "uxb_slot_control"
    X64EmitNativeRuntimeCheckEax cg
    Return 1
End Function

Private Function X64EmitNativeRuntimeTrigger(ByRef ps As ParseState, ByVal triggerNodeIdx As Integer, ByRef laneKindRaw As String, ByVal slotId As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If slotId < 0 Or slotId > 255 Then
        errText = "x64-codegen: trigger slot id out of range"
        Return 0
    End If

    Dim invokeSymbol As String
    If X64RuntimeTriggerSymbol(laneKindRaw, invokeSymbol) = 0 Then
        errText = "x64-codegen: invalid trigger lane kind " & laneKindRaw
        Return 0
    End If

    Dim inputLabel As String
    inputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_INPUT_NAME, 1, 8)
    Dim outputLabel As String
    outputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_RESULT_NAME, 1, 8)

    Dim inputExpr As Integer
    inputExpr = X64ChildAt(ps, triggerNodeIdx, 1)
    If inputExpr <> -1 Then
        If X64EmitExprToRax(ps, inputExpr, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    mov [rel " & inputLabel & "], rax"
    Else
        X64EmitText cg, "    mov qword [rel " & inputLabel & "], 0"
    End If
    X64EmitText cg, "    mov qword [rel " & outputLabel & "], 0"

    cg.nativeRuntimeUsed = 1
    X64EmitText cg, "    mov ecx, " & X64ToStr(slotId)
    X64EmitText cg, "    mov edx, dword [rel " & inputLabel & "]"
    X64EmitText cg, "    lea r8, [rel " & outputLabel & "]"
    X64EmitCall0 cg, invokeSymbol
    X64EmitNativeRuntimeCheckEax cg
    Return 1
End Function

Private Function X64EmitSlotLaneBodyRoutine(ByRef ps As ParseState, ByVal blockNodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim laneKind As String
    If X64SlotLaneKindFromNodeKind(ps.ast.nodes(blockNodeIdx).kind, laneKind) = 0 Then Return 1

    Dim savedRoutineLabel As String
    Dim savedLocalCount As Integer
    Dim savedLocalFrameBytes As Integer
    Dim savedParamCount As Integer
    Dim savedRoutineIsFunction As Integer
    Dim savedEpilogLabel As String

    savedRoutineLabel = cg.currentRoutineLabel
    savedLocalCount = cg.localCount
    savedLocalFrameBytes = cg.localFrameBytes
    savedParamCount = cg.paramCount
    savedRoutineIsFunction = cg.currentRoutineIsFunction
    savedEpilogLabel = cg.currentEpilogLabel

    ' Typed task routines use the ordinary Win64 routine ABI.  This is the
    ' direct AST->x64 path and deliberately bypasses native SLOT ABI v1, whose
    ' payload is limited to one signed 32-bit value.
    If X64CountRoutineParams(ps, blockNodeIdx) > 0 Or X64TaskLaneIsSpawned(ps, blockNodeIdx) <> 0 Then
        Dim typedRoutineLabel As String
        typedRoutineLabel = LCase(X64SanitizeSymbol(Trim(ps.ast.nodes(blockNodeIdx).value)))
        If typedRoutineLabel = "" Then
            errText = "x64-codegen: typed task routine name missing"
            Return 0
        End If
        X64RegisterRoutineSignatureAs ps, blockNodeIdx, cg, typedRoutineLabel
        Dim typedRoutineIndex As Integer
        typedRoutineIndex = X64FindRoutine(cg, X64Upper(typedRoutineLabel))
        Dim typedIsFunction As Integer
        typedIsFunction = IIf(X64Upper(ps.ast.nodes(blockNodeIdx).kind) = "PIPE_STMT" Or X64ExtractRoutineReturnType(ps, blockNodeIdx) <> "", 1, 0)
        If typedRoutineIndex <> -1 Then gX64RoutineIsFunction(typedRoutineIndex) = typedIsFunction
        If GenerateRoutine(ps, blockNodeIdx, cg, errText, typedIsFunction, typedRoutineLabel) = 0 Then Return 0
        If X64TaskLaneIsSpawned(ps, blockNodeIdx) <> 0 Then X64TaskEmitThunk ps, blockNodeIdx, cg
        cg.currentRoutineLabel = savedRoutineLabel
        cg.localCount = savedLocalCount
        cg.localFrameBytes = savedLocalFrameBytes
        cg.paramCount = savedParamCount
        cg.currentRoutineIsFunction = savedRoutineIsFunction
        cg.currentEpilogLabel = savedEpilogLabel
        Return 1
    End If

    cg.currentRoutineLabel = X64SlotRoutineLabelForNode(blockNodeIdx)
    cg.localCount = 0
    cg.localFrameBytes = 0
    cg.paramCount = 0
    cg.currentRoutineIsFunction = 0
    cg.currentEpilogLabel = X64NextLabel(cg, "slot_ret")

    X64EnsureGlobalSymbol(cg, UXB_TASK_INPUT_NAME, 1, 8)
    X64EnsureGlobalSymbol(cg, UXB_TASK_RESULT_NAME, 1, 8)

    Dim scanNode As Integer
    scanNode = ps.ast.nodes(blockNodeIdx).firstChild
    Do While scanNode <> -1
        If X64Upper(ps.ast.nodes(scanNode).kind) <> "SLOT_HEADER_ARGS" Then
            X64CollectRoutineLocals ps, scanNode, cg
        End If
        scanNode = ps.ast.nodes(scanNode).nextSibling
    Loop

    Dim frameBytes As Integer
    frameBytes = X64Align16(cg.localFrameBytes)

    X64EmitText cg, "global " & cg.currentRoutineLabel
    X64EmitLabel cg, cg.currentRoutineLabel
    EmitFunctionProlog cg, frameBytes

    Dim bodyNode As Integer
    bodyNode = ps.ast.nodes(blockNodeIdx).firstChild
    Do While bodyNode <> -1
        Dim bodyKind As String
        bodyKind = X64Upper(ps.ast.nodes(bodyNode).kind)
        If bodyKind <> "SLOT_HEADER_ARGS" Then
            If bodyKind = "DIM_STMT" Or bodyKind = "DIM" Or bodyKind = "REDIM_STMT" Or bodyKind = "REDIM" Or _
               bodyKind = "PRINT_STMT" Or bodyKind = "PRINT" Or bodyKind = "CALL_STMT" Or bodyKind = "CALL_EXPR" Or bodyKind = "CALL" Or _
               bodyKind = "CALL_DLL_STMT" Or bodyKind = "CALL_API_STMT" Then
                If GenerateStatement(ps, bodyNode, cg, errText) = 0 Then Return 0
            Else
                If X64EmitNode(ps, bodyNode, cg, errText) = 0 Then Return 0
            End If
        End If
        bodyNode = ps.ast.nodes(bodyNode).nextSibling
    Loop

    X64EmitLabel cg, cg.currentEpilogLabel
    EmitFunctionEpilog cg
    X64EmitText cg, ""

    cg.currentRoutineLabel = savedRoutineLabel
    cg.localCount = savedLocalCount
    cg.localFrameBytes = savedLocalFrameBytes
    cg.paramCount = savedParamCount
    cg.currentRoutineIsFunction = savedRoutineIsFunction
    cg.currentEpilogLabel = savedEpilogLabel
    If X64EmitNativeRuntimeCallbackThunk(ps, blockNodeIdx, cg, errText) = 0 Then Return 0
    Return 1
End Function

Private Function X64EmitSlotLaneRoutines(ByRef ps As ParseState, ByVal rootNodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If rootNodeIdx < 0 Or rootNodeIdx >= ps.ast.count Then Return 1

    Dim ch As Integer
    ch = ps.ast.nodes(rootNodeIdx).firstChild
    Do While ch <> -1
        Dim laneKind As String
        If X64SlotLaneKindFromNodeKind(ps.ast.nodes(ch).kind, laneKind) <> 0 Then
            If X64EmitSlotLaneBodyRoutine(ps, ch, cg, errText) = 0 Then Return 0
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Function X64EmitSlotLaneStmtCore(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 1

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)

    If nodeKind = "SLOT_TABLE_STMT" Then
        X64EmitComment cg, "uxb_runtime SLOT table"
        Dim entryNode As Integer
        entryNode = ps.ast.nodes(nodeIdx).firstChild
        Do While entryNode <> -1
            If X64Upper(ps.ast.nodes(entryNode).kind) <> "SLOT_BIND_ENTRY" Then
                errText = "x64-codegen: invalid SLOT table entry"
                Return 0
            End If
            If X64EmitNativeRuntimeSlotBindEntry(ps, entryNode, cg, errText) = 0 Then Return 0
            entryNode = ps.ast.nodes(entryNode).nextSibling
        Loop
        Return 1
    End If

    If nodeKind = "SLOT_BIND_ENTRY" Then
        Return X64EmitNativeRuntimeSlotBindEntry(ps, nodeIdx, cg, errText)
    End If

    Dim laneKind As String
    If X64SlotLaneKindFromNodeKind(nodeKind, laneKind) <> 0 Then
        Dim activeLabel As String
        activeLabel = X64EnsureGlobalSymbol(cg, X64SlotActiveSymbolName(nodeIdx), 1, 4)

        Dim countLabel As String
        countLabel = X64EnsureGlobalSymbol(cg, X64SlotCountSymbolName(laneKind), 1, 4)

        Dim capLabel As String
        capLabel = X64EnsureGlobalSymbol(cg, X64SlotCapSymbolName(laneKind), 1, 4)

        Dim skipLabel As String
        skipLabel = X64NextLabel(cg, "slot_decl_skip")

        X64EnsureGlobalSymbol(cg, UXB_TASK_INPUT_NAME, 1, 8)
        X64EnsureGlobalSymbol(cg, UXB_TASK_RESULT_NAME, 1, 8)

        X64EmitComment cg, "slot lane declaration " & laneKind & " " & X64Upper(ps.ast.nodes(nodeIdx).value)
        X64EmitText cg, "    mov dword [rel " & activeLabel & "], 0"
        X64EmitText cg, "    mov eax, dword [rel " & capLabel & "]"
        X64EmitText cg, "    test eax, eax"
        X64EmitText cg, "    jle " & skipLabel
        X64EmitText cg, "    cmp dword [rel " & countLabel & "], eax"
        X64EmitText cg, "    jge " & skipLabel
        X64EmitText cg, "    inc dword [rel " & countLabel & "]"
        X64EmitLabel cg, skipLabel

        Dim headerSlotId As Integer
        If X64SlotTryConstHeaderId(ps, nodeIdx, headerSlotId) <> 0 Then
            Dim taskName As String
            taskName = Trim(ps.ast.nodes(nodeIdx).symbolName)
            If taskName = "" Then taskName = Trim(ps.ast.nodes(nodeIdx).value)
            If X64EmitNativeRuntimeBindSlot(ps, headerSlotId, laneKind, nodeIdx, taskName, taskName, 0, cg, errText) = 0 Then Return 0
        End If
        Return 1
    End If

    If nodeKind = "SLOT_STMT" Then
        laneKind = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))
        If laneKind = "" Then
            errText = "x64-codegen: SLOT kind missing"
            Return 0
        End If

        Dim countExpr As Integer
        countExpr = X64ChildAt(ps, nodeIdx, 0)
        If countExpr = -1 Then
            errText = "x64-codegen: SLOT count missing"
            Return 0
        End If

        Dim slotCap As Integer
        If X64TryConstIntExpr(ps, countExpr, slotCap) = 0 Then
            errText = "x64-codegen: SLOT count must be constant integer"
            Return 0
        End If
        If slotCap < 0 Or slotCap > 256 Then
            errText = "x64-codegen: SLOT count must be in 0..256"
            Return 0
        End If

        Dim capLabel As String
        capLabel = X64EnsureGlobalSymbol(cg, X64SlotCapSymbolName(laneKind), 1, 4)
        X64EmitComment cg, "slot lane cap " & laneKind & " = " & X64ToStr(slotCap)
        X64EmitText cg, "    mov dword [rel " & capLabel & "], " & X64ToStr(slotCap)
        Return 1
    End If

    If nodeKind = "SLOT_CONTROL_STMT" Then
        laneKind = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))
        Dim targetExpr As Integer
        targetExpr = X64ChildAt(ps, nodeIdx, 0)

        Dim declNode As Integer
        If X64SlotResolveDeclNode(ps, laneKind, targetExpr, declNode, errText) = 0 Then Return 0

        Dim activeLabel As String
        activeLabel = X64EnsureGlobalSymbol(cg, X64SlotActiveSymbolName(declNode), 1, 4)

        Dim opText As String
        opText = X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
        Dim slotId As Integer
        If X64SlotFindBoundSlotIdForDeclNode(ps, declNode, slotId) = 0 Then
            errText = "x64-codegen: slot control target has no runtime slot id"
            Return 0
        End If
        If opText = "ON" Then
            X64EmitComment cg, "slot lane ON " & laneKind
            X64EmitText cg, "    mov dword [rel " & activeLabel & "], 1"
            Dim directTaskName As String
            directTaskName = Trim(ps.ast.nodes(declNode).symbolName)
            If directTaskName = "" Then directTaskName = Trim(ps.ast.nodes(declNode).value)
            If X64EmitNativeRuntimeBindSlot(ps, slotId, laneKind, declNode, directTaskName, directTaskName, 1, cg, errText) = 0 Then Return 0
            Return 1
        ElseIf opText = "OFF" Then
            X64EmitComment cg, "slot lane OFF " & laneKind
            X64EmitText cg, "    mov dword [rel " & activeLabel & "], 0"
            If X64EmitNativeRuntimeSlotControl(slotId, 0, cg, errText) = 0 Then Return 0
            Return 1
        End If

        errText = "x64-codegen: invalid slot control op " & ps.ast.nodes(nodeIdx).op
        Return 0
    End If

    If nodeKind = "TRIGGER_STMT" Then
        laneKind = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))
        If laneKind = "TASK" Or laneKind = "" Then
            Dim resolvedTriggerKind As String
            resolvedTriggerKind = X64Upper(Trim(ps.ast.nodes(nodeIdx).typeName))
            If resolvedTriggerKind <> "" Then laneKind = resolvedTriggerKind
        End If
        Dim triggerTargetExpr As Integer
        triggerTargetExpr = X64ChildAt(ps, nodeIdx, 0)

        Dim triggerDecl As Integer
        If X64SlotResolveDeclNode(ps, laneKind, triggerTargetExpr, triggerDecl, errText) = 0 Then Return 0

        Dim activeLabel As String
        activeLabel = X64EnsureGlobalSymbol(cg, X64SlotActiveSymbolName(triggerDecl), 1, 4)

        Dim triggerSlotId As Integer
        If X64SlotFindBoundSlotIdForDeclNode(ps, triggerDecl, triggerSlotId) = 0 Then
            Dim directParamCount As Integer
            directParamCount = X64CountRoutineParams(ps, triggerDecl)
            If directParamCount > 0 Then
                Dim directTaskLabel As String
                directTaskLabel = LCase(X64SanitizeSymbol(Trim(ps.ast.nodes(triggerDecl).value)))
                X64RegisterRoutineSignatureAs ps, triggerDecl, cg, directTaskLabel
                Dim directRoutineIndex As Integer
                directRoutineIndex = X64FindRoutine(cg, X64Upper(directTaskLabel))
                If directRoutineIndex <> -1 Then gX64RoutineIsFunction(directRoutineIndex) = IIf(laneKind = "PIPE", 1, 0)
                Dim triggerArgCount As Integer
                triggerArgCount = 0
                Dim triggerArgNode As Integer
                triggerArgNode = X64ChildAt(ps, nodeIdx, 1)
                Do While triggerArgNode <> -1
                    triggerArgCount += 1
                    triggerArgNode = ps.ast.nodes(triggerArgNode).nextSibling
                Loop
                Dim emptyOwner As String, emptyType As String, emptyMethod As String
                If X64EmitRoutineCall(ps, nodeIdx, cg, directTaskLabel, triggerArgCount, 0, emptyOwner, emptyType, emptyMethod, -1, -1, errText, 1) = 0 Then Return 0
                If laneKind = "PIPE" Then
                    Dim directOutputLabel As String
                    directOutputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_RESULT_NAME, 1, 8)
                    X64EmitText cg, "    mov [rel " & directOutputLabel & "], rax"
                End If
                Return 1
            End If
            errText = "x64-codegen: trigger target has no runtime slot id"
            Return 0
        End If

        Dim skipCallLabel As String
        skipCallLabel = X64NextLabel(cg, "slot_trigger_skip")
        X64EmitComment cg, "slot lane TRIGGER " & laneKind
        X64EmitText cg, "    cmp dword [rel " & activeLabel & "], 0"
        X64EmitText cg, "    je " & skipCallLabel
        If X64EmitNativeRuntimeTrigger(ps, nodeIdx, laneKind, triggerSlotId, cg, errText) = 0 Then Return 0
        X64EmitLabel cg, skipCallLabel
        Return 1
    End If

    errText = "x64-codegen: unsupported slot lane stmt " & ps.ast.nodes(nodeIdx).kind
    Return 0
End Function

Private Function X64EmitShellStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim commandNode As Integer
    commandNode = X64ChildAt(ps, nodeIdx, 0)
    If commandNode = -1 Then
        errText = "x64-codegen: SHELL command missing"
        Return 0
    End If

    Dim timeoutNode As Integer
    Dim runPathNode As Integer
    Dim outPathNode As Integer
    Dim errPathNode As Integer
    Dim nowaitMode As Integer
    Dim outVarName As String
    Dim errVarName As String
    Dim codeVarName As String
    timeoutNode = -1
    runPathNode = -1
    outPathNode = -1
    errPathNode = -1
    nowaitMode = 0

    Dim optionNode As Integer
    optionNode = ps.ast.nodes(nodeIdx).firstChild
    If optionNode <> -1 Then optionNode = ps.ast.nodes(optionNode).nextSibling
    Do While optionNode <> -1
        If X64Upper(ps.ast.nodes(optionNode).kind) = "SHELL_OPTION" Then
            Dim optionName As String
            Dim payloadNode As Integer
            optionName = X64Upper(Trim(ps.ast.nodes(optionNode).value))
            payloadNode = X64ChildAt(ps, optionNode, 0)
            If payloadNode = -1 Then payloadNode = ps.ast.nodes(optionNode).left
            Select Case optionName
            Case "NOWAIT"
                nowaitMode = 1
            Case "TIMEOUT"
                timeoutNode = payloadNode
            Case "RUNPATH"
                runPathNode = payloadNode
            Case "OUTPATH"
                outPathNode = payloadNode
            Case "ERRPATH"
                errPathNode = payloadNode
            Case "OUTVAR"
                If payloadNode <> -1 Then outVarName = Trim(ps.ast.nodes(payloadNode).value)
            Case "ERRVAR"
                If payloadNode <> -1 Then errVarName = Trim(ps.ast.nodes(payloadNode).value)
            Case "CODEVAR"
                If payloadNode <> -1 Then codeVarName = Trim(ps.ast.nodes(payloadNode).value)
            Case Else
                errText = "x64-codegen: unsupported SHELL option " & optionName
                Return 0
            End Select
        End If
        optionNode = ps.ast.nodes(optionNode).nextSibling
    Loop

    If nowaitMode <> 0 And (outVarName <> "" Or errVarName <> "") Then
        errText = "x64-codegen: SHELL NOWAIT cannot use OUTVAR/ERRVAR; use OUTPATH/ERRPATH"
        Return 0
    End If
    If nowaitMode <> 0 And timeoutNode <> -1 Then
        errText = "x64-codegen: SHELL NOWAIT cannot use TIMEOUT"
        Return 0
    End If

    Dim captureType As String
    If outVarName <> "" Then
        captureType = ""
        If X64FindDeclaredTypeName(ps, outVarName, captureType) <> 0 Then
            If X64Upper(Trim(captureType)) <> "STRING" Then
                errText = "x64-codegen: SHELL OUTVAR must be STRING"
                Return 0
            End If
        End If
    End If
    If errVarName <> "" Then
        captureType = ""
        If X64FindDeclaredTypeName(ps, errVarName, captureType) <> 0 Then
            If X64Upper(Trim(captureType)) <> "STRING" Then
                errText = "x64-codegen: SHELL ERRVAR must be STRING"
                Return 0
            End If
        End If
    End If
    If codeVarName <> "" Then
        captureType = ""
        If X64FindDeclaredTypeName(ps, codeVarName, captureType) <> 0 Then
            captureType = X64Upper(Trim(captureType))
            If captureType = "STRING" Or X64TypeToFloatKind(captureType) <> 0 Then
                errText = "x64-codegen: SHELL CODEVAR must be an integer variable"
                Return 0
            End If
        End If
    End If

    Dim baseLabel As String
    baseLabel = "__uxb_shell_" & LTrim(Str(nodeIdx))
    Dim cmdPtrLabel As String
    Dim runPtrLabel As String
    Dim outPathPtrLabel As String
    Dim errPathPtrLabel As String
    Dim timeoutLabel As String
    Dim exitLabel As String
    Dim outBufferLabel As String
    Dim errBufferLabel As String
    cmdPtrLabel = baseLabel & "_cmd"
    runPtrLabel = baseLabel & "_run"
    outPathPtrLabel = baseLabel & "_out_path"
    errPathPtrLabel = baseLabel & "_err_path"
    timeoutLabel = baseLabel & "_timeout"
    exitLabel = baseLabel & "_exit"
    outBufferLabel = baseLabel & "_stdout"
    errBufferLabel = baseLabel & "_stderr"

    X64EmitBss cg, "align 8"
    X64EmitBss cg, cmdPtrLabel & ": resq 1"
    X64EmitBss cg, runPtrLabel & ": resq 1"
    X64EmitBss cg, outPathPtrLabel & ": resq 1"
    X64EmitBss cg, errPathPtrLabel & ": resq 1"
    X64EmitBss cg, timeoutLabel & ": resd 1"
    X64EmitBss cg, exitLabel & ": resd 1"
    X64EmitBss cg, outBufferLabel & ": resb 65536"
    X64EmitBss cg, errBufferLabel & ": resb 65536"

    Dim emptyText As String
    Dim emptyStem As String
    emptyText = ""
    emptyStem = "shell_empty"
    Dim emptyLabel As String
    emptyLabel = X64CreateCStringConstant(cg, emptyText, emptyStem)

    If X64EmitExprToRax(ps, commandNode, cg, errText) = 0 Then Return 0
    X64EmitText cg, "    mov [rel " & cmdPtrLabel & "], rax"

    If runPathNode <> -1 Then
        If X64EmitExprToRax(ps, runPathNode, cg, errText) = 0 Then Return 0
    Else
        X64EmitText cg, "    lea rax, [rel " & emptyLabel & "]"
    End If
    X64EmitText cg, "    mov [rel " & runPtrLabel & "], rax"

    If outPathNode <> -1 Then
        If X64EmitExprToRax(ps, outPathNode, cg, errText) = 0 Then Return 0
    Else
        X64EmitText cg, "    lea rax, [rel " & emptyLabel & "]"
    End If
    X64EmitText cg, "    mov [rel " & outPathPtrLabel & "], rax"

    If errPathNode <> -1 Then
        If X64EmitExprToRax(ps, errPathNode, cg, errText) = 0 Then Return 0
    Else
        X64EmitText cg, "    lea rax, [rel " & emptyLabel & "]"
    End If
    X64EmitText cg, "    mov [rel " & errPathPtrLabel & "], rax"

    If timeoutNode <> -1 Then
        If X64EmitExprToRax(ps, timeoutNode, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    mov dword [rel " & timeoutLabel & "], eax"
    Else
        X64EmitText cg, "    mov dword [rel " & timeoutLabel & "], 0"
    End If
    X64EmitText cg, "    mov dword [rel " & exitLabel & "], 0"

    cg.nativeRuntimeUsed = 1
    If nowaitMode <> 0 Then
        X64EmitComment cg, "SHELL NOWAIT via uxb_runtime.dll"
        X64EmitText cg, "    mov rcx, [rel " & cmdPtrLabel & "]"
        X64EmitText cg, "    mov rdx, [rel " & runPtrLabel & "]"
        X64EmitText cg, "    mov r8, [rel " & outPathPtrLabel & "]"
        X64EmitText cg, "    mov r9, [rel " & errPathPtrLabel & "]"
        X64EmitText cg, "    sub rsp, 48"
        X64EmitText cg, "    lea rax, [rel " & exitLabel & "]"
        X64EmitText cg, "    mov [rsp + 32], rax"
        X64EmitText cg, "    call uxb_shell_start"
        X64EmitText cg, "    add rsp, 48"
        X64EmitNativeRuntimeCheckEax cg
    Else
        X64EmitComment cg, "SHELL capture via uxb_runtime.dll"
        X64EmitText cg, "    mov rcx, [rel " & cmdPtrLabel & "]"
        X64EmitText cg, "    mov rdx, [rel " & runPtrLabel & "]"
        X64EmitText cg, "    mov r8d, dword [rel " & timeoutLabel & "]"
        X64EmitText cg, "    lea r9, [rel " & outBufferLabel & "]"
        X64EmitText cg, "    sub rsp, 64"
        X64EmitText cg, "    mov qword [rsp + 32], 65536"
        X64EmitText cg, "    lea rax, [rel " & errBufferLabel & "]"
        X64EmitText cg, "    mov [rsp + 40], rax"
        X64EmitText cg, "    mov qword [rsp + 48], 65536"
        X64EmitText cg, "    lea rax, [rel " & exitLabel & "]"
        X64EmitText cg, "    mov [rsp + 56], rax"
        X64EmitText cg, "    call uxb_shell_run"
        X64EmitText cg, "    add rsp, 64"
        Dim shellOkLabel As String
        shellOkLabel = X64NextLabel(cg, "shell_ok")
        X64EmitText cg, "    test eax, eax"
        X64EmitText cg, "    jne " & shellOkLabel
        X64EmitText cg, "    cmp dword [rel " & exitLabel & "], 124"
        X64EmitText cg, "    je " & shellOkLabel
        X64EmitNativeRuntimeAbort cg
        X64EmitLabel cg, shellOkLabel

        If outPathNode <> -1 Then
            X64EmitText cg, "    mov rcx, [rel " & outPathPtrLabel & "]"
            X64EmitText cg, "    lea rdx, [rel " & outBufferLabel & "]"
            X64EmitCall0 cg, "uxb_text_file_write"
            X64EmitNativeRuntimeCheckEax cg
        End If
        If errPathNode <> -1 Then
            X64EmitText cg, "    mov rcx, [rel " & errPathPtrLabel & "]"
            X64EmitText cg, "    lea rdx, [rel " & errBufferLabel & "]"
            X64EmitCall0 cg, "uxb_text_file_write"
            X64EmitNativeRuntimeCheckEax cg
        End If
        If outVarName <> "" Then
            X64EmitText cg, "    lea rax, [rel " & outBufferLabel & "]"
            X64EmitStoreVar cg, outVarName
        End If
        If errVarName <> "" Then
            X64EmitText cg, "    lea rax, [rel " & errBufferLabel & "]"
            X64EmitStoreVar cg, errVarName
        End If
    End If

    If codeVarName <> "" Then
        X64EmitText cg, "    movsxd rax, dword [rel " & exitLabel & "]"
        X64EmitStoreVar cg, codeVarName
    End If
    Return 1
End Function

Private Function X64EmitAssertStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim condNode As Integer
    condNode = X64ChildAt(ps, nodeIdx, 0)
    If condNode = -1 Then
        errText = "x64-codegen: ASSERT condition missing"
        Return 0
    End If

    If X64EmitExprToRax(ps, condNode, cg, errText) = 0 Then Return 0

    Dim okLabel As String
    okLabel = X64NextLabel(cg, "assert_ok")
    X64EmitComment cg, "ASSERT"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jne " & okLabel
    X64EmitAssertFailure ps, nodeIdx, cg, errText
    If errText <> "" Then Return 0
    X64EmitLabel cg, okLabel
    Return 1
End Function

Declare Function GenerateRoutineCore(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String, ByVal isFunction As Integer, ByRef routineName As String) As Integer

' S-143: emits one routine with gX64CurrentRoutineNode set (declared-type lookups are scoped to it)
Private Function GenerateRoutine(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String, ByVal isFunction As Integer, ByRef routineName As String) As Integer
    Dim savedRoutineNode As Integer
    savedRoutineNode = gX64CurrentRoutineNode
    gX64CurrentRoutineNode = nodeIdx
    Dim savedResultSlotName As String
    savedResultSlotName = gX64ResultSlotName
    gX64ResultSlotName = ""
    Dim generated As Integer
    generated = GenerateRoutineCore(ps, nodeIdx, cg, errText, isFunction, routineName)
    gX64CurrentRoutineNode = savedRoutineNode
    gX64ResultSlotName = savedResultSlotName
    Return generated
End Function
Private Function GenerateRoutineCore(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String, ByVal isFunction As Integer, ByRef routineName As String) As Integer
    cg.currentRoutineLabel = routineName
    cg.localCount = 0
    cg.localFrameBytes = 0
    cg.paramCount = 0
    cg.currentEpilogLabel = ""
    cg.currentRoutineIsFunction = isFunction

    Dim routineKindUpper As String
    routineKindUpper = X64Upper(Trim(ps.ast.nodes(nodeIdx).kind))

    Dim receiverClassType As String
    receiverClassType = ""

    Dim hiddenReceiverShift As Integer
    hiddenReceiverShift = 0

    If X64ClassMethodIsStatic(ps, nodeIdx) <> 0 Then
        ' S-603: a STATIC method has no hidden receiver (arguments start in rcx) and binds no THIS / ME / SUPER
        hiddenReceiverShift = 0
        receiverClassType = ""
    ElseIf routineKindUpper = "CLASS_METHOD_DECL" Or routineKindUpper = "CLASS_OPERATOR_DECL" Or routineKindUpper = "CLASS_CONSTRUCTOR_DECL" Or routineKindUpper = "CLASS_DESTRUCTOR_DECL" Or routineKindUpper = "CLASS_PROPERTY_GET_STMT" Or routineKindUpper = "CLASS_PROPERTY_SET_STMT" Then
        hiddenReceiverShift = 1
        If X64FindOwningClassName(ps, nodeIdx, receiverClassType) = 0 Then receiverClassType = ""
    Else
        If X64InferRoutineReceiverClass(ps, routineName, receiverClassType) = 0 Then receiverClassType = ""
    End If

    X64RegisterProcedureParams ps, nodeIdx, cg

    If routineKindUpper = "CLASS_PROPERTY_SET_STMT" Then
        Dim propertyType As String
        propertyType = ""
        Dim propertyNode As Integer
        propertyNode = ps.ast.nodes(nodeIdx).parent
        If propertyNode >= 0 And propertyNode < ps.ast.count Then
            propertyType = X64ExtractPropertyType(ps, propertyNode)
        End If

        Dim valueParamOffset As Integer
        valueParamOffset = X64EnsureLocalSlot(cg, "VALUE", 1, 8)
        Dim valueMapErr As String
        If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, "VALUE", valueParamOffset, 1, valueMapErr) = 0 Then
            errText = valueMapErr
            Return 0
        End If
        If cg.paramCount <= 255 Then
            gX64ParamNames(cg.paramCount) = "VALUE"
            gX64ParamTypes(cg.paramCount) = X64Upper(Trim(propertyType))
            cg.paramCount += 1
        End If

        If propertyType <> "" Then X64RegisterVarType cg, "VALUE", propertyType
    End If

    Dim scanNode As Integer
    scanNode = ps.ast.nodes(nodeIdx).firstChild
    Do While scanNode <> -1
        X64CollectRoutineLocals(ps, scanNode, cg)
        scanNode = ps.ast.nodes(scanNode).nextSibling
    Loop

    If receiverClassType <> "" Then
        Dim thisOffsetPre As Integer
        Dim meOffsetPre As Integer
        Dim superOffsetPre As Integer
        thisOffsetPre = X64EnsureLocalSlot(cg, "THIS", 1, 8)
        meOffsetPre = X64EnsureLocalSlot(cg, "ME", 1, 8)
        superOffsetPre = X64EnsureLocalSlot(cg, "SUPER", 1, 8)
        Dim receiverMapErr As String
        If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, "THIS", thisOffsetPre, 1, receiverMapErr) = 0 Then
            errText = receiverMapErr
            Return 0
        End If
        If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, "ME", meOffsetPre, 1, receiverMapErr) = 0 Then
            errText = receiverMapErr
            Return 0
        End If
        If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, "SUPER", superOffsetPre, 1, receiverMapErr) = 0 Then
            errText = receiverMapErr
            Return 0
        End If
        X64RegisterVarType cg, "THIS", receiverClassType
        X64RegisterVarType cg, "ME", receiverClassType
        X64RegisterVarType cg, "SUPER", receiverClassType
    End If

    ' S-599 (2026-10-17): a FUNCTION owns a result variable named after the function (`F = value`). It lives in a frame slot that
    ' starts as zero; when the body falls off its end (RETURN jumps straight to the epilog label instead) the slot is loaded into
    ' rax / xmm0. Until now `F = 5` followed by any other statement returned whatever the last statement left in rax (8, 1 and
    ' 0 instead of 5, 8 and 1.5), and a function that never assigned its result returned a stray last value.
    Dim resultSlotOffset As Integer
    Dim hasResultSlot As Integer
    Dim resultFloatKind As Integer
    hasResultSlot = 0
    resultFloatKind = 0
    If isFunction <> 0 Then
        Dim resultRetType As String
        resultRetType = ""
        Dim resultTypeNode As Integer
        resultTypeNode = ps.ast.nodes(nodeIdx).firstChild
        Do While resultTypeNode <> -1
            If X64Upper(ps.ast.nodes(resultTypeNode).kind) = "RETURN_TYPE" Then
                resultRetType = X64Upper(Trim(ps.ast.nodes(resultTypeNode).value))
                Exit Do
            End If
            resultTypeNode = ps.ast.nodes(resultTypeNode).nextSibling
        Loop
        resultFloatKind = X64TypeToFloatKind(resultRetType)
        If routineKindUpper = "FUNCTION_STMT" Or routineKindUpper = "PIPE_STMT" Then
            Dim resultVarName As String
            resultVarName = X64Upper(Trim(ps.ast.nodes(nodeIdx).value))
            If resultVarName <> "" Then
                resultSlotOffset = X64EnsureLocalSlot(cg, resultVarName, 1, 8)
                Dim resultMapErr As String
                If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, resultVarName, resultSlotOffset, 1, resultMapErr) = 0 Then
                    errText = resultMapErr
                    Return 0
                End If
                If resultRetType <> "" Then X64RegisterVarType cg, resultVarName, resultRetType
                If routineKindUpper = "PIPE_STMT" Then
                    ' PIPE name and TASKOUT are aliases of one invocation-owned
                    ' result, as in MIRNormalizeTaskResultAlias. Last assignment
                    ' wins even when followed by PRINT or nested control flow.
                    X64EnsureLocalSlot cg, UXB_TASK_RESULT_NAME, 1, 8
                    Dim pipeAliasIdx As Integer = X64FindLocal(cg, UXB_TASK_RESULT_NAME)
                    gX64LocalOffsets(pipeAliasIdx) = resultSlotOffset
                    gX64LocalElemBytes(pipeAliasIdx) = 8
                    If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, UXB_TASK_RESULT_NAME, resultSlotOffset, 1, resultMapErr) = 0 Then
                        errText = resultMapErr
                        Return 0
                    End If
                    If resultRetType <> "" Then X64RegisterVarType cg, UXB_TASK_RESULT_NAME, resultRetType
                End If
                hasResultSlot = 1
                gX64ResultSlotName = resultVarName
            End If
        End If
    End If

    Dim frameBytes As Integer
    frameBytes = X64Align16(cg.localFrameBytes)
    cg.currentEpilogLabel = X64NextLabel(cg, "ret")

    X64RegisterRoutineSymbol routineName
    X64EmitText cg, "global " & routineName
    X64EmitLabel cg, routineName
    EmitFunctionProlog cg, frameBytes
    If isFunction <> 0 Then
        X64EmitText cg, "    xor rax, rax"
    End If
    If hasResultSlot <> 0 Then X64EmitText cg, "    mov qword " & X64FormatRbpRef(resultSlotOffset) & ", 0"

    Dim paramRegs(0 To 3) As String
    paramRegs(0) = "rcx"
    paramRegs(1) = "rdx"
    paramRegs(2) = "r8"
    paramRegs(3) = "r9"

    Dim paramXmmRegs(0 To 3) As String
    paramXmmRegs(0) = "xmm0"
    paramXmmRegs(1) = "xmm1"
    paramXmmRegs(2) = "xmm2"
    paramXmmRegs(3) = "xmm3"

    Dim paramIndex As Integer
    For paramIndex = 0 To cg.paramCount - 1
        Dim paramOffset As Integer
        If X64TryFindLocalOffset(cg, gX64ParamNames(paramIndex), paramOffset) <> 0 Then
            Dim incomingIndex As Integer
            incomingIndex = paramIndex + hiddenReceiverShift
            Dim incomingParamType As String
            Dim incomingFloatKind As Integer
            incomingParamType = X64Upper(Trim(gX64ParamTypes(paramIndex)))
            incomingFloatKind = X64TypeToFloatKind(incomingParamType)
            ' An incoming argument register holds whatever width the caller
            ' produced, so a parameter declared narrower than 64 bits is fitted
            ' to its declared type before it becomes this frame's slot.  Without
            ' this, "v AS I8" receiving 255 reads back as 255 here while every
            ' other engine yields -1.  r10 is used rather than rax so the
            ' function's default return value set above stays intact.
            If incomingIndex <= 3 Then
                If incomingFloatKind = UXF_F32 Then
                    X64EmitText cg, "    movss " & X64FormatRbpRef(paramOffset) & ", " & paramXmmRegs(incomingIndex)
                ElseIf incomingFloatKind = UXF_F64 Then
                    X64EmitText cg, "    movsd " & X64FormatRbpRef(paramOffset) & ", " & paramXmmRegs(incomingIndex)
                Else
                    X64EmitText cg, "    mov r10, " & paramRegs(incomingIndex)
                    X64TryEmitNarrowRegToType cg, "r10", incomingParamType
                    X64EmitText cg, "    mov " & X64FormatRbpRef(paramOffset) & ", r10"
                End If
            Else
                Dim stackOffset As Integer
                stackOffset = 48 + ((incomingIndex - 4) * 8)
                If incomingFloatKind = UXF_F32 Then
                    X64EmitText cg, "    movss xmm0, dword [rbp + " & X64ToStr(stackOffset) & "]"
                    X64EmitText cg, "    movss " & X64FormatRbpRef(paramOffset) & ", xmm0"
                ElseIf incomingFloatKind = UXF_F64 Then
                    X64EmitText cg, "    movsd xmm0, qword [rbp + " & X64ToStr(stackOffset) & "]"
                    X64EmitText cg, "    movsd " & X64FormatRbpRef(paramOffset) & ", xmm0"
                Else
                    X64EmitText cg, "    mov r10, [rbp + " & X64ToStr(stackOffset) & "]"
                    X64TryEmitNarrowRegToType cg, "r10", incomingParamType
                    X64EmitText cg, "    mov " & X64FormatRbpRef(paramOffset) & ", r10"
                End If
            End If
        End If
    Next paramIndex

    If receiverClassType <> "" Then
        Dim thisOffset As Integer
        Dim meOffset As Integer
        Dim superOffset As Integer
        If X64TryFindLocalOffset(cg, "THIS", thisOffset) <> 0 Then X64EmitText cg, "    mov " & X64FormatRbpRef(thisOffset) & ", rcx"
        If X64TryFindLocalOffset(cg, "ME", meOffset) <> 0 Then X64EmitText cg, "    mov " & X64FormatRbpRef(meOffset) & ", rcx"
        If X64TryFindLocalOffset(cg, "SUPER", superOffset) <> 0 Then X64EmitText cg, "    mov " & X64FormatRbpRef(superOffset) & ", rcx"
    End If

    Dim body As Integer
    body = ps.ast.nodes(nodeIdx).firstChild
    Do While body <> -1
        Dim k As String
        k = X64Upper(ps.ast.nodes(body).kind)

        If k = "PARAM_DECL" Or k = "RETURN_TYPE" Then
            ' metadata node
        ElseIf k = "DIM_STMT" Or k = "DIM" Or k = "REDIM_STMT" Or k = "REDIM" Or _
               k = "PRINT_STMT" Or k = "PRINT" Or k = "CALL_STMT" Or k = "CALL_EXPR" Or k = "CALL" Or _
               k = "CALL_DLL_STMT" Or k = "CALL_API_STMT" Then
            If GenerateStatement(ps, body, cg, errText) = 0 Then Return 0
        Else
            If X64EmitNode(ps, body, cg, errText) = 0 Then Return 0
        End If

        body = ps.ast.nodes(body).nextSibling
    Loop

    If isFunction <> 0 Then
        ' the body fell off its end (every RETURN jumps to the epilog label below, past this): the result is the result variable,
        ' or the typed zero when the routine has none (a METHOD, or a FUNCTION that never assigned it)
        If resultFloatKind = UXF_F32 Then
            If hasResultSlot <> 0 Then X64EmitText cg, "    movss xmm0, dword " & X64FormatRbpRef(resultSlotOffset) Else X64EmitText cg, "    xorps xmm0, xmm0"
        ElseIf resultFloatKind = UXF_F64 Then
            If hasResultSlot <> 0 Then X64EmitText cg, "    movsd xmm0, qword " & X64FormatRbpRef(resultSlotOffset) Else X64EmitText cg, "    xorps xmm0, xmm0"
        ElseIf hasResultSlot <> 0 Then
            X64EmitText cg, "    mov rax, " & X64FormatRbpRef(resultSlotOffset)
        Else
            X64EmitText cg, "    xor rax, rax"
        End If
    End If

    X64EmitLabel cg, cg.currentEpilogLabel
    X64EmitSecStackWipe cg
    EmitFunctionEpilog cg

    cg.currentRoutineLabel = ""
    cg.localCount = 0
    cg.localFrameBytes = 0
    cg.paramCount = 0
    cg.currentEpilogLabel = ""
    cg.currentRoutineIsFunction = 0
    For paramIndex = 0 To 255
        gX64ParamTypes(paramIndex) = ""
    Next paramIndex
    Return 1
End Function

Private Function GenerateStatement(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "x64-codegen: invalid statement node index " & LTrim(Str(nodeIdx))
        Return 0
    End If
    gX64LastEmitNode = nodeIdx

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)

    Select Case nodeKind
    Case "DIM_STMT", "DIM", "REDIM_STMT", "REDIM"
        Return GenerateLocalDim(ps, nodeIdx, cg, errText)
    Case "DEFTYPE_STMT", "SETSTRINGSIZE_STMT"
        X64EmitComment cg, "stmt: " & nodeKind & " (metadata-only for x64 emit)"
        Return 1
    Case "PRINT_STMT", "PRINT"
        Return GeneratePrint(ps, nodeIdx, cg, errText)
    Case "CLS_STMT"
        Return X64EmitClsStmt(ps, nodeIdx, cg, errText)
    Case "LOCATE_STMT"
        Return X64EmitLocateStmt(ps, nodeIdx, cg, errText)
    Case "COLOR_STMT"
        Return X64EmitColorStmt(ps, nodeIdx, cg, errText)
    Case "RANDOMIZE_STMT"
        Return X64EmitRandomizeStmt(ps, nodeIdx, cg, errText)
    Case "INPUT_STMT"
        Return X64EmitInputStmt(ps, nodeIdx, cg, errText)
    Case "INPUT_FILE_STMT"
        Return X64EmitInputFileStmt(ps, nodeIdx, cg, errText)
    Case "OPEN_STMT"
        Return X64EmitOpenStmt(ps, nodeIdx, cg, errText)
    Case "CLOSE_STMT"
        Return X64EmitCloseStmt(ps, nodeIdx, cg, errText)
    Case "GET_STMT"
        Return X64EmitGetStmt(ps, nodeIdx, cg, errText)
    Case "PUT_STMT"
        Return X64EmitPutStmt(ps, nodeIdx, cg, errText)
    Case "SEEK_STMT"
        Return X64EmitSeekStmt(ps, nodeIdx, cg, errText)
    Case "POKEB_STMT"
        Return X64EmitPokeStmt(ps, nodeIdx, cg, errText, "__uxb_mem_storeb_mode", "POKEB")
    Case "POKEW_STMT"
        Return X64EmitPokeStmt(ps, nodeIdx, cg, errText, "__uxb_mem_storew_mode", "POKEW")
    Case "POKED_STMT"
        Return X64EmitPokeStmt(ps, nodeIdx, cg, errText, "__uxb_mem_stored_mode", "POKED")
    Case "POKEQ_STMT"
        Return X64EmitPokeStmt(ps, nodeIdx, cg, errText, "__uxb_mem_storeq_mode", "POKEQ")
    Case "POKES_STMT"
        Return X64EmitPokesStmt(ps, nodeIdx, cg, errText)
    Case "MEMCOPYB_STMT"
        Return X64EmitMemCopyStmt(ps, nodeIdx, cg, errText, "__uxb_mem_copy_mode", "MEMCOPYB")
    Case "MEMCOPYW_STMT"
        Return X64EmitMemCopyStmt(ps, nodeIdx, cg, errText, "__uxb_mem_copy_mode", "MEMCOPYW")
    Case "MEMCOPYD_STMT"
        Return X64EmitMemCopyStmt(ps, nodeIdx, cg, errText, "__uxb_mem_copy_mode", "MEMCOPYD")
    Case "MEMCOPYQ_STMT"
        Return X64EmitMemCopyStmt(ps, nodeIdx, cg, errText, "__uxb_mem_copy_mode", "MEMCOPYQ")
    Case "MEMFILLB_STMT"
        Return X64EmitMemFillStmt(ps, nodeIdx, cg, errText, "__uxb_mem_fill_mode", "MEMFILLB")
    Case "MEMFILLW_STMT"
        Return X64EmitMemFillStmt(ps, nodeIdx, cg, errText, "__uxb_mem_fill_mode", "MEMFILLW")
    Case "MEMFILLD_STMT"
        Return X64EmitMemFillStmt(ps, nodeIdx, cg, errText, "__uxb_mem_fill_mode", "MEMFILLD")
    Case "MEMFILLQ_STMT"
        Return X64EmitMemFillStmt(ps, nodeIdx, cg, errText, "__uxb_mem_fill_mode", "MEMFILLQ")
    Case "SETNEWOFFSET_STMT"
        Return X64EmitSetNewOffsetStmt(ps, nodeIdx, cg, errText)
    Case "EVENT_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT", "SLOT_STMT", "SLOT_TABLE_STMT", "SLOT_BIND_ENTRY", "SLOT_CONTROL_STMT", "TRIGGER_STMT"
        Return X64EmitSlotLaneStmt(ps, nodeIdx, cg, errText)
    Case "SHELL_STMT"
        Return X64EmitShellStmt(ps, nodeIdx, cg, errText)
    Case "ASSERT_STMT"
        Return X64EmitAssertStmt(ps, nodeIdx, cg, errText)
    Case "TRY_STMT"
        Return X64EmitTryStmt(ps, nodeIdx, cg, errText)
    Case "THROW_STMT"
        Return X64EmitThrowStmt(ps, nodeIdx, cg, errText)
    Case "CALL_DLL_STMT", "CALL_API_STMT"
        ' X64_FFI_CODEGEN_RESOLVER_SYNC_FIX_20260712:
        ' Direct lowered FFI statements must emit through the same stub numbering path
        ' as CALL(DLL) expressions.  Without this, the resolver artifact can contain
        ' one more symptr than program.asm, producing undefined __uxb_ffi_symptr_N.
        Return X64EmitDllCallNode(ps, nodeIdx, cg, errText)
    Case "CALL_STMT", "CALL_EXPR", "CALL"
        Return GenerateCall(ps, nodeIdx, cg, errText)
    Case "IF_STMT", "IF"
        Return GenerateIf(ps, nodeIdx, cg, errText)
    Case "SELECT_STMT"
        Return X64EmitSelectStmt(ps, nodeIdx, cg, errText)
    Case "FOR_STMT", "FOR"
        Return GenerateFor(ps, nodeIdx, cg, errText)
    Case "FOR_EACH_STMT"
        Return X64EmitForEachStmt(ps, nodeIdx, cg, errText)
    Case "DO_STMT"
        Return X64EmitDoStmt(ps, nodeIdx, cg, errText)
    Case "DO_EACH_STMT"
        Return X64EmitDoEachStmt(ps, nodeIdx, cg, errText)
    Case "LABEL_STMT"
        Return X64EmitLabelStmt(ps, nodeIdx, cg, errText)
    Case "GOTO_STMT"
        Return X64EmitGotoStmt(ps, nodeIdx, cg, errText)
    Case "GOSUB_STMT"
        Return X64EmitGosubStmt(ps, nodeIdx, cg, errText)
    Case "EXIT_STMT", "CONTINUE_STMT"
        Return X64EmitExitStmt(ps, nodeIdx, cg, errText)
    Case Else
        errText = "x64-codegen: unsupported statement in GenerateStatement: " & ps.ast.nodes(nodeIdx).kind
        Return 0
    End Select
End Function

Private Function GenerateLocalDim(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: DIM"
    Return X64EmitDimStmt(ps, nodeIdx, cg, errText)
End Function

Private Function GeneratePrint(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: PRINT"
    Return X64EmitPrintStmt(ps, nodeIdx, cg, errText)
End Function

#include once "stmt_emitters/x64_codegen_stmt_io_console.fbs"

#include once "stmt_emitters/x64_codegen_stmt_try.fbs"

Private Function X64EmitConditionToRax(ByRef ps As ParseState, ByVal expression As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim floatKind As Integer = X64InferFloatKindOfExpr(ps, expression, cg)
    If floatKind = UXF_F32 Or floatKind = UXF_F64 Then
        If X64SyncEmitArgument(ps, expression, cg, UXF_F64, errText) = 0 Then Return 0
        X64EmitText cg, "    xorpd xmm1, xmm1"
        X64EmitText cg, "    ucomisd xmm0, xmm1"
        X64EmitText cg, "    setne al"
        X64EmitText cg, "    setp dl"
        X64EmitText cg, "    or al, dl"
        X64EmitText cg, "    movzx rax, al"
        Return 1
    End If
    Return X64SyncEmitArgument(ps, expression, cg, 0, errText)
End Function

#include once "stmt_emitters/x64_codegen_stmt_flow_core.fbs"

#include once "stmt_emitters/x64_codegen_stmt_dispatch.fbs"

Private Function X64EmitDeleteStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim targetNode As Integer
    targetNode = ps.ast.nodes(nodeIdx).left
    If targetNode = -1 Then targetNode = X64ChildAt(ps, nodeIdx, 0)
    If targetNode = -1 Then
        errText = "x64-codegen: DELETE target missing"
        Return 0
    End If

    Dim targetName As String
    Dim targetKind As String
    targetKind = X64Upper(ps.ast.nodes(targetNode).kind)
    If targetKind = "IDENT" Or targetKind = "IDENTIFIER" Then
        targetName = Trim(ps.ast.nodes(targetNode).value)
    End If

    If X64EmitExprToRax(ps, targetNode, cg, errText) = 0 Then Return 0

    ' S-574 (2026-10-17): the destructor chain is not taken from the DECLARED type of the variable any more (a base-typed variable holding a
    ' derived object skipped the derived destructor, S-486). __uxb_runtime_destroy finds the real class from the object's header, runs its
    ' destructor and then its bases' (once: a header that is already 0 means "destroyed"), and marks the object dead instead of freeing it.
    Dim rootClassCount As Integer
    rootClassCount = 0
    Dim rootClassNode As Integer
    rootClassNode = ps.ast.nodes(ps.rootNode).firstChild
    Do While rootClassNode <> -1
        If X64Upper(ps.ast.nodes(rootClassNode).kind) = "CLASS_STMT" Then rootClassCount += 1
        rootClassNode = ps.ast.nodes(rootClassNode).nextSibling
    Loop
    If rootClassCount > 0 Then
        ' Destructors may use the shared I/O scratch slot while printing, so the routine keeps the object in its own frame.
        X64EmitText cg, "    mov rcx, rax"
        X64EmitText cg, "    sub rsp, 32"
        X64EmitText cg, "    call __uxb_runtime_destroy"
        X64EmitText cg, "    add rsp, 32"
    End If

    If targetName <> "" Then
        X64EmitText cg, "    xor rax, rax"
        X64EmitStoreVar cg, targetName
    End If

    Return 1
End Function

Private Function X64EmitConstStmtMetadata(ByRef ps As ParseState, ByVal constStmtNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim decl As Integer
    decl = ps.ast.nodes(constStmtNode).firstChild
    Do While decl <> -1
        If X64Upper(ps.ast.nodes(decl).kind) = "CONST_DECL" Then
            Dim constName As String
            constName = Trim(ps.ast.nodes(decl).value)
            If constName <> "" Then
                Dim constLabelBase As String
                constLabelBase = "__uxb_meta_const_" & X64SanitizeSymbol(LCase(constName)) & "_" & X64ToStr(decl)

                Dim constValue As LongInt
                Dim constKnown As Integer
                constKnown = X64TryResolveConstInt(ps, constName, constValue)
                If constKnown = 0 Then constValue = 0

                X64EmitData cg, constLabelBase & "_known: dq " & X64ToStr(constKnown)
                X64EmitData cg, constLabelBase & "_value_i64: dq " & LTrim(Str(constValue))
            End If
        End If
        decl = ps.ast.nodes(decl).nextSibling
    Loop

    Return 1
End Function

Private Function X64EmitTypeDeclMetadata(ByRef ps As ParseState, ByVal typeNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim typeName As String
    typeName = Trim(ps.ast.nodes(typeNode).value)
    If typeName = "" Then Return 1

    Dim typeSize As Integer
    Dim typeErr As String
    If TypeLayoutSizeOf(ps, typeName, typeSize, typeErr) = 0 Then
        errText = "x64-codegen: type metadata size resolve failed for " & typeName & " | " & typeErr
        Return 0
    End If

    Dim typeBase As String
    typeBase = "__uxb_meta_type_" & X64SanitizeSymbol(LCase(typeName))
    X64EmitData cg, typeBase & "_size: dq " & X64ToStr(typeSize)

    Dim fieldCount As Integer
    fieldCount = 0

    Dim fieldNode As Integer
    fieldNode = ps.ast.nodes(typeNode).firstChild
    Do While fieldNode <> -1
        If X64Upper(ps.ast.nodes(fieldNode).kind) = "TYPE_FIELD" Then
            Dim fieldName As String
            fieldName = Trim(ps.ast.nodes(fieldNode).value)
            If fieldName <> "" Then
                Dim fieldType As String
                fieldType = ""
                Dim fieldTypeNode As Integer
                fieldTypeNode = X64FindChildByKind(ps, fieldNode, "TYPE_REF")
                If fieldTypeNode <> -1 Then fieldType = Trim(ps.ast.nodes(fieldTypeNode).value)

                Dim fieldSize As Integer
                fieldSize = X64GetElemBytesForType(ps, fieldType)

                Dim fieldOffset As Integer
                Dim offErr As String
                If TypeLayoutOffsetOf(ps, typeName, fieldName, fieldOffset, offErr) = 0 Then
                    errText = "x64-codegen: type metadata offset resolve failed for " & typeName & "." & fieldName & " | " & offErr
                    Return 0
                End If

                Dim fieldBase As String
                fieldBase = typeBase & "_field_" & X64SanitizeSymbol(LCase(fieldName))
                X64EmitData cg, fieldBase & "_offset: dq " & X64ToStr(fieldOffset)
                X64EmitData cg, fieldBase & "_size: dq " & X64ToStr(fieldSize)
                fieldCount += 1
            End If
        End If
        fieldNode = ps.ast.nodes(fieldNode).nextSibling
    Loop

    X64EmitData cg, typeBase & "_field_count: dq " & X64ToStr(fieldCount)
    Return 1
End Function

Private Function X64EmitClassDeclMetadata(ByRef ps As ParseState, ByVal classNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim className As String
    className = Trim(ps.ast.nodes(classNode).value)
    If className = "" Then Return 1

    Dim classSize As Integer
    Dim classErr As String
    If TypeLayoutSizeOf(ps, className, classSize, classErr) = 0 Then
        errText = "x64-codegen: class metadata size resolve failed for " & className & " | " & classErr
        Return 0
    End If

    Dim classBase As String
    classBase = "__uxb_meta_class_" & X64SanitizeSymbol(LCase(className))
    X64EmitData cg, classBase & "_size: dq " & X64ToStr(classSize)

    Dim methodCount As Integer
    Dim propertyCount As Integer
    Dim fieldCount As Integer
    methodCount = 0
    propertyCount = 0
    fieldCount = 0

    Dim member As Integer
    member = ps.ast.nodes(classNode).firstChild
    Do While member <> -1
        Dim memberKind As String
        memberKind = X64Upper(ps.ast.nodes(member).kind)

        If memberKind = "CLASS_FIELD" Then
            Dim fieldName As String
            fieldName = Trim(ps.ast.nodes(member).value)
            If fieldName <> "" Then
                Dim fieldType As String
                fieldType = ""
                Dim typeNode As Integer
                typeNode = X64FindChildByKind(ps, member, "TYPE_REF")
                If typeNode <> -1 Then fieldType = Trim(ps.ast.nodes(typeNode).value)

                Dim fieldSize As Integer
                fieldSize = X64GetElemBytesForType(ps, fieldType)

                Dim fieldOffset As Integer
                Dim offErr As String
                If TypeLayoutOffsetOf(ps, className, fieldName, fieldOffset, offErr) = 0 Then
                    errText = "x64-codegen: class metadata offset resolve failed for " & className & "." & fieldName & " | " & offErr
                    Return 0
                End If

                Dim fieldBase As String
                fieldBase = classBase & "_field_" & X64SanitizeSymbol(LCase(fieldName))
                X64EmitData cg, fieldBase & "_offset: dq " & X64ToStr(fieldOffset)
                X64EmitData cg, fieldBase & "_size: dq " & X64ToStr(fieldSize)
                fieldCount += 1
            End If
        ElseIf memberKind = "CLASS_PROPERTY_DECL" Then
            propertyCount += 1
        ElseIf memberKind = "CLASS_METHOD_DECL" Or memberKind = "CLASS_OPERATOR_DECL" Or memberKind = "CLASS_CONSTRUCTOR_DECL" Or memberKind = "CLASS_DESTRUCTOR_DECL" Then
            methodCount += 1
        End If

        member = ps.ast.nodes(member).nextSibling
    Loop

    X64EmitData cg, classBase & "_field_count: dq " & X64ToStr(fieldCount)
    X64EmitData cg, classBase & "_method_count: dq " & X64ToStr(methodCount)
    X64EmitData cg, classBase & "_property_count: dq " & X64ToStr(propertyCount)
    Return 1
End Function

Private Function X64EmitDeclarationMetadata(ByRef ps As ParseState, ByVal rootNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitData cg, "__uxb_meta_decl_schema_v1: dq 1"

    Dim ch As Integer
    ch = ps.ast.nodes(rootNode).firstChild
    Do While ch <> -1
        Dim kindText As String
        kindText = X64Upper(ps.ast.nodes(ch).kind)
        Select Case kindText
        Case "CONST_STMT"
            If X64EmitConstStmtMetadata(ps, ch, cg, errText) = 0 Then Return 0
        Case "TYPE_STMT"
            If X64EmitTypeDeclMetadata(ps, ch, cg, errText) = 0 Then Return 0
        Case "CLASS_STMT"
            If X64EmitClassDeclMetadata(ps, ch, cg, errText) = 0 Then Return 0
        End Select
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Function X64EmitRuntimeInstanceOfSupport(ByRef ps As ParseState, ByVal rootNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If rootNode < 0 Or rootNode >= ps.ast.count Then Return 1

    Dim classCount As Integer
    classCount = 0

    Dim ch As Integer
    ch = ps.ast.nodes(rootNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_STMT" Then classCount += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If classCount <= 0 Then Return 1

    X64EmitText cg, "__uxb_runtime_instanceof:"
    X64EmitText cg, "    test rcx, rcx"
    X64EmitText cg, "    jz .uxb_inst_false"
    X64EmitText cg, "    cmp rdx, 1"
    X64EmitText cg, "    jl .uxb_inst_false"
    X64EmitText cg, "    mov r8, [rcx]"
    X64EmitText cg, "    xor rax, rax"
    X64EmitText cg, "    mov r10, [rel __uxb_runtime_class_count]"
    X64EmitText cg, "    lea r9, [rel __uxb_runtime_class_vtables]"
    X64EmitText cg, ".uxb_inst_find:"
    X64EmitText cg, "    cmp rax, r10"
    X64EmitText cg, "    jge .uxb_inst_false"
    X64EmitText cg, "    mov r11, [r9 + rax*8]"
    X64EmitText cg, "    cmp r8, r11"
    X64EmitText cg, "    je .uxb_inst_found"
    X64EmitText cg, "    inc rax"
    X64EmitText cg, "    jmp .uxb_inst_find"
    X64EmitText cg, ".uxb_inst_found:"
    X64EmitText cg, "    inc rax"
    X64EmitText cg, ".uxb_inst_chain:"
    X64EmitText cg, "    cmp rax, rdx"
    X64EmitText cg, "    je .uxb_inst_true"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .uxb_inst_false"
    X64EmitText cg, "    dec rax"
    X64EmitText cg, "    lea r9, [rel __uxb_runtime_class_base_ids]"
    X64EmitText cg, "    mov rax, [r9 + rax*8]"
    X64EmitText cg, "    jmp .uxb_inst_chain"
    X64EmitText cg, ".uxb_inst_true:"
    X64EmitText cg, "    mov rax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".uxb_inst_false:"
    X64EmitText cg, "    xor rax, rax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    ' S-574 (2026-10-17): DELETE destroys an object by its REAL class. rcx = the object; an empty reference, a header that is already 0 (an object
    ' DELETE has destroyed) and a header that names no class are left alone, otherwise the class whose vtable the header holds runs its destructor
    ' (the entry of __uxb_runtime_class_dtors, 0 = the class has none), then its base class, up to the root; finally the header is zeroed and the
    ' block KEPT (it used to be freed: an alias then read recycled memory and a second DELETE freed it twice).
    X64EmitText cg, "__uxb_runtime_destroy:"
    X64EmitText cg, "    push rbx"
    X64EmitText cg, "    push rsi"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    mov rbx, rcx"
    X64EmitText cg, "    test rbx, rbx"
    X64EmitText cg, "    jz .uxb_dst_done"
    X64EmitText cg, "    mov r8, [rbx]"
    ' S-616: while the chain runs the header holds 1 (swapped in atomically from the class's vtable label); 0 = destroyed, 1 = being destroyed -
    ' a DELETE of the same object from inside its own destructor (through a global alias) then does nothing instead of recursing without end.
    X64EmitText cg, "    cmp r8, 1"
    X64EmitText cg, "    jbe .uxb_dst_done"
    X64EmitText cg, "    mov rax, r8"
    X64EmitText cg, "    mov ecx, 1"
    X64EmitText cg, "    lock cmpxchg [rbx], rcx"
    X64EmitText cg, "    jne .uxb_dst_done"
    X64EmitText cg, "    xor rsi, rsi"
    X64EmitText cg, "    mov r10, [rel __uxb_runtime_class_count]"
    X64EmitText cg, "    lea r9, [rel __uxb_runtime_class_vtables]"
    X64EmitText cg, ".uxb_dst_find:"
    X64EmitText cg, "    cmp rsi, r10"
    X64EmitText cg, "    jge .uxb_dst_mark"
    X64EmitText cg, "    cmp r8, [r9 + rsi*8]"
    X64EmitText cg, "    je .uxb_dst_chain"
    X64EmitText cg, "    inc rsi"
    X64EmitText cg, "    jmp .uxb_dst_find"
    X64EmitText cg, ".uxb_dst_chain:"
    X64EmitText cg, "    lea r9, [rel __uxb_runtime_class_dtors]"
    X64EmitText cg, "    mov rax, [r9 + rsi*8]"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .uxb_dst_next"
    X64EmitText cg, "    mov rcx, rbx"
    X64EmitText cg, "    call rax"
    X64EmitText cg, ".uxb_dst_next:"
    X64EmitText cg, "    lea r9, [rel __uxb_runtime_class_base_ids]"
    X64EmitText cg, "    mov rsi, [r9 + rsi*8]"
    X64EmitText cg, "    test rsi, rsi"
    X64EmitText cg, "    jz .uxb_dst_mark"
    X64EmitText cg, "    dec rsi"
    X64EmitText cg, "    jmp .uxb_dst_chain"
    X64EmitText cg, ".uxb_dst_mark:"
    X64EmitText cg, "    mov qword [rbx], 0"
    X64EmitText cg, ".uxb_dst_done:"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    pop rsi"
    X64EmitText cg, "    pop rbx"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitData cg, "__uxb_runtime_class_count: dq " & X64ToStr(classCount)

    X64EmitData cg, "__uxb_runtime_class_dtors:"
    ch = ps.ast.nodes(rootNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_STMT" Then
            Dim dtorClassName As String
            dtorClassName = X64Upper(Trim(ps.ast.nodes(ch).value))
            ' The routine signatures are registered AFTER this support code is emitted, so the destructor is looked up in the AST itself: a class
            ' that declares a DESTRUCTOR has a <CLASS>_DTOR routine (its label is the symbol found here), a class without one gets 0 (nothing to run).
            Dim dtorExactSymbol As String
            If X64FindRoutineSymbolName(ps, dtorClassName & "_DTOR", dtorExactSymbol) <> 0 Then
                X64EmitData cg, "dq " & dtorExactSymbol
            Else
                X64EmitData cg, "dq 0"
            End If
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    X64EmitData cg, "__uxb_runtime_class_vtables:"
    ch = ps.ast.nodes(rootNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_STMT" Then
            Dim className As String
            className = X64Upper(Trim(ps.ast.nodes(ch).value))
            X64EmitData cg, "dq " & X64ClassVTableLabel(className)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    X64EmitData cg, "__uxb_runtime_class_base_ids:"
    ch = ps.ast.nodes(rootNode).firstChild
    Do While ch <> -1
        If X64Upper(ps.ast.nodes(ch).kind) = "CLASS_STMT" Then
            Dim currentClass As String
            currentClass = X64Upper(Trim(ps.ast.nodes(ch).value))

            Dim baseType As String
            Dim baseId As Integer
            baseId = 0
            baseType = ""
            If X64GetClassBaseTypeName(ps, currentClass, baseType) <> 0 Then
                baseId = X64ClassTypeId(ps, baseType)
            End If
            X64EmitData cg, "dq " & X64ToStr(baseId)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Sub X64RegisterContainerRoutineSignatures(ByRef ps As ParseState, ByVal containerNode As Integer, ByRef cg As X64CodegenContext, ByVal parentPrefix As String = "")
    If containerNode < 0 Or containerNode >= ps.ast.count Then Exit Sub

    Dim containerPrefix As String
    containerPrefix = X64Upper(Trim(parentPrefix))
    Dim localContainerName As String
    localContainerName = X64Upper(Trim(ps.ast.nodes(containerNode).value))
    If localContainerName <> "" Then
        If containerPrefix = "" Then containerPrefix = localContainerName Else containerPrefix &= "_" & localContainerName
    End If

    Dim ch As Integer
    ch = ps.ast.nodes(containerNode).firstChild
    Do While ch <> -1
        Dim k As String
        k = X64Upper(ps.ast.nodes(ch).kind)
        Select Case k
        Case "SUB_STMT", "FUNCTION_STMT"
            Dim qualifiedRoutineName As String
            qualifiedRoutineName = LCase(X64SanitizeSymbol(containerPrefix & "_" & Trim(ps.ast.nodes(ch).value)))
            X64RegisterRoutineSignatureAs ps, ch, cg, qualifiedRoutineName
        Case "NAMESPACE_STMT", "MODULE_STMT"
            X64RegisterContainerRoutineSignatures ps, ch, cg, containerPrefix
        End Select
        ch = ps.ast.nodes(ch).nextSibling
    Loop
End Sub

' S-531: the variables of a NAMESPACE / MODULE are program-wide globals under their qualified store name ("NS.NV", see
' parser_namespace_vars.fbs: the declaration and every access already carry it). The legacy emitter treated the whole
' container as compile-time only, so the variable never became a global: inside the container's own routines the name was
' not known and turned into an uninitialised frame slot of that routine (a read returned stack garbage, a write was lost
' when the routine returned; `adet = n` in one SUB was invisible to the next). Their declarations are emitted here, in
' source order, at main level - the same place the other engines run them.
Private Function X64EmitContainerVariables(ByRef ps As ParseState, ByVal containerNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If containerNode < 0 Or containerNode >= ps.ast.count Then Return 1
    Dim ch As Integer = ps.ast.nodes(containerNode).firstChild
    Do While ch <> -1
        Select Case X64Upper(ps.ast.nodes(ch).kind)
        Case "DIM_STMT", "DIM"
            If X64EmitNode(ps, ch, cg, errText) = 0 Then Return 0
        Case "NAMESPACE_STMT", "MODULE_STMT"
            If X64EmitContainerVariables(ps, ch, cg, errText) = 0 Then Return 0
        End Select
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 1
End Function

Private Function X64EmitProgramRuntimeChildren(ByRef ps As ParseState, ByVal containerNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If containerNode < 0 Or containerNode >= ps.ast.count Then Return 1

    Dim ch As Integer
    ch = ps.ast.nodes(containerNode).firstChild
    Do While ch <> -1
        Dim k As String
        k = X64Upper(ps.ast.nodes(ch).kind)
        Select Case k
        Case "NAMESPACE_STMT", "MODULE_STMT"
            If X64EmitContainerVariables(ps, ch, cg, errText) = 0 Then Return 0
        Case "SUB_STMT", "FUNCTION_STMT", "CLASS_STMT", "TYPE_STMT", "INTERFACE_STMT", _
             "DECLARE_SUB_STMT", "DECLARE_FUNCTION_STMT", "IMPORT_STMT", "INCLUDE_STMT", _
             "USING_STMT", "ALIAS_STMT", "CONST_STMT"
            ' declaration or compile-time container: not executable in main
        Case "MAIN_STMT"
            If X64EmitProgramRuntimeChildren(ps, ch, cg, errText) = 0 Then Return 0
        Case Else
            If X64EmitNode(ps, ch, cg, errText) = 0 Then Return 0
        End Select
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 1
End Function

Private Function X64EmitContainerRoutines(ByRef ps As ParseState, ByVal containerNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String, ByVal parentPrefix As String = "") As Integer
    If containerNode < 0 Or containerNode >= ps.ast.count Then Return 1

    Dim containerPrefix As String
    containerPrefix = X64Upper(Trim(parentPrefix))
    Dim localContainerName As String
    localContainerName = X64Upper(Trim(ps.ast.nodes(containerNode).value))
    If localContainerName <> "" Then
        If containerPrefix = "" Then containerPrefix = localContainerName Else containerPrefix &= "_" & localContainerName
    End If

    Dim ch As Integer
    ch = ps.ast.nodes(containerNode).firstChild
    Do While ch <> -1
        Dim k As String
        k = X64Upper(ps.ast.nodes(ch).kind)
        Select Case k
        Case "SUB_STMT", "FUNCTION_STMT"
            Dim qualifiedRoutineName As String
            qualifiedRoutineName = LCase(X64SanitizeSymbol(containerPrefix & "_" & Trim(ps.ast.nodes(ch).value)))
            gX64CurrentNamespace = localContainerName
            If GenerateRoutine(ps, ch, cg, errText, IIf(k = "FUNCTION_STMT", 1, 0), qualifiedRoutineName) = 0 Then gX64CurrentNamespace = "": Return 0
            gX64CurrentNamespace = ""
            X64EmitText cg, ""
        Case "NAMESPACE_STMT", "MODULE_STMT"
            If X64EmitContainerRoutines(ps, ch, cg, errText, containerPrefix) = 0 Then Return 0
        End Select
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 1
End Function

Private Function X64EmitProgram(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If UXBTaskEnsureSyncAnalysis(ps, errText) = 0 Then Return 0
    X64EmitText cg, "bits 64"
    X64EmitText cg, "default rel"
    X64EmitText cg, "section .text"
    X64EmitText cg, "extern printf"
    X64EmitText cg, "extern scanf"
    X64EmitText cg, "extern sprintf"
    X64EmitText cg, "extern atoi"
    X64EmitText cg, "extern atof"
    X64EmitText cg, "extern exit"
    X64EmitText cg, "extern calloc"
    X64EmitText cg, "extern free"
    X64EmitText cg, "extern fopen"
    X64EmitText cg, "extern fclose"
    X64EmitText cg, "extern fflush"
    X64EmitText cg, "extern fread"
    X64EmitText cg, "extern fwrite"
    X64EmitText cg, "extern fscanf"
    X64EmitText cg, "extern fgets"
    X64EmitText cg, "extern __uxb_rt_hex"
    X64EmitText cg, "extern __uxb_rt_oct"
    X64EmitText cg, "extern __uxb_rt_bin"
    X64EmitText cg, "extern uxb_f80_zero"
    X64EmitText cg, "extern uxb_f80_from_str"
    X64EmitText cg, "extern uxb_f80_to_str"
    X64EmitText cg, "extern uxb_f80_copy"
    X64EmitText cg, "extern uxb_f80_add"
    X64EmitText cg, "extern uxb_f80_sub"
    X64EmitText cg, "extern uxb_f80_mul"
    X64EmitText cg, "extern uxb_f80_div"
    X64EmitText cg, "extern uxb_f80_cmp"
    X64EmitText cg, "extern uxb_f128_zero"
    X64EmitText cg, "extern uxb_f128_from_str"
    X64EmitText cg, "extern uxb_f128_to_str"
    X64EmitText cg, "extern uxb_f128_copy"
    X64EmitText cg, "extern uxb_f128_add"
    X64EmitText cg, "extern uxb_f128_sub"
    X64EmitText cg, "extern uxb_f128_mul"
    X64EmitText cg, "extern uxb_f128_div"
    X64EmitText cg, "extern uxb_f128_cmp"
    X64EmitText cg, "extern fseek"
    X64EmitText cg, "extern ftell"
    X64EmitText cg, "extern feof"
    X64EmitText cg, "extern fgetc"
    X64EmitText cg, "extern ungetc"
    X64EmitText cg, "extern memmove"
    X64EmitText cg, "extern memset"
    X64EmitText cg, "extern strlen"
    X64EmitText cg, "extern __uxb_rt_rnd_f64"
    X64EmitText cg, "extern __uxb_rt_randomize_seed"
    X64EmitText cg, "extern sin"
    X64EmitText cg, "extern cos"
    X64EmitText cg, "extern tan"
    X64EmitText cg, "extern atan"
    X64EmitText cg, "extern exp"
    X64EmitText cg, "extern log"
    X64EmitText cg, "extern GetTickCount64"
    X64EmitText cg, "extern __uxb_rt_timer_f64"
    X64EmitText cg, "extern __uxb_rt_biginit_text"
    X64EmitText cg, "extern __uxb_rt_str_i64"
    X64EmitText cg, "extern __uxb_rt_str_store"
    X64EmitText cg, "extern __uxb_rt_str_release"
    X64EmitText cg, "extern __uxb_rt_str_temp"
    X64EmitText cg, "extern __uxb_rt_array_resize"
    X64EmitText cg, "extern __uxb_rt_str_concat"
    X64EmitText cg, "extern __uxb_rt_trim"
    X64EmitText cg, "extern __uxb_rt_string"
    X64EmitText cg, "extern __uxb_rt_string_text"
    X64EmitText cg, "extern __uxb_rt_print_cstr"
    X64EmitText cg, "extern __uxb_rt_print_separator"
    X64EmitText cg, "extern __uxb_rt_print_newline"
    X64EmitText cg, "extern __uxb_rt_cls"
    X64EmitText cg, "extern __uxb_rt_csrlin"
    X64EmitText cg, "extern __uxb_rt_pos"
    X64EmitText cg, "extern __uxb_rt_locate"
    X64EmitText cg, "extern __uxb_rt_color"
    X64EmitText cg, "extern __uxb_rt_getkey_i64"
    X64EmitText cg, "extern __uxb_rt_inkey_i64"
    X64EmitText cg, "extern __uxb_rt_instr"
    X64EmitText cg, "extern __uxb_rt_lcase"
    X64EmitText cg, "extern __uxb_rt_ucase"
    X64EmitText cg, "extern __uxb_rt_rtrim"
    X64EmitText cg, "extern __uxb_rt_ltrim"
    X64EmitText cg, "extern __uxb_rt_str_compare"
    X64EmitText cg, "extern __uxb_rt_chr"
    X64EmitText cg, "extern __uxb_rt_strlen"
    X64EmitText cg, "extern __uxb_rt_left"
    X64EmitText cg, "extern __uxb_rt_right"
    X64EmitText cg, "extern __uxb_rt_mid"
    X64EmitText cg, "extern __uxb_rt_program_end"
    X64EmitText cg, "extern __uxb_rt_sync_enter"
    X64EmitText cg, "extern __uxb_rt_sync_leave"
    X64EmitText cg, "extern __uxb_rt_lock_mark"
    X64EmitText cg, "extern __uxb_rt_lock_release_to"
    X64EmitText cg, "extern __uxb_rt_mutex_new"
    X64EmitText cg, "extern __uxb_rt_exc_active"
    X64EmitText cg, "extern __uxb_rt_exc_set_value"
    X64EmitText cg, "extern __uxb_rt_exc_set_active"
    X64EmitText cg, "extern __uxb_rt_exc_uncaught"
    X64EmitText cg, "extern __uxb_rt_str_f32"
    X64EmitText cg, "extern __uxb_rt_str_f64"
    X64EmitText cg, "extern __uxb_rt_str_u64"
    X64EmitText cg, "extern __uxb_rt_list_new"
    X64EmitText cg, "extern __uxb_rt_list_len"
    X64EmitText cg, "extern __uxb_rt_list_add"
    If gX64ProgramHasFileIo <> 0 Then X64EmitBss cg, "__uxb_file_mutex_id: resq 1"
    cg.nativeRuntimeUsed = X64AstUsesNativeRuntimeSlots(ps, nodeIdx)
    If cg.nativeRuntimeUsed <> 0 Then X64EmitNativeRuntimeExterns cg
    If X64TaskUsesV2(ps) <> 0 Then
        Dim taskSymbols(0 To 14) As String = { "spawn", "join", "wait", "cancel", "result", "status", "error", "group_create", "group_add", "group_join", "shutdown", "cancel_point", "fail_i64", "fail_cstr", "set_workers" }
        For taskSym As Integer = 0 To 14
            X64EmitText cg, "extern __uxb_rt_task_" & taskSymbols(taskSym)
        Next
    End If

    X64CollectDllCallPlan ps, nodeIdx, cg
    If cg.ffiCallTotal > 0 Then X64EmitText cg, "extern __uxb_ffi_resolve_all"
    X64EmitText cg, ""

    X64EmitBuiltinSupport cg
    X64EmitFfiSupport cg
    If X64EmitRuntimeInstanceOfSupport(ps, nodeIdx, cg, errText) = 0 Then Return 0

    Dim sigScan As Integer
    sigScan = ps.ast.nodes(nodeIdx).firstChild
    Do While sigScan <> -1
        Dim sigKind As String
        sigKind = X64Upper(ps.ast.nodes(sigScan).kind)
        If sigKind = "SUB_STMT" Or sigKind = "FUNCTION_STMT" Then
            X64RegisterRoutineSignature ps, sigScan, cg
        ElseIf sigKind = "THREAD_STMT" Or sigKind = "PARALEL_STMT" Then
            Dim taskLabel As String = LCase(X64SanitizeSymbol(ps.ast.nodes(sigScan).value))
            X64RegisterRoutineSignatureAs ps, sigScan, cg, taskLabel
        ElseIf sigKind = "CLASS_STMT" Then
            Dim sigMember As Integer
            sigMember = ps.ast.nodes(sigScan).firstChild
            Do While sigMember <> -1
                Dim sigMemberKind As String
                sigMemberKind = X64Upper(ps.ast.nodes(sigMember).kind)
                If sigMemberKind = "CLASS_METHOD_DECL" Or sigMemberKind = "CLASS_OPERATOR_DECL" Or sigMemberKind = "CLASS_CONSTRUCTOR_DECL" Or sigMemberKind = "CLASS_DESTRUCTOR_DECL" Then
                    X64RegisterClassRoutineSignature ps, sigMember, cg
                ElseIf sigMemberKind = "CLASS_PROPERTY_DECL" Then
                    Dim accessorNode As Integer
                    accessorNode = ps.ast.nodes(sigMember).firstChild
                    Do While accessorNode <> -1
                        Dim accessorKind As String
                        accessorKind = X64Upper(ps.ast.nodes(accessorNode).kind)
                        If accessorKind = "CLASS_PROPERTY_GET_STMT" Or accessorKind = "CLASS_PROPERTY_SET_STMT" Then
                            X64RegisterClassRoutineSignature ps, accessorNode, cg
                        End If
                        accessorNode = ps.ast.nodes(accessorNode).nextSibling
                    Loop
                End If
                sigMember = ps.ast.nodes(sigMember).nextSibling
            Loop
            ' Emit vtable data for the class
            Dim errText As String
            If X64EmitClassVTable(ps, sigScan, cg, errText) = 0 Then Return 0
        End If
        sigScan = ps.ast.nodes(sigScan).nextSibling
    Loop

    ' UXB_007_REL10_FIX_20260712: functions inside NAMESPACE/MODULE are real
    ' routines, but their containers are compile-time only.
    Dim nestedSigScan As Integer
    nestedSigScan = ps.ast.nodes(nodeIdx).firstChild
    Do While nestedSigScan <> -1
        Dim nestedSigKind As String
        nestedSigKind = X64Upper(ps.ast.nodes(nestedSigScan).kind)
        If nestedSigKind = "NAMESPACE_STMT" Or nestedSigKind = "MODULE_STMT" Then
            X64RegisterContainerRoutineSignatures ps, nestedSigScan, cg
        End If
        nestedSigScan = ps.ast.nodes(nestedSigScan).nextSibling
    Loop

    If X64EmitDeclarationMetadata(ps, nodeIdx, cg, errText) = 0 Then Return 0

    Dim mainLabel As String
    mainLabel = "__uxb_main"

    cg.currentRoutineLabel = ""
    cg.localCount = 0
    cg.localFrameBytes = 0
    cg.paramCount = 0
    cg.currentRoutineIsFunction = 1
    cg.currentEpilogLabel = X64NextLabel(cg, "ret")
    cg.ffiCallEmitIndex = 0

    X64EmitText cg, "global main"
    X64EmitText cg, "global __uxb_main"
    X64EmitLabel cg, "main"
    X64EmitLabel cg, mainLabel
    EmitFunctionProlog cg, 0
    X64EmitCall0 cg, "__uxb_register_literal_spans"
    If gX64ProgramHasFileIo <> 0 Then
        X64EmitCall0 cg, "__uxb_rt_mutex_new"
        X64EmitText cg, "    mov [rel __uxb_file_mutex_id], rax"
    End If
    If cg.ffiCallTotal > 0 Then
        X64EmitText cg, "    sub rsp, 32"
        X64EmitText cg, "    call __uxb_ffi_resolve_all"
        X64EmitText cg, "    add rsp, 32"
    End If
    If cg.nativeRuntimeUsed <> 0 Then X64EmitNativeRuntimeInit cg
    If X64TaskUsesV2(ps) <> 0 And gX64TaskWorkers > 0 Then
        X64EmitText cg, "    mov rcx, " & X64ToStr(gX64TaskWorkers)
        X64EmitCall0 cg, "__uxb_rt_task_set_workers"
    End If
    X64EmitText cg, "    xor rax, rax"

    Dim ch As Integer
    ' UXB_007_REL10_FIX_20260712: emit only executable top-level and MAIN
    ' children.  Namespace/module function labels must never appear inside main.
    If X64EmitProgramRuntimeChildren(ps, nodeIdx, cg, errText) = 0 Then Return 0

    X64EmitLabel cg, cg.currentEpilogLabel
    If X64TaskUsesV2(ps) <> 0 Then
        X64EmitText cg, "    mov ecx, 1"
        X64EmitCall0 cg, "__uxb_rt_task_shutdown"
        X64EmitText cg, "    test rax, rax"
        Dim taskExitOk As String = X64NextLabel(cg, "task_exit_ok")
        X64EmitText cg, "    jz " & taskExitOk
        X64EmitText cg, "    mov ecx, 1"
        X64EmitCall0 cg, "exit"
        X64EmitLabel cg, taskExitOk
    End If
    If cg.nativeRuntimeUsed <> 0 Then X64EmitNativeRuntimeShutdown cg
    ' The process entry routine has no language-level return value.  A final
    ' CALL(DLL, ..., VOID, ...) can leave an arbitrary native value in RAX;
    ' always return successful process status rather than leaking that value.
    X64EmitText cg, "    xor eax, eax"
    EmitFunctionEpilog cg
    X64EmitText cg, ""

    cg.currentRoutineLabel = ""
    cg.localCount = 0
    cg.localFrameBytes = 0
    cg.paramCount = 0
    cg.currentRoutineIsFunction = 0
    cg.currentEpilogLabel = ""

    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        Dim k As String
        k = X64Upper(ps.ast.nodes(ch).kind)
        If k = "SUB_STMT" Or k = "FUNCTION_STMT" Then
            If X64EmitNode(ps, ch, cg, errText) = 0 Then Return 0
            X64EmitText cg, ""
        ElseIf k = "CLASS_STMT" Then
            Dim classMember As Integer
            classMember = ps.ast.nodes(ch).firstChild
            Do While classMember <> -1
                Dim classMemberKind As String
                classMemberKind = X64Upper(ps.ast.nodes(classMember).kind)
                If classMemberKind = "CLASS_METHOD_DECL" Or classMemberKind = "CLASS_OPERATOR_DECL" Or classMemberKind = "CLASS_CONSTRUCTOR_DECL" Or classMemberKind = "CLASS_DESTRUCTOR_DECL" Then
                    If X64EmitClassRoutineNode(ps, classMember, cg, errText) = 0 Then Return 0
                    If X64ClassRoutineHasBody(ps, classMember) <> 0 Then X64EmitText cg, ""
                ElseIf classMemberKind = "CLASS_PROPERTY_DECL" Then
                    Dim accessorMember As Integer
                    accessorMember = ps.ast.nodes(classMember).firstChild
                    Do While accessorMember <> -1
                        Dim accessorKind2 As String
                        accessorKind2 = X64Upper(ps.ast.nodes(accessorMember).kind)
                        If accessorKind2 = "CLASS_PROPERTY_GET_STMT" Or accessorKind2 = "CLASS_PROPERTY_SET_STMT" Then
                            If X64EmitClassRoutineNode(ps, accessorMember, cg, errText) = 0 Then Return 0
                            If X64ClassRoutineHasBody(ps, accessorMember) <> 0 Then X64EmitText cg, ""
                        End If
                        accessorMember = ps.ast.nodes(accessorMember).nextSibling
                    Loop
                End If
                classMember = ps.ast.nodes(classMember).nextSibling
            Loop
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Dim nestedRoutineScan As Integer
    nestedRoutineScan = ps.ast.nodes(nodeIdx).firstChild
    Do While nestedRoutineScan <> -1
        Dim nestedRoutineKind As String
        nestedRoutineKind = X64Upper(ps.ast.nodes(nestedRoutineScan).kind)
        If nestedRoutineKind = "NAMESPACE_STMT" Or nestedRoutineKind = "MODULE_STMT" Then
            If X64EmitContainerRoutines(ps, nestedRoutineScan, cg, errText) = 0 Then Return 0
        End If
        nestedRoutineScan = ps.ast.nodes(nestedRoutineScan).nextSibling
    Loop

    If X64EmitSlotLaneRoutines(ps, nodeIdx, cg, errText) = 0 Then Return 0

    Return 1
End Function

Private Function X64EmitSubStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim procName As String
    procName = Trim(ps.ast.nodes(nodeIdx).value)
    If procName = "" Then procName = X64NextLabel(cg, "sub")
    Return GenerateRoutine(ps, nodeIdx, cg, errText, 0, procName)
End Function

Private Function X64EmitFunctionStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim fnName As String
    fnName = Trim(ps.ast.nodes(nodeIdx).value)
    If fnName = "" Then fnName = X64NextLabel(cg, "fn")
    Return GenerateRoutine(ps, nodeIdx, cg, errText, 1, fnName)
End Function

Private Function X64EmitClassRoutineNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim nodeKind As String
    nodeKind = X64Upper(Trim(ps.ast.nodes(nodeIdx).kind))
    If nodeKind <> "CLASS_METHOD_DECL" And nodeKind <> "CLASS_OPERATOR_DECL" And nodeKind <> "CLASS_CONSTRUCTOR_DECL" And nodeKind <> "CLASS_DESTRUCTOR_DECL" And nodeKind <> "CLASS_PROPERTY_GET_STMT" And nodeKind <> "CLASS_PROPERTY_SET_STMT" Then Return 1

    ' S-597 (2026-10-17): an empty METHOD / CONSTRUCTOR / DESTRUCTOR is a real routine. It used to be skipped here while the NEW and
    ' call sites still referenced it, so the assembler failed with "symbol `ALT_CTOR' not defined".

    Dim routineName As String
    If X64ResolveClassRoutineName(ps, nodeIdx, routineName) = 0 Then
        errText = "x64-codegen: class routine name resolve failed"
        Return 0
    End If

    Dim isFunction As Integer
    isFunction = 0
    If nodeKind = "CLASS_METHOD_DECL" Or nodeKind = "CLASS_OPERATOR_DECL" Then
        isFunction = IIf(X64NodeHasReturnType(ps, nodeIdx) <> 0, 1, 0)
    ElseIf nodeKind = "CLASS_PROPERTY_GET_STMT" Then
        isFunction = 1
    End If
    Return GenerateRoutine(ps, nodeIdx, cg, errText, isFunction, routineName)
End Function

' S-529: DIM / REDIM [PRESERVE] of a dynamic scalar array (see x64_codegen_dynamic_class_arrays.fbs). DIM creates the three-qword
' descriptor (global, or a frame slot of the routine that declares it) and allocates the first block; REDIM works on the
' descriptor that already exists and resizes it (PRESERVE keeps the overlapping elements).
Private Function X64EmitSdaDeclaration(ByRef ps As ParseState, ByVal stmtNode As Integer, ByVal declNode As Integer, ByRef declName As String, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim isRedim As Integer = IIf(X64Upper(ps.ast.nodes(declNode).kind) = "REDIM_DECL" Or X64Upper(ps.ast.nodes(stmtNode).kind) = "REDIM_STMT", 1, 0)
    Dim keepOld As Integer = IIf(isRedim <> 0 And X64Upper(Trim(ps.ast.nodes(stmtNode).op)) = "PRESERVE", 1, 0)
    Dim localOffset As Integer
    Dim slotCount As Integer
    Dim labelText As String
    Dim exists As Integer = 0
    If cg.currentRoutineLabel <> "" Then
        If X64TryFindLocalInfo(cg, declName, localOffset, slotCount) <> 0 Then exists = 1
    End If
    If exists = 0 Then
        If X64TryFindGlobalInfo(cg, declName, labelText, slotCount) <> 0 Then exists = 1
    End If
    If isRedim = 0 Or exists = 0 Then
        If cg.currentRoutineLabel = "" Then
            X64EnsureGlobalSymbol(cg, declName, 3, 8)
        Else
            localOffset = X64EnsureLocalSlot(cg, declName, 3, 8)
            Dim sdaMapErr As String
            If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, declName, localOffset, 3, sdaMapErr) = 0 Then
                errText = sdaMapErr
                Return 0
            End If
        End If
        Dim sdaTypeName As String = ""
        If X64FindDeclaredTypeName(ps, declName, sdaTypeName) <> 0 Then X64RegisterVarType(cg, declName, sdaTypeName)
        If cg.currentRoutineLabel <> "" Then
            ' a frame slot holds whatever the stack held before: start from an empty descriptor
            If X64SdaDescriptorToReg(cg, declName, "rcx") = 0 Then errText = "x64-codegen: dynamic array descriptor missing: " & declName: Return 0
            X64EmitText cg, "    mov qword [rcx], 0"
            X64EmitText cg, "    mov qword [rcx + 8], 0"
            X64EmitText cg, "    mov qword [rcx + 16], 0"
        End If
    End If
    Dim unallocatedBounds As Integer = 0
    Dim unallocatedChild As Integer = ps.ast.nodes(declNode).firstChild
    Do While unallocatedChild >= 0
        If ps.ast.nodes(unallocatedChild).kind = "DIM_BOUNDS" AndAlso ps.ast.nodes(unallocatedChild).op = "UNALLOCATED_ARRAY" Then
            unallocatedBounds = 1
            Exit Do
        End If
        unallocatedChild = ps.ast.nodes(unallocatedChild).nextSibling
    Loop
    If unallocatedBounds <> 0 Then
        If X64SdaDescriptorToReg(cg, declName, "rcx") = 0 Then
            errText = "x64-codegen: unallocated array descriptor missing: " & declName
            Return 0
        End If
        X64EmitText cg, "    mov qword [rcx], 0"
        X64EmitText cg, "    mov qword [rcx + 8], 0"
        X64EmitText cg, "    mov qword [rcx + 16], -1"
        Return 1
    End If
    Return X64SdaResize(ps, cg, declNode, declName, keepOld, errText)
End Function

' %%NOZEROVARS ON: a declared plain numeric scalar local is not cleared at its DIM (the program assigns it before reading it).
' Arrays, strings, references and records keep the clearing: their cleanup and null checks rely on it.
Private Function X64DimMayKeepStackValue(ByRef declTypeText As String, ByVal elemCount As Integer, ByVal hasBounds As Integer) As Integer
    If gLastPreprocessResult.noZeroVars = 0 Then Return 0
    If elemCount <> 1 Or hasBounds <> 0 Then Return 0
    Select Case UCase(Trim(declTypeText))
    Case "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64", "BOOLEAN", "BOOL"
        Return 1
    End Select
    Return 0
End Function

Private Function X64EmitDimStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        Dim declName As String
        declName = Trim(ps.ast.nodes(ch).value)
        If declName = "" Then declName = X64NextLabel(cg, "dim")

        If X64SdaKind(ps, declName) <> 0 Then
            Dim sdaBoundsChild As Integer = ps.ast.nodes(ch).firstChild
            Dim sdaHasBounds As Integer = 0
            Do While sdaBoundsChild >= 0
                If X64Upper(ps.ast.nodes(sdaBoundsChild).kind) = "DIM_BOUNDS" Then sdaHasBounds = 1: Exit Do
                sdaBoundsChild = ps.ast.nodes(sdaBoundsChild).nextSibling
            Loop
            If sdaHasBounds <> 0 Then
                If X64EmitSdaDeclaration(ps, nodeIdx, ch, declName, cg, errText) = 0 Then Return 0
                ch = ps.ast.nodes(ch).nextSibling
                Continue Do
            End If
        End If

        Dim boundsNode As Integer
        boundsNode = -1

        Dim elemCount As Integer
        elemCount = X64ComputeDimSlotCount(ps, ch)

        ' Determine element byte size from declared type (if any)
        Dim elemBytes As Integer
        elemBytes = 8
        Dim declTypeName As String
        declTypeName = ""
        Dim declIsClass As Integer
        Dim declIsObject As Integer
        declIsClass = 0
        declIsObject = 0
        If X64FindDeclaredTypeName(ps, declName, declTypeName) <> 0 Then
            declTypeName = X64Upper(Trim(declTypeName))
            declIsClass = IIf(X64FindClassDeclNode(ps, declTypeName) <> -1, 1, 0)
            declIsObject = IIf(declTypeName = "OBJECT", 1, 0)

            If declIsClass <> 0 Or declIsObject <> 0 Then
                ' CLASS/OBJECT variables are pointer slots in x64 lane.
                elemBytes = 8
            Else
                Dim aggSize As Integer
                Dim aggErr As String
                ' S-079: the slot/array element is the STRIDE cell (F80: 16 bytes,
                ' first 10 = x87 payload), not the payload (10) SIZEOF reports.
                If TypeLayoutStrideOf(ps, declTypeName, aggSize, aggErr) <> 0 Then
                    If aggSize > 0 Then elemBytes = aggSize
                Else
                    ' fallback for float kinds
                    Select Case X64TypeToFloatKind(declTypeName)
                    Case UXF_F80
                        elemBytes = 16
                    Case UXF_F32
                        elemBytes = 4
                    Case Else
                        elemBytes = 8
                    End Select
                End If
            End If
        End If

        If cg.currentRoutineLabel = "" OrElse (X64DcaKind(ps, declName) <> 0 AndAlso X64HasTopLevelGlobalDecl(ps, declName) <> 0) Then
            X64EnsureGlobalSymbol(cg, declName, elemCount, elemBytes)
        Else
            Dim localOffset As Integer
            localOffset = X64EnsureLocalSlot(cg, declName, elemCount, elemBytes)
            Dim localMapErr As String
            If VarMappingAddLocalChecked(cg.localVars, cg.currentRoutineLabel, declName, localOffset, elemCount, localMapErr) = 0 Then
                errText = localMapErr
                Return 0
            End If
        End If
        '
        ' Register declared type (if any) for this variable into the codegen var-type registry
        declTypeName = ""
        If X64FindDeclaredTypeName(ps, declName, declTypeName) <> 0 Then
            X64RegisterVarType(cg, declName, declTypeName)
        End If

        Dim subNode As Integer
        Dim hasInitExpr As Integer
        hasInitExpr = 0
        Dim hasBounds As Integer
        hasBounds = 0
        subNode = ps.ast.nodes(ch).firstChild
        Do While subNode <> -1
            Dim subKind As String
            subKind = X64Upper(ps.ast.nodes(subNode).kind)

            If subKind = "DIM_BOUNDS" Then hasBounds = 1

            If subKind = "INIT_EXPR" And ps.ast.nodes(subNode).left <> -1 Then
                hasInitExpr = 1
                Dim initExpr As Integer
                initExpr = ps.ast.nodes(subNode).left
                Dim declType As String
                declType = ""
                If X64FindDeclaredTypeName(ps, declName, declType) <> 0 Then
                    Dim initFloatKind As Integer
                    initFloatKind = X64TypeToFloatKind(declType)
                    If initFloatKind = UXF_F32 Or initFloatKind = UXF_F64 Then
                        If X64EmitExprToXmm0As(ps, initExpr, cg, initFloatKind, errText) = 0 Then Return 0
                        ' Keep the declaration width at the store boundary.  The
                        ' old helper always stored as F64, so a literal F32 was
                        ' written with MOVSD even though it had been evaluated
                        ' with MOVSS (S-512).
                        If X64EmitStoreXmm0ToFloatVarAs(cg, declName, initFloatKind, errText) = 0 Then Return 0
                    ElseIf X64IsExtFpKind(initFloatKind) <> 0 Then
                        Dim initTargetNode As Integer
                        initTargetNode = ch
                        If X64EmitExtFpAddrOfExprToRax(ps, initTargetNode, cg, initFloatKind, errText) = 0 Then
                            ' DIM_DECL nodes are not always addressable AST expressions; fall back to variable address.
                            If X64EmitAddrOfVar(cg, declName, errText) = 0 Then Return 0
                        End If
                        X64EmitText cg, "    mov r9, rax"
                        If X64EmitExtFpAssignToPreparedAddress(ps, initExpr, cg, initFloatKind, "[r9]", errText) = 0 Then Return 0
                    Else
                        If X64EmitExprToRax(ps, initExpr, cg, errText) = 0 Then Return 0
                        X64EmitStoreVar cg, declName
                    End If
                Else
                    If X64EmitExprToRax(ps, initExpr, cg, errText) = 0 Then Return 0
                    X64EmitStoreVar cg, declName
                End If
            End If
            subNode = ps.ast.nodes(subNode).nextSibling
        Loop

        If hasBounds <> 0 And X64DcaKind(ps, declName) <> 0 Then
            If X64DcaResize(ps, cg, ch, declName, errText) = 0 Then Return 0
        ElseIf hasBounds <> 0 And declIsClass <> 0 And hasInitExpr = 0 Then
            ' Every executed DIM starts with NULL references. Stack contents
            ' are not an initialization contract, including on repeated calls.
            If X64EmitAddrOfVar(cg, declName, errText) = 0 Then Return 0
            X64EmitText cg, "    mov rcx, rax"
            X64EmitText cg, "    xor edx, edx"
            X64EmitText cg, "    mov r8, " & LTrim(Str(CLngInt(elemCount) * 8))
            X64EmitCall0 cg, "memset"
        End If

        If hasInitExpr = 0 And cg.currentRoutineLabel <> "" And X64DcaKind(ps, declName) = 0 And X64DimMayKeepStackValue(declTypeName, elemCount, hasBounds) = 0 Then
            ' S-030 exposed an older AST-direct defect: uninitialized local DIM
            ' read stale stack values. Default initialization is per execution,
            ' including repeated calls and OS workers, not an OS stack accident.
            If X64EmitAddrOfVar(cg, declName, errText) = 0 Then Return 0
            X64EmitText cg, "    mov rcx, rax"
            X64EmitText cg, "    xor edx, edx"
            X64EmitText cg, "    mov r8, " & LTrim(Str(CLngInt(elemCount) * elemBytes))
            X64EmitCall0 cg, "memset"
        End If

        If X64Upper(declTypeName) = "TASKGROUP" And hasInitExpr = 0 And hasBounds = 0 Then
            X64EmitCall0 cg, "__uxb_rt_task_group_create"
            X64EmitStoreVar cg, declName
        End If

        If X64Upper(declTypeName) = "MUTEX" And hasInitExpr = 0 And hasBounds = 0 Then
            X64EmitCall0 cg, "__uxb_rt_mutex_new"
            X64EmitStoreVar cg, declName
        End If

        If X64Upper(declTypeName) = "LIST" And hasInitExpr = 0 And hasBounds = 0 Then
            X64EmitCall0 cg, "__uxb_rt_list_new"
            X64EmitStoreVar cg, declName
        End If

        If declIsClass <> 0 And hasInitExpr = 0 And hasBounds = 0 Then
            Dim classSize As Integer
            Dim classErr As String
            If TypeLayoutSizeOf(ps, declTypeName, classSize, classErr) = 0 Then
                errText = "x64-codegen: DIM class layout resolve failed " & classErr
                Return 0
            End If
            If classSize <= 0 Then
                errText = "x64-codegen: unresolved class layout: " & declTypeName
                Return 0
            End If

            ' S-108 (Mete's decision, 2026-09-20): `DIM a AS Cls` is a NULL reference; the object exists
            ' only after `= NEW ...` (it used to calloc a default object that `a = NEW Dog()` leaked).
            X64EmitComment cg, "DIM class variable = NULL reference"
            X64EmitText cg, "    xor eax, eax"
            X64EmitStoreVar cg, declName
        End If

        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Function X64EmitIfStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Return GenerateIf(ps, nodeIdx, cg, errText)
End Function

Private Function X64EmitForStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Return GenerateFor(ps, nodeIdx, cg, errText)
End Function

Private Function X64EmitNextStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    ' Parsed FOR bodies already consume NEXT tokens.
    Return 1
End Function

Private Function X64EmitSelectCompare(ByRef ps As ParseState, ByVal selectorExpr As Integer, ByRef selectorVar As String, ByVal rhsExpr As Integer, ByVal rel As String, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim selKind As Integer = X64InferFloatKindOfExpr(ps, selectorExpr, cg)
    Dim rhsKind As Integer = X64InferFloatKindOfExpr(ps, rhsExpr, cg)
    If selKind = UXF_F80 Or selKind = UXF_F128 Or rhsKind = UXF_F80 Or rhsKind = UXF_F128 Then
        errText = "legacy AST-x64: SELECT extended floating point comparison is not supported"
        Return 0
    End If
    If selKind = UXF_F32 Or selKind = UXF_F64 Or rhsKind = UXF_F32 Or rhsKind = UXF_F64 Then
        If X64EmitExprToXmm0As(ps, rhsExpr, cg, UXF_F64, errText) = 0 Then Return 0
        X64EmitText cg, "    movapd xmm1, xmm0"
        X64EmitLoadVar cg, selectorVar
        If selKind = UXF_F32 Or selKind = UXF_F64 Then
            X64EmitText cg, "    movq xmm0, rax"
        ElseIf UXBExprIsU64(ps, selectorExpr) <> 0 Then
            Dim unsignedLow As String = X64NextLabel(cg, "select_u64_low")
            Dim unsignedDone As String = X64NextLabel(cg, "select_u64_done")
            X64EmitText cg, "    test rax, rax"
            X64EmitText cg, "    jns " & unsignedLow
            X64EmitText cg, "    mov rdx, rax"
            X64EmitText cg, "    and eax, 1"
            X64EmitText cg, "    shr rdx, 1"
            X64EmitText cg, "    or rax, rdx"
            X64EmitText cg, "    cvtsi2sd xmm0, rax"
            X64EmitText cg, "    addsd xmm0, xmm0"
            X64EmitText cg, "    jmp " & unsignedDone
            X64EmitLabel cg, unsignedLow
            X64EmitText cg, "    cvtsi2sd xmm0, rax"
            X64EmitLabel cg, unsignedDone
        Else
            X64EmitText cg, "    cvtsi2sd xmm0, rax"
        End If
        X64EmitText cg, "    ucomisd xmm0, xmm1"
        X64EmitSetFromFloatCompareFlags cg, rel
        Return 1
    End If
    If X64EmitExprToRax(ps, rhsExpr, cg, errText) = 0 Then Return 0
    X64EmitText cg, "    mov rbx, rax"
    X64EmitLoadVar cg, selectorVar
    If X64ExprIsStringLike(ps, selectorExpr, cg) <> 0 Then
        X64EmitText cg, "    mov rcx, rax"
        X64EmitText cg, "    mov rdx, rbx"
        X64EmitCall0 cg, "__uxb_builtin_str_compare"
        X64EmitSetFromSignedCompareResult cg, rel
        Return 1
    End If
    Dim uns As Integer = IIf(UXBExprIsU64(ps, selectorExpr) <> 0 Or UXBExprIsU64(ps, rhsExpr) <> 0, 1, 0)
    Dim cond As String
    Select Case rel
    Case "=": cond = "e"
    Case "<>": cond = "ne"
    Case "<": cond = IIf(uns <> 0, "b", "l")
    Case ">": cond = IIf(uns <> 0, "a", "g")
    Case "<=": cond = IIf(uns <> 0, "be", "le")
    Case ">=": cond = IIf(uns <> 0, "ae", "ge")
    Case Else: errText = "SELECT invalid comparison: " & rel: Return 0
    End Select
    X64EmitText cg, "    cmp rax, rbx"
    X64EmitText cg, "    set" & cond & " al"
    X64EmitText cg, "    movzx eax, al"
    X64EmitText cg, "    neg rax"
    Return 1
End Function

Private Function X64EmitSelectStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: SELECT"

    Dim selectCount As Integer
    selectCount = X64ChildCount(ps, nodeIdx)
    If selectCount < 1 Then
        errText = "x64-codegen: SELECT selector missing"
        Return 0
    End If

    Dim selectorExpr As Integer
    selectorExpr = X64ChildAt(ps, nodeIdx, 0)
    If selectorExpr = -1 Then
        errText = "x64-codegen: SELECT selector missing"
        Return 0
    End If

    Dim selectorVar As String
    selectorVar = X64NextLabel(cg, "select_tmp")
    Dim selectorFloatKind As Integer = X64InferFloatKindOfExpr(ps, selectorExpr, cg)
    If selectorFloatKind = UXF_F32 Or selectorFloatKind = UXF_F64 Then
        If X64EmitExprToXmm0As(ps, selectorExpr, cg, UXF_F64, errText) = 0 Then Return 0
        X64EmitText cg, "    movq rax, xmm0"
    Else
        If X64EmitExprToRax(ps, selectorExpr, cg, errText) = 0 Then Return 0
    End If
    X64EmitStoreVar cg, selectorVar

    Dim endLabel As String
    endLabel = X64NextLabel(cg, "select_end")
    Dim condLabel As String
    condLabel = X64NextLabel(cg, "select_case")

    X64EmitText cg, "    jmp " & condLabel

    Dim casePos As Integer
    For casePos = 1 To selectCount - 1
        Dim caseNode As Integer
        caseNode = X64ChildAt(ps, nodeIdx, casePos)
        If caseNode = -1 Then
            errText = "x64-codegen: SELECT case missing"
            Return 0
        End If

        X64EmitLabel cg, condLabel

        Dim caseKind As String
        caseKind = X64Upper(ps.ast.nodes(caseNode).kind)
        If caseKind = "CASE_ELSE" Then
            Dim elseStmt As Integer
            elseStmt = ps.ast.nodes(caseNode).firstChild
            Do While elseStmt <> -1
                If X64EmitNode(ps, elseStmt, cg, errText) = 0 Then Return 0
                elseStmt = ps.ast.nodes(elseStmt).nextSibling
            Loop
            X64EmitText cg, "    jmp " & endLabel
            Exit For
        End If

        If caseKind <> "CASE_BLOCK" Then
            errText = "x64-codegen: unexpected SELECT case node " & ps.ast.nodes(caseNode).kind
            Return 0
        End If

        Dim caseChildCount As Integer
        caseChildCount = X64ChildCount(ps, caseNode)

        Dim bodyStart As Integer
        bodyStart = caseChildCount

        Dim cp As Integer
        For cp = 0 To caseChildCount - 1
            Dim cchild As Integer
            cchild = X64ChildAt(ps, caseNode, cp)
            If cchild <> -1 And X64IsStmtKind(ps.ast.nodes(cchild).kind) <> 0 Then
                bodyStart = cp
                Exit For
            End If
        Next cp

        If bodyStart <= 0 Then
            errText = "x64-codegen: CASE values missing"
            Return 0
        End If

        Dim bodyLabel As String
        Dim nextLabel As String
        bodyLabel = X64NextLabel(cg, "select_body")
        If casePos < selectCount - 1 Then
            nextLabel = X64NextLabel(cg, "select_case")
        Else
            nextLabel = endLabel
        End If

        For cp = 0 To bodyStart - 1
            Dim cexpr As Integer
            cexpr = X64ChildAt(ps, caseNode, cp)
            If cexpr = -1 Then
                errText = "x64-codegen: CASE expression missing"
                Return 0
            End If

            If X64Upper(ps.ast.nodes(cexpr).kind) = "CASE_RANGE_VALUE" Then
                If X64EmitSelectCompare(ps, selectorExpr, selectorVar, ps.ast.nodes(cexpr).left, ">=", cg, errText) = 0 Then Return 0
                Dim rangeLoPredicate As String = X64NextLabel(cg, "case_range_lower")
                X64EmitStoreVar cg, rangeLoPredicate
                If X64EmitSelectCompare(ps, selectorExpr, selectorVar, ps.ast.nodes(cexpr).right, "<=", cg, errText) = 0 Then Return 0
                X64EmitText cg, "    push rax"
                X64EmitLoadVar cg, rangeLoPredicate
                X64EmitText cg, "    pop rbx"
                X64EmitText cg, "    and rax, rbx"
            ElseIf X64Upper(ps.ast.nodes(cexpr).kind) = "CASE_IS_VALUE" Then
                If ps.ast.nodes(cexpr).left = -1 Then errText = "SELECT CASE IS expression missing": Return 0
                If X64EmitSelectCompare(ps, selectorExpr, selectorVar, ps.ast.nodes(cexpr).left, ps.ast.nodes(cexpr).op, cg, errText) = 0 Then Return 0
            Else
                If X64EmitSelectCompare(ps, selectorExpr, selectorVar, cexpr, "=", cg, errText) = 0 Then Return 0
            End If
            X64EmitText cg, "    test rax, rax"
            X64EmitText cg, "    jnz " & bodyLabel
        Next cp

        X64EmitText cg, "    jmp " & nextLabel
        X64EmitLabel cg, bodyLabel

        For cp = bodyStart To caseChildCount - 1
            Dim bodyStmt As Integer
            bodyStmt = X64ChildAt(ps, caseNode, cp)
            If bodyStmt <> -1 Then
                If X64EmitNode(ps, bodyStmt, cg, errText) = 0 Then Return 0
            End If
        Next cp

        X64EmitText cg, "    jmp " & endLabel
        condLabel = nextLabel
    Next casePos

    X64EmitLabel cg, endLabel
    Return 1
End Function

Private Function X64EmitDoStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: DO"

    Dim doMode As String
    doMode = X64Upper(ps.ast.nodes(nodeIdx).op)

    Dim doCount As Integer
    doCount = X64ChildCount(ps, nodeIdx)

    Dim hasPreCond As Integer
    Dim hasPostCond As Integer
    hasPreCond = (doMode = "DO_WHILE" Or doMode = "DO_UNTIL" Or doMode = "WHILE_WEND")
    hasPostCond = (doMode = "LOOP_WHILE" Or doMode = "LOOP_UNTIL")

    Dim preCondPos As Integer
    Dim postCondPos As Integer
    Dim bodyStartPos As Integer
    Dim bodyEndPos As Integer
    preCondPos = IIf(hasPreCond <> 0, 0, -1)
    postCondPos = IIf(hasPostCond <> 0, doCount - 1, -1)
    bodyStartPos = IIf(hasPreCond <> 0, 1, 0)
    bodyEndPos = IIf(hasPostCond <> 0, doCount - 2, doCount - 1)

    Dim lblStart As String
    Dim lblCond As String
    Dim lblEnd As String
    lblStart = X64NextLabel(cg, "do_start")
    lblCond = X64NextLabel(cg, "do_cond")
    lblEnd = X64NextLabel(cg, "do_end")

    cg.loopDepth += 1
    If cg.loopDepth > 255 Then
        errText = "x64-codegen: loop nesting too deep"
        Return 0
    End If
    gX64LoopEndLabels(cg.loopDepth - 1) = lblEnd
    gX64LoopStepLabels(cg.loopDepth - 1) = lblCond
    gX64LoopKinds(cg.loopDepth - 1) = IIf(doMode = "WHILE_WEND", "WHILE", "DO")

    X64EmitLabel cg, lblStart
    X64TaskEmitCancelPoint ps, cg

    If hasPreCond <> 0 Then
        Dim preExpr As Integer
        preExpr = X64ChildAt(ps, nodeIdx, preCondPos)
        If preExpr = -1 Then
            errText = "x64-codegen: DO pre-condition missing"
            Return 0
        End If
        If X64EmitConditionToRax(ps, preExpr, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    cmp rax, 0"
        If doMode = "DO_WHILE" Or doMode = "WHILE_WEND" Then
            X64EmitText cg, "    je " & lblEnd
        Else
            X64EmitText cg, "    jne " & lblEnd
        End If
    End If

    Dim bodyPos As Integer
    For bodyPos = bodyStartPos To bodyEndPos
        If bodyPos < 0 Then Exit For
        Dim bodyStmt As Integer
        bodyStmt = X64ChildAt(ps, nodeIdx, bodyPos)
        If bodyStmt <> -1 Then
            If X64EmitNode(ps, bodyStmt, cg, errText) = 0 Then Return 0
        End If
    Next bodyPos

    X64EmitLabel cg, lblCond
    If hasPostCond <> 0 Then
        Dim postExpr As Integer
        postExpr = X64ChildAt(ps, nodeIdx, postCondPos)
        If postExpr = -1 Then
            errText = "x64-codegen: LOOP post-condition missing"
            Return 0
        End If
        If X64EmitConditionToRax(ps, postExpr, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    cmp rax, 0"
        If doMode = "LOOP_WHILE" Then
            X64EmitText cg, "    jne " & lblStart
        Else
            X64EmitText cg, "    je " & lblStart
        End If
    Else
        X64EmitText cg, "    jmp " & lblStart
    End If

    X64EmitLabel cg, lblEnd
    gX64LoopEndLabels(cg.loopDepth - 1) = ""
    gX64LoopStepLabels(cg.loopDepth - 1) = ""
    cg.loopDepth -= 1
    Return 1
End Function

' Mirrors src/semantic/iterator_lowering.fbs MIREachSingleArrayInfo: detects a
' single EACH source that is a statically-bounded real array vs. a collection
' (LIST/DICT/SET/...) that has no native x64 iterator support yet. Returns 1
' when `info` describes a usable static array, 0 to fall back to the legacy
' literal-expression-list semantics below, -1 with errText set on a source
' that must fail closed instead of silently becoming a one-item sequence
' (S-038/S-044: this used to be handled by evaluating the bare array/collection
' identifier as a scalar expression, producing a silent wrong result).
Private Function X64TryDetectArrayEachInfo(ByRef ps As ParseState, ByVal itemsNode As Integer, ByRef info As UXBArrayMemoryInfo, ByRef errText As String) As Integer
    UXBArrayMemoryInfoReset info
    errText = ""
    If itemsNode < 0 Or itemsNode >= ps.ast.count Then Return 0
    Dim first As Integer = ps.ast.nodes(itemsNode).firstChild
    If first = -1 Or ps.ast.nodes(first).nextSibling <> -1 Then Return 0
    Dim k As String = X64Upper(Trim(ps.ast.nodes(first).kind))
    If k <> "IDENT" And k <> "IDENTIFIER" And k <> "VAR" And k <> "VAR_REF" Then Return 0
    If UXBFindArrayMemoryInfo(ps, ps.ast.nodes(first).value, info, errText) = 0 Then Return -1
    If info.found <> 0 Then
        If info.dynamicBounds <> 0 Then
            errText = "x64-codegen: FOR EACH/DO EACH dynamic array requires a runtime iterator ABI; REDIM arrays are not silently treated as one-item sequences"
            Return -1
        End If
        Return 1
    End If

    Dim declaredType As String
    If UXBFindDeclaredTypeForMemoryOperand(ps, ps.ast.nodes(first).value, declaredType) <> 0 Then
        Select Case X64Upper(Trim(declaredType))
        Case "LIST", "DICT", "SET", "CLASS", "INTERFACE", "STRING", "WSTRING"
            errText = "x64-codegen: FOR EACH/DO EACH source type " & declaredType & " has no native x64 iterator ABI yet; it cannot fall back to legacy one-item sequence semantics"
            Return -1
        End Select
    End If
    Return 0
End Function

' Emits a genuine indexed runtime loop (lowerBound..upperBound) reading each
' element of a real static-bounds array, instead of the legacy path's single
' scalar evaluation. itemVarName receives the element value; indexVarName
' (may be "") receives the loop counter.
Private Function X64EmitArrayEachRuntimeLoop(ByRef ps As ParseState, ByRef info As UXBArrayMemoryInfo, ByRef itemVarName As String, ByRef indexVarName As String, ByVal bodyNode As Integer, ByRef cg As X64CodegenContext, ByRef endLabel As String, ByRef errText As String) As Integer
    Dim baseOffset As Integer
    Dim globalLabel As String
    Dim slotCount As Integer
    Dim strideBytes As Integer
    Dim useLocal As Integer
    useLocal = 0
    strideBytes = info.elementBytes
    If strideBytes <= 0 Then strideBytes = 8

    If cg.currentRoutineLabel <> "" And X64TryFindLocalInfo(cg, info.nameText, baseOffset, slotCount) <> 0 Then
        useLocal = 1
        If X64TryGetLocalElemBytes(cg, info.nameText, strideBytes) = 0 Then strideBytes = info.elementBytes
    ElseIf X64TryFindGlobalInfo(cg, info.nameText, globalLabel, slotCount) <> 0 Then
        useLocal = 0
        If X64TryGetGlobalElemBytes(cg, info.nameText, strideBytes) = 0 Then strideBytes = info.elementBytes
    Else
        errText = "x64-codegen: FOR EACH/DO EACH array symbol not registered: " & info.nameText
        Return 0
    End If
    If strideBytes <= 0 Then strideBytes = 8

    Dim counterName As String
    counterName = X64NextLabel(cg, "foreach_arr_idx")
    X64EmitText cg, "    mov rax, " & X64ToStr(info.lowerBound)
    X64EmitStoreVar cg, counterName

    Dim checkLabel As String
    checkLabel = X64NextLabel(cg, "foreach_arr_check")
    X64EmitLabel cg, checkLabel
    X64EmitLoadVar cg, counterName
    X64EmitText cg, "    cmp rax, " & X64ToStr(info.upperBound)
    X64EmitText cg, "    jg " & endLabel

    X64EmitLoadVar cg, counterName
    If info.lowerBound <> 0 Then X64EmitText cg, "    sub rax, " & X64ToStr(info.lowerBound)
    X64EmitText cg, "    mov rbx, rax"
    X64EmitText cg, "    imul rbx, " & X64ToStr(strideBytes)
    If useLocal <> 0 Then
        X64EmitText cg, "    lea rcx, " & X64FormatRbpRef(baseOffset)
    Else
        X64EmitText cg, "    lea rcx, [rel " & globalLabel & "]"
    End If
    X64EmitText cg, "    add rcx, rbx"
    Select Case strideBytes
    Case 1
        X64EmitText cg, "    movsx rax, byte [rcx]"
    Case 2
        X64EmitText cg, "    movsx rax, word [rcx]"
    Case 4
        X64EmitText cg, "    movsxd rax, dword [rcx]"
    Case Else
        X64EmitText cg, "    mov rax, [rcx]"
    End Select
    X64EmitStoreVar cg, itemVarName
    If Trim(indexVarName) <> "" Then
        X64EmitLoadVar cg, counterName
        X64EmitStoreVar cg, indexVarName
    End If

    Dim continueLabel As String = X64NextLabel(cg, "each_next")
    gX64LoopStepLabels(cg.loopDepth - 1) = continueLabel
    Dim bodyStmt As Integer
    bodyStmt = ps.ast.nodes(bodyNode).firstChild
    Do While bodyStmt <> -1
        If X64EmitNode(ps, bodyStmt, cg, errText) = 0 Then Return 0
        bodyStmt = ps.ast.nodes(bodyStmt).nextSibling
    Loop

    X64EmitLabel cg, continueLabel
    X64EmitLoadVar cg, counterName
    X64EmitText cg, "    add rax, 1"
    X64EmitStoreVar cg, counterName
    X64EmitText cg, "    jmp " & checkLabel
    Return 1
End Function

Private Function X64EmitForEachStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: FOR EACH"

    Dim itemsNode As Integer
    Dim bodyNode As Integer
    itemsNode = X64ChildAt(ps, nodeIdx, 0)
    bodyNode = X64ChildAt(ps, nodeIdx, 1)
    If itemsNode = -1 Or bodyNode = -1 Then
        errText = "x64-codegen: FOR EACH items/body missing"
        Return 0
    End If

    Dim endLabel As String
    endLabel = X64NextLabel(cg, "foreach_end")
    cg.loopDepth += 1
    If cg.loopDepth > 255 Then
        errText = "x64-codegen: loop nesting too deep"
        Return 0
    End If
    gX64LoopEndLabels(cg.loopDepth - 1) = endLabel
    gX64LoopKinds(cg.loopDepth - 1) = "FOR"

    Dim arrInfo As UXBArrayMemoryInfo
    Dim arrDetect As Integer
    arrDetect = X64TryDetectArrayEachInfo(ps, itemsNode, arrInfo, errText)
    If arrDetect < 0 Then
        cg.loopDepth -= 1
        Return 0
    End If
    If arrDetect = 1 Then
        Dim arrResult As Integer
        arrResult = X64EmitArrayEachRuntimeLoop(ps, arrInfo, ps.ast.nodes(nodeIdx).value, ps.ast.nodes(nodeIdx).op, bodyNode, cg, endLabel, errText)
        X64EmitLabel cg, endLabel
        gX64LoopEndLabels(cg.loopDepth - 1) = ""
        cg.loopDepth -= 1
        Return arrResult
    End If

    Dim itemCount As Integer
    itemCount = X64ChildCount(ps, itemsNode)

    Dim itemVarNames(Any) As String
    If itemCount > 0 Then ReDim itemVarNames(itemCount - 1)

    Dim i As Integer
    For i = 0 To itemCount - 1
        Dim itemExpr As Integer
        itemExpr = X64ChildAt(ps, itemsNode, i)
        If itemExpr = -1 Then
            errText = "x64-codegen: FOR EACH item missing"
            Return 0
        End If
        itemVarNames(i) = X64NextLabel(cg, "foreach_item")
        If X64EmitExprToRax(ps, itemExpr, cg, errText) = 0 Then Return 0
        X64EmitStoreVar cg, itemVarNames(i)
    Next i

    For i = 0 To itemCount - 1
        X64EmitLoadVar cg, itemVarNames(i)
        X64EmitStoreVar cg, ps.ast.nodes(nodeIdx).value
        If Trim(ps.ast.nodes(nodeIdx).op) <> "" Then
            X64EmitText cg, "    mov rax, " & X64ToStr(i)
            X64EmitStoreVar cg, ps.ast.nodes(nodeIdx).op
        End If

        Dim continueLabel As String = X64NextLabel(cg, "each_next")
        gX64LoopStepLabels(cg.loopDepth - 1) = continueLabel
        Dim bodyStmt As Integer
        bodyStmt = ps.ast.nodes(bodyNode).firstChild
        Do While bodyStmt <> -1
            If X64EmitNode(ps, bodyStmt, cg, errText) = 0 Then Return 0
            bodyStmt = ps.ast.nodes(bodyStmt).nextSibling
        Loop
        X64EmitLabel cg, continueLabel
    Next i

    X64EmitLabel cg, endLabel
    gX64LoopEndLabels(cg.loopDepth - 1) = ""
    cg.loopDepth -= 1
    Return 1
End Function

Private Function X64EmitDoEachStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: DO EACH"

    Dim itemsNode As Integer
    Dim bodyNode As Integer
    itemsNode = X64ChildAt(ps, nodeIdx, 0)
    bodyNode = X64ChildAt(ps, nodeIdx, 1)
    If itemsNode = -1 Or bodyNode = -1 Then
        errText = "x64-codegen: DO EACH items/body missing"
        Return 0
    End If

    Dim endLabel As String
    endLabel = X64NextLabel(cg, "doeach_end")
    cg.loopDepth += 1
    If cg.loopDepth > 255 Then
        errText = "x64-codegen: loop nesting too deep"
        Return 0
    End If
    gX64LoopEndLabels(cg.loopDepth - 1) = endLabel
    gX64LoopKinds(cg.loopDepth - 1) = "DO"

    Dim arrInfoDo As UXBArrayMemoryInfo
    Dim arrDetectDo As Integer
    arrDetectDo = X64TryDetectArrayEachInfo(ps, itemsNode, arrInfoDo, errText)
    If arrDetectDo < 0 Then
        cg.loopDepth -= 1
        Return 0
    End If
    If arrDetectDo = 1 Then
        Dim arrResultDo As Integer
        arrResultDo = X64EmitArrayEachRuntimeLoop(ps, arrInfoDo, ps.ast.nodes(nodeIdx).value, ps.ast.nodes(nodeIdx).op, bodyNode, cg, endLabel, errText)
        X64EmitLabel cg, endLabel
        gX64LoopEndLabels(cg.loopDepth - 1) = ""
        cg.loopDepth -= 1
        Return arrResultDo
    End If

    Dim itemCount As Integer
    itemCount = X64ChildCount(ps, itemsNode)

    Dim i As Integer
    For i = 0 To itemCount - 1
        Dim itemExpr As Integer
        itemExpr = X64ChildAt(ps, itemsNode, i)
        If itemExpr = -1 Then
            errText = "x64-codegen: DO EACH item missing"
            Return 0
        End If
        If X64EmitExprToRax(ps, itemExpr, cg, errText) = 0 Then Return 0
        X64EmitStoreVar cg, ps.ast.nodes(nodeIdx).value

        Dim continueLabel As String = X64NextLabel(cg, "each_next")
        gX64LoopStepLabels(cg.loopDepth - 1) = continueLabel
        Dim bodyStmt As Integer
        bodyStmt = ps.ast.nodes(bodyNode).firstChild
        Do While bodyStmt <> -1
            If X64EmitNode(ps, bodyStmt, cg, errText) = 0 Then Return 0
            bodyStmt = ps.ast.nodes(bodyStmt).nextSibling
        Loop
        X64EmitLabel cg, continueLabel
    Next i

    X64EmitLabel cg, endLabel
    gX64LoopEndLabels(cg.loopDepth - 1) = ""
    cg.loopDepth -= 1
    Return 1
End Function

' S-300: true when the subtree holds a LABEL. A FINALLY emitted once per exit path (RETURN/CONTINUE/EXIT) would define it again (NASM duplicate label).
Private Function X64SubtreeHasLabel(ByRef ps As ParseState, ByVal rootIdx As Integer) As Integer
    If rootIdx < 0 Or rootIdx >= ps.ast.count Then Return 0
    If UCase(Trim(ps.ast.nodes(rootIdx).kind)) = "LABEL_STMT" Then Return 1
    Dim ch As Integer = ps.ast.nodes(rootIdx).firstChild
    Do While ch <> -1
        If X64SubtreeHasLabel(ps, ch) <> 0 Then Return 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

' S-300: an EXIT FOR/DO/WHILE leaves every TRY between the statement and the target loop; true when one of them has a FINALLY to run first.
Private Function X64ExitCrossesFinally(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef exitMode As String) As Integer
    Dim child As Integer = nodeIdx
    Dim ancestor As Integer = ps.ast.nodes(child).parent
    Do While ancestor >= 0
        Dim kindText As String = UCase(ps.ast.nodes(ancestor).kind)
        Dim kindLoop As String = ""
        If kindText = "FOR_STMT" Or kindText = "FOR_EACH_STMT" Then kindLoop = "FOR"
        If kindText = "DO_EACH_STMT" Then kindLoop = "DO"
        If kindText = "DO_STMT" Then kindLoop = IIf(UCase(ps.ast.nodes(ancestor).op) = "WHILE_WEND", "WHILE", "DO")
        If kindLoop <> "" And (exitMode = "ANY" Or exitMode = kindLoop) Then Exit Do
        If kindText = "LOCK_STMT" Then Return 1
        If kindText = "TRY_STMT" And UCase(ps.ast.nodes(child).kind) <> "FINALLY_PART" Then
            Dim part As Integer = ps.ast.nodes(ancestor).firstChild
            Do While part <> -1
                If UCase(ps.ast.nodes(part).kind) = "FINALLY_PART" Then Return 1
                part = ps.ast.nodes(part).nextSibling
            Loop
        End If
        child = ancestor
        ancestor = ps.ast.nodes(ancestor).parent
    Loop
    Return 0
End Function

Private Function X64EmitExitStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: EXIT"

    Dim exitMode As String
    exitMode = X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
    If exitMode = "" Then exitMode = "ANY"

    Dim isContinue As Integer = IIf(UCase(ps.ast.nodes(nodeIdx).kind) = "CONTINUE_STMT", 1, 0)
    If exitMode = "IF" Then
        If gX64IfDepth > 0 Then
            X64LockUnwindTransfer ps, nodeIdx, cg, "IF"
            X64EmitText cg, "    jmp " & gX64IfEndLabels(gX64IfDepth - 1)
            Return 1
        End If
    Else
        Dim loopIdx As Integer
        For loopIdx = cg.loopDepth - 1 To 0 Step -1
            If exitMode = "ANY" Or exitMode = gX64LoopKinds(loopIdx) Then
                ' S-300: EXIT FOR/DO/WHILE, like CONTINUE, runs the FINALLY of every TRY it leaves before the jump.
                If isContinue <> 0 Or X64ExitCrossesFinally(ps, nodeIdx, exitMode) <> 0 Then
                    Dim savedLoopDepth As Integer = cg.loopDepth
                    Dim savedIfDepth As Integer = gX64IfDepth
                    Dim savedIfEnds(0 To 255) As String
                    For savedIdx As Integer = 0 To savedIfDepth - 1
                        savedIfEnds(savedIdx) = gX64IfEndLabels(savedIdx)
                    Next savedIdx
                    Dim savedLoopVars(0 To 255) As String
                    Dim savedLoopKinds(0 To 255) As String
                    Dim savedLoopStartLabels(0 To 255) As String
                    Dim savedLoopEndLabels(0 To 255) As String
                    Dim savedLoopStepLabels(0 To 255) As String
                    Dim savedLoopLimitLabels(0 To 255) As String
                    For savedIdx As Integer = 0 To cg.loopDepth - 1
                        savedLoopVars(savedIdx) = gX64LoopVars(savedIdx)
                        savedLoopKinds(savedIdx) = gX64LoopKinds(savedIdx)
                        savedLoopStartLabels(savedIdx) = gX64LoopStartLabels(savedIdx)
                        savedLoopEndLabels(savedIdx) = gX64LoopEndLabels(savedIdx)
                        savedLoopStepLabels(savedIdx) = gX64LoopStepLabels(savedIdx)
                        savedLoopLimitLabels(savedIdx) = gX64LoopLimitLabels(savedIdx)
                    Next savedIdx
                    Dim child As Integer = nodeIdx
                    Dim ancestor As Integer = ps.ast.nodes(child).parent
                    Do While ancestor >= 0
                        Dim kindText As String = UCase(ps.ast.nodes(ancestor).kind)
                        Dim kindLoop As String = ""
                        If kindText = "FOR_STMT" Or kindText = "FOR_EACH_STMT" Then kindLoop = "FOR"
                        If kindText = "DO_EACH_STMT" Then kindLoop = "DO"
                        If kindText = "DO_STMT" Then kindLoop = IIf(UCase(ps.ast.nodes(ancestor).op) = "WHILE_WEND", "WHILE", "DO")
                        If kindLoop <> "" And (exitMode = "ANY" Or exitMode = kindLoop) Then Exit Do
                        If kindLoop <> "" And cg.loopDepth > 0 Then cg.loopDepth -= 1
                        If kindText = "IF_STMT" And gX64IfDepth > 0 Then gX64IfDepth -= 1
                        If kindText = "LOCK_STMT" Then X64LockLeave cg, ancestor
                        If kindText = "TRY_STMT" And UCase(ps.ast.nodes(child).kind) <> "FINALLY_PART" Then
                            Dim part As Integer = ps.ast.nodes(ancestor).firstChild
                            Do While part <> -1
                                If UCase(ps.ast.nodes(part).kind) = "FINALLY_PART" Then
                                    If X64SubtreeHasLabel(ps, part) <> 0 Then
                                        errText = "x64-codegen: a FINALLY block that contains a label cannot be run for CONTINUE/EXIT (it is emitted once per exit path and the label would be defined twice)"
                                        Return 0
                                    End If
                                    Dim finStmt As Integer = ps.ast.nodes(part).firstChild
                                    Do While finStmt <> -1
                                        If X64EmitNode(ps, finStmt, cg, errText) = 0 Then Return 0
                                        finStmt = ps.ast.nodes(finStmt).nextSibling
                                    Loop
                                    Exit Do
                                End If
                                part = ps.ast.nodes(part).nextSibling
                            Loop
                        End If
                        child = ancestor
                        ancestor = ps.ast.nodes(ancestor).parent
                    Loop
                    gX64IfDepth = savedIfDepth
                    For savedIdx As Integer = 0 To savedIfDepth - 1
                        gX64IfEndLabels(savedIdx) = savedIfEnds(savedIdx)
                    Next savedIdx
                    For savedIdx As Integer = 0 To savedLoopDepth - 1
                        gX64LoopVars(savedIdx) = savedLoopVars(savedIdx)
                        gX64LoopKinds(savedIdx) = savedLoopKinds(savedIdx)
                        gX64LoopStartLabels(savedIdx) = savedLoopStartLabels(savedIdx)
                        gX64LoopEndLabels(savedIdx) = savedLoopEndLabels(savedIdx)
                        gX64LoopStepLabels(savedIdx) = savedLoopStepLabels(savedIdx)
                        gX64LoopLimitLabels(savedIdx) = savedLoopLimitLabels(savedIdx)
                    Next savedIdx
                    cg.loopDepth = savedLoopDepth
                    X64EmitText cg, "    jmp " & IIf(isContinue <> 0, gX64LoopStepLabels(loopIdx), gX64LoopEndLabels(loopIdx))
                Else
                    X64EmitText cg, "    jmp " & gX64LoopEndLabels(loopIdx)
                End If
                Return 1
            End If
        Next loopIdx
    End If
    errText = "x64-codegen: loop transfer used outside matching control block"
    Return 0
End Function

Private Function X64EmitLabelStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim labelName As String
    labelName = Trim(ps.ast.nodes(nodeIdx).value)
    If labelName = "" Then
        errText = "x64-codegen: LABEL name missing"
        Return 0
    End If

    X64EmitLabel cg, X64ScopedLabelSymbol(cg, labelName)
    Return 1
End Function

Private Function X64EmitGotoStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim labelName As String
    labelName = Trim(ps.ast.nodes(nodeIdx).value)
    If labelName = "" Then
        errText = "x64-codegen: GOTO target missing"
        Return 0
    End If

    X64LockUnwindTransfer ps, nodeIdx, cg, "GOTO", labelName
    X64EmitText cg, "    jmp " & X64ScopedLabelSymbol(cg, labelName)
    Return 1
End Function

Private Function X64EmitGosubStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim labelName As String
    labelName = Trim(ps.ast.nodes(nodeIdx).value)
    If labelName = "" Then
        errText = "x64-codegen: GOSUB target missing"
        Return 0
    End If

    ' S-537: the number of GOSUBs that have not returned yet is counted, so a main-level RETURN that no GOSUB called can be
    ' reported (see X64EmitReturnStmt) instead of `ret`-ing into whatever the stack holds.
    X64EmitText cg, "    inc qword [rel __uxb_gosub_depth]"
    X64EmitText cg, "    call " & X64ScopedLabelSymbol(cg, labelName)
    X64EmitText cg, "    dec qword [rel __uxb_gosub_depth]"
    Return 1
End Function

Private Function X64EmitCallStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Return X64EmitCallNode(ps, nodeIdx, cg, errText)
End Function

Private Function X64EmitCoreScalarCastCall(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByVal argCount As Integer, ByRef castType As String, ByRef handledOut As Integer, ByRef errText As String) As Integer
    handledOut = 0
    Dim targetType As String
    If X64CoreScalarCastType(castType, targetType) = 0 Then Return 1
    handledOut = 1
    If argCount <> 1 Then
        errText = "x64-codegen: " & targetType & " conversion expects exactly one argument"
        Return 0
    End If

    Dim sourceNode As Integer
    sourceNode = X64ChildAt(ps, nodeIdx, 0)
    If sourceNode = -1 Then
        errText = "x64-codegen: " & targetType & " conversion source missing"
        Return 0
    End If

    Dim targetFloatKind As Integer
    targetFloatKind = X64TypeToFloatKind(targetType)
    If targetFloatKind = UXF_F32 Or targetFloatKind = UXF_F64 Then
        Return X64EmitExprToXmm0As(ps, sourceNode, cg, targetFloatKind, errText)
    End If

    Dim sourceFloatKind As Integer
    sourceFloatKind = X64InferFloatKindOfExpr(ps, sourceNode, cg)
    If sourceFloatKind = UXF_F32 Or sourceFloatKind = UXF_F64 Then
        If X64EmitExprToXmm0As(ps, sourceNode, cg, sourceFloatKind, errText) = 0 Then Return 0
        If targetType = "BOOLEAN" Then
            If sourceFloatKind = UXF_F32 Then
                X64EmitText cg, "    xorps xmm1, xmm1"
                X64EmitText cg, "    ucomiss xmm0, xmm1"
            Else
                X64EmitText cg, "    xorpd xmm1, xmm1"
                X64EmitText cg, "    ucomisd xmm0, xmm1"
            End If
            X64EmitText cg, "    setne al"
            X64EmitText cg, "    setp dl"
            X64EmitText cg, "    or al, dl"
            X64EmitText cg, "    movzx rax, al"
            X64EmitText cg, "    neg rax"
            Return 1
        End If
        If sourceFloatKind = UXF_F32 Then
            X64EmitText cg, "    cvttss2si rax, xmm0"
        Else
            X64EmitText cg, "    cvttsd2si rax, xmm0"
        End If
    Else
        If X64EmitExprToRax(ps, sourceNode, cg, errText) = 0 Then Return 0
    End If

    If X64TryEmitNarrowRegToType(cg, "rax", targetType) = 0 Then
        errText = "x64-codegen: unsupported scalar conversion target " & targetType
        Return 0
    End If
    Return 1
End Function

' Emits the narrowing that fits a value to a declared type's width, onto the
' given register.  One implementation shared by the type-name conversion call
' (I8(x) and friends) and by routine parameter entry, so "I8(255)" and
' "v AS I8" cannot drift apart on this backend.
'
' The accepted spellings deliberately include the long aliases (BYTE, SHORT,
' INTEGER, LONG, ...) because a parameter's declared type reaches here exactly
' as the user wrote it; matching only the short names would leave "x AS BYTE"
' un-narrowed here while every other engine narrowed it.  LONG is I32, per
' type_binding.fbs.  Kept in step with MIRX64NormalizeRegForType
' (mir_x64_emit_helpers.fbs), ExecApplyDeclaredType (exec_state_value_utils.fbs)
' and UXBInterpApplyDeclaredType (interp_value.fbs).
'
' Returns 1 when the type named a scalar this understands, 0 when it did not --
' STRING, objects and user types have no narrowing to apply, and the caller
' decides whether that is an error or simply means "leave the value alone".
Function X64TryEmitNarrowRegToType(ByRef cg As X64CodegenContext, ByRef regName As String, ByRef typeNameRaw As String) As Integer
    Dim t As String
    t = X64Upper(Trim(typeNameRaw))
    If t = "" Then Return 0
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)

    ' Sub-register spellings differ between rax and the numbered registers.
    Dim r8b As String, r16b As String, r32b As String
    Select Case LCase(Trim(regName))
    Case "rax"
        r8b = "al": r16b = "ax": r32b = "eax"
    Case "r10"
        r8b = "r10b": r16b = "r10w": r32b = "r10d"
    Case "r11"
        r8b = "r11b": r16b = "r11w": r32b = "r11d"
    Case Else
        Return 0
    End Select

    Select Case t
    Case "BOOLEAN", "BOOL"
        X64EmitText cg, "    cmp " & regName & ", 0"
        X64EmitText cg, "    setne " & r8b
        X64EmitText cg, "    movzx " & regName & ", " & r8b
        X64EmitText cg, "    neg " & regName
    Case "U8", "UBYTE"
        X64EmitText cg, "    movzx " & regName & ", " & r8b
    Case "U16", "USHORT"
        X64EmitText cg, "    movzx " & regName & ", " & r16b
    Case "U32", "UINTEGER", "UINT", "ULONG"
        X64EmitText cg, "    mov " & r32b & ", " & r32b
    Case "I8", "BYTE", "SBYTE"
        X64EmitText cg, "    movsx " & regName & ", " & r8b
    Case "I16", "SHORT"
        X64EmitText cg, "    movsx " & regName & ", " & r16b
    Case "I32", "INTEGER", "INT", "LONG"
        X64EmitText cg, "    movsxd " & regName & ", " & r32b
    Case "I64", "U64", "LONGINT", "ULONGINT", "PTR"
        ' Already the full register width; nothing to mask.
    Case Else
        Return 0
    End Select

    Return 1
End Function

Private Function X64EmitCallNodeSpecial(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef calleeName As String, ByVal argCount As Integer, ByRef builtinName As String, ByRef handledOut As Integer, ByRef errText As String) As Integer
    handledOut = 0
    If X64EmitCoreScalarCastCall(ps, nodeIdx, cg, argCount, builtinName, handledOut, errText) = 0 Then Return 0
    If handledOut <> 0 Then Return 1
    If X64IsDllCallNode(ps, nodeIdx) <> 0 Then
        handledOut = 1
        Return X64EmitDllCallNode(ps, nodeIdx, cg, errText)
    End If

    If builtinName = "CALL" Then
        Dim firstArg As Integer
        firstArg = X64ChildAt(ps, nodeIdx, 0)
        If firstArg <> -1 Then
            Dim firstKind As String
            firstKind = X64Upper(ps.ast.nodes(firstArg).kind)
            If (firstKind = "IDENT" Or firstKind = "KEYWORD_REF") And X64Upper(ps.ast.nodes(firstArg).value) = "DLL" Then
                handledOut = 1
                Return X64EmitDllCallNode(ps, nodeIdx, cg, errText)
            End If
        End If
    End If

    ' UXB_007_REL10_FIX_20260712:
    ' BIGINIT canonical surface returns the textual value payload.  The kind
    ' argument selects the external big-number family; arithmetic remains in
    ' the external runtime, while initialization/PRINT preserves exact text.
    If builtinName = "BIGINIT" Then
        handledOut = 1
        If argCount < 2 Or argCount > 3 Then
            errText = "x64-codegen: BIGINIT expects kind, value and optional precision"
            Return 0
        End If

        Dim bigKindNode As Integer
        Dim bigValueNode As Integer
        bigKindNode = X64ChildAt(ps, nodeIdx, 0)
        bigValueNode = X64ChildAt(ps, nodeIdx, 1)
        If bigKindNode = -1 Or bigValueNode = -1 Then
            errText = "x64-codegen: BIGINIT arguments missing"
            Return 0
        End If

        Dim bigKindNodeKind As String
        bigKindNodeKind = X64Upper(Trim(ps.ast.nodes(bigKindNode).kind))
        If bigKindNodeKind <> "IDENT" And bigKindNodeKind <> "KEYWORD_REF" And bigKindNodeKind <> "STRING" Then
            errText = "x64-codegen: BIGINIT kind must be a type name or string literal"
            Return 0
        End If
        Dim bigKindText As String
        bigKindText = X64Upper(Trim(ps.ast.nodes(bigKindNode).value))
        Dim bigKindLabel As String
        bigKindLabel = X64CreateCStringConstant(cg, bigKindText, "big_kind")

        If X64EmitExprToRax(ps, bigValueNode, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    push rax"
        If argCount = 3 Then
            If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 2), cg, errText) = 0 Then Return 0
        ElseIf bigKindText = "BIGD" Then
            X64EmitText cg, "    mov rax, 80"
        ElseIf bigKindText = "BIGI" Or bigKindText = "BIGINT" Then
            X64EmitText cg, "    xor rax, rax"
        Else
            X64EmitText cg, "    mov rax, 256"
        End If
        X64EmitText cg, "    mov r8d, eax"
        X64EmitText cg, "    pop rdx"
        X64EmitText cg, "    lea rcx, [rel " & bigKindLabel & "]"
        X64EmitCall0 cg, "__uxb_rt_biginit_text"
        Dim bigOkLabel As String
        bigOkLabel = X64NextLabel(cg, "biginit_ok")
        X64EmitText cg, "    test rax, rax"
        X64EmitText cg, "    jnz " & bigOkLabel
        X64EmitText cg, "    mov rcx, 70"
        X64EmitCall0 cg, "exit"
        X64EmitLabel cg, bigOkLabel
        Return 1
    End If

    If builtinName = "FIX" Then
        handledOut = 1
        If argCount <> 1 Then
            errText = "x64-codegen: FIX expects 1 argument"
            Return 0
        End If
        Dim fixArgNode As Integer
        fixArgNode = X64ChildAt(ps, nodeIdx, 0)
        Dim fixArgFloatKind As Integer
        fixArgFloatKind = X64InferFloatKindOfExpr(ps, fixArgNode, cg)
        If fixArgFloatKind = UXF_F32 Or fixArgFloatKind = UXF_F64 Then
            If X64EmitExprToXmm0As(ps, fixArgNode, cg, UXF_F64, errText) = 0 Then Return 0
            X64EmitText cg, "    cvttsd2si rax, xmm0"
            Return 1
        End If
        Return X64EmitExprToRax(ps, fixArgNode, cg, errText)
    End If

    If builtinName = "VARPTR" Then
        handledOut = 1
        If argCount <> 1 Then
            errText = "x64-codegen: VARPTR expects 1 argument"
            Return 0
        End If
        Dim ptrArg As Integer
        ptrArg = X64ChildAt(ps, nodeIdx, 0)
        If ptrArg = -1 Then
            errText = "x64-codegen: VARPTR argument missing"
            Return 0
        End If
        Dim ptrKind As String
        ptrKind = X64Upper(ps.ast.nodes(ptrArg).kind)
        If ptrKind <> "IDENT" And ptrKind <> "KEYWORD_REF" Then
            errText = "x64-codegen: VARPTR requires identifier argument"
            Return 0
        End If
        Dim ptrDeclType As String
        If X64FindDeclaredTypeName(ps, ps.ast.nodes(ptrArg).value, ptrDeclType) <> 0 Then
            If ptrDeclType = "OBJECT" Or X64FindClassDeclNode(ps, ptrDeclType) <> -1 Then
                X64EmitLoadVar cg, ps.ast.nodes(ptrArg).value
                Return 1
            End If
        End If
        Return X64EmitAddrOfVar(cg, ps.ast.nodes(ptrArg).value, errText)
    End If

    If builtinName = "OFFSETOF" Then
        handledOut = 1
        If argCount <> 2 Then
            errText = "x64-codegen: OFFSETOF expects 2 arguments"
            Return 0
        End If
        Dim typeNode As Integer
        Dim pathNode As Integer
        typeNode = X64ChildAt(ps, nodeIdx, 0)
        pathNode = X64ChildAt(ps, nodeIdx, 1)
        If typeNode = -1 Or pathNode = -1 Then
            errText = "x64-codegen: OFFSETOF arguments missing"
            Return 0
        End If
        Dim typeKind As String
        Dim pathKind As String
        typeKind = X64Upper(ps.ast.nodes(typeNode).kind)
        pathKind = X64Upper(ps.ast.nodes(pathNode).kind)
        If typeKind <> "IDENT" And typeKind <> "KEYWORD_REF" Then
            errText = "x64-codegen: OFFSETOF first argument must be type name"
            Return 0
        End If
        If pathKind <> "STRING" Then
            errText = "x64-codegen: OFFSETOF second argument must be path string"
            Return 0
        End If
        Dim offsetValue As Integer
        Dim offsetErr As String
        If TypeLayoutOffsetOf(ps, ps.ast.nodes(typeNode).value, ps.ast.nodes(pathNode).value, offsetValue, offsetErr) = 0 Then
            errText = "x64-codegen: OFFSETOF resolve failed " & offsetErr
            Return 0
        End If
        X64EmitText cg, "    mov rax, " & X64ToStr(offsetValue)
        Return 1
    End If

    If builtinName = "INSTANCEOF" Then
        handledOut = 1
        If argCount <> 2 Then
            errText = "x64-codegen: INSTANCEOF expects object and class"
            Return 0
        End If

        Dim objNode As Integer
        Dim classNode As Integer
        objNode = X64ChildAt(ps, nodeIdx, 0)
        classNode = X64ChildAt(ps, nodeIdx, 1)
        If objNode = -1 Or classNode = -1 Then
            errText = "x64-codegen: INSTANCEOF arguments missing"
            Return 0
        End If

        Dim className As String
        Dim classKind As String
        classKind = X64Upper(ps.ast.nodes(classNode).kind)
        If classKind = "STRING" Or classKind = "STRING_LITERAL" Or classKind = "IDENT" Or classKind = "KEYWORD_REF" Then
            className = Trim(ps.ast.nodes(classNode).value)
        Else
            errText = "x64-codegen: INSTANCEOF class argument must be class name"
            Return 0
        End If

        Dim classId As Integer
        classId = X64ClassTypeId(ps, className)
        If classId <= 0 Then
            errText = "x64-codegen: INSTANCEOF unknown class " & className
            Return 0
        End If

        If X64EmitExprToRax(ps, objNode, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    mov rcx, rax"
        X64EmitText cg, "    mov rdx, " & X64ToStr(classId)
        X64EmitText cg, "    call __uxb_runtime_instanceof"
        Return 1
    End If

    If builtinName = "PEEK" Or builtinName = "PEEKB" Or builtinName = "PEEKW" Or builtinName = "PEEKD" Or builtinName = "PEEKQ" Then
        handledOut = 1
        Dim peekModeValue As Integer
        Dim peekArgOffset As Integer
        X64MemModeFromArgs ps, nodeIdx, peekModeValue, peekArgOffset
        If argCount <> peekArgOffset + 1 Then
            errText = "x64-codegen: " & builtinName & " expects [mode,]address"
            Return 0
        End If
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, peekArgOffset), cg, errText) = 0 Then Return 0
        X64EmitText cg, "    mov rcx, rax"
        X64EmitText cg, "    mov rdx, " & X64ToStr(peekModeValue)
        Select Case builtinName
        Case "PEEKB"
            X64EmitCall0 cg, "__uxb_mem_loadb_mode"
        Case "PEEKW"
            X64EmitCall0 cg, "__uxb_mem_loadw_mode"
        Case "PEEKQ"
            X64EmitCall0 cg, "__uxb_mem_loadq_mode"
        Case Else
            X64EmitCall0 cg, "__uxb_mem_loadd_mode"
        End Select
        Return 1
    End If

    If builtinName = "PEEKS" Then
        ' S-062/S-059: PEEKS had NO codegen at all in this legacy backend
        ' (the "_mode" runtime helper __uxb_mem_peeks_mode already existed,
        ' fully correct, but nothing ever called it -- see AST's identical
        ' gap, fixed the same way in exec_eval_text_helpers.fbs).
        handledOut = 1
        Dim peeksModeValue As Integer
        Dim peeksArgOffset As Integer
        X64MemModeFromArgs ps, nodeIdx, peeksModeValue, peeksArgOffset
        If argCount <> peeksArgOffset + 2 Then
            errText = "x64-codegen: PEEKS expects [mode,]address,length"
            Return 0
        End If
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, peeksArgOffset), cg, errText) = 0 Then Return 0
        X64EmitText cg, "    push rax"
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, peeksArgOffset + 1), cg, errText) = 0 Then Return 0
        X64EmitText cg, "    mov rdx, rax"
        X64EmitText cg, "    pop rcx"
        X64EmitText cg, "    mov r8, " & X64ToStr(peeksModeValue)
        X64EmitCall0 cg, "__uxb_mem_peeks_mode"
        Return 1
    End If

    Return 1
End Function

Private Function X64EmitBuiltinCall(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef builtinName As String, ByVal argCount As Integer, ByRef handledOut As Integer, ByRef errText As String) As Integer
    handledOut = 0

    ' S-079: SIZEOF is a compile-time constant here too. The legacy backend had
    ' no SIZEOF at all (the call fell through to an undefined `SIZEOF` symbol and
    ' NASM failed). Array bytes and type sizes come from the same two sources the
    ' AST interpreter and the MIR lowering use.
    If UCase(builtinName) = "SIZEOF" And argCount = 1 Then
        Dim sizeofArg As Integer
        sizeofArg = X64ChildAt(ps, nodeIdx, 0)
        If sizeofArg <> -1 Then
            Dim sizeofArgKind As String
            sizeofArgKind = X64Upper(ps.ast.nodes(sizeofArg).kind)
            If sizeofArgKind = "IDENT" Or sizeofArgKind = "KEYWORD_REF" Then
                Dim sizeofName As String
                Dim sizeofArrayInfo As UXBArrayMemoryInfo
                Dim sizeofArrayErr As String
                Dim sizeofValue As Integer
                Dim sizeofLayoutErr As String
                sizeofName = Trim(ps.ast.nodes(sizeofArg).value)
                If UXBFindArrayMemoryInfo(ps, sizeofName, sizeofArrayInfo, sizeofArrayErr) <> 0 Then
                    If sizeofArrayInfo.found <> 0 And sizeofArrayInfo.dynamicBounds = 0 Then
                        X64EmitText cg, "    mov rax, " & LTrim(Str(sizeofArrayInfo.byteLength))
                        handledOut = 1
                        Return 1
                    End If
                End If
                If TypeLayoutSizeOf(ps, sizeofName, sizeofValue, sizeofLayoutErr) <> 0 Then
                    X64EmitText cg, "    mov rax, " & LTrim(Str(sizeofValue))
                    handledOut = 1
                    Return 1
                End If
                errText = "x64-codegen: SIZEOF failed " & sizeofLayoutErr
                Return 0
            End If
        End If
    End If

    ' S-101: LBOUND/UBOUND(array [, dimension]). The legacy backend keeps no run-time array
    ' descriptor (a parameter is a biased base pointer), so only a one-dimensional array declared
    ' ONCE with compile-time bounds folds to a constant here; every other form is refused with a
    ' clear message instead of computing something wrong (default MIR-x64 supports them all).
    If UCase(builtinName) = "LBOUND" Or UCase(builtinName) = "UBOUND" Then
        handledOut = 1
        Dim bndLabel As String
        bndLabel = UCase(builtinName)
        If argCount < 1 Or argCount > 2 Then
            errText = "x64-codegen: " & bndLabel & " expects (array [, dimension])"
            Return 0
        End If
        Dim bndArrNode As Integer
        bndArrNode = X64ChildAt(ps, nodeIdx, 0)
        Dim bndArrKind As String
        bndArrKind = X64Upper(ps.ast.nodes(bndArrNode).kind)
        If bndArrKind <> "IDENT" And bndArrKind <> "KEYWORD_REF" And bndArrKind <> "IDENTIFIER" Then
            errText = "x64-codegen: " & bndLabel & " needs an array variable as its first argument"
            Return 0
        End If
        Dim bndDim As Integer
        bndDim = 1
        If argCount = 2 Then
            Dim bndDimNode As Integer
            bndDimNode = X64ChildAt(ps, nodeIdx, 1)
            If X64Upper(ps.ast.nodes(bndDimNode).kind) <> "NUMBER" Then
                errText = "x64-codegen: " & bndLabel & " dimension must be an integer literal"
                Return 0
            End If
            bndDim = ValInt(Trim(ps.ast.nodes(bndDimNode).value))
        End If
        Dim bndName As String
        bndName = Trim(ps.ast.nodes(bndArrNode).value)
        Dim bndDeclCount As Integer
        bndDeclCount = 0
        Dim bndScan As Integer
        For bndScan = 0 To ps.ast.count - 1
            Dim bndScanKind As String
            bndScanKind = X64Upper(ps.ast.nodes(bndScan).kind)
            If bndScanKind <> "DIM_DECL" And bndScanKind <> "REDIM_DECL" Then Continue For
            If X64Upper(Trim(ps.ast.nodes(bndScan).value)) = X64Upper(bndName) Then bndDeclCount += 1
        Next bndScan
        ' S-529: the bounds of a dynamic scalar array are read from its descriptor (qword 1 = lower, qword 2 = upper)
        If X64SdaKind(ps, bndName) <> 0 Then
            If bndDim <> 1 Then
                errText = "x64-codegen: " & bndLabel & " dimension " & LTrim(Str(bndDim)) & " is out of range: array " & bndName & " has 1 dimension"
                Return 0
            End If
            If X64SdaDescriptorToReg(cg, bndName, "rcx") = 0 Then
                errText = "x64-codegen: " & bndLabel & " dynamic array descriptor missing: " & bndName
                Return 0
            End If
            X64EmitText cg, IIf(bndLabel = "UBOUND", "    mov rax, [rcx + 16]", "    mov rax, [rcx + 8]")
            Return 1
        End If
        Dim bndInfo As UXBArrayMemoryInfo
        Dim bndInfoErr As String
        If UXBFindArrayMemoryInfo(ps, bndName, bndInfo, bndInfoErr) <> 0 Then
            If bndInfo.found <> 0 And bndInfo.dynamicBounds = 0 And bndDeclCount = 1 Then
                If bndDim <> 1 Then
                    errText = "x64-codegen: " & bndLabel & " dimension " & LTrim(Str(bndDim)) & " is out of range: array " & bndName & " has 1 dimension"
                    Return 0
                End If
                X64EmitText cg, "    mov rax, " & LTrim(Str(IIf(bndLabel = "UBOUND", bndInfo.upperBound, bndInfo.lowerBound)))
                Return 1
            End If
        End If
        errText = "x64-codegen: the legacy AST-x64 backend supports " & bndLabel & " only for a one-dimensional array declared once with compile-time bounds; arrays with REDIM or run-time bounds, array parameters and several dimensions need the default MIR-x64 backend"
        Return 0
    End If

    ' S-076: a legacy STRING value already IS a pointer to its NUL-terminated character
    ' data (immutable blocks; LEN/ASC/PRINT consume it as such), so SADD is the identity.
    If UCase(builtinName) = "SADD" And argCount = 1 Then
        Dim sadArgNode As Integer
        sadArgNode = X64ChildAt(ps, nodeIdx, 0)
        If sadArgNode = -1 Then
            errText = "x64-codegen: SADD argument missing"
            Return 0
        End If
        If X64ExprIsStringLike(ps, sadArgNode, cg) = 0 Then
            errText = "x64-codegen: SADD requires a STRING argument"
            Return 0
        End If
        If X64EmitExprToRax(ps, sadArgNode, cg, errText) = 0 Then Return 0
        handledOut = 1
        Return 1
    End If

    ' S-076: CODEPTR(routine) / LPTR(label) are the real code / label address here,
    ' exactly as in the MIR-x64 backend (the call used to fall through to an undefined
    ' CODEPTR/LPTR symbol and NASM failed). LPTR also accepts a routine name.
    If (UCase(builtinName) = "CODEPTR" Or UCase(builtinName) = "LPTR") And argCount = 1 Then
        Dim ptrArgNode As Integer
        ptrArgNode = X64ChildAt(ps, nodeIdx, 0)
        If ptrArgNode = -1 Then
            errText = "x64-codegen: " & UCase(builtinName) & " argument missing"
            Return 0
        End If
        Dim ptrArgKind As String
        ptrArgKind = X64Upper(ps.ast.nodes(ptrArgNode).kind)
        If ptrArgKind <> "IDENT" And ptrArgKind <> "KEYWORD_REF" Then
            errText = "x64-codegen: " & UCase(builtinName) & " needs a routine or label name"
            Return 0
        End If
        Dim ptrTargetName As String
        Dim ptrRoutineSymbol As String
        ptrTargetName = Trim(ps.ast.nodes(ptrArgNode).value)
        If X64FindRoutineSymbolName(ps, ptrTargetName, ptrRoutineSymbol) <> 0 Then
            X64EmitText cg, "    lea rax, [rel " & ptrRoutineSymbol & "]"
        ElseIf UCase(builtinName) = "LPTR" Then
            X64EmitText cg, "    lea rax, [rel " & X64ScopedLabelSymbol(cg, ptrTargetName) & "]"
        Else
            errText = "x64-codegen: CODEPTR operand is not a declared SUB/FUNCTION: " & ptrTargetName
            Return 0
        End If
        handledOut = 1
        Return 1
    End If

    Dim builtinSymbol As String
    builtinSymbol = X64BuiltinCallSymbol(builtinName)
    If builtinSymbol = "" Then Return 1
    ' S-144: INSTR(start, haystack, needle) has its own entry (rcx = start, rdx = haystack, r8 = needle)
    If builtinSymbol = "__uxb_builtin_instr" And argCount = 3 Then builtinSymbol = "__uxb_builtin_instr3"
    handledOut = 1

    If UCase(builtinName) = "STR" And argCount = 1 Then
        ' S-142b: STR of any floating expression (not only a plain F64 variable) goes through the shared
        ' float-to-text emitter; it used to skip the variadic register copy (xmm2/r8) and crash.
        Dim strArg As Integer
        strArg = X64ChildAt(ps, nodeIdx, 0)
        If strArg <> -1 Then
            If X64ExprIsStringLike(ps, strArg, cg) <> 0 Then
                Return X64EmitExprToRax(ps, strArg, cg, errText)
            End If
            Dim strFloatKind As Integer
            strFloatKind = X64InferFloatKindOfExpr(ps, strArg, cg)
            If strFloatKind = UXF_F32 Or strFloatKind = UXF_F64 Then
                If X64EmitExprToXmm0As(ps, strArg, cg, UXF_F64, errText) = 0 Then Return 0
                X64EmitFloatToStrBuf cg, IIf(strFloatKind = UXF_F32, 1, 0)
                Return 1
            End If
        End If
    End If

    Dim upBuiltin As String
    upBuiltin = X64Upper(builtinName)
    If (upBuiltin = "INT" Or upBuiltin = "FIX" Or upBuiltin = "CINT" Or upBuiltin = "CLNG") And argCount = 1 Then
        Dim intArgNode As Integer
        Dim intArgFloatKind As Integer
        intArgNode = X64ChildAt(ps, nodeIdx, 0)
        intArgFloatKind = X64InferFloatKindOfExpr(ps, intArgNode, cg)
        If intArgFloatKind = UXF_F32 Or intArgFloatKind = UXF_F64 Then
            If X64EmitExprToXmm0As(ps, intArgNode, cg, UXF_F64, errText) = 0 Then Return 0
            ' CINT/CLNG use the active IEEE rounding mode (the platform default
            ' is nearest); FIX truncates toward zero; INT then adjusts negatives
            ' to floor.  Keep this inline so a floating argument is never passed
            ' as its raw IEEE bit pattern through the integer-only builtin ABI.
            If upBuiltin = "CINT" Or upBuiltin = "CLNG" Then
                X64EmitText cg, "    cvtsd2si rax, xmm0"
            Else
                X64EmitText cg, "    cvttsd2si rax, xmm0"
            End If
            If upBuiltin = "INT" Then
                Dim intFloorDone As String
                intFloorDone = X64NextLabel(cg, "int_floor_done")
                X64EmitText cg, "    cvtsi2sd xmm1, rax"
                X64EmitText cg, "    ucomisd xmm0, xmm1"
                X64EmitText cg, "    jae " & intFloorDone
                X64EmitText cg, "    dec rax"
                X64EmitLabel cg, intFloorDone
            End If
        Else
            If X64EmitExprToRax(ps, intArgNode, cg, errText) = 0 Then Return 0
        End If
        ' Do not fall through to a synthetic external symbol for the integer
        ' case.  CINT still has its declared 32-bit result width; the remaining
        ' integer conversions are identity operations on an already integral
        ' input.
        If upBuiltin = "CINT" Then
            If X64TryEmitNarrowRegToType(cg, "rax", "I32") = 0 Then
                errText = "x64-codegen: CINT result narrowing unavailable"
                Return 0
            End If
        End If
        Return 1
    End If
    If upBuiltin = "SQR" Or upBuiltin = "SIN" Or upBuiltin = "COS" Or upBuiltin = "TAN" Or upBuiltin = "ATN" Or upBuiltin = "EXP" Or upBuiltin = "LOG" Then
        Select Case argCount
        Case 0
            X64EmitText cg, "    xorps xmm0, xmm0"
        Case 1
            If X64EmitExprToXmm0(ps, X64ChildAt(ps, nodeIdx, 0), cg, errText) = 0 Then Return 0
        Case Else
            errText = "x64-codegen: float builtin " & builtinName & " unsupported argcount=" & X64ToStr(argCount)
            Return 0
        End Select
        ' S-144: aligned at run time (see X64EmitCall0)
        X64EmitCall0 cg, builtinSymbol
        Return 1
    End If

    If upBuiltin = "TIMER" And argCount = 0 Then
        ' S-624: TIMER F64'tur (yerel gece yarisindan beri kesirli saniye; src/common/uxb_clock.fbs ile ayni tanim),
        ' sonuc XMM0'dadir. Eski __uxb_builtin_timer yardimcisi RDX/R8'in bayat degerine bakip RAX'ta
        ' GetTickCount64 dondurdugu icin F64 degiskene 0 ya da cop sayi yaziyordu.
        X64EmitCall0 cg, "__uxb_rt_timer_f64"
        Return 1
    End If

    Select Case argCount
    Case 0
        X64EmitCall0 cg, builtinSymbol
        Return 1
    Case 1
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 0), cg, errText) = 0 Then Return 0
        X64EmitCall1 cg, builtinSymbol
        Return 1
    Case 2
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 0), cg, errText) = 0 Then Return 0
        X64EmitText cg, "    push rax"
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 1), cg, errText) = 0 Then Return 0
        If upBuiltin = "MID" Or upBuiltin = "MID$" Then
            X64EmitText cg, "    push rax"
            X64EmitText cg, "    mov rax, -1"
            X64EmitCall3 cg, builtinSymbol
        Else
            X64EmitCall2 cg, builtinSymbol
        End If
        Return 1
    Case 3
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 0), cg, errText) = 0 Then Return 0
        X64EmitText cg, "    push rax"
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 1), cg, errText) = 0 Then Return 0
        X64EmitText cg, "    push rax"
        If X64EmitExprToRax(ps, X64ChildAt(ps, nodeIdx, 2), cg, errText) = 0 Then Return 0
        X64EmitCall3 cg, builtinSymbol
        Return 1
    Case Else
        errText = "x64-codegen: builtin argument count not supported for " & builtinName
        Return 0
    End Select
End Function

' S-097/TUR7: the argument is the address of (data, lower, upper).
' Static views live in this invocation's stack frame, never global scratch.
Private Function X64EmitArrayArgBaseToRax(ByRef ps As ParseState, ByVal argNode As Integer, ByRef cg As X64CodegenContext, ByRef errText As String, ByVal descScratchOffset As Integer) As Integer
    If argNode < 0 Or argNode >= ps.ast.count Then Return 0
    Dim argKind As String
    argKind = X64Upper(ps.ast.nodes(argNode).kind)
    If argKind <> "IDENT" And argKind <> "IDENTIFIER" Then
        errText = "x64-codegen: an array parameter needs an array name as its argument"
        Return 0
    End If
    Dim argName As String
    argName = Trim(ps.ast.nodes(argNode).value)

    Dim paramStride As Integer
    Dim slotOffset As Integer
    Dim slotCount As Integer
    Dim labelText As String

    If cg.currentRoutineLabel <> "" Then
        If X64ParamArrayElemBytes(cg, argName, paramStride) <> 0 Then
            ' Forward the descriptor unchanged; its owner is the live caller.
            If X64TryFindLocalOffset(cg, argName, slotOffset) = 0 Then
                errText = "x64-codegen: array parameter slot missing: " & argName
                Return 0
            End If
            X64EmitText cg, "    mov rax, " & X64FormatRbpRef(slotOffset)
            Return 1
        End If
    End If

    If X64DcaDescriptor(ps, cg, argName, "rax") <> 0 Then Return 1

    ' Dynamic arrays already own a compatible live descriptor.
    If X64SdaKind(ps, argName) <> 0 Then
        If X64SdaDescriptorToReg(cg, argName, "rax") = 0 Then
            errText = "x64-codegen: dynamic array argument has no descriptor: " & argName
            Return 0
        End If
        Return 1
    End If

    Dim arrInfo As UXBArrayMemoryInfo
    Dim arrInfoErr As String
    If UXBFindArrayMemoryInfo(ps, argName, arrInfo, arrInfoErr) = 0 Or arrInfo.found = 0 Then
        errText = "x64-codegen: argument is not a declared array: " & argName
        Return 0
    End If
    If arrInfo.dynamicBounds <> 0 Then
        errText = "x64-codegen: array argument bounds unavailable: " & argName
        Return 0
    End If
    If descScratchOffset < 0 Then
        errText = "x64-codegen: array descriptor scratch offset missing"
        Return 0
    End If

    If cg.currentRoutineLabel <> "" Then
        If X64TryFindLocalInfo(cg, argName, slotOffset, slotCount) <> 0 Then
            X64EmitText cg, "    lea r10, " & X64FormatRbpRef(slotOffset)
        ElseIf X64TryFindGlobalInfo(cg, argName, labelText, slotCount) <> 0 Then
            X64EmitText cg, "    lea r10, [rel " & labelText & "]"
        Else
            errText = "x64-codegen: array argument has no storage: " & argName
            Return 0
        End If
    Else
        If X64TryFindGlobalInfo(cg, argName, labelText, slotCount) = 0 Then
            errText = "x64-codegen: array argument has no storage: " & argName
            Return 0
        End If
        X64EmitText cg, "    lea r10, [rel " & labelText & "]"
    End If
    X64EmitText cg, "    mov qword [rsp + " & X64ToStr(descScratchOffset) & "], r10"
    X64EmitText cg, "    mov r10, " & LTrim(Str(arrInfo.lowerBound))
    X64EmitText cg, "    mov qword [rsp + " & X64ToStr(descScratchOffset + 8) & "], r10"
    X64EmitText cg, "    mov r10, " & LTrim(Str(arrInfo.upperBound))
    X64EmitText cg, "    mov qword [rsp + " & X64ToStr(descScratchOffset + 16) & "], r10"
    X64EmitText cg, "    lea rax, [rsp + " & X64ToStr(descScratchOffset) & "]"
    Return 1
End Function

Private Function X64CreateCallTextSlot(ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If gX64CallTextCount >= 2048 Then errText = "x64-codegen: STRING argument frame capacity exceeded": Return 0
    If cg.localCount >= 2048 Then errText = "x64-codegen: STRING argument local capacity exceeded": Return 0
    Dim textName As String = X64NextLabel(cg, "call_text")
    Dim textOffset As Integer = X64EnsureLocalSlot(cg, textName, 1, 8)
    X64EmitText cg, "    mov qword " & X64FormatRbpRef(textOffset) & ", 0"
    gX64CallTextOffsets(gX64CallTextCount) = textOffset
    gX64CallTextCount += 1
    Return textOffset
End Function

Private Sub X64StoreCallText(ByRef cg As X64CodegenContext, ByVal textOffset As Integer)
    X64EmitText cg, "    mov rdx, rax"
    X64EmitText cg, "    lea rcx, " & X64FormatRbpRef(textOffset)
    X64EmitCall0 cg, "__uxb_rt_str_store"
    X64EmitText cg, "    mov rax, " & X64FormatRbpRef(textOffset)
End Sub

Private Sub X64ReleaseCallText(ByRef cg As X64CodegenContext, ByVal firstText As Integer)
    For textIndex As Integer = gX64CallTextCount - 1 To firstText Step -1
        X64EmitText cg, "    lea rcx, " & X64FormatRbpRef(gX64CallTextOffsets(textIndex))
        X64EmitCall0 cg, "__uxb_rt_str_release"
    Next textIndex
    gX64CallTextCount = firstText
End Sub

Private Function X64EmitRoutineArgToRax(ByRef ps As ParseState, ByVal argNode As Integer, ByRef cg As X64CodegenContext, ByRef paramType As String, ByRef errText As String, ByVal descScratchOffset As Integer = -1) As Integer
    If Right(X64Upper(Trim(paramType)), 2) = "[]" Then Return X64EmitArrayArgBaseToRax(ps, argNode, cg, errText, descScratchOffset)
    Dim textOffset As Integer
    If X64TypeNameIsStringLike(paramType) <> 0 Then
        textOffset = X64CreateCallTextSlot(cg, errText)
        If textOffset = 0 Then Return 0
    End If
    Return X64SyncEmitArgument(ps, argNode, cg, 0, errText, textOffset)
End Function

Private Function X64EmitRoutineCallRaw(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef calleeName As String, ByVal argCount As Integer, ByVal methodPrependReceiver As Integer, ByRef methodReceiverOwner As String, ByRef methodReceiverType As String, ByRef methodName As String, ByVal methodVirtualSlot As Integer, ByVal methodReceiverNodeIdx As Integer, ByRef errText As String, ByVal argNodeOffset As Integer) As Integer
    Dim expectedArgCount As Integer
    Dim calleeIsFunction As Integer
    Dim actualArgCount As Integer
    actualArgCount = argCount + methodPrependReceiver

    If X64TryGetRoutineSignature(cg, calleeName, expectedArgCount, calleeIsFunction) <> 0 Then
        If actualArgCount <> expectedArgCount Then
            errText = "x64-codegen: argument count mismatch for " & calleeName & " expected=" & X64ToStr(expectedArgCount) & " actual=" & X64ToStr(actualArgCount)
            Return 0
        End If
    End If

    Dim regOrder(0 To 3) As String
    regOrder(0) = "rcx"
    regOrder(1) = "rdx"
    regOrder(2) = "r8"
    regOrder(3) = "r9"

    Dim xmmRegOrder(0 To 3) As String
    xmmRegOrder(0) = "xmm0"
    xmmRegOrder(1) = "xmm1"
    xmmRegOrder(2) = "xmm2"
    xmmRegOrder(3) = "xmm3"

    Dim stackArgCount As Integer
    stackArgCount = 0
    If actualArgCount > 4 Then stackArgCount = actualArgCount - 4

    Dim regSpillSlots As Integer
    regSpillSlots = actualArgCount
    If regSpillSlots > 4 Then regSpillSlots = 4

    ' S-533: the stack is aligned at RUN TIME, like X64EmitCall0 does for the C runtime (S-144). A call that is the right
    ' operand of a binary operation is emitted while the left value sits on the stack (`push rax`), so RSP is 8 mod 16
    ' there; the callee then started misaligned and crashed in its first `printf`/`sprintf` (SSE aligned access, exit code
    ' 0xC0000005, nothing printed). The caller's RSP is kept in one extra slot above the spill slots and put back after the call.
    Dim savedRspOffset As Integer
    savedRspOffset = 32 + (stackArgCount * 8) + (regSpillSlots * 8)
    ' TUR7: reserve descriptor scratch only for array arguments. Scalar-only
    ' calls retain their previous frame size, unlike 24 * every argument.
    Dim arrayDescOffset(Any) As Integer
    Dim arrayDescBytes As Integer = 0
    If argCount > 0 Then
        ReDim arrayDescOffset(0 To argCount - 1)
        For ai As Integer = 0 To argCount - 1
            arrayDescOffset(ai) = -1
            Dim atype As String
            If X64TryGetRoutineParamType(cg, calleeName, ai + methodPrependReceiver, atype) <> 0 Then
                If Right(X64Upper(Trim(atype)), 2) = "[]" Then
                    arrayDescOffset(ai) = savedRspOffset + 8 + arrayDescBytes
                    arrayDescBytes += 24
                End If
            End If
        Next ai
    End If
    Dim reserveBytes As Integer
    reserveBytes = savedRspOffset + 8 + arrayDescBytes
    If (reserveBytes Mod 16) <> 0 Then reserveBytes += 8
    X64EmitText cg, "    mov r11, rsp"
    X64EmitText cg, "    sub rsp, " & X64ToStr(reserveBytes)
    X64EmitText cg, "    and rsp, -16"
    X64EmitText cg, "    mov [rsp + " & X64ToStr(savedRspOffset) & "], r11"

    If methodPrependReceiver <> 0 Then
        If methodReceiverNodeIdx <> -1 Then
            If X64EmitExprToRax(ps, methodReceiverNodeIdx, cg, errText) = 0 Then Return 0
        ElseIf methodReceiverType = "" Or methodReceiverType = "OBJECT" Or X64FindClassDeclNode(ps, methodReceiverType) <> -1 Or X64InterfaceMethodNode(ps, methodReceiverType, methodName) <> -1 Then
            X64EmitLoadVar cg, methodReceiverOwner
        Else
            If X64EmitAddrOfVar(cg, methodReceiverOwner, errText) = 0 Then Return 0
        End If
        Dim recvSpillOffset As Integer
        recvSpillOffset = 32 + (stackArgCount * 8)
        X64EmitText cg, "    mov [rsp + " & X64ToStr(recvSpillOffset) & "], rax"
    End If

    Dim i As Integer
    For i = 0 To argCount - 1
        Dim argNode As Integer
        argNode = X64ChildAt(ps, nodeIdx, i + argNodeOffset)
        If argNode = -1 Then Continue For
        Dim dstIndex As Integer
        dstIndex = i + methodPrependReceiver
        Dim argType As String
        Dim argFloatKind As Integer
        argType = ""
        argFloatKind = 0
        If X64TryGetRoutineParamType(cg, calleeName, dstIndex, argType) <> 0 Then argFloatKind = X64TypeToFloatKind(argType)
        If dstIndex < 4 Then
            Dim spillOffset As Integer
            spillOffset = 32 + (stackArgCount * 8) + (dstIndex * 8)
            If argFloatKind = UXF_F32 Or argFloatKind = UXF_F64 Then
                If X64SyncEmitArgument(ps, argNode, cg, argFloatKind, errText) = 0 Then Return 0
                X64EmitText cg, "    mov qword [rsp + " & X64ToStr(spillOffset) & "], 0"
                If argFloatKind = UXF_F32 Then
                    X64EmitText cg, "    movss [rsp + " & X64ToStr(spillOffset) & "], xmm0"
                Else
                    X64EmitText cg, "    movsd [rsp + " & X64ToStr(spillOffset) & "], xmm0"
                End If
            Else
                If X64EmitRoutineArgToRax(ps, argNode, cg, argType, errText, arrayDescOffset(i)) = 0 Then Return 0
                X64EmitText cg, "    mov [rsp + " & X64ToStr(spillOffset) & "], rax"
            End If
        Else
            Dim stackOffset As Integer
            stackOffset = 32 + ((dstIndex - 4) * 8)
            If argFloatKind = UXF_F32 Or argFloatKind = UXF_F64 Then
                If X64SyncEmitArgument(ps, argNode, cg, argFloatKind, errText) = 0 Then Return 0
                X64EmitText cg, "    mov qword [rsp + " & X64ToStr(stackOffset) & "], 0"
                If argFloatKind = UXF_F32 Then
                    X64EmitText cg, "    movss [rsp + " & X64ToStr(stackOffset) & "], xmm0"
                Else
                    X64EmitText cg, "    movsd [rsp + " & X64ToStr(stackOffset) & "], xmm0"
                End If
            Else
                If X64EmitRoutineArgToRax(ps, argNode, cg, argType, errText, arrayDescOffset(i)) = 0 Then Return 0
                X64EmitText cg, "    mov [rsp + " & X64ToStr(stackOffset) & "], rax"
            End If
        End If
    Next i

    For i = 0 To regSpillSlots - 1
        Dim loadOffset As Integer
        loadOffset = 32 + (stackArgCount * 8) + (i * 8)
        Dim loadParamType As String
        Dim loadFloatKind As Integer
        loadParamType = ""
        loadFloatKind = 0
        If X64TryGetRoutineParamType(cg, calleeName, i, loadParamType) <> 0 Then loadFloatKind = X64TypeToFloatKind(loadParamType)
        If loadFloatKind = UXF_F32 Then
            X64EmitText cg, "    movss " & xmmRegOrder(i) & ", [rsp + " & X64ToStr(loadOffset) & "]"
        ElseIf loadFloatKind = UXF_F64 Then
            X64EmitText cg, "    movsd " & xmmRegOrder(i) & ", [rsp + " & X64ToStr(loadOffset) & "]"
        Else
            X64EmitText cg, "    mov " & regOrder(i) & ", [rsp + " & X64ToStr(loadOffset) & "]"
        End If
    Next i

    ' A typed TASK/PIPE direct call uses the normal Win64 ABI, but the
    ' language-level task context remains observable through TASKIN/TASKOUT.
    ' Store the already-evaluated first argument here (rather than evaluating
    ' the AST expression a second time) so side effects occur exactly once.
    If X64Upper(ps.ast.nodes(nodeIdx).kind) = "TRIGGER_STMT" And argNodeOffset = 1 And methodPrependReceiver = 0 Then
        Dim directTaskInputLabel As String
        Dim directTaskOutputLabel As String
        directTaskInputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_INPUT_NAME, 1, 8)
        directTaskOutputLabel = X64EnsureGlobalSymbol(cg, UXB_TASK_RESULT_NAME, 1, 8)
        If actualArgCount > 0 Then
            Dim directTaskInputType As String
            Dim directTaskInputFloatKind As Integer
            directTaskInputType = ""
            directTaskInputFloatKind = 0
            If X64TryGetRoutineParamType(cg, calleeName, 0, directTaskInputType) <> 0 Then directTaskInputFloatKind = X64TypeToFloatKind(directTaskInputType)
            If directTaskInputFloatKind = UXF_F32 Then
                X64EmitText cg, "    movd eax, xmm0"
                X64EmitText cg, "    mov [rel " & directTaskInputLabel & "], rax"
            ElseIf directTaskInputFloatKind = UXF_F64 Then
                X64EmitText cg, "    movq rax, xmm0"
                X64EmitText cg, "    mov [rel " & directTaskInputLabel & "], rax"
            Else
                X64EmitText cg, "    mov [rel " & directTaskInputLabel & "], rcx"
            End If
        Else
            X64EmitText cg, "    mov qword [rel " & directTaskInputLabel & "], 0"
        End If
        X64EmitText cg, "    mov qword [rel " & directTaskOutputLabel & "], 0"
    End If

    If methodPrependReceiver <> 0 Then
        ' S-037: a method call on a null object reference is a clean runtime error. The
        ' virtual path below returned 0 SILENTLY for a null receiver and the direct path
        ' called the method with THIS = 0 (rcx holds the receiver here).
        Dim recvOkLbl As String
        Dim recvMsgLbl As String
        recvOkLbl = X64NextLabel(cg, "recv_ok")
        recvMsgLbl = X64NextLabel(cg, "recv_null_msg")
        X64EmitData cg, recvMsgLbl & ": db ""uXBasic runtime error: method call on a null object reference: " & X64Upper(Trim(methodName)) & """, 10, 0"
        ' S-574 (2026-10-17): a DESTROYED receiver (DELETE zeroes the header word) is the same error as a NULL one
        Dim recvBadLbl As String
        recvBadLbl = X64NextLabel(cg, "recv_bad")
        X64EmitText cg, "    test rcx, rcx"
        X64EmitText cg, "    jz " & recvBadLbl
        X64EmitText cg, "    cmp qword [rcx], 0"
        X64EmitText cg, "    jne " & recvOkLbl
        X64EmitLabel cg, recvBadLbl
        X64EmitText cg, "    lea rcx, [rel " & recvMsgLbl & "]"
        ' rsp is 16-byte aligned here (the call frame above is a multiple of 16): 32 bytes
        ' of shadow space keep it aligned; 40 misaligned printf and crashed (0xC0000005).
        X64EmitText cg, "    sub rsp, 32"
        X64EmitText cg, "    call printf"
        X64EmitText cg, "    mov ecx, 1"
        X64EmitText cg, "    call exit"
        X64EmitLabel cg, recvOkLbl
        Dim methodUpperLookup As String
        methodUpperLookup = X64Upper(Trim(methodName))
        Dim vslot As Integer
        vslot = -1
        If methodVirtualSlot >= 0 Then
            vslot = methodVirtualSlot
        ElseIf methodVirtualSlot <> -2 And methodUpperLookup <> "" And methodReceiverType <> "" Then
            X64FindVTableSlot cg, methodReceiverType, methodUpperLookup, vslot
        End If
        If vslot >= 0 Then
            Dim vcallNullObjLbl As String
            Dim vcallNullVtblLbl As String
            Dim vcallNullSlotLbl As String
            Dim vcallAfterLbl As String
            vcallNullObjLbl = X64NextLabel(cg, "vcall_null_obj")
            vcallNullVtblLbl = X64NextLabel(cg, "vcall_null_vtbl")
            vcallNullSlotLbl = X64NextLabel(cg, "vcall_null_slot")
            vcallAfterLbl = X64NextLabel(cg, "vcall_after")
            X64EmitText cg, "    test rcx, rcx"
            X64EmitText cg, "    jz " & vcallNullObjLbl
            X64EmitText cg, "    mov rax, [rcx]"
            X64EmitText cg, "    test rax, rax"
            X64EmitText cg, "    jz " & vcallNullVtblLbl
            X64EmitText cg, "    mov r11, [rax + " & X64ToStr(vslot * 8) & "]"
            X64EmitText cg, "    test r11, r11"
            X64EmitText cg, "    jz " & vcallNullSlotLbl
            X64EmitText cg, "    call r11"
            X64EmitText cg, "    jmp " & vcallAfterLbl
            X64EmitLabel cg, vcallNullObjLbl
            X64EmitText cg, "    xor rax, rax"
            X64EmitText cg, "    jmp " & vcallAfterLbl
            X64EmitLabel cg, vcallNullVtblLbl
            X64EmitText cg, "    xor rax, rax"
            X64EmitText cg, "    jmp " & vcallAfterLbl
            X64EmitLabel cg, vcallNullSlotLbl
            X64EmitText cg, "    xor rax, rax"
            X64EmitLabel cg, vcallAfterLbl
            X64EmitText cg, "    mov rsp, [rsp + " & X64ToStr(savedRspOffset) & "]"
            Return 1
        End If
    End If

    X64EmitText cg, "    call " & calleeName
    X64EmitText cg, "    mov rsp, [rsp + " & X64ToStr(savedRspOffset) & "]"
    Return 1
End Function

Private Function X64EmitRoutineCall(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef calleeName As String, ByVal argCount As Integer, ByVal methodPrependReceiver As Integer, ByRef methodReceiverOwner As String, ByRef methodReceiverType As String, ByRef methodName As String, ByVal methodVirtualSlot As Integer, ByVal methodReceiverNodeIdx As Integer, ByRef errText As String, ByVal argNodeOffset As Integer) As Integer
    Dim savedCount As Integer
    Dim firstText As Integer = gX64CallTextCount
    If X64SyncBeginCallArguments(ps, nodeIdx, cg, calleeName, argCount, argNodeOffset, methodPrependReceiver, savedCount, errText) = 0 Then Return 0
    Dim result As Integer = X64EmitRoutineCallRaw(ps, nodeIdx, cg, calleeName, argCount, methodPrependReceiver, methodReceiverOwner, methodReceiverType, methodName, methodVirtualSlot, methodReceiverNodeIdx, errText, argNodeOffset)
    If result <> 0 AndAlso gX64CallTextCount > firstText Then
        Dim returnType As String
        X64TryResolveCallReturnType ps, nodeIdx, cg, returnType
        If X64TypeNameIsStringLike(returnType) <> 0 Then
            ' The result may point into a BYVAL argument being released below.
            X64EmitText cg, "    mov rcx, rax"
            X64EmitCall0 cg, "__uxb_rt_str_temp"
        End If
        Dim resultName As String = X64NextLabel(cg, "call_text_result")
        If cg.localCount >= 2048 Then
            gX64CallTextCount = firstText
            X64SyncEndCallArguments savedCount
            errText = "x64-codegen: STRING result local capacity exceeded"
            Return 0
        End If
        Dim resultOffset As Integer = X64EnsureLocalSlot(cg, resultName, 1, 8)
        Dim resultFloat As Integer = X64TypeToFloatKind(returnType)
        If resultFloat = UXF_F32 Or resultFloat = UXF_F64 Then
            X64EmitText cg, "    movq " & X64FormatRbpRef(resultOffset) & ", xmm0"
        Else
            X64EmitText cg, "    mov " & X64FormatRbpRef(resultOffset) & ", rax"
        End If
        X64ReleaseCallText cg, firstText
        If resultFloat = UXF_F32 Or resultFloat = UXF_F64 Then
            X64EmitText cg, "    movq xmm0, " & X64FormatRbpRef(resultOffset)
        Else
            X64EmitText cg, "    mov rax, " & X64FormatRbpRef(resultOffset)
        End If
    End If
    gX64CallTextCount = firstText
    X64SyncEndCallArguments savedCount
    If result <> 0 AndAlso X64TaskUsesV2(ps) <> 0 Then X64TaskCheckException cg
    Return result
End Function

Private Function X64CallReceiverIsSuper(ByRef ps As ParseState, ByVal callNodeIdx As Integer) As Integer
    Dim recvNode As Integer
    recvNode = ps.ast.nodes(callNodeIdx).left
    If recvNode < 0 Or recvNode >= ps.ast.count Then Return 0
    Dim recvKind As String
    recvKind = X64Upper(ps.ast.nodes(recvNode).kind)
    If recvKind <> "IDENT" And recvKind <> "KEYWORD_REF" Then Return 0
    Return IIf(X64Upper(Trim(ps.ast.nodes(recvNode).value)) = "SUPER", 1, 0)
End Function

' S-603: is the receiver of this call node the NAME OF A CLASS (a static call `Klass.Metot()`)?
Private Function X64CallReceiverIsClassName(ByRef ps As ParseState, ByVal callNodeIdx As Integer) As Integer
    Dim recvNode As Integer
    recvNode = ps.ast.nodes(callNodeIdx).left
    If recvNode < 0 Or recvNode >= ps.ast.count Then Return 0
    Dim recvKind As String
    recvKind = X64Upper(ps.ast.nodes(recvNode).kind)
    If recvKind <> "IDENT" And recvKind <> "KEYWORD_REF" Then Return 0
    Dim recvName As String
    recvName = X64Upper(Trim(ps.ast.nodes(recvNode).value))
    If recvName = "" Or recvName = "THIS" Or recvName = "ME" Or recvName = "SUPER" Then Return 0
    Return IIf(X64FindClassDeclNode(ps, recvName) <> -1, 1, 0)
End Function

' S-484 (2026-10-17): THIS.m() is a DIRECT call of the implementation visible from the class that contains the call;
' ME.m() and the bare m() the front end rewrites to ME.m() keep dispatching through the vtable.
Private Function X64CallReceiverIsThis(ByRef ps As ParseState, ByVal callNodeIdx As Integer) As Integer
    Dim recvNode As Integer
    recvNode = ps.ast.nodes(callNodeIdx).left
    If recvNode < 0 Or recvNode >= ps.ast.count Then Return 0
    Dim recvKind As String
    recvKind = X64Upper(ps.ast.nodes(recvNode).kind)
    If recvKind <> "IDENT" And recvKind <> "KEYWORD_REF" Then Return 0
    Return IIf(X64Upper(Trim(ps.ast.nodes(recvNode).value)) = "THIS", 1, 0)
End Function

Private Function X64EmitCallNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim listHandled As Integer
    If X64ListEmitValue(ps, nodeIdx, cg, listHandled, errText) = 0 Then Return 0
    If listHandled <> 0 Then Return 1
    Dim atomicHandled As Integer
    If X64AtomicEmitValue(ps, nodeIdx, cg, 0, atomicHandled, errText) = 0 Then Return 0
    If atomicHandled <> 0 Then Return 1
    Dim taskHandled As Integer
    If X64TaskEmitValue(ps, nodeIdx, cg, taskHandled, errText) = 0 Then Return 0
    If taskHandled <> 0 Then Return 1
    Dim calleeName As String
    calleeName = Trim(ps.ast.nodes(nodeIdx).value)
    If calleeName = "" Then calleeName = "__uxb_unknown_call"

    Dim argCount As Integer
    argCount = X64ChildCount(ps, nodeIdx)

    If UCase(calleeName) = "RND" And ps.ast.nodes(nodeIdx).left = -1 Then
        If argCount > 1 Then errText = "legacy AST-x64: RND accepts zero or one argument": Return 0
        If argCount = 1 Then
            If X64EmitExprToXmm0As(ps, X64ChildAt(ps, nodeIdx, 0), cg, UXF_F64, errText) = 0 Then Return 0
            X64EmitText cg, "    movapd xmm1, xmm0"
            X64EmitText cg, "    mov ecx, 1"
        Else
            X64EmitText cg, "    xor ecx, ecx"
            X64EmitText cg, "    pxor xmm1, xmm1"
        End If
        X64EmitCall0 cg, "__uxb_rt_rnd_f64"
        Return 1
    End If

    Dim builtinName As String
    builtinName = X64Upper(calleeName)

    Dim handled As Integer
    handled = 0
    If X64EmitCallNodeSpecial(ps, nodeIdx, cg, calleeName, argCount, builtinName, handled, errText) = 0 Then Return 0
    If handled <> 0 Then Return 1

    Dim methodPrependReceiver As Integer
    Dim methodReceiverOwner As String
    Dim methodReceiverType As String
    Dim methodVirtualSlot As Integer
    Dim methodReceiverNodeIdx As Integer
    methodPrependReceiver = 0
    methodReceiverOwner = ""
    methodReceiverType = ""
    methodVirtualSlot = -1
    methodReceiverNodeIdx = -1

    Dim methodOwner As String
    Dim methodName As String
    methodName = ""

    Dim namespaceCallSymbol As String
    Dim isNamespaceCall As Integer
    namespaceCallSymbol = ""
    isNamespaceCall = X64ResolveNamespaceRoutineSymbol(ps, calleeName, namespaceCallSymbol)
    If isNamespaceCall <> 0 Then
        calleeName = namespaceCallSymbol
        builtinName = X64Upper(calleeName)
    End If

    ' S-037: a SUPER receiver is handled by the dedicated SUPER branch below (a NON-virtual
    ' call to the base implementation). The chain branch cannot resolve it (it answers
    ' "unresolved" = -1) and, being the taken branch of the If/ElseIf, used to skip the
    ' SUPER handling altogether: the call was emitted as an undefined `super.speak` symbol.
    ' S-603 (2026-10-17): `Say.Iki()` - a STATIC method named through its class. The chain branch below only knows instance receivers; for a
    ' class-name receiver it left the callee as the raw text "say.iki" and the assembler failed with "symbol `say.iki' not defined".
    ' Such calls take the static branch of the ElseIf (owner = class name) instead.
    If isNamespaceCall = 0 And ps.ast.nodes(nodeIdx).left <> -1 And InStr(calleeName, ".") > 0 AndAlso X64CallReceiverIsSuper(ps, nodeIdx) = 0 AndAlso X64CallReceiverIsClassName(ps, nodeIdx) = 0 Then
        methodName = X64MethodLeafName(calleeName)
        If methodName = "" Then
            errText = "x64-codegen: chained method name missing"
            Return 0
        End If

        Dim chainReceiverType As String
        Dim chainResolve As Integer
        chainReceiverType = ""
        chainResolve = X64TryResolveReceiverExprType(ps, ps.ast.nodes(nodeIdx).left, cg, chainReceiverType, errText)
        If chainResolve = 0 Then Return 0

        If chainResolve > 0 Then
            Dim chainResolvedOwner As String
            chainReceiverType = X64Upper(Trim(chainReceiverType))
            chainResolvedOwner = chainReceiverType
            methodPrependReceiver = 1
            methodReceiverOwner = ""
            methodReceiverType = chainReceiverType
            methodReceiverNodeIdx = ps.ast.nodes(nodeIdx).left

            If chainReceiverType <> "" And X64FindClassDeclNode(ps, chainReceiverType) <> -1 Then
                Dim chainResolvedMethod As String
                Dim chainResolvedRoutine As String
                chainResolvedMethod = methodName
                chainResolvedRoutine = ""
                If X64ResolveMethodRoutineNameFromType(ps, chainReceiverType, methodName, chainResolvedRoutine, chainResolvedOwner, chainResolvedMethod) <> 0 Then
                    calleeName = chainResolvedRoutine
                Else
                    If X64ResolveMethodOwnerType(ps, chainReceiverType, methodName, chainResolvedOwner) = 0 Then chainResolvedOwner = chainReceiverType
                    calleeName = chainResolvedOwner & "_" & methodName
                End If

                Dim chainSlot As Integer
                chainSlot = -1
                X64FindVTableSlot cg, methodReceiverType, chainResolvedMethod, chainSlot
                If chainSlot >= 0 Then methodVirtualSlot = chainSlot
                If X64CallReceiverIsThis(ps, nodeIdx) <> 0 Then methodVirtualSlot = -2
                ' S-608 (2026-10-17): a STATIC method called through an object variable (`x.Iki()`) takes no hidden receiver; the
                ' assembler-level signature has one parameter fewer ("argument count mismatch for SAY_IKI expected=0").
                If X64ClassMethodIsStatic(ps, X64FindClassMethodDeclNode(ps, chainResolvedOwner, chainResolvedMethod)) <> 0 Then
                    methodPrependReceiver = 0
                    methodVirtualSlot = -1
                End If

                Dim chainExactSymbol As String
                If X64FindRoutineSymbolName(ps, calleeName, chainExactSymbol) <> 0 Then
                    calleeName = chainExactSymbol
                Else
                    calleeName = LCase(calleeName)
                End If
            Else
                ' Interface/OBJECT typed receiver: native code must use vtable slot dispatch.
                Dim chainIfaceSlot As Integer
                chainIfaceSlot = -1
                If X64FindInterfaceMethodSlot(ps, chainReceiverType, methodName, chainIfaceSlot) <> 0 Then
                    methodVirtualSlot = chainIfaceSlot
                    calleeName = X64InterfaceMethodABI(ps, chainReceiverType, methodName)
                    If calleeName = "" Then calleeName = "__uxb_virtual_dispatch_" & LCase(methodName)
                ElseIf X64FindMethodSlotGlobal(ps, methodName, chainIfaceSlot) <> 0 And chainIfaceSlot >= 0 Then
                    methodVirtualSlot = chainIfaceSlot
                    calleeName = "__uxb_virtual_dispatch_" & LCase(methodName)
                Else
                    errText = "x64-codegen: interface/virtual method slot not found for receiver type " & chainReceiverType & " method " & methodName
                    Return 0
                End If
            End If
            builtinName = X64Upper(calleeName)
        End If

    ElseIf isNamespaceCall = 0 And X64SplitMethodCallName(calleeName, methodOwner, methodName) <> 0 Then
        Dim ownerUpper As String
        Dim methodUpper As String
        ownerUpper = X64Upper(methodOwner)
        methodUpper = X64Upper(methodName)

        If ownerUpper = "SUPER" Then
            Dim callerClassType As String
            callerClassType = ""
            If X64ResolveCurrentReceiverClass(ps, cg, callerClassType) = 0 Then
                errText = "x64-codegen: SUPER used outside method context"
                Return 0
            End If

            Dim baseClassType As String
            baseClassType = ""
            If X64GetClassBaseTypeName(ps, callerClassType, baseClassType) = 0 Then
                errText = "x64-codegen: SUPER base class missing " & callerClassType
                Return 0
            End If

            If methodUpper = "CONSTRUCTOR" Then
                ' S-485 / S-487 (P0.2): SUPER.CONSTRUCTOR(args) is the base-class constructor call the front end wrote (semantic_base_ctor.fbs):
                ' a direct call of the base class's constructor routine (hidden receiver first, like a method).
                calleeName = baseClassType & "_CTOR"
            Else
                calleeName = baseClassType & "_" & methodUpper
            End If
            methodPrependReceiver = 1
            methodReceiverOwner = "THIS"
            methodReceiverType = baseClassType
            ' S-037: SUPER.m() is a DIRECT call of the base implementation. Left to the
            ' generic path it looked the method up in the vtable of the receiver's class
            ' and dispatched to the OVERRIDE that is calling SUPER: endless recursion,
            ' stack overflow at run time. -2 = "never dispatch through the vtable".
            methodVirtualSlot = -2
        ElseIf X64FindClassDeclNode(ps, ownerUpper) <> -1 Then
            Dim staticOwner As String
            staticOwner = ownerUpper
            Dim staticMethod As String
            Dim staticRoutine As String
            staticMethod = methodUpper
            staticRoutine = ""
            If X64ResolveMethodRoutineNameFromType(ps, ownerUpper, methodUpper, staticRoutine, staticOwner, staticMethod) <> 0 Then
                calleeName = staticRoutine
            Else
                If X64ResolveMethodOwnerType(ps, ownerUpper, methodUpper, staticOwner) = 0 Then staticOwner = ownerUpper
                calleeName = staticOwner & "_" & methodUpper
            End If
        Else
            Dim receiverType As String
            If X64FindDeclaredTypeName(ps, ownerUpper, receiverType) = 0 Then
                If X64TryGetVarType(cg, ownerUpper, receiverType) = 0 Then
                    If ownerUpper = "THIS" Or ownerUpper = "ME" Then
                        If X64ResolveCurrentReceiverClass(ps, cg, receiverType) = 0 Then
                            errText = "x64-codegen: unknown method receiver " & ownerUpper
                            Return 0
                        End If
                    Else
                        errText = "x64-codegen: unknown method receiver " & ownerUpper
                        Return 0
                    End If
                End If
            End If
            receiverType = X64Upper(Trim(receiverType))
            If receiverType <> "" And X64FindClassDeclNode(ps, receiverType) <> -1 Then
                Dim resolvedOwner As String
                resolvedOwner = receiverType
                Dim resolvedMethod As String
                Dim resolvedRoutine As String
                resolvedMethod = methodUpper
                resolvedRoutine = ""
                If X64ResolveMethodRoutineNameFromType(ps, receiverType, methodUpper, resolvedRoutine, resolvedOwner, resolvedMethod) <> 0 Then
                    calleeName = resolvedRoutine
                Else
                    If X64ResolveMethodOwnerType(ps, receiverType, methodUpper, resolvedOwner) = 0 Then resolvedOwner = receiverType
                    calleeName = resolvedOwner & "_" & methodUpper
                End If
                methodPrependReceiver = 1
                methodReceiverOwner = ownerUpper
                methodReceiverType = receiverType
                If ownerUpper = "THIS" Then methodVirtualSlot = -2
            Else
                Dim globalSlot As Integer
                globalSlot = -1
                If X64FindInterfaceMethodSlot(ps, receiverType, methodUpper, globalSlot) <> 0 Then
                    methodPrependReceiver = 1
                    methodReceiverOwner = ownerUpper
                    methodReceiverType = receiverType
                    methodVirtualSlot = globalSlot
                    calleeName = X64InterfaceMethodABI(ps, receiverType, methodUpper)
                    If calleeName = "" Then calleeName = "__uxb_virtual_dispatch_" & LCase(methodUpper)
                ElseIf X64FindMethodSlotGlobal(ps, methodUpper, globalSlot) <> 0 And globalSlot >= 0 Then
                    methodPrependReceiver = 1
                    methodReceiverOwner = ownerUpper
                    methodReceiverType = receiverType
                    methodVirtualSlot = globalSlot
                Else
                    errText = "x64-codegen: method slot not found for receiver " & ownerUpper & " method " & methodUpper
                    Return 0
                End If
            End If
        End If

        Dim exactMethodSymbol As String
        If X64FindRoutineSymbolName(ps, calleeName, exactMethodSymbol) <> 0 Then
            calleeName = exactMethodSymbol
        Else
            calleeName = LCase(calleeName)
        End If

        builtinName = X64Upper(calleeName)
    End If

    If methodPrependReceiver = 0 Then
        Dim exactRoutineSymbol As String
        If X64FindRoutineSymbolName(ps, calleeName, exactRoutineSymbol) <> 0 Then calleeName = exactRoutineSymbol
    End If

    handled = 0
    If X64EmitBuiltinCall(ps, nodeIdx, cg, builtinName, argCount, handled, errText) = 0 Then Return 0
    If handled <> 0 Then Return 1

    Return X64EmitRoutineCall(ps, nodeIdx, cg, calleeName, argCount, methodPrependReceiver, methodReceiverOwner, methodReceiverType, methodName, methodVirtualSlot, methodReceiverNodeIdx, errText)
End Function

Private Function X64InferFloatKindOfExpr(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext) As Integer
    Dim taskSym As String, taskType As String, taskRecv As Integer, taskArgs As Integer
    If X64TaskMemberInfo(ps, nodeIdx, cg, taskSym, taskType, taskRecv, taskArgs) <> 0 Then Return X64TypeToFloatKind(taskType)
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)

    Select Case nodeKind
    Case "INCDEC_EXPR"
        Return X64InferFloatKindOfExpr(ps, ps.ast.nodes(nodeIdx).left, cg)
    Case "UNARY"
        Dim unaryOp As String = X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
        If unaryOp <> "-" And unaryOp <> "+" And unaryOp <> "" Then Return UXF_UNKNOWN
        Dim unaryOperand As Integer = ps.ast.nodes(nodeIdx).left
        If unaryOperand = -1 Then unaryOperand = ps.ast.nodes(nodeIdx).right
        If unaryOperand = -1 Then unaryOperand = X64ChildAt(ps, nodeIdx, 0)
        Return X64InferFloatKindOfExpr(ps, unaryOperand, cg)
    Case "TERNARY_EXPR"
        Dim conditionalType As String = ps.ast.nodes(nodeIdx).typeName
        Return X64TypeToFloatKind(conditionalType)
    Case "NUMBER", "INTEGER", "INT", "INT_LITERAL"
        ' UXB_006_TP02_FIX_20260712:
        ' NUMBER is shared by integer and floating literals.  Treat only decimal/
        ' exponent forms as F64; otherwise SHL/SHR and other integer operators are
        ' incorrectly routed through the float/XMM emitter.
        Dim literalText As String
        literalText = Trim(ps.ast.nodes(nodeIdx).value)
        If UXBNumberLiteralIsFloat(literalText) <> 0 Then Return UXF_F64
        Return UXF_UNKNOWN
    Case "IDENT", "IDENTIFIER", "VAR", "NAME", "VAR_REF", "KEYWORD_REF"
        Dim identName As String
        identName = Trim(ps.ast.nodes(nodeIdx).value)
        If identName = "" Then Return 0

        Dim declType As String
        declType = ""
        If X64TryGetVarType(cg, identName, declType) <> 0 Then
            Return X64TypeToFloatKind(declType)
        End If
        If X64FindDeclaredTypeName(ps, identName, declType) <> 0 Then
            Return X64TypeToFloatKind(declType)
        End If
        Return 0
    Case "CALL_EXPR"
        Dim retType As String
        retType = ""
        If X64TryResolveCallReturnType(ps, nodeIdx, cg, retType) <> 0 Then
            ' An indexed array parameter is an element value, not F32[]/F64[].
            If Right(retType, 2) = "[]" Then retType = Left(retType, Len(retType) - 2)
            Return X64TypeToFloatKind(retType)
        End If
        ' S-064: array indexing (`f(0)`) parses as CALL_EXPR too, same as an
        ' actual function call. When this isn't a resolvable call, it might
        ' be indexing into an array instead -- check that before giving up
        ' and defaulting to non-float (which was the actual root cause of
        ' native AST-direct x64 printing F64 array elements as raw integer
        ' bit patterns: PRINT asked this function "is f(0) a float?", got a
        ' false "no" here, and so used the integer expr path instead of
        ' X64EmitExprToXmm0As -- whose own CALL_EXPR case, a few hundred
        ' lines below, already correctly loads a float array element via
        ' X64EmitLoadIndexedLocalXmm/GlobalXmm and was simply never reached).
        Dim ceBaseName As String
        Dim ceIndexExpr As Integer
        If X64TryExtractIndexedTarget(ps, nodeIdx, ceBaseName, ceIndexExpr) <> 0 Then
            Dim ceBaseType As String
            ceBaseType = ""
            If X64TryGetVarType(cg, ceBaseName, ceBaseType) <> 0 OrElse X64FindDeclaredTypeName(ps, ceBaseName, ceBaseType) <> 0 Then
                If Right(ceBaseType, 2) = "[]" Then ceBaseType = Left(ceBaseType, Len(ceBaseType) - 2)
                Return X64TypeToFloatKind(ceBaseType)
            End If
        End If
        Return 0
    Case "FIELD_EXPR"
        Dim rootName As String
        Dim pathText As String
        Dim rootNode As Integer
        Dim rootType As String
        Dim fieldOffset As Integer
        Dim fieldType As String
        Dim fieldSize As Integer
        Dim resolveErr As String
        If X64ResolveFieldInfo(ps, nodeIdx, cg, rootName, pathText, rootNode, rootType, fieldOffset, fieldType, fieldSize, resolveErr) <> 0 Then
            Return X64TypeToFloatKind(fieldType)
        End If
        Return 0
    Case "BINARY", "BINARY_EXPR", "BINOP", "OP", "ADD", "SUB", "MUL", "DIV"
        Dim lhs As Integer
        Dim rhs As Integer
        lhs = ps.ast.nodes(nodeIdx).left
        rhs = ps.ast.nodes(nodeIdx).right
        If lhs = -1 Then lhs = X64ChildAt(ps, nodeIdx, 0)
        If rhs = -1 Then rhs = X64ChildAt(ps, nodeIdx, 1)

        ' S-144: a comparison or logical operator yields an integer truth value (-1/0) even when its operands
        ' are floats. `PRINT f > 2` asked "is this expression a float?", got yes, tried to emit the comparison
        ' as an XMM value and the build failed with an EMPTY error text.
        Select Case X64Upper(Trim(ps.ast.nodes(nodeIdx).op))
        Case "=", "==", "<>", "!=", "<", ">", "<=", ">=", "AND", "OR", "XOR", "ANDALSO", "ORELSE", "&&", "||"
            Return 0
        End Select

        Dim lk As Integer
        Dim rk As Integer
        lk = X64InferFloatKindOfExpr(ps, lhs, cg)
        rk = X64InferFloatKindOfExpr(ps, rhs, cg)

        If lk = UXF_F128 Or rk = UXF_F128 Then Return UXF_F128
        If lk = UXF_F80 Or rk = UXF_F80 Then Return UXF_F80
        If lk = UXF_F64 Or rk = UXF_F64 Then Return UXF_F64
        If lk = UXF_F32 Or rk = UXF_F32 Then Return UXF_F32
        ' S-525: `/` is the DECIMAL division in every engine (7 / 2 = 3.5, `\` is the integer one). Two integer operands were left
        ' to the integer path (idiv -> 3). The front end has already stamped the node with the type it computes; trust a
        ' floating stamp for `/` (an operator overload on a class yields a non-float stamp and stays untouched).
        If X64Upper(Trim(ps.ast.nodes(nodeIdx).op)) = "/" Then
            Dim divStampKind As Integer = X64TypeToFloatKind(ps.ast.nodes(nodeIdx).typeName)
            If divStampKind = UXF_F32 Or divStampKind = UXF_F64 Then Return divStampKind
        End If
        Return 0
    Case Else
        Dim baseName As String
        Dim indexExpr As Integer
        If X64TryExtractIndexedTarget(ps, nodeIdx, baseName, indexExpr) <> 0 Then
            Dim baseType As String
            baseType = ""
            If X64TryGetVarType(cg, baseName, baseType) <> 0 Then
                Return X64TypeToFloatKind(baseType)
            End If
            If X64FindDeclaredTypeName(ps, baseName, baseType) <> 0 Then
                Return X64TypeToFloatKind(baseType)
            End If
        End If
    End Select

    Return 0
End Function


' UXB_001_X64_PRINT_STR_FIX_20260712:
' PRINT must not format string pointers with __uxb_fmt_num.  String literals,
' STRING variables and STRING/STRPTR-returning CALL(DLL/API)/functions are
' emitted as direct text pointers to __uxb_runtime_print.
Private Function X64TypeNameIsStringLike(ByRef typeName As String) As Integer
    Dim t As String
    t = X64Upper(Trim(typeName))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)
    Select Case t
    Case "STRING", "STR", "STRPTR", "ZSTRING", "CSTRING", "LPSTR", "LPCSTR"
        Return 1
    End Select
    Return 0
End Function

Private Function X64ExprIsStringLike(ByRef ps As ParseState, ByVal exprNode As Integer, ByRef cg As X64CodegenContext) As Integer
    Dim taskSym As String, taskType As String, taskRecv As Integer, taskArgs As Integer
    If X64TaskMemberInfo(ps, exprNode, cg, taskSym, taskType, taskRecv, taskArgs) <> 0 Then Return X64TypeNameIsStringLike(taskType)
    If exprNode < 0 Or exprNode >= ps.ast.count Then Return 0
    If UXBStep3TypeIsString(ps.ast.nodes(exprNode).typeName) <> 0 Then Return 1

    Dim k As String
    k = X64Upper(Trim(ps.ast.nodes(exprNode).kind))

    If k = "TERNARY_EXPR" Then
        Dim conditionalType As String = UCase(Trim(ps.ast.nodes(exprNode).typeName))
        If Left(conditionalType, 5) = "TYPE_" Then conditionalType = Mid(conditionalType, 6)
        Return X64TypeNameIsStringLike(conditionalType)
    End If

    If k = "STRING" Or k = "STRING_LITERAL" Or k = "STR_LITERAL" Then Return 1

    If k = "FIELD_EXPR" Then
        Dim namespaceConstDecl As Integer
        Dim namespaceConstInit As Integer
        If UXBAstResolveNamespaceConstField(ps.ast, exprNode, namespaceConstDecl, namespaceConstInit) <> 0 Then
            If namespaceConstInit <> exprNode Then Return X64ExprIsStringLike(ps, namespaceConstInit, cg)
        End If
    End If

    If k = "BINARY" Or k = "BINARY_EXPR" Or k = "BINOP" Or k = "OP" Or k = "ADD" Then
        Dim binaryOp As String
        binaryOp = X64Upper(Trim(ps.ast.nodes(exprNode).op))
        If binaryOp = "" Then binaryOp = k
        If binaryOp = "+" Or binaryOp = "ADD" Then
            Dim binaryLhs As Integer
            Dim binaryRhs As Integer
            binaryLhs = ps.ast.nodes(exprNode).left
            binaryRhs = ps.ast.nodes(exprNode).right
            If binaryLhs = -1 Then binaryLhs = X64ChildAt(ps, exprNode, 0)
            If binaryRhs = -1 Then binaryRhs = X64ChildAt(ps, exprNode, 1)
            If binaryLhs <> exprNode And X64ExprIsStringLike(ps, binaryLhs, cg) <> 0 Then Return 1
            If binaryRhs <> exprNode And X64ExprIsStringLike(ps, binaryRhs, cg) <> 0 Then Return 1
        End If
    End If

    Dim t As String
    t = ""

    If X64TryResolveDllCallReturnTypeFromAst(ps, exprNode, t) <> 0 Then
        If X64TypeNameIsStringLike(t) <> 0 Then Return 1
    End If

    If k = "VAR_REF" Or k = "IDENT" Or k = "IDENTIFIER" Then
        Dim varName As String
        varName = Trim(ps.ast.nodes(exprNode).value)
        If varName <> "" Then
            If X64TryGetVarType(cg, varName, t) <> 0 Then
                If X64TypeNameIsStringLike(t) <> 0 Then Return 1
            End If
            If X64FindDeclaredTypeName(ps, varName, t) <> 0 Then
                If X64TypeNameIsStringLike(t) <> 0 Then Return 1
            End If
        End If
    End If

    If k = "CALL_EXPR" Or k = "CALL" Then
        Dim routineName As String
        routineName = X64Upper(Trim(ps.ast.nodes(exprNode).value))
        Dim namespaceStringRoutine As String
        namespaceStringRoutine = ""
        If X64ResolveNamespaceRoutineSymbol(ps, ps.ast.nodes(exprNode).value, namespaceStringRoutine) <> 0 Then
            routineName = X64Upper(namespaceStringRoutine)
        End If
        If routineName = "BIGINIT" Then Return 1
        If routineName = "HEX" Or routineName = "OCT" Or routineName = "BIN" Then Return 1
        Select Case routineName
        Case "LEFT", "LEFT$", "RIGHT", "RIGHT$", "MID", "MID$", "UCASE", "UCASE$", "LCASE", "LCASE$", "LTRIM", "LTRIM$", "RTRIM", "RTRIM$", "TRIM", "TRIM$", "SPACE", "SPACE$", "STRING", "STRING$", "CHR", "CHR$", "STR", "STR$", "PEEKS"
            Return 1
        End Select
        If routineName <> "" Then
            Dim routineIdx As Integer
            routineIdx = X64FindRoutine(cg, routineName)
            If routineIdx <> -1 Then
                If X64TypeNameIsStringLike(gX64RoutineReturnTypes(routineIdx)) <> 0 Then Return 1
            End If
        End If
        ' A METHOD call (`obj.Label()`, `Make().Label()`): the routine is registered under its
        ' class-qualified symbol, so the plain-name lookup above misses it and PRINT formatted the
        ' returned STRING pointer as a number.
        If InStr(ps.ast.nodes(exprNode).value, ".") > 0 Then
            Dim methodRetType As String
            methodRetType = ""
            If X64TryResolveCallReturnType(ps, exprNode, cg, methodRetType) <> 0 Then
                If X64TypeNameIsStringLike(methodRetType) <> 0 Then Return 1
            End If
        End If
    End If

    ' S-064: same gap as X64InferFloatKindOfExpr above -- array indexing
    ' (`s(0)`) parses as CALL_EXPR too, and nothing above this line recognizes
    ' that shape. Without this, PRINT on a STRING array element fell through
    ' to the numeric path and printed the element's raw 8-byte handle as an
    ' address instead of calling the C-string print path.
    If k = "CALL_EXPR" Or k = "CALL" Then
        Dim csBaseName As String
        Dim csIndexExpr As Integer
        If X64TryExtractIndexedTarget(ps, exprNode, csBaseName, csIndexExpr) <> 0 Then
            Dim csBaseType As String
            csBaseType = ""
            If X64TryGetVarType(cg, csBaseName, csBaseType) <> 0 Then
                If X64TypeNameIsStringLike(csBaseType) <> 0 Then Return 1
            ElseIf X64FindDeclaredTypeName(ps, csBaseName, csBaseType) <> 0 Then
                If X64TypeNameIsStringLike(csBaseType) <> 0 Then Return 1
            End If
        End If
    End If

    Return 0
End Function


Private Function X64EmitPrintFileStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim childCount As Integer
    childCount = X64ChildCount(ps, nodeIdx)
    If childCount < 2 Then
        errText = "x64-codegen: PRINT# handle/value missing"
        Return 0
    End If

    Dim handleExpr As Integer
    handleExpr = X64ChildAt(ps, nodeIdx, 0)
    If handleExpr = -1 Then
        errText = "x64-codegen: PRINT# handle missing"
        Return 0
    End If

    Dim trailingSep As String
    trailingSep = ""

    Dim itemPos As Integer
    For itemPos = 1 To childCount - 1
        Dim itemNode As Integer
        Dim exprNode As Integer
        itemNode = X64ChildAt(ps, nodeIdx, itemPos)
        If itemNode = -1 Then
            errText = "x64-codegen: PRINT# item missing"
            Return 0
        End If
        exprNode = ps.ast.nodes(itemNode).left
        If exprNode = -1 Then exprNode = X64ChildAt(ps, itemNode, 0)
        If exprNode = -1 Then
            errText = "x64-codegen: PRINT# item expression missing"
            Return 0
        End If

        If X64EmitExprToRax(ps, handleExpr, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    push rax"

        Dim inferredFloatKind As Integer
        inferredFloatKind = X64InferFloatKindOfExpr(ps, exprNode, cg)
        If X64ExprIsStringLike(ps, exprNode, cg) <> 0 Then
            If X64EmitExprToRax(ps, exprNode, cg, errText) = 0 Then Return 0
        ElseIf inferredFloatKind = UXF_F32 Or inferredFloatKind = UXF_F64 Then
            If X64EmitExprToXmm0As(ps, exprNode, cg, UXF_F64, errText) = 0 Then Return 0
            X64EmitFloatToStrBuf cg, IIf(inferredFloatKind = UXF_F32, 1, 0)
        ElseIf X64IsExtFpKind(inferredFloatKind) <> 0 Then
            errText = "x64-codegen: PRINT# extended floating point text conversion is unsupported"
            Return 0
        Else
            If X64EmitExprToRax(ps, exprNode, cg, errText) = 0 Then Return 0
            X64EmitText cg, "    mov rcx, rax"
            If UXBExprIsU64(ps, exprNode) <> 0 Then
                X64EmitCall0 cg, "__uxb_rt_str_u64"
            Else
                X64EmitCall0 cg, "__uxb_rt_str_i64"
            End If
        End If

        X64EmitText cg, "    mov rdx, rax"
        X64EmitText cg, "    xor r8d, r8d"
        X64EmitText cg, "    pop rcx"
        X64EmitCall0 cg, "__uxb_file_write_text"

        trailingSep = Trim(ps.ast.nodes(itemNode).op)
        If trailingSep = "," Then
            If X64EmitExprToRax(ps, handleExpr, cg, errText) = 0 Then Return 0
            X64EmitText cg, "    mov rcx, rax"
            X64EmitText cg, "    lea rdx, [rel __uxb_print_tab]"
            X64EmitText cg, "    xor r8d, r8d"
            X64EmitCall0 cg, "__uxb_file_write_text"
        End If
    Next itemPos

    If trailingSep <> ";" And trailingSep <> "," Then
        If X64EmitExprToRax(ps, handleExpr, cg, errText) = 0 Then Return 0
        X64EmitText cg, "    mov rcx, rax"
        X64EmitText cg, "    lea rdx, [rel __uxb_empty_text]"
        X64EmitText cg, "    mov r8d, 1"
        X64EmitCall0 cg, "__uxb_file_write_text"
    End If

    Return 1
End Function

Private Function X64EmitPrintStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If X64Upper(Trim(ps.ast.nodes(nodeIdx).op)) = "FILE" Then
        Return X64EmitPrintFileStmt(ps, nodeIdx, cg, errText)
    End If
    Dim hadItems As Integer
    hadItems = 0
    Dim suppressNewline As Integer
    suppressNewline = 0

    Dim itemNode As Integer
    itemNode = ps.ast.nodes(nodeIdx).firstChild
    Do While itemNode <> -1
        Dim exprNode As Integer
        exprNode = ps.ast.nodes(itemNode).left
        If exprNode = -1 Then exprNode = X64ChildAt(ps, itemNode, 0)
        If exprNode <> -1 Then
            Dim inferredFloatKind As Integer
            inferredFloatKind = X64InferFloatKindOfExpr(ps, exprNode, cg)

            If inferredFloatKind = UXF_UNKNOWN Then
                Dim inferKindExpr As String
                inferKindExpr = X64Upper(ps.ast.nodes(exprNode).kind)
                Dim namespacePrintCallSymbol As String
                Dim namespacePrintCall As Integer
                namespacePrintCallSymbol = ""
                namespacePrintCall = 0
                If inferKindExpr = "CALL_EXPR" Then
                    namespacePrintCall = X64ResolveNamespaceRoutineSymbol(ps, ps.ast.nodes(exprNode).value, namespacePrintCallSymbol)
                End If
                If inferKindExpr = "FIELD_EXPR" Or (inferKindExpr = "CALL_EXPR" And namespacePrintCall = 0 And InStr(Trim(ps.ast.nodes(exprNode).value), ".") > 0) Then
                    Dim inferRootName As String
                    Dim inferPathText As String
                    Dim inferRootNode As Integer
                    Dim inferRootType As String
                    Dim inferFieldOffset As Integer
                    Dim inferFieldType As String
                    Dim inferFieldSize As Integer
                    Dim inferErr As String
                    If X64ResolveFieldInfo(ps, exprNode, cg, inferRootName, inferPathText, inferRootNode, inferRootType, inferFieldOffset, inferFieldType, inferFieldSize, inferErr) <> 0 Then
                        inferredFloatKind = X64TypeToFloatKind(inferFieldType)
                    End If
                End If
            End If

            If X64ExprIsStringLike(ps, exprNode, cg) <> 0 Then
                Dim firstPrintText As Integer = gX64CallTextCount
                Dim printText As Integer = X64CreateCallTextSlot(cg, errText)
                If printText = 0 Then Return 0
                If X64SyncEmitArgument(ps, exprNode, cg, 0, errText, printText) = 0 Then Return 0
                X64EmitText cg, "    mov rcx, rax"
                X64EmitText cg, "    call __uxb_runtime_print"
                X64ReleaseCallText cg, firstPrintText
            ElseIf X64IsExtFpKind(inferredFloatKind) <> 0 Then
                If X64EmitExtFpPrintExpr(ps, exprNode, cg, inferredFloatKind, errText) = 0 Then Return 0
            ElseIf inferredFloatKind = UXF_F32 Or inferredFloatKind = UXF_F64 Then
                If X64SyncEmitArgument(ps, exprNode, cg, UXF_F64, errText) = 0 Then Return 0
                X64EmitFloatToStrBuf cg, IIf(inferredFloatKind = UXF_F32, 1, 0)
                X64EmitText cg, "    mov rcx, rax"
                X64EmitText cg, "    call __uxb_runtime_print"
            Else
                If X64SyncEmitArgument(ps, exprNode, cg, 0, errText) = 0 Then Return 0
                X64EmitText cg, "    mov rcx, rax"
                ' S-077: an unsigned 64-bit value prints by its unsigned magnitude.
                If UXBExprIsU64(ps, exprNode) <> 0 Then
                    X64EmitCall0 cg, "__uxb_rt_str_u64"
                Else
                    X64EmitCall0 cg, "__uxb_rt_str_i64"
                End If
                X64EmitText cg, "    mov rcx, rax"
                X64EmitText cg, "    call __uxb_runtime_print"
            End If
            hadItems = 1
        End If

        Dim sepOp As String
        sepOp = Trim(ps.ast.nodes(itemNode).op)
        If sepOp = "," Then
            X64EmitText cg, "    call __uxb_runtime_print_sep_comma"
            suppressNewline = 1
        ElseIf sepOp = ";" Then
            X64EmitText cg, "    call __uxb_runtime_print_sep_semicolon"
            suppressNewline = 1
        Else
            suppressNewline = 0
        End If

        itemNode = ps.ast.nodes(itemNode).nextSibling
    Loop

    If hadItems = 0 Then
        X64EmitText cg, "    call __uxb_runtime_print_newline"
    ElseIf suppressNewline = 0 Then
        X64EmitText cg, "    call __uxb_runtime_print_newline"
    End If
    X64EmitText cg, "    xor rcx, rcx"
    X64EmitCall0 cg, "fflush"
    Return 1
End Function

Private Function X64RoutineBoundaryKind(ByRef kindText As String) As Integer
    Select Case kindText
    Case "SUB_STMT", "FUNCTION_STMT", "CLASS_METHOD_DECL", "CLASS_OPERATOR_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", _
         "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT", "EVENT_STMT"
        Return 1
    End Select
    Return 0
End Function

' S-300: a RETURN leaves the routine, so the FINALLY of every enclosing TRY (reached from its body or CATCH, not from its own FINALLY)
' must run first. True when such a FINALLY exists; other RETURNs keep the plain jump to the epilogue.
Private Function X64ReturnCrossesFinally(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim child As Integer = nodeIdx
    Dim ancestor As Integer = ps.ast.nodes(child).parent
    Do While ancestor >= 0
        Dim kindText As String = UCase(ps.ast.nodes(ancestor).kind)
        If X64RoutineBoundaryKind(kindText) <> 0 Then Exit Do
        If kindText = "LOCK_STMT" Then Return 1
        If kindText = "TRY_STMT" And UCase(ps.ast.nodes(child).kind) <> "FINALLY_PART" Then
            Dim part As Integer = ps.ast.nodes(ancestor).firstChild
            Do While part <> -1
                If UCase(ps.ast.nodes(part).kind) = "FINALLY_PART" Then Return 1
                part = ps.ast.nodes(part).nextSibling
            Loop
        End If
        child = ancestor
        ancestor = ps.ast.nodes(ancestor).parent
    Loop
    Return 0
End Function

' S-300: runs the FINALLY bodies a RETURN crosses (innermost first) with the already computed result parked in a 16-byte frame
' slot (rax, or xmm0 for F32/F64), then reloads it. While a body runs, the try targets of the blocks the RETURN has left
' are popped (an exception thrown by the FINALLY goes to the enclosing TRY, as in the other engines) and restored afterwards.
Private Function X64EmitReturnFinallyUnwind(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByVal hasValue As Integer, ByVal isFloat As Integer, ByRef errText As String) As Integer
    If hasValue <> 0 Then
        X64EmitText cg, "    sub rsp, 16"
        If isFloat <> 0 Then X64EmitText cg, "    movsd [rsp], xmm0" Else X64EmitText cg, "    mov [rsp], rax"
    End If
    Dim savedTryDepth As Integer = gX64TryDepth
    Dim savedTryLabels(0 To 255) As String
    For savedIdx As Integer = 0 To savedTryDepth - 1
        savedTryLabels(savedIdx) = gX64TryTargetLabels(savedIdx)
    Next savedIdx
    Dim ok As Integer = 1
    Dim child As Integer = nodeIdx
    Dim ancestor As Integer = ps.ast.nodes(child).parent
    Do While ancestor >= 0 And ok <> 0
        Dim kindText As String = UCase(ps.ast.nodes(ancestor).kind)
        If X64RoutineBoundaryKind(kindText) <> 0 Then Exit Do
        If kindText = "LOCK_STMT" Then X64LockLeave cg, ancestor
        If kindText = "TRY_STMT" Then
            Dim branchKind As String = UCase(ps.ast.nodes(child).kind)
            Dim finallyPart As Integer = -1
            Dim part As Integer = ps.ast.nodes(ancestor).firstChild
            Do While part <> -1
                If UCase(ps.ast.nodes(part).kind) = "FINALLY_PART" Then finallyPart = part: Exit Do
                part = ps.ast.nodes(part).nextSibling
            Loop
            If branchKind = "TRY_BODY" And gX64TryDepth > 0 Then gX64TryDepth -= 1
            If branchKind = "CATCH_PART" And finallyPart <> -1 And gX64TryDepth > 0 Then gX64TryDepth -= 1
            If branchKind <> "FINALLY_PART" And finallyPart <> -1 And X64SubtreeHasLabel(ps, finallyPart) <> 0 Then
                errText = "x64-codegen: a FINALLY block that contains a label cannot be run for RETURN (it is emitted once per exit path and the label would be defined twice)"
                ok = 0
            End If
            If ok <> 0 And branchKind <> "FINALLY_PART" And finallyPart <> -1 Then
                Dim finStmt As Integer = ps.ast.nodes(finallyPart).firstChild
                Do While finStmt <> -1
                    If X64EmitNode(ps, finStmt, cg, errText) = 0 Then ok = 0: Exit Do
                    finStmt = ps.ast.nodes(finStmt).nextSibling
                Loop
            End If
        End If
        child = ancestor
        ancestor = ps.ast.nodes(ancestor).parent
    Loop
    gX64TryDepth = savedTryDepth
    For savedIdx As Integer = 0 To savedTryDepth - 1
        gX64TryTargetLabels(savedIdx) = savedTryLabels(savedIdx)
    Next savedIdx
    If ok = 0 Then Return 0
    If hasValue <> 0 Then
        If isFloat <> 0 Then X64EmitText cg, "    movsd xmm0, [rsp]" Else X64EmitText cg, "    mov rax, [rsp]"
        X64EmitText cg, "    add rsp, 16"
    End If
    Return 1
End Function

Private Function X64EmitReturnStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: RETURN"
    Dim retExpr As Integer
    retExpr = X64ChildAt(ps, nodeIdx, 0)
    Dim retIsFloat As Integer = 0
    Dim firstReturnText As Integer = gX64CallTextCount, returnText As Integer = 0

    If retExpr <> -1 Then
        Dim routineRetType As String
        Dim routineRetKind As Integer
        routineRetType = ""
        routineRetKind = 0

        If cg.currentRoutineIsFunction <> 0 And X64TryGetRoutineReturnType(cg, cg.currentRoutineLabel, routineRetType) <> 0 Then
            routineRetKind = X64TypeToFloatKind(routineRetType)
        End If
        If routineRetKind = UXF_F32 Or routineRetKind = UXF_F64 Then retIsFloat = 1

        If routineRetKind = UXF_F32 Or routineRetKind = UXF_F64 Then
            If X64SyncEmitArgument(ps, retExpr, cg, routineRetKind, errText) = 0 Then Return 0
        ElseIf routineRetKind = UXF_F80 Then
            errText = "x64-codegen: F80 function return requires x87/ST0 path"
            Return 0
        Else
            If X64TypeNameIsStringLike(routineRetType) <> 0 Then
                returnText = X64CreateCallTextSlot(cg, errText)
                If returnText = 0 Then Return 0
            End If
            If X64SyncEmitArgument(ps, retExpr, cg, 0, errText, returnText) = 0 Then Return 0
        End If
    ElseIf cg.currentRoutineIsFunction = 0 Then
        X64EmitComment cg, "SUB RETURN uses control transfer only"
    End If

    ' S-300: the result is computed; run the FINALLY of every TRY this RETURN leaves before the jump to the epilogue.
    If X64ReturnCrossesFinally(ps, nodeIdx) <> 0 Then
        If X64EmitReturnFinallyUnwind(ps, nodeIdx, cg, IIf(retExpr <> -1, 1, 0), retIsFloat, errText) = 0 Then Return 0
    End If

    If returnText <> 0 Then
        ' Keep the owned result through FINALLY (which can exhaust the temporary
        ' string ring). Publish the caller's temporary only after that user code.
        X64EmitText cg, "    mov rcx, " & X64FormatRbpRef(returnText)
        X64EmitCall0 cg, "__uxb_rt_str_temp"
        X64EmitText cg, "    sub rsp, 16"
        X64EmitText cg, "    mov [rsp], rax"
        X64ReleaseCallText cg, firstReturnText
        X64EmitText cg, "    mov rax, [rsp]"
        X64EmitText cg, "    add rsp, 16"
    End If

    If Trim(cg.currentRoutineLabel) = "" Then
        ' S-537: RETURN at main level only leaves a GOSUB body. Reached by falling in (no GOSUB called it) it is an explicit run time
        ' error in every engine, never a `ret` into garbage.
        Dim returnOkLabel As String = X64NextLabel(cg, "gosub_return_ok")
        X64EmitText cg, "    cmp qword [rel __uxb_gosub_depth], 0"
        X64EmitText cg, "    jne " & returnOkLabel
        X64EmitText cg, "    lea rcx, [rel __uxb_msg_return_without_gosub]"
        X64EmitCall0 cg, "printf"
        X64EmitText cg, "    xor ecx, ecx"
        X64EmitCall0 cg, "fflush"
        X64EmitText cg, "    mov ecx, 5"
        X64EmitCall0 cg, "exit"
        X64EmitLabel cg, returnOkLabel
        X64EmitText cg, "    ret"
    ElseIf cg.currentEpilogLabel <> "" Then
        X64EmitText cg, "    jmp " & cg.currentEpilogLabel
    Else
        X64EmitText cg, "    leave"
        X64EmitText cg, "    ret"
    End If
    Return 1
End Function

Private Function X64EmitBlockStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild

    Do While ch <> -1
        If X64EmitNode(ps, ch, cg, errText) = 0 Then Return 0
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Function X64EmitExprStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: EXPR"
    Dim exprNode As Integer
    exprNode = ps.ast.nodes(nodeIdx).left
    If exprNode = -1 Then exprNode = X64ChildAt(ps, nodeIdx, 0)

    If exprNode <> -1 Then
        Return X64EmitExprToRax(ps, exprNode, cg, errText)
    End If

    Return 1
End Function

Private Function X64EmitIntegerAssignOp(ByRef ps As ParseState, ByVal lhs As Integer, ByVal rhs As Integer, ByRef opText As String, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Dim lhsUnsigned As Integer
    lhsUnsigned = X64ExprIsUnsignedInteger(ps, lhs, cg)

    Select Case opText
    Case "=+", "=-"
        X64EmitText cg, "    mov rax, rbx"
        If opText = "=-" Then X64EmitText cg, "    neg rax"
    Case "+="
        X64EmitText cg, "    add rax, rbx"
    Case "-="
        X64EmitText cg, "    sub rax, rbx"
    Case "*="
        X64EmitText cg, "    imul rax, rbx"
    Case "**="
        X64EmitIntegerPowRaxRbx cg
    Case "/=", "\="
        If UXBExprIsU64(ps, lhs) <> 0 Or UXBExprIsU64(ps, rhs) <> 0 Then
            X64EmitText cg, "    xor edx, edx"
            X64EmitText cg, "    div rbx"
        Else
            X64EmitText cg, "    cqo"
            X64EmitText cg, "    idiv rbx"
        End If
    Case "%="
        If UXBExprIsU64(ps, lhs) <> 0 Or UXBExprIsU64(ps, rhs) <> 0 Then
            X64EmitText cg, "    xor edx, edx"
            X64EmitText cg, "    div rbx"
        Else
            X64EmitText cg, "    cqo"
            X64EmitText cg, "    idiv rbx"
        End If
        X64EmitText cg, "    mov rax, rdx"
    Case "&="
        X64EmitText cg, "    and rax, rbx"
    Case "|="
        X64EmitText cg, "    or rax, rbx"
    Case "^="
        X64EmitText cg, "    xor rax, rbx"
    Case "<<="
        X64EmitText cg, "    mov ecx, ebx"
        X64EmitText cg, "    shl rax, cl"
    Case ">>="
        X64EmitText cg, "    mov ecx, ebx"
        If lhsUnsigned <> 0 Then X64EmitText cg, "    shr rax, cl" Else X64EmitText cg, "    sar rax, cl"
    Case "ROL="
        X64EmitText cg, "    mov ecx, ebx"
        X64EmitText cg, "    rol rax, cl"
    Case "ROR="
        X64EmitText cg, "    mov ecx, ebx"
        X64EmitText cg, "    ror rax, cl"
    Case Else
        errText = "x64-codegen: unsupported assignment operator '" & opText & "'"
        Return 0
    End Select

    Return 1
End Function

Private Function X64EmitFloatAssignOp(ByRef cg As X64CodegenContext, ByRef opText As String, ByVal nativeKind As Integer, ByRef errText As String) As Integer
        Select Case opText
        Case "=+", "=-"
            X64EmitText cg, "    movaps xmm0, xmm1"
            If opText = "=-" Then
                If nativeKind = UXF_F32 Then
                    X64EmitText cg, "    mov eax, 0x80000000"
                Else
                    X64EmitText cg, "    mov rax, 0x8000000000000000"
                End If
                X64EmitText cg, "    movq xmm1, rax"
                X64EmitText cg, "    xorps xmm0, xmm1"
            End If
        Case "+="
            If nativeKind = UXF_F32 Then
                X64EmitText cg, "    addss xmm0, xmm1"
            Else
                X64EmitText cg, "    addsd xmm0, xmm1"
            End If
        Case "-="
            If nativeKind = UXF_F32 Then
                X64EmitText cg, "    subss xmm0, xmm1"
            Else
                X64EmitText cg, "    subsd xmm0, xmm1"
            End If
        Case "*="
            If nativeKind = UXF_F32 Then
                X64EmitText cg, "    mulss xmm0, xmm1"
            Else
                X64EmitText cg, "    mulsd xmm0, xmm1"
            End If
        Case "/="
            If nativeKind = UXF_F32 Then
                X64EmitText cg, "    divss xmm0, xmm1"
            Else
                X64EmitText cg, "    divsd xmm0, xmm1"
            End If
        Case "%="
            If nativeKind = UXF_F32 Then
                X64EmitText cg, "    cvttss2si rax, xmm0"
                X64EmitText cg, "    cvttss2si rbx, xmm1"
            Else
                X64EmitText cg, "    cvttsd2si rax, xmm0"
                X64EmitText cg, "    cvttsd2si rbx, xmm1"
            End If
            X64EmitText cg, "    cqo"
            X64EmitText cg, "    idiv rbx"
            X64EmitText cg, "    mov rax, rdx"
            If nativeKind = UXF_F32 Then
                X64EmitText cg, "    cvtsi2ss xmm0, rax"
            Else
                X64EmitText cg, "    cvtsi2sd xmm0, rax"
            End If
        Case Else
            errText = "x64-codegen: unsupported float assignment operator '" & opText & "'"
            Return 0
        End Select
    Return 1
End Function

Private Function X64EmitCompoundAssign(ByRef ps As ParseState, ByVal lhs As Integer, ByVal rhs As Integer, ByRef lhsKind As String, ByVal lhsIsIndexed As Integer, ByRef lhsName As String, ByVal lhsIndexExpr As Integer, ByRef opText As String, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If lhsKind = "FIELD_EXPR" Then
        Dim cmpFieldType As String
        Dim cmpFieldSize As Integer
        Dim cmpDummyRoot As String
        Dim cmpDummyPath As String
        Dim cmpDummyRootNode As Integer
        Dim cmpDummyRootType As String
        Dim cmpDummyOffset As Integer
        If X64ResolveFieldInfo(ps, lhs, cg, cmpDummyRoot, cmpDummyPath, cmpDummyRootNode, cmpDummyRootType, cmpDummyOffset, cmpFieldType, cmpFieldSize, errText) = 0 Then
            Return 0
        End If
        Dim cmpFk As Integer
        cmpFk = X64TypeToFloatKind(cmpFieldType)
        If cmpFk = UXF_F32 Or cmpFk = UXF_F64 Then
            If X64EmitLoadFieldExpr(ps, lhs, cg, errText) = 0 Then Return 0

            X64EmitText cg, "    sub rsp, 16"
            If cmpFk = UXF_F32 Then
                X64EmitText cg, "    movss [rsp], xmm0"
            Else
                X64EmitText cg, "    movsd [rsp], xmm0"
            End If

            If X64EmitExprToXmm0As(ps, rhs, cg, cmpFk, errText) = 0 Then
                X64EmitText cg, "    add rsp, 16"
                Return 0
            End If

            If cmpFk = UXF_F32 Then
                X64EmitText cg, "    movss xmm1, xmm0"
                X64EmitText cg, "    movss xmm0, [rsp]"
            Else
                X64EmitText cg, "    movsd xmm1, xmm0"
                X64EmitText cg, "    movsd xmm0, [rsp]"
            End If
            X64EmitText cg, "    add rsp, 16"

            Select Case opText
            Case "=+", "=-"
                X64EmitText cg, "    movaps xmm0, xmm1"
                If opText = "=-" Then
                    If cmpFk = UXF_F32 Then
                        X64EmitText cg, "    mov eax, 0x80000000"
                    Else
                        X64EmitText cg, "    mov rax, 0x8000000000000000"
                    End If
                    X64EmitText cg, "    movq xmm1, rax"
                    X64EmitText cg, "    xorps xmm0, xmm1"
                End If
            Case "+="
                If cmpFk = UXF_F32 Then
                    X64EmitText cg, "    addss xmm0, xmm1"
                Else
                    X64EmitText cg, "    addsd xmm0, xmm1"
                End If
            Case "-="
                If cmpFk = UXF_F32 Then
                    X64EmitText cg, "    subss xmm0, xmm1"
                Else
                    X64EmitText cg, "    subsd xmm0, xmm1"
                End If
            Case "*="
                If cmpFk = UXF_F32 Then
                    X64EmitText cg, "    mulss xmm0, xmm1"
                Else
                    X64EmitText cg, "    mulsd xmm0, xmm1"
                End If
            Case "/="
                If cmpFk = UXF_F32 Then
                    X64EmitText cg, "    divss xmm0, xmm1"
                Else
                    X64EmitText cg, "    divsd xmm0, xmm1"
                End If
            Case "%="
                If cmpFk = UXF_F32 Then
                    X64EmitText cg, "    cvttss2si rax, xmm0"
                    X64EmitText cg, "    cvttss2si rbx, xmm1"
                Else
                    X64EmitText cg, "    cvttsd2si rax, xmm0"
                    X64EmitText cg, "    cvttsd2si rbx, xmm1"
                End If
                X64EmitText cg, "    cqo"
                X64EmitText cg, "    idiv rbx"
                X64EmitText cg, "    mov rax, rdx"
                If cmpFk = UXF_F32 Then
                    X64EmitText cg, "    cvtsi2ss xmm0, rax"
                Else
                    X64EmitText cg, "    cvtsi2sd xmm0, rax"
                End If
            Case Else
                errText = "x64-codegen: unsupported float field assignment operator '" & opText & "'"
                Return 0
            End Select

            Return X64EmitStoreFieldFromXmm0(ps, lhs, cg, cmpFk, errText)
        End If

        If cmpFk = UXF_F80 Then
            errText = "x64-codegen: F80 field compound assignment is not supported yet"
            Return 0
        End If
    End If

    If lhsKind = "FIELD_EXPR" Then
        If X64EmitLoadFieldExpr(ps, lhs, cg, errText) = 0 Then Return 0
    ElseIf lhsIsIndexed <> 0 Then
        If cg.currentRoutineLabel <> "" And X64EmitLoadIndexedLocal(ps, cg, lhsName, lhsIndexExpr, errText) <> 0 Then
        ElseIf X64EmitLoadIndexedGlobal(ps, cg, lhsName, lhsIndexExpr, errText) = 0 Then
            errText = "x64-codegen: indexed assignment currently supports DIM arrays"
            Return 0
        End If
    Else
        X64EmitLoadVar cg, lhsName
    End If
    X64EmitText cg, "    push rax"
    If X64EmitExprToRax(ps, rhs, cg, errText) = 0 Then Return 0
    X64EmitText cg, "    mov rbx, rax"
    X64EmitText cg, "    pop rax"

    If X64EmitIntegerAssignOp(ps, lhs, rhs, opText, cg, errText) = 0 Then Return 0

    If lhsKind = "FIELD_EXPR" Then
        Return X64EmitStoreFieldExpr(ps, lhs, cg, errText)
    ElseIf lhsIsIndexed <> 0 Then
        If cg.currentRoutineLabel <> "" And X64EmitStoreIndexedLocal(ps, cg, lhsName, lhsIndexExpr, errText) <> 0 Then
        ElseIf X64EmitStoreIndexedGlobal(ps, cg, lhsName, lhsIndexExpr, errText) = 0 Then
            errText = "x64-codegen: indexed assignment currently supports DIM arrays"
            Return 0
        End If
    Else
        X64EmitStoreVar cg, lhsName
    End If
    Return 1
End Function

Private Function X64EmitAssignStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: ASSIGN"
    Dim lhs As Integer
    Dim rhs As Integer
    lhs = ps.ast.nodes(nodeIdx).left
    rhs = ps.ast.nodes(nodeIdx).right

    If lhs = -1 Or rhs = -1 Then
        errText = "x64-codegen: ASSIGN_STMT missing lhs/rhs"
        Return 0
    End If

    Dim aggregateKind As String = UCase(ps.ast.nodes(lhs).kind)
    If aggregateKind <> "IDENT" And aggregateKind <> "IDENTIFIER" Then
        Dim aggregateType As String, aggregateTypeErr As String
        If UXBStep3InferExprType(ps, lhs, aggregateType, aggregateTypeErr) <> 0 Then
            If UXBTaskSyncValueType(aggregateType) <> 0 Then Return X64EmitLValueUpdate(ps, nodeIdx, cg, 0, errText)
        End If
    End If

    Dim lhsName As String
    Dim lhsKind As String
    lhsKind = X64Upper(ps.ast.nodes(lhs).kind)

    Dim lhsIndexExpr As Integer
    lhsIndexExpr = -1
    Dim lhsIsIndexed As Integer
    lhsIsIndexed = 0

    If lhsKind = "IDENT" Or lhsKind = "IDENTIFIER" Then
        lhsName = Trim(ps.ast.nodes(lhs).value)
    ElseIf X64TryExtractIndexedTarget(ps, lhs, lhsName, lhsIndexExpr) <> 0 Then
        If InStr(lhsName, ".") > 0 Then
            lhsKind = "FIELD_EXPR"
            lhsName = "__FIELD__"
        Else
            lhsIsIndexed = 1
        End If
    ElseIf lhsKind = "FIELD_EXPR" Then
        lhsName = "__FIELD__"
    Else
        errText = "x64-codegen: assignment target must be identifier/index/field"
        Return 0
    End If

    If lhsName = "" Then
        errText = "x64-codegen: assignment target is empty"
        Return 0
    End If

    Dim opText As String
    opText = Trim(ps.ast.nodes(nodeIdx).op)

    Dim lhsTypeText As String
    Dim lhsFloatKind As Integer
    lhsTypeText = ""
    lhsFloatKind = 0

    If X64TryGetVarType(cg, lhsName, lhsTypeText) <> 0 Then
        lhsFloatKind = X64TypeToFloatKind(lhsTypeText)
    End If
    If lhsFloatKind = 0 And X64FindDeclaredTypeName(ps, lhsName, lhsTypeText) <> 0 Then
        lhsFloatKind = X64TypeToFloatKind(lhsTypeText)
    End If

    If lhsFloatKind = 0 And lhsKind = "FIELD_EXPR" Then
        Dim lhsRootName2 As String
        Dim lhsPathText2 As String
        Dim lhsRootNode2 As Integer
        Dim lhsRootType2 As String
        Dim lhsFieldOffset2 As Integer
        Dim lhsFieldType2 As String
        Dim lhsFieldSize2 As Integer
        Dim lhsFieldErr2 As String
        If X64ResolveFieldInfo(ps, lhs, cg, lhsRootName2, lhsPathText2, lhsRootNode2, lhsRootType2, lhsFieldOffset2, lhsFieldType2, lhsFieldSize2, lhsFieldErr2) <> 0 Then
            lhsTypeText = lhsFieldType2
            lhsFloatKind = X64TypeToFloatKind(lhsTypeText)
        End If
    End If

    If lhsFloatKind = 0 And lhsIsIndexed <> 0 Then
        ' The destination is an element, so use the same element type as
        ' indexed reads. F32[]/F64[] parameter types are descriptor types.
        lhsFloatKind = X64InferFloatKindOfExpr(ps, lhs, cg)
    End If

    If lhsFloatKind = UXF_F32 Or lhsFloatKind = UXF_F64 Or lhsFloatKind = UXF_F80 Or lhsFloatKind = UXF_F128 Then
        If X64IsExtFpKind(lhsFloatKind) <> 0 Then
            If opText <> "=" And opText <> "" Then
                errText = "x64-codegen: " & X64FloatKindToExtFpTypeName(lhsFloatKind) & " compound assignment is not supported yet; use explicit A = A op B form"
                Return 0
            End If
            Return X64EmitExtFpAssignStmtCore(ps, lhs, rhs, cg, lhsFloatKind, errText)
        End If

        If opText = "=" Or opText = "" Then
            If lhsKind = "FIELD_EXPR" Then
                Return X64EmitStoreFieldFromRhs(ps, lhs, rhs, cg, errText)
            End If

            If X64EmitExprToXmm0As(ps, rhs, cg, lhsFloatKind, errText) = 0 Then Return 0

            If lhsIsIndexed <> 0 Then
                If cg.currentRoutineLabel <> "" And X64EmitStoreIndexedLocalXmm(ps, cg, lhsName, lhsIndexExpr, errText) <> 0 Then
                    Return 1
                End If
                If X64EmitStoreIndexedGlobalXmm(ps, cg, lhsName, lhsIndexExpr, errText) = 0 Then
                    errText = "x64-codegen: indexed float store currently supports DIM arrays"
                    Return 0
                End If
                Return 1
            End If

            If X64EmitStoreXmm0ToFloatVarAs(cg, lhsName, lhsFloatKind, errText) = 0 Then Return 0
            Return 1
        End If

        Select Case opText
        Case "+=", "=+", "-=", "=-", "*=", "/=", "%="
            ' supported below
        Case Else
            errText = "x64-codegen: unsupported float assignment operator '" & opText & "'"
            Return 0
        End Select

        If lhsKind = "FIELD_EXPR" Then
            If X64EmitLoadFieldExpr(ps, lhs, cg, errText) = 0 Then Return 0
        ElseIf lhsIsIndexed <> 0 Then
            If cg.currentRoutineLabel <> "" And X64EmitLoadIndexedLocalXmm(ps, cg, lhsName, lhsIndexExpr, errText) <> 0 Then
            ElseIf X64EmitLoadIndexedGlobalXmm(ps, cg, lhsName, lhsIndexExpr, errText) = 0 Then
                errText = "x64-codegen: indexed float load currently supports DIM arrays"
                Return 0
            End If
        Else
            If X64EmitLoadFloatVarToXmm0As(ps, cg, lhsName, lhsFloatKind, errText) = 0 Then Return 0
        End If

        X64EmitText cg, "    sub rsp, 16"
        If lhsFloatKind = UXF_F32 Then
            X64EmitText cg, "    movss [rsp], xmm0"
        Else
            X64EmitText cg, "    movsd [rsp], xmm0"
        End If

        If X64EmitExprToXmm0As(ps, rhs, cg, lhsFloatKind, errText) = 0 Then
            X64EmitText cg, "    add rsp, 16"
            Return 0
        End If

        If lhsFloatKind = UXF_F32 Then
            X64EmitText cg, "    movss xmm1, xmm0"
            X64EmitText cg, "    movss xmm0, [rsp]"
        Else
            X64EmitText cg, "    movsd xmm1, xmm0"
            X64EmitText cg, "    movsd xmm0, [rsp]"
        End If
        X64EmitText cg, "    add rsp, 16"

        If X64EmitFloatAssignOp(cg, opText, lhsFloatKind, errText) = 0 Then Return 0

        If lhsKind = "FIELD_EXPR" Then
            Return X64EmitStoreFieldFromXmm0(ps, lhs, cg, lhsFloatKind, errText)
        End If

        If lhsIsIndexed <> 0 Then
            If cg.currentRoutineLabel <> "" And X64EmitStoreIndexedLocalXmm(ps, cg, lhsName, lhsIndexExpr, errText) <> 0 Then
                Return 1
            End If
            If X64EmitStoreIndexedGlobalXmm(ps, cg, lhsName, lhsIndexExpr, errText) = 0 Then
                errText = "x64-codegen: indexed float store currently supports DIM arrays"
                Return 0
            End If
            Return 1
        End If

        If X64EmitStoreXmm0ToFloatVarAs(cg, lhsName, lhsFloatKind, errText) = 0 Then Return 0
        Return 1
    End If

    If opText = "+=" And X64ExprIsStringLike(ps, lhs, cg) <> 0 Then
        Dim concatNode As Integer = ASTNewNode(ps.ast, "BINARY", "", "+", ps.ast.nodes(nodeIdx).lineNo, ps.ast.nodes(nodeIdx).colNo)
        ps.ast.nodes(concatNode).left = lhs
        ps.ast.nodes(concatNode).right = rhs
        ps.ast.nodes(concatNode).typeName = "TYPE_STRING"
        rhs = concatNode
        opText = "="
    End If

    If opText = "=" Or opText = "" Then
        If lhsKind = "FIELD_EXPR" Then
            Return X64EmitStoreFieldFromRhs(ps, lhs, rhs, cg, errText)
        End If

        If X64EmitExprToRax(ps, rhs, cg, errText) = 0 Then Return 0
        If lhsIsIndexed <> 0 Then
            If cg.currentRoutineLabel <> "" And X64EmitStoreIndexedLocal(ps, cg, lhsName, lhsIndexExpr, errText) <> 0 Then
                Return 1
            End If
            If X64EmitStoreIndexedGlobal(ps, cg, lhsName, lhsIndexExpr, errText) = 0 Then
                errText = "x64-codegen: indexed store currently supports DIM arrays"
                Return 0
            End If
            Return 1
        Else
            X64EmitStoreVar cg, lhsName
        End If
        Return 1
    End If

    Return X64EmitCompoundAssign(ps, lhs, rhs, lhsKind, lhsIsIndexed, lhsName, lhsIndexExpr, opText, cg, errText)
End Function

Private Function X64EmitIncDecStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    Return X64EmitLValueUpdate(ps, nodeIdx, cg, 0, errText)
End Function


' Legacy motor kullanici rutinlerini ham adla etiketler (`global near` / `near:` / `call near`). Ad bir NASM
' ayrilmis sozcugu ya da yazmac adiysa (NEAR, BYTE, REL, AL, RAX ...) NASM "expression syntax error" verir.
' NASM'de `$ad` bicimi adi her zaman sembol olarak okutur; bu kume o rutin adlarini tutar ("|ad|", kucuk harf).
' S-684: liste NASM 2.16.01 ile OLCULEREK genisletildi (etiket tanimi + global + call + jmp + lea [rel] bicimi): komut onekleri
' (rep, lock, wait ...), yonergeler (float, export, cpu ...) ve k0-k7 / bnd0-bnd3 / tmm0-tmm7 / tr0-tr7 yazmaclari ham ad olarak
' dusuyordu; hepsi `$ad` ile kurtulur. Yeni bir NASM surumunde dusen sozcuk gorulurse buraya eklenir.
Dim Shared gX64AsmEscapeNames As String

Private Function X64IsNasmReservedName(ByVal nameText As String) As Integer
    Dim n As String = "|" & LCase(Trim(nameText)) & "|"
    Const kw As String = "|near|far|short|byte|word|dword|qword|tword|oword|yword|zword|rel|abs|strict|seg|wrt|times|nosplit|ptr|" & _
        "db|dw|dd|dq|dt|do|dy|dz|resb|resw|resd|resq|rest|reso|resy|resz|equ|incbin|section|segment|global|extern|common|bits|default|align|alignb|org|" & _
        "rax|rbx|rcx|rdx|rsi|rdi|rbp|rsp|eax|ebx|ecx|edx|esi|edi|ebp|esp|ax|bx|cx|dx|si|di|bp|sp|al|bl|cl|dl|ah|bh|ch|dh|sil|dil|bpl|spl|" & _
        "r8|r9|r10|r11|r12|r13|r14|r15|r8d|r9d|r10d|r11d|r12d|r13d|r14d|r15d|r8w|r9w|r10w|r11w|r12w|r13w|r14w|r15w|r8b|r9b|r10b|r11b|r12b|r13b|r14b|r15b|" & _
        "cs|ds|es|fs|gs|ss|rip|st0|st1|st2|st3|st4|st5|st6|st7|" & _
        "a16|a32|a64|asp|o16|o32|o64|osp|lock|rep|repe|repne|repnz|repz|wait|xacquire|xrelease|bnd|nobnd|to|float|static|use16|use32|" & _
        "absolute|at|istruc|iend|struc|endstruc|sectalign|cpu|required|export|" & _
        "k0|k1|k2|k3|k4|k5|k6|k7|bnd0|bnd1|bnd2|bnd3|tmm0|tmm1|tmm2|tmm3|tmm4|tmm5|tmm6|tmm7|tr0|tr1|tr2|tr3|tr4|tr5|tr6|tr7|"
    If InStr(kw, n) > 0 Then Return 1
    If Left(n, 4) = "|xmm" Or Left(n, 4) = "|ymm" Or Left(n, 4) = "|zmm" Or Left(n, 3) = "|cr" Or Left(n, 3) = "|dr" Or Left(n, 3) = "|mm" Then
        Dim rest As String = Mid(n, IIf(Left(n, 3) = "|cr" Or Left(n, 3) = "|dr" Or Left(n, 3) = "|mm", 4, 5))
        rest = Left(rest, Len(rest) - 1)
        If rest <> "" AndAlso rest = LTrim(Str(Val(rest))) Then Return 1
    End If
    Return 0
End Function

Sub X64RegisterRoutineSymbol(ByVal nameText As String)
    If X64IsNasmReservedName(nameText) = 0 Then Exit Sub
    Dim key As String = "|" & LCase(Trim(nameText)) & "|"
    If gX64AsmEscapeNames = "" Then gX64AsmEscapeNames = "|"
    If InStr(gX64AsmEscapeNames, key) = 0 Then gX64AsmEscapeNames &= LCase(Trim(nameText)) & "|"
End Sub

' Yalniz sembol beklenen konumlarda (call/jmp hedefi, global, etiket tanimi, [rel X], dq X) kumedeki adin onune `$`.
Private Function X64EscapeRoutineSymbolsInLine(ByRef lineText As String) As String
    Dim t As String = Trim(lineText)
    If t = "" Then Return lineText
    Dim lead As String = Left(lineText, Len(lineText) - Len(LTrim(lineText)))
    Dim low As String = LCase(t)
    Dim prefixes(0 To 4) As String = {"call ", "jmp ", "global ", "dq ", "extern "}
    Dim i As Integer
    ' Etiket tanimi "ad:"
    If Right(t, 1) = ":" AndAlso InStr(t, " ") = 0 Then
        If InStr(gX64AsmEscapeNames, "|" & LCase(Left(t, Len(t) - 1)) & "|") > 0 Then Return lead & "$" & t
        Return lineText
    End If
    For i = 0 To 4
        If Left(low, Len(prefixes(i))) = prefixes(i) Then
            Dim operand As String = Trim(Mid(t, Len(prefixes(i)) + 1))
            If InStr(gX64AsmEscapeNames, "|" & LCase(operand) & "|") > 0 Then Return lead & Left(t, Len(prefixes(i))) & "$" & operand
        End If
    Next i
    ' [rel ad] -- ornegin CODEPTR / geri cagirma adresi
    Dim relPos As Integer = InStr(low, "[rel ")
    If relPos > 0 Then
        Dim closePos As Integer = InStr(relPos, t, "]")
        If closePos > relPos + 5 Then
            Dim sym As String = Trim(Mid(t, relPos + 5, closePos - relPos - 5))
            If InStr(gX64AsmEscapeNames, "|" & LCase(sym) & "|") > 0 Then Return lead & Left(t, relPos + 4) & "$" & sym & Mid(t, closePos)
        End If
    End If
    Return lineText
End Function

Private Function X64CodegenAssembleOutput(ByRef cg As X64CodegenContext, ByRef asmText As String) As Integer
    If Len(gX64AsmEscapeNames) > 1 Then
        Dim escText As String = cg.textSection
        Dim outText As String = ""
        Dim startPos As Integer = 1
        Do While startPos <= Len(escText)
            Dim nlPos As Integer = InStr(startPos, escText, Chr(10))
            Dim oneLine As String
            If nlPos = 0 Then
                oneLine = Mid(escText, startPos)
                startPos = Len(escText) + 1
            Else
                oneLine = Mid(escText, startPos, nlPos - startPos)
                startPos = nlPos + 1
            End If
            outText &= X64EscapeRoutineSymbolsInLine(oneLine)
            If nlPos <> 0 Then outText &= Chr(10)
        Loop
        cg.textSection = outText
        Dim dataOut As String = ""
        startPos = 1
        escText = cg.dataSection
        Do While startPos <= Len(escText)
            Dim dnl As Integer = InStr(startPos, escText, Chr(10))
            Dim dLine As String
            If dnl = 0 Then
                dLine = Mid(escText, startPos)
                startPos = Len(escText) + 1
            Else
                dLine = Mid(escText, startPos, dnl - startPos)
                startPos = dnl + 1
            End If
            dataOut &= X64EscapeRoutineSymbolsInLine(dLine)
            If dnl <> 0 Then dataOut &= Chr(10)
        Loop
        cg.dataSection = dataOut
    End If
    asmText = cg.textSection

    If cg.literalSpanCount > 0 Then
        asmText &= Chr(10) & "section .data" & Chr(10) & "__uxb_literal_spans:" & Chr(10) & cg.literalSpans
        asmText &= "section .text" & Chr(10) & "extern __uxb_rt_register_string_literals" & Chr(10)
        asmText &= "__uxb_register_literal_spans:" & Chr(10) & "    lea rcx, [rel __uxb_literal_spans]" & Chr(10)
        asmText &= "    mov rdx, " & LTrim(Str(cg.literalSpanCount)) & Chr(10) & "    jmp __uxb_rt_register_string_literals" & Chr(10)
    Else
        asmText &= Chr(10) & "__uxb_register_literal_spans:" & Chr(10) & "    ret" & Chr(10)
    End If

    If Len(cg.dataSection) > 0 Then
        asmText &= Chr(10) & "section .data" & Chr(10) & cg.dataSection
    End If

    If Len(cg.bssSection) > 0 Then
        asmText &= Chr(10) & "section .bss" & Chr(10) & cg.bssSection
    End If

    asmText = X64CompactBlankLines(asmText)

    Return 1
End Function

' ===== S-538-L: unresolved assembler symbols are reported by name before the assembler ever runs =====
' A built-in, collection function, SLOT callback or FFI argument stub this emitter cannot produce used to be emitted as a plain
' `call <name>`; the user then only saw "build_all.bat failed with exit code 1" and had to dig the real cause (NASM `symbol 'dictset'
' not defined`) out of build_all.stderr.txt. The finished text is scanned for symbols that are referenced but neither defined nor
' declared extern, and the first few are named in a plain "not supported" message.
Dim Shared gX64AsmSymTab(0 To 131071) As String

Private Function X64AsmSymHash(ByRef nameText As String) As Integer
    Dim h As UInteger = 2166136261UL
    For i As Integer = 1 To Len(nameText)
        h = (h Xor Asc(nameText, i)) * 16777619UL
    Next i
    Return CInt(h And 131071UL)
End Function

Private Sub X64AsmSymAdd(ByRef nameText As String)
    If nameText = "" Then Exit Sub
    Dim slot As Integer = X64AsmSymHash(nameText)
    Do
        If gX64AsmSymTab(slot) = "" Then gX64AsmSymTab(slot) = nameText: Exit Sub
        If gX64AsmSymTab(slot) = nameText Then Exit Sub
        slot = (slot + 1) And 131071
    Loop
End Sub

Private Function X64AsmSymHas(ByRef nameText As String) As Integer
    Dim slot As Integer = X64AsmSymHash(nameText)
    Do
        If gX64AsmSymTab(slot) = "" Then Return 0
        If gX64AsmSymTab(slot) = nameText Then Return 1
        slot = (slot + 1) And 131071
    Loop
End Function

Private Function X64AsmIdentChar(ByVal c As Integer) As Integer
    If (c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95 Or c = 46 Or c = 36 Or c = 64 Or c = 35 Or c = 126 Or c = 63 Then Return 1
    Return 0
End Function

' first identifier of textFrom starting at pos (skips spaces); "" if the next character cannot start one
Private Function X64AsmIdentAt(ByRef lineText As String, ByVal scanFrom As Integer) As String
    Dim scanPos As Integer = scanFrom
    Do While scanPos <= Len(lineText) AndAlso (Asc(lineText, scanPos) = 32 Or Asc(lineText, scanPos) = 9)
        scanPos += 1
    Loop
    Dim startPos As Integer = scanPos
    Do While scanPos <= Len(lineText) AndAlso X64AsmIdentChar(Asc(lineText, scanPos)) <> 0
        scanPos += 1
    Loop
    If scanPos = startPos Then Return ""
    Dim c0 As Integer = Asc(lineText, startPos)
    If c0 >= 48 And c0 <= 57 Then Return ""
    Return Mid(lineText, startPos, scanPos - startPos)
End Function

Private Function X64AsmIsRegisterName(ByRef nameText As String) As Integer
    Select Case LCase(nameText)
    Case "rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp", "eax", "ebx", "ecx", "edx", "esi", "edi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15", _
         "qword", "dword", "word", "byte", "short", "near", "far", "rel", "abs", "ptr", "tword", "xmm0", "xmm1", "xmm2", "xmm3"
        Return 1
    End Select
    Return 0
End Function

Private Function X64VerifyAsmSymbols(ByRef asmText As String, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To 131071
        gX64AsmSymTab(i) = ""
    Next i
    Dim pass As Integer
    Dim missing As String = ""
    Dim missingCount As Integer = 0
    For pass = 1 To 2
        Dim startPos As Integer = 1
        Do While startPos <= Len(asmText)
            Dim nlPos As Integer = InStr(startPos, asmText, Chr(10))
            Dim oneLine As String
            If nlPos = 0 Then
                oneLine = Mid(asmText, startPos)
                startPos = Len(asmText) + 1
            Else
                oneLine = Mid(asmText, startPos, nlPos - startPos)
                startPos = nlPos + 1
            End If
            Dim t As String = LTrim(oneLine)
            If t = "" Then Continue Do
            Dim c1 As Integer = Asc(t, 1)
            If c1 = 59 Then Continue Do
            Dim lowerT As String = LCase(Left(t, 12))
            If pass = 1 Then
                If Left(lowerT, 7) = "extern " Then
                    Dim ex As String = X64AsmIdentAt(t, 8)
                    X64AsmSymAdd ex
                    Continue Do
                End If
                Dim firstId As String = X64AsmIdentAt(t, 1)
                If firstId <> "" And Left(firstId, 1) <> "." Then
                    Dim afterId As Integer = Len(firstId) + 1
                    If afterId <= Len(t) AndAlso Asc(t, afterId) = 58 Then
                        X64AsmSymAdd firstId
                    Else
                        Dim secondId As String = LCase(X64AsmIdentAt(t, afterId))
                        Select Case secondId
                        Case "equ", "db", "dw", "dd", "dq", "dt", "resb", "resw", "resd", "resq", "rest"
                            X64AsmSymAdd firstId
                        End Select
                    End If
                End If
            Else
                Dim refName As String = ""
                Dim lowerPrefix As String = LCase(Left(t, 5))
                If Left(lowerPrefix, 5) = "call " Then
                    refName = X64AsmIdentAt(t, 6)
                ElseIf Left(lowerPrefix, 4) = "jmp " Then
                    refName = X64AsmIdentAt(t, 5)
                End If
                If refName <> "" Then
                    If Left(refName, 1) <> "." And X64AsmIsRegisterName(refName) = 0 And X64AsmSymHas(refName) = 0 Then
                        If InStr(missing, "|" & refName & "|") = 0 And missingCount < 8 Then missing &= "|" & refName & "|": missingCount += 1
                    End If
                End If
                Dim relPos As Integer = InStr(t, "[rel ")
                If relPos > 0 Then
                    Dim relName As String = X64AsmIdentAt(t, relPos + 5)
                    If relName <> "" Then
                        If Left(relName, 1) <> "." And X64AsmIsRegisterName(relName) = 0 And X64AsmSymHas(relName) = 0 Then
                            If InStr(missing, "|" & relName & "|") = 0 And missingCount < 8 Then missing &= "|" & relName & "|": missingCount += 1
                        End If
                    End If
                End If
            End If
        Loop
    Next pass
    If missingCount = 0 Then Return 1
    Dim shown As String = ""
    Dim shownPos As Integer = 2
    Do While shownPos < Len(missing)
        Dim shownEnd As Integer = InStr(shownPos, missing, "|")
        If shownEnd = 0 Then Exit Do
        If shown <> "" Then shown &= ", "
        shown &= Mid(missing, shownPos, shownEnd - shownPos)
        shownPos = shownEnd + 2
    Loop
    errText = "legacy AST-x64 (S-538-L): bu program, eski AST-x64 yolunun uretemedigi bir ozellik kullaniyor (cozulemeyen simge: " & shown & "). " & _
              "Ornek: koleksiyon islevleri (LIST/DICT/SET), SLOT geri cagrisi, FFI bagimsiz degisken kopruleri, F80 yazdirma. " & _
              "Ayni program varsayilan MIR tabanli native yolda calisir: `uxb bld <dosya> --build-x64`."
    Return 0
End Function

Private Function GenerateX64Code(ByRef ps As ParseState, ByRef outputText As String, ByRef errText As String) As Integer
    gX64ProgramHasLocks = 0
    gX64ProgramHasFileIo = 0
    For lockScan As Integer = 0 To ps.ast.count - 1
        Dim scanKind As String = UCase(ps.ast.nodes(lockScan).kind)
        If scanKind = "LOCK_STMT" Then gX64ProgramHasLocks = 1
        If InStr("|OPEN_STMT|CLOSE_STMT|INPUT_FILE_STMT|GET_STMT|PUT_STMT|SEEK_STMT|", "|" & scanKind & "|") > 0 Then gX64ProgramHasFileIo = 1
        If scanKind = "PRINT_STMT" And UCase(ps.ast.nodes(lockScan).op) = "FILE" Then gX64ProgramHasFileIo = 1
        If scanKind = "CALL_EXPR" AndAlso InStr("|EOF|LOF|FILEPOS|FREEFILE|", "|" & UCase(ps.ast.nodes(lockScan).value) & "|") > 0 Then gX64ProgramHasFileIo = 1
    Next
    gX64SdaCache = ""
    outputText = ""
    errText = ""

    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then
        errText = "x64-codegen: AST root is missing"
        Return 0
    End If

    ' S-140: constants (STRING/F64/namespace/routine-local included) become their values at every use.
    X64InlineConstants ps

    Dim cg As X64CodegenContext
    cg.textSection = ""
    cg.dataSection = ""
    cg.bssSection = ""
    cg.currentRoutineLabel = ""
    cg.labelSeed = 0
    cg.symbolCount = 0
    cg.globalCount = 0
    cg.loopDepth = 0
    VarMappingInit(cg.localVars)
    cg.localCount = 0
    cg.localFrameBytes = 0
    cg.paramCount = 0
    cg.currentEpilogLabel = ""
    cg.currentRoutineIsFunction = 0
    cg.routineCount = 0
    gX64AsmEscapeNames = ""

    Dim i As Integer
    For i = 0 To 4095
        gX64SymbolKeys(i) = ""
        gX64SymbolLabels(i) = ""
        gX64GlobalKeys(i) = ""
        gX64GlobalLabels(i) = ""
        gX64GlobalSlots(i) = 0
    Next i

    For i = 0 To 255
        gX64LoopVars(i) = ""
        gX64LoopStartLabels(i) = ""
        gX64LoopEndLabels(i) = ""
        gX64LoopStepLabels(i) = ""
        gX64LoopLimitLabels(i) = ""
        gX64IfEndLabels(i) = ""
        gX64TryTargetLabels(i) = ""
        gX64ParamNames(i) = ""
        gX64ParamTypes(i) = ""
    Next i
    gX64IfDepth = 0
    gX64TryDepth = 0
    gX64TryFrameDepth = 0

    For i = 0 To 1023
        gX64RoutineKeys(i) = ""
        gX64RoutineArgCounts(i) = 0
        gX64RoutineIsFunction(i) = 0
        gX64RoutineReturnTypes(i) = ""
        Dim paramTypeReset As Integer
        For paramTypeReset = 0 To 63
            gX64RoutineParamTypes(i, paramTypeReset) = ""
        Next paramTypeReset
    Next i

    For i = 0 To 2047
        gX64LocalKeys(i) = ""
        gX64LocalOffsets(i) = 0
        gX64LocalSlots(i) = 0
    Next i

    X64EmitData cg, "format_str: db " & Chr(34) & "%s" & Chr(34) & ", 10, 0"
    X64EmitData cg, "format_int: db " & Chr(34) & "%lld" & Chr(34) & ", 10, 0"
    X64EmitData cg, "__uxb_prompt_fmt: db " & Chr(34) & "%s" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_scan_int: db " & Chr(34) & "%lld" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_scan_f64: db " & Chr(34) & "%lf" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_scan_f32: db " & Chr(34) & "%f" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_scan_str: db " & Chr(34) & "%4095s" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_fmt_num: db " & Chr(34) & "%lld" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_fmt_u64: db " & Chr(34) & "%llu" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_fmt_f64: db " & Chr(34) & "%.16g" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_fmt_f32: db " & Chr(34) & "%.7g" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_text_nan: db " & Chr(34) & "nan" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_scan_file_i32: db " & Chr(34) & "%d" & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_print_space: db " & Chr(34) & " " & Chr(34) & ", 0"
    X64EmitData cg, "__uxb_print_newline: db 10, 0"
    X64EmitData cg, "__uxb_file_newline: db 13, 10, 0"
    X64EmitData cg, "__uxb_gosub_depth: dq 0"
    X64EmitData cg, "__uxb_msg_return_without_gosub: db ""uXBasic runtime error: RETURN used without GOSUB (9301)"", 10, 0"
    X64EmitData cg, "__uxb_print_tab: db 9, 0"
    X64EmitData cg, "__uxb_empty_text: db 0"
    X64EmitData cg, "__uxb_chr_buf: times 2 db 0"
    X64EmitData cg, "__uxb_str_buf: times 64 db 0"
    X64EmitData cg, "__uxb_extfp_str_buf: times 512 db 0"
    X64EmitData cg, "__uxb_ltrim_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_rtrim_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_ucase_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_lcase_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_space_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_string_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_mid_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_mode_rb: db ""rb"", 0"
    X64EmitData cg, "__uxb_mode_wb: db ""wb"", 0"
    X64EmitData cg, "__uxb_mode_ab: db ""ab"", 0"
    X64EmitData cg, "__uxb_mode_rplusb: db ""r+b"", 0"
    X64EmitData cg, "__uxb_mode_wplusb: db ""w+b"", 0"
    X64EmitData cg, "__uxb_file_handles: times 256 dq 0"
    X64EmitData cg, "__uxb_file_can_read: times 256 dd 0"
    X64EmitData cg, "__uxb_file_can_write: times 256 dd 0"
    X64EmitData cg, "__uxb_file_allow_seek: times 256 dd 0"
    X64EmitData cg, "__uxb_file_record_len: times 256 dd 0"
    X64EmitData cg, "__uxb_file_tmp_path: dq 0"
    X64EmitData cg, "__uxb_file_tmp_handle: dq 0"
    X64EmitData cg, "__uxb_file_tmp_fileptr: dq 0"
    X64EmitData cg, "__uxb_file_tmp_dest: dq 0"
    X64EmitData cg, "__uxb_file_tmp_value: dq 0"
    X64EmitData cg, "__uxb_file_tmp_result: dq 0"
    X64EmitData cg, "__uxb_file_io_tmp: dq 0"
    X64EmitData cg, "__uxb_delete_saved_ptr: dq 0"
    X64EmitData cg, "__uxb_input_f64_tmp: dq 0"
    X64EmitData cg, "__uxb_input_f32_tmp: dd 0"
    X64EmitData cg, "__uxb_input_str_buf: times 4096 db 0"
    X64EmitData cg, "__uxb_print_col: dq 0"
    X64EmitData cg, "__uxb_mem_space: times 1048576 db 0"
    X64EmitData cg, "__uxb_memory_seq_buf: times 65536 db 0"
    X64EmitData cg, "__uxb_exc_active: dd 0"
    X64EmitData cg, "__uxb_exc_is_string: dd 0"
    X64EmitData cg, "__uxb_exc_code: dq 0"
    X64EmitData cg, "__uxb_exc_value: dq 0"
    X64EmitData cg, "__uxb_exc_line: dq 0"
    X64EmitData cg, "__uxb_exc_col: dq 0"
    X64EmitData cg, "__uxb_exc_kind: dq 0"
    X64EmitData cg, "__uxb_exc_message: dq 0"
    X64EmitData cg, "__uxb_exc_routine: dq 0"
    X64EmitData cg, "__uxb_exc_value_type: dq 0"
    X64EmitData cg, "__uxb_exc_value_text: dq 0"
    X64EmitData cg, "__uxb_exc_saved_active: times 256 dd 0"
    X64EmitData cg, "__uxb_exc_saved_is_string: times 256 dd 0"
    X64EmitData cg, "__uxb_exc_saved_code: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_value: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_line: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_col: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_kind: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_message: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_routine: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_value_type: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_saved_value_text: times 256 dq 0"
    X64EmitData cg, "__uxb_exc_kind_throw: db ""THROW"", 0"
    X64EmitData cg, "__uxb_exc_kind_assert: db ""ASSERT"", 0"
    X64EmitData cg, "__uxb_exc_message_throw: db ""THROW 0"", 0"
    X64EmitData cg, "__uxb_exc_message_assert: db ""ASSERT failed"", 0"
    X64EmitData cg, "__uxb_exc_fmt_throw_i64: db ""THROW %lld"", 0"
    X64EmitData cg, "__uxb_exc_fmt_assert_str: db ""ASSERT failed: %s"", 0"
    X64EmitData cg, "__uxb_exc_format_value: dq 0"
    X64EmitData cg, "__uxb_exc_format_dest: dq 0"
    X64EmitData cg, "__uxb_exc_type_integer: db ""INTEGER"", 0"
    X64EmitData cg, "__uxb_exc_type_string: db ""STRING"", 0"
    X64EmitData cg, "__uxb_exc_text_zero: db ""0"", 0"

    ' LOCK/MUTEX/ATOMIC consume the common native lock table and atomic
    ' emitter. No feature-wide rejection remains for the AST-direct provider.

    ' S-159-L: legacy motor TYPE degerinin butun atamasini (k2 = k) kopyalamiyor; sessiz yanlis sonuc
    ' yerine acik tani (MIR tabanli native x64 alan alan kopyalar).
    Dim s159Idx As Integer
    For s159Idx = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(s159Idx).kind)) <> "ASSIGN_STMT" Then Continue For
        Dim s159Op As String = Trim(ps.ast.nodes(s159Idx).op)
        If s159Op <> "" And s159Op <> "=" Then Continue For
        Dim s159L As Integer = ps.ast.nodes(s159Idx).left
        Dim s159R As Integer = ps.ast.nodes(s159Idx).right
        If s159L < 0 Or s159R < 0 Then Continue For
        Dim s159Kind As String = UCase(Trim(ps.ast.nodes(s159R).kind))
        If s159Kind <> "IDENT" And s159Kind <> "IDENTIFIER" And s159Kind <> "FIELD_EXPR" Then Continue For
        Dim s159Type As String, s159Err As String
        If UXBStep3InferExprType(ps, s159R, s159Type, s159Err) = 0 Then Continue For
        s159Type = UCase(Trim(s159Type))
        If Left(s159Type, 5) = "TYPE_" Then Continue For
        Dim s159Size As Integer, s159Align As Integer, s159RecKind As String, s159Abi As String, s159Pack As Integer, s159Explicit As Integer
        If TypeLayoutDescribeGlobal(s159Type, s159Size, s159Align, s159RecKind, s159Abi, s159Pack, s159Explicit) = 0 Then Continue For
        If s159RecKind = "TYPE" Or s159RecKind = "STRUCT" Or s159RecKind = "UNION" Then
            errText = "legacy AST-x64: TYPE degerinin butun atamasi desteklenmiyor (S-159-L; MIR tabanli native x64 destekler: `uxb bld` varsayilan motoru) -- satir " & LTrim(Str(ps.ast.nodes(s159Idx).lineNo))
            Return 0
        End If
    Next s159Idx

    ' S-160-L: legacy motorun istisna durumu rutin sinirini gecmez (cagirandaki TRY yakalayamaz). TRY
    ' iceren programda rutin icindeki THROW/ASSERT sessizce farkli davranmasin diye acik tani.
    Dim legacyHasTry As Integer = 0
    Dim excScanIdx As Integer
    For excScanIdx = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(excScanIdx).kind)) = "TRY_STMT" Then legacyHasTry = 1: Exit For
    Next excScanIdx
    If legacyHasTry <> 0 Then
        For excScanIdx = 0 To ps.ast.count - 1
            Dim excKind As String = UCase(Trim(ps.ast.nodes(excScanIdx).kind))
            If (excKind = "THROW_STMT" Or excKind = "ASSERT_STMT") AndAlso UXBTaskEnclosingRoutine(ps, excScanIdx) <> -1 Then
                errText = "legacy AST-x64: rutin icinden atilan istisnanin cagirandaki TRY ile yakalanmasi desteklenmiyor (S-160-L; MIR tabanli native x64 destekler: `uxb bld` varsayilan motoru) -- satir " & LTrim(Str(ps.ast.nodes(excScanIdx).lineNo))
                Return 0
            End If
        Next excScanIdx
    End If

    ' S-167-L: legacy motor kullanici rutininin BYREF skaler parametresini deger olarak geciriyor
    ' (cagiranin degiskeni hic degismiyor) -- sessiz yanlis sonuc yerine acik tani. Dizi parametresi
    ' (T[]) zaten cagiranin dizisine baslanir; FFI DECLARE parametreleri bu denetimin disindadir.
    Dim byRefScanIdx As Integer
    For byRefScanIdx = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(byRefScanIdx).kind)) <> "PARAM_DECL" Then Continue For
        If UCase(Trim(ps.ast.nodes(byRefScanIdx).op)) <> "BYREF" Then Continue For
        Dim byRefOwner As Integer = ps.ast.nodes(byRefScanIdx).parent
        If byRefOwner < 0 Then Continue For
        Dim byRefOwnerKind As String = UCase(Trim(ps.ast.nodes(byRefOwner).kind))
        If byRefOwnerKind <> "SUB_STMT" And byRefOwnerKind <> "FUNCTION_STMT" And Left(byRefOwnerKind, 6) <> "CLASS_" Then Continue For
        Dim byRefParamType As String = UCase(Trim(ps.ast.nodes(byRefScanIdx).typeName))
        If byRefParamType = "" Then
            Dim byRefTypeChild As Integer = ps.ast.nodes(byRefScanIdx).firstChild
            Do While byRefTypeChild <> -1
                If UCase(Trim(ps.ast.nodes(byRefTypeChild).kind)) = "TYPE_REF" Then byRefParamType = UCase(Trim(ps.ast.nodes(byRefTypeChild).value)) : Exit Do
                byRefTypeChild = ps.ast.nodes(byRefTypeChild).nextSibling
            Loop
        End If
        If Right(byRefParamType, 2) = "[]" Then Continue For
        errText = "legacy AST-x64: BYREF parametre desteklenmiyor (S-167-L: bu motor degeri kopyalar, cagiranin degiskeni degismez; MIR tabanli native x64 destekler: `uxb bld` varsayilan motoru) -- " & Trim(ps.ast.nodes(byRefOwner).value) & "." & Trim(ps.ast.nodes(byRefScanIdx).value) & " satir " & LTrim(Str(ps.ast.nodes(byRefScanIdx).lineNo))
        Return 0
    Next byRefScanIdx

    gX64LastEmitNode = -1
    If X64EmitNode(ps, ps.rootNode, cg, errText) = 0 Then
        ' S-675: a node emitter that gives up without a message used to end the build with an empty "x64 build basarisiz:" line
        If Trim(errText) = "" Then
            errText = "legacy AST-x64: kod uretimi bir ileti vermeden durdu"
            If gX64LastEmitNode >= 0 And gX64LastEmitNode < ps.ast.count Then
                errText &= " (dugum " & Trim(ps.ast.nodes(gX64LastEmitNode).kind) & ", satir " & LTrim(Str(ps.ast.nodes(gX64LastEmitNode).lineNo)) & ")"
            End If
            errText &= ". Ayni program varsayilan MIR tabanli native yolda calisabilir: `uxb bld <dosya> --build-x64`."
        End If
        Return 0
    End If

    If X64CodegenAssembleOutput(cg, outputText) = 0 Then
        errText = "x64-codegen: output assembly failed"
        Return 0
    End If
    If X64VerifyAsmSymbols(outputText, errText) = 0 Then Return 0

    Return 1
End Function

Function X64CodegenEmitNasm(ByRef ps As ParseState, ByRef asmText As String, ByRef errText As String) As Integer
    Return GenerateX64Code(ps, asmText, errText)
End Function

Function X64CodegenValidate(ByRef ps As ParseState, ByRef errText As String) As Integer
    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then
        errText = "x64-codegen: AST root is missing"
        Return 0
    End If

    errText = ""
    Return 1
End Function
Private Function X64EmitUnknownNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    ' UXB_009_REALCODE_FIX_20260712: unknown executable nodes may not disappear
    ' into recursive child traversal.  That produced linkable executables with the
    ' requested operation missing.
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "x64-codegen: unsupported invalid AST node index " & LTrim(Str(nodeIdx))
    Else
        errText = "x64-codegen: unsupported AST node kind=" & ps.ast.nodes(nodeIdx).kind & _
                  " node=" & LTrim(Str(nodeIdx)) & _
                  " line=" & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo)) & _
                  " column=" & LTrim(Str(ps.ast.nodes(nodeIdx).colNo))
    End If
    Return 0
End Function

#include once "helpers/x64_codegen_task_v2.fbs"
#include once "helpers/x64_codegen_sync.fbs"
