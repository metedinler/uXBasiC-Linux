' S-141: namespace of the SUB/FUNCTION being emitted (upper case, "" outside a namespace): an unqualified call to a sibling routine
' inside a NAMESPACE/MODULE resolves to that namespace's routine label (see X64ResolveNamespaceRoutineSymbol).
Dim Shared gX64CurrentNamespace As String
' S-143: AST node of the SUB/FUNCTION/method being emitted (-1 while emitting the main program): declared types are looked up
' inside that routine first (see X64FindDeclaredTypeName).
Dim Shared gX64CurrentRoutineNode As Integer = -1
' S-599 / S-618: upper-case name of the FUNCTION being emitted when its result variable (a frame slot named after the function) exists, "" otherwise.
' `F(x)` inside that function is a RECURSIVE CALL, never an index into the scalar result slot (see X64TryExtractIndexedTarget).
