    X64EmitText cg, "    jz .sgn_done"
    X64EmitText cg, "    mov rax, 1"
    X64EmitText cg, "    jg .sgn_done"
    X64EmitText cg, "    mov rax, -1"
    X64EmitText cg, ".sgn_done:"
