    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_fill_mode:"
    X64EmitText cg, "    test r8, r8"
    X64EmitText cg, "    jz .mem_fill_mode_done"
    X64EmitText cg, "    mov r11, r10"
    X64EmitText cg, "    imul r11, r8"
    X64EmitText cg, "    jo .mem_fill_mode_fail"
    X64EmitText cg, "    cmp r9, 2"
    X64EmitText cg, "    je .mem_fill_mode_resolve"
    X64EmitText cg, "    mov rax, 1048576"
    X64EmitText cg, "    sub rax, r11"
    X64EmitText cg, "    cmp rcx, rax"
    X64EmitText cg, "    ja .mem_fill_mode_fail"
    X64EmitText cg, ".mem_fill_mode_resolve:"
    X64EmitText cg, "    push r12"
    X64EmitText cg, "    mov r12, r10"
    X64EmitText cg, "    mov r11, rdx"
    X64EmitText cg, "    mov rdx, r9"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_fill_mode_fail_pop"
    X64EmitText cg, "    mov r10, rax"
    X64EmitText cg, "    xor rax, rax"
    X64EmitText cg, ".mem_fill_mode_loop:"
    X64EmitText cg, "    cmp rax, r8"
    X64EmitText cg, "    jae .mem_fill_mode_done_pop"
    X64EmitText cg, "    cmp r12, 1"
    X64EmitText cg, "    je .mem_fill_mode_b"
    X64EmitText cg, "    cmp r12, 2"
    X64EmitText cg, "    je .mem_fill_mode_w"
    X64EmitText cg, "    cmp r12, 8"
    X64EmitText cg, "    je .mem_fill_mode_q"
    X64EmitText cg, "    mov dword [r10 + rax * 4], r11d"
    X64EmitText cg, "    jmp .mem_fill_mode_next"
    X64EmitText cg, ".mem_fill_mode_b:"
    X64EmitText cg, "    mov byte [r10 + rax], r11b"
    X64EmitText cg, "    jmp .mem_fill_mode_next"
    X64EmitText cg, ".mem_fill_mode_w:"
    X64EmitText cg, "    mov word [r10 + rax * 2], r11w"
    X64EmitText cg, "    jmp .mem_fill_mode_next"
    X64EmitText cg, ".mem_fill_mode_q:"
    X64EmitText cg, "    mov qword [r10 + rax * 8], r11"
    X64EmitText cg, ".mem_fill_mode_next:"
    X64EmitText cg, "    inc rax"
    X64EmitText cg, "    jmp .mem_fill_mode_loop"
    X64EmitText cg, ".mem_fill_mode_done_pop:"
    X64EmitText cg, "    pop r12"
    X64EmitText cg, ".mem_fill_mode_done:"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_fill_mode_fail_pop:"
