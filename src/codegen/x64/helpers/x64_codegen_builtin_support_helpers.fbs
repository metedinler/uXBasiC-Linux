    ' X64_STRING_LEFT_RIGHT_BUILTIN_FIX_20260712:
    ' AST-x64 builtin routing now maps LEFT/LEFT$ and RIGHT/RIGHT$ to concrete
    ' runtime labels instead of emitting raw "call left"/"call right" symbols.
    X64EmitText cg, "__uxb_builtin_left:"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    xor r8, r8"
    X64EmitText cg, "    test rcx, rcx"
    X64EmitText cg, "    jz .left_done"
    X64EmitText cg, "    cmp rdx, 0"
    X64EmitText cg, "    jge .left_loop"
    X64EmitText cg, "    xor rdx, rdx"
    X64EmitText cg, ".left_loop:"
    X64EmitText cg, "    cmp r8, rdx"
    X64EmitText cg, "    jge .left_done"
    X64EmitText cg, "    cmp r8, 4095"
    X64EmitText cg, "    jge .left_done"
    X64EmitText cg, "    mov r9b, [rcx + r8]"
    X64EmitText cg, "    cmp r9b, 0"
    X64EmitText cg, "    je .left_done"
    X64EmitText cg, "    mov [rax + r8], r9b"
    X64EmitText cg, "    inc r8"
    X64EmitText cg, "    jmp .left_loop"
    X64EmitText cg, ".left_done:"
    X64EmitText cg, "    mov byte [rax + r8], 0"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_right:"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    test rcx, rcx"
    X64EmitText cg, "    jz .right_empty"
    X64EmitText cg, "    cmp rdx, 0"
    X64EmitText cg, "    jg .right_len"
    X64EmitText cg, "    jmp .right_empty"
    X64EmitText cg, ".right_len:"
    X64EmitText cg, "    xor r8, r8"
    X64EmitText cg, ".right_len_loop:"
    X64EmitText cg, "    cmp byte [rcx + r8], 0"
    X64EmitText cg, "    je .right_have_len"
    X64EmitText cg, "    inc r8"
    X64EmitText cg, "    jmp .right_len_loop"
    X64EmitText cg, ".right_have_len:"
    X64EmitText cg, "    mov r9, r8"
    X64EmitText cg, "    sub r9, rdx"
    X64EmitText cg, "    jge .right_start_ok"
    X64EmitText cg, "    xor r9, r9"
    X64EmitText cg, ".right_start_ok:"
    X64EmitText cg, "    xor r10, r10"
    X64EmitText cg, ".right_copy:"
    X64EmitText cg, "    cmp r10, 4095"
    X64EmitText cg, "    jge .right_done"
    X64EmitText cg, "    mov r11b, [rcx + r9]"
    X64EmitText cg, "    cmp r11b, 0"
    X64EmitText cg, "    je .right_done"
    X64EmitText cg, "    mov [rax + r10], r11b"
    X64EmitText cg, "    inc r9"
    X64EmitText cg, "    inc r10"
    X64EmitText cg, "    jmp .right_copy"
    X64EmitText cg, ".right_done:"
    X64EmitText cg, "    mov byte [rax + r10], 0"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".right_empty:"
    X64EmitText cg, "    mov byte [rel __uxb_mid_buf], 0"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_mid:"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    mov r9, 0"
    X64EmitText cg, "    cmp rdx, 1"
    X64EmitText cg, "    jge .mid_seek"
    X64EmitText cg, "    mov rdx, 1"
    X64EmitText cg, ".mid_seek:"
    X64EmitText cg, "    dec rdx"
    X64EmitText cg, "    cmp r9, rdx"
    X64EmitText cg, "    jge .mid_copy_prep"
    X64EmitText cg, "    cmp byte [rcx], 0"
    X64EmitText cg, "    je .mid_empty"
    X64EmitText cg, "    inc rcx"
    X64EmitText cg, "    inc r9"
    X64EmitText cg, "    jmp .mid_seek"
    X64EmitText cg, ".mid_copy_prep:"
    X64EmitText cg, "    xor r9, r9"
    X64EmitText cg, ".mid_copy:"
    X64EmitText cg, "    mov dl, [rcx]"
    X64EmitText cg, "    cmp dl, 0"
    X64EmitText cg, "    je .mid_done"
    X64EmitText cg, "    cmp r8, 0"
    X64EmitText cg, "    je .mid_store"
    X64EmitText cg, "    cmp r9, r8"
    X64EmitText cg, "    jge .mid_done"
    X64EmitText cg, ".mid_store:"
    X64EmitText cg, "    mov [rax + r9], dl"
    X64EmitText cg, "    inc rcx"
    X64EmitText cg, "    inc r9"
    X64EmitText cg, "    jmp .mid_copy"
    X64EmitText cg, ".mid_done:"
    X64EmitText cg, "    mov byte [rax + r9], 0"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mid_empty:"
    X64EmitText cg, "    mov byte [rel __uxb_mid_buf], 0"
    X64EmitText cg, "    lea rax, [rel __uxb_mid_buf]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    ' S-144: INSTR (legacy AST-x64 had no INSTR at all: `call instr` -> "symbol `instr' not defined").
    ' __uxb_builtin_instr : rcx = haystack, rdx = needle            -> rax = 1-based position, 0 = not found
    ' __uxb_builtin_instr3: rcx = start (1-based), rdx = haystack, r8 = needle
    ' An empty needle matches at the start position (like FreeBASIC's InStr).
    X64EmitText cg, "__uxb_builtin_instr:"
    X64EmitText cg, "    mov r8, 1"
    X64EmitText cg, "    jmp __uxb_rt_instr"
    X64EmitText cg, "__uxb_builtin_instr3:"
    X64EmitText cg, "    mov r9, rcx"
    X64EmitText cg, "    mov rcx, rdx"
    X64EmitText cg, "    mov rdx, r8"
    X64EmitText cg, "    mov r8, r9"
    X64EmitText cg, "    jmp __uxb_rt_instr"
