    X64EmitText cg, "    mov r9, r10"
    X64EmitText cg, "    mov [rel __uxb_file_tmp_fileptr], r10"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call fwrite"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    cmp rax, [rel __uxb_file_tmp_result]"
    X64EmitText cg, "    jne .file_put_fail"
    X64EmitText cg, "    mov rcx, [rel __uxb_file_tmp_fileptr]"
