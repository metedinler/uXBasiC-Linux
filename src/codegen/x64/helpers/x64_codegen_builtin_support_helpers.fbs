    X64EmitText cg, ""

    ' S-179: the language's VAL() returns a Double (VAL("2.75") = 2.75; the type registry stamps VAL
    ' TYPE_F64 and every caller reads its result from XMM0). This used to call `atoi` (integer, "2.75"
    ' truncates to 2) and return through RAX -- the caller then read RAX's raw integer bits back as if
    ' they were already a double's bit pattern, printing a silent wrong value (VAL("40") -> the tiny
    ' denormal 40's bits decode to). `atof` parses a real double and returns it in XMM0, matching what
    ' every VAL call site already expects.
    X64EmitText cg, "__uxb_builtin_val:"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call atof"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_rnd:"
    X64EmitText cg, "    xor ecx, ecx"
    X64EmitText cg, "    pxor xmm1, xmm1"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call __uxb_rt_rnd_f64"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_timer:"
    X64EmitText cg, "    test rdx, rdx"
    X64EmitText cg, "    jz .timer_now"
    X64EmitText cg, "    test r8, r8"
    X64EmitText cg, "    jz .timer_now"
    X64EmitText cg, "    mov rax, rdx"
    X64EmitText cg, "    sub rax, rcx"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".timer_now:"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call GetTickCount64"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_sqr:"
    X64EmitText cg, "    ; expects double in xmm0, returns double in xmm0"
    X64EmitText cg, "    sqrtsd xmm0, xmm0"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""
    X64EmitText cg, "__uxb_builtin_sin:"
    X64EmitText cg, "    ; expects double in xmm0, returns double in xmm0"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call sin"
