    X64EmitText cg, "    mov [rel __uxb_file_tmp_result], r8"
    X64EmitText cg, "    mov dword [rel __uxb_file_io_tmp], r9d"
    X64EmitText cg, "    cmp rdx, -1"
    X64EmitText cg, "    je .file_put_write"
    X64EmitText cg, "    mov [rel __uxb_file_tmp_handle], rcx"
    X64EmitText cg, "    mov rcx, r10"
    X64EmitText cg, "    dec rdx"
    X64EmitText cg, "    xor r8d, r8d"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call fseek"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    test eax, eax"
    X64EmitText cg, "    jne .file_put_fail"
    X64EmitText cg, "    mov rcx, [rel __uxb_file_tmp_handle]"
    X64EmitText cg, "    lea r11, [rel __uxb_file_handles]"
    X64EmitText cg, "    mov r10, [r11 + rcx*8]"
