' Extracted from code_generator.fbs for wave-14 modular split (phase 3)

Private Sub X64EmitBuiltinSupportCoreA(ByRef cg As X64CodegenContext)
    X64EmitText cg, "__uxb_runtime_cls:"
    X64EmitText cg, "    jmp __uxb_rt_cls"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_runtime_locate:"
    X64EmitText cg, "    jmp __uxb_rt_locate"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_runtime_color:"
    X64EmitText cg, "    jmp __uxb_rt_color"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_runtime_randomize_auto:"
    X64EmitText cg, "    xor ecx, ecx"
    X64EmitText cg, "    xor edx, edx"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call __uxb_rt_randomize_seed"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_runtime_randomize_seed:"
    X64EmitText cg, "    mov rdx, rcx"
    X64EmitText cg, "    mov ecx, 1"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call __uxb_rt_randomize_seed"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_getkey:"
    X64EmitText cg, "    jmp __uxb_rt_getkey_i64"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_builtin_inkey:"
    X64EmitText cg, "    jmp __uxb_rt_inkey_i64"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_resolve_mode:"
    X64EmitText cg, "    cmp rdx, 1"
    X64EmitText cg, "    je .mem_resolve_virtual"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_resolve_native"
    ' S-069: any other mode value (0/AUTO) falls straight into the VIRTUAL
    ' branch. The old fallback here was a separate __uxb_mem_resolve that
    ' treated addresses >= 1 MiB as raw pointers -- the retired "size decides
    ' the memory class" heuristic. AUTO is now decided before codegen, by the
    ' address expression's static type (UXBMemoryAddrIsPointer), and arrives
    ' here as an explicit 1 (VIRTUAL) or 2 (NATIVE).
    X64EmitText cg, ".mem_resolve_virtual:"
    X64EmitText cg, "    cmp rcx, 1048576"
    X64EmitText cg, "    jae .mem_resolve_fail"
    X64EmitText cg, "    lea rax, [rel __uxb_mem_space]"
    X64EmitText cg, "    add rax, rcx"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_resolve_native:"
    X64EmitText cg, "    mov rax, rcx"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_resolve_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_loadb_mode:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_loadb_fail"
    X64EmitText cg, "    movzx eax, byte [rax]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_loadb_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_loadw_mode:"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_loadw_resolve"
    X64EmitText cg, "    cmp rcx, 1048575"
    X64EmitText cg, "    ja .mem_loadw_fail"
    X64EmitText cg, ".mem_loadw_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_loadw_fail"
    X64EmitText cg, "    movzx eax, word [rax]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_loadw_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_loadd_mode:"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_loadd_resolve"
    X64EmitText cg, "    cmp rcx, 1048571"
    X64EmitText cg, "    ja .mem_loadd_fail"
    X64EmitText cg, ".mem_loadd_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_loadd_fail"
    X64EmitText cg, "    mov eax, dword [rax]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_loadd_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    ' S-055: Q (64-bit) memory family, parallel to loadb/w/d above.
    X64EmitText cg, "__uxb_mem_loadq_mode:"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_loadq_resolve"
    X64EmitText cg, "    cmp rcx, 1048568"
    X64EmitText cg, "    ja .mem_loadq_fail"
    X64EmitText cg, ".mem_loadq_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_loadq_fail"
    X64EmitText cg, "    mov rax, qword [rax]"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_loadq_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_storeb_mode:"
    X64EmitText cg, "    mov r10, rdx"
    X64EmitText cg, "    mov rdx, r8"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_storeb_resolve"
    X64EmitText cg, "    cmp rcx, 1048575"
    X64EmitText cg, "    ja .mem_storeb_fail"
    X64EmitText cg, ".mem_storeb_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_storeb_fail"
    X64EmitText cg, "    mov byte [rax], r10b"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_storeb_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_storew_mode:"
    X64EmitText cg, "    mov r10, rdx"
    X64EmitText cg, "    mov rdx, r8"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_storew_resolve"
    X64EmitText cg, "    cmp rcx, 1048575"
    X64EmitText cg, "    ja .mem_storew_fail"
    X64EmitText cg, ".mem_storew_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_storew_fail"
    X64EmitText cg, "    mov word [rax], r10w"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_storew_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_stored_mode:"
    X64EmitText cg, "    mov r10, rdx"
    X64EmitText cg, "    mov rdx, r8"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_stored_resolve"
    X64EmitText cg, "    cmp rcx, 1048571"
    X64EmitText cg, "    ja .mem_stored_fail"
    X64EmitText cg, ".mem_stored_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_stored_fail"
    X64EmitText cg, "    mov dword [rax], r10d"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_stored_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    ' S-055: Q (64-bit) memory family store, parallel to storeb/w/d above.
    X64EmitText cg, "__uxb_mem_storeq_mode:"
    X64EmitText cg, "    mov r10, rdx"
    X64EmitText cg, "    mov rdx, r8"
    X64EmitText cg, "    cmp rdx, 2"
    X64EmitText cg, "    je .mem_storeq_resolve"
    X64EmitText cg, "    cmp rcx, 1048568"
    X64EmitText cg, "    ja .mem_storeq_fail"
    X64EmitText cg, ".mem_storeq_resolve:"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_storeq_fail"
    X64EmitText cg, "    mov qword [rax], r10"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_storeq_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_mem_copy_mode:"
    X64EmitText cg, "    test r8, r8"
    X64EmitText cg, "    jz .mem_copy_mode_done"
    X64EmitText cg, "    mov r10, rcx"
    X64EmitText cg, "    mov r11, rdx"
    X64EmitText cg, "    cmp r9, 2"
    X64EmitText cg, "    je .mem_copy_mode_native_or_auto"
    X64EmitText cg, "    mov rax, 1048576"
    X64EmitText cg, "    sub rax, r8"
    X64EmitText cg, "    cmp r10, rax"
    X64EmitText cg, "    ja .mem_copy_mode_fail"
    X64EmitText cg, "    cmp r11, rax"
    X64EmitText cg, "    ja .mem_copy_mode_fail"
    X64EmitText cg, ".mem_copy_mode_native_or_auto:"
    X64EmitText cg, "    mov rcx, r10"
    X64EmitText cg, "    mov rdx, r9"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_copy_mode_fail"
    X64EmitText cg, "    mov r10, rax"
    X64EmitText cg, "    mov rcx, r11"
    X64EmitText cg, "    mov rdx, r9"
    X64EmitText cg, "    call __uxb_mem_resolve_mode"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .mem_copy_mode_fail"
    X64EmitText cg, "    mov rcx, rax"
    X64EmitText cg, "    mov rdx, r10"
    X64EmitText cg, "    sub rsp, 32"
    X64EmitText cg, "    call memmove"
    X64EmitText cg, "    add rsp, 32"
    X64EmitText cg, ".mem_copy_mode_done:"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".mem_copy_mode_fail:"
