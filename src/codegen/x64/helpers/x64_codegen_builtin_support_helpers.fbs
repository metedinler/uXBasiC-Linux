Private Sub X64EmitBuiltinSupportCoreB(ByRef cg As X64CodegenContext)
    X64EmitText cg, "__uxb_file_write_text:"
    X64EmitText cg, "    cmp rcx, 1"
    X64EmitText cg, "    jl .file_write_text_fail"
    X64EmitText cg, "    cmp rcx, 255"
    X64EmitText cg, "    jg .file_write_text_fail"
    X64EmitText cg, "    lea r11, [rel __uxb_file_handles]"
    X64EmitText cg, "    mov r10, [r11 + rcx*8]"
    X64EmitText cg, "    test r10, r10"
    X64EmitText cg, "    jz .file_write_text_fail"
    X64EmitText cg, "    lea r11, [rel __uxb_file_can_write]"
    X64EmitText cg, "    cmp dword [r11 + rcx*4], 0"
    X64EmitText cg, "    je .file_write_text_fail"
    X64EmitText cg, "    test rdx, rdx"
    X64EmitText cg, "    jz .file_write_text_fail"
    X64EmitText cg, "    mov [rel __uxb_file_tmp_fileptr], r10"
    X64EmitText cg, "    mov [rel __uxb_file_tmp_dest], rdx"
    X64EmitText cg, "    mov [rel __uxb_file_tmp_value], r8"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, ".file_write_text_len:"
    X64EmitText cg, "    cmp byte [rdx + rax], 0"
    X64EmitText cg, "    je .file_write_text_have_len"
    X64EmitText cg, "    inc rax"
    X64EmitText cg, "    jmp .file_write_text_len"
    X64EmitText cg, ".file_write_text_have_len:"
    X64EmitText cg, "    mov [rel __uxb_file_tmp_result], rax"
    X64EmitText cg, "    test rax, rax"
    X64EmitText cg, "    jz .file_write_text_newline"
    X64EmitText cg, "    mov rcx, [rel __uxb_file_tmp_dest]"
    X64EmitText cg, "    mov rdx, 1"
    X64EmitText cg, "    mov r8, rax"
    X64EmitText cg, "    mov r9, [rel __uxb_file_tmp_fileptr]"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call fwrite"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    cmp rax, [rel __uxb_file_tmp_result]"
    X64EmitText cg, "    jne .file_write_text_fail"
    X64EmitText cg, ".file_write_text_newline:"
    X64EmitText cg, "    cmp qword [rel __uxb_file_tmp_value], 0"
    X64EmitText cg, "    je .file_write_text_flush"
    ' S-536: a PRINT # line ends with CR LF (13, 10) like every other engine; the files are opened in binary mode
    ' ("wb"), so the C run time does not turn a lone LF into CR LF by itself.
    X64EmitText cg, "    lea rcx, [rel __uxb_file_newline]"
    X64EmitText cg, "    mov rdx, 1"
    X64EmitText cg, "    mov r8, 2"
    X64EmitText cg, "    mov r9, [rel __uxb_file_tmp_fileptr]"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call fwrite"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    cmp rax, 2"
    X64EmitText cg, "    jne .file_write_text_fail"
    X64EmitText cg, ".file_write_text_flush:"
    X64EmitText cg, "    mov rcx, [rel __uxb_file_tmp_fileptr]"
    X64EmitText cg, "    sub rsp, 40"
    X64EmitText cg, "    call fflush"
    X64EmitText cg, "    add rsp, 40"
    X64EmitText cg, "    test eax, eax"
    X64EmitText cg, "    jne .file_write_text_fail"
    X64EmitText cg, "    mov eax, 1"
    X64EmitText cg, "    ret"
    X64EmitText cg, ".file_write_text_fail:"
    X64EmitText cg, "    xor eax, eax"
    X64EmitText cg, "    ret"
    X64EmitText cg, ""

    X64EmitText cg, "__uxb_file_put_i32:"
    X64EmitText cg, "    cmp rcx, 1"
    X64EmitText cg, "    jl .file_put_fail"
    X64EmitText cg, "    cmp rcx, 255"
    X64EmitText cg, "    jg .file_put_fail"
    X64EmitText cg, "    lea r11, [rel __uxb_file_handles]"
