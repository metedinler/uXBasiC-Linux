' parser.fbs: see the removal note in inline_backend.fbs (found 2026-09-06).

Type FfiX64CallPlanEntry
    astNodeIndex As Integer
    lineNo As Integer
    dllName As String
    symbolName As String
    signatureText As String
    callingConventionText As String
    argumentCount As Integer
End Type

Private Function FfiCallCStringEscape(ByRef textIn As String) As String
    Dim outText As String
    Dim i As Integer
    outText = ""
    For i = 1 To Len(textIn)
        Dim ch As String
        ch = Mid(textIn, i, 1)
        Select Case Asc(ch)
        Case 34
            outText &= "\" & Chr(34)
        Case 92
            outText &= "\\"
        Case Else
            outText &= ch
        End Select
    Next i
    Return outText
End Function

Private Function FfiCallIsDllConvention(ByRef conventionText As String) As Integer
    Dim s As String
    s = UCase(Trim(conventionText))

    Select Case s
    Case "CDECL", "STDCALL"
        Return 1
    End Select

    Return 0
End Function


Private Function FfiCallLooksLikeArgTypeList(ByRef textIn As String) As Integer
    Dim t As String
    t = UCase(Trim(textIn))
    If t = "" Then Return 0

    Dim scanPos As Integer
    scanPos = 1
    Do
        Dim commaPos As Integer
        commaPos = InStr(scanPos, t, ",")
        Dim part As String
        If commaPos = 0 Then
            part = Trim(Mid(t, scanPos))
        Else
            part = Trim(Mid(t, scanPos, commaPos - scanPos))
        End If

        Select Case part
        Case "I32", "U32", "I64", "U64", "F64", "PTR", "STRPTR", "BYREF"
        Case Else
            Return 0
        End Select

        If commaPos = 0 Then Exit Do
        scanPos = commaPos + 1
    Loop

    Return 1
End Function


Private Function FfiCallNodeIndexValid(ByRef ps As ParseState, ByVal idx As Integer) As Integer
    If idx < 0 Then Return 0
    If idx >= ps.ast.count Then Return 0
    Return 1
End Function

Private Function FfiCallChildAt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal childPos As Integer) As Integer
    ' X64_FFI_AST_BOUNDS_FIX_20260712:
    ' Never trust child/sibling links while walking the global AST for x64 FFI
    ' collection.  A malformed or non-child sentinel used by another AST lowering
    ' path must become a diagnostic/skip, not a FreeBASIC runtime error 6.
    If FfiCallNodeIndexValid(ps, nodeIdx) = 0 Then Return -1
    If childPos < 0 Then Return -1

    Dim ch As Integer
    Dim i As Integer
    Dim guard As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    i = 0
    guard = 0

    Do While ch <> -1
        If FfiCallNodeIndexValid(ps, ch) = 0 Then Return -1
        If i = childPos Then Return ch
        ch = ps.ast.nodes(ch).nextSibling
        i += 1
        guard += 1
        If guard > ps.ast.count Then Return -1
    Loop

    Return -1
End Function

Private Function FfiCallChildCount(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If FfiCallNodeIndexValid(ps, nodeIdx) = 0 Then Return 0

    Dim n As Integer
    Dim ch As Integer
    Dim guard As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    guard = 0

    Do While ch <> -1
        If FfiCallNodeIndexValid(ps, ch) = 0 Then Return n
        n += 1
        ch = ps.ast.nodes(ch).nextSibling
        guard += 1
        If guard > ps.ast.count Then Return n
    Loop

    Return n
End Function

Private Sub FfiCallPushEntry(entries() As FfiX64CallPlanEntry, ByRef entryCount As Integer, ByRef entry As FfiX64CallPlanEntry)
    If entryCount = 0 Then
        ReDim entries(0)
    Else
        ReDim Preserve entries(entryCount)
    End If

    entries(entryCount) = entry
    entryCount += 1
End Sub

Private Function FfiCallFindDeclaredReturnTypeNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef symbolName As String, ByRef returnTypeOut As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim k As String
    k = UCase(Trim(ps.ast.nodes(nodeIdx).kind))
    If k = "DECLARE_FUNCTION_STMT" Then
        Dim declaredName As String
        declaredName = UCase(Trim(ps.ast.nodes(nodeIdx).value))
        If declaredName = UCase(Trim(symbolName)) Then
            Dim ch As Integer
            ch = ps.ast.nodes(nodeIdx).firstChild
            Do While ch <> -1
                If UCase(Trim(ps.ast.nodes(ch).kind)) = "RETURN_TYPE" Then
                    returnTypeOut = UCase(Trim(ps.ast.nodes(ch).value))
                    Return IIf(returnTypeOut <> "", 1, 0)
                End If
                ch = ps.ast.nodes(ch).nextSibling
            Loop
        End If
    End If

    If ps.ast.nodes(nodeIdx).left <> -1 Then
        If FfiCallFindDeclaredReturnTypeNode(ps, ps.ast.nodes(nodeIdx).left, symbolName, returnTypeOut) <> 0 Then Return 1
    End If
    If ps.ast.nodes(nodeIdx).right <> -1 Then
        If FfiCallFindDeclaredReturnTypeNode(ps, ps.ast.nodes(nodeIdx).right, symbolName, returnTypeOut) <> 0 Then Return 1
    End If

    Dim childNode As Integer
    childNode = ps.ast.nodes(nodeIdx).firstChild
    Do While childNode <> -1
        If FfiCallFindDeclaredReturnTypeNode(ps, childNode, symbolName, returnTypeOut) <> 0 Then Return 1
        childNode = ps.ast.nodes(childNode).nextSibling
    Loop
    Return 0
End Function

Private Function FfiCallFindDeclaredReturnType(ByRef ps As ParseState, ByRef symbolName As String, ByRef returnTypeOut As String) As Integer
    returnTypeOut = ""
    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then Return 0
    Return FfiCallFindDeclaredReturnTypeNode(ps, ps.rootNode, symbolName, returnTypeOut)
End Function

Private Function FfiCallReadDllEntry(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef entryOut As FfiX64CallPlanEntry, ByRef errText As String) As Integer
    If FfiCallNodeIndexValid(ps, nodeIdx) = 0 Then Return 0

    Dim nodeKind As String
    nodeKind = UCase(Trim(ps.ast.nodes(nodeIdx).kind))

    ' X64_FFI_RESOLVER_COLLECT_FIX_20260712:
    ' The AST x64 emitter already recognizes CALL_DLL_STMT / CALL_API_STMT and emits
    ' __uxb_ffi_stub_N calls into program.asm.  The separate resolver artifact pass
    ' used a narrower detector (CALL_STMT/CALL_EXPR only), so it collected zero
    ' entries for wrapper-lowered CALL(DLL) nodes.  Result: program.asm referenced
    ' __uxb_ffi_resolve_all, but ffi_resolver.c was not emitted and x64 build failed
    ' later with almost no useful diagnostic.
    Dim basePos As Integer
    Dim resolvedCallKind As String
    basePos = 0
    resolvedCallKind = ""

    If nodeKind = "CALL_DLL_STMT" Or nodeKind = "CALL_API_STMT" Then
        ' Direct lowered form:
        '   CALL_DLL_STMT "lib", "symbol", RETTYPE, CONV, "ARGTYPES", arg...
        basePos = 0
        resolvedCallKind = IIf(nodeKind = "CALL_API_STMT", "API", "DLL")
    ElseIf nodeKind = "CALL_STMT" Or nodeKind = "CALL_EXPR" Or nodeKind = "CALL" Then
        Dim callNodeValue As String
        callNodeValue = UCase(Trim(ps.ast.nodes(nodeIdx).value))
        If callNodeValue = "DLL" Or callNodeValue = "API" Then
            resolvedCallKind = callNodeValue
        Else
            If callNodeValue <> "CALL" Then Return 0
            Dim firstArg As Integer
            firstArg = FfiCallChildAt(ps, nodeIdx, 0)
            If FfiCallNodeIndexValid(ps, firstArg) = 0 Then Return 0
            Dim firstKind As String
            firstKind = UCase(Trim(ps.ast.nodes(firstArg).kind))
            If firstKind <> "IDENT" And firstKind <> "KEYWORD_REF" And firstKind <> "IDENTIFIER" And firstKind <> "VAR_REF" Then Return 0
            Dim markerValue As String
            markerValue = UCase(Trim(ps.ast.nodes(firstArg).value))
            If markerValue <> "DLL" And markerValue <> "API" Then Return 0
            resolvedCallKind = markerValue
            basePos = 1
        End If
    Else
        Return 0
    End If

    Dim argc As Integer
    argc = FfiCallChildCount(ps, nodeIdx)
    If argc < basePos + 3 Then
        errText = "ffi-x64: CALL(DLL) arity is invalid at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If

    Dim libNode As Integer
    libNode = FfiCallChildAt(ps, nodeIdx, basePos)
    If FfiCallNodeIndexValid(ps, libNode) = 0 Then
        errText = "ffi-x64: CALL(DLL) library must be string at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If
    If UCase(ps.ast.nodes(libNode).kind) <> "STRING" Then
        errText = "ffi-x64: CALL(DLL) library must be string at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If

    Dim symNode As Integer
    symNode = FfiCallChildAt(ps, nodeIdx, basePos + 1)
    If FfiCallNodeIndexValid(ps, symNode) = 0 Then
        errText = "ffi-x64: CALL(DLL) symbol must be string at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If
    If UCase(ps.ast.nodes(symNode).kind) <> "STRING" Then
        errText = "ffi-x64: CALL(DLL) symbol must be string at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If

    Dim sigNode As Integer
    sigNode = FfiCallChildAt(ps, nodeIdx, basePos + 2)
    If FfiCallNodeIndexValid(ps, sigNode) = 0 Then
        errText = "ffi-x64: CALL(DLL) signature/first argument missing at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If

    Dim callingConventionText As String
    Dim signatureText As String
    Dim argStartPos As Integer
    Dim sigKind As String
    Dim sigValue As String
    callingConventionText = "CDECL"
    signatureText = ""
    argStartPos = basePos + 3
    sigKind = UCase(Trim(ps.ast.nodes(sigNode).kind))
    sigValue = UCase(Trim(ps.ast.nodes(sigNode).value))

    ' UXB_007_REL10_FIX_20260712: support explicit typed form and legacy short
    ' direct form.  For CALL(API,...,CDECL,arg), result is unused and VOID is
    ' the correct statement contract.  For CALL(DLL,...,arg1,arg2), infer the
    ' return type from DECLARE FUNCTION and start runtime args at child 2.
    If sigKind = "KEYWORD_REF" Or sigKind = "IDENT" Or sigKind = "IDENTIFIER" Or sigKind = "TYPE_REF" Or sigKind = "VAR_REF" Then
        If FfiCallIsDllConvention(sigValue) <> 0 Then
            callingConventionText = sigValue
            signatureText = "VOID"
            argStartPos = basePos + 3
        Else
            signatureText = sigValue
            argStartPos = basePos + 3
        End If
    Else
        If FfiCallFindDeclaredReturnType(ps, ps.ast.nodes(symNode).value, signatureText) = 0 Then signatureText = "VOID"
        argStartPos = basePos + 2
    End If

    If argStartPos = basePos + 3 And argc >= basePos + 4 Then
        Dim convNode As Integer
        convNode = FfiCallChildAt(ps, nodeIdx, basePos + 3)
        If FfiCallNodeIndexValid(ps, convNode) <> 0 Then
            If UCase(ps.ast.nodes(convNode).kind) = "KEYWORD_REF" Then
                Dim convCandidate As String
                convCandidate = UCase(Trim(ps.ast.nodes(convNode).value))
                If FfiCallIsDllConvention(convCandidate) <> 0 Then
                    callingConventionText = convCandidate
                    argStartPos = basePos + 4
                End If
            End If
        End If
    End If

    entryOut.astNodeIndex = nodeIdx
    entryOut.lineNo = ps.ast.nodes(nodeIdx).lineNo
    entryOut.dllName = Trim(ps.ast.nodes(libNode).value)
    If resolvedCallKind = "API" And InStr(entryOut.dllName, ".") = 0 Then entryOut.dllName &= ".dll"
    entryOut.symbolName = Trim(ps.ast.nodes(symNode).value)
    entryOut.signatureText = UCase(Trim(signatureText))
    entryOut.callingConventionText = callingConventionText

    Dim typeListNode As Integer
    typeListNode = FfiCallChildAt(ps, nodeIdx, argStartPos)
    If FfiCallNodeIndexValid(ps, typeListNode) <> 0 Then
        If UCase(ps.ast.nodes(typeListNode).kind) = "STRING" Then
            If FfiCallLooksLikeArgTypeList(ps.ast.nodes(typeListNode).value) <> 0 Then
                argStartPos += 1
            ElseIf argc > argStartPos + 1 Then
                ' Parser validation is the normal gate. Keep the x64 FFI plan
                ' safe when a prebuilt or alternate AST reaches this backend:
                ' unknown metadata may not become a string-pointer argument.
                errText = "UXB_FFI_ARGUMENT_TYPE_LIST: CALL(DLL) invalid argument type-list token: " & _
                    Trim(ps.ast.nodes(typeListNode).value)
                Return -1
            End If
        End If
    End If

    entryOut.argumentCount = argc - argStartPos
    If entryOut.argumentCount < 0 Then entryOut.argumentCount = 0
    If entryOut.argumentCount > 10 Then
        errText = "ffi-x64: CALL(DLL) supports at most 10 runtime arguments at line " & LTrim(Str(ps.ast.nodes(nodeIdx).lineNo))
        Return -1
    End If

    Return 1
End Function

Private Function FfiCallCollectNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, entries() As FfiX64CallPlanEntry, ByRef entryCount As Integer, ByRef errText As String) As Integer
    If FfiCallNodeIndexValid(ps, nodeIdx) = 0 Then Return 1

    Dim readStatus As Integer
    Dim entry As FfiX64CallPlanEntry
    readStatus = FfiCallReadDllEntry(ps, nodeIdx, entry, errText)
    If readStatus < 0 Then Return 0
    If readStatus > 0 Then
        For seen As Integer = 0 To entryCount - 1
            If entries(seen).astNodeIndex = nodeIdx Then Return 1
        Next
        FfiCallPushEntry entries(), entryCount, entry
    End If

    If ps.ast.nodes(nodeIdx).left <> -1 Then
        If FfiCallNodeIndexValid(ps, ps.ast.nodes(nodeIdx).left) <> 0 Then
            If FfiCallCollectNode(ps, ps.ast.nodes(nodeIdx).left, entries(), entryCount, errText) = 0 Then Return 0
        End If
    End If

    If ps.ast.nodes(nodeIdx).right <> -1 Then
        If FfiCallNodeIndexValid(ps, ps.ast.nodes(nodeIdx).right) <> 0 Then
            If FfiCallCollectNode(ps, ps.ast.nodes(nodeIdx).right, entries(), entryCount, errText) = 0 Then Return 0
        End If
    End If

    Dim ch As Integer
    Dim guard As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    guard = 0
    Do While ch <> -1
        If FfiCallNodeIndexValid(ps, ch) = 0 Then Exit Do
        If FfiCallCollectNode(ps, ch, entries(), entryCount, errText) = 0 Then Return 0
        ch = ps.ast.nodes(ch).nextSibling
        guard += 1
        If guard > ps.ast.count Then Exit Do
    Loop

    Return 1
End Function

Private Function FfiCallCollectEntries(ByRef ps As ParseState, entries() As FfiX64CallPlanEntry, ByRef entryCount As Integer, ByRef errText As String) As Integer
    entryCount = 0
    If ps.rootNode = -1 Then
        errText = "ffi-x64: AST root is missing"
        Return 0
    End If

    Return FfiCallCollectNode(ps, ps.rootNode, entries(), entryCount, errText)
End Function

Private Function FfiCallPlanCsv(entries() As FfiX64CallPlanEntry, ByVal entryCount As Integer, ByRef csvOut As String) As Integer
    csvOut = "line,dll,symbol,signature,convention,arg_count,stack_args,reserve_bytes,abi,stack_align,shadow_space" & Chr(10)

    Dim i As Integer
    For i = 0 To entryCount - 1
        Dim stackArgCount As Integer
        stackArgCount = entries(i).argumentCount - 4
        If stackArgCount < 0 Then stackArgCount = 0

        Dim reserveBytes As Integer
        reserveBytes = 32 + (stackArgCount * 8)
        If (reserveBytes Mod 16) = 0 Then reserveBytes += 8

        csvOut &= LTrim(Str(entries(i).lineNo)) & "," & entries(i).dllName & "," & entries(i).symbolName & "," & entries(i).signatureText & "," & entries(i).callingConventionText & "," & LTrim(Str(entries(i).argumentCount)) & "," & LTrim(Str(stackArgCount)) & "," & LTrim(Str(reserveBytes)) & ",WIN64-MSABI,16,32"
        If i < entryCount - 1 Then csvOut &= Chr(10)
    Next i

    Return 1
End Function

Private Function FfiCallResolverCsv(entries() As FfiX64CallPlanEntry, ByVal entryCount As Integer, ByRef csvOut As String) As Integer
    csvOut = "stub_id,dll,symbol,signature,convention,arg_count,arg_stack_bytes,cleanup_type,symptr_label" & Chr(10)

    Dim i As Integer
    For i = 0 To entryCount - 1
        Dim stackArgCount As Integer
        stackArgCount = entries(i).argumentCount - 4
        If stackArgCount < 0 Then stackArgCount = 0

        Dim stubId As String
        stubId = LTrim(Str(i + 1))

        ' Win64 uses caller-managed stack space; keep the resolver metadata shape in sync with x86.
        csvOut &= stubId & "," & entries(i).dllName & "," & entries(i).symbolName & "," & entries(i).signatureText & "," & entries(i).callingConventionText & "," & LTrim(Str(entries(i).argumentCount)) & "," & LTrim(Str(stackArgCount * 8)) & ",CALLER,__uxb_ffi_symptr_" & stubId
        If i < entryCount - 1 Then csvOut &= Chr(10)
    Next i

    Return 1
End Function

Private Function FfiCallResolverCText(entries() As FfiX64CallPlanEntry, ByVal entryCount As Integer, ByRef cOut As String) As Integer
    cOut = "/* uXBasic generated x64 FFI resolver */" & Chr(10)
    cOut &= "#include <windows.h>" & Chr(10)
    cOut &= "#include <stdint.h>" & Chr(10)
    cOut &= "#include <stdio.h>" & Chr(10)
    cOut &= "#include <string.h>" & Chr(10) & Chr(10)

    Dim i As Integer
    For i = 0 To entryCount - 1
        Dim stubId As String
        stubId = LTrim(Str(i + 1))
        cOut &= "extern void* __uxb_ffi_symptr_" & stubId & ";" & Chr(10)
    Next i

    cOut &= Chr(10) & "static int uxb_is_absolute_dll_path(const char* path) {" & Chr(10)
    cOut &= "    if (!path || !path[0]) return 0;" & Chr(10)
    cOut &= "    if ((path[0] == '\\' && path[1] == '\\') || path[0] == '/') return 1;" & Chr(10)
    cOut &= "    if (((path[0] >= 'A' && path[0] <= 'Z') || (path[0] >= 'a' && path[0] <= 'z')) && path[1] == ':') return 1;" & Chr(10)
    cOut &= "    return 0;" & Chr(10)
    cOut &= "}" & Chr(10) & Chr(10)
    cOut &= "static HMODULE uxb_load_library_for_program(const char* dll_name) {" & Chr(10)
    cOut &= "    HMODULE h = LoadLibraryA(dll_name);" & Chr(10)
    cOut &= "    if (h) return h;" & Chr(10)
    cOut &= "    if (!dll_name || !dll_name[0] || uxb_is_absolute_dll_path(dll_name)) return NULL;" & Chr(10)
    cOut &= "    char module_path[MAX_PATH];" & Chr(10)
    cOut &= "    DWORD n = GetModuleFileNameA(NULL, module_path, MAX_PATH);" & Chr(10)
    cOut &= "    if (n == 0 || n >= MAX_PATH) return NULL;" & Chr(10)
    cOut &= "    char* tail = module_path + strlen(module_path);" & Chr(10)
    cOut &= "    while (tail > module_path && tail[-1] != '\\' && tail[-1] != '/') --tail;" & Chr(10)
    cOut &= "    *tail = '\0';" & Chr(10)
    cOut &= "    size_t dir_len = strlen(module_path);" & Chr(10)
    cOut &= "    size_t dll_len = strlen(dll_name);" & Chr(10)
    cOut &= "    if (dir_len + 1 + dll_len + 1 > MAX_PATH) return NULL;" & Chr(10)
    cOut &= "    char full_path[MAX_PATH];" & Chr(10)
    cOut &= "    memcpy(full_path, module_path, dir_len);" & Chr(10)
    cOut &= "    full_path[dir_len] = '\\';" & Chr(10)
    cOut &= "    memcpy(full_path + dir_len + 1, dll_name, dll_len + 1);" & Chr(10)
    cOut &= "    return LoadLibraryA(full_path);" & Chr(10)
    cOut &= "}" & Chr(10) & Chr(10)
    cOut &= "static void uxb_resolve_fail(const char* op, const char* dll_name, const char* symbol_name) {" & Chr(10)
    cOut &= "    fprintf(stderr, ""uXBasic x64 FFI resolve failed: %s dll=%s symbol=%s\n"", op ? op : ""?"", dll_name ? dll_name : ""?"", symbol_name ? symbol_name : ""?"");" & Chr(10)
    cOut &= "    fflush(stderr);" & Chr(10)
    cOut &= "    ExitProcess(127);" & Chr(10)
    cOut &= "}" & Chr(10) & Chr(10)
    cOut &= "static void uxb_resolve_one(void** target, const char* dll_name, const char* symbol_name) {" & Chr(10)
    cOut &= "    if (!target || *target) return;" & Chr(10)
    cOut &= "    HMODULE h = uxb_load_library_for_program(dll_name);" & Chr(10)
    cOut &= "    if (!h) uxb_resolve_fail(""LoadLibraryA"", dll_name, symbol_name);" & Chr(10)
    cOut &= "    FARPROC proc = GetProcAddress(h, symbol_name);" & Chr(10)
    cOut &= "    if (!proc) uxb_resolve_fail(""GetProcAddress"", dll_name, symbol_name);" & Chr(10)
    cOut &= "    *target = (void*)proc;" & Chr(10)
    cOut &= "}" & Chr(10) & Chr(10)

    cOut &= "__declspec(dllexport) void __uxb_ffi_resolve_all(void) {" & Chr(10)
    For i = 0 To entryCount - 1
        Dim stubId As String
        stubId = LTrim(Str(i + 1))
        cOut &= "    uxb_resolve_one(&__uxb_ffi_symptr_" & stubId & ", """
        cOut &= FfiCallCStringEscape(entries(i).dllName) & """, """
        cOut &= FfiCallCStringEscape(entries(i).symbolName) & """);" & Chr(10)
    Next i
    cOut &= "}" & Chr(10)

    Return 1
End Function

Private Function FfiCallNasmStubText(entries() As FfiX64CallPlanEntry, ByVal entryCount As Integer, ByRef asmOut As String) As Integer
    asmOut = "; uXBasic FFI x64 call stub plan" & Chr(10)
    asmOut &= "; ABI=WIN64-MSABI STACK=16 SHADOW=32" & Chr(10)
    asmOut &= "bits 64" & Chr(10) & Chr(10)
    asmOut &= "default rel" & Chr(10)
    asmOut &= "extern exit" & Chr(10)
    asmOut &= "section .text" & Chr(10) & Chr(10)

    Dim i As Integer
    For i = 0 To entryCount - 1
        Dim stubId As String
        stubId = LTrim(Str(i + 1))

        asmOut &= "global __uxb_ffi_stub_" & stubId & Chr(10)
        asmOut &= "global __uxb_ffi_symptr_" & stubId & Chr(10)
        Dim argDeclIdx As Integer
        For argDeclIdx = 1 To entries(i).argumentCount
            asmOut &= "global __uxb_ffi_arg_" & stubId & "_" & LTrim(Str(argDeclIdx)) & Chr(10)
        Next argDeclIdx
        asmOut &= "__uxb_ffi_stub_" & stubId & ":" & Chr(10)
        asmOut &= "    ; line=" & LTrim(Str(entries(i).lineNo)) & " dll=" & entries(i).dllName & " symbol=" & entries(i).symbolName & " conv=" & entries(i).callingConventionText & Chr(10)

        Dim stackArgCount As Integer
        stackArgCount = entries(i).argumentCount - 4
        If stackArgCount < 0 Then stackArgCount = 0

        Dim reserveBytes As Integer
        reserveBytes = 32 + (stackArgCount * 8)
        If (reserveBytes Mod 16) = 0 Then reserveBytes += 8

        asmOut &= "    ; arg_count=" & LTrim(Str(entries(i).argumentCount)) & " stack_args=" & LTrim(Str(stackArgCount)) & " reserve=" & LTrim(Str(reserveBytes)) & Chr(10)
        asmOut &= "    sub rsp, " & LTrim(Str(reserveBytes)) & Chr(10)

        Dim regArgCount As Integer
        regArgCount = entries(i).argumentCount
        If regArgCount > 4 Then regArgCount = 4

        If regArgCount >= 1 Then
            asmOut &= "    mov rcx, qword [rel __uxb_ffi_arg_" & stubId & "_1]" & Chr(10)
            asmOut &= "    movq xmm0, rcx" & Chr(10)
        End If
        If regArgCount >= 2 Then
            asmOut &= "    mov rdx, qword [rel __uxb_ffi_arg_" & stubId & "_2]" & Chr(10)
            asmOut &= "    movq xmm1, rdx" & Chr(10)
        End If
        If regArgCount >= 3 Then
            asmOut &= "    mov r8, qword [rel __uxb_ffi_arg_" & stubId & "_3]" & Chr(10)
            asmOut &= "    movq xmm2, r8" & Chr(10)
        End If
        If regArgCount >= 4 Then
            asmOut &= "    mov r9, qword [rel __uxb_ffi_arg_" & stubId & "_4]" & Chr(10)
            asmOut &= "    movq xmm3, r9" & Chr(10)
        End If

        Dim stackArgIdx As Integer
        For stackArgIdx = 5 To entries(i).argumentCount
            Dim slotIdx As Integer
            slotIdx = stackArgIdx - 5
            Dim slotOffset As Integer
            slotOffset = 32 + (slotIdx * 8)
            asmOut &= "    mov rax, qword [rel __uxb_ffi_arg_" & stubId & "_" & LTrim(Str(stackArgIdx)) & "]" & Chr(10)
            asmOut &= "    mov qword [rsp+" & LTrim(Str(slotOffset)) & "], rax" & Chr(10)
        Next stackArgIdx

        asmOut &= "    mov r11, qword [rel __uxb_ffi_symptr_" & stubId & "]" & Chr(10)
        asmOut &= "    test r11, r11" & Chr(10)
        asmOut &= "    jnz __uxb_ffi_call_" & stubId & Chr(10)
        asmOut &= "    mov ecx, 127" & Chr(10)
        asmOut &= "    call exit" & Chr(10)
        asmOut &= "    ud2" & Chr(10)
        asmOut &= "__uxb_ffi_call_" & stubId & ":" & Chr(10)
        asmOut &= "    call r11" & Chr(10)
        asmOut &= "    add rsp, " & LTrim(Str(reserveBytes)) & Chr(10)
        asmOut &= "    ret" & Chr(10)
        asmOut &= "section .data" & Chr(10)
        asmOut &= "__uxb_ffi_symptr_" & stubId & ": dq 0" & Chr(10)

        Dim argIdx As Integer
        For argIdx = 1 To entries(i).argumentCount
            asmOut &= "__uxb_ffi_arg_" & stubId & "_" & LTrim(Str(argIdx)) & ": dq 0" & Chr(10)
        Next argIdx

        asmOut &= "section .text" & Chr(10)

        If i < entryCount - 1 Then asmOut &= Chr(10)
    Next i

    Return 1
End Function


Private Sub FfiEnsureDirSafe(ByRef dirPath As String)
    ' X64_FFI_ARTIFACT_MKDIR_SAFE_FIX_20260712 / X64_FFI_FB_SYNTAX_BOUNDS_FIX_20260712:
    ' FreeBASIC in this build does not accept the VB-style "On Error Resume Next".
    ' Avoid the exception path completely: only call MkDir when the directory is
    ' absent.  X64BuildEmitArtifacts normally creates this directory first, so this
    ' is a compatibility guard rather than the primary directory creation path.
    If Trim(dirPath) = "" Then Exit Sub
    If Dir(dirPath, 16) = "" Then MkDir dirPath
End Sub

Private Function FfiWriteTextFile(ByRef filePath As String, ByRef fileText As String, ByRef errText As String) As Integer
    Dim f As Integer
    f = FreeFile

    Open filePath For Output As #f
    If Err <> 0 Then
        errText = "ffi-x64: cannot write " & filePath
        Return 0
    End If

    Print #f, fileText;
    Close #f
    Return 1
End Function

Private Sub FfiDeleteGeneratedFile(ByRef filePath As String)
    If Dir(filePath) = "" Then Exit Sub
    Kill filePath
    Err = 0
End Sub

Function FfiX64BackendValidate(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim entries(Any) As FfiX64CallPlanEntry
    Dim entryCount As Integer
    If FfiCallCollectEntries(ps, entries(), entryCount, errText) = 0 Then Return 0

    If entryCount = 0 Then
        errText = "ffi-x64: no CALL(DLL) nodes found"
        Return 0
    End If

    Return 1
End Function

Function FfiX64BackendEmitPlan(ByRef ps As ParseState, ByRef planCsv As String, ByRef errText As String) As Integer
    Dim entries(Any) As FfiX64CallPlanEntry
    Dim entryCount As Integer
    If FfiCallCollectEntries(ps, entries(), entryCount, errText) = 0 Then Return 0

    Return FfiCallPlanCsv(entries(), entryCount, planCsv)
End Function

Function FfiX64BackendEmitNasmStubs(ByRef ps As ParseState, ByRef asmText As String, ByRef errText As String) As Integer
    Dim entries(Any) As FfiX64CallPlanEntry
    Dim entryCount As Integer
    If FfiCallCollectEntries(ps, entries(), entryCount, errText) = 0 Then Return 0

    If entryCount = 0 Then
        errText = "ffi-x64: no CALL(DLL) nodes found"
        Return 0
    End If

    Return FfiCallNasmStubText(entries(), entryCount, asmText)
End Function

Function FfiX64BackendEmitResolverC(ByRef ps As ParseState, ByRef cText As String, ByRef errText As String) As Integer
    Dim entries(Any) As FfiX64CallPlanEntry
    Dim entryCount As Integer
    If FfiCallCollectEntries(ps, entries(), entryCount, errText) = 0 Then Return 0

    Return FfiCallResolverCText(entries(), entryCount, cText)
End Function

Function FfiX64BackendEmitArtifacts(ByRef ps As ParseState, ByRef outputDir As String, ByRef errText As String) As Integer
    Dim entries(Any) As FfiX64CallPlanEntry
    Dim entryCount As Integer
    If FfiCallCollectEntries(ps, entries(), entryCount, errText) = 0 Then Return 0

    Dim planCsv As String
    Dim resolverCsv As String
    Dim asmText As String
    Dim resolverCText As String
    FfiCallPlanCsv entries(), entryCount, planCsv
    FfiCallResolverCsv entries(), entryCount, resolverCsv
    FfiCallNasmStubText entries(), entryCount, asmText
    FfiCallResolverCText entries(), entryCount, resolverCText

    FfiEnsureDirSafe outputDir

    Dim planPath As String
    planPath = outputDir & "\\ffi_call_x64_plan.csv"

    Dim asmPath As String
    asmPath = outputDir & "\\ffi_call_x64_stubs.asm"

    Dim resolverCsvPath As String
    resolverCsvPath = outputDir & "\\ffi_call_x64_resolver.csv"

    Dim resolverPath As String
    resolverPath = outputDir & "\\ffi_resolver.c"

    If FfiWriteTextFile(planPath, planCsv, errText) = 0 Then Return 0
    If entryCount > 0 Then
        If FfiWriteTextFile(asmPath, asmText, errText) = 0 Then Return 0
        If FfiWriteTextFile(resolverCsvPath, resolverCsv, errText) = 0 Then Return 0
        If FfiWriteTextFile(resolverPath, resolverCText, errText) = 0 Then Return 0
    Else
        ' A reused build directory must reflect the current source.  Old FFI
        ' resolver/stub files would otherwise be compiled and linked again.
        FfiDeleteGeneratedFile asmPath
        FfiDeleteGeneratedFile resolverCsvPath
        FfiDeleteGeneratedFile resolverPath
    End If

    Return 1
End Function
