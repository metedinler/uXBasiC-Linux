    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_peek_i64", addrReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimePokeI64(ByRef cg As MIRX64Context, ByRef addrReg As String, ByRef valueReg As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_poke_i64", addrReg, valueReg
    Return 1
End Function

Function MIRX64EmitRuntimeStringRight(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef countReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_right", textReg, countReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringLeft(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef countReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_left", textReg, countReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringMid(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef startReg As String, ByRef lenReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_mid", textReg, startReg, lenReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringInstr(ByRef cg As MIRX64Context, ByRef textReg As String, ByRef needleReg As String, ByRef startReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_instr", textReg, needleReg, startReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringFromI64(ByRef cg As MIRX64Context, ByRef valueReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_str_i64", valueReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileOpen(ByRef cg As MIRX64Context, ByRef fileReg As String, ByRef modeReg As String, ByRef handleReg As String, ByRef lenReg As String) As Integer
    If Trim(lenReg) = "" Then
        MIRX64Emit cg, "    xor rbx, rbx"
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_open", fileReg, modeReg, handleReg, "rbx"
    Else
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_open", fileReg, modeReg, handleReg, lenReg
    End If
    Return 1
End Function

Function MIRX64EmitRuntimeFileClose(ByRef cg As MIRX64Context, ByRef handleReg As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_close", handleReg
    Return 1
End Function

Function MIRX64EmitRuntimeFileSeek(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef posReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    If Trim(posReg) = "" Then
        MIRX64Emit cg, "    mov r10, -1"
        MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_file_seek", handleReg, "r10"
    Else
        MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_file_seek", handleReg, posReg
    End If
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileEof(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_eof", handleReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileLof(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_lof", handleReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileGet(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef posReg As String, ByRef bytesReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    If Trim(posReg) = "" Then
        MIRX64Emit cg, "    mov r10, -1"
        MIRX64Emit cg, "    mov r11, 1"
        MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_file_get", handleReg, "r10", "r11"
    ElseIf Trim(bytesReg) = "" Then
        MIRX64Emit cg, "    mov r11, 1"
        MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_file_get", handleReg, posReg, "r11"
    Else
        MIRX64EmitRuntimeCall3Reg cg, "__uxb_rt_file_get", handleReg, posReg, bytesReg
    End If
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFilePut(ByRef cg As MIRX64Context, ByRef handleReg As String, ByRef posReg As String, ByRef bytesReg As String, ByRef valueReg As String) As Integer
    If Trim(posReg) = "" Then
        MIRX64Emit cg, "    mov r10, -1"
        MIRX64Emit cg, "    mov r11, 1"
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_put", handleReg, "r10", "r11", valueReg
    ElseIf Trim(bytesReg) = "" Then
        MIRX64Emit cg, "    mov r11, 1"
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_put", handleReg, posReg, "r11", valueReg
    Else
        MIRX64EmitRuntimeCall4Reg cg, "__uxb_rt_file_put", handleReg, posReg, bytesReg, valueReg
    End If
    Return 1
End Function

Function MIRX64EmitRuntimeUnsupportedDiagnostic(ByRef cg As MIRX64Context, ByRef opcodeText As String, ByRef reasonText As String) As Integer
    MIRX64AddError cg, "TR: MIR_X64_RUNTIME_BACKED_BEKLEMEDE: " & opcodeText & " - " & reasonText & " | EN: MIR_X64_RUNTIME_BACKED_PENDING: " & opcodeText & " - " & reasonText
    Return 0
End Function



Function MIRX64EmitRuntimeUnaryI64(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef valueReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, symbolName, valueReg
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeBinaryI64(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef leftReg As String, ByRef rightReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, symbolName, leftReg, rightReg
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeNoArgI64(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall0 cg, symbolName
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringUnary(ByRef cg As MIRX64Context, ByRef symbolName As String, ByRef textReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, symbolName, textReg
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringConcat(ByRef cg As MIRX64Context, ByRef leftReg As String, ByRef rightReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_str_concat", leftReg, rightReg
    If MIRX64StoreRegToVar(cg, "rax", resultVar, errText) = 0 Then Return 0
    ' S-142: the result holds a string POINTER. A temp whose type is unknown or integer (the ADD that made
    ' it was typed I64 when no static type was stamped) made `PRINT "x=" + STR(7)` / `PRINT "[" + p + "]"`
    ' print the pointer as a number; `r = "x=" + ...` only worked because the store into a STRING variable
    ' fixed the type up.
    Dim concatSlot As Integer
    If MIRX64FindLocalIndex(cg, resultVar, concatSlot) <> 0 Then
        Dim concatType As String
        concatType = UCase(Trim(cg.locals(concatSlot).typeName))
        If Left(concatType, 5) = "TYPE_" Then concatType = Mid(concatType, 6)
        If concatType = "" Or concatType = "I64" Or concatType = "I32" Or concatType = "OBJECT" Then cg.locals(concatSlot).typeName = "STRING"
    End If
    Return 1
End Function

Function MIRX64EmitRuntimeStringCompare(ByRef cg As MIRX64Context, ByRef leftReg As String, ByRef rightReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_str_compare", leftReg, rightReg
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeStringRelation(ByRef cg As MIRX64Context, ByRef leftReg As String, ByRef rightReg As String, ByRef relationOp As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall2Reg cg, "__uxb_rt_str_compare", leftReg, rightReg
    MIRX64Emit cg, "    cmp rax, 0"
    Select Case UCase(Trim(relationOp))
    Case "EQ": MIRX64Emit cg, "    sete al"
    Case "NE": MIRX64Emit cg, "    setne al"
    Case "LT": MIRX64Emit cg, "    setl al"
    Case "LE": MIRX64Emit cg, "    setle al"
    Case "GT": MIRX64Emit cg, "    setg al"
    Case "GE": MIRX64Emit cg, "    setge al"
    Case Else
        errText = "MIR x64 runtime string relation is unsupported: " & relationOp
        Return 0
    End Select
    MIRX64Emit cg, "    movzx rax, al"
    MIRX64Emit cg, "    neg rax"
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeFileDelete(ByRef cg As MIRX64Context, ByRef pathReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_file_delete", pathReg
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeHostCallNamed(ByRef cg As MIRX64Context, ByRef hostName As String, ByRef resultVar As String, ByRef errText As String) As Integer
    Dim litLabel As String
    Dim literalText As String
    literalText = Chr(34) & UCase(Trim(hostName)) & Chr(34)
    If MIRX64EnsureStringLiteralLabel(cg, literalText, litLabel) = 0 Then
        errText = "MIR x64 runtime host call label failed"
        Return 0
    End If
    MIRX64Emit cg, "    lea rcx, [rel " & litLabel & "]"
    MIRX64EmitRuntimeExtern cg, "__uxb_rt_host_call"
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call __uxb_rt_host_call"
    MIRX64Emit cg, "    add rsp, 32"
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeBigInit(ByRef cg As MIRX64Context, ByRef valueReg As String, ByRef resultVar As String, ByRef errText As String) As Integer
    MIRX64EmitRuntimeCall1Reg cg, "__uxb_rt_biginit", valueReg
    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeHostCallInstruction( _
    ByRef cg As MIRX64Context, _
    ByRef hostName As String, _
    ByRef ins As MIRIRInstruction, _
    ByVal firstArgIndex As Integer, _
    ByRef resultVar As String, _
    ByRef errText As String _
) As Integer
    Dim litLabel As String
    Dim literalText As String
    literalText = Chr(34) & UCase(Trim(hostName)) & Chr(34)
    If MIRX64EnsureStringLiteralLabel(cg, literalText, litLabel) = 0 Then
        errText = "MIR x64 runtime host-call instruction label failed: " & hostName
        Return 0
    End If

    MIRX64Emit cg, "    lea rcx, [rel " & litLabel & "]"

    If ins.operandCount > firstArgIndex Then
        If MIRX64LoadOperandToReg(cg, ins.operands(firstArgIndex), "rdx", errText) = 0 Then Return 0
    Else
        MIRX64Emit cg, "    xor rdx, rdx"
    End If

    If ins.operandCount > firstArgIndex + 1 Then
        If MIRX64LoadOperandToReg(cg, ins.operands(firstArgIndex + 1), "r8", errText) = 0 Then Return 0
    Else
        MIRX64Emit cg, "    xor r8, r8"
    End If

    If ins.operandCount > firstArgIndex + 2 Then
        If MIRX64LoadOperandToReg(cg, ins.operands(firstArgIndex + 2), "r9", errText) = 0 Then Return 0
    Else
        MIRX64Emit cg, "    xor r9, r9"
    End If

    MIRX64EmitRuntimeExtern cg, "__uxb_rt_host_call4"
    MIRX64Emit cg, "    sub rsp, 32"
    MIRX64Emit cg, "    call __uxb_rt_host_call4"
    MIRX64Emit cg, "    add rsp, 32"

    If Trim(resultVar) = "" Then Return 1
    Return MIRX64StoreRegToVar(cg, "rax", resultVar, errText)
End Function

Function MIRX64EmitRuntimeSurfaceCall( _
    ByRef cg As MIRX64Context, _
    ByRef surfaceName As String, _
    ByRef ins As MIRIRInstruction, _
    ByRef errText As String _
) As Integer
    Return MIRX64EmitRuntimeHostCallInstruction(cg, surfaceName, ins, 0, ins.result, errText)
End Function

Function MIRX64EmitRuntimeCallTargetWithArgs( _
    ByRef cg As MIRX64Context, _
    ByRef callTarget As String, _
    ByRef ins As MIRIRInstruction, _
    ByRef errText As String _
) As Integer
    Return MIRX64EmitRuntimeHostCallInstruction(cg, callTarget, ins, 1, ins.result, errText)
End Function

#endif
