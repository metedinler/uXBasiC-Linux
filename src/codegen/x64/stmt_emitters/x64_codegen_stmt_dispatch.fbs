' Extracted from code_generator.fbs for wave-14 modular split
' Scope: node->statement dispatcher

' S-538: END ends the whole program, like every other engine. At main level that is the jump to the main epilogue (task
' shutdown, native runtime shutdown, exit status 0); inside a SUB/FUNCTION/method the frame belongs to the routine, so the
' run-time performs the same normal close and ends the process (MIR-x64: PROGRAM_END -> __uxb_rt_program_end).
Private Function X64EmitEndStmt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    X64EmitComment cg, "stmt: END"
    X64LockUnwindTransfer ps, nodeIdx, cg, "RETURN"
    If Trim(cg.currentRoutineLabel) = "" And cg.currentEpilogLabel <> "" Then
        X64EmitText cg, "    jmp " & cg.currentEpilogLabel
    Else
        X64EmitCall0 cg, "__uxb_rt_program_end"
    End If
    Return 1
End Function

Private Function X64EmitNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef cg As X64CodegenContext, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "x64-codegen: invalid AST node index " & LTrim(Str(nodeIdx))
        Return 0
    End If
    gX64LastEmitNode = nodeIdx

    Dim nodeKind As String
    nodeKind = X64Upper(ps.ast.nodes(nodeIdx).kind)

    Select Case nodeKind
    Case "PROGRAM"
        Return X64EmitProgram(ps, nodeIdx, cg, errText)
    Case "SUB_STMT", "SUB_DECL", "SUB"
        Return X64EmitSubStmt(ps, nodeIdx, cg, errText)
    Case "FUNCTION_STMT", "FUNCTION_DECL", "FUNCTION"
        Return X64EmitFunctionStmt(ps, nodeIdx, cg, errText)
    Case "TYPE_STMT", "TYPE_FIELD", "CLASS_STMT", "CLASS_FIELD", "CLASS_PROPERTY_DECL", "CLASS_PROPERTY_FLAG", "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "CLASS_OPERATOR_DECL", "CLASS_METHOD_FLAG", "CLASS_METHOD_SLOT", "CLASS_ACCESS", "CLASS_BASE_REF", "CLASS_IMPLEMENTS_REF", "CLASS_FRIEND_STMT", "FRIEND_ITEM", "INTERFACE_STMT", "INTERFACE_METHOD_DECL", "CONST_STMT", "CONST_DECL", _
         "DECLARE_SUB_STMT", "DECLARE_FUNCTION_STMT", "IMPORT_STMT", "INCLUDE_STMT", "USING_STMT", "ALIAS_STMT", "NAMESPACE_STMT", "MODULE_STMT", "PARAM_DECL", "RETURN_TYPE", "TYPE_REF", "USING_ITEM", "ALIAS_TARGET", "KEYWORD_REF", "ENUM_STMT", "ENUM_ITEM", "ENUM_BASE_TYPE"
        ' UXB_007_REL10_FIX_20260712: metadata/compile-time containers are
        ' consumed by semantic/layout/interop or X64EmitProgram container passes.
        Return 1
    Case "CLASS_METHOD_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL"
        Return X64EmitClassRoutineNode(ps, nodeIdx, cg, errText)
    Case "DIM_STMT", "DIM", "REDIM_STMT", "REDIM"
        Return GenerateStatement(ps, nodeIdx, cg, errText)
    Case "IF_STMT", "IF"
        Return X64EmitIfStmt(ps, nodeIdx, cg, errText)
    Case "LOCK_STMT"
        Return X64EmitLockStmt(ps, nodeIdx, cg, errText)
    Case "SELECT_STMT"
        Return X64EmitSelectStmt(ps, nodeIdx, cg, errText)
    Case "FOR_STMT", "FOR"
        Return X64EmitForStmt(ps, nodeIdx, cg, errText)
    Case "FOR_EACH_STMT"
        Return X64EmitForEachStmt(ps, nodeIdx, cg, errText)
    Case "DO_STMT"
        Return X64EmitDoStmt(ps, nodeIdx, cg, errText)
    Case "DO_EACH_STMT"
        Return X64EmitDoEachStmt(ps, nodeIdx, cg, errText)
    Case "TRY_STMT"
        Return X64EmitTryStmt(ps, nodeIdx, cg, errText)
    Case "THROW_STMT"
        Return X64EmitThrowStmt(ps, nodeIdx, cg, errText)
    Case "LABEL_STMT"
        Return X64EmitLabelStmt(ps, nodeIdx, cg, errText)
    Case "GOTO_STMT"
        Return X64EmitGotoStmt(ps, nodeIdx, cg, errText)
    Case "GOSUB_STMT"
        Return X64EmitGosubStmt(ps, nodeIdx, cg, errText)
    Case "NEXT_STMT", "NEXT"
        Return X64EmitNextStmt(ps, nodeIdx, cg, errText)
    Case "CALL_STMT", "CALL_EXPR", "CALL", "CALL_DLL_STMT", "CALL_API_STMT"
        ' UXB_009_REALCODE_FIX_20260712: lowered native calls must emit real FFI
        ' argument stores and __uxb_ffi_stub_N calls; they may not become comments.
        Return GenerateStatement(ps, nodeIdx, cg, errText)
    Case "PRINT_STMT", "PRINT"
        Return GenerateStatement(ps, nodeIdx, cg, errText)
    Case "CLS_STMT", "LOCATE_STMT", "COLOR_STMT", "RANDOMIZE_STMT", "INPUT_STMT", "INPUT_FILE_STMT", "OPEN_STMT", "CLOSE_STMT", "GET_STMT", "PUT_STMT", "SEEK_STMT", "POKEB_STMT", "POKEW_STMT", "POKED_STMT", "POKEQ_STMT", "POKES_STMT", "MEMCOPYB_STMT", "MEMCOPYW_STMT", "MEMCOPYD_STMT", "MEMCOPYQ_STMT", "MEMFILLB_STMT", "MEMFILLW_STMT", "MEMFILLD_STMT", "MEMFILLQ_STMT", "SETNEWOFFSET_STMT", "EVENT_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT", "SLOT_STMT", "SLOT_TABLE_STMT", "SLOT_CONTROL_STMT", "TRIGGER_STMT", "SHELL_STMT", "ASSERT_STMT", "DEFTYPE_STMT", "SETSTRINGSIZE_STMT"
        Return GenerateStatement(ps, nodeIdx, cg, errText)
    Case "RETURN_STMT", "RETURN"
        Return X64EmitReturnStmt(ps, nodeIdx, cg, errText)
    Case "EXIT_STMT", "CONTINUE_STMT"
        Return X64EmitExitStmt(ps, nodeIdx, cg, errText)
    Case "END_STMT"
        Return X64EmitEndStmt(ps, nodeIdx, cg, errText)
    Case "DELETE_STMT"
        Return X64EmitDeleteStmt(ps, nodeIdx, cg, errText)
    Case "UNSAFE_STMT"
        ' UNSAFE only waives semantic/synchronization guarantees for its body.
        ' The children still emit normally, including real FFI calls and RETURN.
        Return X64EmitBlockStmt(ps, nodeIdx, cg, errText)
    Case "BLOCK", "SCOPE_BLOCK", "BODY"
        Return X64EmitBlockStmt(ps, nodeIdx, cg, errText)
    Case "EXPR_STMT", "LET_STMT"
        Return X64EmitExprStmt(ps, nodeIdx, cg, errText)
    Case "ASSIGN_STMT"
        Return X64SyncEmitAssign(ps, nodeIdx, cg, errText)
    Case "INCDEC_STMT"
        Return X64SyncEmitAssign(ps, nodeIdx, cg, errText)
    Case Else
        Return X64EmitUnknownNode(ps, nodeIdx, cg, errText)
    End Select
End Function
