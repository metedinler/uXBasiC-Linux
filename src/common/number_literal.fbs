#ifndef UXB_NUMBER_LITERAL_FBS
#define UXB_NUMBER_LITERAL_FBS

' Shared number-literal classification (S-078).
'
' A NUMBER token is shared by decimal integers, floating literals and the
' &H / &O / &B integer forms. Every layer used to decide "float?" with its own
' `InStr(text, ".") Or InStr(UCase(text), "E")`, which mistakes the hexadecimal
' digit E (`&hFE`, `&h7FFE`) for a decimal exponent -- so those literals were
' typed F64, rejected by the integer-literal validator, or lowered as floats.
' One definition, used by the type inference, MIR lowering/exporters, the
' interpreters and the legacy x64 backend.
Function UXBNumberLiteralIsFloat(ByRef literalText As String) As Integer
    Dim t As String
    t = Trim(literalText)
    If t = "" Then Return 0
    ' A sign may precede the radix prefix in folded text ("-&HFE").
    If Left(t, 1) = "-" Or Left(t, 1) = "+" Then t = Mid(t, 2)
    If Left(t, 1) = "&" Then Return 0
    If InStr(t, ".") > 0 Then Return 1
    If InStr(UCase(t), "E") > 0 Then Return 1
    Return 0
End Function

' S-101 / TUR5: dimensions are positive integer literals, never truncated
' floating point values. Parse radix digits directly and reject I32 overflow.
Function UXBArrayDimensionLiteral(ByRef rawText As String, ByRef dimensionOut As Integer) As Integer
    dimensionOut = 0
    Dim t As String = UCase(Trim(rawText))
    If t = "" Then Return 0
    Dim baseValue As Integer = 10
    If Left(t, 2) = "&H" Or Left(t, 2) = "0X" Then
        baseValue = 16
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "&O" Or Left(t, 2) = "0O" Then
        baseValue = 8
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "&B" Or Left(t, 2) = "%B" Or Left(t, 2) = "0B" Then
        baseValue = 2
        t = Mid(t, 3)
    End If
    If t = "" Then Return 0
    Dim acc As LongInt = 0
    Dim sawDigit As Integer = 0
    For i As Integer = 1 To Len(t)
        Dim ch As String = Mid(t, i, 1)
        If ch = "_" Then Continue For
        Dim digit As Integer = -1
        If ch >= "0" And ch <= "9" Then
            digit = Asc(ch) - Asc("0")
        ElseIf ch >= "A" And ch <= "F" Then
            digit = 10 + Asc(ch) - Asc("A")
        End If
        If digit < 0 Or digit >= baseValue Then Return 0
        If acc > (2147483647LL - CLngInt(digit)) \ CLngInt(baseValue) Then Return 0
        acc = acc * CLngInt(baseValue) + CLngInt(digit)
        sawDigit = 1
    Next i
    If sawDigit = 0 Or acc = 0 Then Return 0
    dimensionOut = CInt(acc)
    Return 1
End Function

#endif
