#ifndef UXB_COMMON_DIAGNOSTIC_SCHEMA_WRITER_FBS
#define UXB_COMMON_DIAGNOSTIC_SCHEMA_WRITER_FBS

#include once "json_builder.fbs"
#include once "report_writer.fbs"

#include once "diagnostic_schema_data.fbs"

Function UXBWriteDiagnosticSchemaJson(ByRef outPath As String, ByRef errText As String) As Integer
    Dim jsonText As String
    UXBDiagnosticSchemaJson jsonText
    Return UXBReportWriteText(outPath, jsonText, errText)
End Function

Function UXBWriteJsonSchemaReportCsv(ByRef outPath As String, ByRef errText As String) As Integer
    Dim csvText As String
    csvText = "schema,field,required,notes" & Chr(10)
    csvText &= "diagnostic,code,1,must not be empty" & Chr(10)
    csvText &= "diagnostic,severity,1,info warning error fatal" & Chr(10)
    csvText &= "diagnostic,layer,1,lexer parser ast semantic hir mir runtime backend" & Chr(10)
    csvText &= "diagnostic,message_tr,1,Turkish message" & Chr(10)
    csvText &= "diagnostic,message_en,1,English message" & Chr(10)
    csvText &= "diagnostic,occurrences,1,deduplicated occurrence count" & Chr(10)
    csvText &= "diagnostic,source.known,1,positive line and column or unknown coordinates" & Chr(10)
    csvText &= "diagnostic,source,1,file line col length" & Chr(10)
    csvText &= "source_map,source_stage,1,origin stage" & Chr(10)
    csvText &= "source_map,target_stage,1,next stage" & Chr(10)
    csvText &= "source_map,source_location,1,location must be preserved when available" & Chr(10)
    Return UXBReportWriteText(outPath, csvText, errText)
End Function

#endif
