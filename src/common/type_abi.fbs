#ifndef UXB_TYPE_ABI_FBS
#define UXB_TYPE_ABI_FBS

' Physical ABI of the builtin scalar types -- ONE table (S-079).
'
' Three numbers per type, kept as separate concepts:
'   payload : the bytes of the value itself   -> SIZEOF(T), struct field size
'   align   : the required alignment
'   stride  : the storage cell of one ARRAY ELEMENT = alignUp(payload, align),
'             except where a type documents a wider cell (see BIG*)
'
' F80 (x87 extended precision) is the case that motivated splitting them:
' payload 10 (sign+15-bit exponent+64-bit mantissa), aligned 16, so an array
' element is a 16-byte cell of which the first 10 bytes are the value. Before
' this table, layout said 10/8, the array memory-ref and MIR-x64 said 16 and the
' MIR DIM lowering passed 10 -- MIR-x64 then rejected F80 arrays with "element
' width unsupported: 10".
'
' Returns 1 and fills the three outputs for a builtin scalar name, 0 otherwise
' (user TYPE/CLASS layouts come from the layout module, which builds on this).
Function UXBTypeAbi(ByRef rawTypeName As String, ByRef payloadOut As Integer, ByRef alignOut As Integer, ByRef strideOut As Integer) As Integer
    Dim t As String
    t = UCase(Trim(rawTypeName))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)

    Select Case t
    Case "I8", "U8", "BYTE", "UBYTE", "SBYTE", "BOOLEAN", "BOOL"
        payloadOut = 1: alignOut = 1
    Case "I16", "U16", "SHORT", "USHORT"
        payloadOut = 2: alignOut = 2
    Case "I32", "U32", "F32", "SINGLE", "INTEGER", "LONG", "ULONG", "UINTEGER", "UINT", "INT"
        payloadOut = 4: alignOut = 4
    Case "I64", "U64", "F64", "DOUBLE", "LONGINT", "ULONGINT"
        payloadOut = 8: alignOut = 8
    Case "F80", "EXTENDED", "EXT"
        payloadOut = 10: alignOut = 16
    Case "F128", "FLOAT128", "QUAD"
        payloadOut = 16: alignOut = 16
    Case "BIGF", "BIGFLOAT", "BIGD", "BIGDECIMAL", "BALL", "BIGI", "BIGINT", "BIGINTEGER"
        ' A handle in a variable/field; an array element cell is 16 bytes.
        payloadOut = 8: alignOut = 8
        strideOut = 16
        Return 1
    Case "STRING", "ARRAY", "LIST", "DICT", "SET", "REF", "POINTER", "PTR", "STRPTR", "WSTRPTR", "HANDLE", "OBJECT", "ANY", "VARIANT", "FILE_HANDLE", "DLL_HANDLE", "TASK", "TASKGROUP", "MUTEX"
        payloadOut = 8: alignOut = 8
    Case Else
        Return 0
    End Select

    ' stride = payload rounded up to the alignment
    strideOut = ((payloadOut + alignOut - 1) \ alignOut) * alignOut
    Return 1
End Function

#endif
