    Case "WHILE": Return "CONTROL_FLOW"
    Case "XOR": Return "OPERATOR"
    Case "[": Return "OPERATOR"
    Case "\": Return "OPERATOR"
    Case "\=": Return "OPERATOR"
    Case "]": Return "OPERATOR"
    Case "^": Return "OPERATOR"
    Case "^=": Return "OPERATOR"
    Case "|": Return "OPERATOR"
    Case "|=": Return "OPERATOR"
    Case "!": Return "OPERATOR"
    Case "!=": Return "OPERATOR"
    Case "&&": Return "OPERATOR"
    Case "**": Return "OPERATOR"
    Case "**=": Return "OPERATOR"
    Case "==": Return "OPERATOR"
    Case "?": Return "IO"
    Case "~": Return "OPERATOR"
    Case "||": Return "OPERATOR"
    Case "|>": Return "OPERATOR"
    Case "TRUE": Return "BUILTIN"
    Case "FALSE": Return "BUILTIN"
    Case "ZERO": Return "BUILTIN"
    Case "ONE": Return "BUILTIN"
    Case "NAND": Return "OPERATOR"
    Case "NOR": Return "OPERATOR"
    Case "XNOR": Return "OPERATOR"
    Case "NXOR": Return "OPERATOR"
    Case "EQV": Return "OPERATOR"
    Case "EQA": Return "OPERATOR"
    Case "IFF": Return "OPERATOR"
    Case "IMP": Return "OPERATOR"
    Case "CIMP": Return "OPERATOR"
    Case "NIMP": Return "OPERATOR"
    Case "NCIMP": Return "OPERATOR"
    Case "IDA": Return "OPERATOR"
    Case "IDB": Return "OPERATOR"
    Case "NOTA": Return "OPERATOR"
    Case "NOTB": Return "OPERATOR"
    Case "ENUM": Return "DECLARATION"
    Case "WEND": Return "CONTROL_FLOW"
    End Select
    Return "UNKNOWN_SURFACE"
End Function

Function UXBSurfaceKind(ByRef surfaceText As String) As String
    Select Case UXBSurfaceNormalize(surfaceText)
    Case "%": Return "EXPRESSION_OPERATOR"
    Case "%=": Return "EXPRESSION_OPERATOR"
    Case "&": Return "EXPRESSION_OPERATOR"
    Case "&=": Return "EXPRESSION_OPERATOR"
    Case "(": Return "EXPRESSION_OPERATOR"
    Case ")": Return "EXPRESSION_OPERATOR"
    Case "*": Return "EXPRESSION_OPERATOR"
    Case "*=": Return "EXPRESSION_OPERATOR"
    Case "+": Return "EXPRESSION_OPERATOR"
