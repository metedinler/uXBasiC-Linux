    Case ".BI": Return "FILE_EXTENSION"
    Case ".H": Return "FILE_EXTENSION"
    Case ".HX": Return "FILE_EXTENSION"
    Case ".JS": Return "FILE_EXTENSION"
    Case ".JSON": Return "FILE_EXTENSION"
