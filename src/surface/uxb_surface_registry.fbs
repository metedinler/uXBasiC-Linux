Function UXBSurfaceGroup(ByRef surfaceText As String) As String
    Select Case UXBSurfaceNormalize(surfaceText)
    Case "%": Return "OPERATOR"
    Case "%=": Return "OPERATOR"
    Case "&": Return "OPERATOR"
    Case "&=": Return "OPERATOR"
    Case "(": Return "OPERATOR"
    Case ")": Return "OPERATOR"
    Case "*": Return "OPERATOR"
    Case "*=": Return "OPERATOR"
    Case "+": Return "OPERATOR"
    Case "++": Return "OPERATOR"
    Case "+=": Return "OPERATOR"
    Case ",": Return "OPERATOR"
    Case "-": Return "OPERATOR"
    Case "--": Return "OPERATOR"
    Case "-=": Return "OPERATOR"
    Case ".": Return "OPERATOR"
    Case ".AST.JSON": Return "FILE_TYPE"
    Case ".BAS": Return "FILE_TYPE"
    Case ".BI": Return "FILE_TYPE"
    Case ".H": Return "FILE_TYPE"
    Case ".HX": Return "FILE_TYPE"
    Case ".JS": Return "FILE_TYPE"
    Case ".JSON": Return "FILE_TYPE"
    Case ".MIR.JSON": Return "FILE_TYPE"
    Case ".UXB": Return "FILE_TYPE"
    Case ".UXBASIC": Return "FILE_TYPE"
    Case ".UXM": Return "FILE_TYPE"
    Case ".UXMH": Return "FILE_TYPE"
    Case ".WASM": Return "FILE_TYPE"
    Case ".WAT": Return "FILE_TYPE"
    Case "/": Return "OPERATOR"
    Case "/=": Return "OPERATOR"
    Case ":": Return "OPERATOR"
    Case "<": Return "OPERATOR"
    Case "<<": Return "OPERATOR"
    Case "<<=": Return "OPERATOR"
    Case "<=": Return "OPERATOR"
    Case "<>": Return "OPERATOR"
    Case "=": Return "OPERATOR"
    Case ">": Return "OPERATOR"
    Case ">=": Return "OPERATOR"
    Case ">>": Return "OPERATOR"
    Case ">>=": Return "OPERATOR"
    Case "@": Return "OPERATOR"
    Case "ABS": Return "BUILTIN"
    Case "ABI": Return "COMPILE_TIME"
    Case "ABSTRACT": Return "COMPILE_TIME"
    Case "ALIGN": Return "COMPILE_TIME"
    Case "ALIAS": Return "COMPILE_TIME"
    Case "AND": Return "OPERATOR"
    Case "ARCHIVE": Return "LIBRARY"
    Case "ARRAY": Return "COLLECTION"
    Case "AS": Return "DECLARATION"
    Case "ASC": Return "BUILTIN"
    Case "ASSERT": Return "DIAGNOSTIC_FLOW"
    Case "ATN": Return "BUILTIN"
    Case "AUDIO": Return "LIBRARY"
    Case "BALL": Return "TYPE"
    Case "BIGD": Return "TYPE"
    Case "BIGF": Return "TYPE"
