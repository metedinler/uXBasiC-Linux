#ifndef UXB_SURFACE_REGISTRY_FBS
#define UXB_SURFACE_REGISTRY_FBS

' Canonical lexer/parser surface registry. Code-only closure layer.
' It does not replace parser/semantic/MIR/backend implementations; it gives every recognized surface a non-empty routing decision.

Function UXBSurfaceNormalize(ByRef textIn As String) As String
    Return UCase(Trim(textIn))
End Function

Function UXBSurfaceKnown(ByRef surfaceText As String) As Integer
