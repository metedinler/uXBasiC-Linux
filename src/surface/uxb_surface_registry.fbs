Function UXBSurfaceIsKnownNoEmit(ByRef surfaceText As String) As Integer
    Dim s As String = UXBSurfaceNormalize(surfaceText)
    Dim g As String = UXBSurfaceGroup(s)
    If g = "FILE_TYPE" Then Return 1
    If g = "COMPILE_TIME" Then Return 1
    If g = "MODULE" Then Return 1
    Select Case s
    Case "AS", "THEN", "TO", "STEP", "IN", "IS", "ELSE", "CASE", "NEXT", "END", "WHILE", "(", ")", "[", "]", ",", ":", "."
        Return 1
    End Select
    Return 0
End Function

