    Case "STRINGX": Return "RT_STRINGX_CALL"
    Case "TAN": Return "RT_MATH_TAN"
    Case "TIMER": Return "RT_TIMER"
    Case "UCASE": Return "RT_STR_TO_UPPER"
    Case "VAL": Return "RT_STR_VAL"
    Case "WEBGPU": Return "RT_WEBGPU_CALL"
    End Select
    Return ""
End Function

Function UXBSurfaceX64EmitKind(ByRef surfaceText As String) As String
    Dim s As String = UXBSurfaceNormalize(surfaceText)
    If UXBSurfaceKnown(s) = 0 Then Return "MISSING"
    If UXBSurfaceIsKnownNoEmit(s) <> 0 Then Return "NO_EMIT"
    Dim st As String = UXBSurfaceLayerStatus(s, "X64_MIR")
    If st = "NATIVE_ONLY" Then Return "NATIVE"
    If st = "RUNTIME_CALL" Then Return "RUNTIME_CALL"
    If st = "BROWSER_ONLY" Then Return "HOST_CALL"
    Dim svc As String = UXBSurfaceRuntimeService(s)
    If svc <> "" Then Return "RUNTIME_CALL"
    Dim g As String = UXBSurfaceGroup(s)
    If g = "LIBRARY" Then Return "HOST_CALL"
    If g = "BUILTIN" Then Return "RUNTIME_CALL"
    If g = "IO" Then Return "RUNTIME_CALL"
    Return "NATIVE_EMIT"
End Function

Function UXBSurfaceLayerJson(ByRef surfaceText As String) As String
    Dim s As String = UXBSurfaceNormalize(surfaceText)
    Return "{" & _
        Chr(34) & "surface" & Chr(34) & ":" & Chr(34) & s & Chr(34) & "," & _
        Chr(34) & "semantic" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "SEMANTIC") & Chr(34) & "," & _
        Chr(34) & "type_binding" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "TYPE_BINDING") & Chr(34) & "," & _
        Chr(34) & "layout" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "LAYOUT") & Chr(34) & "," & _
        Chr(34) & "mir" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "MIR") & Chr(34) & "," & _
        Chr(34) & "x64" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "X64_MIR") & Chr(34) & "," & _
        Chr(34) & "js" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "JS_TRANSPILER") & Chr(34) & "," & _
        Chr(34) & "wasm" & Chr(34) & ":" & Chr(34) & UXBSurfaceLayerStatus(s, "WASM_WAT") & Chr(34) & "," & _
        Chr(34) & "mir_opcode" & Chr(34) & ":" & Chr(34) & UXBSurfaceMirOpcode(s) & Chr(34) & "}"
End Function

Function UXBSurfaceKnownCount() As Integer
    Return 268
End Function

#endif

