#ifndef UXB_SURFACE_LAYER_BRIDGE_FBS
#define UXB_SURFACE_LAYER_BRIDGE_FBS

' UXBSurfaceLayerStatus is defined further down in this same file but two call sites
' inside uxb_surface_registry.fbs (included right below) need it earlier -- forward
' declare (found 2026-09-06, blocking a from-scratch build).
Declare Function UXBSurfaceLayerStatus(ByRef surfaceText As String, ByRef layerName As String) As String

#include once "uxb_surface_registry.fbs"

Private Function UXBSurfaceIsLayerRuntime(ByRef layerName As String) As Integer
    Dim l As String = UXBSurfaceNormalize(layerName)
    Select Case l
    Case "MIR", "MIR_VERIFY", "MIR_JSON", "AST_INTERPRETER", "MIR_INTERPRETER", "X64_MIR", "JS_TRANSPILER", "WASM_WAT", "BROWSER_RUNTIME", "LIBRARY_BINDING"
        Return 1
    End Select
    Return 0
End Function

Function UXBSurfaceLayerStatus(ByRef surfaceText As String, ByRef layerName As String) As String
    Dim s As String = UXBSurfaceNormalize(surfaceText)
    Dim g As String = UXBSurfaceGroup(s)
    Dim l As String = UXBSurfaceNormalize(layerName)
    If UXBSurfaceKnown(s) = 0 Then Return "MISSING"
    If l = "LEXER" Or l = "PARSER" Or l = "AST_CONTRACT" Then Return "IMPLEMENTED"
    If g = "FILE_TYPE" Then
        If l = "LAYOUT" Or l = "LIBRARY_BINDING" Then Return "NOT_APPLICABLE"
        Return "COMPILE_TIME_ONLY"
    End If
    If g = "COMPILE_TIME" Or g = "MODULE" Then
        If l = "LAYOUT" Then Return "NOT_APPLICABLE"
        Return "COMPILE_TIME_ONLY"
    End If
    If UXBSurfaceIsKnownNoEmit(s) <> 0 Then
        If l = "LAYOUT" Then Return "NOT_APPLICABLE"
        Return "COMPILE_TIME_ONLY"
    End If
    If g = "TYPE" Or g = "COLLECTION" Then
        Select Case l
        Case "SEMANTIC", "TYPE_BINDING", "LAYOUT", "HIR", "MIR", "MIR_VERIFY", "MIR_JSON"
            Return "IMPLEMENTED"
        Case "AST_INTERPRETER", "MIR_INTERPRETER", "X64_MIR", "JS_TRANSPILER", "WASM_WAT"
            Return "COMPILE_TIME_ONLY"
        End Select
        Return "NOT_APPLICABLE"
    End If
    If g = "LIBRARY" Then
        If l = "LAYOUT" Then Return "NOT_APPLICABLE"
        If l = "SEMANTIC" Or l = "TYPE_BINDING" Or l = "TESTS" Or l = "DOCS" Then Return "IMPLEMENTED"
        If s = "BROWSER" Or s = "CANVAS" Or s = "WEBGPU" Then
            If l = "WASM_WAT" Then Return "BROWSER_ONLY"
            If l = "BROWSER_RUNTIME" Or l = "JS_TRANSPILER" Then Return "RUNTIME_CALL"
        End If
        Return "RUNTIME_CALL"
    End If
    If s = "INLINE" Then
        If l = "JS_TRANSPILER" Or l = "WASM_WAT" Or l = "BROWSER_RUNTIME" Then Return "NATIVE_ONLY"
        If l = "LAYOUT" Then Return "NOT_APPLICABLE"
        Return "NATIVE_ONLY"
    End If
    If g = "IO" Or g = "DIAGNOSTIC_FLOW" Then
        If l = "LAYOUT" Then Return "NOT_APPLICABLE"
        If UXBSurfaceIsLayerRuntime(l) <> 0 Then Return "RUNTIME_CALL"
        Return "IMPLEMENTED"
    End If
    If g = "MEMORY" Then
        If l = "LAYOUT" Then
            Select Case s
            Case "SIZEOF", "OFFSETOF", "VARPTR", "SADD", "CODEPTR", "LPTR"
                Return "IMPLEMENTED"
            End Select
            Return "NOT_APPLICABLE"
        End If
        If l = "WASM_WAT" Then Return "RUNTIME_CALL"
        Return "IMPLEMENTED"
    End If
    If g = "BUILTIN" Then
        If l = "LAYOUT" Then Return "NOT_APPLICABLE"
        Select Case s
        Case "EVENT", "PIPE", "SLOT", "THREAD", "THREAD", "TRIGGER", "PARALEL", "PARALEL", "ON", "OFF", "DECORATOR", "MAGIC", "MIXIN", "OVERRIDE", "VIRTUAL", "MAGIC"
            If UXBSurfaceIsLayerRuntime(l) <> 0 Then Return "RUNTIME_CALL"
        End Select
        If l = "WASM_WAT" Then Return "RUNTIME_CALL"
        Return "IMPLEMENTED"
    End If
    If l = "LAYOUT" Then Return "NOT_APPLICABLE"
    Return "IMPLEMENTED"
End Function

Function UXBSurfaceFinalDecision(ByRef surfaceText As String) As String
    If UXBSurfaceKnown(surfaceText) = 0 Then Return "MISSING"
    If UXBSurfaceIsKnownNoEmit(surfaceText) <> 0 Then Return "COMPILE_TIME_ONLY"
    Dim g As String = UXBSurfaceGroup(surfaceText)
    If g = "LIBRARY" Then Return "RUNTIME_CALL"
    Return "IMPLEMENTED"
End Function

Function UXBSurfaceMirOpcode(ByRef surfaceText As String) As String
    Select Case UXBSurfaceNormalize(surfaceText)
    Case "%": Return "MIR_MOD"
    Case "%=": Return "MIR_MOD_ASSIGN"
    Case "&": Return "MIR_AND"
    Case "&=": Return "MIR_AND_ASSIGN"
    Case "(": Return "MIR_METADATA_ONLY"
    Case ")": Return "MIR_METADATA_ONLY"
    Case "*": Return "MIR_MUL"
    Case "*=": Return "MIR_MUL_ASSIGN"
    Case "+": Return "MIR_ADD"
    Case "++": Return "MIR_INC"
    Case "+=": Return "MIR_ADD_ASSIGN"
    Case ",": Return "MIR_METADATA_ONLY"
    Case "-": Return "MIR_SUB"
    Case "--": Return "MIR_DEC"
    Case "-=": Return "MIR_SUB_ASSIGN"
    Case ".": Return "MIR_METADATA_ONLY"
    Case ".AST.JSON": Return "MIR_METADATA_ONLY"
    Case ".BAS": Return "MIR_METADATA_ONLY"
    Case ".BI": Return "MIR_METADATA_ONLY"
    Case ".H": Return "MIR_METADATA_ONLY"
    Case ".HX": Return "MIR_METADATA_ONLY"
    Case ".JS": Return "MIR_METADATA_ONLY"
    Case ".JSON": Return "MIR_METADATA_ONLY"
    Case ".MIR.JSON": Return "MIR_METADATA_ONLY"
    Case ".UXB": Return "MIR_METADATA_ONLY"
    Case ".UXBASIC": Return "MIR_METADATA_ONLY"
    Case ".UXM": Return "MIR_METADATA_ONLY"
    Case ".UXMH": Return "MIR_METADATA_ONLY"
    Case ".WASM": Return "MIR_METADATA_ONLY"
    Case ".WAT": Return "MIR_METADATA_ONLY"
    Case "/": Return "MIR_DIV"
    Case "/=": Return "MIR_DIV_ASSIGN"
    Case ":": Return "MIR_METADATA_ONLY"
    Case "<": Return "MIR_LT"
    Case "<<": Return "MIR_SHL"
    Case "<<=": Return "MIR_SHL_ASSIGN"
    Case "<=": Return "MIR_LE"
    Case "<>": Return "MIR_NE"
    Case "=": Return "MIR_EQ"
    Case ">": Return "MIR_GT"
    Case ">=": Return "MIR_GE"
    Case ">>": Return "MIR_SHR"
    Case ">>=": Return "MIR_SHR_ASSIGN"
    Case "@": Return "MIR_ADDR_OF"
    Case "ABS": Return "MIR_ABS"
    Case "ABI": Return "MIR_METADATA_ONLY"
    Case "ALIGN": Return "MIR_METADATA_ONLY"
    Case "PACK": Return "MIR_METADATA_ONLY"
    Case "ABSTRACT": Return "MIR_METADATA_ONLY"
    Case "ALIAS": Return "MIR_METADATA_ONLY"
    Case "AND": Return "MIR_AND"
