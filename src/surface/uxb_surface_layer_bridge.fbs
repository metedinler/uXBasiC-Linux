    Case "NOTA": Return "MIR_NOTA"
    Case "NOTB": Return "MIR_NOTB"
    Case "ENUM": Return "MIR_TYPE_DECL"
    Case "WEND": Return "MIR_LOOP_END"
    End Select
    Return ""
End Function

