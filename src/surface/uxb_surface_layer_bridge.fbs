    Case "BIGF": Return "MIR_TYPE_DECL"
    Case "BOOLEAN": Return "MIR_TYPE_DECL"
    Case "BROWSER": Return "MIR_LIBRARY_CALL"
    Case "BYREF": Return "MIR_METADATA_ONLY"
    Case "BYTE": Return "MIR_TYPE_DECL"
    Case "BYVAL": Return "MIR_METADATA_ONLY"
    Case "CALL": Return "MIR_CALL"
