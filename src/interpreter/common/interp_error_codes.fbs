#ifndef UXB_INTERP_ERROR_CODES_FBS
#define UXB_INTERP_ERROR_CODES_FBS

Const UXB_INTERP_OK As Integer = 0
Const UXB_INTERP_ERR_AST_CONTRACT As Integer = 5101
Const UXB_INTERP_ERR_SEMANTIC_REQUIRED As Integer = 5102
Const UXB_INTERP_ERR_NODE_NOT_EXECUTABLE As Integer = 5103
Const UXB_INTERP_ERR_NATIVE_ONLY As Integer = 5104
Const UXB_INTERP_ERR_WASM_UNSUPPORTED As Integer = 5105
Const UXB_INTERP_ERR_RESERVED_NODE As Integer = 5106
Const UXB_INTERP_ERR_DIAGNOSTIC_ONLY As Integer = 5107
Const UXB_INTERP_ERR_SYMBOL_NOT_FOUND As Integer = 5108
Const UXB_INTERP_ERR_TYPE_MISMATCH As Integer = 5109
Const UXB_INTERP_ERR_DIV_ZERO As Integer = 5110
Const UXB_INTERP_ERR_RUNTIME_SERVICE As Integer = 5111
Const UXB_INTERP_ERR_MIR_VERIFY_REQUIRED As Integer = 5112
Const UXB_INTERP_ERR_MIR_OPCODE As Integer = 5113
Const UXB_INTERP_ERR_MIR_TYPE_LEAK As Integer = 5114
Const UXB_INTERP_ERR_LIMIT As Integer = 5115
Const UXB_INTERP_ERR_IO As Integer = 5116
Const UXB_INTERP_ERR_BAD_ARGUMENT As Integer = 5117
' S-156: HATA DEGIL -- rutin icindeki END programi bitirir; ic ice cagrilari cozmek icin hata yolunu
' kullanan sinyal. En ustteki calistirma dongusu bunu basarili bitis sayar.
Const UXB_INTERP_SIGNAL_PROGRAM_END As Integer = 5199
' S-146 Model D: SELF_DEADLOCK / LOCK_DEADLOCK -- programi durduran kilit hatasi. Gorev hatasi
' olarak gorevde tutulmaz ve TRY ile yakalanmaz (native'de de surec acik taniyla biter).
Const UXB_INTERP_ERR_LOCK_FATAL As Integer = 5198

Function UXBInterpErrorName(ByVal codeValue As Integer) As String
    Select Case codeValue
    Case UXB_INTERP_OK: Return "OK"
    Case UXB_INTERP_ERR_AST_CONTRACT: Return "AST_CONTRACT_ERROR"
    Case UXB_INTERP_ERR_SEMANTIC_REQUIRED: Return "SEMANTIC_REQUIRED"
    Case UXB_INTERP_ERR_NODE_NOT_EXECUTABLE: Return "NODE_NOT_EXECUTABLE"
    Case UXB_INTERP_ERR_NATIVE_ONLY: Return "NATIVE_ONLY"
    Case UXB_INTERP_ERR_WASM_UNSUPPORTED: Return "WASM_UNSUPPORTED"
    Case UXB_INTERP_ERR_RESERVED_NODE: Return "RESERVED_NODE"
    Case UXB_INTERP_ERR_DIAGNOSTIC_ONLY: Return "DIAGNOSTIC_ONLY"
    Case UXB_INTERP_ERR_SYMBOL_NOT_FOUND: Return "SYMBOL_NOT_FOUND"
    Case UXB_INTERP_ERR_TYPE_MISMATCH: Return "TYPE_MISMATCH"
    Case UXB_INTERP_ERR_DIV_ZERO: Return "DIVIDE_BY_ZERO"
    Case UXB_INTERP_ERR_RUNTIME_SERVICE: Return "RUNTIME_SERVICE_ERROR"
    Case UXB_INTERP_ERR_MIR_VERIFY_REQUIRED: Return "MIR_VERIFY_REQUIRED"
    Case UXB_INTERP_ERR_MIR_OPCODE: Return "MIR_OPCODE_ERROR"
    Case UXB_INTERP_ERR_MIR_TYPE_LEAK: Return "MIR_TYPE_LEAK"
    Case UXB_INTERP_ERR_LIMIT: Return "EXECUTION_LIMIT"
    Case UXB_INTERP_ERR_IO: Return "IO_ERROR"
    Case UXB_INTERP_ERR_BAD_ARGUMENT: Return "BAD_ARGUMENT"
    End Select
    Return "INTERPRETER_ERROR"
End Function

#endif
