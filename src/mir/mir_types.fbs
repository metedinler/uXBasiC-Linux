#ifndef UXB_MIR_TYPES_FBS
#define UXB_MIR_TYPES_FBS

#include once "../common/string_memo.fbs"

Const UXB_MIR_TYPE_VOID As String = "TYPE_VOID"
Const UXB_MIR_TYPE_BOOL As String = "TYPE_BOOL"
Const UXB_MIR_TYPE_BOOLEAN As String = "TYPE_BOOL"
Const UXB_MIR_TYPE_I8 As String = "TYPE_I8"
Const UXB_MIR_TYPE_U8 As String = "TYPE_U8"
Const UXB_MIR_TYPE_I16 As String = "TYPE_I16"
Const UXB_MIR_TYPE_U16 As String = "TYPE_U16"
Const UXB_MIR_TYPE_I32 As String = "TYPE_I32"
Const UXB_MIR_TYPE_U32 As String = "TYPE_U32"
Const UXB_MIR_TYPE_I64 As String = "TYPE_I64"
Const UXB_MIR_TYPE_U64 As String = "TYPE_U64"
Const UXB_MIR_TYPE_F32 As String = "TYPE_F32"
Const UXB_MIR_TYPE_F64 As String = "TYPE_F64"
Const UXB_MIR_TYPE_F80 As String = "TYPE_F80"
Const UXB_MIR_TYPE_F128 As String = "TYPE_F128"
Const UXB_MIR_TYPE_BIGINT As String = "TYPE_BIGINT"
Const UXB_MIR_TYPE_BIGF As String = "TYPE_BIGF"
Const UXB_MIR_TYPE_BIGD As String = "TYPE_BIGD"
Const UXB_MIR_TYPE_BALL As String = "TYPE_BALL"
Const UXB_MIR_TYPE_ANY As String = "TYPE_ANY"
Const UXB_MIR_TYPE_VARIANT As String = "TYPE_VARIANT"
Const UXB_MIR_TYPE_STRING As String = "TYPE_STRING"
Const UXB_MIR_TYPE_WSTRING As String = "TYPE_WSTRING"
Const UXB_MIR_TYPE_PTR As String = "TYPE_PTR"
Const UXB_MIR_TYPE_ARRAY As String = "TYPE_ARRAY"
Const UXB_MIR_TYPE_OBJECT As String = "TYPE_OBJECT"
Const UXB_MIR_TYPE_HANDLE As String = "TYPE_HANDLE"
Const UXB_MIR_TYPE_RUNTIME As String = "TYPE_RUNTIME"
Const UXB_MIR_TYPE_INFERRED As String = "TYPE_INFERRED"
Const UXB_MIR_TYPE_INFERRED_NUMERIC As String = "TYPE_INFERRED_NUMERIC"
Const UXB_MIR_TYPE_ERROR As String = "TYPE_ERROR"
Const UXB_MIR_TYPE_UNKNOWN As String = "TYPE_UNKNOWN"
Const UXB_MIR_LAYOUT_MISSING As String = "LAYOUT_MISSING"

Dim Shared gUxbMemoCanonType As UXBStringMemo

Declare Function UXBMIRStep4CanonicalTypeNameUncached(ByRef typeText As String) As String

' Pure function of the text; memoized (see string_memo.fbs).
Function UXBMIRStep4CanonicalTypeName(ByRef typeText As String) As String
    Dim cached As String
    If UXBStringMemoGet(gUxbMemoCanonType, typeText, cached) <> 0 Then Return cached
    Dim result As String = UXBMIRStep4CanonicalTypeNameUncached(typeText)
    UXBStringMemoPut gUxbMemoCanonType, typeText, result
    Return result
End Function

Function UXBMIRStep4CanonicalTypeNameUncached(ByRef typeText As String) As String
    Dim t As String
    t = UCase(Trim(typeText))
    If t = "" Then Return UXB_MIR_TYPE_VOID
    If Len(t) > 2 AndAlso Right(t, 2) = "[]" Then Return UXB_MIR_TYPE_ARRAY
    Select Case t
    Case "VOID", "TYPE_VOID": Return UXB_MIR_TYPE_VOID
    Case "BOOL", "BOOLEAN", "TYPE_BOOL", "TYPE_BOOLEAN": Return UXB_MIR_TYPE_BOOL
    Case "I8", "TYPE_I8": Return UXB_MIR_TYPE_I8
    Case "U8", "TYPE_U8": Return UXB_MIR_TYPE_U8
    Case "I16", "TYPE_I16": Return UXB_MIR_TYPE_I16
    Case "U16", "TYPE_U16": Return UXB_MIR_TYPE_U16
    Case "I32", "INTEGER", "INT", "TYPE_I32": Return UXB_MIR_TYPE_I32
    Case "U32", "UINT", "TYPE_U32": Return UXB_MIR_TYPE_U32
    Case "I64", "LONGINT", "TYPE_I64": Return UXB_MIR_TYPE_I64
    Case "U64", "ULONGINT", "TYPE_U64": Return UXB_MIR_TYPE_U64
    Case "F32", "SINGLE", "TYPE_F32": Return UXB_MIR_TYPE_F32
    Case "F64", "DOUBLE", "TYPE_F64": Return UXB_MIR_TYPE_F64
    Case "F80", "TYPE_F80": Return UXB_MIR_TYPE_F80
    Case "F128", "TYPE_F128": Return UXB_MIR_TYPE_F128
    Case "BIGI", "BIGINT", "TYPE_BIGI", "TYPE_BIGINT": Return UXB_MIR_TYPE_BIGINT
    Case "BIGF", "BIGFLOAT", "TYPE_BIGF", "TYPE_BIGFLOAT": Return UXB_MIR_TYPE_BIGF
    Case "BIGD", "BIGDECIMAL", "TYPE_BIGD": Return UXB_MIR_TYPE_BIGD
    Case "BALL", "TYPE_BALL": Return UXB_MIR_TYPE_BALL
    Case "ANY", "ANYREF", "TYPE_ANY": Return UXB_MIR_TYPE_ANY
    Case "VARIANT", "VAR", "TYPE_VARIANT": Return UXB_MIR_TYPE_VARIANT
    Case "STRING", "STRPTR", "TYPE_STRING", "TYPE_STRPTR": Return UXB_MIR_TYPE_STRING
    Case "WSTRING", "WSTRPTR", "TYPE_WSTRING", "TYPE_WSTRPTR": Return UXB_MIR_TYPE_WSTRING
    Case "PTR", "POINTER", "TYPE_PTR": Return UXB_MIR_TYPE_PTR
    Case "ARRAY", "TYPE_ARRAY": Return UXB_MIR_TYPE_ARRAY
    Case "OBJECT", "TYPE_OBJECT", "CLASS", "TYPE_CLASS", "INTERFACE", "TYPE_INTERFACE": Return UXB_MIR_TYPE_OBJECT
    Case "HANDLE", "FILE_HANDLE", "DLL_HANDLE", "JS_HANDLE", "WASM_HANDLE", "TYPE_HANDLE": Return UXB_MIR_TYPE_HANDLE
    Case "RUNTIME", "TYPE_RUNTIME": Return UXB_MIR_TYPE_RUNTIME
    Case "TYPE_INFERRED": Return UXB_MIR_TYPE_INFERRED
    Case "TYPE_INFERRED_NUMERIC": Return UXB_MIR_TYPE_INFERRED_NUMERIC
    Case UXB_MIR_TYPE_UNKNOWN, UXB_MIR_TYPE_ERROR, UXB_MIR_LAYOUT_MISSING: Return t
    End Select
    Return t
End Function

Function UXBMIRStep4TypeIsBlocked(ByRef typeText As String) As Integer
    Dim t As String
    t = UXBMIRStep4CanonicalTypeName(typeText)
    If t = UXB_MIR_TYPE_UNKNOWN Then Return 1
    If t = UXB_MIR_TYPE_ERROR Then Return 1
    If t = UXB_MIR_LAYOUT_MISSING Then Return 1
    Return 0
End Function

Private Function UXBMIRStep4TypeIsExtensionName(ByRef typeText As String) As Integer
    Dim t As String
    t = UXBMIRStep4CanonicalTypeName(typeText)
    If t = "" Then Return 0
    If Left(t, 5) = "TYPE_" Then Return 0

    Dim i As Integer
    For i = 1 To Len(t)
        Dim ch As String
        ch = Mid(t, i, 1)
        ' S-579: a UTF-8 Turkish letter of a type name (bytes >= 128) is part of the name
        If Asc(ch) >= 128 Then Continue For
        If (ch < "A" Or ch > "Z") And (ch < "0" Or ch > "9") And ch <> "_" And ch <> "." Then Return 0
        If i = 1 And ch >= "0" And ch <= "9" Then Return 0
    Next i
    Return 1
End Function

Function UXBMIRStep4TypeIsKnown(ByRef typeText As String) As Integer
    Dim t As String
    t = UXBMIRStep4CanonicalTypeName(typeText)
    If UXBMIRStep4TypeIsBlocked(t) <> 0 Then Return 0
    Select Case t
    Case UXB_MIR_TYPE_VOID, UXB_MIR_TYPE_BOOL, UXB_MIR_TYPE_I8, UXB_MIR_TYPE_U8, UXB_MIR_TYPE_I16, UXB_MIR_TYPE_U16
        Return 1
    Case UXB_MIR_TYPE_I32, UXB_MIR_TYPE_U32, UXB_MIR_TYPE_I64, UXB_MIR_TYPE_U64, UXB_MIR_TYPE_F32, UXB_MIR_TYPE_F64
        Return 1
    Case UXB_MIR_TYPE_F80, UXB_MIR_TYPE_F128, UXB_MIR_TYPE_STRING, UXB_MIR_TYPE_WSTRING, UXB_MIR_TYPE_PTR
        Return 1
    Case UXB_MIR_TYPE_ARRAY, UXB_MIR_TYPE_OBJECT, UXB_MIR_TYPE_HANDLE, UXB_MIR_TYPE_RUNTIME
        Return 1
    Case UXB_MIR_TYPE_BIGINT, UXB_MIR_TYPE_BIGF, UXB_MIR_TYPE_BIGD, UXB_MIR_TYPE_BALL, UXB_MIR_TYPE_ANY, UXB_MIR_TYPE_VARIANT
        Return 1
    Case UXB_MIR_TYPE_INFERRED, UXB_MIR_TYPE_INFERRED_NUMERIC
        Return 1
    End Select
    If UXBMIRStep4TypeIsExtensionName(t) <> 0 Then Return 1
    Return 0
End Function

#endif
