#ifndef UXB_STEP4_MIR_VERIFY_CONTROL_FLOW_FBS
#define UXB_STEP4_MIR_VERIFY_CONTROL_FLOW_FBS
#include once "../../common/number_literal.fbs"

Private Function UXBMIRStep4TryParseInt(ByRef textValue As String, ByRef valueOut As Integer) As Integer
    Return UXBDecimalI32Literal(textValue, valueOut)
End Function

Private Function UXBMIRStep4FindBlockById(ByRef fn As MIRFunction, ByVal blockId As Integer) As Integer
    Dim bi As Integer
    For bi = 0 To fn.blockCount - 1
        If fn.blocks(bi).id = blockId Then Return bi
    Next bi
    Return -1
End Function

Function UXBMIRStep4VerifyControlFlow(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim fn As MIRFunction Ptr
        fn = @m.functions(fi)

        Dim bi As Integer
        For bi = 0 To fn->blockCount - 1
            Dim blk As MIRBasicBlock Ptr
            blk = @fn->blocks(bi)

            Dim ii As Integer
            For ii = 0 To blk->instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @blk->instructions(ii)

                Dim op As String
                op = UXBMIRStep4NormalizeOpcode(inst->opcode)

                Dim targetId As Integer
                If op = "MIR_JMP" Or op = "JMP" Then
                    If inst->operandCount < 1 Or UXBMIRStep4TryParseInt(inst->operands(0), targetId) = 0 Then
                        errText = "step4 verify cfg: bad jump target"
                        Return 0
                    End If
                    If UXBMIRStep4FindBlockById(*fn, targetId) = -1 Then
                        errText = "step4 verify cfg: jump target block not found"
                        Return 0
                    End If
                ElseIf op = "MIR_JMP_IF_TRUE" Or op = "MIR_JMP_IF_FALSE" Or op = "JZ" Or op = "JNZ" Then
                    If inst->operandCount < 2 Or UXBMIRStep4TryParseInt(inst->operands(1), targetId) = 0 Then
                        errText = "step4 verify cfg: bad conditional jump target"
                        Return 0
                    End If
                    If UXBMIRStep4FindBlockById(*fn, targetId) = -1 Then
                        errText = "step4 verify cfg: conditional target block not found"
                        Return 0
                    End If
                End If
            Next ii
        Next bi
    Next fi

    Return 1
End Function

#endif
