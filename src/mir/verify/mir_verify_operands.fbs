#ifndef UXB_STEP4_MIR_VERIFY_OPERANDS_FBS
#define UXB_STEP4_MIR_VERIFY_OPERANDS_FBS

Private Function UXBMIRStep4ExpectedOperandCount(ByRef opRaw As String) As Integer
    Dim op As String
    op = UXBMIRStep4NormalizeOpcode(opRaw)

    Select Case op
    Case "MIR_NOP", "MIR_MODULE_BEGIN", "MIR_MODULE_END", "MIR_NAMESPACE_BEGIN", "MIR_NAMESPACE_END", "MIR_FUNCTION_BEGIN", "MIR_FUNCTION_END", "MIR_SUB_BEGIN", "MIR_SUB_END", "MIR_SELECT_BEGIN", "MIR_SELECT_END", "MIR_LOOP_BEGIN", "MIR_LOOP_END", "MIR_CASE_ELSE", "MIR_BREAK", "MIR_CONTINUE", "MIR_CLS", "MIR_TRY_BEGIN", "MIR_CATCH_BEGIN", "MIR_FINALLY_BEGIN", "MIR_TRY_END"
        Return 0
    Case "MIR_NEG", "MIR_INC", "MIR_DEC", "MIR_NOT", "MIR_RETURN", "MIR_PRINT", "MIR_INPUT", "MIR_RANDOMIZE", "MIR_TIMER", "MIR_THROW", "MIR_ASSERT", "MIR_LOAD", "MIR_STORE", "MIR_LOAD_CONST", "MIR_LOAD_LOCAL", "MIR_STORE_LOCAL", "MIR_LOAD_GLOBAL", "MIR_STORE_GLOBAL", "MIR_MEM_LOAD", "MIR_MEM_STORE", "MIR_MEMORY_LOAD", "MIR_MEMORY_STORE", "MIR_MEMORY_COPY", "MIR_MEMORY_FILL", "MIR_MEMORY_READ_SEQUENCE", "MIR_MEMORY_WRITE_SEQUENCE", "MIR_PEEK", "MIR_POKE", "MIR_FILE_OPEN", "MIR_FILE_CLOSE", "MIR_FILE_READ", "MIR_FILE_WRITE", "MIR_FILE_SEEK", "MIR_FILE_DELETE", "MIR_LABEL", "MIR_JMP", "MIR_CAST", "MIR_COERCE", "MIR_TYPEOF", "MIR_SIZEOF", "MIR_OFFSETOF"
        Return 1
    Case "MIR_VIRTUAL_INIT"
        Return 2
    Case "MIR_JMP_IF_TRUE", "MIR_JMP_IF_FALSE", "MIR_EQ", "MIR_NE", "MIR_LT", "MIR_LE", "MIR_GT", "MIR_GE", "MIR_AND", "MIR_OR", "MIR_XOR", "MIR_NAND", "MIR_NOR", "MIR_XNOR", "MIR_IMP", "MIR_CIMP", "MIR_NIMP", "MIR_NCIMP", "MIR_IDA", "MIR_IDB", "MIR_NOTA", "MIR_NOTB", "MIR_POW", "MIR_ADD", "MIR_SUB", "MIR_MUL", "MIR_DIV", "MIR_IDIV", "MIR_MOD", "MIR_SHL", "MIR_SHR", "MIR_USHR", "MIR_UIDIV", "MIR_UMOD", "MIR_ULT", "MIR_ULE", "MIR_UGT", "MIR_UGE", "MIR_ROL", "MIR_ROR", "MIR_FADD", "MIR_FSUB", "MIR_FMUL", "MIR_FDIV", "MIR_FNEG", "MIR_FCMP", "MIR_STR_ASSIGN", "MIR_STR_CONCAT", "MIR_STR_COMPARE", "MIR_ARRAY_LOAD", "MIR_ARRAY_STORE", "MIR_COLOR", "MIR_LOCATE", "MIR_CASE", "MIR_RUNTIME_CALL", "MIR_JS_CALL", "MIR_BROWSER_CALL", "MIR_WASM_IMPORT", "MIR_WASM_EXPORT", "MIR_HOST_CALL"
        Return 2
    Case "MIR_FIELD_LOAD":
        Return 3
    Case "MIR_DELETE_OBJECT":
        Return 1
    Case "MIR_ARRAY_SIZEOF":
        Return 3
    Case "MIR_ARRAY_LBOUND", "MIR_ARRAY_UBOUND":
        Return 2
    Case "MIR_MEMORY_REF":
        Return 4
    Case "MIR_FIELD_STORE":
        Return 4
    Case "MIR_UNION_FIELD_LOAD":
        Return 5
    Case "MIR_UNION_FIELD_STORE":
        Return 6
    Case "MIR_METHOD_CALL", "MIR_VIRTUAL_CALL":
        Return 4
    Case "MIR_OBJECT_NEW":
        Return 2
    End Select

    Return -1
End Function

Function UXBMIRStep4VerifyOperands(ByRef m As MIRModule, ByRef errText As String) As Integer
    errText = ""

    Dim fi As Integer
    For fi = 0 To m.functionCount - 1
        Dim bi As Integer
        For bi = 0 To m.functions(fi).blockCount - 1
            Dim ii As Integer
            For ii = 0 To m.functions(fi).blocks(bi).instructionCount - 1
                Dim inst As MIRIRInstruction Ptr
                inst = @m.functions(fi).blocks(bi).instructions(ii)

                Dim op As String
                op = UXBMIRStep4NormalizeOpcode(inst->opcode)

                Dim expected As Integer
                expected = UXBMIRStep4ExpectedOperandCount(op)
                If expected >= 0 Then
                    If inst->operandCount < expected Then
                        errText = "step4 verify operands: " & op & " expects at least " & LTrim(Str(expected)) & " operands"
                        Return 0
                    End If
                End If
            Next ii
        Next bi
    Next fi

    Return 1
End Function

#endif
