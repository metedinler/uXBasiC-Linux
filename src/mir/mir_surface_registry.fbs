#ifndef UXB_MIR_SURFACE_REGISTRY_FBS
#define UXB_MIR_SURFACE_REGISTRY_FBS

Const UXB_MIR_STEP4_SURFACE_COUNT As Integer = 268

Function UXBMIRStep4SurfaceKnown(ByRef surfaceText As String) As Integer
    Dim s As String
    s = UCase(Trim(surfaceText))
    Select Case s
    Case "%", "%=", "&", "&=", "("
        Return 1
    Case ")", "*", "*=", "+", "++"
        Return 1
    Case "+=", ",", "-", "--", "-="
        Return 1
    Case ".", ".AST.JSON", ".BAS", ".BI", ".H"
        Return 1
    Case ".HX", ".JS", ".JSON", ".MIR.JSON", ".UXB"
        Return 1
    Case ".UXBASIC", ".UXM", ".UXMH", ".WASM", ".WAT"
        Return 1
    Case "/", "/=", ":", "<", "<<"
        Return 1
    Case "<<=", "<=", "<>", "=", ">"
        Return 1
    Case ">=", ">>", ">>=", "@", "ABS"
        Return 1
    Case "ABSTRACT", "ALIAS", "AND", "ARCHIVE", "ARRAY"
        Return 1
    Case "AS", "ASC", "ASSERT", "ATN", "AUDIO"
        Return 1
    Case "BALL", "BIGD", "BIGF", "BOOLEAN", "BROWSER"
        Return 1
    Case "BYREF", "BYTE", "BYVAL", "CALL", "CANVAS"
        Return 1
    Case "CASE", "CATCH", "CDBL", "CDECL", "CHR"
        Return 1
    Case "CINT", "CLASS", "CLNG", "CLOSE", "CLS"
        Return 1
    Case "CODEPTR", "COLOR", "CONST", "CONSTRUCTOR", "COS"
        Return 1
    Case "CRYPTO", "CSNG", "CURL", "DEC", "DECLARE"
        Return 1
    Case "DECORATOR", "DEFBYT", "DEFDBL", "DEFEXT", "DEFINT"
        Return 1
    Case "DEFLNG", "DEFSNG", "DEFSTR", "DELETE", "DESTRUCTOR"
        Return 1
    Case "DICT", "DIM", "DO", "EACH", "ELSE"
        Return 1
    Case "ELSEIF", "END", "EOF", "EVENT", "EXIT", "CONTINUE"
        Return 1
    Case "EXP", "F128", "F32", "F64", "F80"
        Return 1
    Case "FINAL", "FINALLY", "FIX", "FOR", "FRIEND"
        Return 1
    Case "FUNCTION", "GET", "GETKEY", "GOSUB", "GOTO"
        Return 1
    Case "GRAPHICS", "HTTP", "I16", "I32", "I64"
        Return 1
    Case "I8", "IF", "IMAGE", "IMMUTABLE", "IMPLEMENTS"
        Return 1
    Case "IMPORT", "IN", "INC", "INCLUDE", "INKEY"
        Return 1
    Case "INLINE", "INPUT", "INT", "INTERFACE", "IS"
        Return 1
    Case "JSON", "LCASE", "LEN", "LIST", "LLAMA"
        Return 1
    Case "LOCATE", "LOF", "LOG", "LOOP", "LPTR"
        Return 1
    Case "LTRIM", "LUA", "MAGIC", "MAIN", "MATH"
        Return 1
    Case "MEMCOPYB", "MEMCOPYD", "MEMCOPYW", "MEMFILLB", "MEMFILLD"
        Return 1
    Case "MEMFILLW", "METHOD", "MID", "MIXIN", "MOD"
        Return 1
    Case "MODULE", "MUTABLE", "NAMESPACE", "NEW", "NEXT"
        Return 1
    Case "NOT", "OBJECT", "OFF", "OFFSETOF", "ON"
        Return 1
    Case "ONNX", "OPEN", "OPERATOR", "OR", "OS"
        Return 1
    Case "OVERRIDE", "PARALEL", "PARALEL", "PEEKB", "PEEKD"
        Return 1
    Case "PEEKW", "PIPE", "POKE", "POKEB", "POKED"
        Return 1
    Case "POKES", "POKEW", "PRINT", "PRIVATE", "PROLOG"
        Return 1
    Case "PROPERTY", "PROTECTED", "PTR", "PUBLIC", "PUT"
        Return 1
    Case "RANDOMIZE", "READONLY", "REDIM", "REGEX", "RESTRICTED"
        Return 1
    Case "RETURN", "RND", "ROL", "ROR", "RTRIM"
        Return 1
    Case "SADD", "SEALED", "SEEK", "SELECT", "SERVER"
        Return 1
    Case "SET", "SETNEWOFFSET", "SETSTRINGSIZE", "SGN", "SHL"
        Return 1
    Case "SHR", "MAGIC", "SIN", "SIZEOF", "SLOT"
        Return 1
    Case "SPACE", "SQLITE", "SQR", "SQRT", "STATIC"
        Return 1
    Case "STDCALL", "STEP", "STR", "STRING", "STRINGX"
        Return 1
    Case "STRPTR", "SUB", "TAN", "THEN", "THREAD"
        Return 1
    Case "THREAD", "THROW", "TIMER", "TO", "TRIGGER"
        Return 1
    Case "TRY", "TYPE", "U16", "U32", "U64"
        Return 1
    Case "U8", "UCASE", "UNTIL", "USING", "VAL"
        Return 1
    Case "VARPTR", "VIRTUAL", "WEBGPU", "WHILE", "XOR"
        Return 1
    Case "LBOUND", "UBOUND"
        Return 1
    Case "[", "\", "\=", "]", "^"
        Return 1
    Case "^=", "|", "|="
        Return 1
    End Select
    Return 0
End Function

#endif

