Dim As String extfpPolicyJsonOutPath
Dim As UXBOutputContractPaths outputContractPaths
Dim As String outputContractErr
Dim As UXBActiveBindPlan activeBindPlan

UxbInit

Dim As String cliErrText
Dim As Integer cliInitOk
cliInitOk = UXBCliInitFromCommandLine(cliErrText)

If UXBCliIsHelpRequested() <> 0 Then
    UXBCliPrintHelp
    End 0
End If
If UXBCliIsVersionRequested() <> 0 Then
    UXBCliPrintVersion
    End 0
End If

If cliInitOk = 0 Then
    UxbError cliErrText
    End 20
End If

