#ifndef UXB_TYPE_BUILTIN_REGISTRY_FBS
#define UXB_TYPE_BUILTIN_REGISTRY_FBS

#include once "type_rules.fbs"
#include once "../common/report_writer.fbs"

Type UXBBuiltinTypeRule
    name As String
    returnType As String
    argPolicy As String
    targetPolicy As String
End Type

Private Function UXBBuiltinTypeRuleMake(ByVal nameText As String, ByVal returnTypeText As String, ByVal argPolicyText As String, ByVal targetPolicyText As String) As UXBBuiltinTypeRule
    Dim r As UXBBuiltinTypeRule
    r.name = UCase(Trim(nameText))
    r.returnType = UXBStep3TypeCanonical(returnTypeText)
    r.argPolicy = Trim(argPolicyText)
    r.targetPolicy = Trim(targetPolicyText)
    Return r
End Function

Function UXBBuiltinTypeRuleCount() As Integer
    Return 82
End Function

Function UXBBuiltinTypeRuleAt(ByVal idx As Integer, ByRef r As UXBBuiltinTypeRule) As Integer
    Select Case idx
    Case 0: r = UXBBuiltinTypeRuleMake("LEN", TYPE_I32, "STRING:1", "ALL")
    Case 1: r = UXBBuiltinTypeRuleMake("VAL", TYPE_F64, "STRING:1", "ALL")
    Case 2: r = UXBBuiltinTypeRuleMake("VALINT", TYPE_I32, "STRING:1", "ALL")
    Case 3: r = UXBBuiltinTypeRuleMake("STR", TYPE_STRING, "ANY:1", "ALL")
    Case 4: r = UXBBuiltinTypeRuleMake("LEFT", TYPE_STRING, "STRING,INT", "ALL")
    Case 5: r = UXBBuiltinTypeRuleMake("RIGHT", TYPE_STRING, "STRING,INT", "ALL")
    Case 6: r = UXBBuiltinTypeRuleMake("MID", TYPE_STRING, "STRING,INT[,INT]", "ALL")
    Case 7: r = UXBBuiltinTypeRuleMake("INSTR", TYPE_I32, "STRING,STRING", "ALL")
    Case 8: r = UXBBuiltinTypeRuleMake("ASC", TYPE_I32, "STRING:1", "ALL")
    Case 9: r = UXBBuiltinTypeRuleMake("CHR", TYPE_STRING, "INT:1", "ALL")
    Case 10: r = UXBBuiltinTypeRuleMake("ABS", TYPE_F64, "NUMERIC:1", "ALL")
    Case 11: r = UXBBuiltinTypeRuleMake("SIN", TYPE_F64, "NUMERIC:1", "ALL")
    Case 12: r = UXBBuiltinTypeRuleMake("COS", TYPE_F64, "NUMERIC:1", "ALL")
    Case 13: r = UXBBuiltinTypeRuleMake("TAN", TYPE_F64, "NUMERIC:1", "ALL")
    Case 14: r = UXBBuiltinTypeRuleMake("ATN", TYPE_F64, "NUMERIC:1", "ALL")
    Case 15: r = UXBBuiltinTypeRuleMake("LOG", TYPE_F64, "NUMERIC:1", "ALL")
    Case 16: r = UXBBuiltinTypeRuleMake("EXP", TYPE_F64, "NUMERIC:1", "ALL")
    Case 17: r = UXBBuiltinTypeRuleMake("SQR", TYPE_F64, "NUMERIC:1", "ALL")
    Case 18: r = UXBBuiltinTypeRuleMake("SQRT", TYPE_F64, "NUMERIC:1", "ALL")
    Case 19: r = UXBBuiltinTypeRuleMake("RND", TYPE_F64, "OPTIONAL_SEED", "ALL")
    Case 20: r = UXBBuiltinTypeRuleMake("TIMER", TYPE_F64, "NOARGS", "ALL")
    Case 21: r = UXBBuiltinTypeRuleMake("SGN", TYPE_I32, "NUMERIC:1", "ALL")
    Case 22: r = UXBBuiltinTypeRuleMake("INT", TYPE_I32, "NUMERIC:1", "ALL")
    Case 23: r = UXBBuiltinTypeRuleMake("CINT", TYPE_I32, "ANY:1", "ALL")
    Case 24: r = UXBBuiltinTypeRuleMake("CLNG", TYPE_I32, "ANY:1", "ALL")
    Case 25: r = UXBBuiltinTypeRuleMake("CSNG", TYPE_F32, "ANY:1", "ALL")
    Case 26: r = UXBBuiltinTypeRuleMake("CDBL", TYPE_F64, "ANY:1", "ALL")
    Case 27: r = UXBBuiltinTypeRuleMake("LCASE", TYPE_STRING, "STRING:1", "ALL")
    Case 28: r = UXBBuiltinTypeRuleMake("UCASE", TYPE_STRING, "STRING:1", "ALL")
    Case 29: r = UXBBuiltinTypeRuleMake("TRIM", TYPE_STRING, "STRING:1", "ALL")
    Case 30: r = UXBBuiltinTypeRuleMake("LTRIM", TYPE_STRING, "STRING:1", "ALL")
    Case 31: r = UXBBuiltinTypeRuleMake("RTRIM", TYPE_STRING, "STRING:1", "ALL")
    Case 32: r = UXBBuiltinTypeRuleMake("INPUT", TYPE_STRING, "OPTIONAL_PROMPT", "CONSOLE_RUNTIME")
    Case 33: r = UXBBuiltinTypeRuleMake("STRPTR", TYPE_STRPTR, "STRING:1", "NATIVE_RUNTIME")
    Case 34: r = UXBBuiltinTypeRuleMake("WSTRPTR", TYPE_WSTRPTR, "WSTRING:1", "NATIVE_RUNTIME")
    Case 35: r = UXBBuiltinTypeRuleMake("PTR", TYPE_PTR, "ANY:1", "NATIVE_RUNTIME")
    Case 36: r = UXBBuiltinTypeRuleMake("CASTPTR", TYPE_PTR, "TYPE,VALUE", "NATIVE_RUNTIME")
    Case 37: r = UXBBuiltinTypeRuleMake("VARPTR", TYPE_PTR, "IDENT:1", "NATIVE_RUNTIME")
    Case 38: r = UXBBuiltinTypeRuleMake("SADD", TYPE_PTR, "STRING:1", "NATIVE_RUNTIME")
    Case 39: r = UXBBuiltinTypeRuleMake("BIGINIT", TYPE_BIGFLOAT, "BIG_EXTERNAL_INIT", "EXTFP_RUNTIME")
    Case 40: r = UXBBuiltinTypeRuleMake("F80", TYPE_F80, "EXTFP_CONSTRUCT", "EXTFP_RUNTIME")
    Case 41: r = UXBBuiltinTypeRuleMake("F128", TYPE_F128, "EXTFP_CONSTRUCT", "EXTFP_RUNTIME")
    Case 42: r = UXBBuiltinTypeRuleMake("BIGF", TYPE_BIGFLOAT, "EXTFP_CONSTRUCT", "EXTFP_RUNTIME")
    Case 43: r = UXBBuiltinTypeRuleMake("BIGD", TYPE_BIGD, "EXTFP_CONSTRUCT", "EXTFP_RUNTIME")
    Case 44: r = UXBBuiltinTypeRuleMake("BALL", TYPE_BALL, "EXTFP_CONSTRUCT", "EXTFP_RUNTIME")
    Case 45: r = UXBBuiltinTypeRuleMake("SIZEOF", TYPE_I32, "TYPE:1", "ALL")
    Case 46: r = UXBBuiltinTypeRuleMake("OFFSETOF", TYPE_I32, "TYPE,STRING", "ALL")
    Case 47: r = UXBBuiltinTypeRuleMake("PEEK", TYPE_I32, "PTR:1", "NATIVE_RUNTIME")
    Case 48: r = UXBBuiltinTypeRuleMake("PEEKB", TYPE_U8, "PTR:1", "NATIVE_RUNTIME")
    Case 49: r = UXBBuiltinTypeRuleMake("PEEKW", TYPE_U16, "PTR:1", "NATIVE_RUNTIME")
    ' S-061: PEEKD was TYPE_I32 (signed), inconsistent with PEEKB/PEEKW's own
    ' TYPE_U8/TYPE_U16 right above -- PEEK* never returns a negative value in
    ' any of the 3 engines (Mete's decision: unsigned, classic BASIC PEEK
    ' convention). Corrected to match; PEEKQ added unsigned for the same reason.
    Case 50: r = UXBBuiltinTypeRuleMake("PEEKD", TYPE_U32, "PTR:1", "NATIVE_RUNTIME")
    Case 51: r = UXBBuiltinTypeRuleMake("LISTLEN", TYPE_I32, "LIST:1", "ALL")
    Case 52: r = UXBBuiltinTypeRuleMake("LISTGET", TYPE_OBJECT, "LIST,INT", "ALL")
    Case 53: r = UXBBuiltinTypeRuleMake("LISTSET", TYPE_BOOL, "LIST,INT,ANY", "ALL")
    Case 54: r = UXBBuiltinTypeRuleMake("LISTADD", TYPE_BOOL, "LIST,ANY", "ALL")
    Case 55: r = UXBBuiltinTypeRuleMake("LISTREMOVE", TYPE_BOOL, "LIST,INT", "ALL")
    Case 56: r = UXBBuiltinTypeRuleMake("LISTCLEAR", TYPE_BOOL, "LIST:1", "ALL")
    Case 57: r = UXBBuiltinTypeRuleMake("DICTLEN", TYPE_I32, "DICT:1", "ALL")
    Case 58: r = UXBBuiltinTypeRuleMake("DICTHAS", TYPE_BOOL, "DICT,STRING", "ALL")
    Case 59: r = UXBBuiltinTypeRuleMake("DICTGET", TYPE_OBJECT, "DICT,STRING", "ALL")
    Case 60: r = UXBBuiltinTypeRuleMake("DICTSET", TYPE_BOOL, "DICT,STRING,ANY", "ALL")
    Case 61: r = UXBBuiltinTypeRuleMake("DICTCLEAR", TYPE_BOOL, "DICT:1", "ALL")
    Case 62: r = UXBBuiltinTypeRuleMake("SETLEN", TYPE_I32, "SET:1", "ALL")
    Case 63: r = UXBBuiltinTypeRuleMake("SETHAS", TYPE_BOOL, "SET,STRING", "ALL")
    Case 64: r = UXBBuiltinTypeRuleMake("SETADD", TYPE_BOOL, "SET,STRING", "ALL")
    Case 65: r = UXBBuiltinTypeRuleMake("SETREMOVE", TYPE_BOOL, "SET,STRING", "ALL")
    Case 66: r = UXBBuiltinTypeRuleMake("SETCLEAR", TYPE_BOOL, "SET:1", "ALL")
    Case 67: r = UXBBuiltinTypeRuleMake("CODEPTR", TYPE_PTR, "IDENT:1", "NATIVE_RUNTIME")
    Case 68: r = UXBBuiltinTypeRuleMake("LPTR", TYPE_PTR, "IDENT:1", "NATIVE_RUNTIME")
    Case 69: r = UXBBuiltinTypeRuleMake("LIST_NEW", "LIST", "NOARGS", "ALL")
    Case 70: r = UXBBuiltinTypeRuleMake("DICT_NEW", "DICT", "NOARGS", "ALL")
    Case 71: r = UXBBuiltinTypeRuleMake("SET_NEW", "SET", "NOARGS", "ALL")
    Case 72: r = UXBBuiltinTypeRuleMake("EOF", TYPE_I32, "INT:1", "CONSOLE_RUNTIME")
    Case 73: r = UXBBuiltinTypeRuleMake("LOF", TYPE_I32, "INT:1", "CONSOLE_RUNTIME")
    Case 74: r = UXBBuiltinTypeRuleMake("PEEKQ", TYPE_U64, "PTR:1", "NATIVE_RUNTIME")
    ' S-101 (Mete decision 2026-09-20): LBOUND/UBOUND(array [, dimension]) - dimension 1-based, default 1.
    Case 75: r = UXBBuiltinTypeRuleMake("LBOUND", TYPE_I32, "ARRAY[,INT]", "ALL")
    Case 76: r = UXBBuiltinTypeRuleMake("UBOUND", TYPE_I32, "ARRAY[,INT]", "ALL")
    ' S-508: FIX truncates toward zero and has the same static integer result
    ' contract as INT; leaving it out made the type pass classify FIX(...) as
    ' TYPE_OBJECT, so only direct PRINT could consume the value.
    Case 77: r = UXBBuiltinTypeRuleMake("FIX", TYPE_I32, "NUMERIC:1", "ALL")
    Case 78: r = UXBBuiltinTypeRuleMake("GETKEY", TYPE_I32, "NOARGS", "CONSOLE_RUNTIME")
    Case 79: r = UXBBuiltinTypeRuleMake("INKEY", TYPE_I32, "FLAGS[,STATE]", "CONSOLE_RUNTIME")
    Case 80: r = UXBBuiltinTypeRuleMake("CSRLIN", TYPE_I32, "NOARGS", "ALL")
    Case 81: r = UXBBuiltinTypeRuleMake("POS", TYPE_I32, "NOARGS", "ALL")
    Case Else
        Return 0
    End Select
    Return 1
End Function

Function UXBBuiltinTypeRegistryReturnType(ByVal callName As String, ByRef returnTypeOut As String, ByRef argPolicyOut As String, ByRef targetPolicyOut As String) As Integer
    Dim n As String
    n = UCase(Trim(callName))
    Dim i As Integer
    For i = 0 To UXBBuiltinTypeRuleCount() - 1
        Dim r As UXBBuiltinTypeRule
        If UXBBuiltinTypeRuleAt(i, r) <> 0 Then
            If r.name = n Then
                returnTypeOut = r.returnType
                argPolicyOut = r.argPolicy
                targetPolicyOut = r.targetPolicy
                Return 1
            End If
        End If
    Next i
    returnTypeOut = ""
    argPolicyOut = ""
    targetPolicyOut = ""
    Return 0
End Function

Function UXBBuiltinTypeReturnType(ByVal callName As String, ByRef returnTypeOut As String) As Integer
    Dim argPolicy As String
    Dim targetPolicy As String
    Return UXBBuiltinTypeRegistryReturnType(callName, returnTypeOut, argPolicy, targetPolicy)
End Function

Function UXBTypeInferReportCsv(ByRef csvOut As String) As Integer
    csvOut = "name,return_type,arg_policy,target_policy,source" & Chr(10)
    Dim i As Integer
    For i = 0 To UXBBuiltinTypeRuleCount() - 1
        Dim r As UXBBuiltinTypeRule
        If UXBBuiltinTypeRuleAt(i, r) <> 0 Then
            csvOut &= UXBReportCsvEscape(r.name) & "," & UXBReportCsvEscape(r.returnType) & "," & UXBReportCsvEscape(r.argPolicy) & "," & UXBReportCsvEscape(r.targetPolicy) & ",type_builtin_registry" & Chr(10)
        End If
    Next i
    Return 1
End Function

Function UXBWriteTypeInferReportCsv(ByRef outPath As String, ByRef errText As String) As Integer
    If Trim(outPath) = "" Then Return 1
    Dim csvText As String
    UXBTypeInferReportCsv csvText
    Return UXBReportWriteText(outPath, csvText, errText)
End Function

Function UXBTypeInferMissingDiagnostic(ByRef callName As String, ByRef errText As String) As Integer
    errText = "TYPE_INFER_MISSING: builtin return type is not registered: " & UCase(Trim(callName))
    Return 0
End Function

#endif
