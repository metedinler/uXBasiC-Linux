#ifndef UXB_TYPE_RULES_FBS
#define UXB_TYPE_RULES_FBS
#include once "type_kinds.fbs"
#include once "../common/type_storage_contract.fbs"
Declare Function UXBStep3EnumBaseType(ByVal typeName As String) As String
Declare Function UXBStep3TypeIsClassOrInterfaceName(ByVal typeName As String) As Integer

Function UXBStep3StorageType(ByVal rawType As String) As String
    Dim baseType As String = UXBStep3EnumBaseType(rawType)
    If baseType <> "" Then Return baseType
    Return rawType
End Function

Function UXBStep3TypeU(ByVal rawText As String) As String
    Return UCase(Trim(rawText))
End Function

Function UXBStep3TypeCanonical(ByVal rawType As String) As String
    Dim t As String = UXBStep3TypeU(rawType)
    ' ADIM43: precision suffix support, e.g. BIGF(256), BIGD(80), BALL(256)
    Dim precisionPos43 As Integer
    precisionPos43 = InStr(t, "(")
    If precisionPos43 > 1 Then t = Left(t, precisionPos43 - 1)
    Select Case t
    Case "", "VARIANT", "VAR", "TYPE_VARIANT": Return TYPE_VARIANT
    Case "ANY", "ANYREF", "TYPE_ANY": Return TYPE_ANY
    Case "VOID", "SUB", "TYPE_VOID": Return TYPE_VOID
    Case "BOOL", "BOOLEAN", "TYPE_BOOL": Return TYPE_BOOL
    Case "BYTE", "SBYTE", "I8", "TYPE_I8": Return TYPE_I8
    Case "UBYTE", "U8", "TYPE_U8": Return TYPE_U8
    Case "SHORT", "I16", "TYPE_I16": Return TYPE_I16
    Case "USHORT", "U16", "TYPE_U16": Return TYPE_U16
    Case "INTEGER", "LONG", "INT", "I32", "TYPE_I32": Return TYPE_I32
    Case "UINTEGER", "ULONG", "UINT", "U32", "TYPE_U32": Return TYPE_U32
    Case "LONGINT", "LONGLONG", "I64", "TYPE_I64": Return TYPE_I64
    Case "ULONGINT", "ULONGLONG", "U64", "TYPE_U64": Return TYPE_U64
    Case "SINGLE", "FLOAT", "F32", "TYPE_F32": Return TYPE_F32
    Case "DOUBLE", "DBL", "F64", "TYPE_F64": Return TYPE_F64
    Case "EXTENDED", "EXT", "F80", "TYPE_F80": Return TYPE_F80
    Case "FLOAT128", "QUAD", "F128", "TYPE_F128": Return TYPE_F128
    Case "BIGINT", "BIG_INTEGER", "TYPE_BIGINT": Return TYPE_BIGINT
    Case "BIGFLOAT", "BIGF", "TYPE_BIGFLOAT": Return TYPE_BIGFLOAT
    Case "BIGD", "BIGDECIMAL", "TYPE_BIGD": Return TYPE_BIGD
    Case "BALL", "TYPE_BALL": Return TYPE_BALL
    Case "STRING", "ZSTRING", "TYPE_STRING": Return TYPE_STRING
    Case "WSTRING", "TYPE_WSTRING": Return TYPE_WSTRING
    Case "PTR", "POINTER", "PVOID", "TYPE_PTR": Return TYPE_PTR
    Case "STRPTR", "TYPE_STRPTR": Return TYPE_STRPTR
    Case "WSTRPTR", "TYPE_WSTRPTR": Return TYPE_WSTRPTR
    Case "ARRAY", "TYPE_ARRAY": Return TYPE_ARRAY
    Case "OBJECT", "VAR", "TYPE_OBJECT": Return TYPE_OBJECT
    Case "TYPE", "STRUCT", "UDT", "TYPE_TYPEDEF": Return TYPE_TYPEDEF
    Case "CLASS", "TYPE_CLASS": Return TYPE_CLASS
    Case "INTERFACE", "TYPE_INTERFACE": Return TYPE_INTERFACE
    Case "FUNCTION_PTR", "FUNCPTR", "PROC", "TYPE_FUNCTION_PTR": Return TYPE_FUNCTION_PTR
    Case "DLL_HANDLE", "HDLL", "TYPE_DLL_HANDLE": Return TYPE_DLL_HANDLE
    Case "FILE_HANDLE", "HFILE", "TYPE_FILE_HANDLE": Return TYPE_FILE_HANDLE
    Case "JS_OBJECT", "TYPE_JS_OBJECT": Return TYPE_JS_OBJECT
    Case "WASM_EXTERNREF", "EXTERNREF", "TYPE_WASM_EXTERNREF": Return TYPE_WASM_EXTERNREF
    Case "TASK", "TYPE_TASK": Return TYPE_TASK
    Case "TASKGROUP", "TYPE_TASKGROUP": Return TYPE_TASKGROUP
    Case "MUTEX", "TYPE_MUTEX": Return TYPE_MUTEX
    Case "TYPE_NULL": Return TYPE_NULL
    Case TYPE_UNKNOWN: Return TYPE_UNKNOWN
    Case TYPE_ERROR: Return TYPE_ERROR
    End Select
    Return t
End Function

Function UXBStep3TypeLegacyName(ByVal rawType As String) As String
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Select Case t
    Case TYPE_VOID: Return "VOID"
    Case TYPE_BOOL: Return "BOOLEAN"
    Case TYPE_I8: Return "I8"
    Case TYPE_U8: Return "U8"
    Case TYPE_I16: Return "I16"
    Case TYPE_U16: Return "U16"
    Case TYPE_I32: Return "I32"
    Case TYPE_U32: Return "U32"
    Case TYPE_I64: Return "I64"
    Case TYPE_U64: Return "U64"
    Case TYPE_F32: Return "F32"
    Case TYPE_F64: Return "F64"
    Case TYPE_F80: Return "F80"
    Case TYPE_F128: Return "F128"
    Case TYPE_BIGINT: Return "BIGINT"
    Case TYPE_BIGFLOAT: Return "BIGF"
    Case TYPE_BIGD: Return "BIGD"
    Case TYPE_BALL: Return "BALL"
    Case TYPE_STRING: Return "STRING"
    Case TYPE_WSTRING: Return "WSTRING"
    Case TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR: Return "POINTER"
    Case TYPE_ARRAY: Return "ARRAY"
    Case TYPE_OBJECT: Return "TYPE"
    Case TYPE_VARIANT: Return "TYPE"
    Case TYPE_ANY: Return "TYPE"
    Case TYPE_TYPEDEF: Return "TYPE"
    Case TYPE_CLASS: Return "CLASS"
    Case TYPE_INTERFACE: Return "INTERFACE"
    Case TYPE_FUNCTION_PTR: Return "POINTER"
    Case TYPE_DLL_HANDLE, TYPE_FILE_HANDLE: Return "POINTER"
    Case TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF: Return "REF"
    ' S-030/S-149: tip baglama tablosu TASK/TASKGROUP turlerini kendisi tanir
    ' (type_binding.fbs, isTask). "POINTER"a indirmek, ada gore calisan kayit
    ' defterinden geri okununca TYPE_PTR'a donusup TASK parametrelerini PTR
    ' gosteriyordu (MIR'de `SUB Show(t AS TASK)` icinde t.JOIN() cozulmuyordu).
    Case TYPE_TASK: Return "TASK"
    Case TYPE_TASKGROUP: Return "TASKGROUP"
    Case TYPE_MUTEX: Return "MUTEX"
    End Select
    Return t
End Function

Function UXBStep3TypeIsBlocked(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    If t = TYPE_UNKNOWN Or t = TYPE_ERROR Then Return 1
    If t = "LAYOUT_MISSING" Or t = "TYPE_LAYOUT_MISSING" Then Return 1
    Return 0
End Function

Function UXBStep3TypeIsKnownScalar(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Select Case t
    Case TYPE_VOID, TYPE_BOOL, TYPE_I8, TYPE_U8, TYPE_I16, TYPE_I32, TYPE_U16, TYPE_U32, TYPE_I64, TYPE_U64, TYPE_F32, TYPE_F64, TYPE_F80, TYPE_F128, TYPE_BIGINT, TYPE_BIGFLOAT, TYPE_BIGD, TYPE_BALL, TYPE_STRING, TYPE_WSTRING, TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR, TYPE_ARRAY, TYPE_OBJECT, TYPE_VARIANT, TYPE_ANY, TYPE_TYPEDEF, TYPE_CLASS, TYPE_INTERFACE, TYPE_FUNCTION_PTR, TYPE_DLL_HANDLE, TYPE_FILE_HANDLE, TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF
        Return 1
    End Select
    Return 0
End Function

Function UXBStep3TypeIsNumeric(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(UXBStep3StorageType(rawType))
    Select Case t
    Case TYPE_I8, TYPE_U8, TYPE_I16, TYPE_I32, TYPE_U16, TYPE_U32, TYPE_I64, TYPE_U64, TYPE_F32, TYPE_F64, TYPE_F80, TYPE_F128, TYPE_BIGINT, TYPE_BIGFLOAT, TYPE_BIGD, TYPE_BALL
        Return 1
    End Select
    Return 0
End Function

Function UXBStep3TypeIsInteger(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(UXBStep3StorageType(rawType))
    Select Case t
    Case TYPE_BOOL, TYPE_I8, TYPE_U8, TYPE_I16, TYPE_U16, TYPE_I32, TYPE_U32, TYPE_I64, TYPE_U64, TYPE_BIGINT
        Return 1
    End Select
    Return 0
End Function

Function UXBStep3TypeIsFloat(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Select Case t
    Case TYPE_F32, TYPE_F64, TYPE_F80, TYPE_F128, TYPE_BIGFLOAT, TYPE_BIGD, TYPE_BALL
        Return 1
    End Select
    Return 0
End Function

Function UXBStep3TypeIsString(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Return IIf(t = TYPE_STRING Or t = TYPE_WSTRING, 1, 0)
End Function

Function UXBStep3TypeIsPointerLike(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Select Case t
    Case TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR, TYPE_FUNCTION_PTR, TYPE_DLL_HANDLE, TYPE_FILE_HANDLE
        Return 1
    End Select
    Return 0
End Function

' Pointers that support byte-based +/- arithmetic (not handles/function pointers).
Function UXBStep3TypeIsBytePointer(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Select Case t
    Case TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR
        Return 1
    End Select
    Return 0
End Function

Function UXBStep3TypeIsObjectLike(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(rawType)
    Select Case t
    Case TYPE_OBJECT, TYPE_VARIANT, TYPE_ANY, TYPE_TYPEDEF, TYPE_CLASS, TYPE_INTERFACE, TYPE_ARRAY, TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF
        Return 1
    End Select
    Return 0
End Function

Function UXBStep3TypeSizeBytes(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(UXBStep3StorageType(rawType))
    Select Case t
    Case TYPE_VOID: Return 0
    Case TYPE_BOOL, TYPE_I8, TYPE_U8: Return 1
    Case TYPE_I16, TYPE_U16: Return 2
    Case TYPE_I32, TYPE_U32, TYPE_F32: Return 4
    Case TYPE_I64, TYPE_U64, TYPE_F64: Return 8
    Case TYPE_F80: Return 10
    Case TYPE_F128: Return 16
    Case TYPE_BIGINT, TYPE_BIGFLOAT, TYPE_BIGD, TYPE_BALL, TYPE_STRING, TYPE_WSTRING, TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR, TYPE_ARRAY, TYPE_OBJECT, TYPE_VARIANT, TYPE_ANY, TYPE_TYPEDEF, TYPE_CLASS, TYPE_INTERFACE, TYPE_FUNCTION_PTR, TYPE_DLL_HANDLE, TYPE_FILE_HANDLE, TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF
        Return 8
    End Select
    Return 8
End Function

Function UXBStep3TypeAlignBytes(ByVal rawType As String) As Integer
    Dim sz As Integer = UXBStep3TypeSizeBytes(rawType)
    If sz <= 1 Then Return 1
    If sz <= 2 Then Return 2
    If sz <= 4 Then Return 4
    Return 8
End Function

Function UXBStep3TypePromoteNumeric(ByVal leftType As String, ByVal rightType As String) As String
    Dim l As String = UXBStep3TypeCanonical(UXBStep3StorageType(leftType))
    Dim r As String = UXBStep3TypeCanonical(UXBStep3StorageType(rightType))
    If l = TYPE_F128 Or r = TYPE_F128 Then Return TYPE_F128
    If l = TYPE_F80 Or r = TYPE_F80 Then Return TYPE_F80
    If l = TYPE_F64 Or r = TYPE_F64 Then Return TYPE_F64
    If l = TYPE_F32 Or r = TYPE_F32 Then Return TYPE_F32
    If l = TYPE_BALL Or r = TYPE_BALL Then Return TYPE_BALL
    If l = TYPE_BIGD Or r = TYPE_BIGD Then Return TYPE_BIGD
    If l = TYPE_BIGFLOAT Or r = TYPE_BIGFLOAT Then Return TYPE_BIGFLOAT
    If l = TYPE_BIGINT Or r = TYPE_BIGINT Then Return TYPE_BIGINT
    ' S-077: an unsigned 64-bit operand makes the whole operation unsigned
    ' 64-bit (C rule: I64 op U64 -> U64). It used to collapse to I64, which made
    ' `u - 1` a negative number and `u > 5` a signed compare.
    If l = TYPE_U64 Or r = TYPE_U64 Then Return TYPE_U64
    If l = TYPE_I64 Or r = TYPE_I64 Then Return TYPE_I64
    ' S-088 (Mete's decision, 2026-09-20): U32 op U32 is U32 (C rule: an unsigned 32-bit
    ' operand makes a 32-bit operation unsigned), so the RESULT wraps modulo 2^32 --
    ' `1 - 2` on U32 is 4294967295 -- not only when it is later stored. U8/U16 operands
    ' still promote to I32 (their sum cannot overflow it), U64 already returns above.
    If l = TYPE_U32 Or r = TYPE_U32 Then Return TYPE_U32
    Return TYPE_I32
End Function

' S-088: true when `rawType` is the unsigned 32-bit integer type.
Function UXBStep3TypeIsU32(ByVal rawType As String) As Integer
    Return IIf(UXBStep3TypeCanonical(UXBStep3StorageType(rawType)) = TYPE_U32, 1, 0)
End Function

' S-077: true when `typeText` is the unsigned 64-bit integer type.
Function UXBStep3TypeIsU64(ByVal rawType As String) As Integer
    Return IIf(UXBStep3TypeCanonical(UXBStep3StorageType(rawType)) = TYPE_U64, 1, 0)
End Function

' S-077: signed or unsigned 64-bit integer (values that do not fit the AST
' interpreter's 32-bit-clamping integer core).
Function UXBStep3TypeIsWide64(ByVal rawType As String) As Integer
    Dim t As String = UXBStep3TypeCanonical(UXBStep3StorageType(rawType))
    Return IIf(t = TYPE_U64 Or t = TYPE_I64, 1, 0)
End Function

Function UXBStep3TypeCanCoerce(ByVal fromType As String, ByVal toType As String, ByRef explicitCastNeeded As Integer) As Integer
    Dim f As String = UXBStep3TypeCanonical(fromType)
    Dim t As String = UXBStep3TypeCanonical(toType)
    explicitCastNeeded = 0
    If UXBStep3TypeIsBlocked(f) <> 0 Or UXBStep3TypeIsBlocked(t) <> 0 Then Return 0
    If t = TYPE_VOID Then Return IIf(f = TYPE_VOID, 1, 0)
    If f = t Then Return 1
    ' S-564: NULL / NOTHING converts (implicitly) to a pointer, an object, a class / interface type and a function pointer, to nothing else.
    If f = TYPE_NULL Then
        Select Case t
        Case TYPE_PTR, TYPE_STRPTR, TYPE_WSTRPTR, TYPE_FUNCTION_PTR, TYPE_OBJECT, TYPE_VARIANT, TYPE_ANY, TYPE_CLASS, TYPE_INTERFACE, TYPE_JS_OBJECT, TYPE_WASM_EXTERNREF
            Return 1
        End Select
        Return UXBStep3TypeIsClassOrInterfaceName(t)
    End If
    If t = TYPE_NULL Then
        ' (comparison operands are not checked here; assigning TO the null type has no meaning)
        Return 0
    End If
    If UXBStep3EnumBaseType(f) <> "" Or UXBStep3EnumBaseType(t) <> "" Then
        If UXBStep3TypeIsInteger(f) <> 0 And UXBStep3TypeIsInteger(t) <> 0 Then explicitCastNeeded = 1: Return 1
        Return 0
    End If
    If UXBStep3TypeIsNumeric(f) <> 0 And UXBStep3TypeIsNumeric(t) <> 0 Then
        ' S-132: float->integer daraltma her zaman explicit (veri kaybi garantili).
        ' float->float daraltma (F64->F32 gibi) ve integer->float atamalari IMPLICIT;
        ' C/FreeBASIC uyumu: `x AS SINGLE = 2.5` gecerli.
        ' integer->integer daraltma (I64->I32 gibi) explicit.
        If UXBStep3TypeIsFloat(f) <> 0 And UXBStep3TypeIsInteger(t) <> 0 Then explicitCastNeeded = 1
        If UXBStep3TypeIsInteger(f) <> 0 And UXBStep3TypeIsInteger(t) <> 0 Then
            If UXBStep3TypeSizeBytes(f) > UXBStep3TypeSizeBytes(t) Then explicitCastNeeded = 1
        End If
        Return 1
    End If
    If f = TYPE_BOOL And UXBStep3TypeIsInteger(t) <> 0 Then Return 1
    If UXBStep3TypeIsInteger(f) <> 0 And t = TYPE_BOOL Then explicitCastNeeded = 1: Return 1
    If f = TYPE_STRING And t = TYPE_WSTRING Then Return 1
    If f = TYPE_WSTRING And t = TYPE_STRING Then explicitCastNeeded = 1: Return 1
    If UXBStep3TypeIsPointerLike(f) <> 0 And UXBStep3TypeIsPointerLike(t) <> 0 Then explicitCastNeeded = 1: Return 1
    If UXBStep3TypeIsObjectLike(f) <> 0 And UXBStep3TypeIsObjectLike(t) <> 0 Then explicitCastNeeded = 1: Return 1
    If f = TYPE_VARIANT Or t = TYPE_VARIANT Then explicitCastNeeded = IIf(f = t, 0, 1): Return 1
    If f = TYPE_ANY Or t = TYPE_ANY Then explicitCastNeeded = IIf(f = t, 0, 1): Return 1
    If f = TYPE_OBJECT Or t = TYPE_OBJECT Then explicitCastNeeded = 1: Return 1
    Return 0
End Function
#endif
