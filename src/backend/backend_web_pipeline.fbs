#ifndef UXB_BACKEND_WEB_PIPELINE_FBS
#define UXB_BACKEND_WEB_PIPELINE_FBS

#include once "backend_web_cli_args.fbs"
#include once "backend_web_context_builder.fbs"
#include once "backend_native_surface_scan.fbs"
#include once "backend_web_coverage_gate_adim26.fbs"
#include once "uxb_backend_web_gate_adim14.fbs"
#include once "uxb_backend_web_report_adim14.fbs"
#include once "common/backend_result.fbs"
#include once "common/backend_json_report.fbs"
#include once "../common/report_writer.fbs"
#include once "../semantic/mir_verification_gate.fbs"
