#ifndef UXB_CLI_ARGS_FBS
#define UXB_CLI_ARGS_FBS

Const UXB_CLI_MAX_ARGS As Integer = 512
Const UXB_CLI_MAX_FLAGS As Integer = 256
Const UXB_CLI_MAX_VALUES As Integer = 256
Const UXB_CLI_VERSION_TEXT As String = "uXBasic CLI Adim12"

Type UXBCliArgList
    items(0 To UXB_CLI_MAX_ARGS - 1) As String
    count As Integer
End Type

Type UXBCliKeyValue
    keyText As String
    valueText As String
End Type

Type UXBCliRoute
    verb As String
    sourcePath As String
    target As String
    stopAfter As String
    jsonOut As String
    diagFormat As String
    errorLimit As Integer
    strictMode As Integer
    timePasses As Integer
    helpMode As Integer
    versionMode As Integer
    emitNasmOut As String
    x64Mode As String
    emitJsOut As String
    emitWatOut As String
    emitWasmOut As String
    dumpAstOut As String
    dumpMirOut As String
    routeMatrixOut As String
    helpOut As String
    reportOut As String
End Type

Type UXBCliState
    initialized As Integer
    rawArgs As UXBCliArgList
    expandedArgs As UXBCliArgList
    route As UXBCliRoute
    aliasFlags(0 To UXB_CLI_MAX_FLAGS - 1) As String
    aliasFlagCount As Integer
    aliasValues(0 To UXB_CLI_MAX_VALUES - 1) As UXBCliKeyValue
    aliasValueCount As Integer
    errorCode As String
    errorText As String
End Type

Dim Shared gUXBCli As UXBCliState

Sub UXBCliArgListInit(ByRef a As UXBCliArgList)
    a.count = 0
End Sub

Function UXBCliArgListAdd(ByRef a As UXBCliArgList, ByRef itemText As String) As Integer
    If a.count >= UXB_CLI_MAX_ARGS Then Return 0
    a.items(a.count) = itemText
    a.count += 1
    Return 1
End Function

Function UXBCliLower(ByRef s As String) As String
    Return LCase(Trim(s))
End Function

Sub UXBCliRouteInit(ByRef r As UXBCliRoute)
    r.verb = ""
    r.sourcePath = ""
    r.target = ""
    r.stopAfter = ""
    r.jsonOut = ""
    r.diagFormat = "text"
    r.errorLimit = 20
    r.strictMode = 0
    r.timePasses = 0
    r.helpMode = 0
    r.versionMode = 0
    r.emitNasmOut = ""
    r.x64Mode = ""
    r.emitJsOut = ""
    r.emitWatOut = ""
    r.emitWasmOut = ""
    r.dumpAstOut = ""
    r.dumpMirOut = ""
    r.routeMatrixOut = "reports\control\current\adim12_cli_route_matrix.csv"
    r.helpOut = "reports\control\current\adim12_cli_help.txt"
    r.reportOut = "reports\control\current\adim12_cli_json_report.json"
End Sub

Sub UXBCliStateInit(ByRef s As UXBCliState)
    s.initialized = 0
    UXBCliArgListInit s.rawArgs
    UXBCliArgListInit s.expandedArgs
    UXBCliRouteInit s.route
    s.aliasFlagCount = 0
    s.aliasValueCount = 0
    s.errorCode = ""
    s.errorText = ""
End Sub

Function UXBCliIsOption(ByRef textValue As String) As Integer
    If Left(Trim(textValue), 1) = "-" Then Return 1
    Return 0
End Function

Function UXBCliIsResponseFile(ByRef textValue As String) As Integer
    If Left(Trim(textValue), 1) = "@" Then Return 1
    Return 0
End Function

Function UXBCliNormalizeKey(ByRef keyText As String) As String
    Return UXBCliLower(keyText)
End Function

Function UXBCliAddAliasFlag(ByRef s As UXBCliState, ByRef keyText As String) As Integer
    Dim key As String = UXBCliNormalizeKey(keyText)
    If key = "" Then Return 1
    Dim i As Integer
    For i = 0 To s.aliasFlagCount - 1
        If s.aliasFlags(i) = key Then Return 1
    Next i
    If s.aliasFlagCount >= UXB_CLI_MAX_FLAGS Then Return 0
    s.aliasFlags(s.aliasFlagCount) = key
    s.aliasFlagCount += 1
    Return 1
End Function

Function UXBCliAddAliasValue(ByRef s As UXBCliState, ByRef keyText As String, ByRef valueText As String) As Integer
    Dim key As String = UXBCliNormalizeKey(keyText)
    If key = "" Then Return 1
    Dim i As Integer
    For i = 0 To s.aliasValueCount - 1
        If s.aliasValues(i).keyText = key Then
            s.aliasValues(i).valueText = valueText
            Return 1
        End If
    Next i
    If s.aliasValueCount >= UXB_CLI_MAX_VALUES Then Return 0
    s.aliasValues(s.aliasValueCount).keyText = key
    s.aliasValues(s.aliasValueCount).valueText = valueText
    s.aliasValueCount += 1
    Return 1
End Function

Function UXBCliHasAliasFlag(ByRef s As UXBCliState, ByRef keyText As String) As Integer
    Dim key As String = UXBCliNormalizeKey(keyText)
    Dim i As Integer
    For i = 0 To s.aliasFlagCount - 1
        If s.aliasFlags(i) = key Then Return 1
    Next i
    Return 0
End Function

Function UXBCliGetAliasValue(ByRef s As UXBCliState, ByRef keyText As String, ByRef valueOut As String) As Integer
    Dim key As String = UXBCliNormalizeKey(keyText)
    Dim i As Integer
    For i = 0 To s.aliasValueCount - 1
        If s.aliasValues(i).keyText = key Then
            valueOut = s.aliasValues(i).valueText
            Return IIf(valueOut <> "", 1, 0)
        End If
    Next i
    valueOut = ""
    Return 0
End Function

Function UXBCliArgListHasKey(ByRef a As UXBCliArgList, ByRef keyText As String) As Integer
    Dim key As String = UXBCliNormalizeKey(keyText)
    Dim i As Integer
    For i = 0 To a.count - 1
        Dim low As String = UXBCliLower(a.items(i))
        If low = key Then Return 1
        Dim eqPos As Integer = InStr(low, "=")
        If eqPos > 0 Then If Left(low, eqPos - 1) = key Then Return 1
    Next i
    Return 0
End Function

Function UXBCliArgListGetValue(ByRef a As UXBCliArgList, ByRef keyText As String, ByRef valueOut As String) As Integer
    Dim key As String = UXBCliNormalizeKey(keyText)
    Dim i As Integer
    For i = 0 To a.count - 1
        Dim raw As String = Trim(a.items(i))
        Dim low As String = UXBCliLower(raw)
        If low = key Then
            If i + 1 < a.count Then
                valueOut = a.items(i + 1)
                Return IIf(valueOut <> "", 1, 0)
            End If
        End If
        Dim eqPos As Integer = InStr(raw, "=")
        If eqPos > 0 Then
            If UXBCliLower(Left(raw, eqPos - 1)) = key Then
                valueOut = Mid(raw, eqPos + 1)
                Return IIf(valueOut <> "", 1, 0)
            End If
        End If
    Next i
    valueOut = ""
    Return 0
End Function

Function UXBCliReadCommandLineRaw(ByRef outArgs As UXBCliArgList) As Integer
    UXBCliArgListInit outArgs
    Dim i As Integer
    For i = 1 To UXB_CLI_MAX_ARGS
        Dim a As String = Command(i)
        If a = "" Then Exit For
        If UXBCliArgListAdd(outArgs, a) = 0 Then Return 0
    Next i
    If Command(UXB_CLI_MAX_ARGS + 1) <> "" Then Return 0
    Return 1
End Function

Function UXBCliSetError(ByRef s As UXBCliState, ByRef codeText As String, ByRef msgText As String) As Integer
    s.errorCode = codeText
    s.errorText = codeText & ": " & msgText
    Return 0
End Function

#endif
