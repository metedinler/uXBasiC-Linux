#ifndef UXB_CLI_HELP_FBS
#define UXB_CLI_HELP_FBS

#include once "cli_args.fbs"
#include once "cli_registry_adim41.fbs"

Private Sub UXBCliPrintRegistryOptions()
    Dim items() As UXBCliOptionAdim41
    UXBCliRegistryFillAdim41 items()
    Print "KAYITLI TÜM CLI ANAHTARLARI (registry kaynaklı, eksiksiz):"
    Dim i As Integer
    For i = LBound(items) To UBound(items)
        If Trim(items(i).longName) <> "" And items(i).isRemoved = 0 Then
            Dim suffixText As String
            suffixText = ""
            If items(i).needsValue <> 0 Then suffixText &= " <değer>"
            If Trim(items(i).shortName) <> "" Then suffixText &= " [" & items(i).shortName & "]"
            Print "  " & items(i).longName & suffixText & " : " & items(i).layerText & " | " & items(i).validationText
        End If
    Next i
    Print ""
End Sub

' ==============================================================================
' 1. YARDIMCI ALT PROGRAM: Doğrudan Konsola Tüm Detaylı Helpi Basar
' ==============================================================================
Sub ShowUXBCliHelp()
    ' === BAŞLIK VE ÖĞRENME FELSEFESİ ===
    Print "=== uXBasic CLI Compiler Infrastructure ==="
    Print "Kullanım: uxb <verb> [kaynak.uxb] [seçenekler...]"
    Print "          uxb @komutlar.uxcli (Toplu komut dosyası calistirir.)"
    Print "          <komutlar>.uxcli (Toplu komut dosyasıdir)"
    Print "================================================================================"
    Print "uXBasiC komut satırı yalnız çalıştırmak için değildir; öğrenmek için de kullanılır."
    Print "Bir genç programcı seçeneklerle kendi yazdığı programın iç organlarını görebilir."
    Print "Bu, derleyici yazmayı öğrenmenin kısa yoludur."
    Print "================================================================================"
    Print ""

    ' === VERBLER (3 HARFLİ ANA KOMUTLAR) ===
    Print "VERBLER (Aşama Seçiciler):"
    ' INT_VERB_AST_COMPAT_FIX_20260711: int defaults to AST-compatible interpreter; MIR stays explicit.
    Print "  lex   : Lexer / token üretimi            | par   : Sadece syntax kontrol"
    Print "  ast   : AST üretimi & contract check     | sem   : Semantic analiz & type binding"
    Print "  hir   : HIR üretimi                      | mir   : MIR üretimi ve doğrulama"
    Print "  int   : AST interpreter ile çalıştırma   | x64   : x64 NASM üretimi + build"
    Print "  jsw   : JavaScript / Web backend         | wat   : WAT üretimi"
    Print "  bld   : Tam x64 build pipeline           | run   : Programı çalıştır (interpreter)"
    Print "  chk   : Toplu doğrulama (validate-all)   | fmt   : Format kontrolü"
    Print "  map   : Source map üretimi               | doc   : Dokümantasyon üretimi"
    Print "  rel   : Release gate kontrolü            | hlp   : Detaylı yardım"
    Print "  ver   : Versiyon bilgisi"
    Print ""

    ' === GENEL VE KONTROL SEÇENEKLERİ ===
    Print "GENEL VE KONTROL SEÇENEKLERİ (Tetikleyiciler ve Bayraklar):"
    Print "  --format-check          : Biçimlendirme kontrolünü aktif eder."
    Print "  --help                  : Genel yardım menüsünü gösterir."
    Print "  --version               : Derleyici sürüm bilgisini basar."
    Print "  --target <hedef>        : Hedef platform seçer (x64, js, wat, wasm, browser)."
    Print "  --stop-after <aşama>    : Belirtilen derleme aşamasında durur."
    Print "  --diag-format           : Tanı/Hata mesajlarının çıktı formatını ayarlar."
    Print "  --strict                : Katı mod kurallarını devreye alır."
    Print "  --time-passes           : Derleyici aşamalarının çalışma sürelerini raporlar."
    Print "  --parse-only            : Sadece parser katmanını çalıştırır."
    Print "  --semantic              : Semantik analizi zorunlu kılar."
    Print "  --mir-verify            : MIR katmanı doğrulamayı tetikler."
    Print "  --execmem               : Kod üretimi için dinamik bellek yürütmesini açar."
    Print "  --interpreter-backend   : Yorumlayıcı motorunun arkasındaki katmanı seçer."
    Print "  --max-steps <N>         : Yalnız yorumlayıcılar: en çok N adım (0 = sınırsız, varsayılan)."
    Print "  --task-workers <N>      : Native SPAWN işçi sayısı (1..1024, varsayılan: CPU sayısı)."
    Print "  --validate-all          : Tüm doğrulama adımlarını çalıştırır."
    Print "  --validate-all-fail-fast: İlk hatada doğrulamayı keser."
    Print "  --source-map            : Kaynak haritası (source-map) üretimini tetikler."
    Print "  --doc                   : Otomatik dökümantasyon motorunu çalıştırır."
    Print "  --release-gate          : Canlıya alım (production) kapısı kontrollerini yürütür."
    Print "  --extract-src           : Gömülü kaynak kodları ayrıştırır."
    Print "  --console-mode          : Konsol çıktı modunu yapılandırır."
    Print "  --interop               : Harici dil bağlama (interoperability) modunu açar."
    Print "  --codegen / --x64gen    : Native kod üreticilerini tetikler."
    Print "  --debug / --ayikla      : Derleyici içi hata ayıklama (debug) çıktısını açar."
    Print "  --quiet / --sessiz      : Log çıktılarını kapatır, sadece hataları basar."
    Print "  --trace / --hook-trace  : Derleyici adımlarını ve hook'ları izler."
    Print "  --extfp-strict          : Genişletilmiş sabit nokta (ExtFP) katı modunu açar."
    Print "  --enable-extfp-runtime  : ExtFP çalışma zamanı desteğini aktif eder."
    Print "  --adim25-27-close-gate  : Adım 25-27 arası optimizasyon kapısını kapatır."
    Print "  --adim25-26-27-close-gate: Adım 25-27 tam optimizasyon kapısını kapatır."
    Print ""

    ' === EMIT VE OUT AYRIMI ===
    Print "HEDEF EMIT TETİKLEYİCİLERİ (Tek Başına Yazılır):"
    Print "  --emit-js               : JavaScript kod üretimi modunu açar."
    Print "  --emit-wat              : WebAssembly Text (WAT) üretim modunu açar."
    Print "  --emit-wasm             : WebAssembly ikili (WASM) üretim modunu açar."
    Print "  --emit-browser          : Tarayıcı uyumlu HTML/JS üretim modunu açar."
    Print "  --emit-nasm             : x64 NASM Assembly üretimini tetikler."
    Print "  --emit-x64-nasm         : x64 NASM Assembly üretim modunu açar."
    Print "  --build-x64             : Üretilen x64 kodunu doğrudan EXE'ye derler."
    Print "  --wat2wasm[=<yol>]      : WAT -> WASM dönüştürücüsünü varsayılan veya verilen yoldan çalıştırır."
    Print ""
    Print "ÇIKTI DOSYA HEDEFLERİ (Arkasına Mutlaka Dosya/Klasör Yolu İster!):"
    Print "  --js-out <dosya.js>     : Üretilen JavaScript kodunun yazılacağı dosya."
    Print "  --wat-out <dosya.wat>   : Üretilen WebAssembly Text kodunun yazılacağı dosya."
    Print "  --wasm-out <dosya.wasm> : Üretilen binary WASM kodunun yazılacağı dosya."
    Print "  --html-out <dosya.html> : Üretilen tarayıcı arayüzünün yazılacağı dosya."
    Print "  --emit-x64-nasm-out <f> : NASM assembly çıktısının kaydedileceği dosya."
    Print "  --x64gen-out <klasör>   : Üretilen yerel x64 binary dosyalarının klasörü."
    Print "  --build-x64-out <exe>   : Derlenecek nihai Windows EXE dosyasının adı/yolu."
    Print "  --out-root <klasör>     : Tüm çıktıların yazılacağı kök dizin (Örn: build/)."
    Print "  --artifact-root <klas>  : Ara derleme dosyalarının (artifact) kök dizini."
    Print "  --extfp-runtime-dir <d> : ExtFP runtime kütüphanelerinin aranacağı dizin."
    Print ""

    ' === İÇ ORGAN ANALİZİ VE JSON/CSV ÇIKTILARI ===
    Print "İÇ ORGAN ANALİZİ VE JSON/CSV ÇIKTILARI (Dosya Yolu İster):"
    Print "  --json-out <dosya>      : Genel derleme raporunu JSON formatında yazar."
    Print "  --error-limit <sayı>    : Maksimum hata limiti ve hata raporlama dosyası."
    Print "  --token-json-out <f>    : Standart token akışını JSON olarak kaydeder."
    Print "  --tokens-json-out <f>   : Gelişmiş lexer token listesini JSON olarak kaydeder."
    Print "  --parser-json-out <f>   : Parser (Sözdizimi) ağaç analiz raporunu yazar."
    Print "  --ast-json-out <dosya>  : Soyut Sözdizimi Ağacını (AST) JSON olarak dışa aktarır."
    Print "  --ir-json-out <dosya>   : Ara Seviye Temsili (IR) verilerini yazar."
    Print "  --hir-json-out <dosya>  : High-Level IR (HIR) analiz çıktısını yazar."
    Print "  --mir-json-out <dosya>  : Medium-Level IR (MIR) temel analiz çıktısını yazar."
    Print "  --mir-full-json-out <f> : Tüm MIR kontrol akış grafiğini (CFG) JSON yazar."
    Print "  --semantic-json-out <f> : Semantik analiz ve tip bağlama raporunu yazar."
    Print "  --backend-report-json-out : Arka yüz (backend) kod üretim matris raporunu yazar."
    Print "  --source-map-json-out <f> : Kaynak kod-hedef kod eşleşme haritasını JSON yazar."
    Print "  --doc-json-out <dosya>  : Üretilen API ve dil dökümantasyonunu JSON yazar."
    Print "  --release-json-out <f>  : Release kapısı test sonuç raporunu JSON yazar."
    Print "  --run-report-json-out <f>: Interpreter çalıştırma metriklerini raporlar."
    Print "  --log-out / --debug-log-out <f> : Derleyici iç loglarını dosyaya kaydeder."
    Print "  --stdout-out / --stderr-out <f> : Standart çıktıları dosyaya yönlendirir."
    Print ""
    Print "GELİŞMİŞ KATMAN VE MATRİS RAPORLARI (Anlamları ve Kullanımları):"
    Print "  --lexer-diagnostics-json-out <f>   : Lexer aşaması detaylı hata/uyarı tanı raporu."
    Print "  --parser-diagnostics-json-out <f>  : Parser aşaması sözdizimi hata ve tanı raporu."
    Print "  --semantic-diagnostics-json-out <f>: Semantik (anlam) analizi ve tip tanılama logu."
    Print "  --mir-opt-report-json-out <f>      : MIR optimizasyon adımları ve yapılan dönüşümler."
