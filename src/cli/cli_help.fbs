    Print "  --hir-inventory-json-out <f>       : High-Level IR nesnelerinin ve düğümlerinin dökümü."
    Print "  --inventory-json-out <f>           : Genel derleyici kaynak ve bileşen envanteri."
    Print "  --pipeline-json-out <f>            : Derleyici aşamalarının yürütme sırası ve durumları."
    Print "  --mir-pipeline-json-out <f>        : MIR optimizasyon ve lowering boru hattı akışı."
    Print "  --mir-opcodes-json-out <f>         : Üretilen MIR opkodlarının (buyruklarının) tam listesi."
    Print "  --mir-surface-json-out <f>         : MIR kontrol akış grafiğinin yüzeysel şeması."
    Print "  --mir-module-json-out <f>          : Modül düzeyindeki MIR yapısı ve global tanımlar."
    Print "  --mir-verify-json-out <f>          : MIR doğrulama (verification) test sonuç raporu."
    Print "  --artifact-report-json-out <f>     : Derleme sonucu oluşan tüm ara dosyaların (artifact) listesi."
    Print "  --ast-contract-json-out <f>        : AST sözleşme (contract) tanımlarının ham JSON dökümü."
    Print "  --ast-contract-report-json-out <f> : AST katmanı sözleşme ihlalleri ve uyumluluk raporu."
    Print "  --ast-contract-matrix-out <f>      : Hangi AST düğümünün hangi sözleşmeye bağlı olduğu matrisi."
    Print "  --session-live-json-out <f>        : Canlı derleme oturumu çalışma zamanı metrikleri."
    Print "  --layer-timing-json-out <f>        : Derleyici katmanlarının (lex, par, ast) mikrosaniye süreleri."
    Print "  --trace-json <f>                   : Derleyicinin tüm adımlarının adım adım izleme (tracing) verisi."
    Print "  --runtime-trace-json-out <f>       : uXBasic kodunun çalışma zamanı izleme/profil logları."
    Print "  --x64-codegen-policy-json-out <f>  : x64 kod üretimi sırasında uygulanan register/ABI politikaları."
    Print "  --extfp-policy-json-out <f>        : Genişletilmiş Sabit Nokta (ExtFP) hassasiyet politikaları."
    Print "  --program-output-json-out <f>      : Hedef programın ürettiği konsol çıktılarının JSON özeti."
    Print "  --program-output-out <f>           : Hedef programın ham standart çıktı (stdout) yönlendirmesi."
    Print "  --final-screen-json-out <f>        : Program sonlandığında oluşan bellek/ekran durum dökümü."
    Print "  --ast-contract-check               : AST katmanı sözleşme denetimlerini zorunlu tetikler."
    Print "  --debug-token-dump                 : Lexer'ın ürettiği tüm tokenleri anlık ekrana basar."
    Print "  --dump-ast                         : AST yapısını terminale insan okuyabilir formatta basar."
    Print "  --dump-mir                         : MIR yapısını ve kontrol akış grafiklerini terminale basar."
    Print "  --run-id <kimlik>                   : Çalışma oturumuna özel ID atar."
    Print ""
    Print "ÖRNEK KULLANIMLAR (Derleyiciyi Öğrenmek İçin):"
    Print "  uxb ast main.bas --dump-ast --ast-json-out build/ast.json"
    Print "  uxb sem main.bas --symbol-table-json-out build/symbols.json --type-table-json-out build/types.json"
    Print "  uxb mir main.bas --dump-mir --mir-opcodes-json-out build/opcodes.json --mir-opt-report-json-out build/opt.json"
   
    Print ""

    ' === DOĞRU KULLANIM ÖRNEKLERİ ===
    Print "AYRI İŞLEV KULLANIM ÖRNEKLERİ (Doğru ve Yanlış Kombinasyonlar):"
    Print "  DOĞRU (Adım adım ve parametreli):"
    Print "    uxb jsw main.uxb --emit-js --js-out build/app.js"
    Print "    uxb x64 main.uxb --emit-x64-nasm --emit-x64-nasm-out build/out.asm"
    Print "    uxb bld main.uxb --build-x64 --build-x64-out bin/oyun.exe"
    Print "    uxb ast main.uxb --ast-json-out build/ast_yapisi.json"
    Print ""
    UXBCliPrintRegistryOptions()
    Print "  YANLIŞ (Parametresiz arka arkaya yazım - HATA VERİR):"
    Print "    uxb jsw main.uxb --emit-js --js-out  <-- Hatalı! Çıktı dosyası belirtilmedi."
    Print "================================================================================"
    Print "Detaylı yardım için: uxb hlp --verbose"
    Print ""
    Print "uXBasic Compiler v1.06 (12.06.2026) - Zuhtu Mete DINLER - Developer"
    Print "uXBasic Compiler Copyright @ MIT 2026"
End Sub

' ==============================================================================
' 2. ANA FONKSİYON: Helpi Ekrana Basar ve Bridge İçin Temel Özet Metni Döndürür
' ==============================================================================
Function UXBCliHelpText() As String
    ' Önce terminal ekranına tüm detaylı yardım içeriğini sub ile komple yazdırıyoruz
    ShowUXBCliHelp()
    
    ' Ardından fonksiyon bir dönüş değeri (String) istediği için temel bir özet metni döndürüyoruz.
    ' Bu metin bridge dosyasındaki log/dosya yazma süreçlerini besleyecektir.
    Dim baseText As String
    baseText = "=== uXBasic Gelistirilmis BasiC  ===" & Chr(10)
    baseText &= "Zuhtu Mete DINLER Copyright @ 2026 - Kocaeli / TURKIYE (zmetedinler@gmail.com)." & Chr(10)
    baseText &= "Kullanım formatı: uxb <verb> [source.bas] [options]" & Chr(10)
    baseText &= "Bu komutları ayrı ayrı ezberleme. Mantığı şudur: `emit` üretimi açar, " & Chr(10)
    baseText &= "`out` yol söyler, `report` kanıt üretir, `trace` çalışma anını izler." & Chr(10)
    baseText &= " Bir web programını temiz üretmek için yalnız `program.js` yetmez;" & Chr(10)
    baseText &= "`index.html`, `manifest.json`, rapor ve gerekirse çalışma izi de gerekir." & Chr(10)
    
    Return baseText
End Function

' ==============================================================================
' 3. DİĞER STANDART CLI METOTLARI
' ==============================================================================
Function UXBCliEnsureParentDir(ByRef outPath As String) As Integer
    Dim p As String = Trim(outPath)
    If p = "" Then Return 1
    Dim cut As Integer = InStrRev(p, "\")
    Dim cut2 As Integer = InStrRev(p, "/")
    If cut2 > cut Then cut = cut2
    If cut <= 0 Then Return 1
    Dim parentDir As String = Left(p, cut - 1)
    If parentDir = "" Then Return 1

    Dim norm As String = ""
    Dim j As Integer
    For j = 1 To Len(parentDir)
        Dim cj As String = Mid(parentDir, j, 1)
        If cj = "/" Then
            norm &= "\"
        Else
            norm &= cj
        End If
    Next j
    Dim acc As String = ""
    Dim i As Integer
    Dim ch As String
    For i = 1 To Len(norm)
        ch = Mid(norm, i, 1)
        acc &= ch
        If ch = "\" Then
            If Len(acc) > 3 Then
                Dim partial As String = Left(acc, Len(acc) - 1)
                If partial <> "" And Dir(partial) = "" Then MkDir partial
            End If
        End If
    Next i
    If Dir(norm) = "" Then MkDir norm
    Return 1
End Function

Sub UXBCliPrintHelp()
    ' Bu metod çağrıldığında doğrudan alt programı çalıştırabiliriz
    ShowUXBCliHelp()
End Sub

Sub UXBCliPrintVersion()
    Print UXB_CLI_VERSION_TEXT
End Sub

Function UXBCliWriteTextFile(ByRef outPath As String, ByRef textValue As String, ByRef errText As String) As Integer
    If Trim(outPath) = "" Then Return 1
    UXBCliEnsureParentDir outPath
    Dim f As Integer = FreeFile
    Open outPath For Output As #f
    If Err <> 0 Then errText = "CLI_OUTPUT_WRITE_FAIL: " & outPath: Return 0
    Print #f, textValue;
    Close #f
    Return 1
End Function

