#ifndef UXB_CLI_VERB_DISPATCH_FBS
#define UXB_CLI_VERB_DISPATCH_FBS

#include once "cli_args.fbs"
#include once "cli_output_contract_adim41.fbs"
#include once "../backend/common/backend_target.fbs"

Private Function UXBCliValidateOutputOptionAdim41(ByRef optName As String, ByRef outPath As String, ByRef errText As String) As Integer
    If Trim(outPath) = "" Then Return 1
    Dim c As UXBCliOutputContractAdim41
    UXBCliOutputContractInitAdim41 c, optName, outPath
    If UXBCliOutputContractValidatePathAdim41(c, errText) = 0 Then Return 0
    Return 1
End Function

Function UXBCliIsKnownVerb(ByRef verbText As String) As Integer
    Select Case UXBCliLower(verbText)
    Case "lex", "par", "ast", "sem", "hir", "mir", "int", "x64", "x86", "jsw", "wat", "bld", "run", "chk", "fmt", "map", "doc", "rel", "hlp", "ver", "mtx"
        Return 1
    End Select
    Return 0
End Function

Private Sub UXBCliParseCommonOptions(ByRef s As UXBCliState)
    Dim v As String
    If UXBCliArgListGetValue(s.expandedArgs, "--target", v) <> 0 Then s.route.target = UXBCliLower(v)
    If UXBCliArgListGetValue(s.expandedArgs, "--stop-after", v) <> 0 Then s.route.stopAfter = UXBCliLower(v)
    If UXBCliArgListGetValue(s.expandedArgs, "--json-out", v) <> 0 Then s.route.jsonOut = v
    If UXBCliArgListGetValue(s.expandedArgs, "--diag-format", v) <> 0 Then s.route.diagFormat = UXBCliLower(v)
    If UXBCliArgListGetValue(s.expandedArgs, "--error-limit", v) <> 0 Then s.route.errorLimit = ValInt(v)
    If UXBCliArgListGetValue(s.expandedArgs, "--emit-x64-nasm-out", v) <> 0 Then s.route.emitNasmOut = v
    If s.route.emitNasmOut = "" Then
        If UXBCliArgListGetValue(s.expandedArgs, "--build-x64-out", v) <> 0 Then s.route.emitNasmOut = v
    End If
    If UXBCliArgListGetValue(s.expandedArgs, "--x64-mode", v) <> 0 Then s.route.x64Mode = UCase(Trim(v))
    If UXBCliArgListGetValue(s.expandedArgs, "--js-out", v) <> 0 Then s.route.emitJsOut = v
    If UXBCliArgListGetValue(s.expandedArgs, "--wat-out", v) <> 0 Then s.route.emitWatOut = v
    If s.route.emitWatOut = "" Then
        If UXBCliArgListGetValue(s.expandedArgs, "--wasm-wat-out", v) <> 0 Then s.route.emitWatOut = v
    End If
    If UXBCliArgListGetValue(s.expandedArgs, "--wasm-out", v) <> 0 Then s.route.emitWasmOut = v
    If UXBCliArgListGetValue(s.expandedArgs, "--dump-ast", v) <> 0 Then s.route.dumpAstOut = v
    If UXBCliArgListGetValue(s.expandedArgs, "--dump-mir", v) <> 0 Then s.route.dumpMirOut = v
    If UXBCliArgListHasKey(s.expandedArgs, "--strict") <> 0 Then s.route.strictMode = 1
    If UXBCliArgListHasKey(s.expandedArgs, "--time-passes") <> 0 Then s.route.timePasses = 1

    Dim contractErr As String
    If UXBCliValidateOutputOptionAdim41("--json-out", s.route.jsonOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
    If UXBCliValidateOutputOptionAdim41("--emit-nasm", s.route.emitNasmOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
    If UXBCliValidateOutputOptionAdim41("--emit-js", s.route.emitJsOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
    If UXBCliValidateOutputOptionAdim41("--emit-wat", s.route.emitWatOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
    If UXBCliValidateOutputOptionAdim41("--emit-wasm", s.route.emitWasmOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
    If UXBCliValidateOutputOptionAdim41("--dump-ast", s.route.dumpAstOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
    If UXBCliValidateOutputOptionAdim41("--dump-mir", s.route.dumpMirOut, contractErr) = 0 Then UXBCliSetError s, "CLI_OUTPUT_CONTRACT", contractErr
End Sub

Private Sub UXBCliFindSourcePath(ByRef s As UXBCliState)
    Dim startIdx As Integer = IIf(s.route.verb <> "", 1, 0)
    Dim i As Integer
    For i = startIdx To s.expandedArgs.count - 1
        Dim item As String = s.expandedArgs.items(i)
        If UXBCliIsOption(item) = 0 And UXBCliIsResponseFile(item) = 0 Then
            If UXBCliIsKnownVerb(item) = 0 Then s.route.sourcePath = item: Exit Sub
        End If
    Next i
End Sub

Private Sub UXBCliAddCommonCompatibility(ByRef s As UXBCliState)
    If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--json-out", s.route.jsonOut
    If s.route.target <> "" Then UXBCliAddAliasValue s, "--target", s.route.target
    If s.route.stopAfter <> "" Then UXBCliAddAliasValue s, "--stop-after", s.route.stopAfter
    If s.route.diagFormat <> "" Then UXBCliAddAliasValue s, "--diag-format", s.route.diagFormat
    If s.route.errorLimit > 0 Then UXBCliAddAliasValue s, "--error-limit", LTrim(Str(s.route.errorLimit))
    If s.route.strictMode <> 0 Then UXBCliAddAliasFlag s, "--strict"
    If s.route.timePasses <> 0 Then UXBCliAddAliasFlag s, "--time-passes"
    If s.route.x64Mode <> "" Then UXBCliAddAliasValue s, "--x64-mode", s.route.x64Mode
End Sub

' S-666 (x86 emeklilik, Asama 3): x86 adi hangi yoldan verilirse verilsin (`x86` fiili, --emit-x86, --target-x86,
' --target x86|win32|windows32|i386|i686) ayni CLI_TARGET_RETIRED hatasi doner. Eskiden yalniz `x86` fiili reddediliyor,
' `run --target-x86` sessizce calisiyor, `bld --target x86` ise sessizce x64 EXE uretiyordu.
Private Function UXBCliRetiredX86Message() As String
    Return "x86 hedefi emekli edildi: uXBasic artik x86 (32-bit) kod uretmiyor. uXBasic'in resmi native hedefi x64'tur; 'x64' verb'ini veya --target x64 kullanin."
End Function

Private Function UXBCliX86Requested(ByRef s As UXBCliState) As Integer
    If UXBCliArgListHasKey(s.expandedArgs, "--emit-x86") <> 0 Then Return 1
    If UXBCliArgListHasKey(s.expandedArgs, "--target-x86") <> 0 Then Return 1
    Return UXBBackendTargetIsRetired(s.route.target)
End Function

Function UXBCliBuildCompatibilityAliases(ByRef s As UXBCliState) As Integer
    If UXBCliX86Requested(s) <> 0 Then Return UXBCliSetError(s, "CLI_TARGET_RETIRED", UXBCliRetiredX86Message())
    UXBCliAddCommonCompatibility s
    Dim v As String = UXBCliLower(s.route.verb)
    Select Case v
    Case ""
    Case "hlp": s.route.helpMode = 1: UXBCliAddAliasFlag s, "--help"
    Case "ver": s.route.versionMode = 1: UXBCliAddAliasFlag s, "--version"
    Case "lex": s.route.stopAfter = "lex": UXBCliAddAliasFlag s, "--debug-token-dump": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--token-json-out", s.route.jsonOut
    Case "par": s.route.stopAfter = "par": UXBCliAddAliasFlag s, "--parse-only": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--parser-json-out", s.route.jsonOut
    Case "ast": s.route.stopAfter = "ast": UXBCliAddAliasFlag s, "--ast-contract-check": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--ast-json-out", s.route.jsonOut
    Case "sem": s.route.stopAfter = "sem": UXBCliAddAliasFlag s, "--semantic": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--semantic-json-out", s.route.jsonOut
    Case "hir": s.route.stopAfter = "hir": UXBCliAddAliasFlag s, "--semantic": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--hir-json-out", s.route.jsonOut
    Case "mir": s.route.stopAfter = "mir": UXBCliAddAliasFlag s, "--mir-verify": UXBCliAddAliasValue s, "--codegen-source", "MIR": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--mir-full-json-out", s.route.jsonOut
    Case "int"
        ' INT_VERB_AST_COMPAT_FIX_20260711:
        ' "int" is the user-facing interpreter verb used by smoke runners as a
        ' generic "run through interpreter" command.  MIR is still tested
        ' explicitly by --interpreter-backend MIR and by the "mir" verb; but the
        ' YAMA6 runtime surface (EVENT/PIPE/THREAD/PARALEL/SHELL) is not yet MIR
        ' feature-complete.  Default INT to AST so user-visible interpreter
        ' output matches "run" until MIR reaches runtime-surface parity.
        UXBCliAddAliasFlag s, "--execmem"
        Dim explicitInterpreterBackend As String
        If UXBCliArgListGetValue(s.expandedArgs, "--interpreter-backend", explicitInterpreterBackend) = 0 Then
            UXBCliAddAliasValue s, "--interpreter-backend", "AST"
        End If
        If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--run-report-json-out", s.route.jsonOut
    Case "x64": s.route.target = "x64": UXBCliAddAliasFlag s, "--emit-x64-nasm": UXBCliAddAliasValue s, "--codegen-source", "MIR": UXBCliAddAliasValue s, "--x64-mode", IIf(s.route.x64Mode <> "", s.route.x64Mode, "MIR"): If s.route.emitNasmOut <> "" Then UXBCliAddAliasValue s, "--emit-x64-nasm-out", s.route.emitNasmOut: If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--x64-codegen-policy-json-out", s.route.jsonOut
    Case "x86"
        ' x86 kod uretimi bilincli olarak emekli edildi (bkz. backend_target.fbs:
        ' UXB_TARGET_X86_RETIRED). Eskiden buradan --emit-x86 enjekte edilip derin
        ' bir katmanda kafa karistirici "unknown target" hatasi alinirdi; artik CLI
        ' seviyesinde dogrudan, durust bir emeklilik mesaji verilir.
        Return UXBCliSetError(s, "CLI_TARGET_RETIRED", UXBCliRetiredX86Message())
    Case "jsw": s.route.target = "js": UXBCliAddAliasFlag s, "--emit-js": If s.route.emitJsOut <> "" Then UXBCliAddAliasValue s, "--js-out", s.route.emitJsOut: If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--backend-report-json-out", s.route.jsonOut
    Case "wat": s.route.target = "wat": UXBCliAddAliasFlag s, "--emit-wat": If s.route.emitWatOut <> "" Then UXBCliAddAliasValue s, "--wasm-wat-out", s.route.emitWatOut: If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--backend-report-json-out", s.route.jsonOut
    Case "bld": UXBCliAddAliasFlag s, "--build-x64": UXBCliAddAliasValue s, "--x64-mode", IIf(s.route.x64Mode <> "", s.route.x64Mode, "MIR"): If s.route.emitNasmOut <> "" Then UXBCliAddAliasValue s, "--build-x64-out", s.route.emitNasmOut
    Case "run": UXBCliAddAliasFlag s, "--execmem"
    Case "chk": UXBCliAddAliasFlag s, "--validate-all": UXBCliAddAliasFlag s, "--mir-verify": UXBCliAddAliasFlag s, "--ast-contract-check": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--validate-all-report-json-out", s.route.jsonOut
    Case "fmt": UXBCliAddAliasFlag s, "--format-check"
    Case "map": UXBCliAddAliasFlag s, "--source-map": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--source-map-json-out", s.route.jsonOut
    Case "doc": UXBCliAddAliasFlag s, "--doc": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--doc-json-out", s.route.jsonOut
    Case "rel": UXBCliAddAliasFlag s, "--release-gate": If s.route.jsonOut <> "" Then UXBCliAddAliasValue s, "--release-json-out", s.route.jsonOut
    Case "mtx": UXBCliAddAliasFlag s, "--emit-surface-matrices"
    Case Else
        Return UXBCliSetError(s, "CLI_UNKNOWN_VERB", "unknown CLI verb: " & s.route.verb)
    End Select
    Return 1
End Function

Function UXBCliParseExpandedArgs(ByRef s As UXBCliState) As Integer
    UXBCliRouteInit s.route
    If s.expandedArgs.count <= 0 Then s.route.verb = "hlp": s.route.helpMode = 1: Return UXBCliBuildCompatibilityAliases(s)
    Dim firstArg As String = UXBCliLower(s.expandedArgs.items(0))
    ' S-116: the words a user naturally types for help / version are aliases of the
    ' verbs `hlp` / `ver` (`uxb help` used to be taken for a source file name and failed
    ' with "unsupported source file extension").
    Select Case firstArg
    Case "help", "yardim", "?"
        firstArg = "hlp": s.expandedArgs.items(0) = "hlp"
    Case "version", "surum"
        firstArg = "ver": s.expandedArgs.items(0) = "ver"
    End Select
    If UXBCliIsKnownVerb(firstArg) <> 0 Then s.route.verb = firstArg Else s.route.verb = ""
    UXBCliParseCommonOptions s
    UXBCliFindSourcePath s
    If UXBCliArgListHasKey(s.expandedArgs, "--help") <> 0 Or UXBCliArgListHasKey(s.expandedArgs, "-h") <> 0 Then s.route.helpMode = 1
    If UXBCliArgListHasKey(s.expandedArgs, "--version") <> 0 Or UXBCliArgListHasKey(s.expandedArgs, "-v") <> 0 Then s.route.versionMode = 1
    If s.route.verb = "hlp" Then s.route.helpMode = 1
    If s.route.verb = "ver" Then s.route.versionMode = 1
    If s.errorCode <> "" Then Return 0
    Return UXBCliBuildCompatibilityAliases(s)
End Function

#endif
