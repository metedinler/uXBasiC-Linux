' ADIM41_CLI_FULL_CONTRACT_PATCH
' Bu dosya otomatik üretilmiş kayıt tablosudur.
' Amaç: tüm uzun CLI seçenekleri ve 3 harfli kısa komutları tek kaynaktan doğrulamak.
' Ana kaynak dosyalar doğrudan ezilmemeli; mevcut CLI parser bu registry üzerinden bağlanmalıdır.

#ifndef __UXB_CLI_REGISTRY_ADIM41_BI__
#define __UXB_CLI_REGISTRY_ADIM41_BI__

Type UXBCliOptionAdim41
    longName       As String
    shortName      As String
    statusText     As String
    layerText      As String
    expectedExt    As String
    examplePath    As String
    vscodeUse      As String
    validationText As String
    isRemoved      As Integer
    needsValue     As Integer
    producesFile   As Integer
End Type

Private Function UXBCliOptionNeedsValueAdim41(ByRef optName As String) As Integer
    Dim u As String = LCase(Trim(optName))
    If Right(u, 4) = "-out" Then Return 1
    If InStr(u, "json-out") > 0 Then Return 1
    Select Case u
    Case "--target", "--stop-after", "--diag-format", "--error-limit", "--codegen-source", "--x64-mode", "--interpreter-backend", "--pp", "--preprocessor", "--artifact-root", "--out-root", "--run-id", "--extfp-runtime-dir", "--console-mode", "--message-lang", "--language", "--source", "-s", "--error-log-out", "--error-language-file", "-elo", "-elf", "--virtual", "--max-steps", "--task-workers"
        Return 1
    End Select
    Return 0
End Function

Private Function UXBCliOptionProducesFileAdim41(ByRef optName As String) As Integer
    Dim u As String = LCase(Trim(optName))
    If Right(u, 4) = "-out" Then Return 1
    If InStr(u, "json-out") > 0 Then Return 1
    If u = "--trace-json" Then Return 1
    Return 0
End Function

Private Function UXBCliRemovedTurkishAliasAdim41(ByRef optName As String, ByRef canonicalOut As String) As Integer
    canonicalOut = ""
    ' ADIM44: Turkish aliases are removed; keep strict canonical flags only.
    Return 0
End Function

Private Function UXBCliRegistryCountAdim41() As Integer
    Return 173
End Function

