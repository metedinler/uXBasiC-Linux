Function UXBCliShortToLongAdim41(ByRef shortName As String) As String
    Dim items() As UXBCliOptionAdim41
    UXBCliRegistryFillAdim41 items()
    Dim i As Integer
    For i = LBound(items) To UBound(items)
        If LCase(items(i).shortName) = LCase(Trim(shortName)) Then Return items(i).longName
    Next i
    Return ""
End Function

Function UXBCliLongKnownAdim41(ByRef longName As String) As Integer
    Dim items() As UXBCliOptionAdim41
    UXBCliRegistryFillAdim41 items()
    Dim i As Integer
    For i = LBound(items) To UBound(items)
        If LCase(items(i).longName) = LCase(Trim(longName)) Then Return 1
    Next i
    Return 0
End Function

Function UXBCliExpectedExtAdim41(ByRef longName As String) As String
    Dim items() As UXBCliOptionAdim41
    UXBCliRegistryFillAdim41 items()
    Dim i As Integer
    For i = LBound(items) To UBound(items)
        If LCase(items(i).longName) = LCase(Trim(longName)) Then Return items(i).expectedExt
    Next i
    Return ""
End Function

