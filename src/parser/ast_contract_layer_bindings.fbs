' uXBasic AST contract layer binding policy.
' Step 2 completion: explicit, non-empty binding decisions for semantic/type/layout/interpreter/MIR/backend layers.
#ifndef UXBASIC_AST_CONTRACT_LAYER_BINDINGS_FBS
#define UXBASIC_AST_CONTRACT_LAYER_BINDINGS_FBS

#include once "ast_node_kinds.fbs"
#include once "../common/string_memo.fbs"

' The node-kind predicates below are pure functions of the kind text but each one upper-cases,
' trims and runs long string SELECTs / InStr scans; the semantic and MIR passes ask them for
' every AST node several times. Each public predicate is memoized (string_memo.fbs); the
' original bodies live on as ...Uncached.
Declare Function UXBAstContractIsCompileTimeNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsCompileTimeNode As UXBStringMemo
Declare Function UXBAstContractIsExpressionNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsExpressionNode As UXBStringMemo
Declare Function UXBAstContractIsTypeOrObjectNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsTypeOrObjectNode As UXBStringMemo
Declare Function UXBAstContractIsLayoutNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsLayoutNode As UXBStringMemo
Declare Function UXBAstContractIsFileNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsFileNode As UXBStringMemo
Declare Function UXBAstContractIsMemoryNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsMemoryNode As UXBStringMemo
Declare Function UXBAstContractIsControlNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsControlNode As UXBStringMemo
Declare Function UXBAstContractIsErrorNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsErrorNode As UXBStringMemo
Declare Function UXBAstContractIsRuntimeServiceNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsRuntimeServiceNode As UXBStringMemo
Declare Function UXBAstContractIsNativeOnlyNode(ByRef nodeName As String) As Integer
Dim Shared gUxbMemo_UXBAstContractIsNativeOnlyNode As UXBStringMemo

Private Function UXBAstContractBindingU(ByRef textIn As String) As String
    Return UCase(Trim(textIn))
End Function

Private Function UXBAstContractBindingHas(ByRef haystack As String, ByRef needle As String) As Integer
    Return IIf(InStr(UXBAstContractBindingU(haystack), UXBAstContractBindingU(needle)) > 0, 1, 0)
End Function

Private Function UXBAstContractIsCompileTimeNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_ALIAS_STMT, ASTK_ALIAS_TARGET, ASTK_IMPORT_STMT, ASTK_INCLUDE_STMT, ASTK_USING_STMT, ASTK_USING_ITEM, ASTK_MODULE_STMT, ASTK_NAMESPACE_STMT, ASTK_MAIN_STMT
        Return 1
    Case ASTK_CONST_DECL, ASTK_CONST_STMT, ASTK_DECLARE_FUNCTION_STMT, ASTK_DECLARE_SUB_STMT, ASTK_DEFTYPE_STMT
        Return 1
    Case ASTK_TYPE_REF, ASTK_RETURN_TYPE, ASTK_PARAM_DECL, ASTK_DIM_BOUNDS, ASTK_CLASS_ARRAY_SHAPE, ASTK_CLASS_ARRAY_RUNTIME
        Return 1
    End Select
    If UXBAstContractBindingHas(n, "_REF") <> 0 Then Return 1
    If UXBAstContractBindingHas(n, "_FLAG") <> 0 Then Return 1
    If UXBAstContractBindingHas(n, "_ITEM") <> 0 Then Return 1
    Return 0
End Function

Private Function UXBAstContractIsExpressionNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_IDENTIFIER, ASTK_NUMBER, ASTK_STRING, ASTK_BOOLEAN, ASTK_BINARY, ASTK_UNARY, ASTK_TERNARY_EXPR, ASTK_CALL_EXPR, ASTK_FIELD_EXPR, ASTK_MEMBER_EXPR, ASTK_INDEX_EXPR, ASTK_CAST_EXPR, ASTK_SIZEOF_EXPR, ASTK_NEW_EXPR, ASTK_RANGE_EXPR, ASTK_INCDEC_EXPR, ASTK_INIT_EXPR, ASTK_PROMPT_EXPR, ASTK_KEYWORD_REF
        Return 1
    End Select
    If UXBAstContractBindingHas(n, "_EXPR") <> 0 Then Return 1
    Return 0
End Function

Private Function UXBAstContractIsTypeOrObjectNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractBindingHas(n, "CLASS_") <> 0 Then Return 1
    If UXBAstContractBindingHas(n, "INTERFACE_") <> 0 Then Return 1
    If UXBAstContractBindingHas(n, "TYPE_") <> 0 Then Return 1
    Select Case n
    Case ASTK_CLASS_STMT, ASTK_INTERFACE_STMT, ASTK_TYPE_STMT, ASTK_NEW_EXPR, ASTK_SPAWN_EXPR, ASTK_FIELD_EXPR, ASTK_MEMBER_EXPR, ASTK_INDEX_EXPR
        Return 1
    End Select
    Return 0
End Function

Private Function UXBAstContractIsLayoutNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_TYPE_STMT, ASTK_TYPE_FIELD, ASTK_CLASS_STMT, ASTK_CLASS_FIELD, ASTK_CLASS_PROPERTY_DECL, ASTK_CLASS_METHOD_DECL, ASTK_CLASS_CONSTRUCTOR_DECL, ASTK_CLASS_DESTRUCTOR_DECL, ASTK_CLASS_OPERATOR_DECL, ASTK_INTERFACE_STMT, ASTK_INTERFACE_METHOD_DECL, ASTK_DIM_DECL, ASTK_REDIM_DECL, ASTK_DIM_STMT, ASTK_REDIM_STMT, ASTK_FIELD_EXPR, ASTK_MEMBER_EXPR, ASTK_INDEX_EXPR, ASTK_NEW_EXPR
        Return 1
    End Select
    Return 0
End Function

Private Function UXBAstContractIsFileNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_OPEN_STMT, ASTK_CLOSE_STMT, ASTK_GET_STMT, ASTK_PUT_STMT, ASTK_SEEK_STMT, ASTK_INPUT_FILE_STMT, ASTK_INPUTF_STMT
        Return 1
    End Select
    Return 0
End Function

Private Function UXBAstContractIsMemoryNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractBindingHas(n, "POKE") <> 0 Then Return 1
    If UXBAstContractBindingHas(n, "MEMCOPY") <> 0 Then Return 1
    If UXBAstContractBindingHas(n, "MEMFILL") <> 0 Then Return 1
    If n = ASTK_SETNEWOFFSET_STMT Then Return 1
    Return 0
End Function

Private Function UXBAstContractIsControlNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    If n = ASTK_CASE_RANGE_VALUE Then Return 1
    Select Case n
    Case ASTK_IF_STMT, ASTK_ELSEIF_PART, ASTK_ELSE_PART, ASTK_SELECT_STMT, ASTK_CASE_BLOCK, ASTK_CASE_ELSE, ASTK_CASE_IS_VALUE, ASTK_FOR_STMT, ASTK_FOR_EACH_STMT, ASTK_EACH_ITEMS, ASTK_EACH_BODY, ASTK_DO_STMT, ASTK_DO_EACH_STMT, ASTK_EXIT_STMT, ASTK_CONTINUE_STMT, ASTK_RETURN_STMT, ASTK_GOTO_STMT, ASTK_GOSUB_STMT, ASTK_LABEL_STMT, ASTK_END_STMT
        Return 1
    End Select
    Return 0
End Function

Private Function UXBAstContractIsErrorNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_TRY_STMT, ASTK_TRY_BODY, ASTK_CATCH_PART, ASTK_FINALLY_PART, ASTK_THROW_STMT, ASTK_ASSERT_STMT
        Return 1
    End Select
    Return 0
End Function

Private Function UXBAstContractIsRuntimeServiceNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_PRINT_STMT, ASTK_PRINT_ITEM, ASTK_INPUT_STMT, ASTK_LOCATE_STMT, ASTK_COLOR_STMT, ASTK_CLS_STMT, ASTK_RANDOMIZE_STMT, ASTK_EVENT_STMT, ASTK_SLOT_STMT, ASTK_SLOT_TABLE_STMT, ASTK_SLOT_BIND_ENTRY, ASTK_SLOT_HEADER_ARGS, ASTK_SLOT_CONTROL_STMT, ASTK_TRIGGER_STMT, ASTK_PIPE_STMT, ASTK_THREAD_STMT, ASTK_PARALEL_STMT
        Return 1
    End Select
    If UXBAstContractIsFileNode(n) <> 0 Then Return 1
    If UXBAstContractIsMemoryNode(n) <> 0 Then Return 1
    Return 0
End Function

Private Function UXBAstContractIsNativeOnlyNodeUncached(ByRef nodeName As String) As Integer
    Dim n As String = UXBAstContractBindingU(nodeName)
    Select Case n
    Case ASTK_INLINE_STMT
        Return 1
    End Select
    Return 0
End Function

Function UXBAstContractSemanticHandlerForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "N/A"
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return "SemStep2ExprContract"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "SemStep2TypeObjectContract"
    If UXBAstContractIsControlNode(n) <> 0 Then Return "SemStep2ControlContract"
    If UXBAstContractIsErrorNode(n) <> 0 Then Return "SemStep2ErrorContract"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "SemStep2RuntimeContract"
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return "SemStep2NativeContract"
    Return "SemStep2StatementContract"
End Function

Function UXBAstContractTypeBindingHandlerForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "N/A"
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return "TypeBindingStep2ExprContract"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "TypeBindingStep2ObjectContract"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "TypeBindingStep2RuntimeContract"
    If UXBAstContractIsControlNode(n) <> 0 Or UXBAstContractIsErrorNode(n) <> 0 Then Return "TypeBindingStep2FlowContract"
    Return "TypeBindingStep2StatementContract"
End Function

Function UXBAstContractLayoutHandlerForNode(ByRef nodeName As String) As String
    If UXBAstContractIsLayoutNode(nodeName) <> 0 Then Return "LayoutStep2Contract"
    Return "N/A"
End Function

Function UXBAstContractAstInterpreterHandlerForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return "AstExecStep2NativeBlocked"
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return "AstExecStep2ExpressionDispatch"
    If UXBAstContractIsControlNode(n) <> 0 Then Return "AstExecStep2ControlDispatch"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "AstExecStep2RuntimeDispatch"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "AstExecStep2ObjectDispatch"
    Return "AstExecStep2StatementDispatch"
End Function

Function UXBAstContractMIRLoweringHandlerForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return "MIRLowerStep2NativeOnly"
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return "MIRLowerStep2ExpressionDecision"
    If UXBAstContractIsControlNode(n) <> 0 Then Return "MIRLowerStep2ControlDecision"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "MIRLowerStep2RuntimeDecision"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "MIRLowerStep2ObjectDecision"
    Return "MIRLowerStep2StatementDecision"
End Function

Function UXBAstContractMIRVerifyRuleForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return "verify_fail_closed"
    If UXBAstContractIsExpressionNode(n) <> 0 Then Return "verify_expr"
    If UXBAstContractIsControlNode(n) <> 0 Then Return "verify_control"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "verify_runtime"
    If UXBAstContractIsFileNode(n) <> 0 Then Return "verify_file"
    If UXBAstContractIsMemoryNode(n) <> 0 Then Return "verify_memory"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "verify_object"
    Return "verify_statement"
End Function

Function UXBAstContractX64AstHandlerForNode(ByRef nodeName As String) As String
    If UXBAstContractIsCompileTimeNode(nodeName) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(nodeName) <> 0 Then Return "X64AstNativeOnlyDispatch"
    Return "X64AstStep2Dispatch"
End Function

Function UXBAstContractX64MirHandlerForNode(ByRef nodeName As String) As String
    If UXBAstContractIsCompileTimeNode(nodeName) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(nodeName) <> 0 Then Return "X64MirNativeOnlyDispatch"
    Return "X64MirStep2Dispatch"
End Function

Function UXBAstContractJsHandlerForNode(ByRef nodeName As String) As String
    If UXBAstContractIsCompileTimeNode(nodeName) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(nodeName) <> 0 Then Return "NATIVE_ONLY"
    Return "JsStep2Dispatch"
End Function

Function UXBAstContractWasmWatHandlerForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "N/A"
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return "WASM_UNSUPPORTED"
    If UXBAstContractIsFileNode(n) <> 0 Then Return "RUNTIME_CALL"
    If UXBAstContractIsRuntimeServiceNode(n) <> 0 Then Return "RUNTIME_CALL"
    If UXBAstContractIsExpressionNode(n) <> 0 Or UXBAstContractIsControlNode(n) <> 0 Then Return "WasmWatStep2Dispatch"
    If UXBAstContractIsTypeOrObjectNode(n) <> 0 Then Return "WASM_UNSUPPORTED"
    Return "WASM_UNSUPPORTED"
End Function

Function UXBAstContractFinalDecisionForNode(ByRef nodeName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then Return "COMPILE_TIME_ONLY"
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then Return "NATIVE_ONLY"
    Return "IMPLEMENTED"
End Function

Function UXBAstContractLayerStatusForNode(ByRef nodeName As String, ByRef layerName As String) As String
    Dim n As String = UXBAstContractBindingU(nodeName)
    Dim layerU As String = UXBAstContractBindingU(layerName)
    If UXBAstContractIsCompileTimeNode(n) <> 0 Then
        If layerU = "LAYOUT" Then Return "NOT_APPLICABLE"
        Return "COMPILE_TIME_ONLY"
    End If
    If UXBAstContractIsNativeOnlyNode(n) <> 0 Then
        If layerU = "LAYOUT" Then Return "NOT_APPLICABLE"
        If layerU = "JS" Or layerU = "WASM_WAT" Then Return "NATIVE_ONLY"
        Return "NATIVE_ONLY"
    End If
    Select Case layerU
    Case "LAYOUT"
        Return IIf(UXBAstContractIsLayoutNode(n) <> 0, "IMPLEMENTED", "NOT_APPLICABLE")
    Case "WASM_WAT"
        Dim wh As String = UXBAstContractWasmWatHandlerForNode(n)
        If wh = "RUNTIME_CALL" Then Return "RUNTIME_CALL"
        If wh = "WASM_UNSUPPORTED" Then Return "WASM_UNSUPPORTED"
        Return "IMPLEMENTED"
    Case "TYPE_BINDING", "SEMANTIC", "AST_INTERPRETER", "MIR", "MIR_VERIFY", "X64_AST", "X64_MIR", "JS"
        Return "IMPLEMENTED"
    End Select
    Return "NOT_APPLICABLE"
End Function

Function UXBAstContractTargetSupportJson(ByRef nodeName As String) As String
    Return "{" & _
        """semantic"":""" & UXBAstContractLayerStatusForNode(nodeName, "SEMANTIC") & """," & _
        """type_binding"":""" & UXBAstContractLayerStatusForNode(nodeName, "TYPE_BINDING") & """," & _
        """layout"":""" & UXBAstContractLayerStatusForNode(nodeName, "LAYOUT") & """," & _
        """ast_interpreter"":""" & UXBAstContractLayerStatusForNode(nodeName, "AST_INTERPRETER") & """," & _
        """mir"":""" & UXBAstContractLayerStatusForNode(nodeName, "MIR") & """," & _
        """mir_verify"":""" & UXBAstContractLayerStatusForNode(nodeName, "MIR_VERIFY") & """," & _
        """x64_ast"":""" & UXBAstContractLayerStatusForNode(nodeName, "X64_AST") & """," & _
        """x64_mir"":""" & UXBAstContractLayerStatusForNode(nodeName, "X64_MIR") & """," & _
        """js"":""" & UXBAstContractLayerStatusForNode(nodeName, "JS") & """," & _
        """wasm"":""" & UXBAstContractLayerStatusForNode(nodeName, "WASM_WAT") & """}"
End Function


Function UXBAstContractIsCompileTimeNode(ByRef nodeName As String) As Integer
    Dim cached As String
    If UXBStringMemoGet(gUxbMemo_UXBAstContractIsCompileTimeNode, nodeName, cached) <> 0 Then Return IIf(cached = "1", 1, 0)
    Dim r As Integer = UXBAstContractIsCompileTimeNodeUncached(nodeName)
    UXBStringMemoPut gUxbMemo_UXBAstContractIsCompileTimeNode, nodeName, IIf(r <> 0, "1", "0")
    Return r
End Function

Function UXBAstContractIsExpressionNode(ByRef nodeName As String) As Integer
    Dim cached As String
    If UXBStringMemoGet(gUxbMemo_UXBAstContractIsExpressionNode, nodeName, cached) <> 0 Then Return IIf(cached = "1", 1, 0)
    Dim r As Integer = UXBAstContractIsExpressionNodeUncached(nodeName)
    UXBStringMemoPut gUxbMemo_UXBAstContractIsExpressionNode, nodeName, IIf(r <> 0, "1", "0")
    Return r
End Function

