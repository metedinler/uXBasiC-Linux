    Dim cached As String
    If UXBStringMemoGet(gUxbMemo_UXBAstContractIsTypeOrObjectNode, nodeName, cached) <> 0 Then Return IIf(cached = "1", 1, 0)
    Dim r As Integer = UXBAstContractIsTypeOrObjectNodeUncached(nodeName)
    UXBStringMemoPut gUxbMemo_UXBAstContractIsTypeOrObjectNode, nodeName, IIf(r <> 0, "1", "0")
