#include once "ast.fbs"
#include once "ast_contract.fbs"

' Open-addressing hash slot indexing ALIAS_STMT AST nodes by alias name so
' repeated call-site resolution doesn't need to rescan the whole program AST.
' headIdx/tailIdx point into ParseState.aliasChainNext; entries sharing a name
' (redeclared aliases) are chained in original AST-scan order so the existing
' "closest preceding declaration" tie-break logic still sees them in that order.
Type ParseAliasHashSlot
    used As Integer
    key As String
    headIdx As Integer
    tailIdx As Integer
End Type

Type ParseState
    lx As LexerState
    cursorIndex As Integer
    parseDebug As Integer
    trustedGeneratedInput As Integer
    lastError As String
    parseErrorCount As Integer
    parseErrors(Any) As String
    ast As ASTPool
    rootNode As Integer
    namespaceDepth As Integer
    moduleDepth As Integer
    mainDepth As Integer
    taskScopeNames(Any) As String
    taskScopeDepth As Integer
    aliasIndexBuilt As Integer
    aliasIndexAstCount As Integer
    aliasIndexCap As Integer
    aliasIndexSlots(Any) As ParseAliasHashSlot
    aliasChainNext(Any) As Integer
End Type

Declare Function ParseRelation(ByRef ps As ParseState) As Integer
Declare Function ParseSimpleStatement(ByRef ps As ParseState) As Integer
