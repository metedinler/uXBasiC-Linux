#ifndef UXB_PARSER_ADIM08_SURFACE_ROUTES_FBS
#define UXB_PARSER_ADIM08_SURFACE_ROUTES_FBS

Enum UXBParserSurfaceRoute
    UXB_PARSE_ROUTE_UNKNOWN = 0
    UXB_PARSE_ROUTE_STATEMENT
    UXB_PARSE_ROUTE_EXPRESSION
    UXB_PARSE_ROUTE_DECLARATION
    UXB_PARSE_ROUTE_TYPE
    UXB_PARSE_ROUTE_META_ONLY
    UXB_PARSE_ROUTE_DIAGNOSTIC_ONLY
End Enum

Function UXBParserNormalizeSurfaceName(ByRef rawText As String) As String
    Return UCase(Trim(rawText))
End Function

Function UXBParserRouteName(ByVal routeValue As Integer) As String
    Select Case routeValue
    Case UXB_PARSE_ROUTE_STATEMENT: Return "STATEMENT"
    Case UXB_PARSE_ROUTE_EXPRESSION: Return "EXPRESSION"
    Case UXB_PARSE_ROUTE_DECLARATION: Return "DECLARATION"
    Case UXB_PARSE_ROUTE_TYPE: Return "TYPE"
    Case UXB_PARSE_ROUTE_META_ONLY: Return "META_ONLY"
    Case UXB_PARSE_ROUTE_DIAGNOSTIC_ONLY: Return "DIAGNOSTIC_ONLY"
    End Select
    Return "UNKNOWN"
End Function

Function UXBParserSurfaceRouteForKeyword(ByRef keywordText As String) As Integer
    Dim k As String
    k = UXBParserNormalizeSurfaceName(keywordText)

    Select Case k
    Case "PRINT", "INPUT", "INPUTF", "OPEN", "CLOSE", "GET", "PUT", "SEEK", "LOCATE", "COLOR", "CLS", "SHELL"
        Return UXB_PARSE_ROUTE_STATEMENT
    Case "IF", "SELECT", "FOR", "DO", "GOTO", "GOSUB", "RETURN", "EXIT", "CONTINUE", "END", "TRY", "THROW", "ASSERT"
        Return UXB_PARSE_ROUTE_STATEMENT
    Case "CALL", "INLINE", "DELETE", "INC", "DEC", "RANDOMIZE", "POKE", "POKEB", "POKEW", "POKED", "POKEQ", "POKES"
        Return UXB_PARSE_ROUTE_STATEMENT
    Case "MEMCOPYB", "MEMCOPYW", "MEMCOPYD", "MEMCOPYQ", "MEMFILLB", "MEMFILLW", "MEMFILLD", "MEMFILLQ", "SETNEWOFFSET"
        Return UXB_PARSE_ROUTE_STATEMENT
    Case "EVENT", "THREAD", "PARALEL", "PARALEL", "PIPE", "SLOT", "ON", "OFF", "TRIGGER"
        Return UXB_PARSE_ROUTE_STATEMENT
    Case "DIM", "REDIM", "CONST", "DECLARE", "SUB", "FUNCTION", "TYPE", "STRUCT", "UNION", "CLASS", "INTERFACE", "NAMESPACE", "MODULE", "MAIN", "USING", "ALIAS", "IMPORT", "INCLUDE"
        Return UXB_PARSE_ROUTE_DECLARATION
    Case "DEFINT", "DEFLNG", "DEFSNG", "DEFDBL", "DEFEXT", "DEFSTR", "DEFBYT", "SETSTRINGSIZE"
        Return UXB_PARSE_ROUTE_DECLARATION
    Case "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "F80", "F128", "BIGF", "BIGD", "BALL", "STRING", "BOOLEAN", "PTR", "OBJECT"
        Return UXB_PARSE_ROUTE_TYPE
    Case "AND", "OR", "XOR", "NOT", "MOD", "NEW", "THIS", "ME", "BASE"
        Return UXB_PARSE_ROUTE_EXPRESSION
    End Select

    Return UXB_PARSE_ROUTE_UNKNOWN
End Function

Function UXBParserExpectedAstKindForSurface(ByRef surfaceText As String) As String
    Dim k As String
    k = UXBParserNormalizeSurfaceName(surfaceText)

    Select Case k
    Case "CALL": Return "CALL_STMT"
    Case "CALL_DLL": Return "CALL_DLL_STMT"
    Case "CALL_API": Return "CALL_API_STMT"
    Case "IMPORT": Return "IMPORT_STMT"
    Case "INCLUDE": Return "INCLUDE_STMT"
    Case "INLINE": Return "INLINE_STMT"
    Case "SHELL": Return "SHELL_STMT"
    Case "CLASS": Return "CLASS_STMT"
    Case "TYPE", "STRUCT", "UNION": Return "TYPE_STMT"
    Case "FUNCTION": Return "FUNCTION_STMT"
    Case "SUB": Return "SUB_STMT"
    Case "PROPERTY": Return "CLASS_PROPERTY_DECL"
    Case "METHOD": Return "CLASS_METHOD_DECL"
    Case "OPERATOR": Return "CLASS_OPERATOR_DECL"
    Case "EVENT": Return "EVENT_STMT"
    Case "THREAD": Return "THREAD_STMT"
    Case "PARALEL", "PARALEL": Return "PARALEL_STMT"
    Case "PIPE": Return "PIPE_STMT"
    Case "SLOT": Return "SLOT_STMT"
    Case "TRIGGER": Return "TRIGGER_STMT"
    End Select

    Dim routeValue As Integer
    routeValue = UXBParserSurfaceRouteForKeyword(k)
    If routeValue = UXB_PARSE_ROUTE_STATEMENT Then Return k & "_STMT"
    If routeValue = UXB_PARSE_ROUTE_DECLARATION Then Return k & "_STMT"
    If routeValue = UXB_PARSE_ROUTE_EXPRESSION Then Return "CALL_EXPR"
    If routeValue = UXB_PARSE_ROUTE_TYPE Then Return "TYPE_REF"

    Return ""
End Function

#endif

