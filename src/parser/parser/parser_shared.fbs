#include once "../../common/array_memory_ref.fbs"
#include once "../../semantic/library_type_manifest_io.fbs"

Private Function CurToken(ByRef ps As ParseState) As Token
    Return TokenListAt(ps.lx.tokens, ps.cursorIndex)
End Function

'' ParserLog removed: use ParserDiag -> UxbDebug instead

Private Sub ParserDiag(ByRef ps As ParseState, ByRef msgText As String)
    If ps.parseDebug <> 0 Then
        ' Keep parser debug hook local to avoid cross-module dependency.
        'Print "parser: " & msgText
    End If
End Sub

Private Function LookToken(ByRef ps As ParseState, ByVal look As Integer) As Token
    If look < 0 Then look = 0
    Return TokenListAt(ps.lx.tokens, ps.cursorIndex + look)
End Function

Private Sub AdvanceTok(ByRef ps As ParseState)
    If ps.cursorIndex < ps.lx.tokens.count Then
        ps.cursorIndex += 1
    End If
End Sub

Private Function MatchOp(ByRef ps As ParseState, ByRef opText As String) As Integer
    Dim tk As Token
    tk = CurToken(ps)
    If tk.kind = "OP" And tk.lexeme = opText Then
        AdvanceTok ps
        Return 1
    End If
    Return 0
End Function

Private Function IsKw(ByRef ps As ParseState, ByRef kw As String) As Integer
    Dim tk As Token
    tk = CurToken(ps)
    Return tk.kind = "KEYWORD" And UCase(tk.lexeme) = UCase(kw)
End Function

Private Function MatchKeyword(ByRef ps As ParseState, ByRef kw As String) As Integer
    If IsKw(ps, kw) Then
        AdvanceTok ps
        Return 1
    End If
    Return 0
End Function

' S-128 (Mete's decision 2026-09-24): a uXBasic keyword -- statement and control words, type names and
' builtin-function names, i.e. the lexer's IsKeyword registry -- cannot name a variable, constant,
' parameter, loop/catch variable or a top-level SUB/FUNCTION. The rule is enforced here, in the shared
' parser, so AST, canonical-MIR, native x64, legacy x64, JS and WASM all reject it with the same
' message before any engine sees the program. Member names reached through a dot (fields, methods,
' namespace routines: `obj.then`, `uxsqlite.Open`) stay free -- the lexer already reads a word after
' "." as a plain identifier.
Private Function ParserTokenIsReservedName(ByRef tk As Token) As Integer
    If tk.kind <> "IDENT" And tk.kind <> "KEYWORD" Then Return 0
    Return IsKeyword(tk.lexeme)
End Function

Private Sub ParserSetReservedNameError(ByRef ps As ParseState, ByRef tk As Token, ByRef ownerLabel As String, ByRef whatText As String)
    ps.lastError = ownerLabel & ": '" & LCase(Trim(tk.lexeme)) & "' is a reserved uXBasic keyword and cannot be used as a " & whatText & " name; choose another name"
End Sub

Private Function IsAssignOrIncDecOp(ByRef tk As Token) As Integer
    If tk.kind <> "OP" Then Return 0
    Select Case tk.lexeme
    Case "=", "+=", "-=", "*=", "/=", "\=", "=+", "=-", "++", "--"
        Return 1
    End Select
    Return 0
End Function

Private Function IsLegacyInlineName(ByRef nameText As String) As Integer
    Dim u As String
    u = UCase(nameText)
    Return u = "_ASM" Or u = "ASM_SUB" Or u = "ASM_FUNCTION"
End Function

Private Function IsDisabledUnderscoreCommand(ByRef identText As String, ByRef nextTok As Token) As Integer
    If Left(identText, 1) <> "_" Then Return 0
    If IsAssignOrIncDecOp(nextTok) Then Return 0
    Return 1
End Function

Private Function IsValidTimerUnit(ByRef unitText As String) As Integer
    Dim u As String
    u = LCase(unitText)

    Select Case u
    Case "ns", "us", "ms", "s", "min", "h", "day", "year"
        Return 1
    End Select

    Return 0
End Function

Dim Shared gDeclaredTypeNames() As String
Dim Shared gDeclaredTypeCount As Integer
Dim Shared gReferencedTypeNames() As String
Dim Shared gReferencedTypeCount As Integer

Private Sub AddUniqueTypeName(typeNames() As String, ByRef typeCount As Integer, ByRef rawName As String)
    Dim normalizedName As String
    normalizedName = UCase(Trim(rawName))
    If normalizedName = "" Then Exit Sub

    Dim i As Integer
    For i = 0 To typeCount - 1
        If typeNames(i) = normalizedName Then Exit Sub
    Next i

    If typeCount = 0 Then
        ReDim typeNames(0)
    Else
        ReDim Preserve typeNames(typeCount)
    End If

    typeNames(typeCount) = normalizedName
    typeCount += 1
End Sub

Private Function IsRegisteredTypeName(typeNames() As String, ByVal typeCount As Integer, ByRef rawName As String) As Integer
    Dim normalizedName As String
    normalizedName = UCase(Trim(rawName))
    If normalizedName = "" Then Return 0

    Dim i As Integer
    For i = 0 To typeCount - 1
        If typeNames(i) = normalizedName Then Return 1
    Next i

    Return 0
End Function

Private Function IsBuiltinTypeKeyword(ByRef typeName As String) As Integer
    Select Case UCase(typeName)
    Case "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "F80", "F128", "BIGF", "BIGD", "BALL", "BIGI", "BIGINT", "EXTENDED", "EXT", "BOOLEAN", "STRING", "OBJECT", "ARRAY", "LIST", "DICT", "SET", "PTR"
        Return 1
    Case "TASK", "TASKGROUP"
        Return 1
    Case "MUTEX"
        ' S-146 Model D (Mete 2026-09-26): dis kaynak / programci tanimli kritik bolge kilidi.
        Return 1
    End Select

    Return 0
End Function

Private Function CanonicalTypeNameForParser(ByRef rawTypeName As String) As String
    Dim t As String
    t = UCase(Trim(rawTypeName))
    ' ADIM43: parser canonical type strips precision suffix in BIGF(256)/BIGD(80)/BALL(256)
    Dim precisionPos43 As Integer
    precisionPos43 = InStr(t, "(")
    If precisionPos43 > 1 Then t = Left(t, precisionPos43 - 1)

    Select Case t
    Case "F80", "EXTENDED", "EXT"
        Return "F80"
    Case "F128", "FLOAT128", "QUAD"
        Return "F128"
    Case "BIGF", "BIGFLOAT"
        Return "BIGF"
    Case "BIGD", "BIGDECIMAL"
        Return "BIGD"
    Case "BALL"
        Return "BALL"
    Case "BIGI", "BIGINT", "BIGINTEGER"
        Return "BIGINT"
    Case "DOUBLE", "DBL", "DBLE"
        Return "F64"
    Case "SINGLE", "SNG", "SNGLE"
        Return "F32"
    ' Every long spelling the rest of the compiler accepts must fold to its
    ' canonical name here, or a declaration using it is rejected outright as an
    ' unknown type while the same name works everywhere downstream.  Widths
    ' follow type_binding.fbs / type_rules.fbs: LONG is I32, LONGINT is I64.
    Case "INTEGER", "INT", "LONG"
        Return "I32"
    Case "UINTEGER", "UINT", "ULONG"
        Return "U32"
    Case "BYTE", "SBYTE"
        Return "I8"
    Case "UBYTE"
        Return "U8"
    Case "SHORT"
        Return "I16"
    Case "USHORT"
        Return "U16"
    Case "LONGINT"
        Return "I64"
    Case "ULONGINT"
        Return "U64"
    End Select

    Return t
End Function

Private Sub ResetTypeValidationState()
    gDeclaredTypeCount = 0
    gReferencedTypeCount = 0
    Dim referenceType As UXBLibraryTypeContract
    UXBLibraryTypeMakeRationalReference referenceType
    AddUniqueTypeName gDeclaredTypeNames(), gDeclaredTypeCount, referenceType.typeName
End Sub

Private Sub RegisterDeclaredTypeName(ByRef typeName As String)
    AddUniqueTypeName gDeclaredTypeNames(), gDeclaredTypeCount, typeName
End Sub

' Library type manifests are source-level declarations, but fields and nested
' declarations can be validated before the statement node is fully consumed.
' Register every readable manifest up front so all parser paths see the same
' user type set. Invalid manifests remain on the normal LIBTYPE error path.
Private Sub PreRegisterLibraryTypeManifestNames(ByRef lx As LexerState)
    Dim i As Integer
    For i = 0 To lx.tokens.count - 2
        Dim manifestKeyword As Token
        manifestKeyword = TokenListAt(lx.tokens, i)
        If UCase(Trim(manifestKeyword.lexeme)) <> "LIBTYPE" Then Continue For

        Dim pathTok As Token
        pathTok = TokenListAt(lx.tokens, i + 1)
        If pathTok.kind <> "STRING" Then Continue For

        Dim manifestType As UXBLibraryTypeContract
        Dim manifestErr As String
        manifestErr = ""
        If UXBLibraryTypeReadManifestForSource(pathTok.lexeme, manifestKeyword.sourceFile, manifestType, manifestErr) <> 0 Then
            RegisterDeclaredTypeName manifestType.typeName
        End If
    Next i
End Sub

Private Function ValidateTypeToken(ByRef ps As ParseState, ByRef tk As Token) As Integer
    Dim canonical As String
    canonical = CanonicalTypeNameForParser(tk.lexeme)

    If tk.kind = "KEYWORD" Then
        If IsBuiltinTypeKeyword(canonical) Then Return 1
        ps.lastError = "invalid type name: " & tk.lexeme
        Return 0
    End If

    If tk.kind = "IDENT" Then
        If IsBuiltinTypeKeyword(canonical) Then Return 1
        AddUniqueTypeName gReferencedTypeNames(), gReferencedTypeCount, tk.lexeme
        Return 1
    End If

    ps.lastError = "type expected"
    Return 0
End Function

Private Function ValidateTypeReferences(ByRef ps As ParseState) As Integer
    Dim i As Integer
    ParserDiag ps, "[PDBG] ValidateTypeReferences declared_count=" & Str(gDeclaredTypeCount) & " referenced_count=" & Str(gReferencedTypeCount)
    For i = 0 To gReferencedTypeCount - 1
        ParserDiag ps, "[PDBG] referenced type: " & gReferencedTypeNames(i)
        Dim refCanonical As String
        refCanonical = CanonicalTypeNameForParser(gReferencedTypeNames(i))
        If IsBuiltinTypeKeyword(refCanonical) <> 0 Then
            Continue For
        End If
        Dim refUp As String
        refUp = UCase(Trim(refCanonical))
        If refUp = "PTR" Or refUp = "POINTER" Or Left(refUp, 4) = "PTR(" Then
            Continue For
        End If
        If IsRegisteredTypeName(gDeclaredTypeNames(), gDeclaredTypeCount, gReferencedTypeNames(i)) = 0 Then
            ParserDiag ps, "[PDBG] missing referenced type: " & gReferencedTypeNames(i)
            ps.lastError = "unknown type: " & gReferencedTypeNames(i) & " [canonical=" & refCanonical & "]"
            Return 0
        End If
    Next i

    Return 1
End Function

Private Function ASTChildCount(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim count As Integer
    Dim ch As Integer

    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        count += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return count
End Function

Private Function ASTChildAt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal childPos As Integer) As Integer
    Dim i As Integer
    Dim ch As Integer

    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If i = childPos Then Return ch
        i += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return -1
End Function

Private Function ValidateTimerCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    Dim argc As Integer
    argc = ASTChildCount(ps, callNode)

    If argc = 0 Then Return 1

    If argc = 1 Then
        Dim unitArg As Integer
        unitArg = ASTChildAt(ps, callNode, 0)
        If unitArg = -1 Then Return 0
        If UCase(ps.ast.nodes(unitArg).kind) <> "STRING" Then
            ps.lastError = "TIMER(unit) expects string unit"
            Return 0
        End If
        If IsValidTimerUnit(ps.ast.nodes(unitArg).value) = 0 Then
            ps.lastError = "invalid TIMER unit"
            Return 0
        End If
        Return 1
    End If

    If argc = 3 Then
        Dim unitArg3 As Integer
        unitArg3 = ASTChildAt(ps, callNode, 2)
        If unitArg3 = -1 Then Return 0
        If UCase(ps.ast.nodes(unitArg3).kind) <> "STRING" Then
            ps.lastError = "TIMER(start,end,unit) expects string unit"
            Return 0
        End If
        If IsValidTimerUnit(ps.ast.nodes(unitArg3).value) = 0 Then
            ps.lastError = "invalid TIMER unit"
            Return 0
        End If
        Return 1
    End If

    ps.lastError = "TIMER expects 0, 1 or 3 arguments"
    Return 0
End Function

Private Function ValidateSingleArgCall(ByRef ps As ParseState, ByVal callNode As Integer, ByRef callName As String) As Integer
    Dim argc As Integer
    argc = ASTChildCount(ps, callNode)

    If argc <> 1 Then
        ps.lastError = callName & " expects exactly 1 argument"
        Return 0
    End If

    Return 1
End Function

Private Function ValidateFileInfoCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    Dim callName As String
    callName = UCase(ps.ast.nodes(callNode).value)

    Select Case callName
    Case "LOF", "EOF"
        Return ValidateSingleArgCall(ps, callNode, callName)
    End Select

    Return 1
End Function

Private Function ValidateArgCountInRange(ByRef ps As ParseState, ByVal callNode As Integer, ByRef callName As String, ByVal minArgs As Integer, ByVal maxArgs As Integer) As Integer
    Dim argc As Integer
    argc = ASTChildCount(ps, callNode)

    If argc < minArgs Or argc > maxArgs Then
        If minArgs = maxArgs Then
            ps.lastError = callName & " expects exactly " & Str(minArgs) & " argument(s)"
        Else
            ps.lastError = callName & " expects " & Str(minArgs) & " to " & Str(maxArgs) & " argument(s)"
        End If
        Return 0
    End If

    Return 1
End Function

Private Function IsTypeRefArgNode(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx = -1 Then Return 0

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)

    Select Case UCase(n.kind)
    Case "IDENT"
        Return 1
    Case "KEYWORD_REF"
        Return IsBuiltinTypeKeyword(n.value)
    End Select

    Return 0
End Function

Private Function ValidateSizeOfCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    If ValidateArgCountInRange(ps, callNode, "SIZEOF", 1, 1) = 0 Then Return 0

    Dim a0 As Integer
    a0 = ASTChildAt(ps, callNode, 0)
    If IsTypeRefArgNode(ps, a0) <> 0 Then Return 1
    ' PATCH4: SIZEOF(array) is a layout query over an addressable array.
    ' Semantic/layout validation performs the actual declaration lookup.
    If a0 <> -1 And UCase(Trim(ps.ast.nodes(a0).kind)) = "IDENT" Then Return 1
    ps.lastError = "SIZEOF expects a type name or array identifier"
    Return 0
End Function

Private Function ValidateOffsetOfCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    If ValidateArgCountInRange(ps, callNode, "OFFSETOF", 2, 2) = 0 Then Return 0

    Dim a0 As Integer
    Dim a1 As Integer
    a0 = ASTChildAt(ps, callNode, 0)
    a1 = ASTChildAt(ps, callNode, 1)

    If IsTypeRefArgNode(ps, a0) = 0 Then
        ps.lastError = "OFFSETOF expects a type name as first argument"
        Return 0
    End If

    If a1 = -1 Or UCase(ps.ast.nodes(a1).kind) <> "STRING" Then
        ps.lastError = "OFFSETOF expects a string path as second argument"
        Return 0
    End If

    If Len(Trim(ps.ast.nodes(a1).value)) = 0 Then
        ps.lastError = "OFFSETOF path cannot be empty"
        Return 0
    End If

    Return 1
End Function

Private Function ValidateVarPtrCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    If ValidateArgCountInRange(ps, callNode, "VARPTR", 1, 1) = 0 Then Return 0

    Dim a0 As Integer
    a0 = ASTChildAt(ps, callNode, 0)
    ' S-081: VARPTR(name) or VARPTR(array(index)) -- the second form is rewritten by
    ' the semantic pass into VARPTR(array) + (index - LBOUND) * stride.
    If a0 = -1 Then
        ps.lastError = "VARPTR expects an identifier argument"
        Return 0
    End If
    If UCase(ps.ast.nodes(a0).kind) <> "IDENT" And UCase(ps.ast.nodes(a0).kind) <> "CALL_EXPR" Then
        ps.lastError = "VARPTR expects an identifier or an array element argument"
        Return 0
    End If

    Return 1
End Function

Private Function ValidateSaddCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    If ValidateArgCountInRange(ps, callNode, "SADD", 1, 1) = 0 Then Return 0

    Dim a0 As Integer
    a0 = ASTChildAt(ps, callNode, 0)
    If a0 = -1 Then
        ps.lastError = "SADD expects one argument"
        Return 0
    End If

    Dim argKind As String
    argKind = UCase(ps.ast.nodes(a0).kind)
    If argKind <> "STRING" And argKind <> "IDENT" Then
        ps.lastError = "SADD expects a string literal or identifier argument"
        Return 0
    End If

    Return 1
End Function

Private Function ValidateLabelPtrCall(ByRef ps As ParseState, ByVal callNode As Integer, ByRef callName As String) As Integer
    If ValidateArgCountInRange(ps, callNode, callName, 1, 1) = 0 Then Return 0

    Dim a0 As Integer
    Dim k As String
    a0 = ASTChildAt(ps, callNode, 0)
    If a0 = -1 Then
        ps.lastError = callName & " expects an identifier argument"
        Return 0
    End If

    k = UCase(ps.ast.nodes(a0).kind)
    If k <> "IDENT" And k <> "KEYWORD_REF" Then
        ps.lastError = callName & " expects an identifier argument"
        Return 0
    End If

    If Len(Trim(ps.ast.nodes(a0).value)) = 0 Then
        ps.lastError = callName & " expects a non-empty identifier argument"
        Return 0
    End If

    Return 1
End Function

Private Function ValidateCoreIntrinsicCall(ByRef ps As ParseState, ByVal callNode As Integer) As Integer
    Dim callName As String
    callName = UCase(ps.ast.nodes(callNode).value)

    Select Case callName
    Case "SIZEOF"
        Return ValidateSizeOfCall(ps, callNode)
    Case "OFFSETOF"
        Return ValidateOffsetOfCall(ps, callNode)
    Case "LEN", "STR", "VAL", "ABS", "INT", "UCASE", "LCASE", "ASC", "CHR", "LTRIM", "RTRIM", "SPACE", "SGN", "SIN", "COS", "TAN", "ATN", "EXP", "LOG", "CINT", "CLNG", "CDBL", "CSNG", "FIX", "SQR"
        Return ValidateArgCountInRange(ps, callNode, callName, 1, 1)
    Case "SQRT"
        ' SQRT is a canonical alias of SQR (kept for BASIC-tradition compatibility);
        ' rewrite the call node so every downstream layer (semantic/MIR/codegen/interpreter)
        ' sees a plain SQR call and needs no separate handling.
        ps.ast.nodes(callNode).value = "SQR"
        Return ValidateArgCountInRange(ps, callNode, "SQR", 1, 1)
    Case "RND"
        Return ValidateArgCountInRange(ps, callNode, callName, 0, 1)
    Case "MID"
        Return ValidateArgCountInRange(ps, callNode, callName, 2, 3)
    Case "STRING"
        Return ValidateArgCountInRange(ps, callNode, callName, 2, 2)
    Case "INKEY"
        Return ValidateArgCountInRange(ps, callNode, callName, 1, 2)
    Case "GETKEY"
        Return ValidateArgCountInRange(ps, callNode, callName, 0, 0)
    Case "PEEK", "PEEKB", "PEEKW", "PEEKD", "PEEKQ"
        Return ValidateArgCountInRange(ps, callNode, callName, 1, 2)
    Case "PEEKS"
        Return ValidateArgCountInRange(ps, callNode, callName, 2, 3)
    Case "VARPTR"
        Return ValidateVarPtrCall(ps, callNode)
    Case "SADD"
        Return ValidateSaddCall(ps, callNode)
    Case "LPTR", "CODEPTR"
        Return ValidateLabelPtrCall(ps, callNode, callName)
    Case "INKEY_LEGACY"
        ps.lastError = "INKEY_LEGACY removed; use GETKEY or INKEY"
        Return 0
    End Select

    Return 1
End Function


Private Function ParserFindTokenOffsetByLineCol(ByRef ps As ParseState, ByVal lineNo As Integer, ByVal colNo As Integer, ByRef lenOut As Integer, ByRef lexemeOut As String) As Integer
    lenOut = 0
    lexemeOut = ""
    Dim i As Integer
    For i = 0 To ps.lx.tokens.count - 1
        If ps.lx.tokens.items(i).lineNo = lineNo And ps.lx.tokens.items(i).colNo = colNo Then
            lenOut = ps.lx.tokens.items(i).lexemeLength
            lexemeOut = ps.lx.tokens.items(i).lexeme
            Return ps.lx.tokens.items(i).offset
        End If
    Next i
    Return 0
End Function

Private Sub ParserBackfillAstSourceOffsetsNode(ByRef ps As ParseState, ByVal nodeIdx As Integer)
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Exit Sub
    If ps.ast.nodes(nodeIdx).sourceOffset <= 0 And ps.ast.nodes(nodeIdx).lineNo > 0 Then
        Dim tokLen As Integer
        Dim tokLex As String
        Dim tokOff As Integer
        tokOff = ParserFindTokenOffsetByLineCol(ps, ps.ast.nodes(nodeIdx).lineNo, ps.ast.nodes(nodeIdx).colNo, tokLen, tokLex)
        If tokOff > 0 Then
            ps.ast.nodes(nodeIdx).sourceOffset = tokOff
            If ps.ast.nodes(nodeIdx).sourceLength <= 0 Then ps.ast.nodes(nodeIdx).sourceLength = tokLen
            If Trim(ps.ast.nodes(nodeIdx).lexemeSnippet) = "" Then ps.ast.nodes(nodeIdx).lexemeSnippet = UXBSourceSnippet(tokLex)
        End If
    End If
    If ps.ast.nodes(nodeIdx).left <> -1 Then ParserBackfillAstSourceOffsetsNode ps, ps.ast.nodes(nodeIdx).left
    If ps.ast.nodes(nodeIdx).right <> -1 Then ParserBackfillAstSourceOffsetsNode ps, ps.ast.nodes(nodeIdx).right
    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        ParserBackfillAstSourceOffsetsNode ps, ch
        ch = ps.ast.nodes(ch).nextSibling
    Loop
End Sub

Sub ParserBackfillAstSourceOffsets(ByRef ps As ParseState)
    ParserBackfillAstSourceOffsetsNode ps, ps.rootNode
End Sub

Private Function IsEndIfStart(ByRef ps As ParseState) As Integer
    Return IsKw(ps, "END") And (LookToken(ps, 1).kind = "KEYWORD") And (UCase(LookToken(ps, 1).lexeme) = "IF")
End Function

Private Function IsEndSelectStart(ByRef ps As ParseState) As Integer
    Return IsKw(ps, "END") And (LookToken(ps, 1).kind = "KEYWORD") And (UCase(LookToken(ps, 1).lexeme) = "SELECT")
End Function

Private Sub SkipSeparators(ByRef ps As ParseState)
    Do
        Dim tk As Token
        tk = CurToken(ps)
        If tk.kind = "EOL" Then
            AdvanceTok ps
        ElseIf tk.kind = "OP" And tk.lexeme = ":" Then
            AdvanceTok ps
        Else
            Exit Do
        End If
    Loop
End Sub

Private Function MakeNodeFromToken(ByRef ps As ParseState, ByRef kindName As String, ByRef valueText As String, ByRef opText As String, ByRef tk As Token) As Integer
    If AstContract_HasNode(kindName) = 0 Then
        ps.lastError = "AST contract node missing: " & kindName
        Return -1
    End If
    Return ASTNewNode(ps.ast, kindName, valueText, opText, tk.lineNo, tk.colNo, tk.sourceFile, tk.kind, tk.lexemeLength, tk.lexeme, tk.offset)
End Function

Private Function MakeSyntheticNumber(ByRef ps As ParseState, ByRef numberText As String) As Integer
    Dim tk As Token
    tk = CurToken(ps)
    If AstContract_HasNode(ASTK_NUMBER) = 0 Then
        ps.lastError = "AST contract node missing: " & ASTK_NUMBER
        Return -1
    End If
    Return ASTNewNode(ps.ast, ASTK_NUMBER, numberText, "", tk.lineNo, tk.colNo, tk.sourceFile, tk.kind, tk.lexemeLength, tk.lexeme, tk.offset)
End Function
