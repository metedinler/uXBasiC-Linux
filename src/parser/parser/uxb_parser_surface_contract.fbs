Function UXBParserSurfaceParseStatus(ByRef surfaceText As String) As String
    Dim s As String
    s = UXBSurfaceNormalize(surfaceText)

    If Left(s, 2) = "%%" Then Return "PARSE_PREPROCESS_ONLY"

    Select Case s
    Case "INLINE"
        Return "PARSE_DEPRECATED"
    Case "NATIVE"
        Return "PARSE_DECL_ONLY"
    Case "PEEKS"
        Return "PARSE_EXPR_ONLY"
    End Select

    If UXBSurfaceKnown(s) = 0 Then Return "PARSE_MISSING"

    Select Case s
    Case "DIM", "REDIM", "CONST", "DECLARE", "SUB", "FUNCTION", "TYPE", "STRUCT", "UNION", "CLASS", "INTERFACE", "ENUM", "CONSTRUCTOR", "DESTRUCTOR", "PROPERTY", "METHOD", "OPERATOR", "ALIAS", "IMPORT", "INCLUDE", "NAMESPACE", "MODULE", "USING", "PUBLIC", "PRIVATE", "PROTECTED", "FRIEND", "STATIC", "ABSTRACT", "FINAL", "SEALED", "READONLY", "MUTABLE", "IMMUTABLE", "RESTRICTED"
        Return "PARSE_DECL_ONLY"
    Case "ABS", "ASC", "ATN", "CDBL", "CHR", "CINT", "CLNG", "COS", "CSNG", "EOF", "EXP", "FIX", "GETKEY", "INKEY", "INT", "LCASE", "LEN", "LOF", "LOG", "LTRIM", "MID", "RND", "RTRIM", "SGN", "SIN", "SPACE", "SQR", "SQRT", "STR", "TAN", "TIMER", "UCASE", "VAL", "VARPTR", "SADD", "LPTR", "CODEPTR", "SIZEOF", "OFFSETOF", "LBOUND", "UBOUND", "TRUE", "FALSE", "ZERO", "ONE", "NAND", "NOR", "XNOR", "NXOR", "EQV", "EQA", "IFF", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB"
        Return "PARSE_EXPR_ONLY"
    Case "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "F80", "F128", "BIGF", "BIGD", "BALL", "BOOLEAN", "STRING", "OBJECT", "PTR", "ARRAY", "LIST", "DICT", "SET", "BYTE"
        Return "PARSE_DECL_ONLY"
    End Select

    Return "PARSE_ACTIVE"
End Function

