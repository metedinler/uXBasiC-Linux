#ifndef UXB_PARSER_DIAGNOSTIC_BRIDGE_ADIM16_FBS
#define UXB_PARSER_DIAGNOSTIC_BRIDGE_ADIM16_FBS

#include once "../../common/diagnostic.fbs"

Function UXBParserDiagnosticBridgePush(ByRef outList As UXBDiagnosticList, ByRef codeText As String, ByRef messageText As String, ByRef filePathText As String, ByVal lineNo As Integer, ByVal colNo As Integer, ByRef surfaceText As String = "") As Integer
    Dim srcLocation As SourceLocation
    srcLocation = UXBSourceLocationMake(filePathText, lineNo, colNo, 1, surfaceText)
    Return UXBDiagnosticPush(outList, codeText, UXB_DIAG_ERROR, "parser", "parse", messageText, srcLocation, surfaceText, "parser diagnostic bridge")
End Function

Private Sub UXBParserDiagnosticLocationFromMessage(ByRef messageText As String, ByRef lineNo As Integer, ByRef colNo As Integer)
    lineNo = 0
    colNo = 0
    Dim scanPos As Integer
    scanPos = 1
    Do
        Dim openPos As Integer
        Dim closePos As Integer
        openPos = InStr(scanPos, messageText, "[")
        If openPos <= 0 Then Exit Do
        closePos = InStr(openPos + 1, messageText, "]")
        If closePos <= openPos Then Exit Do
        Dim bodyText As String
        bodyText = Mid(messageText, openPos + 1, closePos - openPos - 1)
        Dim colonPos As Integer
        colonPos = InStr(bodyText, ":")
        If colonPos > 1 Then
            Dim lineText As String
            Dim colText As String
            lineText = Trim(Left(bodyText, colonPos - 1))
            colText = Trim(Mid(bodyText, colonPos + 1))
            If Val(lineText) > 0 Then
                lineNo = Val(lineText)
                colNo = Val(colText)
                If colNo < 1 Then colNo = 1
                Exit Do
            End If
        End If
        scanPos = closePos + 1
    Loop
End Sub

Function UXBParserDiagnosticBridgePushAll(ByRef outList As UXBDiagnosticList, ByRef ps As ParseState, ByRef filePathText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.parseErrorCount - 1
        Dim msgText As String
        msgText = ps.parseErrors(i)
        If Trim(msgText) = "" Then msgText = ps.lastError
        Dim lineNo As Integer
        Dim colNo As Integer
        UXBParserDiagnosticLocationFromMessage msgText, lineNo, colNo
        Dim codeText As String
        codeText = UXBParserDiagnosticCodeFromMessage(msgText)
        If codeText = "" Then codeText = "PARSER_DIAGNOSTIC"
        UXBParserDiagnosticBridgePush outList, codeText, msgText, filePathText, lineNo, colNo, ""
    Next i
    If ps.parseErrorCount = 0 And Trim(ps.lastError) <> "" Then
        Dim lastLineNo As Integer
        Dim lastColNo As Integer
        UXBParserDiagnosticLocationFromMessage ps.lastError, lastLineNo, lastColNo
        Dim lastCodeText As String
        lastCodeText = UXBParserDiagnosticCodeFromMessage(ps.lastError)
        If lastCodeText = "" Then lastCodeText = "PARSER_DIAGNOSTIC"
        UXBParserDiagnosticBridgePush outList, lastCodeText, ps.lastError, filePathText, lastLineNo, lastColNo, ""
        Return 1
    End If
    Return ps.parseErrorCount
End Function

#endif
