#ifndef UXB_PARSER_ADIM08_JSON_EXPORT_FBS
#define UXB_PARSER_ADIM08_JSON_EXPORT_FBS

#include once "../../common/report_writer.fbs"

Function UXBParserJsonEscape(ByVal rawText As String) As String
    Dim outText As String
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim c As String
        c = Mid(rawText, i, 1)
        Select Case c
        Case Chr(34)
            outText &= "\"""
        Case "\\"
            outText &= "\\\\"
        Case Chr(10)
            outText &= "\n"
        Case Chr(13)
            outText &= "\r"
        Case Chr(9)
            outText &= "\t"
        Case Else
            outText &= c
        End Select
    Next i
    Return outText
End Function

Function UXBParserErrorsToJson(ByRef ps As ParseState) As String
    Dim j As String
    Dim i As Integer

    j = "{" & Chr(10)
    j &= "  ""ok"": " & IIf(ps.parseErrorCount = 0, "true", "false") & "," & Chr(10)
    j &= "  ""error_count"": " & LTrim(Str(ps.parseErrorCount)) & "," & Chr(10)
    j &= "  ""errors"": ["

    If ps.parseErrorCount > 0 Then j &= Chr(10)
    For i = 0 To ps.parseErrorCount - 1
        Dim errorCode As String
        errorCode = UXBParserDiagnosticCodeFromMessage(ps.parseErrors(i))
        If errorCode = "" Then errorCode = "PARSER_DIAGNOSTIC"
        j &= "    {""index"": " & LTrim(Str(i)) & ", ""code"": """ & UXBParserJsonEscape(errorCode) & """, ""message"": """ & UXBParserJsonEscape(ps.parseErrors(i)) & """}"
        If i < ps.parseErrorCount - 1 Then j &= ","
        j &= Chr(10)
    Next i

    j &= "  ]" & Chr(10)
    j &= "}"
    Return j
End Function

Function UXBParserWriteErrorsJson(ByRef ps As ParseState, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1

    ' S-466: ust klasor yokken (varsayilan frontend/parser/ klasoru henuz olusmamisken ya da klasorlu --...-json-out yolu)
    ' ciplak `Open` -exx altinda derleyiciyi "runtime error 2 (file not found)" ile iptal ediyordu ve `If Err` satirina varilmiyordu.
    ' Ortak yazici ust klasoru olusturur ve acma hatasini tani olarak dondurur. `Print #` satir sonu (CRLF) korunur.
    Dim writeErr As String
    If UXBReportWriteText(outPath, UXBParserErrorsToJson(ps) & Chr(13) & Chr(10), writeErr) = 0 Then
        errText = "parser: cannot write errors json: " & outPath & " (" & writeErr & ")"
        Return 0
    End If
    Return 1
End Function

Function UXBParserWriteAstJson(ByRef ps As ParseState, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1
    Return ASTWriteJson(ps.ast, ps.rootNode, outPath, errText)
End Function

#endif
