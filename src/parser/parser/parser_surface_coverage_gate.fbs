Function UXBParserSurfaceCoverageGate(ByRef errText As String, ByRef csvOut As String) As Integer
    errText = ""
    csvOut = "surface,contract_status,parse_status,ok,reason" & Chr(10)

    Dim missingCount As Integer
    missingCount = 0

    Dim i As Integer
    For i = 0 To UXBParserSurfaceKeywordCount() - 1
        Dim surfaceText As String
        surfaceText = UXBParserSurfaceKeywordAt(i)

        Dim contractStatus As String
        Dim parseStatus As String
        contractStatus = UXBParserSurfaceContractStatus(surfaceText)
        parseStatus = UXBParserSurfaceParseStatus(surfaceText)

        Dim rowOk As Integer
        Dim reasonText As String
        rowOk = 1
        reasonText = "ok"

        If Trim(surfaceText) = "" Then
            rowOk = 0
            reasonText = "empty lexer surface entry"
        ElseIf contractStatus = "MISSING" Or parseStatus = "PARSE_MISSING" Then
            rowOk = 0
            reasonText = UXB_SURFACE_PARSER_STATUS_MISSING
        End If

        If rowOk = 0 Then missingCount += 1

        csvOut &= UXBReportCsvEscape(surfaceText) & "," & UXBReportCsvEscape(contractStatus) & "," & UXBReportCsvEscape(parseStatus) & "," & LTrim(Str(rowOk)) & "," & UXBReportCsvEscape(reasonText) & Chr(10)
    Next i

    If missingCount > 0 Then
        errText = UXB_SURFACE_PARSER_STATUS_MISSING & ": count=" & LTrim(Str(missingCount))
        Return 0
    End If

    Return 1
End Function

Function UXBParserSurfaceCoverageGateWrite(ByRef outPath As String, ByRef errText As String) As Integer
    Dim csvText As String
    If UXBParserSurfaceCoverageGate(errText, csvText) = 0 Then
        Dim writeErr As String
        writeErr = ""
        UXBReportWriteText outPath, csvText, writeErr
        Return 0
    End If
    Return UXBReportWriteText(outPath, csvText, errText)
End Function

#endif
