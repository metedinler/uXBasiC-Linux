Const UXB_SURFACE_PARSER_STATUS_MISSING As String = "UXB_SURFACE_PARSER_STATUS_MISSING"

Function UXBParserSurfaceKeywordCount() As Integer
    ' S-055 follow-up: this count was 219 while the Case table below already
    ' listed entries through index 220 ("NATIVE"=219, "PEEKS"=220) -- both
    ' were silently unreachable by UXBParserSurfaceCoverageGate's `For i = 0
    ' To UXBParserSurfaceKeywordCount()-1` loop, a pre-existing stale-count
    ' bug unrelated to the Q family being added here. Fixed while extending
    ' this table with the new PEEKQ/POKEQ/MEMCOPYQ/MEMFILLQ entries (221-224).
    ' S-196: Model D (LOCK/UNSAFE/TASK/TASKGROUP) and PEEK/MEMCOPY/MEMFILL added (227-233).
    Return 234
End Function

