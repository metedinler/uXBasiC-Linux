' uXBasic AST contract registry.
' 2026-05-26 19:32 +03:00 - Codex: Step 2 için parser node adlarını resmi contract kaydına bağlar.
#ifndef UXBASIC_AST_CONTRACT_REGISTRY_FBS
#define UXBASIC_AST_CONTRACT_REGISTRY_FBS

#include once "ast_node_roles.fbs"
#include once "ast_node_fields.fbs"

Const AST_CONTRACT_STATUS_IMPLEMENTED As String = "IMPLEMENTED"
Const AST_CONTRACT_STATUS_NOT_APPLICABLE As String = "NOT_APPLICABLE"
Const AST_CONTRACT_STATUS_COMPILE_TIME_ONLY As String = "COMPILE_TIME_ONLY"
Const AST_CONTRACT_STATUS_RUNTIME_CALL As String = "RUNTIME_CALL"
Const AST_CONTRACT_STATUS_NATIVE_ONLY As String = "NATIVE_ONLY"
Const AST_CONTRACT_STATUS_JS_ONLY As String = "JS_ONLY"
Const AST_CONTRACT_STATUS_WASM_ONLY As String = "WASM_ONLY"
Const AST_CONTRACT_STATUS_WASM_UNSUPPORTED As String = "WASM_UNSUPPORTED"
Const AST_CONTRACT_STATUS_BROWSER_ONLY As String = "BROWSER_ONLY"
Const AST_CONTRACT_STATUS_DIAGNOSTIC_ONLY As String = "DIAGNOSTIC_ONLY"
Const AST_CONTRACT_STATUS_RESERVED As String = "RESERVED"
Const AST_CONTRACT_STATUS_REMOVED As String = "REMOVED"
Const AST_CONTRACT_STATUS_MISSING As String = "MISSING"
Const AST_CONTRACT_STATUS_BROKEN As String = "BROKEN"

#include once "ast_contract_layer_bindings.fbs"

Type AstContractNodeBinding
    nodeName As String
    nodeGroup As String
    nodeKind As String
    requiredFields As String
    optionalFields As String
    allowedChildRoles As String
    allowedParentNodes As String
    producedByParserFunction As String
    semanticHandler As String
    typeBindingHandler As String
    layoutHandler As String
    astInterpreterHandler As String
    mirLoweringHandler As String
    mirVerifyRule As String
    x64AstHandler As String
    x64MirHandler As String
    jsHandler As String
    wasmWatHandler As String
    finalDecision As String
End Type

Dim Shared gAstContractNodes(Any) As AstContractNodeBinding
Dim Shared gAstContractNodeCount As Integer
Dim Shared gAstContractReady As Integer

Private Function AstContract_U(ByRef textIn As String) As String
    Return UCase(Trim(textIn))
End Function

Private Function AstContract_GroupForNode(ByRef nodeName As String) As String
    Dim n As String = AstContract_U(nodeName)
    If n = ASTK_PROGRAM Then Return "PROGRAM_STRUCTURE"
    If n = ASTK_BLOCK Then Return "STATEMENT"
    If n = ASTK_IF_STMT Or n = ASTK_ELSEIF_PART Or n = ASTK_ELSE_PART Or n = ASTK_SELECT_STMT Or n = ASTK_CASE_BLOCK Or n = ASTK_CASE_ELSE Or n = ASTK_CASE_IS_VALUE Or n = ASTK_FOR_STMT Or n = ASTK_FOR_EACH_STMT Or n = ASTK_EACH_ITEMS Or n = ASTK_EACH_BODY Or n = ASTK_DO_STMT Or n = ASTK_DO_EACH_STMT Or n = ASTK_EXIT_STMT Or n = ASTK_RETURN_STMT Or n = ASTK_GOTO_STMT Or n = ASTK_GOSUB_STMT Or n = ASTK_LABEL_STMT Or n = ASTK_END_STMT Then Return "CONTROL_FLOW"
    If n = ASTK_TRY_STMT Or n = ASTK_TRY_BODY Or n = ASTK_CATCH_PART Or n = ASTK_FINALLY_PART Or n = ASTK_THROW_STMT Or n = ASTK_ASSERT_STMT Then Return "ERROR_HANDLING"
    If n = ASTK_OPEN_STMT Or n = ASTK_MODE_REF Or n = ASTK_CLOSE_STMT Or n = ASTK_GET_STMT Or n = ASTK_PUT_STMT Or n = ASTK_SEEK_STMT Or n = ASTK_INPUT_STMT Or n = ASTK_INPUT_FILE_STMT Or n = ASTK_INPUTF_STMT Or n = ASTK_PROMPT_EXPR Or n = ASTK_LOCATE_STMT Or n = ASTK_COLOR_STMT Or n = ASTK_CLS_STMT Then Return "FILE_IO"
    If n = ASTK_POKEB_STMT Or n = ASTK_POKEW_STMT Or n = ASTK_POKED_STMT Or n = ASTK_POKEQ_STMT Or n = ASTK_POKES_STMT Or n = ASTK_MEMCOPYB_STMT Or n = ASTK_MEMCOPYW_STMT Or n = ASTK_MEMCOPYD_STMT Or n = ASTK_MEMCOPYQ_STMT Or n = ASTK_MEMFILLB_STMT Or n = ASTK_MEMFILLW_STMT Or n = ASTK_MEMFILLD_STMT Or n = ASTK_MEMFILLQ_STMT Or n = ASTK_SETNEWOFFSET_STMT Then Return "MEMORY"
    If n = ASTK_INLINE_STMT Then Return "FFI"
    If n = ASTK_IMPORT_STMT Or n = ASTK_INCLUDE_STMT Or n = ASTK_USING_STMT Or n = ASTK_USING_ITEM Or n = ASTK_ALIAS_STMT Or n = ASTK_ALIAS_TARGET Or n = ASTK_MODULE_STMT Or n = ASTK_NAMESPACE_STMT Or n = ASTK_MAIN_STMT Then Return "MODULE_SYSTEM"
    If Instr(n, "CLASS_") = 1 Or Instr(n, "INTERFACE_") = 1 Or n = ASTK_NEW_EXPR Or n = ASTK_DELETE_STMT Then Return "OOP"
    If Instr(n, "TYPE_") = 1 Or n = ASTK_TYPE_REF Or n = ASTK_RETURN_TYPE Then Return "TYPE_SYSTEM"
    If Instr(n, "_DECL") > 0 Or n = ASTK_PARAM_DECL Or n = ASTK_DIM_BOUNDS Or n = ASTK_CONST_STMT Or n = ASTK_DIM_STMT Or n = ASTK_REDIM_STMT Or n = ASTK_DECLARE_SUB_STMT Or n = ASTK_DECLARE_FUNCTION_STMT Or n = ASTK_SUB_STMT Or n = ASTK_FUNCTION_STMT Then Return "DECLARATION"
    If n = ASTK_SPAWN_EXPR Then Return "RUNTIME_SERVICE"
    If Instr(n, "_EXPR") > 0 Or n = ASTK_BINARY Or n = ASTK_UNARY Or n = ASTK_IDENTIFIER Or n = ASTK_NUMBER Or n = ASTK_STRING Or n = ASTK_BOOLEAN Or n = ASTK_KEYWORD_REF Then Return "EXPRESSION"
    If n = ASTK_EVENT_STMT Or n = ASTK_THREAD_STMT Or n = ASTK_PARALEL_STMT Or n = ASTK_PIPE_STMT Or n = ASTK_SLOT_STMT Or n = ASTK_SLOT_TABLE_STMT Or n = ASTK_SLOT_BIND_ENTRY Or n = ASTK_SLOT_HEADER_ARGS Or n = ASTK_SLOT_CONTROL_STMT Or n = ASTK_TRIGGER_STMT Or n = ASTK_LOCK_STMT Or n = ASTK_LOCK_TARGET Or n = ASTK_UNSAFE_STMT Then Return "RUNTIME_SERVICE"
    Return "STATEMENT"
End Function

Private Function AstContract_NodeKindForNode(ByRef nodeName As String) As String
    Dim n As String = AstContract_U(nodeName)
    If Instr(n, "_EXPR") > 0 Or n = ASTK_BINARY Or n = ASTK_UNARY Or n = ASTK_IDENTIFIER Or n = ASTK_NUMBER Or n = ASTK_STRING Or n = ASTK_BOOLEAN Or n = ASTK_KEYWORD_REF Then Return "EXPRESSION"
    If Instr(n, "_DECL") > 0 Or n = ASTK_PARAM_DECL Then Return "DECLARATION"
    If Instr(n, "_PART") > 0 Or Instr(n, "_BLOCK") > 0 Or n = ASTK_BLOCK Then Return "STRUCTURE"
    If Instr(n, "_REF") > 0 Or Instr(n, "_ITEM") > 0 Or Instr(n, "_VALUE") > 0 Or Instr(n, "_FLAG") > 0 Or n = ASTK_CLASS_ACCESS Then Return "METADATA"
    Return "STATEMENT"
End Function

Private Function AstContract_DefaultRequiredFields(ByRef nodeName As String) As String
    Dim k As String = AstContract_NodeKindForNode(nodeName)
    If k = "DECLARATION" Then Return AST_FIELDS_DECL_REQUIRED
    If k = "STRUCTURE" Then Return AST_FIELDS_BLOCK_REQUIRED
    If k = "EXPRESSION" Then Return AST_FIELDS_EXPR_REQUIRED
    Return AST_FIELDS_STMT_REQUIRED
End Function

Private Function AstContract_DefaultRoles(ByRef nodeName As String) As String
    Dim n As String = AstContract_U(nodeName)
    If n = ASTK_IF_STMT Then Return "CONDITION,THEN,ELSEIF,ELSE,BODY"
    If n = ASTK_FOR_STMT Or n = ASTK_DO_STMT Then Return "INIT,CONDITION,STEP,BODY"
    If n = ASTK_FOR_EACH_STMT Or n = ASTK_DO_EACH_STMT Then Return "ITEM,INDEX,BODY,EXPR"
    If n = ASTK_BINARY Then Return "LEFT,RIGHT"
    If n = ASTK_UNARY Then Return "EXPR"
    If n = ASTK_CALL_EXPR Or n = ASTK_CALL_STMT Then Return "ARGS,EXPR"
    If n = ASTK_CLASS_STMT Or n = ASTK_TYPE_STMT Or n = ASTK_INTERFACE_STMT Then Return "MEMBERS,DECLS,BODY"
    If n = ASTK_SUB_STMT Or n = ASTK_FUNCTION_STMT Or n = ASTK_DECLARE_SUB_STMT Or n = ASTK_DECLARE_FUNCTION_STMT Then Return "PARAMS,RETURN_TYPE,BODY"
    Return "*"
End Function

Private Function AstContract_DefaultDecision(ByRef nodeName As String) As String
    Dim g As String = AstContract_GroupForNode(nodeName)
    If g = "MODULE_SYSTEM" Or g = "TYPE_SYSTEM" Or g = "DECLARATION" Then Return AST_CONTRACT_STATUS_COMPILE_TIME_ONLY
    If g = "FFI" Then Return AST_CONTRACT_STATUS_NATIVE_ONLY
    Return AST_CONTRACT_STATUS_IMPLEMENTED
End Function

Sub AstContract_RegisterNode(ByRef nodeName As String, ByRef nodeGroup As String, ByRef nodeKind As String, ByRef requiredFields As String, ByRef optionalFields As String, ByRef allowedChildRoles As String, ByRef finalDecision As String)
    Dim nameU As String = AstContract_U(nodeName)
    If nameU = "" Then Exit Sub
    Dim i As Integer
    For i = 0 To gAstContractNodeCount - 1
        If gAstContractNodes(i).nodeName = nameU Then Exit Sub
    Next i
    If gAstContractNodeCount = 0 Then
        ReDim gAstContractNodes(0)
    Else
        ReDim Preserve gAstContractNodes(gAstContractNodeCount)
    End If
    With gAstContractNodes(gAstContractNodeCount)
        .nodeName = nameU
        .nodeGroup = nodeGroup
        .nodeKind = nodeKind
        .requiredFields = requiredFields
        .optionalFields = optionalFields
        .allowedChildRoles = allowedChildRoles
        .allowedParentNodes = "*"
        .producedByParserFunction = "parser"
        .semanticHandler = UXBAstContractSemanticHandlerForNode(nameU)
        .typeBindingHandler = UXBAstContractTypeBindingHandlerForNode(nameU)
        .layoutHandler = UXBAstContractLayoutHandlerForNode(nameU)
        .astInterpreterHandler = UXBAstContractAstInterpreterHandlerForNode(nameU)
        .mirLoweringHandler = UXBAstContractMIRLoweringHandlerForNode(nameU)
        .mirVerifyRule = UXBAstContractMIRVerifyRuleForNode(nameU)
        .x64AstHandler = UXBAstContractX64AstHandlerForNode(nameU)
        .x64MirHandler = UXBAstContractX64MirHandlerForNode(nameU)
        .jsHandler = UXBAstContractJsHandlerForNode(nameU)
        .wasmWatHandler = UXBAstContractWasmWatHandlerForNode(nameU)
        .finalDecision = UXBAstContractFinalDecisionForNode(nameU)
    End With
    gAstContractNodeCount += 1
End Sub

Private Sub AstContract_RegisterKnown(ByRef nodeName As String)
    Dim g As String = AstContract_GroupForNode(nodeName)
    Dim k As String = AstContract_NodeKindForNode(nodeName)
    Dim req As String = AstContract_DefaultRequiredFields(nodeName)
    Dim roles As String = AstContract_DefaultRoles(nodeName)
    Dim decision As String = AstContract_DefaultDecision(nodeName)
    AstContract_RegisterNode nodeName, g, k, req, AST_FIELDS_COMMON_OPTIONAL, roles, decision
End Sub

