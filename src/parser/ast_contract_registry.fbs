Private Function AstContract_FindNodeIndex(ByRef nodeName As String) As Integer
    AstContract_Init
    Dim nameU As String = AstContract_U(nodeName)
    Dim i As Integer
    For i = 0 To gAstContractNodeCount - 1
        If gAstContractNodes(i).nodeName = nameU Then Return i
    Next i
    Return -1
End Function

Function AstContract_HasNode(ByRef nodeName As String) As Integer
    Return IIf(AstContract_FindNodeIndex(nodeName) >= 0, 1, 0)
End Function

Function AstContract_GetNodeGroup(ByRef nodeName As String) As String
    Dim i As Integer = AstContract_FindNodeIndex(nodeName)
    If i < 0 Then Return "DIAGNOSTIC"
    Return gAstContractNodes(i).nodeGroup
End Function

Function AstContract_GetRequiredFields(ByRef nodeName As String) As String
    Dim i As Integer = AstContract_FindNodeIndex(nodeName)
    If i < 0 Then Return AST_FIELDS_COMMON_REQUIRED
    Return gAstContractNodes(i).requiredFields
End Function

Function AstContract_GetAllowedRoles(ByRef nodeName As String) As String
    Dim i As Integer = AstContract_FindNodeIndex(nodeName)
    If i < 0 Then Return ""
    Return gAstContractNodes(i).allowedChildRoles
End Function

Function AstContract_GetLayerBinding(ByRef nodeName As String, ByRef layerName As String) As String
    Dim i As Integer = AstContract_FindNodeIndex(nodeName)
    If i < 0 Then Return AST_CONTRACT_STATUS_MISSING
    Select Case AstContract_U(layerName)
    Case "SEMANTIC": Return gAstContractNodes(i).semanticHandler
    Case "TYPE_BINDING": Return gAstContractNodes(i).typeBindingHandler
    Case "LAYOUT": Return gAstContractNodes(i).layoutHandler
    Case "AST_INTERPRETER": Return gAstContractNodes(i).astInterpreterHandler
    Case "MIR": Return gAstContractNodes(i).mirLoweringHandler
    Case "MIR_VERIFY": Return gAstContractNodes(i).mirVerifyRule
    Case "X64_AST": Return gAstContractNodes(i).x64AstHandler
    Case "X64_MIR": Return gAstContractNodes(i).x64MirHandler
    Case "JS": Return gAstContractNodes(i).jsHandler
    Case "WASM_WAT": Return gAstContractNodes(i).wasmWatHandler
    End Select
    Return AST_CONTRACT_STATUS_NOT_APPLICABLE
End Function

Function AstContract_NodeFinalDecision(ByRef nodeName As String) As String
    Dim i As Integer = AstContract_FindNodeIndex(nodeName)
    If i < 0 Then Return AST_CONTRACT_STATUS_MISSING
    Return gAstContractNodes(i).finalDecision
End Function

Function AstContract_GetLayerStatus(ByRef nodeName As String, ByRef layerName As String) As String
    Return UXBAstContractLayerStatusForNode(nodeName, layerName)
End Function

Function AstContract_TargetSupportJson(ByRef nodeName As String) As String
    Return UXBAstContractTargetSupportJson(nodeName)
End Function

