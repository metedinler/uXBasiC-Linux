' MIR Evaluator functions
Private Sub MIREvaluatorInit(ByRef mir As MIREvaluator)
    mir.blockCount = 0
    mir.currentBlock = 0
End Sub

Private Sub MIRBlockInit(ByRef blk As MIRBlock)
    blk.count = 0
End Sub

Private Sub MIRAddInstruction(ByRef blk As MIRBlock, ByRef opcode As String, ByRef op1 As String, ByRef op2 As String, ByRef op3 As String)
    If blk.count = 0 Then
        ReDim blk.instructions(0)
    Else
        ReDim Preserve blk.instructions(blk.count)
    End If
    
    blk.instructions(blk.count).opcode = opcode
    blk.instructions(blk.count).operand1 = op1
    blk.instructions(blk.count).operand2 = op2
    blk.instructions(blk.count).operand3 = op3
    blk.count += 1
End Sub

Private Function MIRGenerateFromAST(ByRef mir As MIREvaluator, ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "mir: invalid node index"
        Return 0
    End If
    
    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)
    
    Select Case UCase(n.kind)
    Case "NUMBER"
        MIRAddInstruction mir.blocks(mir.currentBlock), "LOAD_CONST", n.value, "", ""
        Return 1
        
    Case "IDENT"
        MIRAddInstruction mir.blocks(mir.currentBlock), "LOAD_VAR", n.value, "", ""
        Return 1
        
    Case "BINARY"
        If MIRGenerateFromAST(mir, ps, n.left, errText) = 0 Then Return 0
        If MIRGenerateFromAST(mir, ps, n.right, errText) = 0 Then Return 0
        
        Select Case n.op
        Case "+"
            MIRAddInstruction mir.blocks(mir.currentBlock), "ADD", "", "", ""
        Case "-"
            MIRAddInstruction mir.blocks(mir.currentBlock), "SUB", "", "", ""
        Case "*"
            MIRAddInstruction mir.blocks(mir.currentBlock), "MUL", "", "", ""
        Case "="
            MIRAddInstruction mir.blocks(mir.currentBlock), "EQ", "", "", ""
        Case Else
            errText = "mir: unsupported binary op " & n.op
            Return 0
        End Select
        Return 1
        
    Case Else
        errText = "mir: unsupported node kind " & n.kind
        Return 0
    End Select
End Function

Private Function MIRExecute(ByRef mir As MIREvaluator, ByRef es As ExecState, ByRef errText As String) As Integer
    Dim valueStack(0 To 1023) As Integer
    Dim stackTop As Integer
    stackTop = -1

    Dim bi As Integer
    For bi = 0 To mir.blockCount - 1
        Dim ii As Integer
        For ii = 0 To mir.blocks(bi).count - 1
            Dim mirInstr As MIRInstruction
            mirInstr = mir.blocks(bi).instructions(ii)

            Dim op As String
            op = UCase(Trim(mirInstr.opcode))

            Select Case op
            Case "LOAD_CONST"
                If stackTop >= UBound(valueStack) Then
                    errText = "mir: stack overflow in legacy evaluator"
                    Return 0
                End If
                stackTop += 1
                valueStack(stackTop) = ValInt(mirInstr.operand1)

            Case "LOAD_VAR"
                If stackTop >= UBound(valueStack) Then
                    errText = "mir: stack overflow in legacy evaluator"
                    Return 0
                End If
                stackTop += 1
                valueStack(stackTop) = ExecGetVar(es, mirInstr.operand1)

            Case "STORE_VAR"
                If stackTop < 0 Then
                    errText = "mir: stack underflow on STORE_VAR"
                    Return 0
                End If
                ExecSetVar es, mirInstr.operand1, valueStack(stackTop)
                stackTop -= 1

            Case "ADD", "SUB", "MUL", "DIV", "MOD", "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "SHL", "SHR"
                If stackTop < 1 Then
                    errText = "mir: stack underflow on " & op
                    Return 0
                End If

                Dim rhs As Integer
                Dim lhs As Integer
                rhs = valueStack(stackTop)
                lhs = valueStack(stackTop - 1)
                stackTop -= 1

                Select Case op
                Case "ADD": valueStack(stackTop) = lhs + rhs
                Case "SUB": valueStack(stackTop) = lhs - rhs
                Case "MUL": valueStack(stackTop) = lhs * rhs
                Case "DIV"
                    If rhs = 0 Then
                        errText = "mir: division by zero"
                        Return 0
                    End If
                    valueStack(stackTop) = lhs \ rhs
                Case "MOD"
                    If rhs = 0 Then
                        errText = "mir: modulo by zero"
                        Return 0
                    End If
                    valueStack(stackTop) = lhs Mod rhs
                Case "EQ": valueStack(stackTop) = IIf(lhs = rhs, -1, 0)
                Case "NE": valueStack(stackTop) = IIf(lhs <> rhs, -1, 0)
                Case "LT": valueStack(stackTop) = IIf(lhs < rhs, -1, 0)
                Case "LE": valueStack(stackTop) = IIf(lhs <= rhs, -1, 0)
                Case "GT": valueStack(stackTop) = IIf(lhs > rhs, -1, 0)
                Case "GE": valueStack(stackTop) = IIf(lhs >= rhs, -1, 0)
                Case "AND": valueStack(stackTop) = lhs And rhs
                Case "OR": valueStack(stackTop) = lhs Or rhs
                Case "XOR": valueStack(stackTop) = lhs Xor rhs
                Case "SHL": valueStack(stackTop) = CInt(CUInt(lhs) Shl (rhs And 31))
                Case "SHR": valueStack(stackTop) = CInt(CUInt(lhs) Shr (rhs And 31))
                End Select

            Case "NEG"
                If stackTop < 0 Then
                    errText = "mir: stack underflow on NEG"
                    Return 0
                End If
                valueStack(stackTop) = -valueStack(stackTop)

            Case "NOT"
                If stackTop < 0 Then
                    errText = "mir: stack underflow on NOT"
                    Return 0
                End If
                valueStack(stackTop) = Not valueStack(stackTop)

            Case Else
                errText = "mir: legacy evaluator unsupported opcode " & mirInstr.opcode
                Return 0
            End Select
        Next ii
    Next bi

    If stackTop >= 0 Then Return valueStack(stackTop)
    Return 0
End Function

Private Sub ExecInitZeroValue(ByRef outValue As ExecValue)
    outValue.valueType = "INTEGER"
    outValue.intValue = 0
    outValue.floatValue = 0
    outValue.stringValue = ""
End Sub

Private Function ExecFieldZeroValue(ByRef fieldTypeRaw As String) As ExecValue
    Dim result As ExecValue
    ExecInitZeroValue result

    Dim fieldType As String
    fieldType = UCase(Trim(fieldTypeRaw))
    If fieldType = "STRING" Or fieldType = "STRPTR" Then
        result.valueType = "STRING"
        result.stringValue = ""
    ElseIf fieldType = "F32" Or fieldType = "F64" Or fieldType = "F80" Or fieldType = "SINGLE" Or fieldType = "DOUBLE" Then
        result.valueType = "FLOAT"
        result.floatValue = 0
    End If

    Return result
End Function

Private Sub ExecStaticFieldReset()
    gExecStaticFieldSlotCount = 0
    Erase gExecStaticFieldSlots
End Sub

Private Function ExecStaticFieldFindIndex(ByRef keyRaw As String) As Integer
    Dim keyUpper As String
    keyUpper = UCase(Trim(keyRaw))
    If keyUpper = "" Then Return -1

    Dim i As Integer
    For i = 0 To gExecStaticFieldSlotCount - 1
        If UCase(Trim(gExecStaticFieldSlots(i).keyText)) = keyUpper Then Return i
    Next i
    Return -1
End Function

Private Function ExecStaticFieldRead(ByRef keyRaw As String, ByRef valueOut As ExecValue) As Integer
    Dim idx As Integer
    idx = ExecStaticFieldFindIndex(keyRaw)
    If idx = -1 Then Return 0

    If gExecStaticFieldSlots(idx).hasValue = 0 Then Return 0
    valueOut = gExecStaticFieldSlots(idx).value
    Return 1
End Function

Private Sub ExecStaticFieldWrite(ByRef keyRaw As String, ByRef valueIn As ExecValue)
    Dim keyUpper As String
    keyUpper = UCase(Trim(keyRaw))
    If keyUpper = "" Then Exit Sub

    Dim idx As Integer
    idx = ExecStaticFieldFindIndex(keyUpper)
    If idx = -1 Then
        If gExecStaticFieldSlotCount = 0 Then
            ReDim gExecStaticFieldSlots(0)
        Else
            ReDim Preserve gExecStaticFieldSlots(gExecStaticFieldSlotCount)
        End If
        idx = gExecStaticFieldSlotCount
        gExecStaticFieldSlotCount += 1
        gExecStaticFieldSlots(idx).keyText = keyUpper
    End If

    gExecStaticFieldSlots(idx).value = valueIn
    gExecStaticFieldSlots(idx).hasValue = 1
End Sub

Private Sub ExecDebugConsoleReset()
    gDebugLocateRow = 0
    gDebugLocateCol = 0
    gDebugColorFg = 0
    gDebugColorBg = 0
    gDebugClsCount = 0
    gDebugPrintColumnPos = 0
    UxbConsoleReset
End Sub

' ===== EXECUTION CONTRACT IMPLEMENTATIONS =====
' YOK R öğeleri için runtime execution ekleme

Private Sub ExecContractInit(ByRef es As ExecState)
    es.constCount = 0
    es.defTypeCount = 0
    es.stringSize = 255
    Erase es.consts
    Erase es.defTypes
    gExecDebugLastDefTypeCount = es.defTypeCount
    gExecDebugLastStringSize = es.stringSize
End Sub

#include once "exec/exec_class_layout_helpers.fbs"

' CONST execution contract
Function ExecEvalCONST(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef es As ExecState, ByRef errText As String) As Integer
    ' Parser emits CONST_STMT with one or more CONST_DECL children.
    Dim declCount As Integer
    declCount = ExecChildCount(ps, nodeIdx)
    If declCount < 1 Then
        errText = "CONST: İsim ve değer gerekli"
        Return 0
    End If

    Dim declPos As Integer
    For declPos = 0 To declCount - 1
        Dim declNode As Integer
        declNode = ExecChildAt(ps, nodeIdx, declPos)
        If declNode = -1 Or UCase(ps.ast.nodes(declNode).kind) <> "CONST_DECL" Then
            errText = "CONST: Geçersiz sabit bildirimi"
            Return 0
        End If

        Dim constName As String
        constName = UCase(Trim(ps.ast.nodes(declNode).value))
        If constName = "" Then
            errText = "CONST: Geçersiz sabit adı"
            Return 0
        End If

        Dim valueNode As Integer
        valueNode = ps.ast.nodes(declNode).left
        If valueNode = -1 Then
            errText = "CONST: Değer düğümü bulunamadı"
            Return 0
        End If

        ' Check if already defined
        Dim i As Integer
        For i = 0 To es.constCount - 1
            If UCase(es.consts(i).nameText) = constName Then
                errText = "CONST: Sabit zaten tanımlanmış: " & constName
                Return 0
            End If
        Next

        ' Evaluate value
        Dim constValue As ExecValue
        If ExecEvalExpression(ps, valueNode, es, constValue, errText) = 0 Then
            Return 0
        End If

        ' Add to const table
        If es.constCount = 0 Then
            ReDim es.consts(0)
        Else
            ReDim Preserve es.consts(es.constCount)
        End If

        es.consts(es.constCount).nameText = constName
        es.consts(es.constCount).value = constValue
        es.constCount += 1
    Next

    Return 1
End Function

' DIM execution contract
Function ExecEvalDIM(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef es As ExecState, ByRef errText As String) As Integer
    ' DIM decl[, decl...] where each decl is DIM_DECL [DIM_BOUNDS] TYPE_REF [INIT_EXPR]
    Dim childCount As Integer
    childCount = ExecChildCount(ps, nodeIdx)
    If childCount < 1 Then
        errText = "DIM: declaration required"
        Return 0
    End If

    Dim declPos As Integer
    For declPos = 0 To childCount - 1
        Dim declNode As Integer
        declNode = ExecChildAt(ps, nodeIdx, declPos)
        If declNode = -1 Then
            errText = "DIM: declaration node missing"
            Return 0
        End If

        If UCase(ps.ast.nodes(declNode).kind) <> "DIM_DECL" Then
            errText = "DIM: invalid declaration node"
            Return 0
        End If

        Dim varName As String
        varName = UCase(Trim(ps.ast.nodes(declNode).value))
        If varName = "" Then
            errText = "DIM: invalid variable name"
            Return 0
        End If

        Dim existingVarIdx As Integer
        existingVarIdx = ExecFindVar(es, varName)
        If existingVarIdx <> -1 Then
            ' DIM inside a routine creates a new activation-local variable.
            ' An outer/global variable with the same name is legal shadowing;
            ' a duplicate in the current frame remains an error.
            Dim canShadowOuter As Integer
            canShadowOuter = 0
            If es.runtime.callContextDepth > 0 And es.runtime.callContextDepth <= 63 Then
                If existingVarIdx < es.runtime.callFrameBase(es.runtime.callContextDepth) Then canShadowOuter = 1
            End If
            If canShadowOuter = 0 Then
                errText = "DIM: duplicate variable " & varName
                Return 0
            End If
            If ExecAppendFrameVar(es, varName) = -1 Then
                errText = "DIM: local frame variable capacity exceeded"
                Return 0
            End If
        End If

        Dim typeNode As Integer
        typeNode = ExecFindChildByKind(ps, declNode, "TYPE_REF")
        If typeNode = -1 Then
            errText = "DIM: type reference missing"
            Return 0
        End If

        Dim declType As String
        declType = UCase(Trim(ps.ast.nodes(typeNode).value))
        If declType = "" Then
            errText = "DIM: invalid type"
            Return 0
        End If

        Dim boundsNode As Integer
        boundsNode = ExecFindChildByKind(ps, declNode, "DIM_BOUNDS")

        Dim varValue As ExecValue
        ExecValueInit varValue

        If boundsNode <> -1 Then
            Dim dimCount As Integer
            dimCount = ExecChildCount(ps, boundsNode)
            If dimCount < 1 Then
                errText = "DIM: empty array bounds"
                Return 0
            End If

            Dim lowerBound As Integer
            Dim upperBound As Integer

            If dimCount = 1 Then
                Dim boundExpr As Integer
                boundExpr = ExecChildAt(ps, boundsNode, 0)
                If boundExpr = -1 Then
                    errText = "DIM: array bound missing"
                    Return 0
                End If

                If ExecParseBoundRange(ps, es, boundExpr, lowerBound, upperBound, errText) = 0 Then Return 0
            Else
                ' Multi-dimensional DIM: flattened to a single 0-based array.
                ' Bounds must be compile-time constants -- see exec_array_dim.fbs.
                Dim multiDimTotal As Integer
                If ExecArrayFlatElementCount(ps, boundsNode, multiDimTotal, errText) = 0 Then Return 0
                lowerBound = 0
                upperBound = multiDimTotal - 1
            End If

            Dim extent As LongInt
            extent = CLng(upperBound) - CLng(lowerBound) + 1
            If extent <= 0 Then
                errText = "DIM: invalid array extent"
                Return 0
            End If

            Dim elemSize As Integer
            Dim aggregateArrayElem As Integer
            aggregateArrayElem = 0

            elemSize = ExecTypeElemSizeBytes(declType)
            If elemSize <= 0 Then
                Dim aggElemErr As String
                If TypeLayoutSizeOf(ps, declType, elemSize, aggElemErr) <> 0 Then
                    If ExecFindClassDeclNode(ps, declType) = -1 And ExecFindInterfaceDeclNode(ps, declType) = -1 And declType <> "OBJECT" Then
                        aggregateArrayElem = 1
                    End If
                End If
            End If

            If elemSize <= 0 Then
                errText = "DIM: unsupported array element type " & declType
                Return 0
            End If

            Dim totalBytes As LongInt
            totalBytes = extent * CLng(elemSize)
            If totalBytes <= 0 Or totalBytes > &h7FFFFFFF Then
                errText = "DIM: array byte overflow"
                Return 0
            End If

            varValue.valueType = "ARRAY"
            ExecSetVarValue es, varName, varValue
            ExecSetVarDeclMeta es, varName, declType, 1, 1, lowerBound, upperBound, totalBytes
            If ExecArrayResizeVar(es, varName, lowerBound, upperBound, 0) = 0 Then
                errText = "DIM: array storage init failed"
                Return 0
            End If

            If aggregateArrayElem <> 0 Then
                Dim arrVarIdx As Integer
                arrVarIdx = ExecFindVar(es, varName)
                If arrVarIdx = -1 Then
                    errText = "DIM: aggregate array variable allocation failed " & varName
                    Return 0
                End If

                Dim arrBase As UInteger
                arrBase = es.nextVarAddr
                es.vars(arrVarIdx).addr = arrBase

                If VMemFillB(arrBase, 0, CUInt(totalBytes)) = 0 Then
                    errText = "DIM: aggregate array allocation out of range"
                    Return 0
                End If

                Dim arrEnd As UInteger
                arrEnd = arrBase + CUInt(totalBytes)
                If arrEnd > es.nextVarAddr Then es.nextVarAddr = arrEnd
            End If
        Else
            Dim initNode As Integer
            initNode = ExecFindChildByKind(ps, declNode, "INIT_EXPR")
            If declType = "LIST" Or declType = "DICT" Or declType = "SET" Then
                Dim collHandle As Integer
                collHandle = ExecCollectionCreate(declType)
                ExecValueSetInteger varValue, collHandle
            ElseIf declType = "TASKGROUP" Then
                ' S-030: TASKGROUP, LIST/DICT/SET gibi bos-ama-kullanima-hazir bir
                ' konteynerdir -- TASK'in aksine (SPAWN'a kadar NULL kalir, S-108 ile
                ' ayni cizgide), TASKGROUP NEW/SPAWN gerektirmez.
                Dim taskGroupHandle As Integer
                taskGroupHandle = ExecTaskGroupAlloc()
                ExecValueSetInteger varValue, taskGroupHandle
            ElseIf declType = "MUTEX" Then
                ' S-146 Model D: her MUTEX bildirimi kendi kilidini (kimlik) alir -- MIR/native ile ayni.
                ExecValueSetInteger varValue, ExecMutexNew()
            ElseIf ExecFindClassDeclNode(ps, declType) <> -1 Or ExecFindInterfaceDeclNode(ps, declType) <> -1 Or declType = "OBJECT" Then
                If initNode <> -1 Then
                    If ps.ast.nodes(initNode).left = -1 Then
                        errText = "DIM: invalid class initializer"
                        Return 0
                    End If

                    Dim initExprNode As Integer
                    initExprNode = ps.ast.nodes(initNode).left
                    If UCase(ps.ast.nodes(initExprNode).kind) <> "NEW_EXPR" Then
                        errText = "DIM: class initializer must be NEW " & declType
                        Return 0
                    End If

                    Dim newType As String
                    newType = UCase(Trim(ps.ast.nodes(initExprNode).value))
                    If ExecCanAssignClassType(ps, declType, newType) = 0 Then
                        errText = "DIM: class initializer type mismatch expected=" & declType & " actual=" & newType
                        Return 0
                    End If

                    Dim initValue As ExecValue
                    If ExecEvalExpression(ps, initExprNode, es, initValue, errText) = 0 Then Return 0
                    varValue = initValue
                End If
            ElseIf initNode <> -1 Then
                If ps.ast.nodes(initNode).left = -1 Then
                    errText = "DIM: invalid initializer"
                    Return 0
                End If

                Dim initValue As ExecValue
                If ExecEvalExpression(ps, ps.ast.nodes(initNode).left, es, initValue, errText) = 0 Then Return 0
                varValue = initValue
            End If

            ExecSetVarValue es, varName, varValue
            ExecSetVarDeclMeta es, varName, declType, 0, 0, 0, 0, 0
            Dim aggregateSize As Integer
            Dim aggregateErr As String
            Dim hasAggregateLayout As Integer
            hasAggregateLayout = 0
            If TypeLayoutSizeOf(ps, declType, aggregateSize, aggregateErr) <> 0 Then
                If ExecFindClassDeclNode(ps, declType) = -1 And ExecFindInterfaceDeclNode(ps, declType) = -1 And declType <> "OBJECT" Then
                    hasAggregateLayout = 1
                End If
            End If

            If hasAggregateLayout <> 0 Then
                Dim aggVarIdx As Integer
                aggVarIdx = ExecFindVar(es, varName)
                If aggVarIdx = -1 Then
                    errText = "DIM: aggregate variable allocation failed " & varName
                    Return 0
                End If
                If VMemFillB(es.vars(aggVarIdx).addr, 0, CUInt(aggregateSize)) = 0 Then
                    errText = "DIM: aggregate allocation out of range"
                    Return 0
                End If
                Dim aggEnd As UInteger
                aggEnd = es.vars(aggVarIdx).addr + CUInt(aggregateSize)
                If aggEnd > es.nextVarAddr Then es.nextVarAddr = aggEnd
            ElseIf ExecFindClassDeclNode(ps, declType) <> -1 Then
                If initNode <> -1 Then
                    ExecSetVarAddr es, varName, CUInt(ExecValueToInteger(varValue))
                    Dim initExprNode2 As Integer
                    initExprNode2 = ps.ast.nodes(initNode).left
                    If initExprNode2 <> -1 Then
                        es.vars(ExecFindVar(es, varName)).runtimeClassType = UCase(Trim(ps.ast.nodes(initExprNode2).value))
                    End If
                Else
                    ' S-108 (Mete's decision, 2026-09-20): a CLASS variable is a REFERENCE; `DIM a AS Animal`
                    ' makes a NULL reference and the object exists only after `= NEW ...`. (It used to
                    ' allocate and construct a default object here, which `a = NEW Dog()` then leaked.)
                    es.vars(ExecFindVar(es, varName)).runtimeClassType = ""
                    ExecSetVarAddr es, varName, 0
                End If
            ElseIf ExecFindInterfaceDeclNode(ps, declType) <> -1 Then
                If initNode <> -1 Then
                    ExecSetVarAddr es, varName, CUInt(ExecValueToInteger(varValue))
                    Dim initExprNodeIface As Integer
                    initExprNodeIface = ps.ast.nodes(initNode).left
                    If initExprNodeIface <> -1 Then
                        es.vars(ExecFindVar(es, varName)).runtimeClassType = UCase(Trim(ps.ast.nodes(initExprNodeIface).value))
                    End If
                Else
                    es.vars(ExecFindVar(es, varName)).runtimeClassType = ""
                    ExecSetVarAddr es, varName, 0
                End If
            ElseIf declType = "OBJECT" Then
                If initNode <> -1 Then
                    ExecSetVarAddr es, varName, CUInt(ExecValueToInteger(varValue))
                    Dim initExprNode3 As Integer
                    initExprNode3 = ps.ast.nodes(initNode).left
                    If initExprNode3 <> -1 Then
                        es.vars(ExecFindVar(es, varName)).runtimeClassType = UCase(Trim(ps.ast.nodes(initExprNode3).value))
                    End If
                End If
            End If
        End If
    Next declPos

    Return 1
End Function

' REDIM execution contract
Function ExecEvalREDIM(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef es As ExecState, ByRef errText As String) As Integer
    ' REDIM decl[, decl...] where each decl is REDIM_DECL DIM_BOUNDS TYPE_REF
    Dim preserveMode As Integer
    preserveMode = (UCase(Trim(ps.ast.nodes(nodeIdx).op)) = "PRESERVE")

    Dim childCount As Integer
    childCount = ExecChildCount(ps, nodeIdx)
    If childCount < 1 Then
        errText = "REDIM: declaration required"
        Return 0
    End If

    Dim declPos As Integer
    For declPos = 0 To childCount - 1
        Dim declNode As Integer
        declNode = ExecChildAt(ps, nodeIdx, declPos)
        If declNode = -1 Then
            errText = "REDIM: declaration node missing"
            Return 0
        End If

        If UCase(ps.ast.nodes(declNode).kind) <> "REDIM_DECL" Then
            errText = "REDIM: invalid declaration node"
            Return 0
        End If

        Dim varName As String
        varName = UCase(Trim(ps.ast.nodes(declNode).value))
        If varName = "" Then
            errText = "REDIM: invalid variable name"
            Return 0
        End If

        Dim varIdx As Integer
        varIdx = ExecFindVar(es, varName)
        If varIdx = -1 Then
            errText = "REDIM: variable not declared " & varName
            Return 0
        End If

        If es.vars(varIdx).isArray = 0 Or es.vars(varIdx).value.valueType <> "ARRAY" Then
            errText = "REDIM: target is not array " & varName
            Return 0
        End If

        Dim typeNode As Integer
        typeNode = ExecFindChildByKind(ps, declNode, "TYPE_REF")
        If typeNode = -1 Then
            errText = "REDIM: type reference missing"
            Return 0
        End If

        Dim redimType As String
        redimType = ExecNormalizeTypeName(ps.ast.nodes(typeNode).value)
        If redimType = "" Then
            errText = "REDIM: invalid type"
            Return 0
        End If

        Dim declTypeNorm As String
        declTypeNorm = ExecNormalizeTypeName(es.vars(varIdx).declType)
        If declTypeNorm <> "" And redimType <> declTypeNorm Then
            errText = "REDIM: type mismatch for " & varName
            Return 0
        End If

        Dim boundsNode As Integer
        boundsNode = ExecFindChildByKind(ps, declNode, "DIM_BOUNDS")
        If boundsNode = -1 Then
            errText = "REDIM: array bounds required"
            Return 0
        End If

        Dim dimCount As Integer
        dimCount = ExecChildCount(ps, boundsNode)
        If dimCount < 1 Then
            errText = "REDIM: at least one dimension required"
            Return 0
        End If

        ' S-035 follow-up: mirror DIM's fallback (above, ExecEvalDIM) for
        ' element types ExecTypeElemSizeBytes doesn't cover (STRING, TYPE/
        ' class aggregates) -- without this, REDIM/REDIM PRESERVE on a
        ' STRING array failed unconditionally even though the real resize
        ' (ExecArrayResizeVar below) fully supports STRING elements, since
        ' elemSize/totalBytes here are only used for an overflow sanity
        ' check and declaration metadata, never for the actual allocation.
        Dim elemSize As Integer
        elemSize = ExecTypeElemSizeBytes(redimType)
        If elemSize <= 0 Then
            Dim redimAggElemErr As String
            TypeLayoutSizeOf ps, redimType, elemSize, redimAggElemErr
        End If
        If elemSize <= 0 Then
            errText = "REDIM: unsupported array element type " & redimType
            Return 0
        End If

        Dim totalElements As LongInt
        totalElements = 1
        Dim firstLower As Integer
        Dim firstUpper As Integer
        firstLower = 0
        firstUpper = -1

        Dim dimPos As Integer
        For dimPos = 0 To dimCount - 1
            Dim boundExpr As Integer
            boundExpr = ExecChildAt(ps, boundsNode, dimPos)
            If boundExpr = -1 Then
                errText = "REDIM: array bound missing"
                Return 0
            End If

            Dim lowerBound As Integer
            Dim upperBound As Integer
            If ExecParseBoundRange(ps, es, boundExpr, lowerBound, upperBound, errText) = 0 Then Return 0

            Dim extent As LongInt
            extent = CLng(upperBound) - CLng(lowerBound) + 1
            If extent <= 0 Then
                errText = "REDIM: invalid array extent"
                Return 0
            End If

            If dimPos = 0 Then
                firstLower = lowerBound
                firstUpper = upperBound
            End If

            If totalElements > &h7FFFFFFF \ extent Then
                errText = "REDIM: array byte overflow"
                Return 0
            End If
            totalElements *= extent
        Next dimPos

        Dim totalBytes As LongInt
        totalBytes = totalElements * CLng(elemSize)
        If totalBytes <= 0 Or totalBytes > &h7FFFFFFF Then
            errText = "REDIM: array byte overflow"
            Return 0
        End If

        Dim newValue As ExecValue
        ExecValueInit newValue
        newValue.valueType = "ARRAY"

        es.vars(varIdx).value = newValue
        If ExecArrayResizeVar(es, varName, firstLower, firstUpper, preserveMode) = 0 Then
            errText = "REDIM: array storage resize failed"
            Return 0
        End If
        ExecSetVarDeclMeta es, varName, redimType, 1, dimCount, firstLower, firstUpper, totalBytes
    Next declPos

    Return 1
End Function

' DEF* execution contract
Function ExecEvalDEF(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef es As ExecState, ByRef errText As String) As Integer
    ' DEFINT/DEFLNG/DEFSNG/DEFDBL/DEFEXT/DEFSTR/DEFBYT varlist
    Dim stmtKind As String
    stmtKind = UCase(ps.ast.nodes(nodeIdx).kind)

    If stmtKind = "DEFTYPE_STMT" Then
        stmtKind = UCase(Trim(ps.ast.nodes(nodeIdx).op))
    End If

    Dim typeChar As String
    Dim typeName As String

    Select Case stmtKind
    Case "DEFINT", "DEFINT_STMT"
        typeChar = "I"
        typeName = "INTEGER"
    Case "DEFLNG", "DEFLNG_STMT"
        typeChar = "L"
        typeName = "LONG"
    Case "DEFSNG", "DEFSNG_STMT"
        typeChar = "S"
        typeName = "SINGLE"
    Case "DEFDBL", "DEFDBL_STMT"
        typeChar = "D"
        typeName = "DOUBLE"
    Case "DEFEXT", "DEFEXT_STMT"
        typeChar = "E"
        typeName = "EXTENDED"
    Case "DEFSTR", "DEFSTR_STMT"
        typeChar = "T"
        typeName = "STRING"
    Case "DEFBYT", "DEFBYT_STMT"
        typeChar = "B"
        typeName = "I8"
    Case Else
        errText = "DEF: Bilinmeyen DEF türü: " & stmtKind
        Return 0
    End Select

    ' Add to def type table
    If es.defTypeCount = 0 Then
        ReDim es.defTypes(0)
    Else
        ReDim Preserve es.defTypes(es.defTypeCount)
    End If

    es.defTypes(es.defTypeCount).typeChar = typeChar
    es.defTypes(es.defTypeCount).typeName = typeName
    es.defTypeCount += 1
    gExecDebugLastDefTypeCount = es.defTypeCount

    Return 1
End Function

' SETSTRINGSIZE execution contract
Function ExecEvalSETSTRINGSIZE(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef es As ExecState, ByRef errText As String) As Integer
    ' SETSTRINGSIZE size
    Dim childCount As Integer
    childCount = ExecChildCount(ps, nodeIdx)
    If childCount < 1 Then
        errText = "SETSTRINGSIZE: Boyut değeri gerekli"
        Return 0
    End If

    Dim sizeNode As Integer
    sizeNode = ExecChildAt(ps, nodeIdx, 0)
    If sizeNode = -1 Then
        errText = "SETSTRINGSIZE: Boyut düğümü bulunamadı"
        Return 0
    End If

    Dim sizeValue As Integer
    sizeValue = ExecEvalNode(ps, es, sizeNode, errText)
    If errText <> "" Then Return 0

    If sizeValue <= 0 Then
        errText = "SETSTRINGSIZE: Boyut pozitif olmalı"
        Return 0
    End If

    es.stringSize = sizeValue
    gExecDebugLastStringSize = es.stringSize
    Return 1
End Function

Private Function ExecBinaryOperatorTokenToRoutineSuffix(ByRef opRaw As String, ByRef suffixOut As String) As Integer
    Dim opText As String
    opText = UCase(Trim(opRaw))
    suffixOut = ""

    Select Case opText
    Case "+", "ADD", "OP_ADD"
        suffixOut = "OP_ADD"
    Case "-", "SUB", "OP_SUB"
        suffixOut = "OP_SUB"
    Case "*", "MUL", "OP_MUL"
        suffixOut = "OP_MUL"
    Case "/", "DIV", "OP_DIV"
        suffixOut = "OP_DIV"
    Case "\", "IDIV", "OP_IDIV"
        suffixOut = "OP_IDIV"
    Case "%", "MOD", "OP_MOD"
        suffixOut = "OP_MOD"
    Case "&", "BAND", "OP_BAND"
        suffixOut = "OP_BAND"
    Case "|", "BOR", "OP_BOR"
        suffixOut = "OP_BOR"
    Case "AND", "OP_AND"
        suffixOut = "OP_AND"
    Case "OR", "OP_OR"
        suffixOut = "OP_OR"
    Case "XOR", "OP_XOR", "^"
        suffixOut = "OP_XOR"
    Case "<<", "SHL", "OP_SHL"
        suffixOut = "OP_SHL"
    Case ">>", "SHR", "OP_SHR"
        suffixOut = "OP_SHR"
    Case "ROL", "OP_ROL"
        suffixOut = "OP_ROL"
    Case "ROR", "OP_ROR"
        suffixOut = "OP_ROR"
    Case "=", "==", "OP_EQ"
        suffixOut = "OP_EQ"
    Case "<>", "!=", "OP_NE"
        suffixOut = "OP_NE"
    Case "<", "OP_LT"
        suffixOut = "OP_LT"
    Case "<=", "OP_LE"
        suffixOut = "OP_LE"
    Case ">", "OP_GT"
        suffixOut = "OP_GT"
    Case ">=", "OP_GE"
        suffixOut = "OP_GE"
    End Select

    If suffixOut = "" Then
        Dim cleaned As String
        cleaned = ""
        Dim i As Integer
        For i = 1 To Len(opText)
            Dim ch As String
            ch = Mid(opText, i, 1)
            If (ch >= "A" And ch <= "Z") Or (ch >= "0" And ch <= "9") Then cleaned &= ch
        Next i
        If cleaned <> "" Then suffixOut = "OP_" & cleaned
    End If

    Return IIf(suffixOut <> "", 1, 0)
End Function

Private Function ExecMagicOperatorRoutineNameBySuffix(ByRef suffixRaw As String, ByRef magicOut As String) As Integer
    Dim suffixUpper As String
    suffixUpper = UCase(Trim(suffixRaw))
    magicOut = ""

    ' Runtime magic names follow the parser/semantic canonical surface.
    ' CLASS OPERATOR & may still compile to OP_BAND, but MAGIC uses MAGIC_AND.
    ' CLASS OPERATOR | may still compile to OP_BOR, but MAGIC uses MAGIC_OR.
    Select Case suffixUpper
    Case "OP_ADD"
        magicOut = "MAGIC_ADD"
    Case "OP_SUB"
        magicOut = "MAGIC_SUB"
    Case "OP_MUL"
        magicOut = "MAGIC_MUL"
    Case "OP_DIV"
        magicOut = "MAGIC_DIV"
    Case "OP_IDIV"
        magicOut = "MAGIC_IDIV"
    Case "OP_MOD"
        magicOut = "MAGIC_MOD"
    Case "OP_AND", "OP_BAND"
        magicOut = "MAGIC_AND"
    Case "OP_OR", "OP_BOR"
        magicOut = "MAGIC_OR"
    Case "OP_XOR"
        magicOut = "MAGIC_XOR"
    Case "OP_SHL"
        magicOut = "MAGIC_SHL"
    Case "OP_SHR"
        magicOut = "MAGIC_SHR"
    Case "OP_ROL"
        magicOut = "MAGIC_ROL"
    Case "OP_ROR"
        magicOut = "MAGIC_ROR"
    Case "OP_EQ"
        magicOut = "MAGIC_EQ"
    Case "OP_NE"
        magicOut = "MAGIC_NE"
    Case "OP_LT"
        magicOut = "MAGIC_LT"
    Case "OP_LE"
        magicOut = "MAGIC_LE"
    Case "OP_GT"
        magicOut = "MAGIC_GT"
    Case "OP_GE"
        magicOut = "MAGIC_GE"
    End Select

    Return IIf(magicOut <> "", 1, 0)
End Function

Private Function ExecMagicRoutineDunderAlias(ByRef magicRaw As String, ByRef aliasOut As String) As Integer
    Dim magicUpper As String
    magicUpper = UCase(Trim(magicRaw))
    aliasOut = ""

    If Left(magicUpper, 6) <> "MAGIC_" Then Return 0
    aliasOut = "__" & Mid(magicUpper, 7)
    Return 1
End Function

Private Function ExecResolveMagicRoutineInHierarchy(ByRef ps As ParseState, ByRef es As ExecState, ByRef startTypeRaw As String, ByRef magicNameRaw As String, ByRef routineIdxOut As Integer) As Integer
    routineIdxOut = -1

    Dim curType As String
    curType = UCase(Trim(startTypeRaw))
    Dim magicName As String
    magicName = UCase(Trim(magicNameRaw))
    If curType = "" Or magicName = "" Then Return 0

    Dim dunderAlias As String
    dunderAlias = ""
    ExecMagicRoutineDunderAlias magicName, dunderAlias

    Dim hop As Integer
    Do While curType <> ""
        hop += 1
        If hop > 64 Then Exit Do

        routineIdxOut = ExecRoutineIndexOf(es, curType & "_" & magicName)
        If routineIdxOut <> -1 Then Return 1

        If dunderAlias <> "" Then
            routineIdxOut = ExecRoutineIndexOf(es, curType & "_" & dunderAlias)
            If routineIdxOut <> -1 Then Return 1
        End If

        Dim nextBase As String
        If ExecGetClassBaseTypeByName(ps, curType, nextBase) = 0 Then Exit Do
        curType = nextBase
    Loop

    routineIdxOut = -1
    Return 0
End Function

Private Function ExecNormalizeMagicHookName(ByRef hookNameRaw As String, ByRef magicNameOut As String) As Integer
    Dim h As String
    h = UCase(Trim(hookNameRaw))
    magicNameOut = ""
    If h = "" Then Return 0

    If Left(h, 2) = "__" Then
        h = Mid(h, 3)
    ElseIf Left(h, 6) = "MAGIC_" Then
        h = Mid(h, 7)
    End If
    If h = "" Then Return 0

    Dim i As Integer
    For i = 1 To Len(h)
        Dim ch As String
        ch = Mid(h, i, 1)
        If (ch >= "A" And ch <= "Z") Or (ch >= "0" And ch <= "9") Or ch = "_" Then
            Continue For
        End If
        Return 0
    Next i

    magicNameOut = "MAGIC_" & h
    Return 1
End Function

Private Function ExecResolveNamedMagicRoutineInHierarchy(ByRef ps As ParseState, ByRef es As ExecState, ByRef startTypeRaw As String, ByRef hookNameRaw As String, ByRef routineIdxOut As Integer) As Integer
    routineIdxOut = -1

    Dim magicName As String
    If ExecNormalizeMagicHookName(hookNameRaw, magicName) = 0 Then Return 0

    Return ExecResolveMagicRoutineInHierarchy(ps, es, startTypeRaw, magicName, routineIdxOut)
End Function

Private Function ExecGetClassBaseTypeByName(ByRef ps As ParseState, ByRef classTypeNameRaw As String, ByRef baseTypeOut As String) As Integer
    baseTypeOut = ""
    Dim classTypeName As String
    classTypeName = UCase(Trim(classTypeNameRaw))
    If classTypeName = "" Then Return 0

    Dim classNode As Integer
    classNode = ExecFindClassDeclNode(ps, classTypeName)
    If classNode = -1 Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(classNode).firstChild
    Do While ch <> -1
        If UCase(ps.ast.nodes(ch).kind) = "CLASS_BASE_REF" Then
            baseTypeOut = UCase(Trim(ps.ast.nodes(ch).value))
            Return IIf(baseTypeOut <> "", 1, 0)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function ExecTryResolveRuntimeClassByObjectAddr(ByRef ps As ParseState, ByRef es As ExecState, ByVal objectAddr As UInteger, ByRef classTypeOut As String) As Integer
    classTypeOut = ""
    If objectAddr = 0 Then Return 0

    Dim vtableHandle As UInteger
    vtableHandle = CUInt(VMemPeekD(objectAddr))
    If vtableHandle = 0 Then Return 0

    Dim resolvedClass As String
    resolvedClass = ""
    If ExecFindRuntimeVTableClassByHandle(es, vtableHandle, resolvedClass) = 0 Then Return 0

    resolvedClass = UCase(Trim(resolvedClass))
    If resolvedClass = "" Then Return 0
    If ExecFindClassDeclNode(ps, resolvedClass) = -1 Then Return 0

    classTypeOut = resolvedClass
    Return 1
End Function

Private Function ExecTryResolveBinaryReceiver(ByRef ps As ParseState, ByRef es As ExecState, ByVal lhsNodeIdx As Integer, ByRef lhsValue As ExecValue, ByRef receiverTypeOut As String, ByRef receiverAddrOut As Integer) As Integer
    receiverTypeOut = ""
    receiverAddrOut = 0
    If lhsNodeIdx < 0 Or lhsNodeIdx >= ps.ast.count Then Return 0

    Dim lhsKind As String
    lhsKind = UCase(Trim(ps.ast.nodes(lhsNodeIdx).kind))
    If lhsKind <> "IDENT" And lhsKind <> "KEYWORD_REF" And lhsKind <> "FIELD_EXPR" Then Return 0

    If lhsKind = "FIELD_EXPR" Then
        Dim fieldAddr As UInteger
        Dim fieldType As String
        Dim fieldSize As Integer
        Dim rootType As String
        Dim rootAddr As UInteger
        Dim pathText As String
        Dim fieldErr As String
        fieldErr = ""
        If ExecResolveFieldAccess(ps, es, lhsNodeIdx, fieldAddr, fieldType, fieldSize, rootType, rootAddr, pathText, fieldErr) = 0 Then Return 0

        fieldType = UCase(Trim(fieldType))
        If fieldType <> "" And fieldType <> "OBJECT" And ExecFindClassDeclNode(ps, fieldType) <> -1 Then
            receiverTypeOut = fieldType
        End If

        receiverAddrOut = ExecValueToInteger(lhsValue)
        ' CLASS fields store object references.  A zero value is a null
        ' receiver; the address of the field slot is not an object instance.
        If receiverAddrOut = 0 Then Return 0

        If receiverTypeOut = "" Or receiverTypeOut = "OBJECT" Or ExecFindClassDeclNode(ps, receiverTypeOut) = -1 Then
            Dim inferredFieldType As String
            inferredFieldType = ""
            If ExecTryResolveRuntimeClassByObjectAddr(ps, es, CUInt(receiverAddrOut), inferredFieldType) <> 0 Then
                receiverTypeOut = inferredFieldType
            End If
        End If

        If receiverTypeOut = "" Or ExecFindClassDeclNode(ps, receiverTypeOut) = -1 Then Return 0
        If receiverAddrOut = 0 Then Return 0
        Return 1
    End If

    Dim ownerName As String
    ownerName = UCase(Trim(ps.ast.nodes(lhsNodeIdx).value))
    If ownerName = "" Then Return 0

    Dim receiverIdx As Integer
    receiverIdx = ExecFindVar(es, ownerName)
    If receiverIdx = -1 Then Return 0

    If es.vars(receiverIdx).runtimeClassType <> "" Then
        receiverTypeOut = UCase(Trim(es.vars(receiverIdx).runtimeClassType))
    Else
        receiverTypeOut = UCase(Trim(es.vars(receiverIdx).declType))
    End If

    receiverAddrOut = ExecGetVar(es, ownerName)
    If receiverAddrOut = 0 Then receiverAddrOut = CInt(es.vars(receiverIdx).addr)
    If receiverAddrOut = 0 Then Return 0

    If receiverTypeOut = "" Or receiverTypeOut = "OBJECT" Or ExecFindClassDeclNode(ps, receiverTypeOut) = -1 Then
        Dim inferredIdentType As String
        inferredIdentType = ""
        If ExecTryResolveRuntimeClassByObjectAddr(ps, es, CUInt(receiverAddrOut), inferredIdentType) <> 0 Then
            receiverTypeOut = inferredIdentType
        End If
    End If

    If receiverTypeOut = "" Or ExecFindClassDeclNode(ps, receiverTypeOut) = -1 Then Return 0
    Return 1
End Function

Private Function ExecResolveOperatorRoutineInHierarchy(ByRef ps As ParseState, ByRef es As ExecState, ByRef startTypeRaw As String, ByRef suffixRaw As String, ByRef routineIdxOut As Integer) As Integer
    routineIdxOut = -1

    Dim curType As String
    curType = UCase(Trim(startTypeRaw))
    Dim suffix As String
    suffix = UCase(Trim(suffixRaw))
    If curType = "" Or suffix = "" Then Return 0

    Dim hop As Integer
    Do While curType <> ""
        hop += 1
        If hop > 64 Then Exit Do

        Dim routineName As String
        routineName = curType & "_" & suffix
        routineIdxOut = ExecRoutineIndexOf(es, routineName)
        If routineIdxOut <> -1 Then Return 1

        If suffix = "OP_ADD" Then
            routineIdxOut = ExecRoutineIndexOf(es, curType & "_ADD")
            If routineIdxOut <> -1 Then Return 1
        End If

        Dim magicRoutineName As String
        magicRoutineName = ""
        If ExecMagicOperatorRoutineNameBySuffix(suffix, magicRoutineName) <> 0 Then
            routineIdxOut = ExecRoutineIndexOf(es, curType & "_" & magicRoutineName)
            If routineIdxOut <> -1 Then Return 1

            Dim dunderAlias As String
            dunderAlias = ""
            If ExecMagicRoutineDunderAlias(magicRoutineName, dunderAlias) <> 0 Then
                routineIdxOut = ExecRoutineIndexOf(es, curType & "_" & dunderAlias)
                If routineIdxOut <> -1 Then Return 1
            End If
        End If

        Dim nextBase As String
        If ExecGetClassBaseTypeByName(ps, curType, nextBase) = 0 Then Exit Do
        curType = nextBase
    Loop

    routineIdxOut = -1
    Return 0
End Function

Private Function ExecTryEvalOverloadedBinary(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef leftVal As ExecValue, ByRef rightVal As ExecValue, ByRef opText As String, ByRef result As ExecValue, ByRef errText As String) As Integer
    Dim opSuffix As String
    If ExecBinaryOperatorTokenToRoutineSuffix(opText, opSuffix) = 0 Then Return -1

    Dim lhsNode As Integer
    lhsNode = ps.ast.nodes(nodeIdx).left
    If lhsNode = -1 Then lhsNode = ExecChildAt(ps, nodeIdx, 0)
    If lhsNode = -1 Then Return -1

    Dim receiverType As String
    Dim receiverAddr As Integer
    If ExecTryResolveBinaryReceiver(ps, es, lhsNode, leftVal, receiverType, receiverAddr) = 0 Then Return -1

    Dim routineIdx As Integer
    If ExecResolveOperatorRoutineInHierarchy(ps, es, receiverType, opSuffix, routineIdx) = 0 Then Return -1

    Dim preparedArgs(0 To 0) As Integer
    preparedArgs(0) = ExecValueToInteger(rightVal)

    Dim callResult As Integer
    If ExecInvokeRoutineByPreparedArgs(ps, es, routineIdx, preparedArgs(), 1, 1, 1, receiverAddr, callResult, errText) = 0 Then Return 0

    ExecValueSetInteger result, callResult
    Return 1
End Function

' S-077: integer-class values are the ones the AST interpreter carries as
' full-width machine integers: plain INTEGER (host Integer, 64-bit), I64_VALUE
' and U64_PTR (unsigned 64-bit pattern in u64Value).
Private Function ExecIsIntegerClass(ByRef ev As ExecValue) As Integer
    Select Case ev.valueType
    Case "INTEGER", "I64_VALUE", "U64_PTR"
        Return 1
    End Select
    Return 0
End Function

' S-077: the single 64-bit integer implementation of the binary operators.
' Both operands are read as raw 64-bit patterns (a plain INTEGER sign-extends),
' the operation is done modulo 2^64, and the STATIC type of the expression
' chooses the interpretation, exactly like the compiled engines:
'   u64Flags bit0 : an operand's static type is U64  -> unsigned \, MOD, ordering, U64 result
'   u64Flags bit1 : the LEFT operand's static type is U64 -> logical >>, U64 result of a shift
' Returns 1 = handled, 0 = error (errText set), -1 = not an integer operator.
Private Function ExecEvalBinaryInt64(ByRef leftVal As ExecValue, ByRef rightVal As ExecValue, ByRef opText As String, ByVal u64Flags As Integer, ByRef result As ExecValue, ByRef errText As String) As Integer
    Dim ua As ULongInt = ExecValueToU64(leftVal)
    Dim ub As ULongInt = ExecValueToU64(rightVal)
    Dim sa As LongInt = CLngInt(ua)
    Dim sb As LongInt = CLngInt(ub)
    Dim unsignedOp As Integer = IIf((u64Flags And 1) <> 0, 1, 0)
    Dim leftIsU64 As Integer = IIf((u64Flags And 2) <> 0, 1, 0)
    Dim outBits As ULongInt
    Dim isCompare As Integer = 0
    Dim compareTrue As Integer = 0
    Dim isShift As Integer = 0

    Select Case UCase(opText)
    Case "+"
        outBits = ua + ub
    Case "-"
        outBits = ua - ub
    Case "*"
        outBits = ua * ub
    Case "\"
        If ub = 0 Then errText = "Expression: sıfıra bölme": Return 0
        If unsignedOp <> 0 Then
            outBits = ua \ ub
        ElseIf sb = -1 Then
            outBits = 0ULL - ua
        Else
            outBits = CULngInt(sa \ sb)
        End If
    Case "%", "MOD"
        If ub = 0 Then errText = "Expression: mod sıfır": Return 0
        If unsignedOp <> 0 Then
            outBits = ua Mod ub
        ElseIf sb = -1 Then
            outBits = 0
        Else
            outBits = CULngInt(sa Mod sb)
        End If
    Case "&", "AND"
        outBits = ua And ub
    Case "|", "OR"
        outBits = ua Or ub
    Case "XOR"
        outBits = ua Xor ub
    Case "<<", "SHL"
        isShift = 1
        outBits = ua Shl CInt(ub And 63)
    Case ">>", "SHR"
        isShift = 1
        If leftIsU64 <> 0 Then
            outBits = ua Shr CInt(ub And 63)
        Else
            ' arithmetic shift: replicate the sign bit
            Dim sarCount As Integer = CInt(ub And 63)
            If sarCount = 0 Then
                outBits = ua
            ElseIf sa >= 0 Then
                outBits = ua Shr sarCount
            Else
                outBits = Not ((Not ua) Shr sarCount)
            End If
        End If
    Case "="
        isCompare = 1: compareTrue = IIf(ua = ub, 1, 0)
    Case "<>"
        isCompare = 1: compareTrue = IIf(ua <> ub, 1, 0)
    Case "<"
        isCompare = 1
        If unsignedOp <> 0 Then compareTrue = IIf(ua < ub, 1, 0) Else compareTrue = IIf(sa < sb, 1, 0)
    Case "<="
        isCompare = 1
        If unsignedOp <> 0 Then compareTrue = IIf(ua <= ub, 1, 0) Else compareTrue = IIf(sa <= sb, 1, 0)
    Case ">"
        isCompare = 1
        If unsignedOp <> 0 Then compareTrue = IIf(ua > ub, 1, 0) Else compareTrue = IIf(sa > sb, 1, 0)
    Case ">="
        isCompare = 1
        If unsignedOp <> 0 Then compareTrue = IIf(ua >= ub, 1, 0) Else compareTrue = IIf(sa >= sb, 1, 0)
    Case Else
        Return -1
    End Select

    If isCompare <> 0 Then
        ExecValueSetInteger result, IIf(compareTrue <> 0, -1, 0)
        Return 1
    End If

    ' Result representation: a shift keeps its left operand's type, every other
    ' operator follows the promoted operand type.
    If isShift <> 0 Then
        If leftIsU64 <> 0 Then
            ExecValueSetU64 result, outBits
        ElseIf leftVal.valueType = "I64_VALUE" Then
            ExecValueSetI64 result, CLngInt(outBits)
        Else
            ExecValueSetInteger result, CLngInt(outBits)
        End If
    ElseIf unsignedOp <> 0 Then
        ExecValueSetU64 result, outBits
    ElseIf leftVal.valueType = "I64_VALUE" Or rightVal.valueType = "I64_VALUE" Then
        ExecValueSetI64 result, CLngInt(outBits)
    Else
        ExecValueSetInteger result, CLngInt(outBits)
    End If
    Return 1
End Function

Private Function ExecEvalBinaryValues(ByRef leftVal As ExecValue, ByRef rightVal As ExecValue, ByRef opText As String, ByRef result As ExecValue, ByRef errText As String, ByVal u64Flags As Integer = 0) As Integer
    Dim bigResult As Integer
    bigResult = ExecBigEvalBinaryValues(leftVal, rightVal, opText, result, errText)
    If bigResult >= 0 Then Return bigResult

    ' S-077: every operator on two machine integers goes through the one 64-bit
    ' implementation (the per-operator code below is the float/string path).
    If ExecIsIntegerClass(leftVal) <> 0 And ExecIsIntegerClass(rightVal) <> 0 Then
        Dim int64Result As Integer
        int64Result = ExecEvalBinaryInt64(leftVal, rightVal, opText, u64Flags, result, errText)
        If int64Result >= 0 Then Return int64Result
    End If

    Select Case opText
    Case "+"
        If leftVal.valueType = "STRING" Or rightVal.valueType = "STRING" Then
            Dim concatText As String
            concatText = ExecValueToString(leftVal) & ExecValueToString(rightVal)
            ExecValueSetString result, concatText
        ElseIf leftVal.valueType = "INTEGER" And rightVal.valueType = "INTEGER" Then
            ExecValueSetInteger result, leftVal.intValue + rightVal.intValue
        ElseIf leftVal.valueType = "FLOAT" Or rightVal.valueType = "FLOAT" Then
            ExecValueSetFloat result, ExecValueToFloat(leftVal) + ExecValueToFloat(rightVal)
        Else
            errText = "Expression: + işlemi bu tipler için desteklenmiyor"
            Return 0
        End If
    Case "-"
        If leftVal.valueType = "INTEGER" And rightVal.valueType = "INTEGER" Then
            ExecValueSetInteger result, leftVal.intValue - rightVal.intValue
        Else
            ExecValueSetFloat result, ExecValueToFloat(leftVal) - ExecValueToFloat(rightVal)
        End If
    Case "*"
        If leftVal.valueType = "INTEGER" And rightVal.valueType = "INTEGER" Then
            ExecValueSetInteger result, leftVal.intValue * rightVal.intValue
        Else
            ExecValueSetFloat result, ExecValueToFloat(leftVal) * ExecValueToFloat(rightVal)
        End If
    Case "**"
        Dim powBase As Integer
        Dim powExp As Integer
        powBase = ExecValueToInteger(leftVal)
        powExp = ExecValueToInteger(rightVal)
        If powExp < 0 Then
            errText = "Expression: negative exponent not supported"
            Return 0
        End If
        Dim pi As Integer
        Dim pacc As Integer
        pacc = 1
        For pi = 1 To powExp
            pacc *= powBase
        Next pi
        ExecValueSetInteger result, pacc
    Case "/"
        If ExecValueToFloat(rightVal) = 0.0 Then
            errText = "Expression: sıfıra bölme"
            Return 0
        End If
        ExecValueSetFloat result, ExecValueToFloat(leftVal) / ExecValueToFloat(rightVal)
    Case "\"
        Dim divInt As Integer
        divInt = ExecValueToInteger(rightVal)
        If divInt = 0 Then
            errText = "Expression: sıfıra bölme"
            Return 0
        End If
        ExecValueSetInteger result, ExecValueToInteger(leftVal) \ divInt
    Case "%", "MOD"
        Dim modInt As Integer
        modInt = ExecValueToInteger(rightVal)
        If modInt = 0 Then
            errText = "Expression: mod sıfır"
            Return 0
        End If
        ExecValueSetInteger result, ExecValueToInteger(leftVal) Mod modInt
    Case "&"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) And ExecValueToInteger(rightVal)
    Case "|"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) Or ExecValueToInteger(rightVal)
    Case "AND"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) And ExecValueToInteger(rightVal)
    Case "OR"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) Or ExecValueToInteger(rightVal)
    Case "&&", "ANDALSO"
        ExecValueSetInteger result, IIf((ExecValueToInteger(leftVal) <> 0) And (ExecValueToInteger(rightVal) <> 0), -1, 0)
    Case "||", "ORELSE"
        ExecValueSetInteger result, IIf((ExecValueToInteger(leftVal) <> 0) Or (ExecValueToInteger(rightVal) <> 0), -1, 0)
    Case "XOR"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) Xor ExecValueToInteger(rightVal)
    Case "NAND"
        ExecValueSetInteger result, Not (ExecValueToInteger(leftVal) And ExecValueToInteger(rightVal))
    Case "NOR"
        ExecValueSetInteger result, Not (ExecValueToInteger(leftVal) Or ExecValueToInteger(rightVal))
    Case "XNOR"
        ExecValueSetInteger result, Not (ExecValueToInteger(leftVal) Xor ExecValueToInteger(rightVal))
    Case "IMP"
        ExecValueSetInteger result, (Not ExecValueToInteger(leftVal)) Or ExecValueToInteger(rightVal)
    Case "CIMP"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) Or (Not ExecValueToInteger(rightVal))
    Case "NIMP"
        ExecValueSetInteger result, ExecValueToInteger(leftVal) And (Not ExecValueToInteger(rightVal))
    Case "NCIMP"
        ExecValueSetInteger result, (Not ExecValueToInteger(leftVal)) And ExecValueToInteger(rightVal)
    Case "IDA"
        ExecValueSetInteger result, ExecValueToInteger(leftVal)
    Case "IDB"
        ExecValueSetInteger result, ExecValueToInteger(rightVal)
    Case "NOTA"
        ExecValueSetInteger result, Not ExecValueToInteger(leftVal)
    Case "NOTB"
        ExecValueSetInteger result, Not ExecValueToInteger(rightVal)
    Case "<<", "SHL"
        ExecValueSetInteger result, CInt(CUInt(ExecValueToInteger(leftVal)) Shl (ExecValueToInteger(rightVal) And 31))
    Case ">>", "SHR"
        ExecValueSetInteger result, ExecSar32(ExecValueToInteger(leftVal), ExecValueToInteger(rightVal))
    Case "ROL"
        ExecValueSetInteger result, CInt(ExecRol32(CUInt(ExecValueToInteger(leftVal)), ExecValueToInteger(rightVal)))
    Case "ROR"
        ExecValueSetInteger result, CInt(ExecRor32(CUInt(ExecValueToInteger(leftVal)), ExecValueToInteger(rightVal)))
    Case "="
        Dim cmp As Integer
        If leftVal.valueType = "INTEGER" And rightVal.valueType = "INTEGER" Then
            cmp = (leftVal.intValue = rightVal.intValue)
        ElseIf leftVal.valueType = "FLOAT" Or rightVal.valueType = "FLOAT" Then
            cmp = (ExecValueToFloat(leftVal) = ExecValueToFloat(rightVal))
        Else
            cmp = (leftVal.stringValue = rightVal.stringValue)
        End If
        ExecValueSetInteger result, cmp
    Case "<>"
        Dim cmpNe As Integer
        If leftVal.valueType = "INTEGER" And rightVal.valueType = "INTEGER" Then
            cmpNe = (leftVal.intValue <> rightVal.intValue)
        ElseIf leftVal.valueType = "FLOAT" Or rightVal.valueType = "FLOAT" Then
            cmpNe = (ExecValueToFloat(leftVal) <> ExecValueToFloat(rightVal))
        Else
            cmpNe = (ExecValueToString(leftVal) <> ExecValueToString(rightVal))
        End If
        ExecValueSetInteger result, cmpNe
    ' S-133: `<`/`>`/`<=`/`>=` never had a STRING branch (unlike `=`/`<>` right above, which already
    ' compare .stringValue) -- both sides went through ExecValueToFloat, which for a non-numeric string
    ' is Val()'s 0, so e.g. "abc" < "abd" compared 0 < 0 and was always false. Lexicographic (ordinal)
    ' comparison, matching FreeBASIC's own String `<`/`>` and every other engine's STR_COMPARE.
    Case "<"
        If leftVal.valueType = "STRING" Or rightVal.valueType = "STRING" Then
            ExecValueSetInteger result, IIf(ExecValueToString(leftVal) < ExecValueToString(rightVal), -1, 0)
        Else
            ExecValueSetInteger result, IIf(ExecValueToFloat(leftVal) < ExecValueToFloat(rightVal), -1, 0)
        End If
    Case ">"
        If leftVal.valueType = "STRING" Or rightVal.valueType = "STRING" Then
            ExecValueSetInteger result, IIf(ExecValueToString(leftVal) > ExecValueToString(rightVal), -1, 0)
        Else
            ExecValueSetInteger result, IIf(ExecValueToFloat(leftVal) > ExecValueToFloat(rightVal), -1, 0)
        End If
    Case "<="
        If leftVal.valueType = "STRING" Or rightVal.valueType = "STRING" Then
            ExecValueSetInteger result, IIf(ExecValueToString(leftVal) <= ExecValueToString(rightVal), -1, 0)
        Else
            ExecValueSetInteger result, IIf(ExecValueToFloat(leftVal) <= ExecValueToFloat(rightVal), -1, 0)
        End If
    Case ">="
        If leftVal.valueType = "STRING" Or rightVal.valueType = "STRING" Then
            ExecValueSetInteger result, IIf(ExecValueToString(leftVal) >= ExecValueToString(rightVal), -1, 0)
        Else
            ExecValueSetInteger result, IIf(ExecValueToFloat(leftVal) >= ExecValueToFloat(rightVal), -1, 0)
        End If
    Case Else
        errText = "Expression: Desteklenmeyen ikili işlem: " & opText
        Return 0
    End Select

    Return 1
End Function

' S-137: one-argument numeric builtins whose result depends on the WHOLE argument value.
' The integer-only scalar builtin path (ExecEvalBuiltinScalarCategory) rounds the argument to an
' Integer before computing, so the AST engine gave SQR(2.75)=2, SIN(2.75)=0, INT(2.75)=3 and
' INT(x*100)=300 for x=2.75 (canonical MIR and native x64 were right). An integer-class argument
' passes through INT/CINT unchanged (keeps its exact 64-bit value and type).
Private Function ExecApplyNumericBuiltin(ByVal builtinName As String, ByRef argValue As ExecValue, ByRef result As ExecValue, ByRef errText As String) As Integer
    Dim isIntArg As Integer
    Dim argFloat As Double
    isIntArg = ExecIsIntegerClass(argValue)
    argFloat = ExecValueToFloat(argValue)

    Select Case builtinName
    Case "INT", "CINT"
        If isIntArg <> 0 Then
            result = argValue
            Return 1
        End If
        If builtinName = "INT" Then argFloat = Int(argFloat) Else argFloat = CDbl(CLngInt(argFloat))
        If Abs(argFloat) < 9.2E18 Then
            ExecValueSetInteger result, CLngInt(argFloat)
        Else
            ExecValueSetFloat result, argFloat
        End If
    Case "SGN"
        If isIntArg <> 0 Then argFloat = CDbl(ExecValueToInteger(argValue))
        If argFloat < 0 Then
            ExecValueSetInteger result, -1
        ElseIf argFloat > 0 Then
            ExecValueSetInteger result, 1
        Else
            ExecValueSetInteger result, 0
        End If
    Case "SQR"
        If argFloat < 0 Then
            errText = "exec: SQR domain error"
            Return 0
        End If
        ExecValueSetFloat result, Sqr(argFloat)
    Case "SIN": ExecValueSetFloat result, Sin(argFloat)
    Case "COS": ExecValueSetFloat result, Cos(argFloat)
    Case "TAN": ExecValueSetFloat result, Tan(argFloat)
    Case "ATN": ExecValueSetFloat result, Atn(argFloat)
    Case "EXP": ExecValueSetFloat result, Exp(argFloat)
    Case "LOG"
        If argFloat <= 0 Then
            errText = "exec: LOG domain error"
            Return 0
        End If
        ExecValueSetFloat result, Log(argFloat)
    Case Else
        errText = "exec: unsupported numeric builtin " & builtinName
        Return 0
    End Select
    Return 1
End Function

' S-140: innermost NAMESPACE_STMT that contains a node (-1 when the node is not inside one).
Private Function ExecEnclosingNamespaceNode(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim guard As Integer = 0
    Dim anc As Integer = nodeIdx
    Do While anc >= 0 And anc < ps.ast.count And guard < 256
        If UCase(ps.ast.nodes(anc).kind) = "NAMESPACE_STMT" Then Return anc
        anc = ps.ast.nodes(anc).parent
        guard += 1
    Loop
    Return -1
End Function

' S-140: a CONST declared inside a NAMESPACE is visible, unqualified, to the routines of that
' namespace (`RETURN v + K` inside nsk.UsesK). The AST engine only ever registered consts it
' EXECUTED, and namespace bodies are never executed, so the lookup failed with "undefined
' variable K" (canonical MIR gave 11; native/legacy read an uninitialised cell). Resolved
' lexically: the innermost enclosing namespace of the running routine first, then outer ones;
' the constant's initializer is evaluated where it is used (a const initializer is a constant
' expression) and converted to the declared type when one is given.
Private Function ExecTryReadEnclosingNamespaceConst(ByRef ps As ParseState, ByRef es As ExecState, ByVal nameUpper As String, ByRef foundOut As Integer, ByRef result As ExecValue, ByRef errText As String) As Integer
    foundOut = 0
    If es.runtime.currentRoutineNodeIdx < 0 Then Return 1
    If UXBAstNameIndexEnsure(ps) = 0 Then Return 1
    Dim nsNode As Integer = ExecEnclosingNamespaceNode(ps, es.runtime.currentRoutineNodeIdx)
    Do While nsNode <> -1
        Dim ce As Integer = UXBAstNameIndexFirst(1, nameUpper)
        Do While ce <> -1
            Dim declNode As Integer = UXBAstNameIndexNode(ce)
            If UCase(ps.ast.nodes(declNode).kind) = "CONST_DECL" Then
                If ExecEnclosingNamespaceNode(ps, declNode) = nsNode Then
                    Dim initNode As Integer = ps.ast.nodes(declNode).left
                    If initNode = -1 Then initNode = ps.ast.nodes(declNode).firstChild
                    If initNode <> -1 Then
                        If ExecEvalExpression(ps, initNode, es, result, errText) = 0 Then Return 0
                        Dim typeChild As Integer = ps.ast.nodes(declNode).firstChild
                        Do While typeChild <> -1
                            If UCase(ps.ast.nodes(typeChild).kind) = "TYPE_REF" Then
                                Dim typed As ExecValue
                                If ExecApplyDeclaredType(result, UCase(Trim(ps.ast.nodes(typeChild).value)), typed, errText) = 0 Then Return 0
                                result = typed
                                Exit Do
                            End If
                            typeChild = ps.ast.nodes(typeChild).nextSibling
                        Loop
                        foundOut = 1
                        Return 1
                    End If
                End If
            End If
            ce = UXBAstNameIndexNext(ce)
        Loop
        nsNode = ExecEnclosingNamespaceNode(ps, ps.ast.nodes(nsNode).parent)
    Loop
    Return 1
End Function

' Helper: Evaluate expression (simplified)
Function ExecEvalExpression(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef es As ExecState, ByRef result As ExecValue, ByRef errText As String) As Integer
    If nodeIdx = -1 Then
        errText = "Expression: Geçersiz düğüm"
        Return 0
    End If

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)

    Select Case UCase(n.kind)
    Case "NUMBER"
        ' S-078: an integer literal is parsed EXACTLY (Val() goes through a Double:
        ' 53-bit mantissa, and an overflow at 2^63). A literal above I64 max is an
        ' unsigned 64-bit quantity. "&H/&O/&B" literals are integers even when
        ' their digits contain an 'E' (&HFE is not an exponent).
        If UXBNumberLiteralIsFloat(n.value) <> 0 Then
            ExecValueSetFloat result, Val(n.value)
        Else
            ' (The semantic constant folder writes a folded negative result back as
            ' "-1"-style literal text, so a leading '-' must stay a signed value.)
            If Left(Trim(n.value), 1) = "-" Then
                ExecValueSetInteger result, ValLng(n.value)
            Else
                Dim numberBits As ULongInt
                numberBits = ValULng(n.value)
                If numberBits > 9223372036854775807ULL Then
                    ExecValueSetU64 result, numberBits
                Else
                    ExecValueSetInteger result, CLngInt(numberBits)
                End If
            End If
        End If
        Return 1

    Case "STRING"
        ExecValueSetString result, n.value
        Return 1

    Case "BOOLEAN"
        ExecValueSetInteger result, IIf(UCase(Trim(n.value)) = "TRUE" Or Trim(n.value) = "-1", -1, 0)
        Return 1

    Case "IDENT", "KEYWORD_REF"
        Dim varName As String
        varName = UCase(n.value)
        If varName = "" Then varName = UCase(n.symbolName)
        If varName = "RND" Then
            ExecValueSetFloat result, UXBRngRnd(ExecCurrentTaskKey(), 0, 0)   ' S-163: ortak uretec, gorev basina
            Return 1
        End If
        If varName = "TIMER" Then
            ExecValueSetFloat result, Timer
            Return 1
        End If
        ' Check consts first (unless the running routine declares a parameter/local of that name: it shadows)
        Dim i As Integer
        If ExecCurrentFrameHasVar(es, varName) = 0 Then
            For i = 0 To es.constCount - 1
                If UCase(es.consts(i).nameText) = varName Then
                    result = es.consts(i).value
                    Return 1
                End If
            Next
        End If
        ' Then variables
        If ExecGetVarValue(es, varName, result) = 0 Then
            Dim implicitFound As Integer
            If ExecTryReadImplicitThisField(ps, es, varName, implicitFound, result, errText) = 0 Then Return 0
            If implicitFound <> 0 Then Return 1
            Dim namespaceConstFound As Integer
            If ExecTryReadEnclosingNamespaceConst(ps, es, varName, namespaceConstFound, result, errText) = 0 Then Return 0
            If namespaceConstFound <> 0 Then Return 1
            errText = "Expression: Tanımlanmamış değişken: " & varName
            Return 0
        End If
        Return 1

    Case "UNARY"
        Dim unaryNode As Integer
        unaryNode = n.left
        If unaryNode = -1 Then unaryNode = n.right
        If unaryNode = -1 Then
            errText = "Expression: unary operand missing"
            Return 0
        End If

        Dim rightVal As ExecValue
        If n.op <> "@" Then
            If ExecEvalExpression(ps, unaryNode, es, rightVal, errText) = 0 Then Return 0
        End If

        Select Case UCase(n.op)
        Case "+"
            result = rightVal
        Case "-"
            If rightVal.valueType = "FLOAT" Then
                ExecValueSetFloat result, -ExecValueToFloat(rightVal)
            ElseIf ExecIsIntegerClass(rightVal) <> 0 Then
                ' S-077: full 64-bit negation (ExecValueToInteger saturates at 32
                ' bits, so -(2^64-1) came out as -2147483647). The static type decides
                ' whether the result is the unsigned 64-bit magnitude.
                Dim negBits As ULongInt
                negBits = 0ULL - ExecValueToU64(rightVal)
                If rightVal.valueType = "U64_PTR" And UXBExprIsU64(ps, unaryNode) <> 0 Then
                    ExecValueSetU64 result, negBits
                ElseIf rightVal.valueType = "I64_VALUE" Then
                    ExecValueSetI64 result, CLngInt(negBits)
                Else
                    ExecValueSetInteger result, CLngInt(negBits)
                End If
            Else
                ExecValueSetInteger result, -ExecValueToInteger(rightVal)
            End If
        Case "LNOT", "!"
            ExecValueSetInteger result, IIf(ExecValueToInteger(rightVal) = 0, -1, 0)
        Case "NOT", "BNOT", "~", "BITNOT"
            If ExecIsIntegerClass(rightVal) <> 0 Then
                Dim notBits As ULongInt
                notBits = Not ExecValueToU64(rightVal)
                If rightVal.valueType = "U64_PTR" And UXBExprIsU64(ps, unaryNode) <> 0 Then
                    ExecValueSetU64 result, notBits
                ElseIf rightVal.valueType = "I64_VALUE" Then
                    ExecValueSetI64 result, CLngInt(notBits)
                Else
                    ExecValueSetInteger result, CLngInt(notBits)
                End If
            Else
                ExecValueSetInteger result, Not ExecValueToInteger(rightVal)
            End If
        Case "@"
            Dim addrNode As ASTNode
            addrNode = ps.ast.nodes(unaryNode)
            If UCase(addrNode.kind) = "IDENT" Then
                ExecValueSetInteger result, CInt(ExecGetVarAddr(es, addrNode.value))
                Return 1
            End If

            Dim addrInt As Integer
            addrInt = ExecEvalNode(ps, es, unaryNode, errText)
            If errText <> "" Then Return 0
            ExecValueSetInteger result, (&h10000000 Or (addrInt And &h00FFFFFF))
        Case Else
            errText = "Expression: Desteklenmeyen tekli işlem: " & n.op
            Return 0
        End Select

        ' S-088: -u / NOT u on a U32 wrap modulo 2^32
        If UXBStep3TypeIsU32(n.typeName) <> 0 Then
            If ExecIsIntegerClass(result) <> 0 Then ExecValueSetU64 result, (ExecValueToU64(result) And &hFFFFFFFFULL)
        End If
        Return 1

    Case "INCDEC_EXPR"
        Dim targetNode As Integer
        targetNode = n.left
        If targetNode = -1 Then
            errText = "Expression: inc/dec target missing"
            Return 0
        End If

        Dim curVal As ExecValue
        Dim nextVal As ExecValue
        Dim targetName As String
        Dim arrayVarIdx As Integer
        Dim arrayElemIdx As Integer
        Dim isIndexedTarget As Integer
        Dim isFieldTarget As Integer
        isIndexedTarget = 0
        isFieldTarget = 0

        If UCase(ps.ast.nodes(targetNode).kind) = "IDENT" Then
            targetName = ps.ast.nodes(targetNode).value
            If ExecGetVarValue(es, targetName, curVal) = 0 Then ExecValueInit curVal
        ElseIf ExecTryResolveArrayAccess(ps, es, targetNode, arrayVarIdx, arrayElemIdx, errText) <> 0 Then
            isIndexedTarget = 1
            If ExecGetArrayElement(es, arrayVarIdx, arrayElemIdx, curVal) = 0 Then
                If errText = "" Then errText = "Expression: inc/dec array read failed"
                Return 0
            End If
        ElseIf UCase(ps.ast.nodes(targetNode).kind) = "FIELD_EXPR" Then
            ' S-130: `r = c.n++` / `r = ++c.n` on a class / TYPE field
            isFieldTarget = 1
            If ExecReadFieldValue(ps, es, targetNode, curVal, errText) = 0 Then Return 0
        Else
            If errText = "" Then errText = "Expression: inc/dec target must be ident, indexed array or field"
            Return 0
        End If

        If Trim(n.op) = "--" Then
            ExecValueSetInteger nextVal, ExecValueToInteger(curVal) - 1
        Else
            ExecValueSetInteger nextVal, ExecValueToInteger(curVal) + 1
        End If

        If isIndexedTarget <> 0 Then
            If ExecSetArrayElement(es, arrayVarIdx, arrayElemIdx, nextVal) = 0 Then
                errText = "Expression: inc/dec array write failed"
                Return 0
            End If
        ElseIf isFieldTarget <> 0 Then
            If ExecWriteFieldValue(ps, es, targetNode, nextVal, errText) = 0 Then Return 0
        Else
            ExecSetVarValue es, targetName, nextVal
        End If

        If UCase(Trim(n.value)) = "POST" Then
            result = curVal
        Else
            result = nextVal
        End If
        Return 1

    Case "BINARY"
        Dim leftVal As ExecValue, rightVal As ExecValue
        If ExecEvalExpression(ps, n.left, es, leftVal, errText) = 0 Then Return 0

        If n.op = "|>" Then
            If n.right = -1 Then
                errText = "Expression: pipe target missing"
                Return 0
            End If

            Dim pipeOutput As ExecValue
            If ExecEvalPipeInvoke(ps, es, n.right, leftVal, pipeOutput, errText) = 0 Then Return 0
            result = pipeOutput
            Return 1
        End If

        If n.op = "&&" Or UCase(Trim(n.op)) = "ANDALSO" Then
            If ExecValueToInteger(leftVal) = 0 Then
                ExecValueSetInteger result, 0
                Return 1
            End If
        ElseIf n.op = "||" Or UCase(Trim(n.op)) = "ORELSE" Then
            If ExecValueToInteger(leftVal) <> 0 Then
                ExecValueSetInteger result, -1
                Return 1
            End If
        End If

        If ExecEvalExpression(ps, n.right, es, rightVal, errText) = 0 Then Return 0

        Dim overloadRv As Integer
        overloadRv = ExecTryEvalOverloadedBinary(ps, es, nodeIdx, leftVal, rightVal, n.op, result, errText)
        If overloadRv = 0 Then Return 0
        If overloadRv > 0 Then Return 1

        ' S-077: the static type (not the runtime tag, which a U32 shares with a
        ' U64) decides unsigned 64-bit semantics. Only consulted when a runtime
        ' operand is a U64_PTR-tagged value, so ordinary INTEGER math pays nothing.
        Dim binaryU64Flags As Integer
        binaryU64Flags = 0
        If leftVal.valueType = "U64_PTR" Or rightVal.valueType = "U64_PTR" Then
            If UXBExprIsU64(ps, n.left) <> 0 Then binaryU64Flags = 3
            If UXBExprIsU64(ps, n.right) <> 0 Then binaryU64Flags = binaryU64Flags Or 1
        End If

        ' S-142b: text concatenation of an F32 operand uses single-precision (7 digit) text; the value
        ' itself has no width, the stamped static type of the operand decides.
        If n.op = "+" Or n.op = "&" Then
            If leftVal.valueType = "STRING" Or rightVal.valueType = "STRING" Or n.op = "&" Then
                If leftVal.valueType = "FLOAT" And ExecNodeIsSingleFloat(ps, n.left) <> 0 Then ExecValueSetString leftVal, UXBFloatToText(leftVal.floatValue, 1)
                If rightVal.valueType = "FLOAT" And ExecNodeIsSingleFloat(ps, n.right) <> 0 Then ExecValueSetString rightVal, UXBFloatToText(rightVal.floatValue, 1)
            End If
        End If

        If ExecEvalBinaryValues(leftVal, rightVal, n.op, result, errText, binaryU64Flags) = 0 Then Return 0
        ' S-088: an expression whose static type is U32 wraps modulo 2^32 (the type pass stamps
        ' n.typeName; comparisons are BOOL and unaffected).
        If UXBStep3TypeIsU32(n.typeName) <> 0 Then
            If ExecIsIntegerClass(result) <> 0 Then ExecValueSetU64 result, (ExecValueToU64(result) And &hFFFFFFFFULL)
        End If
        Return 1

    Case "TERNARY_EXPR"
        Dim condVal As ExecValue
        If ExecEvalExpression(ps, n.left, es, condVal, errText) = 0 Then Return 0

        Dim thenNode As Integer
        thenNode = ExecChildAt(ps, nodeIdx, 0)
        If thenNode = -1 Then
            errText = "Expression: ternary true branch missing"
            Return 0
        End If

        If ExecValueToInteger(condVal) <> 0 Then
            Return ExecEvalExpression(ps, thenNode, es, result, errText)
        End If
        Return ExecEvalExpression(ps, n.right, es, result, errText)

    Case "CALL_EXPR"
        Dim arrayVarIdx As Integer
        Dim arrayElemIdx As Integer
        Dim arrayTry As Integer
        arrayTry = ExecTryResolveArrayAccess(ps, es, nodeIdx, arrayVarIdx, arrayElemIdx, errText)
        If arrayTry <> 0 Then
            If ExecGetArrayElement(es, arrayVarIdx, arrayElemIdx, result) = 0 Then
                If errText = "" Then errText = "Expression: array element read failed"
                Return 0
            End If
            Return 1
        End If
        If errText <> "" Then Return 0

        Dim bigExprName As String
        bigExprName = ExecFix8BNodeName(n)
        Select Case bigExprName
        Case "BIGINIT", "BIGF", "BIGD", "BALL", "BIGI", "BIGINT", "EXTFP", "FP80", "FP128"
            Return ExecBigCreateValue(ps, es, nodeIdx, result, errText)
        End Select

        Dim scalarCastName As String
        scalarCastName = UCase(Trim(bigExprName))
        If scalarCastName = "BOOL" Then scalarCastName = "BOOLEAN"
        Select Case scalarCastName
        Case "BOOLEAN", "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "PTR"
            If ExecChildCount(ps, nodeIdx) <> 1 Then
                errText = "exec: " & scalarCastName & " conversion expects exactly one argument"
                Return 0
            End If
            Dim scalarArgNode As Integer
            Dim scalarArgValue As ExecValue
            scalarArgNode = ExecChildAt(ps, nodeIdx, 0)
            If ExecEvalExpression(ps, scalarArgNode, es, scalarArgValue, errText) = 0 Then Return 0

            ' Type-name calls and typed routine parameters share one
            ' conversion contract.  Do not maintain a second cast table here.
            Return ExecApplyDeclaredType(scalarArgValue, scalarCastName, result, errText)
        End Select

        ' FIX6_RUNTIME_SEMANTIC_20260610:
        ' CALL_EXPR numeric path string-returning builtins'i 0/1 gibi ezmemeli.
        ' UCASE$/LEFT$/MID$/RIGHT$ benzeri çağrılar önce metin evaluator ile denenir.
        Dim callTextHandledFix6 As Integer
        Dim callTextValueFix6 As String
        If ExecTryEvalCallExprAsText(ps, es, nodeIdx, callTextValueFix6, errText, callTextHandledFix6) = 0 Then Return 0
        If callTextHandledFix6 <> 0 Then
            ExecValueSetString result, callTextValueFix6
            Return 1
        End If

        ' ABI10_ABS_TYPED_EXPR_FIX_20260706:
        ' A CALL_EXPR inside ExecEvalExpression must not always fall back to
        ' the integer-only ExecEvalNode path.  ABI10 smoke uses:
        '     ABS(mixed - 38.0) < 0.0001
        ' Without this path ABS evaluates its argument through ExecEvalNode,
        ' losing FLOAT state from ABI10 F64 returns.
        Dim typedScalarName As String
        typedScalarName = ExecFix8BNodeName(n)
        If Right(typedScalarName, 1) = "$" Then typedScalarName = Left(typedScalarName, Len(typedScalarName) - 1)
        Select Case UCase(Trim(typedScalarName))
        Case "ABS"
            Dim absArgNode As Integer
            absArgNode = ExecChildAt(ps, nodeIdx, 0)
            If absArgNode = -1 Then
                errText = "exec: ABS arg missing"
                Return 0
            End If
            Dim absArgValue As ExecValue
            If ExecEvalExpression(ps, absArgNode, es, absArgValue, errText) = 0 Then Return 0
            If UCase(Trim(absArgValue.valueType)) = "FLOAT" Then
                ExecValueSetFloat result, Abs(ExecValueToFloat(absArgValue))
            Else
                ExecValueSetInteger result, Abs(ExecValueToInteger(absArgValue))
            End If
            Return 1
        Case "CLNG"
            Dim clngArgNode As Integer
            clngArgNode = ExecChildAt(ps, nodeIdx, 0)
            If clngArgNode = -1 Or ExecChildCount(ps, nodeIdx) <> 1 Then
                errText = "exec: CLNG conversion expects exactly one argument"
                Return 0
            End If
            Dim clngArgValue As ExecValue
            If ExecEvalExpression(ps, clngArgNode, es, clngArgValue, errText) = 0 Then Return 0
            ' CLNG rounds a numeric input.  Do not use ExecEvalNode here: that
            ' legacy integer-only path would turn 2.9 into 2 before rounding.
            ExecValueSetInteger result, CInt(CLngInt(ExecValueToFloat(clngArgValue)))
            Return 1
        Case "CDBL", "CSNG"
            ' S-077: these conversions must see the full value. They used to fall
            ' through to the integer-only builtin path, which truncated the argument
            ' to an Integer and clamped it to 32 bits (CDBL of a U64 gave 2147483647).
            Dim cfArgNode As Integer
            cfArgNode = ExecChildAt(ps, nodeIdx, 0)
            If cfArgNode = -1 Or ExecChildCount(ps, nodeIdx) <> 1 Then
                errText = "exec: " & UCase(Trim(typedScalarName)) & " conversion expects exactly one argument"
                Return 0
            End If
            Dim cfArgValue As ExecValue
            If ExecEvalExpression(ps, cfArgNode, es, cfArgValue, errText) = 0 Then Return 0
            If UCase(Trim(typedScalarName)) = "CSNG" Then
                ExecValueSetFloat result, CDbl(CSng(ExecValueToFloat(cfArgValue)))
            Else
                ExecValueSetFloat result, ExecValueToFloat(cfArgValue)
            End If
            Return 1
        Case "FIX"
            Dim fixArgNode As Integer
            fixArgNode = ExecChildAt(ps, nodeIdx, 0)
            If fixArgNode = -1 Or ExecChildCount(ps, nodeIdx) <> 1 Then
                errText = "exec: FIX conversion expects exactly one argument"
                Return 0
            End If
            Dim fixArgValue As ExecValue
            If ExecEvalExpression(ps, fixArgNode, es, fixArgValue, errText) = 0 Then Return 0
            ' FIX is truncation toward zero; it is deliberately not CLNG's
            ' rounding rule, including for negative fractional values.
            ExecValueSetInteger result, CInt(Fix(ExecValueToFloat(fixArgValue)))
            Return 1
        Case "VAL"
            ' S-137: VAL returns a Double ("2.75" -> 2.75); the integer-only path gave 2.
            Dim valArgNode As Integer
            valArgNode = ExecChildAt(ps, nodeIdx, 0)
            If valArgNode = -1 Or ExecChildCount(ps, nodeIdx) <> 1 Then
                errText = "exec: VAL expects exactly one argument"
                Return 0
            End If
            Dim valArgText As String
            If ExecEvalNodeAsText(ps, es, valArgNode, valArgText, errText) = 0 Then Return 0
            Dim valNumber As Double
            valNumber = Val(valArgText)
            If valNumber = Int(valNumber) And Abs(valNumber) < 9.0E18 Then
                ExecValueSetInteger result, CLngInt(valNumber)
            Else
                ExecValueSetFloat result, valNumber
            End If
            Return 1
        Case "RND"
            ' S-163: RND / RND(x) -> [0,1) F64, tum motorlarda ayni uretec (src/common/uxb_rng.fbs).
            Dim rndHasArg As Integer = IIf(ExecChildCount(ps, nodeIdx) > 0, 1, 0)
            Dim rndArgValue As ExecValue
            If rndHasArg <> 0 Then
                If ExecEvalExpression(ps, ExecChildAt(ps, nodeIdx, 0), es, rndArgValue, errText) = 0 Then Return 0
            End If
            ExecValueSetFloat result, UXBRngRnd(ExecCurrentTaskKey(), rndHasArg, IIf(rndHasArg <> 0, ExecValueToFloat(rndArgValue), 0))
            Return 1
        Case "INT", "CINT", "SGN", "SQR", "SIN", "COS", "TAN", "ATN", "EXP", "LOG"
            ' S-137: see ExecApplyNumericBuiltin (these used to fall into the integer-only path below).
            Dim numArgNode As Integer
            numArgNode = ExecChildAt(ps, nodeIdx, 0)
            If numArgNode = -1 Or ExecChildCount(ps, nodeIdx) <> 1 Then
                errText = "exec: " & UCase(Trim(typedScalarName)) & " expects exactly one argument"
                Return 0
            End If
            Dim numArgValue As ExecValue
            If ExecEvalExpression(ps, numArgNode, es, numArgValue, errText) = 0 Then Return 0
            Return ExecApplyNumericBuiltin(UCase(Trim(typedScalarName)), numArgValue, result, errText)
        End Select

        Dim callExprValue As Integer
        gExecLastCallValueExValid = 0
        callExprValue = ExecEvalNode(ps, es, nodeIdx, errText)
        If errText <> "" Then Return 0
        If gExecLastCallValueExValid <> 0 Then
            result = gExecLastCallValueEx
            gExecLastCallValueExValid = 0
        Else
            ExecValueSetInteger result, callExprValue
        End If
        Return 1

    Case "NEW_EXPR"
        Dim newExprValue As Integer
        newExprValue = ExecEvalNode(ps, es, nodeIdx, errText)
        If errText <> "" Then Return 0
        ExecValueSetInteger result, newExprValue
        Return 1

    Case "FIELD_EXPR"
        Return ExecReadFieldValue(ps, es, nodeIdx, result, errText)

    Case "SPAWN_EXPR"
        Return ExecRunSpawnExpr(ps, es, nodeIdx, result, errText)

    Case Else
        errText = "Expression: Desteklenmeyen ifade türü: " & n.kind
        Return 0
    End Select
End Function

' Legacy MIR evaluator bridge intentionally remains self-contained in this file.

Function ExecDebugGetLocateRow() As Integer
    Return gDebugLocateRow
End Function

Function ExecDebugGetLocateCol() As Integer
    Return gDebugLocateCol
End Function

Function ExecDebugGetColorFg() As Integer
    Return gDebugColorFg
End Function

Function ExecDebugGetColorBg() As Integer
    Return gDebugColorBg
End Function

Function ExecDebugGetClsCount() As Integer
    Return gDebugClsCount
End Function

Function ExecDebugGetPrintColumnPos() As Integer
    Return gDebugPrintColumnPos
End Function

Sub ExecDebugInputQueueClear()
    gDebugInputQueueCount = 0
    gDebugInputQueueReadPos = 0
    Erase gDebugInputQueue
End Sub

Sub ExecDebugInputQueuePush(ByRef lineText As String)
    If gDebugInputQueueCount = 0 Then
        ReDim gDebugInputQueue(0)
    Else
        ReDim Preserve gDebugInputQueue(gDebugInputQueueCount)
    End If

    gDebugInputQueue(gDebugInputQueueCount) = lineText
    gDebugInputQueueCount += 1
End Sub

Function ExecDebugGetInputQueueRemaining() As Integer
    Return gDebugInputQueueCount - gDebugInputQueueReadPos
End Function

Sub ExecDebugKeyQueueClear()
    gDebugKeyQueueCount = 0
    gDebugKeyQueueReadPos = 0
    Erase gDebugKeyQueue
End Sub

Sub ExecDebugKeyQueuePush(ByVal keyCode As Integer)
    If gDebugKeyQueueCount = 0 Then
        ReDim gDebugKeyQueue(0)
    Else
        ReDim Preserve gDebugKeyQueue(gDebugKeyQueueCount)
    End If

    gDebugKeyQueue(gDebugKeyQueueCount) = (keyCode And &hFF)
    gDebugKeyQueueCount += 1
End Sub

Function ExecDebugGetKeyQueueRemaining() As Integer
    Return gDebugKeyQueueCount - gDebugKeyQueueReadPos
End Function

Function ExecDebugGetDefTypeCount() As Integer
    Return gExecDebugLastDefTypeCount
End Function

Private Function ExecEvalPipeInvoke(ByRef ps As ParseState, ByRef es As ExecState, ByVal targetNodeIdx As Integer, ByRef pipeInput As ExecValue, ByRef result As ExecValue, ByRef errText As String) As Integer
    If targetNodeIdx < 0 Or targetNodeIdx >= ps.ast.count Then
        errText = "Expression: pipe target missing"
        Return 0
    End If

    Dim targetKind As String
    targetKind = UCase(ps.ast.nodes(targetNodeIdx).kind)

    If targetKind = "IDENT" Or targetKind = "KEYWORD_REF" Then
        Dim pipeTargetName As String
        pipeTargetName = ExecFix8BNodeName(ps.ast.nodes(targetNodeIdx))
        If ExecTaskFind(es, "PIPE", pipeTargetName) <> -1 Then
            If ExecSlotTriggerPipeValue(ps, es, pipeTargetName, pipeInput, result, errText) = 0 Then Return 0
            Return 1
        End If

        Dim tmpName As String
        tmpName = "__UXB_PIPE_TMP"
        ExecEnsureVar es, tmpName
        ExecSetVarValue es, tmpName, pipeInput

        Dim identNode As Integer
        identNode = ASTNewNode(ps.ast, "IDENT", tmpName, "", ps.ast.nodes(targetNodeIdx).lineNo, ps.ast.nodes(targetNodeIdx).colNo)

        Dim callNode As Integer
        callNode = ASTNewNode(ps.ast, "CALL_EXPR", ps.ast.nodes(targetNodeIdx).value, "", ps.ast.nodes(targetNodeIdx).lineNo, ps.ast.nodes(targetNodeIdx).colNo)
        ASTAddChild ps.ast, callNode, identNode

        Dim callValue As Integer
        If ExecEvalCall(ps, es, pipeTargetName, callNode, 1, callValue, errText) = 0 Then Return 0
        ExecValueSetInteger result, callValue
        Return 1
    End If

    If targetKind = "STRING" Then
        If ExecSlotTriggerPipeValue(ps, es, ps.ast.nodes(targetNodeIdx).value, pipeInput, result, errText) = 0 Then Return 0
        Return 1
    End If

    errText = "Expression: pipe target must be identifier or pipe name"
    Return 0
End Function

Function ExecDebugGetStringSize() As Integer
    Return gExecDebugLastStringSize
End Function

Private Function ExecIsBuiltinCallName(ByRef callName As String) As Integer
    Select Case UCase(callName)
    Case "DLL", "API", "CALL", "SIZEOF", "OFFSETOF", "INSTANCEOF", "BOOLEAN", "BOOL", "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "PTR", "LEN", "ABS", "INT", "SGN", "VAL", "ASC", "CINT", "CLNG", "CDBL", "CSNG", "FIX", "SQR", "SIN", "COS", "TAN", "ATN", "EXP", "LOG", "UCASE", "LCASE", "LTRIM", "RTRIM", "TRIM", "LEFT", "RIGHT", "MID", "INSTR", "SPACE", "STRING", "CHR", "STR", "RND", "TIMER", "LOF", "EOF", "INKEY", "GETKEY", "PEEK", "PEEKB", "PEEKW", "PEEKD", "PEEKQ", "VARPTR", "SADD", "LPTR", "CODEPTR", "LBOUND", "UBOUND", _
         "BIGINIT", "BIGF", "BIGD", "BALL", "BIGI", "BIGINT", "EXTFP", "FP80", "FP128", _
         "LIST_NEW", "DICT_NEW", "SET_NEW", "LISTLEN", "LISTGET", "LISTSET", "LISTADD", "LISTREMOVE", "LISTCLEAR", "DICTLEN", "DICTHAS", "DICTGET", "DICTSET", "DICTCLEAR", "SETLEN", "SETHAS", "SETADD", "SETREMOVE", "SETCLEAR"
        Return 1
    End Select

    Return 0
End Function

Private Sub ExecSnapshotVars(ByRef es As ExecState, snapshotVars() As ExecVar, ByRef snapshotCount As Integer, ByRef snapshotNextAddr As UInteger)
    snapshotCount = es.count
    snapshotNextAddr = es.nextVarAddr

    If snapshotCount <= 0 Then
        Erase snapshotVars
        Exit Sub
    End If

    ReDim snapshotVars(snapshotCount - 1)

    Dim i As Integer
    For i = 0 To snapshotCount - 1
        snapshotVars(i) = es.vars(i)
    Next i
End Sub

Private Sub ExecRestoreVars(ByRef es As ExecState, snapshotVars() As ExecVar, ByVal snapshotCount As Integer, ByVal snapshotNextAddr As UInteger)
    es.count = snapshotCount
    es.nextVarAddr = snapshotNextAddr

    If snapshotCount <= 0 Then
        ' Erase es.vars - fixed array
        Exit Sub
    End If

    ' ReDim es.vars(snapshotCount - 1) - fixed array
    If snapshotCount > 256 Then
        ' overflow
        Exit Sub
    End If

    Dim i As Integer
    For i = 0 To snapshotCount - 1
        es.vars(i) = snapshotVars(i)
    Next i
End Sub

Private Function ExecResolveThisMeIdentValue(ByRef es As ExecState, ByRef identText As String, ByRef valueOut As Integer, ByRef errText As String) As Integer
    Dim identUpper As String
    identUpper = UCase(Trim(identText))

    Dim varIdx As Integer
    varIdx = ExecFindVar(es, identUpper)
    If varIdx <> -1 Then
        valueOut = ExecValueToInteger(es.vars(varIdx).value)
        Return 1
    End If

    ' FIX11_FULL_RECOVERY_20260611:
    ' ExecEvalNode() numeric yolu IDENT için buraya düşüyor.
    ' Kullanıcı fonksiyonu çağrısındaki argümanlar (GEN_ADD(2, GEN_HEADER_BASE)) ExecEvalNode ile
    ' hesaplandığı için const tablosu burada görülmezse GEN_HEADER_BASE sessizce 0 oluyor.
    ' ExecEvalExpression zaten const tablosunu görüyor; bu fonksiyon da aynı sözleşmeye uymalı.
    Dim constIdxFix11 As Integer
    For constIdxFix11 = 0 To es.constCount - 1
        If UCase(Trim(es.consts(constIdxFix11).nameText)) = identUpper Then
            valueOut = ExecValueToInteger(es.consts(constIdxFix11).value)
            Return 1
        End If
    Next constIdxFix11

    If identUpper = "THIS" Or identUpper = "ME" Then
        errText = "exec: THIS/ME used outside method context"
        Return 0
    End If

    ' 2 = "success, but the name is not a variable or constant": the caller may still resolve it
    ' as a constant of the running routine's namespace (S-140); otherwise it stays 0.
    valueOut = 0
    Return 2
End Function

Private Function ExecResolveThisMeIdentAddr(ByRef es As ExecState, ByRef identText As String, ByRef addrOut As UInteger, ByRef errText As String) As Integer
    Dim identUpper As String
    identUpper = UCase(Trim(identText))

    Dim varIdx As Integer
    varIdx = ExecFindVar(es, identUpper)
    If varIdx <> -1 Then
        addrOut = es.vars(varIdx).addr
        Return 1
    End If

    If identUpper = "THIS" Or identUpper = "ME" Then
        errText = "exec: THIS/ME used outside method context"
        Return 0
    End If

    addrOut = ExecGetVarAddr(es, identUpper)
    Return 1
End Function

Private Function ExecBuildFieldPath(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef rootNameOut As String, ByRef pathOut As String, ByRef rootNodeOut As Integer, ByRef errText As String) As Integer
    rootNameOut = ""
    pathOut = ""
    rootNodeOut = -1

    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "exec: field access invalid node"
        Return 0
    End If

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)
    Dim k As String
    k = UCase(n.kind)

    If k = "IDENT" Or k = "KEYWORD_REF" Then
        rootNameOut = UCase(Trim(n.value))
        rootNodeOut = nodeIdx
        Return IIf(rootNameOut <> "", 1, 0)
    End If

    If k = "CALL_EXPR" Then
        Dim idxVar As Integer
        Dim idxElem As Integer
        Dim idxTry As Integer
        idxTry = ExecTryResolveArrayAccess(ps, es, nodeIdx, idxVar, idxElem, errText)
        If idxTry <= 0 Then
            If idxTry = 0 Then errText = "exec: field access base must be identifier, array access or field"
            Return 0
        End If

        rootNameOut = UCase(Trim(n.value))
        rootNodeOut = nodeIdx
        Return IIf(rootNameOut <> "", 1, 0)
    End If

    If k <> "FIELD_EXPR" Then
        errText = "exec: field access base must be identifier, array access or field"
        Return 0
    End If

    Dim parentRoot As String
    Dim parentPath As String
    Dim parentRootNode As Integer
    If ExecBuildFieldPath(ps, es, n.left, parentRoot, parentPath, parentRootNode, errText) = 0 Then Return 0

    rootNameOut = parentRoot
    rootNodeOut = parentRootNode
    If parentPath = "" Then
        pathOut = UCase(Trim(n.value))
    Else
        pathOut = parentPath & "." & UCase(Trim(n.value))
    End If

    Return IIf(rootNameOut <> "" And pathOut <> "", 1, 0)
End Function

Private Function ExecFieldPathReadIdent(ByRef pathText As String, ByRef cursor As Integer, ByRef identOut As String) As Integer
    identOut = ""
    If cursor < 1 Or cursor > Len(pathText) Then Return 0

    Do While cursor <= Len(pathText)
        Dim ws As String
        ws = Mid(pathText, cursor, 1)
        If ws <> " " And ws <> Chr(9) Then Exit Do
        cursor += 1
    Loop

    If cursor > Len(pathText) Then Return 0

    Dim ch As String
    ch = Mid(pathText, cursor, 1)
    If Not ((ch >= "A" And ch <= "Z") Or (ch >= "a" And ch <= "z") Or ch = "_") Then Return 0

    Dim startPos As Integer
    startPos = cursor
    cursor += 1

    Do While cursor <= Len(pathText)
        ch = Mid(pathText, cursor, 1)
        If ((ch >= "A" And ch <= "Z") Or (ch >= "a" And ch <= "z") Or (ch >= "0" And ch <= "9") Or ch = "_") = 0 Then Exit Do
        cursor += 1
    Loop

    identOut = UCase(Mid(pathText, startPos, cursor - startPos))
    Return IIf(identOut <> "", 1, 0)
End Function

Private Function ExecFieldPathSkipIndexes(ByRef pathText As String, ByRef cursor As Integer) As Integer
    Do While cursor <= Len(pathText)
        Dim ch As String
        ch = Mid(pathText, cursor, 1)
        If ch <> " " And ch <> Chr(9) Then Exit Do
        cursor += 1
    Loop

    If cursor > Len(pathText) Then Return 1
    If Mid(pathText, cursor, 1) <> "(" Then Return 1

    Dim depth As Integer
    depth = 0
    Do While cursor <= Len(pathText)
        Dim ch As String
        ch = Mid(pathText, cursor, 1)
        If ch = "(" Then
            depth += 1
        ElseIf ch = ")" Then
            depth -= 1
            If depth = 0 Then
                cursor += 1
                Exit Do
            End If
        End If
        cursor += 1
    Loop

    Return IIf(depth = 0, 1, 0)
End Function

Private Function ExecFindAggregateNodeByName(ByRef ps As ParseState, ByRef typeNameRaw As String, ByRef nodeOut As Integer, ByRef isClassOut As Integer) As Integer
    nodeOut = -1
    isClassOut = 0

    Dim typeName As String
    typeName = UCase(Trim(typeNameRaw))
    If typeName = "" Then Return 0

    Dim classNode As Integer
    classNode = ExecFindClassDeclNode(ps, typeName)
    If classNode <> -1 Then
        nodeOut = classNode
        isClassOut = 1
        Return 1
    End If

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(ps.ast.nodes(i).kind) = "TYPE_STMT" Then
            If UCase(Trim(ps.ast.nodes(i).value)) = typeName Then
                nodeOut = i
                isClassOut = 0
                Return 1
            End If
        End If
    Next i

    Return 0
End Function

Private Function ExecFindAggregateFieldNode(ByRef ps As ParseState, ByVal aggregateNode As Integer, ByVal isClassNode As Integer, ByRef fieldNameRaw As String, ByRef fieldNodeOut As Integer) As Integer
    fieldNodeOut = -1
    If aggregateNode < 0 Or aggregateNode >= ps.ast.count Then Return 0

    Dim fieldName As String
    fieldName = UCase(Trim(fieldNameRaw))

    Dim ch As Integer
    ch = ps.ast.nodes(aggregateNode).firstChild
    Do While ch <> -1
        Dim childKind As String
        childKind = UCase(ps.ast.nodes(ch).kind)
        If (isClassNode <> 0 And (childKind = "CLASS_FIELD" Or childKind = "CLASS_PROPERTY_DECL")) Or (isClassNode = 0 And childKind = "TYPE_FIELD") Then
            If UCase(Trim(ps.ast.nodes(ch).value)) = fieldName Then
                fieldNodeOut = ch
                Return 1
            End If
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function ExecFieldNodeTypeName(ByRef ps As ParseState, ByVal fieldNode As Integer, ByRef typeOut As String) As Integer
    typeOut = ""
    If fieldNode < 0 Or fieldNode >= ps.ast.count Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(fieldNode).firstChild
    Do While ch <> -1
        If UCase(ps.ast.nodes(ch).kind) = "TYPE_REF" Then
            typeOut = UCase(Trim(ps.ast.nodes(ch).value))
            Return IIf(typeOut <> "", 1, 0)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function ExecClassFieldHasFlag(ByRef ps As ParseState, ByVal fieldNode As Integer, ByRef flagRaw As String) As Integer
    Dim targetFlag As String
    targetFlag = UCase(Trim(flagRaw))
    If targetFlag = "" Then Return 0
    If fieldNode < 0 Or fieldNode >= ps.ast.count Then Return 0
    Dim nodeKind As String
    nodeKind = UCase(ps.ast.nodes(fieldNode).kind)
    If nodeKind <> "CLASS_FIELD" And nodeKind <> "CLASS_PROPERTY_DECL" Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(fieldNode).firstChild
    Do While ch <> -1
        If UCase(ps.ast.nodes(ch).kind) = "CLASS_FIELD_FLAG" Then
            If UCase(Trim(ps.ast.nodes(ch).value)) = targetFlag Then Return 1
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 0
End Function

Private Function ExecClassPropertyHasAccessor(ByRef ps As ParseState, ByVal propertyNode As Integer, ByRef accessorRaw As String) As Integer
    Dim accessor As String
    accessor = UCase(Trim(accessorRaw))
    If accessor <> "GET" And accessor <> "SET" Then Return 0
    If propertyNode < 0 Or propertyNode >= ps.ast.count Then Return 0
    If UCase(ps.ast.nodes(propertyNode).kind) <> "CLASS_PROPERTY_DECL" Then Return 0

    Dim ch As Integer
    ch = ps.ast.nodes(propertyNode).firstChild
    Do While ch <> -1
        If UCase(ps.ast.nodes(ch).kind) = "CLASS_PROPERTY_FLAG" Then
            If UCase(Trim(ps.ast.nodes(ch).value)) = accessor Then Return 1
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Function ExecTryResolveMagicFieldReceiver(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef receiverTypeOut As String, ByRef receiverAddrOut As Integer, ByRef memberPathOut As String) As Integer
    receiverTypeOut = ""
    receiverAddrOut = 0
    memberPathOut = ""

    Dim rootName As String
    Dim pathText As String
    Dim rootNode As Integer
    Dim buildErr As String
    If ExecBuildFieldPath(ps, es, nodeIdx, rootName, pathText, rootNode, buildErr) = 0 Then Return 0

    Dim rootIdx As Integer
    rootIdx = ExecFindVar(es, rootName)
    If rootIdx = -1 Then Return 0

    Dim candidateType As String
    If es.vars(rootIdx).runtimeClassType <> "" Then
        candidateType = UCase(Trim(es.vars(rootIdx).runtimeClassType))
    Else
        candidateType = UCase(Trim(es.vars(rootIdx).declType))
    End If

    Dim candidateAddr As Integer
    candidateAddr = ExecValueToInteger(es.vars(rootIdx).value)
    If candidateAddr = 0 Then candidateAddr = CInt(es.vars(rootIdx).addr)
    If candidateAddr = 0 Then Return 0

    If candidateType = "" Or candidateType = "OBJECT" Or ExecFindClassDeclNode(ps, candidateType) = -1 Then
        Dim inferredType As String
        inferredType = ""
        If ExecTryResolveRuntimeClassByObjectAddr(ps, es, CUInt(candidateAddr), inferredType) <> 0 Then
            candidateType = inferredType
        End If
    End If

    If candidateType = "" Or ExecFindClassDeclNode(ps, candidateType) = -1 Then Return 0

    receiverTypeOut = candidateType
    receiverAddrOut = candidateAddr
    memberPathOut = UCase(Trim(pathText))
    Return 1
End Function

Private Function ExecTryInvokeMagicFieldGet(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef valueOut As ExecValue, ByRef errText As String) As Integer
    Dim receiverType As String
    Dim receiverAddr As Integer
    Dim memberPath As String
    If ExecTryResolveMagicFieldReceiver(ps, es, nodeIdx, receiverType, receiverAddr, memberPath) = 0 Then Return 0

    Dim routineIdx As Integer
    If ExecResolveMagicRoutineInHierarchy(ps, es, receiverType, "MAGIC_GET", routineIdx) = 0 Then Return 0

    Dim preparedArgs(0 To 0) As Integer
    preparedArgs(0) = CInt(ExecHashText(memberPath))

    Dim callResult As Integer
    If ExecInvokeRoutineByPreparedArgs(ps, es, routineIdx, preparedArgs(), 1, 1, 1, receiverAddr, callResult, errText) = 0 Then
        If errText = "" Then errText = "exec: MAGIC_GET invocation failed"
        Return 0
    End If

    ExecValueSetInteger valueOut, callResult
    Return 1
End Function

Private Function ExecTryInvokeMagicFieldSet(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef valueIn As ExecValue, ByRef errText As String) As Integer
    Dim receiverType As String
    Dim receiverAddr As Integer
    Dim memberPath As String
    If ExecTryResolveMagicFieldReceiver(ps, es, nodeIdx, receiverType, receiverAddr, memberPath) = 0 Then Return 0

    Dim routineIdx As Integer
    If ExecResolveMagicRoutineInHierarchy(ps, es, receiverType, "MAGIC_SET", routineIdx) = 0 Then Return 0

    Dim preparedArgs(0 To 1) As Integer
    preparedArgs(0) = CInt(ExecHashText(memberPath))
    preparedArgs(1) = ExecValueToInteger(valueIn)

    Dim ignoredValue As Integer
    If ExecInvokeRoutineByPreparedArgs(ps, es, routineIdx, preparedArgs(), 2, 0, 1, receiverAddr, ignoredValue, errText) = 0 Then
        If errText = "" Then errText = "exec: MAGIC_SET invocation failed"
        Return 0
    End If

    Return 1
End Function

' Return: 1 = MAGIC_TOSTRING text produced, 0 = error, -1 = no magic text (caller stringifies).
' valueReady = 1 means the probe already evaluated `nodeIdx` (CALL/FIELD/MEMBER/NEW expressions must
' be evaluated to discover an object receiver) and `valueOut` holds that single evaluation; the caller
' must stringify valueOut instead of evaluating the node again - a second evaluation repeated every
' side effect of the expression (S-124: PRINT obj.Method() ran the method twice, NEW ran constructors twice).
Function ExecTryEvalMagicToString(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef textOut As String, ByRef errText As String, ByRef valueOut As ExecValue, ByRef valueReady As Integer) As Integer
    textOut = ""
    valueReady = 0
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1

    Dim nk As String
    nk = UCase(Trim(ps.ast.nodes(nodeIdx).kind))

    Dim receiverType As String
    Dim receiverAddr As Integer
    receiverType = ""
    receiverAddr = 0

    If nk = "IDENT" Or nk = "KEYWORD_REF" Then
        Dim receiverName As String
        receiverName = UCase(Trim(ps.ast.nodes(nodeIdx).value))
        If receiverName = "" Then receiverName = UCase(Trim(ps.ast.nodes(nodeIdx).symbolName))

        Dim receiverIdx As Integer
        receiverIdx = ExecFindVar(es, receiverName)
        If receiverIdx = -1 Then Return -1

        If es.vars(receiverIdx).runtimeClassType <> "" Then
            receiverType = UCase(Trim(es.vars(receiverIdx).runtimeClassType))
        Else
            receiverType = UCase(Trim(es.vars(receiverIdx).declType))
        End If

        receiverAddr = ExecValueToInteger(es.vars(receiverIdx).value)
        If receiverAddr = 0 Then receiverAddr = CInt(es.vars(receiverIdx).addr)
    ElseIf nk = "FIELD_EXPR" Or nk = "MEMBER_EXPR" Or nk = "CALL_EXPR" Or nk = "NEW_EXPR" Then
        Dim receiverValue As ExecValue
        If ExecEvalExpression(ps, nodeIdx, es, receiverValue, errText) = 0 Then Return 0
        valueOut = receiverValue
        valueReady = 1
        receiverAddr = ExecValueToInteger(receiverValue)
    Else
        Return -1
    End If

    If receiverAddr = 0 Then Return -1

    If receiverType = "" Or receiverType = "OBJECT" Or ExecFindClassDeclNode(ps, receiverType) = -1 Then
        Dim inferredType As String
        inferredType = ""
        If ExecTryResolveRuntimeClassByObjectAddr(ps, es, CUInt(receiverAddr), inferredType) <> 0 Then receiverType = inferredType
    End If

    If receiverType = "" Or ExecFindClassDeclNode(ps, receiverType) = -1 Then Return -1

    Dim routineIdx As Integer
    If ExecResolveMagicRoutineInHierarchy(ps, es, receiverType, "MAGIC_TOSTRING", routineIdx) = 0 Then Return -1

    Dim noArgs(Any) As Integer
    ReDim noArgs(0)
    Dim callResult As Integer
    If ExecInvokeRoutineByPreparedArgs(ps, es, routineIdx, noArgs(), 0, 1, 1, receiverAddr, callResult, errText) = 0 Then
        If errText = "" Then errText = "exec: MAGIC_TOSTRING invocation failed " & receiverType
        Return 0
    End If

    textOut = LTrim(Str(callResult))
    Return 1
End Function

Private Function ExecFindClassPropertyAccessorBody(ByRef ps As ParseState, ByVal propertyNode As Integer, ByRef accessorRaw As String, ByRef bodyNodeOut As Integer) As Integer
    bodyNodeOut = -1
    If propertyNode < 0 Or propertyNode >= ps.ast.count Then Return 0
    If UCase(ps.ast.nodes(propertyNode).kind) <> "CLASS_PROPERTY_DECL" Then Return 0

    Dim targetKind As String
    targetKind = ""
    If UCase(Trim(accessorRaw)) = "GET" Then
        targetKind = "CLASS_PROPERTY_GET_STMT"
    ElseIf UCase(Trim(accessorRaw)) = "SET" Then
        targetKind = "CLASS_PROPERTY_SET_STMT"
    Else
        Return 0
    End If

    Dim ch As Integer
    ch = ps.ast.nodes(propertyNode).firstChild
    Do While ch <> -1
        If UCase(ps.ast.nodes(ch).kind) = targetKind Then
            bodyNodeOut = ch
            Return 1
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Sub ExecBindPropertyAccessorContext(ByRef es As ExecState, ByRef rootType As String, ByVal rootAddr As UInteger)
    ExecSetVar es, "THIS", CInt(rootAddr)
    ExecSetVarDeclMeta es, "THIS", rootType, 0, 0, 0, 0, 0
    Dim thisIdx As Integer
    thisIdx = ExecFindVar(es, "THIS")
    If thisIdx <> -1 Then
        es.vars(thisIdx).runtimeClassType = rootType
        es.vars(thisIdx).addr = rootAddr
    End If

    ExecSetVar es, "ME", CInt(rootAddr)
    ExecSetVarDeclMeta es, "ME", rootType, 0, 0, 0, 0, 0
    Dim meIdx As Integer
    meIdx = ExecFindVar(es, "ME")
    If meIdx <> -1 Then
        es.vars(meIdx).runtimeClassType = rootType
        es.vars(meIdx).addr = rootAddr
    End If
End Sub

Private Function ExecRunClassPropertyGetBody(ByRef ps As ParseState, ByRef es As ExecState, ByVal propertyNode As Integer, ByRef rootType As String, ByVal rootAddr As UInteger, ByRef valueOut As ExecValue, ByRef errText As String) As Integer
    Dim bodyNode As Integer
    If ExecFindClassPropertyAccessorBody(ps, propertyNode, "GET", bodyNode) = 0 Then Return 0

    Dim snapshotVars(Any) As ExecVar
    Dim snapshotCount As Integer
    Dim snapshotNextAddr As UInteger
    ExecSnapshotVars es, snapshotVars(), snapshotCount, snapshotNextAddr

    ExecBindPropertyAccessorContext es, rootType, rootAddr

    Dim st As Integer
    Dim gotReturn As Integer
    st = ps.ast.nodes(bodyNode).firstChild
    Do While st <> -1
        If UCase(ps.ast.nodes(st).kind) = "RETURN_STMT" Then
            Dim retExpr As Integer
            retExpr = ExecChildAt(ps, st, 0)
            If retExpr = -1 Then retExpr = ps.ast.nodes(st).left
            If retExpr = -1 Then
                ExecValueSetInteger valueOut, 0
            Else
                If ExecEvalExpression(ps, retExpr, es, valueOut, errText) = 0 Then
                    ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
                    Return 0
                End If
            End If
            gotReturn = 1
            Exit Do
        End If

        If ExecRunStmt(ps, es, st, errText) = 0 Then
            ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
            Return 0
        End If
        st = ps.ast.nodes(st).nextSibling
    Loop

    If gotReturn = 0 Then
        errText = "exec: property GET body missing RETURN"
        ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
        Return 0
    End If

    ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
    Return 1
End Function

Private Function ExecRunClassPropertySetBody(ByRef ps As ParseState, ByRef es As ExecState, ByVal propertyNode As Integer, ByRef rootType As String, ByVal rootAddr As UInteger, ByRef valueIn As ExecValue, ByRef errText As String) As Integer
    Dim bodyNode As Integer
    If ExecFindClassPropertyAccessorBody(ps, propertyNode, "SET", bodyNode) = 0 Then Return 0

    Dim snapshotVars(Any) As ExecVar
    Dim snapshotCount As Integer
    Dim snapshotNextAddr As UInteger
    ExecSnapshotVars es, snapshotVars(), snapshotCount, snapshotNextAddr

    ExecBindPropertyAccessorContext es, rootType, rootAddr
    ExecSetVarValue es, "VALUE", valueIn
    ExecSetVarDeclMeta es, "VALUE", "OBJECT", 0, 0, 0, 0, 0

    Dim st As Integer
    st = ps.ast.nodes(bodyNode).firstChild
    Do While st <> -1
        If UCase(ps.ast.nodes(st).kind) <> "RETURN_STMT" Then
            If ExecRunStmt(ps, es, st, errText) = 0 Then
                ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
                Return 0
            End If
        End If
        st = ps.ast.nodes(st).nextSibling
    Loop

    ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
    Return 1
End Function

Private Function ExecResolveFieldPolicy(ByRef ps As ParseState, ByRef rootTypeRaw As String, ByRef pathText As String, ByRef isStaticOut As Integer, ByRef isReadonlyOut As Integer, ByRef staticKeyOut As String, ByRef allowReadOut As Integer, ByRef allowWriteOut As Integer, ByRef fieldNodeOut As Integer) As Integer
    isStaticOut = 0
    isReadonlyOut = 0
    staticKeyOut = ""
    allowReadOut = 1
    allowWriteOut = 1
    fieldNodeOut = -1

    Dim currentType As String
    currentType = UCase(Trim(rootTypeRaw))
    If currentType = "" Then Return 0

    Dim cursor As Integer
    cursor = 1
    Do
        Dim fieldName As String
        If ExecFieldPathReadIdent(pathText, cursor, fieldName) = 0 Then Return 0

        Dim aggregateNode As Integer
        Dim isClassNode As Integer
        If ExecFindAggregateNodeByName(ps, currentType, aggregateNode, isClassNode) = 0 Then Return 0

        Dim fieldNode As Integer
        If ExecFindAggregateFieldNode(ps, aggregateNode, isClassNode, fieldName, fieldNode) = 0 Then Return 0
        fieldNodeOut = fieldNode

        If isClassNode <> 0 Then
            If ExecClassFieldHasFlag(ps, fieldNode, "STATIC") <> 0 Then
                isStaticOut = 1
                staticKeyOut = currentType & "." & fieldName
            End If
            If ExecClassFieldHasFlag(ps, fieldNode, "READONLY") <> 0 Or ExecClassFieldHasFlag(ps, fieldNode, "IMMUTABLE") <> 0 Then
                isReadonlyOut = 1
            End If
            If UCase(ps.ast.nodes(fieldNode).kind) = "CLASS_PROPERTY_DECL" Then
                allowReadOut = ExecClassPropertyHasAccessor(ps, fieldNode, "GET")
                allowWriteOut = ExecClassPropertyHasAccessor(ps, fieldNode, "SET")
            End If
        End If

        Dim fieldType As String
        If ExecFieldNodeTypeName(ps, fieldNode, fieldType) = 0 Then Return 0
        currentType = fieldType

        If ExecFieldPathSkipIndexes(pathText, cursor) = 0 Then Return 0

        Do While cursor <= Len(pathText)
            Dim ws As String
            ws = Mid(pathText, cursor, 1)
            If ws <> " " And ws <> Chr(9) Then Exit Do
            cursor += 1
        Loop

        If cursor > Len(pathText) Then Exit Do
        If Mid(pathText, cursor, 1) <> "." Then Return 0
        cursor += 1
    Loop

    Return 1
End Function

Private Function ExecResolveFieldAccess(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef baseAddrOut As UInteger, ByRef targetTypeOut As String, ByRef targetSizeOut As Integer, ByRef rootTypeOut As String, ByRef rootAddrOut As UInteger, ByRef pathOut As String, ByRef errText As String) As Integer
    Dim rootName As String
    Dim pathText As String
    Dim rootNode As Integer
    If ExecBuildFieldPath(ps, es, nodeIdx, rootName, pathText, rootNode, errText) = 0 Then
        ' A field can continue from a function or method result, for example
        ' factory().method().child. Evaluate that receiver and resolve only the
        ' current field against the returned runtime class.
        If nodeIdx < 0 Or nodeIdx >= ps.ast.count OrElse UCase(Trim(ps.ast.nodes(nodeIdx).kind)) <> "FIELD_EXPR" OrElse ps.ast.nodes(nodeIdx).left = -1 Then Return 0

        Dim dynamicReceiver As ExecValue
        errText = ""
        If ExecEvalExpression(ps, ps.ast.nodes(nodeIdx).left, es, dynamicReceiver, errText) = 0 Then Return 0

        Dim dynamicAddr As UInteger
        dynamicAddr = CUInt(ExecValueToInteger(dynamicReceiver))
        If dynamicAddr = 0 Then
            errText = "exec: field receiver expression returned null"
            Return 0
        End If

        Dim dynamicType As String
        dynamicType = ""
        If ExecTryResolveRuntimeClassByObjectAddr(ps, es, dynamicAddr, dynamicType) = 0 Then
            errText = "exec: field receiver expression type unresolved"
            Return 0
        End If

        Dim dynamicPath As String
        dynamicPath = UCase(Trim(ps.ast.nodes(nodeIdx).value))
        If dynamicPath = "" Then
            errText = "exec: dynamic field name missing"
            Return 0
        End If

        Dim dynamicOffset As Integer
        Dim dynamicErr As String
        If TypeLayoutResolvePath(ps, dynamicType, dynamicPath, dynamicOffset, targetTypeOut, targetSizeOut, dynamicErr) = 0 Then
            errText = "exec: dynamic field resolve failed " & dynamicErr
            Return 0
        End If

        rootAddrOut = dynamicAddr
        baseAddrOut = dynamicAddr + CUInt(dynamicOffset)
        rootTypeOut = UCase(Trim(dynamicType))
        pathOut = dynamicPath
        targetTypeOut = UCase(Trim(targetTypeOut))
        Return 1
    End If

    Dim rootIdx As Integer
    rootIdx = ExecFindVar(es, rootName)
    If rootIdx = -1 Then
        errText = "exec: field root variable missing " & rootName
        Return 0
    End If

    Dim rootDeclType As String
    Dim rootRuntimeType As String
    rootDeclType = UCase(Trim(es.vars(rootIdx).declType))
    rootRuntimeType = UCase(Trim(es.vars(rootIdx).runtimeClassType))

    Dim rootType As String
    Dim baseAddr As UInteger

    Dim rootNodeKind As String
    rootNodeKind = ""
    If rootNode >= 0 And rootNode < ps.ast.count Then rootNodeKind = UCase(Trim(ps.ast.nodes(rootNode).kind))

    If rootNodeKind = "CALL_EXPR" Then
        Dim arrayVarIdx As Integer
        Dim elemIndex As Integer
        Dim arrayTry As Integer
        arrayTry = ExecTryResolveArrayAccess(ps, es, rootNode, arrayVarIdx, elemIndex, errText)
        If arrayTry <= 0 Then
            If arrayTry = 0 Then errText = "exec: indexed field root must be DIM array access"
            Return 0
        End If

        If arrayVarIdx <> rootIdx Then
            errText = "exec: indexed field root variable mismatch"
            Return 0
        End If

        rootType = rootDeclType
        If rootType = "" Then
            errText = "exec: field root type missing for " & rootName
            Return 0
        End If

        Dim elemSize As Integer
        elemSize = ExecTypeElemSizeBytes(rootType)
        If elemSize <= 0 Then
            Dim elemLayoutErr As String
            If TypeLayoutSizeOf(ps, rootType, elemSize, elemLayoutErr) = 0 Then
                errText = "exec: indexed field element layout missing " & elemLayoutErr
                Return 0
            End If
        End If

        If elemSize <= 0 Then
            errText = "exec: indexed field element size invalid"
            Return 0
        End If

        baseAddr = es.vars(rootIdx).addr + CUInt(elemIndex * elemSize)
    ElseIf rootDeclType = "OBJECT" Or ExecFindClassDeclNode(ps, rootDeclType) <> -1 Then
        rootType = IIf(rootRuntimeType <> "", rootRuntimeType, rootDeclType)
        baseAddr = CUInt(ExecValueToInteger(es.vars(rootIdx).value))
        If baseAddr = 0 Then
            ' S-108: a class variable that was never assigned is a NULL reference (no default object)
            errText = "exec: field access on a null object reference: " & UCase(Trim(rootName))
            Return 0
        End If
    Else
        rootType = rootDeclType
        baseAddr = es.vars(rootIdx).addr
    End If

    If rootType = "" Then
        errText = "exec: field root type missing for " & rootName
        Return 0
    End If
    If baseAddr = 0 Then
        errText = "exec: field root address missing for " & rootName
        Return 0
    End If

    Dim fieldErr As String
    Dim fieldOffset As Integer
    If TypeLayoutResolvePath(ps, rootType, pathText, fieldOffset, targetTypeOut, targetSizeOut, fieldErr) = 0 Then
        errText = "exec: field resolve failed " & fieldErr
        Return 0
    End If

    rootAddrOut = baseAddr
    baseAddrOut = baseAddr + CUInt(fieldOffset)
    rootTypeOut = rootType
    pathOut = pathText
    targetTypeOut = UCase(Trim(targetTypeOut))
    Return 1
End Function

Private Function ExecTryReadEnumMember(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef handledOut As Integer, ByRef valueOut As ExecValue, ByRef errText As String) As Integer
    handledOut = 0

    Dim rootName As String
    Dim pathText As String
    Dim rootNode As Integer
    Dim pathErr As String
    If ExecBuildFieldPath(ps, es, nodeIdx, rootName, pathText, rootNode, pathErr) = 0 Then Return 1
    If InStr(pathText, ".") > 0 Then Return 1

    Dim enumNode As Integer
    enumNode = -1
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) = "ENUM_STMT" And UCase(Trim(ps.ast.nodes(i).value)) = UCase(Trim(rootName)) Then
            enumNode = i
            Exit For
        End If
    Next i
    If enumNode = -1 Then Return 1

    handledOut = 1
    Dim itemNode As Integer
    itemNode = ps.ast.nodes(enumNode).firstChild
    Do While itemNode <> -1
        If UCase(Trim(ps.ast.nodes(itemNode).kind)) = "ENUM_ITEM" And UCase(Trim(ps.ast.nodes(itemNode).value)) = UCase(Trim(pathText)) Then
            Dim valueText As String
            valueText = Trim(ps.ast.nodes(itemNode).op)
            If valueText = "" Then
                errText = "exec: enum value was not resolved for " & rootName & "." & pathText
                Return 0
            End If

            Dim enumValue As LongInt
            enumValue = CLngInt(Val(valueText))
            If enumValue < -2147483648LL Or enumValue > 2147483647LL Then
                errText = "exec: enum value exceeds the AST interpreter I32 range for " & rootName & "." & pathText
                Return 0
            End If
            ExecValueSetInteger valueOut, CInt(enumValue)
            Return 1
        End If
        itemNode = ps.ast.nodes(itemNode).nextSibling
    Loop

    errText = "exec: unknown enum member " & rootName & "." & pathText
    Return 0
End Function

' S-095: a TYPE field of a native scalar type is read and written at ITS width
' with ITS representation. The AST interpreter used to treat every field that was
' not I8/U8/I16/U16 as a 32-bit integer: F64/F32 fields were rounded to integers
' (1.5 -> 2), I64/U64/PTR fields were cut to their low 32 bits, and an I8 field
' read back unsigned (-3 -> 253). Returns "I" (signed integer), "U" (unsigned
' integer), "F" (IEEE float) or "" when the field is not a native scalar (nested
' TYPE, string handle, ... keep their existing size-based path), and its byte width.
' S-158: TYPE/CLASS STRING alanlari. AST alanlari sanal bellekte (VMem) hucre olarak tutar; metin eskiden
' ExecValueToInteger ile SAYIYA cevrilip yaziliyordu (k.ad = "abc" -> 0, STR(55)+"-x" -> 55). Hucreye
' artik metin havuzundaki tutamac yazilir (0 = bos metin). Metin degismez (her yazim yeni tutamac),
' boylece TYPE kopyasi (k2 = k) bayt kopyasiyla ayni metni guvenle paylasir.
Dim Shared gExecFieldStrings(Any) As String
Dim Shared gExecFieldStringCount As Integer

Private Sub ExecFieldStringsReset()
    ReDim gExecFieldStrings(0)
    gExecFieldStringCount = 0
End Sub

Private Function ExecFieldStringIntern(ByRef textValue As String) As LongInt
    If textValue = "" Then Return 0
    If gExecFieldStringCount = 0 Then
        ReDim gExecFieldStrings(1)
        gExecFieldStringCount = 1
    ElseIf gExecFieldStringCount > UBound(gExecFieldStrings) Then
        ReDim Preserve gExecFieldStrings(gExecFieldStringCount * 2)
    End If
    gExecFieldStrings(gExecFieldStringCount) = textValue
    gExecFieldStringCount += 1
    Return gExecFieldStringCount - 1
End Function

Private Function ExecFieldStringLookup(ByVal handleValue As LongInt) As String
    If handleValue <= 0 Or handleValue >= gExecFieldStringCount Then Return ""
    Return gExecFieldStrings(CInt(handleValue))
End Function

Private Function ExecFieldIsString(ByRef fieldTypeRaw As String) As Integer
    Dim t As String = UCase(Trim(fieldTypeRaw))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)
    Return IIf(t = "STRING", 1, 0)
End Function

Private Function ExecFieldScalarKind(ByRef fieldTypeRaw As String, ByRef widthOut As Integer) As String
    Dim t As String
    t = UCase(Trim(fieldTypeRaw))
    If Left(t, 5) = "TYPE_" Then t = Mid(t, 6)
    widthOut = 0
    Select Case t
    Case "I8", "BYTE", "SBYTE": widthOut = 1: Return "I"
    Case "U8", "UBYTE": widthOut = 1: Return "U"
    Case "I16", "SHORT": widthOut = 2: Return "I"
    Case "U16", "USHORT": widthOut = 2: Return "U"
    Case "I32", "INTEGER", "LONG": widthOut = 4: Return "I"
    Case "U32", "UINTEGER", "UINT", "ULONG": widthOut = 4: Return "U"
    Case "I64", "LONGINT": widthOut = 8: Return "I"
    Case "U64", "ULONGINT", "PTR", "STRPTR", "WSTRPTR": widthOut = 8: Return "U"
    Case "F32", "SINGLE": widthOut = 4: Return "F"
    Case "F64", "DOUBLE": widthOut = 8: Return "F"
    End Select
    Return ""
End Function

Private Sub ExecReadScalarField(ByRef kindText As String, ByVal widthBytes As Integer, ByVal fieldAddr As UInteger, ByRef valueOut As ExecValue)
    Dim raw As ULongInt
    Select Case widthBytes
    Case 1: raw = CULngInt(VMemPeekB(fieldAddr) And &hFF)
    Case 2: raw = CULngInt(VMemPeekW(fieldAddr) And &hFFFF)
    Case 4: raw = CULngInt(VMemPeekD(fieldAddr)) And &hFFFFFFFFULL
    Case Else: raw = CULngInt(VMemPeekQ(fieldAddr))
    End Select

    If kindText = "F" Then
        If widthBytes = 4 Then
            Dim lowBits As ULong
            lowBits = CULng(raw And &hFFFFFFFFULL)
            ExecValueSetFloat valueOut, CDbl(*CPtr(Single Ptr, @lowBits))
        Else
            ExecValueSetFloat valueOut, *CPtr(Double Ptr, @raw)
        End If
    ElseIf kindText = "I" Then
        Dim signedValue As LongInt
        signedValue = CLngInt(raw)
        Select Case widthBytes
        Case 1: If signedValue >= &h80 Then signedValue -= &h100
        Case 2: If signedValue >= &h8000 Then signedValue -= &h10000
        Case 4: If signedValue >= &h80000000LL Then signedValue -= &h100000000LL
        End Select
        If widthBytes = 8 Then ExecValueSetI64 valueOut, signedValue Else ExecValueSetInteger valueOut, CInt(signedValue)
    Else
        If widthBytes >= 4 Then ExecValueSetU64 valueOut, raw Else ExecValueSetInteger valueOut, CInt(raw)
    End If
End Sub

Private Function ExecWriteScalarField(ByRef kindText As String, ByVal widthBytes As Integer, ByVal fieldAddr As UInteger, ByRef valueIn As ExecValue) As Integer
    If kindText = "F" Then
        Dim floatValue As Double
        floatValue = ExecValueToFloat(valueIn)
        If widthBytes = 4 Then
            Dim singleValue As Single
            Dim singleBits As ULong
            singleValue = CSng(floatValue)
            singleBits = *CPtr(ULong Ptr, @singleValue)
            Return VMemPokeD(fieldAddr, CInt(singleBits))
        End If
        Dim doubleBits As LongInt
        doubleBits = *CPtr(LongInt Ptr, @floatValue)
        Return VMemPokeQ(fieldAddr, doubleBits)
    End If

    Dim bits As ULongInt
    bits = ExecValueToU64(valueIn)
    Select Case widthBytes
    Case 1: Return VMemPokeB(fieldAddr, CInt(bits And &hFFULL))
    Case 2: Return VMemPokeW(fieldAddr, CInt(bits And &hFFFFULL))
    Case 4: Return VMemPokeD(fieldAddr, CInt(bits And &hFFFFFFFFULL))
    End Select
    Return VMemPokeQ(fieldAddr, CLngInt(bits))
End Function

Private Function ExecReadFieldValue(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef valueOut As ExecValue, ByRef errText As String) As Integer
    Dim namespaceConstDecl As Integer
    Dim namespaceConstInit As Integer
    If UXBAstResolveNamespaceConstField(ps.ast, nodeIdx, namespaceConstDecl, namespaceConstInit) <> 0 Then
        Return ExecEvalExpression(ps, namespaceConstInit, es, valueOut, errText)
    End If

    Dim enumHandled As Integer
    If ExecTryReadEnumMember(ps, es, nodeIdx, enumHandled, valueOut, errText) = 0 Then Return 0
    If enumHandled <> 0 Then Return 1

    ' S-030: TASK/TASKGROUP tutamaci .STATUS/.RESULT/.ERRORTEXT alanlari --
    ' gercek bir CLASS degildir, bu yuzden asagidaki alan cozumleyicisinden
    ' once, ozel tutamac yolundan gecer.
    Dim taskReceiverNodeIdx As Integer
    taskReceiverNodeIdx = ps.ast.nodes(nodeIdx).left
    Dim taskKind As String
    Dim taskHandleId As Integer
    Dim taskRecvRv As Integer
    taskRecvRv = ExecTaskReceiverInfo(ps, es, taskReceiverNodeIdx, taskKind, taskHandleId, errText)
    If taskRecvRv = 0 Then Return 0
    If taskRecvRv > 0 Then
        ' S-146: ertelenmis gorevin sonucu okunurken gorev simdi calisir.
        If taskKind = "TASK" AndAlso taskHandleId <> 0 AndAlso UCase(Trim(ps.ast.nodes(nodeIdx).value)) = "RESULT" Then
            If ExecTaskRunIfDeferred(ps, es, taskHandleId, errText) = 0 Then Return 0
        End If
        Return ExecReadTaskField(taskKind, taskHandleId, ps.ast.nodes(nodeIdx).value, valueOut, errText)
    End If

    Dim fieldAddr As UInteger
    Dim fieldType As String
    Dim fieldSize As Integer
    Dim rootType As String
    Dim rootAddr As UInteger
    Dim pathText As String
    Dim resolveErr As String
    If ExecResolveFieldAccess(ps, es, nodeIdx, fieldAddr, fieldType, fieldSize, rootType, rootAddr, pathText, resolveErr) = 0 Then
        Dim magicErr As String
        magicErr = ""
        If ExecTryInvokeMagicFieldGet(ps, es, nodeIdx, valueOut, magicErr) <> 0 Then Return 1
        If magicErr <> "" Then
            errText = magicErr
        Else
            errText = resolveErr
        End If
        Return 0
    End If

    Dim isStaticField As Integer
    Dim isReadonlyField As Integer
    Dim staticFieldKey As String
    Dim allowRead As Integer
    Dim allowWrite As Integer
    Dim fieldNode As Integer
    If ExecResolveFieldPolicy(ps, rootType, pathText, isStaticField, isReadonlyField, staticFieldKey, allowRead, allowWrite, fieldNode) <> 0 Then
        If allowRead = 0 Then
            errText = "exec: property GET accessor denied " & pathText
            Return 0
        End If
        If fieldNode <> -1 And UCase(ps.ast.nodes(fieldNode).kind) = "CLASS_PROPERTY_DECL" Then
            If ExecRunClassPropertyGetBody(ps, es, fieldNode, rootType, rootAddr, valueOut, errText) <> 0 Then Return 1
        End If
        If isStaticField <> 0 Then
            If ExecStaticFieldRead(staticFieldKey, valueOut) = 0 Then
                valueOut = ExecFieldZeroValue(fieldType)
            End If
            Return 1
        End If
    End If

    If ExecFieldIsString(fieldType) <> 0 Then
        ExecValueInit valueOut
        valueOut.valueType = "STRING"
        If fieldSize >= 8 Then
            valueOut.stringValue = ExecFieldStringLookup(VMemPeekQ(fieldAddr))
        Else
            valueOut.stringValue = ExecFieldStringLookup(CLngInt(VMemPeekD(fieldAddr)))
        End If
        Return 1
    End If

    Dim readScalarWidth As Integer
    Dim readScalarKind As String
    readScalarKind = ExecFieldScalarKind(fieldType, readScalarWidth)
    If readScalarKind <> "" Then
        ExecReadScalarField readScalarKind, readScalarWidth, fieldAddr, valueOut
        Return 1
    End If

    Select Case fieldType
    Case "I8", "U8"
        ExecValueSetInteger valueOut, VMemPeekB(fieldAddr)
    Case "I16", "U16", "SHORT"
        ExecValueSetInteger valueOut, VMemPeekW(fieldAddr)
    Case Else
        If fieldSize = 1 Then
            ExecValueSetInteger valueOut, VMemPeekB(fieldAddr)
        ElseIf fieldSize = 2 Then
            ExecValueSetInteger valueOut, VMemPeekW(fieldAddr)
        Else
            ExecValueSetInteger valueOut, VMemPeekD(fieldAddr)
        End If
    End Select

    Return 1
End Function

Private Function ExecWriteFieldValue(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef valueIn As ExecValue, ByRef errText As String) As Integer
    Dim fieldAddr As UInteger
    Dim fieldType As String
    Dim fieldSize As Integer
    Dim rootType As String
    Dim rootAddr As UInteger
    Dim pathText As String
    Dim resolveErr As String
    If ExecResolveFieldAccess(ps, es, nodeIdx, fieldAddr, fieldType, fieldSize, rootType, rootAddr, pathText, resolveErr) = 0 Then
        Dim magicErr As String
        magicErr = ""
        If ExecTryInvokeMagicFieldSet(ps, es, nodeIdx, valueIn, magicErr) <> 0 Then Return 1
        If magicErr <> "" Then
            errText = magicErr
        Else
            errText = resolveErr
        End If
        Return 0
    End If

    Dim isStaticField As Integer
    Dim isReadonlyField As Integer
    Dim staticFieldKey As String
    Dim allowRead As Integer
    Dim allowWrite As Integer
    Dim fieldNode As Integer
    If ExecResolveFieldPolicy(ps, rootType, pathText, isStaticField, isReadonlyField, staticFieldKey, allowRead, allowWrite, fieldNode) <> 0 Then
        If allowWrite = 0 Then
            errText = "exec: property SET accessor denied " & pathText
            Return 0
        End If
        If fieldNode <> -1 And UCase(ps.ast.nodes(fieldNode).kind) = "CLASS_PROPERTY_DECL" Then
            If ExecRunClassPropertySetBody(ps, es, fieldNode, rootType, rootAddr, valueIn, errText) <> 0 Then Return 1
        End If
        If isReadonlyField <> 0 Then
            errText = "exec: readonly/immutable field assignment denied " & pathText
            Return 0
        End If

        If isStaticField <> 0 Then
            ExecStaticFieldWrite staticFieldKey, valueIn
            Return 1
        End If
    End If

    If ExecFieldIsString(fieldType) <> 0 Then
        Dim fieldTextHandle As LongInt = ExecFieldStringIntern(ExecValueToString(valueIn))
        Dim fieldTextOk As Integer
        If fieldSize >= 8 Then
            fieldTextOk = VMemPokeQ(fieldAddr, fieldTextHandle)
        Else
            fieldTextOk = VMemPokeD(fieldAddr, CInt(fieldTextHandle))
        End If
        If fieldTextOk = 0 Then errText = "exec: field write out of range": Return 0
        Return 1
    End If

    Dim writeScalarWidth As Integer
    Dim writeScalarKind As String
    writeScalarKind = ExecFieldScalarKind(fieldType, writeScalarWidth)
    If writeScalarKind <> "" Then
        If ExecWriteScalarField(writeScalarKind, writeScalarWidth, fieldAddr, valueIn) = 0 Then errText = "exec: field write out of range": Return 0
        Return 1
    End If

    Dim rawValue As Integer
    rawValue = ExecValueToInteger(valueIn)

    Select Case fieldType
    Case "I8", "U8"
        If VMemPokeB(fieldAddr, rawValue) = 0 Then errText = "exec: field write out of range": Return 0
    Case "I16", "U16", "SHORT"
        If VMemPokeW(fieldAddr, rawValue) = 0 Then errText = "exec: field write out of range": Return 0
    Case Else
        If VMemPokeD(fieldAddr, rawValue) = 0 Then errText = "exec: field write out of range": Return 0
    End Select

    Return 1
End Function

Private Function ExecResolveImplicitThisField(ByRef ps As ParseState, ByRef es As ExecState, ByRef fieldName As String, ByRef fieldAddrOut As UInteger, ByRef fieldTypeOut As String, ByRef fieldSizeOut As Integer, ByRef foundOut As Integer, ByRef errText As String) As Integer
    foundOut = 0
    fieldAddrOut = 0
    fieldTypeOut = ""
    fieldSizeOut = 0

    Dim thisIdx As Integer
    thisIdx = ExecFindVar(es, "THIS")
    If thisIdx = -1 Then Return 1

    Dim thisType As String
    thisType = UCase(Trim(es.vars(thisIdx).runtimeClassType))
    If thisType = "" Then thisType = UCase(Trim(es.vars(thisIdx).declType))
    If thisType = "" OrElse ExecFindClassDeclNode(ps, thisType) = -1 Then Return 1

    Dim fieldOffset As Integer
    Dim layoutErr As String
    If TypeLayoutResolvePath(ps, thisType, fieldName, fieldOffset, fieldTypeOut, fieldSizeOut, layoutErr) = 0 Then Return 1

    Dim thisAddr As UInteger
    thisAddr = CUInt(ExecValueToInteger(es.vars(thisIdx).value))
    If thisAddr = 0 Then
        errText = "exec: implicit field receiver is null: " & fieldName
        Return 0
    End If

    fieldAddrOut = thisAddr + CUInt(fieldOffset)
    fieldTypeOut = UCase(Trim(fieldTypeOut))
    foundOut = 1
    Return 1
End Function

Private Function ExecTryReadImplicitThisField(ByRef ps As ParseState, ByRef es As ExecState, ByRef fieldName As String, ByRef foundOut As Integer, ByRef valueOut As ExecValue, ByRef errText As String) As Integer
    Dim fieldAddr As UInteger
    Dim fieldType As String
    Dim fieldSize As Integer
    If ExecResolveImplicitThisField(ps, es, fieldName, fieldAddr, fieldType, fieldSize, foundOut, errText) = 0 Then Return 0
    If foundOut = 0 Then Return 1

    Dim implicitReadWidth As Integer
    Dim implicitReadKind As String
    implicitReadKind = ExecFieldScalarKind(fieldType, implicitReadWidth)
    If implicitReadKind <> "" Then
        ExecReadScalarField implicitReadKind, implicitReadWidth, fieldAddr, valueOut
        Return 1
    End If

    Select Case fieldType
    Case "I8", "U8"
        ExecValueSetInteger valueOut, VMemPeekB(fieldAddr)
    Case "I16", "U16", "SHORT"
        ExecValueSetInteger valueOut, VMemPeekW(fieldAddr)
    Case Else
        If fieldSize = 1 Then
            ExecValueSetInteger valueOut, VMemPeekB(fieldAddr)
        ElseIf fieldSize = 2 Then
            ExecValueSetInteger valueOut, VMemPeekW(fieldAddr)
        Else
            ExecValueSetInteger valueOut, VMemPeekD(fieldAddr)
        End If
    End Select
    Return 1
End Function

Private Function ExecTryWriteImplicitThisField(ByRef ps As ParseState, ByRef es As ExecState, ByRef fieldName As String, ByRef valueIn As ExecValue, ByRef foundOut As Integer, ByRef errText As String) As Integer
    Dim fieldAddr As UInteger
    Dim fieldType As String
    Dim fieldSize As Integer
    If ExecResolveImplicitThisField(ps, es, fieldName, fieldAddr, fieldType, fieldSize, foundOut, errText) = 0 Then Return 0
    If foundOut = 0 Then Return 1

    Dim implicitWriteWidth As Integer
    Dim implicitWriteKind As String
    implicitWriteKind = ExecFieldScalarKind(fieldType, implicitWriteWidth)
    If implicitWriteKind <> "" Then
        If ExecWriteScalarField(implicitWriteKind, implicitWriteWidth, fieldAddr, valueIn) = 0 Then errText = "exec: implicit field write out of range": Return 0
        Return 1
    End If

    Dim rawValue As Integer
    rawValue = ExecValueToInteger(valueIn)
    Select Case fieldType
    Case "I8", "U8"
        If VMemPokeB(fieldAddr, rawValue) = 0 Then errText = "exec: implicit field write out of range": Return 0
    Case "I16", "U16", "SHORT"
        If VMemPokeW(fieldAddr, rawValue) = 0 Then errText = "exec: implicit field write out of range": Return 0
    Case Else
        If VMemPokeD(fieldAddr, rawValue) = 0 Then errText = "exec: implicit field write out of range": Return 0
    End Select
    Return 1
End Function

Private Sub ExecDefFnReset()
    gExecDefFnCount = 0
    Erase gExecDefFnEntries
End Sub

Private Function ExecIsExpressionNodeKind(ByRef kindRaw As String) As Integer
    Dim k As String
    k = UCase(Trim(kindRaw))
    Select Case k
    Case "NUMBER", "STRING", "IDENT", "KEYWORD_REF", "UNARY", "BINARY", "CALL_EXPR", "FIELD_EXPR", "NEW_EXPR", "TERNARY_EXPR", "INCDEC_EXPR"
        Return 1
    End Select
    Return 0
End Function

Private Function ExecTryExtractDefFnDeclaration(ByRef ps As ParseState, ByVal stmtIdx As Integer, ByRef fnNameOut As String, ByRef paramNameOut As String, ByRef exprNodeOut As Integer, ByRef errText As String) As Integer
    fnNameOut = UCase(Trim(ps.ast.nodes(stmtIdx).value))
    paramNameOut = ""
    exprNodeOut = -1

    Dim ch As Integer
    ch = ps.ast.nodes(stmtIdx).firstChild
    Do While ch <> -1
        Dim ck As String
        ck = UCase(Trim(ps.ast.nodes(ch).kind))

        If (ck = "PARAM_DECL" Or ck = "IDENT" Or ck = "KEYWORD_REF") And paramNameOut = "" Then
            paramNameOut = UCase(Trim(ps.ast.nodes(ch).value))
        End If

        If ck = "DEF_FN_EXPR" Then
            If ps.ast.nodes(ch).left <> -1 Then
                exprNodeOut = ps.ast.nodes(ch).left
            ElseIf ps.ast.nodes(ch).right <> -1 Then
                exprNodeOut = ps.ast.nodes(ch).right
            ElseIf ps.ast.nodes(ch).firstChild <> -1 Then
                exprNodeOut = ps.ast.nodes(ch).firstChild
            End If
        ElseIf exprNodeOut = -1 And ExecIsExpressionNodeKind(ck) <> 0 Then
            exprNodeOut = ch
        End If

        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If exprNodeOut = -1 Then
        If ps.ast.nodes(stmtIdx).right <> -1 And ExecIsExpressionNodeKind(ps.ast.nodes(ps.ast.nodes(stmtIdx).right).kind) <> 0 Then
            exprNodeOut = ps.ast.nodes(stmtIdx).right
        ElseIf ps.ast.nodes(stmtIdx).left <> -1 And ExecIsExpressionNodeKind(ps.ast.nodes(ps.ast.nodes(stmtIdx).left).kind) <> 0 Then
            exprNodeOut = ps.ast.nodes(stmtIdx).left
        End If
    End If

    If fnNameOut = "" Then
        errText = "exec: DEF FN name missing"
        Return 0
    End If
    If exprNodeOut = -1 Then
        errText = "exec: DEF FN expression missing " & fnNameOut
        Return 0
    End If
    Return 1
End Function

Private Function ExecRegisterDefFnStatement(ByRef ps As ParseState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim fnName As String
    Dim paramName As String
    Dim exprNode As Integer
    If ExecTryExtractDefFnDeclaration(ps, stmtIdx, fnName, paramName, exprNode, errText) = 0 Then Return 0

    Dim existingIdx As Integer
    existingIdx = -1
    Dim i As Integer
    For i = 0 To gExecDefFnCount - 1
        If gExecDefFnEntries(i).nameText = fnName Then
            existingIdx = i
            Exit For
        End If
    Next i

    If existingIdx = -1 Then
        existingIdx = gExecDefFnCount
        If gExecDefFnCount = 0 Then
            ReDim gExecDefFnEntries(0)
        Else
            ReDim Preserve gExecDefFnEntries(gExecDefFnCount)
        End If
        gExecDefFnCount += 1
    End If

    gExecDefFnEntries(existingIdx).nameText = fnName
    gExecDefFnEntries(existingIdx).paramName = paramName
    gExecDefFnEntries(existingIdx).exprNodeIdx = exprNode
    gExecDefFnEntries(existingIdx).declNodeIdx = stmtIdx
    Return 1
End Function

Private Function ExecTryEvalDefFnCall(ByRef ps As ParseState, ByRef es As ExecState, ByRef callName As String, ByVal callNodeIdx As Integer, ByRef valueOut As Integer, ByRef errText As String) As Integer
    Dim callUpper As String
    callUpper = UCase(Trim(callName))
    If callUpper = "" Then Return -1

    Dim fnIdx As Integer
    fnIdx = -1
    Dim i As Integer
    For i = 0 To gExecDefFnCount - 1
        If gExecDefFnEntries(i).nameText = callUpper Then
            fnIdx = i
            Exit For
        End If
    Next i
    If fnIdx = -1 Then Return -1

    Dim argCount As Integer
    argCount = ExecChildCount(ps, callNodeIdx)
    Dim needsParam As Integer
    needsParam = IIf(Trim(gExecDefFnEntries(fnIdx).paramName) <> "", 1, 0)
    If argCount <> needsParam Then
        errText = "exec: DEF FN arity mismatch " & callUpper & " expected=" & LTrim(Str(needsParam)) & " actual=" & LTrim(Str(argCount))
        Return 0
    End If

    Dim snapshotVars(Any) As ExecVar
    Dim snapshotCount As Integer
    Dim snapshotNextAddr As UInteger
    ExecSnapshotVars es, snapshotVars(), snapshotCount, snapshotNextAddr

    If needsParam <> 0 Then
        Dim argNode As Integer
        argNode = ExecChildAt(ps, callNodeIdx, 0)
        If argNode = -1 Then
            errText = "exec: DEF FN argument missing"
            ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
            Return 0
        End If

        Dim argValue As Integer
        argValue = ExecEvalNode(ps, es, argNode, errText)
        If errText <> "" Then
            ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
            Return 0
        End If
        ExecSetVar es, gExecDefFnEntries(fnIdx).paramName, argValue
    End If

    valueOut = ExecEvalNode(ps, es, gExecDefFnEntries(fnIdx).exprNodeIdx, errText)
    ExecRestoreVars es, snapshotVars(), snapshotCount, snapshotNextAddr
    If errText <> "" Then Return 0
    Return 1
End Function

#include once "exec/exec_eval_builtin_categories.fbs"

Private Function ExecEvalBuiltinCall(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNameRaw As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim callName As String
    callName = ExecFix8BCanonName(callNameRaw)
    ' FIX8_STR_NS_INC_FIXED_20260611: normalize BASIC string builtin aliases, e.g. LEFT$ -> LEFT.
    If Right(callName, 1) = "$" Then callName = Left(callName, Len(callName) - 1)

    Select Case callName
    Case "DLL", "API", "CALL"
        Return ExecEvalBuiltinFfiCategory(ps, es, callName, callNodeIdx, errText)

    Case "SIZEOF", "OFFSETOF", "INSTANCEOF"
        Return ExecEvalBuiltinLayoutCategory(ps, es, callName, callNodeIdx, errText)

    Case "ABS", "INT", "SGN", "VAL", "CINT", "CLNG", "CDBL", "CSNG", "FIX", "SQR", "SIN", "COS", "TAN", "ATN", "EXP", "LOG"
        ' S-137: the integer-only ExecEvalBuiltinScalarCategory path rounded the argument to an Integer
        ' first (`IF SQR(x) > 1.5`, `a(INT(2.7))`, `FOR i = 1 TO SQR(n)`, `VAL("2.75")` all computed on
        ' the rounded value). These builtins are evaluated by the value evaluator, which sees the whole
        ' argument; the caller that needs an Integer gets the value converted.
        Dim numericCallValue As ExecValue
        If ExecEvalExpression(ps, callNodeIdx, es, numericCallValue, errText) = 0 Then Return 0
        Return ExecValueToInteger(numericCallValue)

    Case "BOOLEAN", "BOOL", "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "PTR", "LEN", "ASC"
        Return ExecEvalBuiltinScalarCategory(ps, es, callName, callNodeIdx, errText)

    Case "UCASE", "LCASE", "LTRIM", "RTRIM", "TRIM", "LEFT", "RIGHT", "MID", "INSTR", "SPACE", "STRING", "CHR", "STR"
        Dim textCompat As String
        If ExecEvalNodeAsText(ps, es, callNodeIdx, textCompat, errText) = 0 Then Return 0
        ' Numeric execution path keeps integer return contract; text call side-effects are captured by text evaluator.
        Return 0

    Case "RND", "TIMER"
        Return ExecEvalBuiltinTimeRandomCategory(ps, es, callName, callNodeIdx, errText)

    Case "BIGINIT", "BIGF", "BIGD", "BALL", "BIGI", "BIGINT", "EXTFP", "FP80", "FP128"
        Dim bigCallValue As ExecValue
        If ExecBigCreateValue(ps, es, callNodeIdx, bigCallValue, errText) = 0 Then Return 0
        gExecLastCallValueEx = bigCallValue
        gExecLastCallValueExValid = 1
        Return 0

    Case "LOF", "EOF"
        Return ExecEvalBuiltinFileCategory(ps, es, callName, callNodeIdx, errText)

    Case "INKEY", "GETKEY"
        Return ExecEvalBuiltinKeyboardCategory(ps, es, callName, callNodeIdx, errText)

    Case "PEEK", "PEEKB", "PEEKW", "PEEKD", "PEEKQ"
        Return ExecEvalBuiltinPeekCategory(ps, es, callName, callNodeIdx, errText)

    Case "VARPTR", "SADD", "LPTR", "CODEPTR"
        Return ExecEvalBuiltinPointerCategory(ps, es, callName, callNodeIdx, errText)

    Case "LBOUND", "UBOUND"
        Return ExecEvalBuiltinArrayBoundsCategory(ps, es, callName, callNodeIdx, errText)

    Case "LIST_NEW", "DICT_NEW", "SET_NEW", "LISTLEN", "LISTGET", "LISTSET", "LISTADD", "LISTREMOVE", "LISTCLEAR", "DICTLEN", "DICTHAS", "DICTGET", "DICTSET", "DICTCLEAR", "SETLEN", "SETHAS", "SETADD", "SETREMOVE", "SETCLEAR"
        Return ExecEvalBuiltinCollectionCategory(ps, es, callName, callNodeIdx, errText)

    Case Else
        errText = "exec: unsupported call " & callName
        Return 0
    End Select
End Function

' S-156: ifade icindeki FUNCTION'da calisan END'in isaret metni (hata degil; bkz. ExecRunMemoryProgram).
Const UXB_EXEC_END_SIGNAL_TEXT As String = "exec: END (program sonu)"
#include once "exec/exec_call_dispatch_helpers.fbs"
#include once "exec/exec_task_handle.fbs"

Private Function ExecEvalUserCall(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNameRaw As String, ByVal callNodeIdx As Integer, ByVal expectValue As Integer, ByRef valueOut As Integer, ByRef errText As String) As Integer
    Dim callName As String
    callName = ExecFix8BCanonName(callNameRaw)

    Dim routineIdx As Integer
    routineIdx = ExecRoutineIndexOf(es, callName)
    If routineIdx = -1 Then
        Dim defFnRv As Integer
        defFnRv = ExecTryEvalDefFnCall(ps, es, callName, callNodeIdx, valueOut, errText)
        If defFnRv > 0 Then Return 1
        If defFnRv = 0 Then Return 0
        errText = "exec: unsupported call " & callName
        Return 0
    End If

    Return ExecInvokeRoutineByIndex(ps, es, routineIdx, callNodeIdx, expectValue, 0, 0, valueOut, errText)
End Function

Private Function ExecAliasIndexHashOf(ByRef key As String) As UInteger
    Dim h As UInteger = 2166136261
    Dim i As Integer
    For i = 1 To Len(key)
        h = (h Xor Asc(Mid(key, i, 1))) * 16777619
    Next i
    Return h
End Function

' Appends nodeIdx to the tail of the chain for key, preserving ascending
' AST-index order within a key (matches the original 0..count-1 scan order).
Private Sub ExecAliasIndexInsert(ByRef ps As ParseState, ByRef key As String, ByVal nodeIdx As Integer)
    Dim baseSlot As UInteger
    baseSlot = ExecAliasIndexHashOf(key) Mod ps.aliasIndexCap
    Dim probe As Integer
    For probe = 0 To ps.aliasIndexCap - 1
        Dim slotPos As Integer
        slotPos = (baseSlot + probe) Mod ps.aliasIndexCap
        If ps.aliasIndexSlots(slotPos).used = 0 Then
            ps.aliasIndexSlots(slotPos).used = 1
            ps.aliasIndexSlots(slotPos).key = key
            ps.aliasIndexSlots(slotPos).headIdx = nodeIdx
            ps.aliasIndexSlots(slotPos).tailIdx = nodeIdx
            ps.aliasChainNext(nodeIdx) = -1
            Exit Sub
        End If
        If ps.aliasIndexSlots(slotPos).key = key Then
            ps.aliasChainNext(ps.aliasIndexSlots(slotPos).tailIdx) = nodeIdx
            ps.aliasChainNext(nodeIdx) = -1
            ps.aliasIndexSlots(slotPos).tailIdx = nodeIdx
            Exit Sub
        End If
    Next probe
End Sub

Private Function ExecAliasIndexFindHead(ByRef ps As ParseState, ByRef key As String) As Integer
    If ps.aliasIndexCap <= 0 Then Return -1
    Dim baseSlot As UInteger
    baseSlot = ExecAliasIndexHashOf(key) Mod ps.aliasIndexCap
    Dim probe As Integer
    For probe = 0 To ps.aliasIndexCap - 1
        Dim slotPos As Integer
        slotPos = (baseSlot + probe) Mod ps.aliasIndexCap
        If ps.aliasIndexSlots(slotPos).used = 0 Then Return -1
        If ps.aliasIndexSlots(slotPos).key = key Then Return ps.aliasIndexSlots(slotPos).headIdx
    Next probe
    Return -1
End Function

' Builds an alias-name -> ALIAS_STMT-node-chain index over the whole program AST
' once, so resolving CALL(alias) at each call site no longer rescans every AST
' node in the program (previously O(ast size) per call site, compounding badly
' as a library wrapper file's declared-function count grows).
Private Sub ExecBuildAliasIndexIfNeeded(ByRef ps As ParseState)
    If ps.aliasIndexBuilt <> 0 And ps.aliasIndexAstCount = ps.ast.count Then Exit Sub

    Dim cap As Integer
    cap = 64
    Do While cap * 100 < ps.ast.count * 100
        cap *= 2
    Loop

    ReDim ps.aliasIndexSlots(cap - 1)
    Dim s As Integer
    For s = 0 To cap - 1
        ps.aliasIndexSlots(s).used = 0
        ps.aliasIndexSlots(s).key = ""
        ps.aliasIndexSlots(s).headIdx = -1
        ps.aliasIndexSlots(s).tailIdx = -1
    Next s
    ps.aliasIndexCap = cap

    If ps.ast.count > 0 Then
        ReDim ps.aliasChainNext(ps.ast.count - 1)
    End If

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(ps.ast.nodes(i).kind) = "ALIAS_STMT" Then
            Dim key As String
            key = UCase(Trim(ps.ast.nodes(i).value))
            ExecAliasIndexInsert ps, key, i
        End If
    Next i

    ps.aliasIndexBuilt = 1
    ps.aliasIndexAstCount = ps.ast.count
End Sub

Private Function ExecFindAliasTargetText(ByRef ps As ParseState, ByRef aliasUpper As String, ByVal callLineNo As Integer, ByRef targetTextOut As String, ByRef foundOut As Integer, ByRef errText As String) As Integer
    foundOut = 0
    targetTextOut = ""

    ExecBuildAliasIndexIfNeeded ps

    Dim bestAliasNode As Integer
    bestAliasNode = -1
    Dim bestLineNo As Integer
    bestLineNo = -2147483648

    Dim i As Integer
    i = ExecAliasIndexFindHead(ps, aliasUpper)
    Do While i <> -1
        Dim n As ASTNode
        n = ps.ast.nodes(i)
        If callLineNo <= 0 Then
            bestAliasNode = i
            Exit Do
        End If
        If n.lineNo <= callLineNo And n.lineNo >= bestLineNo Then
            bestAliasNode = i
            bestLineNo = n.lineNo
        End If
        i = ps.aliasChainNext(i)
    Loop

    If bestAliasNode = -1 Then Return 1

    Dim targetNode As Integer
    targetNode = ps.ast.nodes(bestAliasNode).firstChild
    If targetNode = -1 Or UCase(ps.ast.nodes(targetNode).kind) <> "ALIAS_TARGET" Then
        errText = "exec: ALIAS target missing for " & aliasUpper
        Return 0
    End If

    targetTextOut = Trim(ps.ast.nodes(targetNode).value)
    If targetTextOut = "" Then
        errText = "exec: ALIAS target is empty for " & aliasUpper
        Return 0
    End If

    foundOut = 1
    Return 1
End Function

Private Function ExecTryParseAliasCallRef(ByRef targetTextRaw As String, ByRef callRefOut As String) As Integer
    callRefOut = ""

    Dim s As String
    s = UCase(Trim(targetTextRaw))
    If s = "" Then Return 0

    Dim i As Integer
    For i = 1 To Len(s)
        Dim ch As String
        ch = Mid(s, i, 1)

        Dim code As Integer
        code = Asc(ch)
        If (code >= 65 And code <= 90) Or (code >= 48 And code <= 57) Or ch = "_" Or ch = "." Then
            ' allowed
        Else
            Return 0
        End If
    Next i

    callRefOut = s
    Return 1
End Function

Private Function ExecEvalCall(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNameRaw As String, ByVal callNodeIdx As Integer, ByVal expectValue As Integer, ByRef valueOut As Integer, ByRef errText As String) As Integer
    Dim callName As String
    callName = ExecFix8BCanonName(callNameRaw)
    ' FIX8_STR_NS_INC_FIXED_20260611: CALL_EXPR.value can carry LEFT$/UCASE$ in BASIC-compatible sources.
    If Right(callName, 1) = "$" Then callName = Left(callName, Len(callName) - 1)

    If ExecIsBuiltinCallName(callName) <> 0 Then
        valueOut = ExecEvalBuiltinCall(ps, es, callName, callNodeIdx, errText)
        If errText <> "" Then Return 0
        Return 1
    End If

    If InStr(callName, ".") > 0 Then
        ' HAMLE-2: Hamle-1 parser yamasindan gelen CALL_EXPR.left varsa
        ' metot alicisini string bolerek degil, gercek AST ifadesi olarak cozer.
        Dim receiverMethodRv As Integer
        receiverMethodRv = ExecTryEvalReceiverMethodCall(ps, es, callName, callNodeIdx, expectValue, valueOut, errText)
        If receiverMethodRv >= 0 Then Return receiverMethodRv

        ' Geri uyumluluk: Class.method(), SUPER.method() ve eski parser ciktisi.
        Return ExecEvalMethodCall(ps, es, callName, callNodeIdx, expectValue, valueOut, errText)
    End If

    ' A declared routine wins over the implicit same-named function result
    ' variable. This is required for recursion: FUNCTION F creates an F result
    ' slot, but F(...) must still call the routine instead of MAGIC_CALL.
    If ExecRoutineIndexOf(es, callName) <> -1 Then
        Return ExecEvalUserCall(ps, es, callName, callNodeIdx, expectValue, valueOut, errText)
    End If

    ' Callable object surface: obj(...) dispatches to MAGIC_CALL / __CALL when obj is a class instance.
    Dim magicCallRv As Integer
    magicCallRv = ExecTryEvalMagicCall(ps, es, callName, callNodeIdx, expectValue, valueOut, errText)
    If magicCallRv >= 0 Then Return magicCallRv

    Dim aliasFound As Integer
    Dim aliasTarget As String
    If ExecFindAliasTargetText(ps, callName, ps.ast.nodes(callNodeIdx).lineNo, aliasTarget, aliasFound, errText) = 0 Then
        Return 0
    End If

    If aliasFound <> 0 Then
        Dim aliasKind As String
        Dim aliasDll As String
        Dim aliasSymbol As String
        Dim aliasSig As String
        Dim aliasConv As String

        If ExecTryParseAliasFfiTarget(aliasTarget, aliasKind, aliasDll, aliasSymbol, aliasSig, aliasConv) <> 0 Then
            valueOut = ExecEvalDllCallCore(ps, es, callNodeIdx, aliasDll, aliasSymbol, aliasSig, aliasConv, 0, errText)
            If errText <> "" Then Return 0
            Return 1
        End If

        Dim aliasCallRef As String
        If ExecTryParseAliasCallRef(aliasTarget, aliasCallRef) <> 0 Then
            If aliasCallRef = callName Then
                errText = "exec: ALIAS self-cycle for " & callName
                Return 0
            End If

            gExecAliasResolveDepth += 1
            If gExecAliasResolveDepth > 32 Then
                gExecAliasResolveDepth = 0
                errText = "exec: ALIAS recursion depth exceeded for " & callName
                Return 0
            End If

            Dim aliasRv As Integer
            aliasRv = ExecEvalCall(ps, es, aliasCallRef, callNodeIdx, expectValue, valueOut, errText)
            gExecAliasResolveDepth -= 1
            Return aliasRv
        End If

        errText = "exec: unsupported ALIAS target for " & callName
        Return 0
    End If

    Return ExecEvalUserCall(ps, es, callName, callNodeIdx, expectValue, valueOut, errText)
End Function

Private Function ExecEvalNode(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "exec: invalid node index"
        Return 0
    End If

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)

    Select Case UCase(n.kind)
    Case "NUMBER"
        ' S-055 follow-up: FreeBASIC's ValInt() silently misbehaves outside
        ' signed-32-bit range -- it correctly returns the bit pattern for
        ' values that fit in 32 bits (matching B/W/D-width memory statements,
        ' which is why this was never noticed before), but returns a flat -1
        ' "parse failed" sentinel for anything wider (needed by the new Q
        ' 64-bit family: PEEKQ/POKEQ/MEMCOPYQ/MEMFILLQ, and by extension any
        ' other NUMBER literal this shared node evaluator is asked to widen).
        ' CLngInt(Val(...)) parses the full signed 64-bit range instead, and
        ' is already the established pattern for this in this same file (see
        ' the enum-value literal parse above) -- behaves identically to
        ' ValInt() for every value that already worked, so this is a pure
        ' widening with no behavior change in the previously-correct range.
        ' S-078: exact for every 64-bit pattern (a literal above I64 max keeps its
        ' bits); floating literals still go through Val.
        If UXBNumberLiteralIsFloat(n.value) <> 0 Then Return CLngInt(Val(n.value))
        If Left(Trim(n.value), 1) = "-" Then Return ValLng(n.value)
        Return CLngInt(ValULng(n.value))

    Case "STRING"
        Return ValInt(n.value)

    Case "BOOLEAN"
        Return IIf(UCase(Trim(n.value)) = "TRUE" Or Trim(n.value) = "-1", -1, 0)

    Case "IDENT"
        Dim identValue As Integer
        Dim identResolve As Integer
        identResolve = ExecResolveThisMeIdentValue(es, n.value, identValue, errText)
        If identResolve = 0 Then Return 0
        If identResolve = 2 Then
            ' S-140: not a variable/constant -> a constant of the running routine's namespace?
            Dim identNsValue As ExecValue
            Dim identNsFound As Integer
            If ExecTryReadEnclosingNamespaceConst(ps, es, UCase(Trim(n.value)), identNsFound, identNsValue, errText) = 0 Then Return 0
            If identNsFound <> 0 Then Return ExecValueToInteger(identNsValue)
        End If
        Return identValue

    Case "KEYWORD_REF"
        Dim keywordValue As Integer
        If ExecResolveThisMeIdentValue(es, n.value, keywordValue, errText) = 0 Then Return 0
        Return keywordValue

    Case "UNARY"
        Dim unaryExprNode As Integer
        unaryExprNode = n.left
        If unaryExprNode = -1 Then unaryExprNode = n.right
        If unaryExprNode = -1 Then
            errText = "exec: unary operand missing"
            Return 0
        End If

        Dim rv As Integer
        Select Case n.op
        Case "+"
            rv = ExecEvalNode(ps, es, unaryExprNode, errText)
            If errText <> "" Then Return 0
            Return rv
        Case "-"
            rv = ExecEvalNode(ps, es, unaryExprNode, errText)
            If errText <> "" Then Return 0
            Return -rv
        Case "LNOT", "!"
            rv = ExecEvalNode(ps, es, unaryExprNode, errText)
            If errText <> "" Then Return 0
            If rv = 0 Then Return -1 Else Return 0
        Case "NOT"
            rv = ExecEvalNode(ps, es, unaryExprNode, errText)
            If errText <> "" Then Return 0
            Return Not rv
        Case "BNOT", "~", "BITNOT"
            rv = ExecEvalNode(ps, es, unaryExprNode, errText)
            If errText <> "" Then Return 0
            Return Not rv
        Case "@"
            Dim addrNode As ASTNode
            addrNode = ps.ast.nodes(unaryExprNode)
            If UCase(addrNode.kind) = "IDENT" Then
                Dim identAddr As UInteger
                If ExecResolveThisMeIdentAddr(es, addrNode.value, identAddr, errText) = 0 Then Return 0
                Return CInt(identAddr)
            End If

            rv = ExecEvalNode(ps, es, unaryExprNode, errText)
            If errText <> "" Then Return 0
            Return &h10000000 Or (rv And &h00FFFFFF)
        Case Else
            errText = "exec: unsupported unary op " & n.op
            Return 0
        End Select

    Case "INCDEC_EXPR"
        Dim exprTarget As Integer
        exprTarget = n.left
        If exprTarget = -1 Then
            errText = "exec: INCDEC expression target missing"
            Return 0
        End If

        Dim oldVal As Integer
        Dim newVal As Integer
        Dim idxVar As Integer
        Dim idxElem As Integer
        Dim tmpVal As ExecValue

        If UCase(ps.ast.nodes(exprTarget).kind) = "IDENT" Then
            oldVal = ExecGetVar(es, ps.ast.nodes(exprTarget).value)
            If Trim(n.op) = "--" Then
                newVal = oldVal - 1
            Else
                newVal = oldVal + 1
            End If
            ExecSetVar es, ps.ast.nodes(exprTarget).value, newVal
        ElseIf ExecTryResolveArrayAccess(ps, es, exprTarget, idxVar, idxElem, errText) <> 0 Then
            If ExecGetArrayElement(es, idxVar, idxElem, tmpVal) = 0 Then
                If errText = "" Then errText = "exec: INCDEC expression array read failed"
                Return 0
            End If
            oldVal = ExecValueToInteger(tmpVal)
            If Trim(n.op) = "--" Then
                newVal = oldVal - 1
            Else
                newVal = oldVal + 1
            End If
            ExecValueSetInteger tmpVal, newVal
            If ExecSetArrayElement(es, idxVar, idxElem, tmpVal) = 0 Then
                errText = "exec: INCDEC expression array write failed"
                Return 0
            End If
        ElseIf UCase(ps.ast.nodes(exprTarget).kind) = "FIELD_EXPR" Then
            ' S-130: `obj.n++` / `THIS.n--` (the statement form INCDEC_STMT already handled fields)
            If ExecReadFieldValue(ps, es, exprTarget, tmpVal, errText) = 0 Then Return 0
            oldVal = ExecValueToInteger(tmpVal)
            If Trim(n.op) = "--" Then
                newVal = oldVal - 1
            Else
                newVal = oldVal + 1
            End If
            ExecValueSetInteger tmpVal, newVal
            If ExecWriteFieldValue(ps, es, exprTarget, tmpVal, errText) = 0 Then Return 0
        Else
            If errText = "" Then errText = "exec: INCDEC expression target must be ident, indexed array or field"
            Return 0
        End If

        If UCase(Trim(n.value)) = "POST" Then
            Return oldVal
        End If
        Return newVal

    Case "BINARY"
        ' S-077: this evaluator computes in the host Integer and reads variables
        ' through ExecGetVar, which saturates a 64-bit value to 32 bits -- so
        ' `IF bigI64 > 3000000000` and every U64 ordering were wrong here. When an
        ' operand's static type is I64/U64, hand the whole expression to the value
        ' evaluator (full 64-bit patterns, static-type-driven signedness).
        Dim wideOpNorm As String
        wideOpNorm = UCase(Trim(n.op))
        If wideOpNorm <> "|>" And wideOpNorm <> "&&" And wideOpNorm <> "||" And wideOpNorm <> "ANDALSO" And wideOpNorm <> "ORELSE" Then
            ' S-088: a U32 operand/result also needs the value evaluator (the 32-bit
            ' evaluator saw `1 - 2` on U32 as -1 and `(a - b) > 5` as false). The type pass
            ' stamps every expression node's canonical type in typeName.
            Dim u32Involved As Integer
            u32Involved = 0
            If UXBStep3TypeIsU32(n.typeName) <> 0 Then u32Involved = 1
            If n.left >= 0 Then
                If UXBStep3TypeIsU32(ps.ast.nodes(n.left).typeName) <> 0 Then u32Involved = 1
            End If
            If n.right >= 0 Then
                If UXBStep3TypeIsU32(ps.ast.nodes(n.right).typeName) <> 0 Then u32Involved = 1
            End If
            ' S-133: a STRING/WSTRING operand also needs the value evaluator. This evaluator's own
            ' "=","<>","<",">","<=",">=" cases below compare the two sides as plain Integer -- for a
            ' string operand that Integer comes from ExecResolveThisMeIdentValue/ExecEvalNode's own
            ' "STRING" case (ValInt of the text), so two DIFFERENT strings that are both non-numeric
            ' (e.g. "a" and "d") both read as 0 and compared EQUAL: `IF s = "d" THEN` (a block IF
            ' condition, or any other caller of this narrow evaluator) took the THEN branch for every
            ' string value. PRINT's own text path (ExecEvalNodeAsText -> ExecEvalExpression) was never
            ' affected, which is why only conditions/loops built on this integer evaluator were wrong.
            Dim stringInvolved As Integer
            stringInvolved = 0
            If n.left >= 0 Then
                If UCase(Trim(ps.ast.nodes(n.left).kind)) = "STRING" Then stringInvolved = 1
                If UXBStep3TypeIsString(ps.ast.nodes(n.left).typeName) <> 0 Then stringInvolved = 1
            End If
            If n.right >= 0 Then
                If UCase(Trim(ps.ast.nodes(n.right).kind)) = "STRING" Then stringInvolved = 1
                If UXBStep3TypeIsString(ps.ast.nodes(n.right).typeName) <> 0 Then stringInvolved = 1
            End If
            ' S-137: a float operand (F32/F64 static type, or a float literal) also needs the value
            ' evaluator: this one computes in the host Integer, so `IF x < 2.65` (x = 2.6) compared the
            ' ROUNDED values (3 < 3) and was false, and every float comparison/arithmetic here lost
            ' its fraction.
            Dim floatInvolved As Integer
            floatInvolved = 0
            If n.left >= 0 Then
                If UXBStep3TypeIsFloat(ps.ast.nodes(n.left).typeName) <> 0 Then floatInvolved = 1
                If UCase(Trim(ps.ast.nodes(n.left).kind)) = "NUMBER" Then
                    If UXBNumberLiteralIsFloat(ps.ast.nodes(n.left).value) <> 0 Then floatInvolved = 1
                End If
            End If
            If n.right >= 0 Then
                If UXBStep3TypeIsFloat(ps.ast.nodes(n.right).typeName) <> 0 Then floatInvolved = 1
                If UCase(Trim(ps.ast.nodes(n.right).kind)) = "NUMBER" Then
                    If UXBNumberLiteralIsFloat(ps.ast.nodes(n.right).value) <> 0 Then floatInvolved = 1
                End If
            End If
            If u32Involved <> 0 Or stringInvolved <> 0 Or floatInvolved <> 0 Or UXBExprIsWide64(ps, n.left) <> 0 Or UXBExprIsWide64(ps, n.right) <> 0 Then
                Dim wideValue As ExecValue
                If ExecEvalExpression(ps, nodeIdx, es, wideValue, errText) = 0 Then Return 0
                Return ExecValueToInteger(wideValue)
            End If
        End If

        Dim lv As Integer
        Dim rv2 As Integer
        lv = ExecEvalNode(ps, es, n.left, errText)
        If errText <> "" Then Return 0

        If n.op = "|>" Then
            Dim pipeInput As ExecValue
            Dim pipeOutput As ExecValue
            ExecValueSetInteger pipeInput, lv
            If ExecEvalPipeInvoke(ps, es, n.right, pipeInput, pipeOutput, errText) = 0 Then Return 0
            Return ExecValueToInteger(pipeOutput)
        End If

        Dim opNorm As String
        opNorm = UCase(Trim(n.op))

        If opNorm = "&&" Or opNorm = "ANDALSO" Then
            If lv = 0 Then Return 0
        ElseIf opNorm = "||" Or opNorm = "ORELSE" Then
            If lv <> 0 Then Return -1
        End If

        rv2 = ExecEvalNode(ps, es, n.right, errText)
        If errText <> "" Then Return 0

        Dim overloadedRight As ExecValue
        Dim overloadedLeft As ExecValue
        Dim overloadedResult As ExecValue
        Dim overloadNodeRv As Integer
        ExecValueSetInteger overloadedLeft, lv
        ExecValueSetInteger overloadedRight, rv2
        overloadNodeRv = ExecTryEvalOverloadedBinary(ps, es, nodeIdx, overloadedLeft, overloadedRight, n.op, overloadedResult, errText)
        If overloadNodeRv = 0 Then Return 0
        If overloadNodeRv > 0 Then Return ExecValueToInteger(overloadedResult)

        Select Case n.op
        Case "+"
            Return lv + rv2
        Case "-"
            Return lv - rv2
        Case "*"
            Return lv * rv2
        Case "**"
            If rv2 < 0 Then
                errText = "exec: negative exponent not supported"
                Return 0
            End If
            Dim p As Integer
            Dim acc As Integer
            acc = 1
            For p = 1 To rv2
                acc *= lv
            Next p
            Return acc
        Case "/", "\"
            If rv2 = 0 Then
                errText = "exec: division by zero"
                Return 0
            End If
            Return lv \ rv2
        Case "%", "MOD"
            If rv2 = 0 Then
                errText = "exec: modulo by zero"
                Return 0
            End If
            Return lv Mod rv2
        Case "&"
            Return lv And rv2
        Case "|"
            Return lv Or rv2
        Case "AND"
            Return lv And rv2
        Case "OR"
            Return lv Or rv2
        Case "&&", "ANDALSO"
            If lv = 0 Then Return 0
            If rv2 <> 0 Then Return -1 Else Return 0
        Case "||", "ORELSE"
            If lv <> 0 Then Return -1
            If rv2 <> 0 Then Return -1 Else Return 0
        Case "XOR"
            Return lv Xor rv2
        Case "^"
            Return lv Xor rv2
        Case "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB"
            ' Reuse the value evaluator without evaluating either operand twice.
            Dim logicLeft As ExecValue, logicRight As ExecValue, logicResult As ExecValue
            ExecValueSetInteger logicLeft, lv
            ExecValueSetInteger logicRight, rv2
            If ExecEvalBinaryValues(logicLeft, logicRight, n.op, logicResult, errText) = 0 Then Return 0
            Return ExecValueToInteger(logicResult)
        Case "BAND", "BITAND"
            Return lv And rv2
        Case "BOR", "BITOR"
            Return lv Or rv2
        Case "BXOR", "BITXOR"
            Return lv Xor rv2
        Case "<<", "SHL"
            Return CInt(CUInt(lv) Shl (rv2 And 31))
        Case ">>", "SHR"
            Return CInt(CUInt(lv) Shr (rv2 And 31))
        Case "ROL"
            Return CInt(ExecRol32(CUInt(lv), rv2))
        Case "ROR"
            Return CInt(ExecRor32(CUInt(lv), rv2))
        Case "="
            If lv = rv2 Then Return -1 Else Return 0
        Case "=="
            If lv = rv2 Then Return -1 Else Return 0
        Case "<>"
            If lv <> rv2 Then Return -1 Else Return 0
        Case "!="
            If lv <> rv2 Then Return -1 Else Return 0
        Case "<"
            If lv < rv2 Then Return -1 Else Return 0
        Case ">"
            If lv > rv2 Then Return -1 Else Return 0
        Case "<="
            If lv <= rv2 Then Return -1 Else Return 0
        Case ">="
            If lv >= rv2 Then Return -1 Else Return 0
        Case Else
            errText = "exec: unsupported binary op " & n.op
            Return 0
        End Select

    Case "TERNARY_EXPR"
        Dim condInt As Integer
        condInt = ExecEvalNode(ps, es, n.left, errText)
        If errText <> "" Then Return 0

        Dim thenExpr As Integer
        thenExpr = ExecChildAt(ps, nodeIdx, 0)
        If thenExpr = -1 Then
            errText = "exec: ternary true branch missing"
            Return 0
        End If

        If condInt <> 0 Then
            Return ExecEvalNode(ps, es, thenExpr, errText)
        End If
        Return ExecEvalNode(ps, es, n.right, errText)

    Case "CALL_EXPR"
        Dim arrVarIdx As Integer
        Dim arrElemIdx As Integer
        Dim arrValue As ExecValue
        Dim arrAccessTry As Integer
        arrAccessTry = ExecTryResolveArrayAccess(ps, es, nodeIdx, arrVarIdx, arrElemIdx, errText)
        If arrAccessTry <> 0 Then
            If ExecGetArrayElement(es, arrVarIdx, arrElemIdx, arrValue) = 0 Then
                If errText = "" Then errText = "exec: array element read failed"
                Return 0
            End If
            Return ExecValueToInteger(arrValue)
        End If
        If errText <> "" Then Return 0

        Dim callExprValue As Integer
        If ExecEvalCall(ps, es, ExecFix8BNodeName(n), nodeIdx, 1, callExprValue, errText) = 0 Then Return 0
        Return callExprValue

    Case "NEW_EXPR"
        Return ExecAllocClassInstance(ps, es, n.value, nodeIdx, errText)

    Case "SPAWN_EXPR"
        Dim spawnValue As ExecValue
        If ExecRunSpawnExpr(ps, es, nodeIdx, spawnValue, errText) = 0 Then Return 0
        Return spawnValue.intValue

    Case "FIELD_EXPR"
        Dim fieldValue As ExecValue
        If ExecReadFieldValue(ps, es, nodeIdx, fieldValue, errText) = 0 Then Return 0
        Return ExecValueToInteger(fieldValue)

    ' 2026-05-26 19:10 - Copilot: Step2 AST contract kirik dugumleri icin runtime ifade case'leri eklendi.
    Case "CAST_EXPR"
        Dim castExpr As Integer
        castExpr = n.left
        If castExpr = -1 Then castExpr = n.firstChild
        If castExpr = -1 Then castExpr = n.right
        If castExpr = -1 Then
            errText = "exec: CAST expression missing"
            Return 0
        End If
        Return ExecEvalNode(ps, es, castExpr, errText)

    Case "SIZEOF_EXPR"
        Dim szType As String
        szType = UCase(Trim(n.value))
        If szType = "" Then
            Dim szNode As Integer
            szNode = n.left
            If szNode = -1 Then szNode = n.firstChild
            If szNode <> -1 Then
                Dim szKind As String
                szKind = UCase(Trim(ps.ast.nodes(szNode).kind))
                If szKind = "TYPE_REF" Or szKind = "IDENT" Or szKind = "KEYWORD_REF" Then
                    szType = UCase(Trim(ps.ast.nodes(szNode).value))
                End If
            End If
        End If
        If szType = "" Then
            errText = "exec: SIZEOF type missing"
            Return 0
        End If
        Dim typeSize As Integer
        typeSize = ExecTypeElemSizeBytes(szType)
        If typeSize <= 0 Then
            errText = "exec: SIZEOF unsupported type " & szType
            Return 0
        End If
        Return typeSize

    Case "MEMBER_EXPR"
        Dim memberBase As Integer
        memberBase = n.left
        If memberBase = -1 Then
            errText = "exec: MEMBER expression missing base"
            Return 0
        End If
        Return ExecEvalNode(ps, es, memberBase, errText)

    Case "PAREN_EXPR", "GROUP_EXPR", "EXPR_GROUP"
        Dim innerExpr As Integer
        innerExpr = n.left
        If innerExpr = -1 Then innerExpr = n.firstChild
        If innerExpr = -1 Then innerExpr = n.right
        If innerExpr = -1 Then
            errText = "exec: grouped expression missing inner node"
            Return 0
        End If
        Return ExecEvalNode(ps, es, innerExpr, errText)

    Case Else
        errText = "exec: unsupported node kind " & n.kind
        Return 0
    End Select
End Function

Private Function ExecRunDeclDirectiveStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef st As ASTNode, ByRef errText As String) As Integer
    Select Case UCase(st.kind)
    Case "TYPE_STMT", "CLASS_STMT", "ENUM_STMT", "INTERFACE_STMT", "DECLARE_SUB_STMT", "DECLARE_FUNCTION_STMT", "SUB_STMT", "FUNCTION_STMT", _
         "CLASS_FIELD", "CLASS_METHOD_DECL", "CLASS_OPERATOR_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", _
         "CLASS_PROPERTY_DECL", "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "CLASS_MIXIN_REF", "CLASS_DECORATOR_REF", _
         "CLASS_FRIEND_STMT", "INTERFACE_METHOD_DECL"
        Return 1

    Case "DIM_STMT"
        If ExecEvalDIM(ps, stmtIdx, es, errText) = 0 Then Return 0
        Return 1

    Case "CONST_STMT"
        If ExecEvalCONST(ps, stmtIdx, es, errText) = 0 Then Return 0
        Return 1

    Case "REDIM_STMT"
        If ExecEvalREDIM(ps, stmtIdx, es, errText) = 0 Then Return 0
        Return 1

    Case "DEF_FN_STMT"
        Return ExecRegisterDefFnStatement(ps, stmtIdx, errText)

    Case "DEFTYPE_STMT", "DEFINT_STMT", "DEFLNG_STMT", "DEFSNG_STMT", "DEFDBL_STMT", "DEFEXT_STMT", "DEFSTR_STMT", "DEFBYT_STMT"
        If ExecEvalDEF(ps, stmtIdx, es, errText) = 0 Then Return 0
        Return 1

    Case "SETSTRINGSIZE_STMT"
        If ExecEvalSETSTRINGSIZE(ps, stmtIdx, es, errText) = 0 Then Return 0
        Return 1

    Case "INCLUDE_STMT", "INLINE_STMT", "IMPORT_STMT"
        Return 1
    End Select

    Return -2
End Function

Private Function ExecRunTailStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef st As ASTNode, ByRef errText As String) As Integer
    Select Case UCase(st.kind)
    Case "EXIT_STMT"
        Dim exitMode As String
        exitMode = UCase(st.op)
        If exitMode = "" Then exitMode = "ANY"

        If exitMode <> "ANY" And exitMode <> "FOR" And exitMode <> "DO" And exitMode <> "IF" Then
            errText = "exec: unsupported EXIT mode " & st.op
            Return 0
        End If

        es.runtime.exitRequest = exitMode
        Return 1

    Case "GOTO_STMT"
        If Trim(st.value) = "" Then
            errText = "exec: GOTO target missing"
            Return 0
        End If

        es.runtime.exitRequest = "GOTO:" & UCase(st.value)
        Return 1

    Case "GOSUB_STMT"
        If Trim(st.value) = "" Then
            errText = "exec: GOSUB target missing"
            Return 0
        End If

        es.runtime.exitRequest = "GOSUB:" & UCase(st.value)
        Return 1

    Case "END_STMT"
        es.runtime.exitRequest = "END"
        Return 1

    Case "RETURN_STMT"
        Dim returnCount As Integer
        returnCount = ExecChildCount(ps, stmtIdx)
        If returnCount > 1 Then
            errText = "exec: RETURN argument count invalid"
            Return 0
        End If

        If es.runtime.callContextDepth > 0 Then
            If returnCount = 1 Then
                Dim callReturnExpr As Integer
                callReturnExpr = ExecChildAt(ps, stmtIdx, 0)
                If callReturnExpr = -1 Then
                    errText = "exec: RETURN value missing"
                    Return 0
                End If

                Dim typedCallReturn As ExecValue
                If ExecEvalExpression(ps, callReturnExpr, es, typedCallReturn, errText) = 0 Then Return 0
                es.runtime.callReturnValueEx = typedCallReturn
                es.runtime.callReturnValue = ExecValueToInteger(typedCallReturn)
                es.runtime.callReturnHasValue = 1
            Else
                es.runtime.callReturnValue = 0
                es.runtime.callReturnValueEx.valueType = "INTEGER"
                es.runtime.callReturnValueEx.intValue = 0
                es.runtime.callReturnValueEx.floatValue = 0.0
                es.runtime.callReturnValueEx.stringValue = ""
                es.runtime.callReturnHasValue = 0
            End If

            es.runtime.exitRequest = "RETURN_CALL"
            Return 1
        End If

        If returnCount = 1 Then
            Dim returnExpr As Integer
            returnExpr = ExecChildAt(ps, stmtIdx, 0)
            If returnExpr = -1 Then
                errText = "exec: RETURN value missing"
                Return 0
            End If

            Dim returnValue As Integer
            returnValue = ExecEvalNode(ps, es, returnExpr, errText)
            If errText <> "" Then Return 0
        End If

        es.runtime.exitRequest = "RETURN"
        Return 1

    Case "LABEL_STMT"
        Return 1

    Case "EXPR_STMT"
        Dim exprStmtNode As Integer
        exprStmtNode = st.left
        If exprStmtNode = -1 Then exprStmtNode = ExecChildAt(ps, stmtIdx, 0)

        If exprStmtNode <> -1 Then
            ' ABI10_SUB_EXPR_STMT_FIX_20260706:
            ' Bare SUB calls can arrive from parser/semantic as EXPR_STMT -> CALL_EXPR
            ' with typeName=SYM_SUB, not as CALL_STMT.  A statement-level call must
            ' execute with expectValue=0; otherwise ExecEvalNode treats the CALL_EXPR
            ' as a value expression and rejects SUB routines with:
            '   exec: call in expression requires FUNCTION <SUBNAME>
            Dim exprStmtKind As String
            exprStmtKind = UCase(Trim(ps.ast.nodes(exprStmtNode).kind))
            If exprStmtKind = "CALL_EXPR" Then
                Dim ignoredExprStmtCallResult As Integer
                If ExecEvalCall(ps, es, ExecFix8BNodeName(ps.ast.nodes(exprStmtNode)), exprStmtNode, 0, ignoredExprStmtCallResult, errText) = 0 Then Return 0
                Return 1
            End If

            Dim v As Integer
            v = ExecEvalNode(ps, es, exprStmtNode, errText)
            If errText <> "" Then Return 0
        End If
        Return 1

    Case "CALL_STMT"
        Dim ignoredCallResult As Integer
        If ExecEvalCall(ps, es, st.value, stmtIdx, 0, ignoredCallResult, errText) = 0 Then Return 0
        Return 1
    End Select

    Return -2
End Function

#include once "exec/exec_stmt_flow.fbs"
#include once "exec/exec_stmt_io_file.fbs"
#include once "exec/exec_stmt_memory_core.fbs"

Private Function ExecRunBlockChildren(ByRef ps As ParseState, ByRef es As ExecState, ByVal parentIdx As Integer, ByRef errText As String) As Integer
    Dim ch As Integer
    ch = ps.ast.nodes(parentIdx).firstChild

    Do While ch <> -1
        If ExecRunStmt(ps, es, ch, errText) = 0 Then Return 0
        If es.runtime.exitRequest <> "" Then Exit Do
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Function ExecRunStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    If UXBStepBudgetTick(errText) = 0 Then Return 0
    If ExecLockCheckStmtAccess(ps, es, stmtIdx, errText) = 0 Then Return 0
    Dim st As ASTNode
    st = ps.ast.nodes(stmtIdx)

    Select Case UCase(st.kind)
    Case "NAMESPACE_STMT", "MODULE_STMT"
        ' Namespace/module bodies declare scoped symbols. They are registered by
        ' the declaration passes and must not execute as part of the main program.
        ' S-162: ad alani duzeyindeki DIM/REDIM ise depo olusturur ("NS.NV", ayristirma sonrasi
        ' normallestirilmis ad) -- MIR/native ile ayni sekilde calistirilir.
        Dim nsChild As Integer = ps.ast.nodes(stmtIdx).firstChild
        Do While nsChild <> -1
            Dim nsChildKind As String = UCase(Trim(ps.ast.nodes(nsChild).kind))
            If nsChildKind = "DIM_STMT" Or nsChildKind = "REDIM_STMT" Then
                If ExecRunStmt(ps, es, nsChild, errText) = 0 Then Return 0
            End If
            nsChild = ps.ast.nodes(nsChild).nextSibling
        Loop
        Return 1
    Case "MAIN_STMT"
        Return ExecRunBlockChildren(ps, es, stmtIdx, errText)
    Case "CALL_DLL_STMT", "CALL_API_STMT"
        Dim ffiStmtValue As Integer
        Dim ffiStmtName As String
        ffiStmtName = UCase(Trim(st.op))
        If ffiStmtName = "" Then ffiStmtName = UCase(Trim(st.symbolName))
        If ffiStmtName = "" Then ffiStmtName = UCase(Trim(st.value))
        If ffiStmtName <> "DLL" And ffiStmtName <> "API" Then
            errText = "exec: invalid interop statement route " & ffiStmtName
            Return 0
        End If
        Return ExecEvalCall(ps, es, ffiStmtName, stmtIdx, 0, ffiStmtValue, errText)
    Case "USING_STMT", "ALIAS_STMT"
        ' Scope metadata nodes are compile-time constructs; runtime treats them as no-op.
        Return 1
    ' 2026-05-26 19:10 - Copilot: Step2 metadata/govde dugumleri runtime'da no-op olarak acikca desteklendi.
    Case "CLASS_ACCESS", "CLASS_FIELD_FLAG", "CLASS_PROPERTY_FLAG", "CLASS_METHOD_FLAG", "RETURN_TYPE", "TYPE_REF", "PARAM_DECL", "CLASS_IMPLEMENTS_REF", "EACH_ITEMS", "EACH_BODY", "ENUM_ITEM", "ENUM_BASE_TYPE"
        Return 1
    End Select

    Dim declDirectiveResult As Integer
    declDirectiveResult = ExecRunDeclDirectiveStmt(ps, es, stmtIdx, st, errText)
    If declDirectiveResult <> -2 Then Return declDirectiveResult

    Dim tailResult As Integer
    tailResult = ExecRunTailStmt(ps, es, stmtIdx, st, errText)
    If tailResult <> -2 Then Return tailResult

    Dim flowResult As Integer
    flowResult = ExecRunFlowStmt(ps, es, stmtIdx, st, errText)
    If flowResult <> -2 Then Return flowResult

    Dim ioResult As Integer
    ioResult = ExecRunIoFileStmt(ps, es, stmtIdx, st, errText)
    If ioResult <> -2 Then Return ioResult

    Dim memoryCoreResult As Integer
    memoryCoreResult = ExecRunMemoryCoreStmt(ps, es, stmtIdx, st, errText)
    If memoryCoreResult <> -2 Then Return memoryCoreResult

    Dim slotResult As Integer
    slotResult = ExecSlotRunStmt(ps, es, stmtIdx, st, errText)
    If slotResult <> -2 Then Return slotResult

    errText = "exec: unsupported statement kind " & st.kind
    Return 0
End Function

Private Function ExecRunProgramScopeDtors(ByRef ps As ParseState, ByRef es As ExecState, ByRef errText As String) As Integer
    ' Yama 0: program sonu temizligi runtimeClassType=OBJECT akisini da dikkate alir,
    ' addr=0 olan DELETE edilmis degiskenleri atlar ve destructor zincirini kullanir.
    Dim i As Integer
    For i = es.count - 1 To 0 Step -1
        If ExecRunClassVarDtorAtIndex(ps, es, i, errText) = 0 Then
            If errText = "" Then errText = "exec: destructor invoke failed at var index " & LTrim(Str(i))
            Return 0
        End If
    Next i

    Return 1
End Function

' S-073: shared default VIRTUAL setup (--virtual CLI flag, else the 1 MiB default).
' Was inline in ExecRunMemoryProgram, so only the AST interpreter ever ran it;
' the canonical-MIR interpreter left the sandbox uninitialized and every
' PEEK/POKE without an explicit VIRTUAL statement failed. Returns 0 with a
' normalized errText on failure.
Function ExecInitVirtualMemoryDefaults(ByRef errText As String) As Integer
    Dim cliVirtualArg As String
    cliVirtualArg = gUxbCliVirtualArg
    If Trim(cliVirtualArg) <> "" Then
        Dim cliRamPart As String
        Dim cliDiskPart As String
        Dim cliCommaPos As Integer
        cliCommaPos = InStr(cliVirtualArg, ",")
        If cliCommaPos > 0 Then
            cliRamPart = Trim(Left(cliVirtualArg, cliCommaPos - 1))
            cliDiskPart = Trim(Mid(cliVirtualArg, cliCommaPos + 1))
        Else
            cliRamPart = Trim(cliVirtualArg)
            cliDiskPart = ""
        End If

        Dim cliRamBytes As ULongInt
        Dim cliDiskBytes As ULongInt
        Dim cliParseErr As String
        cliDiskBytes = 0
        If ExecParseByteSizeLiteral(cliRamPart, cliRamBytes, cliParseErr) = 0 Then
            errText = "exec: --virtual " & cliParseErr
            ExecNormalizeError errText
            Return 0
        End If
        If cliDiskPart <> "" Then
            If ExecParseByteSizeLiteral(cliDiskPart, cliDiskBytes, cliParseErr) = 0 Then
                errText = "exec: --virtual " & cliParseErr
                ExecNormalizeError errText
                Return 0
            End If
        End If
        If cliRamBytes < 65536 Or cliRamBytes > 2147483647ULL Then
            errText = "exec: --virtual ram boyutu 64K ile 2G arasinda olmali"
            ExecNormalizeError errText
            Return 0
        End If

        Dim cliVmemErr As String
        If VMemInit(CUInt(cliRamBytes), cliDiskBytes, cliVmemErr) = 0 Then
            ' (IIf with a String variable and a literal does not compile in FB 1.10: error 24)
            If cliVmemErr <> "" Then errText = "exec: --virtual " & cliVmemErr Else errText = "exec: --virtual bellek ayirma basarisiz"
            ExecNormalizeError errText
            Return 0
        End If
    Else
        VMemInit
    End If
    Return 1
End Function

Function ExecRunMemoryProgram(ByRef ps As ParseState, ByRef errText As String) As Integer
    Static es As ExecState
    gUxbExecSteps = 0
    ExecBigRuntimeReleaseAll
    ExecStateInit es
    ExecDefFnReset
    gExecAliasResolveDepth = 0
    gActiveRuntimeCtx = @es.runtime
    es.runtime.ffiPolicyEnforce = gFfiDefaultPolicyEnforce
    es.runtime.ffiPolicyPath = gFfiDefaultPolicyPath
    es.runtime.ffiResolverPath = gFfiDefaultResolverPath
    es.runtime.ffiResolverEnforce = gFfiDefaultResolverEnforce
    ExecCollectionsReset
    ExecFieldStringsReset
    ExecSyncReset
    UXBRngResetAll
    ExecSlotsReset es
    ExecDebugConsoleReset
    ExecContractInit es
    ExecStaticFieldReset
    es.runtime.exitRequest = ""
    es.runtime.callContextDepth = 0
    es.runtime.callReturnValue = 0
    es.runtime.callReturnHasValue = 0
    es.runtime.currentRoutineName = ""
    es.runtime.currentRoutineNodeIdx = -1
    es.runtime.execException.active = 0
    es.runtime.execException.kindText = ""
    es.runtime.execException.code = 0
    es.runtime.execException.messageText = ""
    es.runtime.execException.lineNo = 0
    es.runtime.execException.colNo = 0
    es.runtime.execException.routineName = ""
    ExecValueInit es.runtime.execException.value

    If ps.rootNode = -1 Then
        errText = "exec: no AST root"
        ExecNormalizeError errText
        Return 0
    End If

    If ExecInitVirtualMemoryDefaults(errText) = 0 Then Return 0

    Dim labelNames(Any) As String
    Dim labelNodes(Any) As Integer
    Dim labelCount As Integer
    If ExecBuildTopLevelLabelMap(ps, ps.rootNode, labelNames(), labelNodes(), labelCount, errText) = 0 Then
        ExecNormalizeError errText
        UxbFileCloseAll es.fileIo
        Return 0
    End If

    If ExecBuildTopLevelRoutineMap(ps, es, ps.rootNode, errText) = 0 Then
        ExecNormalizeError errText
        UxbFileCloseAll es.fileIo
        Return 0
    End If

    ' Ensure runtime vtable map is built so interpreter can resolve handles
    If ExecBuildVTableMap(ps, es, errText) = 0 Then
        ExecNormalizeError errText
        UxbFileCloseAll es.fileIo
        Return 0
    End If
    Dim callStack(Any) As Integer
    Dim callDepth As Integer

    Dim runGuard As Integer
    runGuard = 0

    Dim st As Integer
    st = ps.ast.nodes(ps.rootNode).firstChild

    Do While st <> -1
        runGuard += 1
        ' S-110: was a fixed 1,000,000 top-level steps (a GOTO loop at top level hit it)
        If UXBStepBudgetTick(errText) = 0 Then
            ExecNormalizeError errText
            UxbFileCloseAll es.fileIo
            Return 0
        End If

        If ExecRunStmt(ps, es, st, errText) = 0 Then
            ' S-156: ifade icindeki bir cagri (PRINT F() gibi) END calistirdi; cagri, ifadenin
            ' geri kalanini degerlendirmemek icin basarisiz yoldan dondu. Bu bir hata degil, program biter.
            If UCase(es.runtime.exitRequest) = "END" Then
                es.runtime.exitRequest = ""
                errText = ""
                Exit Do
            End If
            ExecNormalizeError errText
            UxbFileCloseAll es.fileIo
            Return 0
        End If

        If es.runtime.exitRequest <> "" Then
            Dim exitReq As String
            exitReq = UCase(es.runtime.exitRequest)

            If exitReq = "END" Then
                es.runtime.exitRequest = ""
                Exit Do
            End If

            If exitReq = "RETURN" Then
                If callDepth <= 0 Then
                    errText = "exec: RETURN used without GOSUB (" & LTrim(Str(UXB_CTRL_ERR_RETURN_WITHOUT_GOSUB)) & ")"
                    ExecNormalizeError errText
                    UxbFileCloseAll es.fileIo
                    Return 0
                End If

                callDepth -= 1
                st = callStack(callDepth)
                es.runtime.exitRequest = ""
                Continue Do
            ElseIf Left(exitReq, 5) = "GOTO:" Then
                Dim gotoTarget As String
                gotoTarget = Trim(Mid(es.runtime.exitRequest, 6))

                Dim gotoIdx As Integer
                gotoIdx = ExecLabelIndexOf(labelNames(), labelCount, gotoTarget)
                If gotoIdx = -1 Then
                    errText = "exec: GOTO target not found " & gotoTarget
                    ExecNormalizeError errText
                    UxbFileCloseAll es.fileIo
                    Return 0
                End If

                st = labelNodes(gotoIdx)
                es.runtime.exitRequest = ""
                Continue Do
            ElseIf Left(exitReq, 6) = "GOSUB:" Then
                Dim gosubTarget As String
                gosubTarget = Trim(Mid(es.runtime.exitRequest, 7))

                Dim gosubIdx As Integer
                gosubIdx = ExecLabelIndexOf(labelNames(), labelCount, gosubTarget)
                If gosubIdx = -1 Then
                    errText = "exec: GOSUB target not found " & gosubTarget
                    ExecNormalizeError errText
                    UxbFileCloseAll es.fileIo
                    Return 0
                End If

                If callDepth = 0 Then
                    ReDim callStack(0)
                Else
                    ReDim Preserve callStack(callDepth)
                End If

                callStack(callDepth) = ps.ast.nodes(st).nextSibling
                callDepth += 1

                st = labelNodes(gosubIdx)
                es.runtime.exitRequest = ""
                Continue Do
            ElseIf exitReq = "IF" Then
                errText = "exec: EXIT IF used outside IF block"
                ExecNormalizeError errText
                UxbFileCloseAll es.fileIo
                Return 0
            Else
                errText = "exec: EXIT used outside matching loop"
                ExecNormalizeError errText
                UxbFileCloseAll es.fileIo
                Return 0
            End If
        End If

        st = ps.ast.nodes(st).nextSibling
    Loop

    ' S-146 Model D / K5: ana programin kalan acik kilitleri birakilir (LOCK icinde END), acik
    ' LOCK suresince ertelenmis gorevler program bitmeden calisir.
    If ExecTaskFinishProgram(ps, es, errText) = 0 Then
        ExecNormalizeError errText
        UxbFileCloseAll es.fileIo
        ExecBigRuntimeReleaseAll
        Return 0
    End If

    If ExecRunProgramScopeDtors(ps, es, errText) = 0 Then
        ExecNormalizeError errText
        UxbFileCloseAll es.fileIo
        ExecBigRuntimeReleaseAll
        Return 0
    End If

    UxbFileCloseAll es.fileIo
    ExecBigRuntimeReleaseAll
    Return 1
End Function
