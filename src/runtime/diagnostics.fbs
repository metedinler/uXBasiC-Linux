#include once "../common/error_system_adim45.fbs"
#include once "../common/ident_names.fbs"

Type DiagState
    initialized As Integer
    logPath As String
    debugLogPath As String
    quietMode As Integer
    debugEnabled As Integer
    traceEnabled As Integer
    debugTokenDump As Integer
    sourceBaseName As String
End Type

Dim Shared gDiag As DiagState

Private Sub AppendLineToFile(ByRef pPath As String, ByRef pLine As String)
    If Trim(pPath) = "" Then Exit Sub
    Dim f As Integer
    f = FreeFile
    On Error GoTo _apx_err
    Open pPath For Append As #f
    Print #f, pLine
    Close #f
    On Error GoTo 0
    Exit Sub
_apx_err:
    Dim fileError As Integer = Err
    On Error GoTo 0
    UXBErrorLogWriteFailure45 pPath, fileError
End Sub

Private Function DirNameFromPath(ByRef p As String) As String
    Dim s As String
    s = p
    Dim i As Integer
    Dim tmp As String
    tmp = ""
    Dim ch As String
    For i = 1 To Len(s)
        ch = Mid$(s, i, 1)
        If ch = "/" Then
            tmp = tmp & "\"
        Else
            tmp = tmp & ch
        End If
    Next i
    s = tmp
    For i = Len(s) To 1 Step -1
        If Mid(s, i, 1) = "\" Then
            DirNameFromPath = Left(s, i - 1)
            Exit Function
        End If
    Next i
    DirNameFromPath = "."
End Function

Private Sub EnsureLogDir(ByRef pPath As String)
    If Trim(pPath) = "" Then Exit Sub
    Dim d As String
    d = DirNameFromPath(pPath)
    If d = "." Then Exit Sub
    If Dir(d) <> "" Then Exit Sub

    Dim norm As String
    norm = ""
    Dim j As Integer
    For j = 1 To Len(d)
        Dim chj As String
        chj = Mid(d, j, 1)
        If chj = "/" Then
            norm &= "\"
        Else
            norm &= chj
        End If
    Next j

    Dim i As Integer
    Dim cur As String
    cur = ""
    For i = 1 To Len(norm)
        Dim ch As String
        ch = Mid(norm, i, 1)
        cur &= ch
        If ch = "\" Then
            If Len(cur) > 3 Then
                Dim partial As String
                partial = Left(cur, Len(cur) - 1)
                If partial <> "" And Dir(partial) = "" Then MkDir partial
            End If
        End If
    Next i
    If Dir(norm) = "" Then MkDir norm
End Sub

Private Sub UxbInit()
    If gDiag.initialized <> 0 Then Exit Sub
    ' CLI calls this before resolving its output contract. Defer file I/O until
    ' UxbConfigure supplies the actual path; console diagnostics remain usable.
    If Trim(gDiag.logPath) = "" Then Exit Sub
    On Error GoTo _uerr
    EnsureLogDir(gDiag.logPath)
    EnsureLogDir(gDiag.debugLogPath)

    Dim f As Integer
    f = FreeFile
    Open gDiag.logPath For Append As #f
    Print #f, "---- oturum basladi " & Date$ & " " & Time$ & " ----"
    Close #f
    On Error GoTo 0
    gDiag.initialized = 1
    Exit Sub
_uerr:
    Dim fileError As Integer = Err
    On Error GoTo 0
    UXBErrorLogWriteFailure45 gDiag.logPath, fileError
End Sub

Private Sub UxbConfigure(ByRef logPath As String, ByRef debugLogPath As String, ByVal quiet As Integer, ByVal debugOn As Integer, ByVal traceOn As Integer, ByVal debugToken As Integer, ByRef sourceBaseName As String)
    If (Trim(logPath) <> "" And logPath <> gDiag.logPath) Or (Trim(debugLogPath) <> "" And debugLogPath <> gDiag.debugLogPath) Then gDiag.initialized = 0
    If Trim(logPath) <> "" Then gDiag.logPath = logPath
    If Trim(debugLogPath) <> "" Then gDiag.debugLogPath = debugLogPath
    gDiag.quietMode = IIf(quiet <> 0, 1, 0)
    gDiag.debugEnabled = IIf(debugOn <> 0, 1, 0)
    gDiag.traceEnabled = IIf(traceOn <> 0, 1, 0)
    gDiag.debugTokenDump = IIf(debugToken <> 0, 1, 0)
    gDiag.sourceBaseName = Trim(sourceBaseName)
    UxbInit
End Sub

Private Sub UxbInfo(ByRef msgTextRaw As String)
    Dim msgText As String
    msgText = UxbIdentDisplayText(msgTextRaw) ' S-579: names with Turkish letters are shown as written
    Dim outLine As String
    outLine = "INFO: " & msgText
    AppendLineToFile gDiag.logPath, outLine
    UXBErrorEmitInferred45 "INFO", msgText, "runtime/diagnostics.fbs", "api=UxbInfo"
    If gDiag.quietMode = 0 Then Print outLine
End Sub

Private Sub UxbWarn(ByRef msgTextRaw As String)
    Dim msgText As String
    msgText = UxbIdentDisplayText(msgTextRaw)
    Dim outLine As String
    outLine = "WARN: " & msgText
    AppendLineToFile gDiag.logPath, outLine
    UXBErrorEmitInferred45 "WARN", msgText, "runtime/diagnostics.fbs", "api=UxbWarn"
    If gUXBError45.terminalFormat = "json" Then
        Print UXBErrorLegacyJson45("warning", msgText)
    ElseIf gDiag.quietMode = 0 Then
        Print outLine
    End If
End Sub

Private Sub UxbError(ByRef msgTextRaw As String, ByVal writeArtifacts As Integer = 1)
    Dim msgText As String
    msgText = UxbIdentDisplayText(msgTextRaw)
    Dim outLine As String
    outLine = "ERROR: " & msgText
    If writeArtifacts <> 0 Then
        AppendLineToFile gDiag.logPath, outLine
        UXBErrorEmitLegacy45 msgText, "runtime/diagnostics.fbs", "api=UxbError"
    End If
    If gUXBError45.terminalFormat = "json" Then
        Print UXBErrorLegacyJson45("error", msgText)
    Else
        Print outLine
    End If
End Sub

Private Sub UxbDebug(ByRef msgText As String)
    If gDiag.debugEnabled = 0 Then Exit Sub
    Dim outLine As String
    outLine = "DEBUG: " & msgText
    AppendLineToFile gDiag.debugLogPath, outLine
    UXBErrorEmitInferred45 "DEBUG", msgText, "runtime/diagnostics.fbs", "api=UxbDebug"
End Sub

Private Sub UxbTrace(ByRef msgText As String)
    If gDiag.traceEnabled = 0 Then Exit Sub
    Dim outLine As String
    outLine = "TRACE: " & msgText
    AppendLineToFile gDiag.debugLogPath, outLine
    UXBErrorEmitInferred45 "TRACE", msgText, "runtime/diagnostics.fbs", "api=UxbTrace"
End Sub

Private Sub UxbUserOut(ByRef msgText As String)
    Print msgText
End Sub

' Backwards-compatible wrappers
Private Sub DiagInit()
    UxbInit
End Sub

Private Sub DiagBilgi(ByRef msgText As String)
    UxbInfo msgText
End Sub

Private Sub DiagHata(ByRef msgText As String)
    UxbError msgText
End Sub

Private Sub DiagUyari(ByRef msgText As String)
    UxbWarn msgText
End Sub

' Legacy compatibility wrapper used by older tests.
Private Sub DiagInitPath(ByRef logPath As String)
    Dim dbgPath As String
    Dim sourceName As String
    dbgPath = ""
    sourceName = ""
    UxbConfigure logPath, dbgPath, gDiag.quietMode, gDiag.debugEnabled, gDiag.traceEnabled, gDiag.debugTokenDump, sourceName
End Sub
