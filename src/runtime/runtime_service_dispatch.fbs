#include once "../common/uxb_rng.fbs"
#ifndef UXB_RUNTIME_SERVICE_DISPATCH_FBS
#define UXB_RUNTIME_SERVICE_DISPATCH_FBS

#include once "runtime_context.fbs"
#include once "runtime_service_registry.fbs"
#include once "console/runtime_console.fbs"
#include once "string/runtime_string.fbs"
#include once "memory/runtime_memory.fbs"
#include once "file/runtime_file.fbs"
#include once "ffi/runtime_ffi.fbs"
#include once "library/runtime_library.fbs"
#include once "browser/runtime_browser_hook.fbs"

Private Function UXBRuntimeMathDispatch(ByRef rt As UXBRuntimeContext, ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As UXBInterpValue
    Dim a As Double = 0
    If args.count > 0 Then a = args.values(0).floatValue
    If args.count > 0 And args.values(0).kind <> UXB_VAL_F32 And args.values(0).kind <> UXB_VAL_F64 Then a = CDbl(args.values(0).intValue)
    Select Case UCase(Trim(serviceId))
    Case RT_MATH_ABS
        If a < 0 Then a = -a
        Return UXBInterpValueFloat(a)
    Case RT_MATH_SQRT
        If a < 0 Then Return UXBRuntimeSetError(rt, UXB_RT_ERR_BAD_ARGUMENT, "sqrt argument must be non-negative")
        Return UXBInterpValueFloat(Sqr(a))
    Case RT_MATH_SIN: Return UXBInterpValueFloat(Sin(a))
    Case RT_MATH_COS: Return UXBInterpValueFloat(Cos(a))
    Case RT_MATH_TAN: Return UXBInterpValueFloat(Tan(a))
    Case RT_MATH_ATN: Return UXBInterpValueFloat(Atn(a))
    Case RT_MATH_SGN: Return UXBInterpValueInt(Sgn(a))
    Case RT_MATH_FIX: Return UXBInterpValueFloat(Fix(a))
    Case RT_MATH_INT: Return UXBInterpValueFloat(Int(a))
    Case RT_MATH_LOG
        If a <= 0 Then Return UXBRuntimeSetError(rt, UXB_RT_ERR_BAD_ARGUMENT, "log argument must be positive")
        Return UXBInterpValueFloat(Log(a))
    Case RT_MATH_EXP: Return UXBInterpValueFloat(Exp(a))
    Case RT_RANDOMIZE
        UXBRngRandomizeTime 0   ' S-163: ortak uretec (src/common/uxb_rng.fbs)
        Return UXBInterpValueVoid()
    Case RT_RND
        Return UXBInterpValueFloat(UXBRngRnd(0, 0, 0))
    Case RT_TIMER
        Return UXBInterpValueFloat(Timer)
    End Select
    Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "math service not found: " & serviceId)
End Function

Function UXBRuntimeDispatch(ByRef rt As UXBRuntimeContext, ByVal serviceId As String, ByRef args As UXBRuntimeArgList) As UXBInterpValue
    Dim s As String = UCase(Trim(serviceId))
    If UXBRuntimeServiceKnown(s) = 0 Then Return UXBRuntimeSetError(rt, UXB_RT_ERR_SERVICE_NOT_FOUND, "runtime service not registered: " & s)
    rt.serviceCallCount += 1
    Select Case UXBRuntimeServiceFamily(s)
    Case "CONSOLE": Return UXBRuntimeConsoleDispatch(rt, s, args)
    Case "STRING": Return UXBRuntimeStringDispatch(rt, s, args)
    Case "MATH": Return UXBRuntimeMathDispatch(rt, s, args)
    Case "MEMORY": Return UXBRuntimeMemoryDispatch(rt, s, args)
    Case "FILE": Return UXBRuntimeFileDispatch(rt, s, args)
    Case "FFI": Return UXBRuntimeFfiDispatch(rt, s, args)
    Case "LIBRARY", "EXTFP": Return UXBRuntimeLibraryDispatch(rt, s, args)
    Case "BROWSER", "WASM_BRIDGE", "HOST": Return UXBRuntimeBrowserDispatch(rt, s, args)
    End Select
    Return UXBRuntimeSetError(rt, UXB_RT_ERR_HANDLER_NOT_AVAILABLE, "runtime handler not available: " & s)
End Function

#endif
