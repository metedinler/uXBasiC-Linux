#include once "../../common/uxb_stackdepth.fbs"

' S-543: AST yorumlayicisinin kullanici rutin cagri derinligi ust siniri. Eskiden sabit 63'tu ve 1 MB ana yigin
' ~200 derinlikte iletisiz erisim ihlaliyle dusuruyordu. Gercek sinir UXBExecCallDepthLimit(): yigin boyutundan hesaplanir
' (resmi derleme -t 65536 ile 64 MB yigin kullanir, bu ust siniri verir); her cagri tum degisken tablosunu anlik
' kopyaladigi icin ust sinir bellek bakimindan da sinirlidir. Asilinca "exec: call stack limit exceeded".
Const UXB_EXEC_MAX_CALL_DEPTH As Integer = 1000
Const UXB_EXEC_BYTES_PER_CALL_LEVEL As Integer = 14336   ' olculen en kotu AST yigin tuketimi (<= 14 KB) + pay

' S-540: AST yorumlayicisinin degisken tablosu kapasitesi. 20261007'de 1024'ten fazla degiskeni olan programlar
' (2000 DIM) calisirdi; S-480'in "257 DIM" ham FreeBASIC hatasi duzeltmesi sinirlari 1024'e koydu ve
' tests/compiler_consolidation/stable_cells_byref_pointer (1510 satir) AST'de dusmeye basladi. `ExecState` Static
' oldugu icin (yigin degil) tablo buyutmek yalniz statik veri ekler (~330 B * UXB_EXEC_MAX_VARS).
Const UXB_EXEC_MAX_VARS As Integer = 8192

Function UXBExecCallDepthLimit() As Integer
    Return UXBStackSafeCallDepth(UXB_EXEC_BYTES_PER_CALL_LEVEL, UXB_EXEC_MAX_CALL_DEPTH)
End Function

Type ExecValue
    valueType As String  ' INTEGER, I64_VALUE, FLOAT, STRING, EXTERNAL_BIG, U64_PTR
    intValue As Integer
    u64Value As ULongInt
    floatValue As Double
    stringValue As String
    externalHandle As Any Ptr
    externalKind As String
    externalText As String
    externalPrecision As Integer
End Type

' Model D argument call results are typed, frame-scoped values. In particular
' STRING copies own their bytes; an integer side channel cannot preserve them.
Type ExecArgumentSnapshot
    nodeIdx As Integer
    callDepth As Integer
    value As ExecValue
End Type

' ABI10 / typed CALL result side channel.
' Existing evaluator APIs return Integer. This value preserves F64 and pointer-token
' results across CALL_EXPR and user wrapper FUNCTION boundaries without breaking the
' legacy integer API.
Dim Shared gExecLastCallValueEx As ExecValue
Dim Shared gExecLastCallValueExValid As Integer

Type ExecVar
    nameText As String
    value As ExecValue
    addr As UInteger
    declType As String
    runtimeClassType As String
    isArray As Integer
    arrayId As Integer
    arrayDims As Integer
    arrayLower As Integer
    arrayUpper As Integer
    arrayBytes As LongInt
    ' Stable, declared-width storage for VARPTR and native PEEK/POKE.
    pinned As Integer
    pinWidth As Integer
    pinType As String
    pinCell(0 To 15) As UByte
    ' BYREF parameters alias the caller slot.  Zero means an ordinary slot.
    refIdxPlus1 As Integer
    ' DIM ownership marker used to distinguish the same declaration from a
    ' later local shadow with the same name.
    dimDeclNodePlus1 As Integer
    ' typeBinding As TypeBinding
End Type

Type ExecArray
    dims As Integer
    bounds(Any) As Integer  ' lower/upper pairs
    elements(Any) As ExecValue
    totalElements As Integer
    ' Native scalar arrays use one tightly packed byte store for indexed access
    ' and VARPTR/PEEK/POKE so both views address the same storage.
    isNativeScalar As Integer
    elemStride As Integer
    rawData(Any) As UByte
End Type

Type ExecObject
    typeName As String
    fields(Any) As ExecValue
    fieldNames(Any) As String
    fieldCount As Integer
End Type

Type ExecCollection
    kind As String  ' LIST, DICT, SET
    listItems(Any) As ExecValue
    dictKeys(Any) As String
    dictValues(Any) As ExecValue
    setItems(Any) As String
    count As Integer
End Type

Type ExecExceptionState
    active As Integer
    kindText As String
    code As Integer
    messageText As String
    lineNo As Integer
    colNo As Integer
    routineName As String
    value As ExecValue
End Type

Type ExecConstEntry
    nameText As String
    value As ExecValue
End Type

Type ExecDefTypeEntry
    typeChar As String
    typeName As String
End Type

Type ExecTaskEntry
    kindText As String
    nameText As String
    qualifiedName As String
    nodeIdx As Integer
    active As Integer
    loaded As Integer
    parentName As String
End Type

Type ExecSlotEntry
    kindText As String
    nameText As String
    slotId As Integer
    nodeIdx As Integer
    active As Integer
    loaded As Integer
    targetName As String
    targetQualifiedName As String
    targetKind As String
    targetNodeIdx As Integer
End Type

Type ExecFfiAllowEntry
    dllName As String
    symbolName As String
    signatureText As String
    callingConventionText As String
    hashText As String
    signerText As String
End Type

Type ExecFfiIndexSlot
    used As Integer
    key As String
    headIdx As Integer
    tailIdx As Integer
End Type

Type ExecRoutineDef
    nameText As String
    nodeIdx As Integer
    routineKind As String
End Type

Type ExecRoutineIndexSlot
    used As Integer
    key As String
    idx As Integer
End Type

Type ExecRuntimeContext
    exitRequest As String
    execException As ExecExceptionState
    routineDefs(Any) As ExecRoutineDef
    routineDefCount As Integer
    routineDefCap As Integer
    routineIndexSlots(Any) As ExecRoutineIndexSlot
    routineIndexCap As Integer
    routineIndexCount As Integer
    callContextDepth As Integer
    argumentSnapshots(Any) As ExecArgumentSnapshot
    argumentSnapshotCount As Integer
    argumentSnapshotCap As Integer
    callFrameBase(0 To UXB_EXEC_MAX_CALL_DEPTH) As Integer
    callReturnValue As Integer
    callReturnValueEx As ExecValue
    callReturnHasValue As Integer
    currentRoutineName As String
    currentRoutineNodeIdx As Integer
    ffiPolicyEnforce As Integer
    ffiPolicyPath As String
    ffiAllowEntries(Any) As ExecFfiAllowEntry
    ffiAllowEntryCount As Integer
    ffiAllowEntryCap As Integer
    ffiAllowlistLoaded As Integer
    ffiAllowlistLoadFailed As Integer
    ffiAllowlistLoadFailReason As String
    ffiIndexBuilt As Integer
    ffiIndexCap As Integer
    ffiIndexSlots(Any) As ExecFfiIndexSlot
    ffiChainNext(Any) As Integer
    ' VTable runtime mapping
    vtableClassNames(Any) As String
    vtableClassSlotCounts(Any) As Integer
    vtableClassSlotStart(Any) As Integer
    vtableClassCount As Integer
    vtableClassHandles(Any) As UInteger
    vtableNextHandle As UInteger
    vtableEntryKeys(Any) As String
    vtableEntrySlots(Any) As Integer
    vtableEntryClassIndex(Any) As Integer
    vtableEntryRoutineIdx(Any) As Integer
    vtableEntryCount As Integer
End Type

Type ExecState
    ' Keep the legacy fixed layout, but leave enough slots for ordinary large
    ' modules. Slot tables remain independently capped at 256.
    vars(0 To UXB_EXEC_MAX_VARS - 1) As ExecVar
    count As Integer
    nextVarAddr As UInteger
    variableStorageError As String
    fileIo As UxbFileRuntime
    consts(Any) As ExecConstEntry
    constCount As Integer
    defTypes(Any) As ExecDefTypeEntry
    defTypeCount As Integer
    stringSize As Integer
    slotEntries(Any) As ExecSlotEntry
    slotEntryCount As Integer
    slotTable(0 To 255) As ExecSlotEntry
    slotCapEvent As Integer
    slotCapThread As Integer
    slotCapParalel As Integer
    slotCapPipe As Integer
    slotCapEventDeclared As Integer
    slotCapThreadDeclared As Integer
    slotCapParalelDeclared As Integer
    slotCapPipeDeclared As Integer
    taskEntries(Any) As ExecTaskEntry
    taskEntryCount As Integer
    runtime As ExecRuntimeContext
    arrays(Any) As ExecArray
    arrayCount As Integer
    ' objects(Any) As ExecObject
    ' objectCount As Integer
    ' collections(Any) As ExecCollection
    ' collectionCount As Integer
End Type

Type MIRInstruction
    opcode As String
    operand1 As String
    operand2 As String
    operand3 As String
End Type

Type MIRBlock
    instructions(Any) As MIRInstruction
    count As Integer
End Type

Type MIREvaluator
    blocks(Any) As MIRBlock
    blockCount As Integer
    currentBlock As Integer
End Type
