#include once "../../common/uxb_stdin.fbs"
Private Function ExecRunPrintStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim printCount As Integer
    printCount = ExecChildCount(ps, stmtIdx)

    If printCount = 0 Then
        UxbConsolePrintNewline
        gDebugPrintColumnPos = UxbConsoleGetPrintColumnPos()
        Return 1
    End If

    Dim trailingSep As String
    trailingSep = ""

    Dim printPos As Integer
    For printPos = 0 To printCount - 1
        Dim printExpr As Integer
        printExpr = ExecChildAt(ps, stmtIdx, printPos)
        If printExpr = -1 Then
            errText = "exec: PRINT expression missing"
            Return 0
        End If

        Dim printNode As ASTNode
        printNode = ps.ast.nodes(printExpr)

        Dim printSep As String
        printSep = ""

        If UCase(printNode.kind) = "PRINT_ITEM" Then
            printSep = printNode.op
            printExpr = printNode.left
            If printExpr = -1 Then
                errText = "exec: PRINT item expression missing"
                Return 0
            End If
            printNode = ps.ast.nodes(printExpr)
        ElseIf printPos < printCount - 1 Then
            printSep = " "
        End If

        Dim printText As String
        If ExecEvalNodeAsText(ps, es, printExpr, printText, errText) = 0 Then Return 0
        UxbConsolePrintText printText
        gDebugPrintColumnPos = UxbConsoleGetPrintColumnPos()

        If printSep = "," Then
            UxbConsolePrintCommaZone EXEC_PRINT_ZONE_WIDTH
            gDebugPrintColumnPos = UxbConsoleGetPrintColumnPos()
        ElseIf printSep = " " Then
            UxbConsolePrintSpace
            gDebugPrintColumnPos = UxbConsoleGetPrintColumnPos()
        End If

        trailingSep = printSep
    Next printPos

    If trailingSep = ";" Or trailingSep = "," Then
        Return 1
    End If

    UxbConsolePrintNewline
    gDebugPrintColumnPos = UxbConsoleGetPrintColumnPos()
    Return 1
End Function

Private Function ExecRunPrintFileStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim itemCount As Integer
    itemCount = ExecChildCount(ps, stmtIdx)
    If itemCount < 2 Then
        errText = "exec: PRINT# handle/value missing"
        Return 0
    End If

    Dim handleExpr As Integer
    handleExpr = ExecChildAt(ps, stmtIdx, 0)
    If handleExpr = -1 Then
        errText = "exec: PRINT# handle missing"
        Return 0
    End If

    Dim channelNo As Integer
    channelNo = ExecEvalNode(ps, es, handleExpr, errText)
    If errText <> "" Then Return 0
    If channelNo < 1 Or channelNo > 255 Then
        errText = "exec: PRINT# bad channel"
        Return 0
    End If
    If es.fileIo.channels(channelNo).inUse = 0 Then
        errText = "exec: PRINT# channel not open"
        Return 0
    End If
    Dim lineText As String
    lineText = ""
    Dim trailingSep As String
    trailingSep = ""

    Dim itemPos As Integer
    For itemPos = 1 To itemCount - 1
        Dim itemNode As Integer
        itemNode = ExecChildAt(ps, stmtIdx, itemPos)
        If itemNode = -1 Then
            errText = "exec: PRINT# item missing"
            Return 0
        End If

        Dim exprNode As Integer
        Dim sepText As String
        sepText = ""
        If UCase(ps.ast.nodes(itemNode).kind) = "PRINT_ITEM" Then
            exprNode = ps.ast.nodes(itemNode).left
            sepText = ps.ast.nodes(itemNode).op
        Else
            exprNode = itemNode
            If itemPos < itemCount - 1 Then sepText = " "
        End If

        If exprNode = -1 Then
            errText = "exec: PRINT# item expression missing"
            Return 0
        End If

        Dim piece As String
        If ExecEvalNodeAsText(ps, es, exprNode, piece, errText) = 0 Then Return 0
        lineText &= piece

        If sepText = "," Then
            lineText &= Chr(9)
        ElseIf sepText = " " Then
            lineText &= " "
        End If
        trailingSep = sepText
    Next itemPos

    If trailingSep = ";" Or trailingSep = "," Then
        Print #channelNo, lineText;
    Else
        Print #channelNo, lineText
    End If

    If Err <> 0 Then
        errText = "exec: PRINT# failed"
        Return 0
    End If

    Return 1
End Function

Private Function ExecRunInputStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim inputCount As Integer
    inputCount = ExecChildCount(ps, stmtIdx)
    If inputCount < 1 Then
        errText = "exec: INPUT target missing"
        Return 0
    End If

    Dim inputStartPos As Integer
    inputStartPos = 0

    Dim firstInputChild As Integer
    firstInputChild = ExecChildAt(ps, stmtIdx, 0)
    If firstInputChild = -1 Then
        errText = "exec: INPUT first child missing"
        Return 0
    End If

    If UCase(ps.ast.nodes(firstInputChild).kind) = "PROMPT_EXPR" Then
        Dim promptExpr As Integer
        promptExpr = ps.ast.nodes(firstInputChild).left
        If promptExpr = -1 Then
            errText = "exec: INPUT prompt missing"
            Return 0
        End If

        If UCase(ps.ast.nodes(promptExpr).kind) = "STRING" Then
            Dim promptText As String
            promptText = ps.ast.nodes(promptExpr).value
            UxbConsolePrintText promptText
        Else
            Dim promptVal As Integer
            promptVal = ExecEvalNode(ps, es, promptExpr, errText)
            If errText <> "" Then Return 0
            Dim promptText As String
            promptText = LTrim(Str(promptVal))
            UxbConsolePrintText promptText
        End If

        inputStartPos = 1
    End If

    If inputStartPos >= inputCount Then
        errText = "exec: INPUT target missing"
        Return 0
    End If

    Dim inputPos As Integer
    For inputPos = inputStartPos To inputCount - 1
        Dim inputTarget As Integer
        inputTarget = ExecChildAt(ps, stmtIdx, inputPos)
        If inputTarget = -1 Then
            errText = "exec: INPUT target missing"
            Return 0
        End If

        If UCase(ps.ast.nodes(inputTarget).kind) <> "IDENT" Then
            errText = "exec: INPUT target must be ident"
            Return 0
        End If

        Dim inputText As String
        If ExecDebugInputQueuePop(inputText) = 0 Then
            UxbStdinReadLine inputText   ' S-164: yonlendirilmis girdide de calisir
        End If

        ' S-164: STRING hedef metni oldugu gibi alir (onceden ValInt ile 0'a donusuyordu); sayisal
        ' hedef INPUT# ile ayni kurala uyar.
        Dim inputTargetName As String = ps.ast.nodes(inputTarget).value
        Dim inputTargetIdx As Integer = ExecFindVar(es, inputTargetName)
        Dim inputTargetType As String = ""
        If inputTargetIdx <> -1 Then inputTargetType = UCase(Trim(es.vars(inputTargetIdx).declType))
        If Left(inputTargetType, 5) = "TYPE_" Then inputTargetType = Mid(inputTargetType, 6)
        If inputTargetType = "STRING" Or inputTargetType = "WSTRING" Then
            Dim inputStringValue As ExecValue
            ExecValueSetString inputStringValue, inputText
            ExecSetVarValue es, inputTargetName, inputStringValue
        ElseIf inputTargetType = "F32" Or inputTargetType = "F64" Or inputTargetType = "SINGLE" Or inputTargetType = "DOUBLE" Then
            Dim inputFloatValue As ExecValue
            ExecValueSetFloat inputFloatValue, Val(inputText)
            ExecSetVarValue es, inputTargetName, inputFloatValue
        Else
            ExecSetVar es, inputTargetName, ValInt(inputText)
        End If
    Next inputPos

    Return 1
End Function

Private Function ExecRunInputFileStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim inputFileCount As Integer
    inputFileCount = ExecChildCount(ps, stmtIdx)
    If inputFileCount < 2 Then
        errText = "exec: INPUT# handle/target missing"
        Return 0
    End If

    Dim inputHandleExpr As Integer
    inputHandleExpr = ExecChildAt(ps, stmtIdx, 0)
    If inputHandleExpr = -1 Then
        errText = "exec: INPUT# handle missing"
        Return 0
    End If

    Dim inputChannel As Integer
    inputChannel = ExecEvalNode(ps, es, inputHandleExpr, errText)
    If errText <> "" Then Return 0

    Dim inputFilePos As Integer
    For inputFilePos = 1 To inputFileCount - 1
        Dim inputFileTarget As Integer
        inputFileTarget = ExecChildAt(ps, stmtIdx, inputFilePos)
        If inputFileTarget = -1 Then
            errText = "exec: INPUT# target missing"
            Return 0
        End If

        If UCase(ps.ast.nodes(inputFileTarget).kind) <> "IDENT" Then
            errText = "exec: INPUT# target must be ident"
            Return 0
        End If

        ' ADIM43: INPUT# reads a line first; string variables keep text, numeric variables use ValInt.
        Dim inputReadLine43 As String
        If UxbFileInputLine(es.fileIo, inputChannel, inputReadLine43) = 0 Then
            errText = "exec: INPUT# failed " & ExecFormatFileError(es.fileIo)
            Return 0
        End If

        Dim inputTargetName43 As String
        inputTargetName43 = ps.ast.nodes(inputFileTarget).value
        Dim inputTargetVarIdx43 As Integer
        inputTargetVarIdx43 = ExecFindVar(es, inputTargetName43)
        If inputTargetVarIdx43 = -1 Then
            ' Assignment contexts permit an implicit numeric variable. String input
            ' remains explicit through DIM ... AS STRING; uXBasic has no $ suffix.
            ExecSetVar es, inputTargetName43, ValInt(inputReadLine43)
            Continue For
        End If

        Dim inputTargetType43 As String
        inputTargetType43 = UCase(Trim(es.vars(inputTargetVarIdx43).declType))
        If inputTargetType43 = "STRING" Or inputTargetType43 = "WSTRING" Then
            Dim inputStringValue43 As ExecValue
            ExecValueSetString inputStringValue43, inputReadLine43
            ExecSetVarValue es, inputTargetName43, inputStringValue43
        Else
            ExecSetVar es, inputTargetName43, ValInt(inputReadLine43)
        End If
    Next inputFilePos

    Return 1
End Function

Private Function ExecRunLocateStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim locateCount As Integer
    locateCount = ExecChildCount(ps, stmtIdx)
    If locateCount < 2 Then
        errText = "exec: LOCATE missing row/col"
        Return 0
    End If

    Dim locateRowExpr As Integer
    Dim locateColExpr As Integer
    locateRowExpr = ExecChildAt(ps, stmtIdx, 0)
    locateColExpr = ExecChildAt(ps, stmtIdx, 1)
    If locateRowExpr = -1 Or locateColExpr = -1 Then
        errText = "exec: LOCATE missing row/col"
        Return 0
    End If

    Dim locateRow As Integer
    Dim locateCol As Integer
    locateRow = ExecEvalNode(ps, es, locateRowExpr, errText)
    If errText <> "" Then Return 0
    locateCol = ExecEvalNode(ps, es, locateColExpr, errText)
    If errText <> "" Then Return 0

    gDebugLocateRow = locateRow
    gDebugLocateCol = locateCol
    UxbConsoleLocate locateRow, locateCol
    Return 1
End Function

Private Function ExecRunColorStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim colorCount As Integer
    colorCount = ExecChildCount(ps, stmtIdx)
    If colorCount < 2 Then
        errText = "exec: COLOR missing fg/bg"
        Return 0
    End If

    Dim colorFgExpr As Integer
    Dim colorBgExpr As Integer
    colorFgExpr = ExecChildAt(ps, stmtIdx, 0)
    colorBgExpr = ExecChildAt(ps, stmtIdx, 1)
    If colorFgExpr = -1 Or colorBgExpr = -1 Then
        errText = "exec: COLOR missing fg/bg"
        Return 0
    End If

    Dim colorFg As Integer
    Dim colorBg As Integer
    colorFg = ExecEvalNode(ps, es, colorFgExpr, errText)
    If errText <> "" Then Return 0
    colorBg = ExecEvalNode(ps, es, colorBgExpr, errText)
    If errText <> "" Then Return 0

    gDebugColorFg = colorFg
    gDebugColorBg = colorBg
    UxbConsoleColor colorFg, colorBg
    Return 1
End Function

Private Function ExecRunOpenStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim openCount As Integer
    openCount = ExecChildCount(ps, stmtIdx)
    If openCount < 3 Or openCount > 4 Then
        errText = "exec: OPEN argument count invalid"
        Return 0
    End If

    Dim openFileExpr As Integer
    Dim openModeExpr As Integer
    Dim openHandleExpr As Integer
    openFileExpr = ExecChildAt(ps, stmtIdx, 0)
    openModeExpr = ExecChildAt(ps, stmtIdx, 1)
    openHandleExpr = ExecChildAt(ps, stmtIdx, 2)

    If openFileExpr = -1 Or openModeExpr = -1 Or openHandleExpr = -1 Then
        errText = "exec: OPEN args missing"
        Return 0
    End If

    Dim filePath As String
    If ExecEvalStringLiteral(ps, es, openFileExpr, filePath, errText) = 0 Then
        Return 0
    End If

    If UCase(ps.ast.nodes(openModeExpr).kind) <> "MODE_REF" Then
        errText = "exec: OPEN mode node invalid"
        Return 0
    End If

    Dim modeText As String
    modeText = ps.ast.nodes(openModeExpr).value

    Dim channelNumber As Integer
    channelNumber = ExecEvalNode(ps, es, openHandleExpr, errText)
    If errText <> "" Then Return 0

    Dim recordLength As Integer
    recordLength = 0
    If openCount = 4 Then
        Dim lenExpr As Integer
        lenExpr = ExecChildAt(ps, stmtIdx, 3)
        If lenExpr = -1 Then
            errText = "exec: OPEN LEN arg missing"
            Return 0
        End If
        recordLength = ExecEvalNode(ps, es, lenExpr, errText)
        If errText <> "" Then Return 0
        If recordLength <= 0 Then
            errText = "exec: OPEN LEN must be positive"
            Return 0
        End If
    End If

    If UxbFileOpen(es.fileIo, channelNumber, filePath, modeText, recordLength) = 0 Then
        errText = "exec: OPEN failed " & ExecFormatFileError(es.fileIo)
        Return 0
    End If
    Return 1
End Function

Private Function ExecRunCloseStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim closeCount As Integer
    closeCount = ExecChildCount(ps, stmtIdx)

    If closeCount = 0 Then
        UxbFileCloseAll es.fileIo
        Return 1
    End If

    Dim closeIndex As Integer
    For closeIndex = 0 To closeCount - 1
        Dim closeHandleExpr As Integer
        closeHandleExpr = ExecChildAt(ps, stmtIdx, closeIndex)
        If closeHandleExpr = -1 Then
            errText = "exec: CLOSE handle missing"
            Return 0
        End If

        Dim closeChannel As Integer
        closeChannel = ExecEvalNode(ps, es, closeHandleExpr, errText)
        If errText <> "" Then Return 0

        If UxbFileClose(es.fileIo, closeChannel) = 0 Then
            errText = "exec: CLOSE failed " & ExecFormatFileError(es.fileIo)
            Return 0
        End If
    Next closeIndex

    Return 1
End Function

Private Function ExecRunGetStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim getCount As Integer
    getCount = ExecChildCount(ps, stmtIdx)
    If getCount < 2 Or getCount > 4 Then
        errText = "exec: GET argument count invalid"
        Return 0
    End If

    Dim getHandleExpr As Integer
    getHandleExpr = ExecChildAt(ps, stmtIdx, 0)
    If getHandleExpr = -1 Then
        errText = "exec: GET handle missing"
        Return 0
    End If

    Dim getChannel As Integer
    getChannel = ExecEvalNode(ps, es, getHandleExpr, errText)
    If errText <> "" Then Return 0

    Dim getPositionValue As LongInt
    Dim getBytesValue As Integer
    Dim getTargetExpr As Integer
    getPositionValue = -1
    getBytesValue = 0
    getTargetExpr = -1

    If getCount = 2 Then
        getTargetExpr = ExecChildAt(ps, stmtIdx, 1)
    ElseIf getCount = 3 Then
        Dim getPositionExpr As Integer
        getPositionExpr = ExecChildAt(ps, stmtIdx, 1)
        getTargetExpr = ExecChildAt(ps, stmtIdx, 2)
        If getPositionExpr = -1 Or getTargetExpr = -1 Then
            errText = "exec: GET position/target missing"
            Return 0
        End If
        getPositionValue = ExecEvalNode(ps, es, getPositionExpr, errText)
        If errText <> "" Then Return 0
    Else
        Dim getPositionExpr As Integer
        Dim getBytesExpr As Integer
        getPositionExpr = ExecChildAt(ps, stmtIdx, 1)
        getBytesExpr = ExecChildAt(ps, stmtIdx, 2)
        getTargetExpr = ExecChildAt(ps, stmtIdx, 3)
        If getPositionExpr = -1 Or getBytesExpr = -1 Or getTargetExpr = -1 Then
            errText = "exec: GET position/bytes/target missing"
            Return 0
        End If
        getPositionValue = ExecEvalNode(ps, es, getPositionExpr, errText)
        If errText <> "" Then Return 0
        getBytesValue = ExecEvalNode(ps, es, getBytesExpr, errText)
        If errText <> "" Then Return 0
    End If

    If getTargetExpr = -1 Then
        errText = "exec: GET target missing"
        Return 0
    End If

    If UCase(ps.ast.nodes(getTargetExpr).kind) <> "IDENT" Then
        errText = "exec: GET target must be ident"
        Return 0
    End If

    Dim getReadValue As Integer
    If UxbFileGetI32(es.fileIo, getChannel, getPositionValue, getBytesValue, getReadValue) = 0 Then
        errText = "exec: GET failed " & ExecFormatFileError(es.fileIo)
        Return 0
    End If

    ExecSetVar es, ps.ast.nodes(getTargetExpr).value, getReadValue
    Return 1
End Function

Private Function ExecRunPutStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim putCount As Integer
    putCount = ExecChildCount(ps, stmtIdx)
    If putCount < 2 Or putCount > 4 Then
        errText = "exec: PUT argument count invalid"
        Return 0
    End If

    Dim putHandleExpr As Integer
    putHandleExpr = ExecChildAt(ps, stmtIdx, 0)
    If putHandleExpr = -1 Then
        errText = "exec: PUT handle missing"
        Return 0
    End If

    Dim putChannel As Integer
    putChannel = ExecEvalNode(ps, es, putHandleExpr, errText)
    If errText <> "" Then Return 0

    Dim putPositionValue As LongInt
    Dim putBytesValue As Integer
    Dim putSourceExpr As Integer
    putPositionValue = -1
    putBytesValue = 0
    putSourceExpr = -1

    If putCount = 2 Then
        putSourceExpr = ExecChildAt(ps, stmtIdx, 1)
    ElseIf putCount = 3 Then
        Dim putPositionExpr As Integer
        putPositionExpr = ExecChildAt(ps, stmtIdx, 1)
        putSourceExpr = ExecChildAt(ps, stmtIdx, 2)
        If putPositionExpr = -1 Or putSourceExpr = -1 Then
            errText = "exec: PUT position/source missing"
            Return 0
        End If
        putPositionValue = ExecEvalNode(ps, es, putPositionExpr, errText)
        If errText <> "" Then Return 0
    Else
        Dim putPositionExpr As Integer
        Dim putBytesExpr As Integer
        putPositionExpr = ExecChildAt(ps, stmtIdx, 1)
        putBytesExpr = ExecChildAt(ps, stmtIdx, 2)
        putSourceExpr = ExecChildAt(ps, stmtIdx, 3)
        If putPositionExpr = -1 Or putBytesExpr = -1 Or putSourceExpr = -1 Then
            errText = "exec: PUT position/bytes/source missing"
            Return 0
        End If
        putPositionValue = ExecEvalNode(ps, es, putPositionExpr, errText)
        If errText <> "" Then Return 0
        putBytesValue = ExecEvalNode(ps, es, putBytesExpr, errText)
        If errText <> "" Then Return 0
    End If

    If putSourceExpr = -1 Then
        errText = "exec: PUT source missing"
        Return 0
    End If

    Dim putValue As Integer
    putValue = ExecEvalNode(ps, es, putSourceExpr, errText)
    If errText <> "" Then Return 0

    If UxbFilePutI32(es.fileIo, putChannel, putPositionValue, putBytesValue, putValue) = 0 Then
        errText = "exec: PUT failed " & ExecFormatFileError(es.fileIo)
        Return 0
    End If

    Return 1
End Function

Private Function ExecRunSeekStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim seekCount As Integer
    seekCount = ExecChildCount(ps, stmtIdx)
    If seekCount < 1 Or seekCount > 2 Then
        errText = "exec: SEEK argument count invalid"
        Return 0
    End If

    Dim seekHandleExpr As Integer
    seekHandleExpr = ExecChildAt(ps, stmtIdx, 0)
    If seekHandleExpr = -1 Then
        errText = "exec: SEEK handle missing"
        Return 0
    End If

    Dim seekChannel As Integer
    seekChannel = ExecEvalNode(ps, es, seekHandleExpr, errText)
    If errText <> "" Then Return 0

    Dim seekPositionValue As LongInt
    seekPositionValue = -1
    If seekCount = 2 Then
        Dim seekPositionExpr As Integer
        seekPositionExpr = ExecChildAt(ps, stmtIdx, 1)
        If seekPositionExpr = -1 Then
            errText = "exec: SEEK position missing"
            Return 0
        End If
        seekPositionValue = ExecEvalNode(ps, es, seekPositionExpr, errText)
        If errText <> "" Then Return 0
    End If

    Dim currentFilePosition As LongInt
    If UxbFileSeek(es.fileIo, seekChannel, seekPositionValue, currentFilePosition) = 0 Then
        errText = "exec: SEEK failed " & ExecFormatFileError(es.fileIo)
        Return 0
    End If
    Return 1
End Function


Private Function ExecShellQuoteArg(ByRef rawText As String) As String
    Dim q As String
    Dim outText As String
    Dim i As Integer
    q = Chr(34)
    outText = q
    For i = 1 To Len(rawText)
        Dim ch As String
        ch = Mid(rawText, i, 1)
        If ch = q Then outText &= q
        outText &= ch
    Next i
    outText &= q
    Return outText
End Function

Private Function ExecShellTempPath(ByVal suffixText As String) As String
    Dim basePath As String
    basePath = Environ("TEMP")
    If Trim(basePath) = "" Then basePath = "."
    Dim sep As String
#ifdef __FB_WIN32__
    sep = "\\"
#else
    sep = "/"
#endif
    If Right(basePath, 1) = "\\" Or Right(basePath, 1) = "/" Then sep = ""
    Return basePath & sep & "uxb_shell_" & LTrim(Str(Timer * 1000)) & "_" & LTrim(Str(Int(Rnd * 1000000))) & suffixText
End Function

Private Function ExecShellReadAllText(ByRef filePath As String, ByRef textOut As String) As Integer
    textOut = ""
    If Trim(filePath) = "" Then Return 1

    Dim f As Integer
    Dim lineText As String
    f = FreeFile
    On Error GoTo _exec_shell_read_error
    Open filePath For Input As #f
    Do While EOF(f) = 0
        Line Input #f, lineText
        If textOut <> "" Then textOut &= Chr(10)
        textOut &= lineText
    Loop
    Close #f
    On Error GoTo 0
    Return 1

_exec_shell_read_error:
    On Error GoTo 0
    Return 0
End Function

Private Sub ExecShellTryDelete(ByRef filePath As String)
    If Trim(filePath) = "" Then Exit Sub
    On Error GoTo _exec_shell_delete_done
    Kill filePath
_exec_shell_delete_done:
    On Error GoTo 0
End Sub


Private Function ExecShellSaveTextFile(ByRef filePath As String, ByRef textIn As String) As Integer
    If Trim(filePath) = "" Then Return 1
    Dim f As Integer
    f = FreeFile
    On Error GoTo write_failed
    Open filePath For Output As #f
    Print #f, textIn;
    Close #f
    On Error GoTo 0
    Return 1
write_failed:
    On Error GoTo 0
    Return 0
End Function

Private Function ExecShellEvalOptionText(ByRef ps As ParseState, ByRef es As ExecState, ByVal optionNode As Integer, ByRef textOut As String, ByRef errText As String) As Integer
    textOut = ""
    If optionNode = -1 Then Return 1
    Dim payloadNode As Integer
    payloadNode = ExecChildAt(ps, optionNode, 0)
    If payloadNode = -1 Then payloadNode = ps.ast.nodes(optionNode).left
    If payloadNode = -1 Then Return 1
    Return ExecEvalNodeAsText(ps, es, payloadNode, textOut, errText)
End Function

Private Function ExecShellEvalOptionInt(ByRef ps As ParseState, ByRef es As ExecState, ByVal optionNode As Integer, ByRef intOut As Integer, ByRef errText As String) As Integer
    intOut = 0
    If optionNode = -1 Then Return 1
    Dim payloadNode As Integer
    payloadNode = ExecChildAt(ps, optionNode, 0)
    If payloadNode = -1 Then payloadNode = ps.ast.nodes(optionNode).left
    If payloadNode = -1 Then Return 1
    intOut = ExecEvalNode(ps, es, payloadNode, errText)
    If errText <> "" Then Return 0
    Return 1
End Function

Private Function ExecShellBuildCommand(ByRef commandText As String, ByRef runPath As String, ByRef outPath As String, ByRef errPath As String) As String
    Dim cmd As String
#ifdef __FB_WIN32__
    cmd = "cmd /c "
    If Trim(runPath) <> "" Then cmd &= "cd /d " & ExecShellQuoteArg(runPath) & " && "
    cmd &= commandText
    If Trim(outPath) <> "" Then cmd &= " > " & ExecShellQuoteArg(outPath)
    If Trim(errPath) <> "" Then cmd &= " 2> " & ExecShellQuoteArg(errPath)
#else
    Dim posixInner As String
    posixInner = ""
    If Trim(runPath) <> "" Then posixInner &= "cd " & ExecShellQuoteArg(runPath) & " && "
    posixInner &= commandText
    If Trim(outPath) <> "" Then posixInner &= " > " & ExecShellQuoteArg(outPath)
    If Trim(errPath) <> "" Then posixInner &= " 2> " & ExecShellQuoteArg(errPath)
    cmd = "sh -c " & ExecShellQuoteArg(posixInner)
#endif
    Return cmd
End Function

Private Function ExecShellBuildNowaitCommand(ByRef commandText As String, ByRef runPath As String, ByRef outPath As String, ByRef errPath As String) As String
#ifdef __FB_WIN32__
    Dim innerCmd As String
    innerCmd = ""
    If Trim(runPath) <> "" Then innerCmd &= "cd /d " & ExecShellQuoteArg(runPath) & " && "
    innerCmd &= commandText
    If Trim(outPath) <> "" Then innerCmd &= " > " & ExecShellQuoteArg(outPath)
    If Trim(errPath) <> "" Then innerCmd &= " 2> " & ExecShellQuoteArg(errPath)
    Return "cmd /c start " & Chr(34) & Chr(34) & " cmd /c " & ExecShellQuoteArg(innerCmd)
#else
    Dim posixCmd As String
    posixCmd = ""
    If Trim(runPath) <> "" Then posixCmd &= "cd " & ExecShellQuoteArg(runPath) & " && "
    posixCmd &= commandText
    If Trim(outPath) <> "" Then posixCmd &= " > " & ExecShellQuoteArg(outPath)
    If Trim(errPath) <> "" Then posixCmd &= " 2> " & ExecShellQuoteArg(errPath)
    posixCmd &= " &"
    Return "sh -c " & ExecShellQuoteArg(posixCmd)
#endif
End Function

Private Function ExecRunShellStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim commandNode As Integer
    commandNode = ExecChildAt(ps, stmtIdx, 0)
    If commandNode = -1 Then
        errText = "exec: SHELL command missing"
        Return 0
    End If

    Dim commandText As String
    If ExecEvalNodeAsText(ps, es, commandNode, commandText, errText) = 0 Then Return 0

    Dim timeoutMs As Integer
    timeoutMs = 0
    Dim nowaitMode As Integer
    nowaitMode = 0
    Dim runPath As String
    Dim outPath As String
    Dim errPath As String
    Dim outVar As String
    Dim errVar As String
    Dim codeVar As String
    runPath = ""
    outPath = ""
    errPath = ""
    outVar = ""
    errVar = ""
    codeVar = ""

    Dim ch As Integer
    ch = ps.ast.nodes(stmtIdx).firstChild
    If ch <> -1 Then ch = ps.ast.nodes(ch).nextSibling
    Do While ch <> -1
        If UCase(ps.ast.nodes(ch).kind) = "SHELL_OPTION" Then
            Dim optName As String
            optName = UCase(Trim(ps.ast.nodes(ch).value))
            Select Case optName
            Case "NOWAIT"
                nowaitMode = 1
            Case "TIMEOUT"
                If ExecShellEvalOptionInt(ps, es, ch, timeoutMs, errText) = 0 Then Return 0
            Case "RUNPATH"
                If ExecShellEvalOptionText(ps, es, ch, runPath, errText) = 0 Then Return 0
            Case "OUTPATH"
                If ExecShellEvalOptionText(ps, es, ch, outPath, errText) = 0 Then Return 0
            Case "ERRPATH"
                If ExecShellEvalOptionText(ps, es, ch, errPath, errText) = 0 Then Return 0
            Case "OUTVAR"
                Dim outVarNode As Integer
                outVarNode = ExecChildAt(ps, ch, 0)
                If outVarNode = -1 Then outVarNode = ps.ast.nodes(ch).left
                If outVarNode <> -1 Then outVar = ps.ast.nodes(outVarNode).value
            Case "ERRVAR"
                Dim errVarNode As Integer
                errVarNode = ExecChildAt(ps, ch, 0)
                If errVarNode = -1 Then errVarNode = ps.ast.nodes(ch).left
                If errVarNode <> -1 Then errVar = ps.ast.nodes(errVarNode).value
            Case "CODEVAR"
                Dim codeVarNode As Integer
                codeVarNode = ExecChildAt(ps, ch, 0)
                If codeVarNode = -1 Then codeVarNode = ps.ast.nodes(ch).left
                If codeVarNode <> -1 Then codeVar = ps.ast.nodes(codeVarNode).value
            End Select
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If nowaitMode <> 0 Then
        Dim nowaitCmd As String
        nowaitCmd = ExecShellBuildNowaitCommand(commandText, runPath, outPath, errPath)
        Dim nowaitRc As Integer
        nowaitRc = Shell(nowaitCmd)
        If codeVar <> "" Then ExecSetVar es, codeVar, nowaitRc
        Return 1
    End If

    Dim nativeOutText As String
    Dim nativeErrText As String
    Dim rc As Integer
    Dim nativeShellHandled As Integer
    nativeShellHandled = 0
    If uxb_runtime_is_loaded() = 0 Then uxb_runtime_try_init()
    If uxb_runtime_is_loaded() Then
        nativeShellHandled = 1
        Dim nativeOk As Integer
        nativeOk = uxb_shell_run(commandText, runPath, timeoutMs, nativeOutText, nativeErrText, rc)
        If nativeOk = 0 And rc <> 124 Then
            errText = "exec: native SHELL failed"
            If Trim(nativeErrText) <> "" Then errText &= ": " & nativeErrText
            If Trim(nativeErrText) = "" And Trim(uxb_last_error()) <> "" Then errText &= ": " & uxb_last_error()
            Return 0
        End If
        If Trim(outPath) <> "" Then
            If ExecShellSaveTextFile(outPath, nativeOutText) = 0 Then errText = "exec: SHELL OUTPATH write failed": Return 0
        End If
        If Trim(errPath) <> "" Then
            If ExecShellSaveTextFile(errPath, nativeErrText) = 0 Then errText = "exec: SHELL ERRPATH write failed": Return 0
        End If
        If outVar <> "" Then
            Dim nativeOutValue As ExecValue
            ExecValueSetString nativeOutValue, nativeOutText
            ExecSetVarValue es, outVar, nativeOutValue
        End If
        If errVar <> "" Then
            Dim nativeErrValue As ExecValue
            ExecValueSetString nativeErrValue, nativeErrText
            ExecSetVarValue es, errVar, nativeErrValue
        End If
        If codeVar <> "" Then ExecSetVar es, codeVar, rc
        Return 1
    End If

    Dim captureOutPath As String
    Dim captureErrPath As String
    captureOutPath = outPath
    captureErrPath = errPath
    If outVar <> "" And Trim(captureOutPath) = "" Then captureOutPath = ExecShellTempPath("_out.txt")
    If errVar <> "" And Trim(captureErrPath) = "" Then captureErrPath = ExecShellTempPath("_err.txt")

    Dim waitCmd As String
    waitCmd = ExecShellBuildCommand(commandText, runPath, captureOutPath, captureErrPath)
    rc = Shell(waitCmd)

    If outVar <> "" Then
        Dim outText As String
        If ExecShellReadAllText(captureOutPath, outText) <> 0 Then
            Dim outValue As ExecValue
            ExecValueSetString outValue, outText
            ExecSetVarValue es, outVar, outValue
        End If
        If outPath = "" Then ExecShellTryDelete captureOutPath
    End If

    If errVar <> "" Then
        Dim erText As String
        If ExecShellReadAllText(captureErrPath, erText) <> 0 Then
            Dim errValue As ExecValue
            ExecValueSetString errValue, erText
            ExecSetVarValue es, errVar, errValue
        End If
        If errPath = "" Then ExecShellTryDelete captureErrPath
    End If

    If codeVar <> "" Then ExecSetVar es, codeVar, rc
    Return 1
End Function

Private Function ExecRunIoFileStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef st As ASTNode, ByRef errText As String) As Integer
    Select Case UCase(st.kind)
    Case "PRINT_STMT"
        ' FIX6_RUNTIME_SEMANTIC_20260610:
        ' Parser PRINT #n,... için PRINT_STMT + op="FILE" üretebiliyor.
        ' Bu durumda normal konsol PRINT değil dosya kanalı PRINT# çalışmalı.
        If UCase(Trim(st.op)) = "FILE" Then
            Return ExecRunPrintFileStmt(ps, es, stmtIdx, errText)
        End If
        Return ExecRunPrintStmt(ps, es, stmtIdx, errText)
    Case "PRINT_FILE_STMT"
        Return ExecRunPrintFileStmt(ps, es, stmtIdx, errText)

    Case "INPUT_STMT"
        Return ExecRunInputStmt(ps, es, stmtIdx, errText)

    Case "INPUT_FILE_STMT", "INPUTF_STMT"
        Return ExecRunInputFileStmt(ps, es, stmtIdx, errText)

    Case "LOCATE_STMT"
        Return ExecRunLocateStmt(ps, es, stmtIdx, errText)

    Case "COLOR_STMT"
        Return ExecRunColorStmt(ps, es, stmtIdx, errText)

    Case "CLS_STMT"
        gDebugClsCount += 1
        UxbConsoleCls
        Return 1

    Case "SHELL_STMT"
        Return ExecRunShellStmt(ps, es, stmtIdx, errText)

    Case "OPEN_STMT"
        Return ExecRunOpenStmt(ps, es, stmtIdx, errText)

    Case "CLOSE_STMT"
        Return ExecRunCloseStmt(ps, es, stmtIdx, errText)

    Case "GET_STMT"
        Return ExecRunGetStmt(ps, es, stmtIdx, errText)

    Case "PUT_STMT"
        Return ExecRunPutStmt(ps, es, stmtIdx, errText)

    Case "SEEK_STMT"
        Return ExecRunSeekStmt(ps, es, stmtIdx, errText)
    End Select

    Return -2
End Function
