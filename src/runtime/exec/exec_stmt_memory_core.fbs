Private Function ExecRunMemCopyBStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim modeOffset As Integer
    Dim memMode As String
    If ExecMemoryModeOffset(ps, stmtIdx, modeOffset, memMode, errText) = 0 Then Return 0
    Dim mc0 As Integer
    Dim mc1 As Integer
    Dim mc2 As Integer
    mc0 = ExecChildAt(ps, stmtIdx, modeOffset)
    mc1 = ExecChildAt(ps, stmtIdx, modeOffset + 1)
    mc2 = ExecChildAt(ps, stmtIdx, modeOffset + 2)
    If mc0 = -1 Or mc1 = -1 Or mc2 = -1 Then
        errText = "exec: MEMCOPYB args missing"
        Return 0
    End If

    Dim srcAddr As Integer
    Dim dstAddr As Integer
    Dim copyLen As Integer
    Dim dstIsArrayRef As Integer
    Dim srcIsArrayRef As Integer
    ' Canonical argument order is MEMCOPYB dst, src, len (matches memcpy/CopyMemory).
    If ExecResolveMemcopyOperandAddr(ps, es, mc0, dstAddr, dstIsArrayRef, errText) = 0 Then Return 0
    If ExecResolveMemcopyOperandAddr(ps, es, mc1, srcAddr, srcIsArrayRef, errText) = 0 Then Return 0
    copyLen = ExecEvalNode(ps, es, mc2, errText)
    If errText <> "" Then Return 0

    If copyLen < 0 Then
        errText = "exec: MEMCOPYB negative length"
        Return 0
    End If

    If memMode = "NATIVE" Or dstIsArrayRef <> 0 Or srcIsArrayRef <> 0 Then
        If ExecNativeMemCopyBytes(CUInt(dstAddr), CUInt(srcAddr), CUInt(copyLen)) = 0 Then
            errText = "exec: NATIVE MEMCOPYB out of range" & UXBMemRefReason()
            Return 0
        End If
        Return 1
    End If

    If VMemCopyB(CUInt(srcAddr), CUInt(dstAddr), CUInt(copyLen)) = 0 Then
        errText = "exec: MEMCOPYB out of range"
        Return 0
    End If

    Return 1
End Function

Private Function ExecRunMemFillBStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim modeOffset As Integer
    Dim memMode As String
