    mf2 = ExecChildAt(ps, stmtIdx, modeOffset + 2)
    If mf0 = -1 Or mf1 = -1 Or mf2 = -1 Then
        errText = "exec: MEMFILLB args missing"
        Return 0
    End If

    Dim fillAddr As Integer
    Dim fillVal As Integer
    Dim fillLen As Integer
    fillAddr = ExecEvalNode(ps, es, mf0, errText)
    If errText <> "" Then Return 0
    fillVal = ExecEvalNode(ps, es, mf1, errText)
    If errText <> "" Then Return 0
    fillLen = ExecEvalNode(ps, es, mf2, errText)
    If errText <> "" Then Return 0

    If fillLen < 0 Then
        errText = "exec: MEMFILLB negative length"
        Return 0
    End If

    If memMode = "NATIVE" Then
        If ExecNativeMemFillBBytes(CUInt(fillAddr), fillVal, CUInt(fillLen)) = 0 Then
            errText = "exec: NATIVE MEMFILLB out of range" & UXBMemRefReason()
            Return 0
        End If
        Return 1
    End If

    If VMemFillB(CUInt(fillAddr), fillVal, CUInt(fillLen)) = 0 Then
        errText = "exec: MEMFILLB out of range"
        Return 0
    End If

    Return 1
End Function

Private Function ExecRunPokeSStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim modeOffset As Integer = 0
    Dim isNativeMode As Integer = 0
    If ExecChildAt(ps, stmtIdx, 0) <> -1 And UCase(ps.ast.nodes(ExecChildAt(ps, stmtIdx, 0)).kind) = "KEYWORD_REF" Then
        Dim modeName As String = UCase(Trim(ps.ast.nodes(ExecChildAt(ps, stmtIdx, 0)).value))
        ' S-059: NATIVE mode used to be rejected unconditionally here, while
        ' canonical-MIR silently tried and failed ("memory sequence write
        ' failed") and native x64 already resolved NATIVE addresses for real
        ' (mir_x64_runtime_emit_helpers.fbs's sequence emitters) -- a 3-way
        ' split for identical source. Give it a real implementation instead,
        ' matching what NATIVE POKEB/W/D already do in this same file's
        ' sibling statements.
        If modeName = "NATIVE" Then isNativeMode = 1: modeOffset = 1
        If modeName = "VIRTUAL" Then modeOffset = 1
    End If
    Dim ps0 As Integer = ExecChildAt(ps, stmtIdx, modeOffset)
    Dim ps1 As Integer = ExecChildAt(ps, stmtIdx, modeOffset + 1)
    If ps0 = -1 Or ps1 = -1 Then errText = "exec: POKES args missing": Return 0
    Dim pokeAddr As Integer = ExecEvalNode(ps, es, ps0, errText)
    If errText <> "" Then Return 0
    Dim textValue As String
    If ExecEvalNodeAsText(ps, es, ps1, textValue, errText) = 0 Then Return 0
    Dim writeLen As Integer = Len(textValue)
    Dim explicitLenNode As Integer = ExecChildAt(ps, stmtIdx, modeOffset + 2)
    If explicitLenNode <> -1 Then
        writeLen = ExecEvalNode(ps, es, explicitLenNode, errText)
        If errText <> "" Or writeLen < 0 Then errText = "exec: POKES invalid length": Return 0
    End If
    If writeLen > Len(textValue) Then errText = "exec: POKES length exceeds source text": Return 0
    If isNativeMode <> 0 Then
        If ExecNativeMemCopyBytes(CUInt(pokeAddr), CUInt(StrPtr(textValue)), CUInt(writeLen)) = 0 Then
            errText = "exec: NATIVE POKES out of range" & UXBMemRefReason()
            Return 0
        End If
        Return 1
    End If
    If VMemPokeSLength(CUInt(pokeAddr), textValue, CUInt(writeLen)) = 0 Then errText = "exec: POKES out of range": Return 0
    Return 1
End Function

Private Function ExecRunMemCopyWStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
