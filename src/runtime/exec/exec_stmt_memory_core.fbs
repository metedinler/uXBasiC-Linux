Declare Function ExecRunVirtualStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer

' S-033 follow-up: resolves a MEMCOPY dst/src operand that names a plain,
' native-scalar-typed array directly (no VARPTR) to that array's real
' rawData address (mirrors VARPTR's own array handling in
' exec_eval_builtin_categories.fbs) so `MEMCOPYD dst, src, n` works without
' requiring the user to write VARPTR(dst(0)) by hand -- previously this
' silently evaluated the bare array name as a plain (always-zero) scalar
' expression, so the copy ran against address 0 and did nothing, with no
' error at all. Falls back to plain expression evaluation for anything else
' (a real address expression, VARPTR(...) call, a NATIVE/VIRTUAL literal,
' etc). isArrayRefOut is set to 1 when this resolved an array -- the caller
' must then treat the address as real process memory regardless of the
' statement's own NATIVE/VIRTUAL mode prefix, since an array's backing
' storage is never VMem sandbox memory.
Private Function ExecResolveMemcopyOperandAddr(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef addrOut As Integer, ByRef isArrayRefOut As Integer, ByRef errText As String) As Integer
    isArrayRefOut = 0
    If nodeIdx <> -1 Then
        If UCase(Trim(ps.ast.nodes(nodeIdx).kind)) = "IDENT" Then
            Dim identUpper As String
            identUpper = UCase(Trim(ps.ast.nodes(nodeIdx).value))
            Dim varIdx As Integer
            varIdx = ExecFindVar(es, identUpper)
            If varIdx <> -1 Then
                If es.vars(varIdx).isArray <> 0 Then
                    If ExecDeclTypeIsNativeScalar(es.vars(varIdx).declType) = 0 Then
                        errText = "exec: MEMCOPY array operand must be a native-scalar-typed array: " & identUpper
                        Return 0
                    End If
                    Dim arrId As Integer
                    arrId = es.vars(varIdx).arrayId
                    If arrId < 0 Or arrId >= es.arrayCount Then
                        errText = "exec: MEMCOPY array not initialized: " & identUpper
                        Return 0
                    End If
                    If es.arrays(arrId).totalElements <= 0 Then
                        errText = "exec: MEMCOPY array has no elements: " & identUpper
                        Return 0
                    End If
                    If es.arrays(arrId).isNativeScalar = 0 Then
                        errText = "exec: MEMCOPY array storage not initialized as native scalar: " & identUpper
                        Return 0
                    End If
                    addrOut = CInt(CULngInt(@es.arrays(arrId).rawData(0)))
                    isArrayRefOut = 1
                    Return 1
                End If
            End If
        End If
    End If
    addrOut = ExecEvalNode(ps, es, nodeIdx, errText)
    If errText <> "" Then Return 0
    Return 1
End Function

' modeOut is "" (no prefix, unchanged legacy default), "VIRTUAL" (unchanged),
' or "NATIVE" (S-036: now a real, supported mode -- see ExecNative* helpers
' below -- instead of the old hard "unavailable in interpreter" error).
Private Function ExecMemoryModeOffset(ByRef ps As ParseState, ByVal stmtIdx As Integer, ByRef offsetOut As Integer, ByRef modeOut As String, ByRef errText As String) As Integer
    offsetOut = 0
    modeOut = ""
    Dim firstNode As Integer = ExecChildAt(ps, stmtIdx, 0)
    If firstNode = -1 Then Return 1
    If UCase(ps.ast.nodes(firstNode).kind) = "KEYWORD_REF" Then
        Dim modeName As String = UCase(Trim(ps.ast.nodes(firstNode).value))
        If modeName = "NATIVE" Then modeOut = "NATIVE": offsetOut = 1
        If modeName = "VIRTUAL" Then modeOut = "VIRTUAL": offsetOut = 1
    End If
    ' S-069: no explicit mode -> AUTO by the address expression's static type
    ' (see UXBMemoryAddrIsPointer): pointer -> NATIVE, anything else keeps the
    ' "" default (VIRTUAL sandbox). MEMCOPY: a pointer on either side (dst or
    ' src) makes the whole statement NATIVE, same rule as MIR lowering.
    If modeOut = "" Then
        If UXBMemoryAddrIsPointer(ps, ExecChildAt(ps, stmtIdx, offsetOut)) <> 0 Then
            modeOut = "NATIVE"
        ElseIf Left(UCase(Trim(ps.ast.nodes(stmtIdx).kind)), 7) = "MEMCOPY" Then
            If UXBMemoryAddrIsPointer(ps, ExecChildAt(ps, stmtIdx, offsetOut + 1)) <> 0 Then modeOut = "NATIVE"
        End If
    End If
    Return 1
End Function

' S-159: bir ifade dugumu TYPE/STRUCT/UNION degerinin bellek konumu mu (TYPE degiskeni ya da TYPE tipli alan).
' 1 = evet (addrOut/typeOut dolu), 0 = hayir, -1 = hata (errText dolu).
Private Function ExecTypeValueLocation(ByRef ps As ParseState, ByRef es As ExecState, ByVal nodeIdx As Integer, ByRef addrOut As UInteger, ByRef typeOut As String, ByRef errText As String) As Integer
    addrOut = 0
    typeOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    Dim k As String = UCase(Trim(ps.ast.nodes(nodeIdx).kind))
    Dim candType As String = ""
    Dim candAddr As UInteger = 0
    If k = "IDENT" Or k = "IDENTIFIER" Then
        Dim vIdx As Integer = ExecFindVar(es, ps.ast.nodes(nodeIdx).value)
        If vIdx = -1 Then Return 0
        If es.vars(vIdx).isArray <> 0 Then Return 0
        candType = UCase(Trim(es.vars(vIdx).declType))
        If Left(candType, 5) = "TYPE_" Then candType = Mid(candType, 6)
        candAddr = es.vars(vIdx).addr
    ElseIf k = "FIELD_EXPR" Then
        Dim fSize As Integer, rootT As String, rootA As UInteger, pathT As String, resErr As String
        If ExecResolveFieldAccess(ps, es, nodeIdx, candAddr, candType, fSize, rootT, rootA, pathT, resErr) = 0 Then Return 0
        candType = UCase(Trim(candType))
    Else
        Return 0
    End If
    If candType = "" Or candAddr = 0 Then Return 0
    Dim recSize As Integer, recAlign As Integer, recKind As String, recAbi As String, recPack As Integer, recExplicit As Integer
    If TypeLayoutDescribeGlobal(candType, recSize, recAlign, recKind, recAbi, recPack, recExplicit) = 0 Then Return 0
    If recKind <> "TYPE" And recKind <> "STRUCT" And recKind <> "UNION" Then Return 0
    If ExecFindClassDeclNode(ps, candType) <> -1 Then Return 0
    addrOut = candAddr
    typeOut = candType
    Return 1
End Function

Private Function ExecRunAssignStmt(ByRef ps As ParseState, ByRef es As ExecState, ByRef st As ASTNode, ByRef errText As String) As Integer
    Dim lhs As Integer
    lhs = st.left
    If lhs = -1 Then
        errText = "exec: assign lhs missing"
        Return 0
    End If

    ' S-159: TYPE degerinin butun atamasi (k2 = k, a.ic = b.ic) -- deger semantigi, bayt kopyasi.
    ' STRING alanlar metin havuzu tutamaci tasir (S-158); her yeni yazim yeni tutamac aldigi icin kopya guvenli.
    Dim assignOp As String = Trim(st.op)
    If (assignOp = "" Or assignOp = "=") AndAlso st.right <> -1 Then
        Dim dstAddr As UInteger, dstType As String
        Dim srcAddr As UInteger, srcType As String
        If ExecTypeValueLocation(ps, es, lhs, dstAddr, dstType, errText) = 1 Then
            If ExecTypeValueLocation(ps, es, st.right, srcAddr, srcType, errText) = 1 Then
                If dstType <> srcType Then
                    errText = "exec: TYPE atamasi farkli tipler arasinda: " & srcType & " -> " & dstType
                    Return 0
                End If
                Dim copySize As Integer
                Dim sizeErr As String
                If TypeLayoutSizeOf(ps, dstType, copySize, sizeErr) = 0 Or copySize <= 0 Then
                    errText = "exec: TYPE boyutu bulunamadi " & dstType & " " & sizeErr
                    Return 0
                End If
                If srcAddr <> dstAddr Then
                    If VMemCopyB(srcAddr, dstAddr, CUInt(copySize)) = 0 Then
                        errText = "exec: TYPE kopyasi bellek disi"
                        Return 0
                    End If
                End If
                Return 1
            End If
        End If
        errText = ""
    End If

    Dim rhsValue As ExecValue
    If ExecEvalExpression(ps, st.right, es, rhsValue, errText) = 0 Then Return 0

    Dim curValue As ExecValue
    Dim targetName As String
    Dim targetIdx As Integer
    Dim arrayVarIdx As Integer
    Dim arrayElemIdx As Integer
    Dim isArrayTarget As Integer
    Dim isImplicitFieldTarget As Integer
    isArrayTarget = 0
    isImplicitFieldTarget = 0

    If UCase(ps.ast.nodes(lhs).kind) = "IDENT" Or UCase(ps.ast.nodes(lhs).kind) = "KEYWORD_REF" Then
        targetName = ps.ast.nodes(lhs).value
        If ExecGetVarValue(es, targetName, curValue) = 0 Then
            Dim implicitReadFound As Integer
            If ExecTryReadImplicitThisField(ps, es, targetName, implicitReadFound, curValue, errText) = 0 Then Return 0
            If implicitReadFound <> 0 Then
                isImplicitFieldTarget = 1
            Else
                ExecValueInit curValue
            End If
        End If
    ElseIf ExecTryResolveArrayAccess(ps, es, lhs, arrayVarIdx, arrayElemIdx, errText) <> 0 Then
        If arrayVarIdx < 0 Then Return 0
        isArrayTarget = 1
        targetName = es.vars(arrayVarIdx).nameText
        If ExecGetArrayElement(es, arrayVarIdx, arrayElemIdx, curValue) = 0 Then
            If errText = "" Then errText = "exec: array element read failed"
            Return 0
        End If
    ElseIf UCase(ps.ast.nodes(lhs).kind) = "FIELD_EXPR" Then
        If ExecReadFieldValue(ps, es, lhs, curValue, errText) = 0 Then Return 0
        targetName = "__FIELD__"
    Else
        If errText = "" Then errText = "exec: assign lhs must be ident, indexed array, or field"
        Return 0
    End If

    Dim opText As String
    opText = Trim(st.op)
    If opText = "" Then opText = "="

    Dim outValue As ExecValue

    ' S-077: integer compound assignment goes through the same 64-bit binary
    ' implementation as the expression operators. The old inline code read both
    ' sides through ExecValueToInteger, which saturates at 32 bits (so `big64 += 1`
    ' on a value >= 2^31 collapsed to 2147483648) and used 31-masked 32-bit shifts.
    Dim compoundHandled As Integer
    compoundHandled = 0
    If ExecIsIntegerClass(curValue) <> 0 And ExecIsIntegerClass(rhsValue) <> 0 Then
        Dim compoundBaseOp As String
        compoundBaseOp = ""
        Select Case opText
        Case "+=": compoundBaseOp = "+"
        Case "-=": compoundBaseOp = "-"
        Case "*=": compoundBaseOp = "*"
        Case "\=": compoundBaseOp = "\"
        Case "%=": compoundBaseOp = "MOD"
        Case "&=": compoundBaseOp = "AND"
        Case "|=": compoundBaseOp = "OR"
        Case "^=": compoundBaseOp = "XOR"
        Case "<<=": compoundBaseOp = "<<"
        Case ">>=": compoundBaseOp = ">>"
        End Select
        If compoundBaseOp <> "" Then
            Dim compoundU64Flags As Integer
            compoundU64Flags = 0
            If curValue.valueType = "U64_PTR" Or rhsValue.valueType = "U64_PTR" Then
                If UXBExprIsU64(ps, lhs) <> 0 Then compoundU64Flags = 3
                If UXBExprIsU64(ps, st.right) <> 0 Then compoundU64Flags = compoundU64Flags Or 1
            End If
            Dim compoundRc As Integer
            compoundRc = ExecEvalBinaryInt64(curValue, rhsValue, compoundBaseOp, compoundU64Flags, outValue, errText)
            If compoundRc = 0 Then Return 0
            If compoundRc > 0 Then compoundHandled = 1
        End If
    End If

    If compoundHandled = 0 Then
    Select Case opText
    Case "="
        outValue = rhsValue
    Case "+="
        If curValue.valueType = "FLOAT" Or rhsValue.valueType = "FLOAT" Then
            ExecValueSetFloat outValue, ExecValueToFloat(curValue) + ExecValueToFloat(rhsValue)
        Else
            ExecValueSetInteger outValue, ExecValueToInteger(curValue) + ExecValueToInteger(rhsValue)
        End If
    Case "-="
        If curValue.valueType = "FLOAT" Or rhsValue.valueType = "FLOAT" Then
            ExecValueSetFloat outValue, ExecValueToFloat(curValue) - ExecValueToFloat(rhsValue)
        Else
            ExecValueSetInteger outValue, ExecValueToInteger(curValue) - ExecValueToInteger(rhsValue)
        End If
    Case "*="
        If curValue.valueType = "FLOAT" Or rhsValue.valueType = "FLOAT" Then
            ExecValueSetFloat outValue, ExecValueToFloat(curValue) * ExecValueToFloat(rhsValue)
        Else
            ExecValueSetInteger outValue, ExecValueToInteger(curValue) * ExecValueToInteger(rhsValue)
        End If
    Case "**="
        If curValue.valueType = "FLOAT" Or rhsValue.valueType = "FLOAT" Then
            ExecValueSetFloat outValue, ExecValueToFloat(curValue) ^ ExecValueToFloat(rhsValue)
        Else
            Dim assignPowExp As Integer
            Dim assignPowBase As Integer
            Dim assignPowValue As Integer
            Dim assignPowIndex As Integer
            assignPowBase = ExecValueToInteger(curValue)
            assignPowExp = ExecValueToInteger(rhsValue)
            If assignPowExp < 0 Then
                errText = "exec: negative integer exponent in **="
                Return 0
            End If
            assignPowValue = 1
            For assignPowIndex = 1 To assignPowExp
                assignPowValue *= assignPowBase
            Next assignPowIndex
            ExecValueSetInteger outValue, assignPowValue
        End If
    Case "/="
        If ExecValueToFloat(rhsValue) = 0.0 Then
            errText = "exec: division by zero"
            Return 0
        End If
        ExecValueSetFloat outValue, ExecValueToFloat(curValue) / ExecValueToFloat(rhsValue)
    Case "\="
        If ExecValueToInteger(rhsValue) = 0 Then
            errText = "exec: integer division by zero"
            Return 0
        End If
        ExecValueSetInteger outValue, ExecValueToInteger(curValue) \ ExecValueToInteger(rhsValue)
    Case "%="
        Dim modRhs As Integer
        modRhs = ExecValueToInteger(rhsValue)
        If modRhs = 0 Then
            errText = "exec: modulo by zero"
            Return 0
        End If
        If curValue.valueType = "FLOAT" Or rhsValue.valueType = "FLOAT" Then
            Dim modLhsFloat As Double
            Dim modRhsFloat As Double
            modLhsFloat = ExecValueToFloat(curValue)
            modRhsFloat = ExecValueToFloat(rhsValue)
            ExecValueSetFloat outValue, CDbl(CLngInt(modLhsFloat) Mod CLngInt(modRhsFloat))
        Else
            ExecValueSetInteger outValue, ExecValueToInteger(curValue) Mod modRhs
        End If
    Case "&="
        ExecValueSetInteger outValue, ExecValueToInteger(curValue) And ExecValueToInteger(rhsValue)
    Case "|="
        ExecValueSetInteger outValue, ExecValueToInteger(curValue) Or ExecValueToInteger(rhsValue)
    Case "^="
        ExecValueSetInteger outValue, ExecValueToInteger(curValue) Xor ExecValueToInteger(rhsValue)
    Case "<<="
        ExecValueSetInteger outValue, CInt(CUInt(ExecValueToInteger(curValue)) Shl (ExecValueToInteger(rhsValue) And 31))
    Case ">>="
        Dim shiftAssignType As String
        shiftAssignType = UCase(Trim(ps.ast.nodes(lhs).typeName))
        Dim shiftAssignVarIdx As Integer
        shiftAssignVarIdx = ExecFindVar(es, targetName)
        If shiftAssignVarIdx <> -1 Then shiftAssignType = UCase(Trim(es.vars(shiftAssignVarIdx).declType))
        If Left(shiftAssignType, 5) = "TYPE_" Then shiftAssignType = Mid(shiftAssignType, 6)
        Select Case shiftAssignType
        Case "U8", "U16", "U32", "U64", "UBYTE", "USHORT", "UINTEGER", "UINT", "ULONG", "ULONGINT"
            ExecValueSetInteger outValue, CInt(CUInt(ExecValueToInteger(curValue)) Shr (ExecValueToInteger(rhsValue) And 31))
        Case Else
            ExecValueSetInteger outValue, ExecSar32(ExecValueToInteger(curValue), ExecValueToInteger(rhsValue))
        End Select
    Case "ROL="
        ExecValueSetInteger outValue, CInt(ExecRol32(CUInt(ExecValueToInteger(curValue)), ExecValueToInteger(rhsValue)))
    Case "ROR="
        ExecValueSetInteger outValue, CInt(ExecRor32(CUInt(ExecValueToInteger(curValue)), ExecValueToInteger(rhsValue)))
    Case "=+"
        outValue = rhsValue
    Case "=-"
        If rhsValue.valueType = "FLOAT" Then
            ExecValueSetFloat outValue, -ExecValueToFloat(rhsValue)
        Else
            ExecValueSetInteger outValue, -ExecValueToInteger(rhsValue)
        End If
    Case Else
        errText = "exec: unsupported assign op " & opText
        Return 0
    End Select
    End If

    If UCase(ps.ast.nodes(lhs).kind) = "FIELD_EXPR" Then
        If ExecWriteFieldValue(ps, es, lhs, outValue, errText) = 0 Then Return 0
    ElseIf isImplicitFieldTarget <> 0 Then
        Dim implicitWriteFound As Integer
        If ExecTryWriteImplicitThisField(ps, es, targetName, outValue, implicitWriteFound, errText) = 0 Then Return 0
        If implicitWriteFound = 0 Then
            errText = "exec: implicit field disappeared: " & targetName
            Return 0
        End If
    ElseIf isArrayTarget <> 0 Then
        If ExecSetArrayElement(es, arrayVarIdx, arrayElemIdx, outValue) = 0 Then
            errText = "exec: array element write failed"
            Return 0
        End If
    Else
        ExecSetVarValue es, targetName, outValue

        ' UXB_TYPED_TASK_ROUTINES_20260728: PIPE name and OUTPUT are two local
        ' aliases for the same result cell.  Synchronizing at assignment time
        ' gives a deterministic "last assignment wins" rule without making
        ' either spelling mandatory.
        If es.runtime.currentRoutineNodeIdx >= 0 And es.runtime.currentRoutineNodeIdx < ps.ast.count Then
            If UCase(Trim(ps.ast.nodes(es.runtime.currentRoutineNodeIdx).kind)) = "PIPE_STMT" Then
                Dim pipeRoutineName As String
                pipeRoutineName = UCase(Trim(ps.ast.nodes(es.runtime.currentRoutineNodeIdx).value))
                Dim assignedName As String
                assignedName = UCase(Trim(targetName))
                If assignedName = UXB_TASK_RESULT_NAME Then
                    ExecSetVarValue es, pipeRoutineName, outValue
                ElseIf assignedName = pipeRoutineName Then
                    ExecSetVarValue es, UXB_TASK_RESULT_NAME, outValue
                End If
            End If
        End If
    End If

    targetIdx = ExecFindVar(es, targetName)
    If targetIdx <> -1 Then
        Dim targetDeclType As String
        targetDeclType = UCase(Trim(es.vars(targetIdx).declType))
        Dim isClassLikeTarget As Integer
        isClassLikeTarget = 0
        If targetDeclType = "OBJECT" Then
            isClassLikeTarget = 1
        ElseIf targetDeclType <> "" And ExecFindClassDeclNode(ps, targetDeclType) <> -1 Then
            isClassLikeTarget = 1
        ElseIf targetDeclType <> "" And ExecFindInterfaceDeclNode(ps, targetDeclType) <> -1 Then
            isClassLikeTarget = 1
        End If

        If isClassLikeTarget <> 0 And es.vars(targetIdx).isArray = 0 Then
            If opText <> "=" Then
                errText = "exec: class assignment only supports ="
                Return 0
            End If

            If st.right <> -1 And UCase(ps.ast.nodes(st.right).kind) = "NEW_EXPR" Then
                Dim rhsNewType As String
                rhsNewType = UCase(Trim(ps.ast.nodes(st.right).value))
                If ExecCanAssignClassType(ps, targetDeclType, rhsNewType) = 0 Then
                    errText = "exec: class assignment type mismatch expected=" & targetDeclType & " actual=" & rhsNewType
                    Return 0
                End If
                es.vars(targetIdx).runtimeClassType = rhsNewType
            ElseIf ExecValueToInteger(outValue) = 0 Then
                es.vars(targetIdx).runtimeClassType = ""
            ElseIf ExecFindInterfaceDeclNode(ps, targetDeclType) <> -1 Then
                Dim inferredAssignType As String
                inferredAssignType = ""
                If ExecTryResolveRuntimeClassByObjectAddr(ps, es, CUInt(ExecValueToInteger(outValue)), inferredAssignType) <> 0 Then
                    If ExecCanAssignClassType(ps, targetDeclType, inferredAssignType) = 0 Then
                        errText = "exec: interface assignment type mismatch expected=" & targetDeclType & " actual=" & inferredAssignType
                        Return 0
                    End If
                    es.vars(targetIdx).runtimeClassType = inferredAssignType
                Else
                    errText = "exec: interface assignment runtime type unresolved " & targetDeclType
                    Return 0
                End If
            ElseIf targetDeclType <> "OBJECT" Then
                ' S-037: `a = d` (a AS Animal, d AS Dog) shares d's object, so its RUNTIME class
                ' is the object's own class (Dog), not a's declared type: the runtime class
                ' drives virtual dispatch (`a.Speak()` must run Dog's override). Only `= NEW X`
                ' used to record the real class; every other source pinned it to the target's
                ' declared type. Ask the object, like the interface branch above does.
                Dim inferredClassType As String
                inferredClassType = ""
                If ExecTryResolveRuntimeClassByObjectAddr(ps, es, CUInt(ExecValueToInteger(outValue)), inferredClassType) <> 0 Then
                    If ExecCanAssignClassType(ps, targetDeclType, inferredClassType) = 0 Then
                        errText = "exec: class assignment type mismatch expected=" & targetDeclType & " actual=" & inferredClassType
                        Return 0
                    End If
                    es.vars(targetIdx).runtimeClassType = inferredClassType
                Else
                    es.vars(targetIdx).runtimeClassType = targetDeclType
                End If
            End If

            ExecSetVarAddr es, targetName, CUInt(ExecValueToInteger(outValue))
        End If
    End If

    Return 1
End Function

Private Function ExecRunIncDecStmt(ByRef ps As ParseState, ByRef es As ExecState, ByRef st As ASTNode, ByRef errText As String) As Integer
    Dim lhs2 As Integer
    lhs2 = st.left
    If lhs2 = -1 Then
        errText = "exec: inc/dec target missing"
        Return 0
    End If

    Dim curVal As Integer
    Dim nextValue As ExecValue
    Dim incFullValue As ExecValue
    Dim incHaveFull As Integer
    Dim arrayVarIdx2 As Integer
    Dim arrayElemIdx2 As Integer
    incHaveFull = 0
    If UCase(ps.ast.nodes(lhs2).kind) = "IDENT" Then
        curVal = ExecGetVar(es, ps.ast.nodes(lhs2).value)
        If ExecGetVarValue(es, ps.ast.nodes(lhs2).value, incFullValue) <> 0 Then incHaveFull = 1
    ElseIf ExecTryResolveArrayAccess(ps, es, lhs2, arrayVarIdx2, arrayElemIdx2, errText) <> 0 Then
        If ExecGetArrayElement(es, arrayVarIdx2, arrayElemIdx2, nextValue) = 0 Then
            If errText = "" Then errText = "exec: inc/dec array read failed"
            Return 0
        End If
        curVal = ExecValueToInteger(nextValue)
        incFullValue = nextValue
        incHaveFull = 1
    ElseIf UCase(ps.ast.nodes(lhs2).kind) = "FIELD_EXPR" Then
        If ExecReadFieldValue(ps, es, lhs2, nextValue, errText) = 0 Then Return 0
        curVal = ExecValueToInteger(nextValue)
        incFullValue = nextValue
        incHaveFull = 1
    Else
        If errText = "" Then errText = "exec: inc/dec target must be ident, indexed array, or field"
        Return 0
    End If

    If st.op <> "++" And st.op <> "--" Then
        errText = "exec: unknown inc/dec op"
        Return 0
    End If

    ' S-077: ++/-- on a machine integer uses the same 64-bit implementation as
    ' `+= 1` (ExecGetVar/ExecValueToInteger saturate at 32 bits, so a U64/I64
    ' counter above 2^31 stalled, and 0 - 1 on a U64 stayed a signed -1).
    Dim incDone As Integer
    incDone = 0
    If incHaveFull <> 0 Then
        If ExecIsIntegerClass(incFullValue) <> 0 Then
            Dim incOne As ExecValue
            Dim incFlags As Integer
            ExecValueSetInteger incOne, 1
            incFlags = 0
            If incFullValue.valueType = "U64_PTR" Then
                If UXBExprIsU64(ps, lhs2) <> 0 Then incFlags = 3
            End If
            If ExecEvalBinaryInt64(incFullValue, incOne, IIf(st.op = "++", "+", "-"), incFlags, nextValue, errText) = 0 Then Return 0
            incDone = 1
        End If
    End If
    If incDone = 0 Then
        If st.op = "++" Then
            ExecValueSetInteger nextValue, curVal + 1
        Else
            ExecValueSetInteger nextValue, curVal - 1
        End If
    End If

    If UCase(ps.ast.nodes(lhs2).kind) = "IDENT" Then
        If incDone <> 0 Then
            ExecSetVarValue es, ps.ast.nodes(lhs2).value, nextValue
        Else
            ExecSetVar es, ps.ast.nodes(lhs2).value, nextValue.intValue
        End If
    ElseIf UCase(ps.ast.nodes(lhs2).kind) = "FIELD_EXPR" Then
        If ExecWriteFieldValue(ps, es, lhs2, nextValue, errText) = 0 Then Return 0
    Else
        If ExecSetArrayElement(es, arrayVarIdx2, arrayElemIdx2, nextValue) = 0 Then
            errText = "exec: inc/dec array write failed"
            Return 0
        End If
    End If

    Return 1
End Function

Private Function ExecRunRandomizeStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim randomizeCount As Integer
    randomizeCount = ExecChildCount(ps, stmtIdx)

    ' S-163: tum motorlarda ayni uretec (src/common/uxb_rng.fbs), gorev basina durum.
    If randomizeCount = 0 Then
        UXBRngRandomizeTime ExecCurrentTaskKey()
        Return 1
    End If

    Dim seedExpr As Integer
    seedExpr = ExecChildAt(ps, stmtIdx, 0)
    If seedExpr = -1 Then
        errText = "exec: RANDOMIZE seed missing"
        Return 0
    End If

    Dim seedValue As Integer
    seedValue = ExecEvalNode(ps, es, seedExpr, errText)
    If errText <> "" Then Return 0

    UXBRngRandomize ExecCurrentTaskKey(), seedValue
    Return 1
End Function

Private Function ExecRunPokeBStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim modeOffset As Integer
    Dim memMode As String
    If ExecMemoryModeOffset(ps, stmtIdx, modeOffset, memMode, errText) = 0 Then Return 0
    Dim pb0 As Integer
    Dim pb1 As Integer
    pb0 = ExecChildAt(ps, stmtIdx, modeOffset)
    pb1 = ExecChildAt(ps, stmtIdx, modeOffset + 1)
    If pb0 = -1 Or pb1 = -1 Then
        errText = "exec: POKEB args missing"
        Return 0
    End If

    Dim pbAddr As Integer
    Dim pbVal As Integer
    pbAddr = ExecEvalNode(ps, es, pb0, errText)
    If errText <> "" Then Return 0
    pbVal = ExecEvalNode(ps, es, pb1, errText)
    If errText <> "" Then Return 0

    If memMode = "NATIVE" Then
        If ExecNativePokeB(CUInt(pbAddr), pbVal) = 0 Then
            errText = "exec: NATIVE POKEB out of range" & UXBMemRefReason()
            Return 0
        End If
        Return 1
    End If

    If VMemPokeB(CUInt(pbAddr), pbVal) = 0 Then
        errText = "exec: POKEB out of range"
        Return 0
    End If

    Return 1
End Function

Private Function ExecRunPokeWStmt(ByRef ps As ParseState, ByRef es As ExecState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
