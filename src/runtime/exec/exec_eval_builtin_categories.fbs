Private Function ExecEvalDllCallCore(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef dllName As String, ByRef symbolName As String, ByRef signatureText As String, ByRef callingConventionText As String, ByVal argStartPos As Integer, ByRef errText As String) As Integer
    Dim ffiArgCount As Integer
    ffiArgCount = ExecChildCount(ps, callNodeIdx)

    Dim effectiveArgStartPos As Integer
    effectiveArgStartPos = argStartPos

    Dim mixedArgTypes(0 To 15) As String
    Dim mixedArgTypeCount As Integer
    Dim mixedTypeStatus As Integer
    mixedTypeStatus = ExecTryReadDllArgTypeList(ps, callNodeIdx, argStartPos, ffiArgCount, mixedArgTypes(), mixedArgTypeCount, errText)
    If mixedTypeStatus < 0 Then Return 0
    If mixedTypeStatus > 0 Then effectiveArgStartPos = argStartPos + 1

    If signatureText = "BYREF" Then
        Dim byrefNode As Integer
        byrefNode = ExecChildAt(ps, callNodeIdx, effectiveArgStartPos)
        If byrefNode = -1 Or UCase(ps.ast.nodes(byrefNode).kind) <> "IDENT" Then
            errText = "exec: CALL(DLL) BYREF requires addressable target argument (" & LTrim(Str(UXB_FFI_ERR_BYREF_TARGET)) & ")"
            Return 0
        End If
    End If

    Dim ai As Integer
    For ai = effectiveArgStartPos To ffiArgCount - 1
        Dim argNode As Integer
        argNode = ExecChildAt(ps, callNodeIdx, ai)
        If argNode = -1 Then
            errText = "exec: CALL(DLL) argument missing"
            Return 0
        End If

        Dim argSig As String
        If mixedTypeStatus > 0 Then
            argSig = mixedArgTypes(ai - effectiveArgStartPos)
        Else
            ' Legacy calls without an ABI10 type list are integer calls.  The
            ' return signature describes the result, never the argument types.
            argSig = "I32"
        End If

        If ExecValidateDllMarshalArg(ps, es, argNode, argSig, errText) = 0 Then Return 0
    Next ai

    Dim denyReason As String
    Dim allowDecision As Integer
    Dim requireAttestation As Integer
    Dim ffiMode As String
    ffiMode = ExecGetFfiPolicyMode()
    requireAttestation = IIf(ffiMode = "ENFORCE", 1, 0)
    allowDecision = ExecDllCallIsAllowlisted(dllName, symbolName, signatureText, callingConventionText, requireAttestation, denyReason)
    ExecAuditDllPolicy dllName, symbolName, signatureText, callingConventionText, ffiMode, allowDecision, denyReason

    If allowDecision = 0 And ffiMode = "ENFORCE" Then
        If denyReason = "deny-policy-load-failed" Then
            errText = "exec: CALL(DLL) denied by policy load failed (" & LTrim(Str(UXB_FFI_ERR_POLICY_LOAD_FAILED)) & ")"
            Return 0
        End If
        If denyReason = "deny-attestation-required" Then
            errText = "exec: CALL(DLL) denied by policy attestation required (" & LTrim(Str(UXB_FFI_ERR_POLICY_ATTEST_REQUIRED)) & ")"
            Return 0
        End If
        If denyReason = "deny-hash-extract-failed" Then
            errText = "exec: CALL(DLL) denied by policy hash extraction failed (" & LTrim(Str(UXB_FFI_ERR_POLICY_HASH_EXTRACT_FAILED)) & ")"
            Return 0
        End If
        If denyReason = "deny-hash-mismatch" Then
            errText = "exec: CALL(DLL) denied by policy hash mismatch (" & LTrim(Str(UXB_FFI_ERR_POLICY_HASH_MISMATCH)) & ")"
            Return 0
        End If
        If denyReason = "deny-signer-extract-failed" Then
            errText = "exec: CALL(DLL) denied by policy signer extraction failed (" & LTrim(Str(UXB_FFI_ERR_POLICY_SIGNER_EXTRACT_FAILED)) & ")"
            Return 0
        End If
        If denyReason = "deny-signer-mismatch" Then
            errText = "exec: CALL(DLL) denied by policy signer mismatch (" & LTrim(Str(UXB_FFI_ERR_POLICY_SIGNER_MISMATCH)) & ")"
            Return 0
        End If
        errText = "exec: CALL(DLL) denied by policy (" & LTrim(Str(UXB_FFI_ERR_POLICY_DENY)) & ")"
        Return 0
    End If

    Dim resolverMode As String
    resolverMode = ExecGetFfiResolverMode()

    Dim ffiArgRuntimeCount As Integer
    ffiArgRuntimeCount = ffiArgCount - effectiveArgStartPos
    If ffiArgRuntimeCount < 0 Then ffiArgRuntimeCount = 0
    If ffiArgRuntimeCount > 10 Then
        errText = "exec: CALL(DLL/API) ABI10 supports at most 10 runtime arguments (" & LTrim(Str(UXB_FFI_ERR_BAD_ARITY)) & ")"
        Return 0
    End If

    If ExecGetActiveFfiAbiName() = "WIN64-MSABI" Then
        Dim x64InvokedValue As Integer
        Dim x64InvokedOut As Integer
        Dim x64InvokeErr As String
        Dim useAbi10Bridge As Integer
        useAbi10Bridge = 0

        ' ABI10 / typed CALL(DLL) route:
        ' The legacy x64 direct path returns only Integer and therefore corrupts
        ' typed no-argument calls such as STRPTR/F64/PTR returns.  Route all
        ' explicit mixed calls and all typed zero-argument calls through the
        ' uxffi_invoke10 bridge so gExecLastCallValueEx preserves STRING/F64/PTR.
        If mixedTypeStatus > 0 Then
            useAbi10Bridge = 1
        ElseIf ffiArgRuntimeCount = 0 Then
            useAbi10Bridge = 1
        ElseIf UCase(Trim(signatureText)) = "STRPTR" Or UCase(Trim(signatureText)) = "PTR" Or UCase(Trim(signatureText)) = "F64" Or UCase(Trim(signatureText)) = "VOID" Then
            useAbi10Bridge = 1
        End If

        If useAbi10Bridge <> 0 Then
            If mixedTypeStatus = 0 Then
                Dim abi10FillIdx As Integer
                For abi10FillIdx = 0 To ffiArgRuntimeCount - 1
                    mixedArgTypes(abi10FillIdx) = "I32"
                Next abi10FillIdx
            End If

            If ExecTryInvokeResolvedX64Mixed(ps, es, callNodeIdx, effectiveArgStartPos, dllName, symbolName, signatureText, callingConventionText, mixedArgTypes(), ffiArgRuntimeCount, x64InvokedValue, x64InvokedOut, x64InvokeErr) = 0 Then
                errText = x64InvokeErr
                If errText = "" Then errText = "exec: CALL(DLL/API) x64 ABI10 invocation failed"
                Return 0
            End If
        ElseIf ExecTryInvokeResolvedX64I32(ps, es, callNodeIdx, effectiveArgStartPos, dllName, symbolName, signatureText, callingConventionText, ffiArgRuntimeCount, x64InvokedValue, x64InvokedOut, x64InvokeErr) = 0 Then
            errText = x64InvokeErr
            If errText = "" Then errText = "exec: CALL(DLL/API) x64 invocation failed"
            Return 0
        End If

        If x64InvokedOut <> 0 Then
            Return x64InvokedValue
        End If

        Return 0
    End If

    Dim cleanupType As String
    Dim resolverErr As String
        If ExecResolveX86InteropTarget(dllName, symbolName, signatureText, callingConventionText, ffiArgRuntimeCount, cleanupType, resolverErr) = 0 Then
            If resolverMode = "ENFORCE" Then
                errText = resolverErr
                Return 0
            End If
            If resolverErr <> "" Then UxbWarn "FFI x86 resolver fallback: " & resolverErr

            Dim directInvokedValue As Integer
            Dim directInvokedOut As Integer
            Dim directInvokeErr As String
            If ExecTryInvokeDirectX86I32(ps, es, callNodeIdx, effectiveArgStartPos, dllName, symbolName, signatureText, callingConventionText, ffiArgRuntimeCount, directInvokedValue, directInvokedOut, directInvokeErr) = 0 Then
                errText = directInvokeErr
                If errText = "" Then errText = "exec: CALL(DLL/API) x86 direct invocation failed"
                Return 0
            ElseIf directInvokedOut <> 0 Then
                Return directInvokedValue
            End If
        Else
            UxbInfo "FFI x86 resolver matched cleanup=" & cleanupType & " args=" & LTrim(Str(ffiArgRuntimeCount))

        Dim invokedValue As Integer
        Dim invokedOut As Integer
        Dim invokeErr As String
            If ExecTryInvokeResolvedX86I32(ps, es, callNodeIdx, effectiveArgStartPos, dllName, symbolName, signatureText, callingConventionText, ffiArgRuntimeCount, invokedValue, invokedOut, invokeErr) = 0 Then
                errText = invokeErr
                If errText = "" Then errText = "exec: CALL(DLL/API) x86 invocation failed"
                Return 0
            ElseIf invokedOut <> 0 Then
                Return invokedValue
            End If
        End If

        errText = "exec: CALL(DLL/API) invoke path unavailable signature=" & UCase(Trim(signatureText)) & " args=" & LTrim(Str(ffiArgRuntimeCount))
        Return 0
End Function

Private Function ExecEvalBuiltinFfiCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim callKey As String
    callKey = UCase(Trim(callName))

    Select Case callKey
    Case "DLL", "API", "CALL"
        Dim ffiArgCount As Integer
        ffiArgCount = ExecChildCount(ps, callNodeIdx)
        Dim ffiBasePos As Integer
        ffiBasePos = 0
        Dim callMarker As String
        callMarker = callKey
        If callKey = "CALL" Then
            Dim markerNode As Integer
            markerNode = ExecChildAt(ps, callNodeIdx, 0)
            If markerNode = -1 Then
                errText = "exec: unsupported call CALL"
                Return 0
            End If
            callMarker = UCase(Trim(ps.ast.nodes(markerNode).value))
            If callMarker <> "DLL" And callMarker <> "API" Then
                errText = "exec: unsupported call CALL"
                Return 0
            End If
            ffiBasePos = 1
        End If

        If ffiArgCount < ffiBasePos + 3 Then
            errText = "exec: CALL(DLL) requires library, symbol and return signature (" & LTrim(Str(UXB_FFI_ERR_BAD_ARITY)) & ")"
            Return 0
        End If

        Dim dllNode As Integer
        dllNode = ExecChildAt(ps, callNodeIdx, ffiBasePos)
        If dllNode = -1 Or UCase(ps.ast.nodes(dllNode).kind) <> "STRING" Then
            errText = "exec: CALL(DLL) library must be string literal (" & LTrim(Str(UXB_FFI_ERR_BAD_LIB)) & ")"
            Return 0
        End If

        Dim dllNameRaw As String
        dllNameRaw = Trim(ps.ast.nodes(dllNode).value)
        If callMarker = "API" And InStr(dllNameRaw, ".") = 0 Then dllNameRaw &= ".dll"

        Dim dllName As String
        If ExecNormalizeDllName(dllNameRaw, dllName, errText) = 0 Then
            Return 0
        End If

        Dim symbolNode As Integer
        symbolNode = ExecChildAt(ps, callNodeIdx, ffiBasePos + 1)
        If symbolNode = -1 Or UCase(ps.ast.nodes(symbolNode).kind) <> "STRING" Then
            errText = "exec: CALL(DLL) symbol must be string literal (" & LTrim(Str(UXB_FFI_ERR_BAD_SYMBOL)) & ")"
            Return 0
        End If

        Dim symbolName As String
        symbolName = Trim(ps.ast.nodes(symbolNode).value)
        If symbolName = "" Then
            errText = "exec: CALL(DLL) symbol cannot be empty (" & LTrim(Str(UXB_FFI_ERR_BAD_SYMBOL)) & ")"
            Return 0
        End If

        Dim sigNode As Integer
        sigNode = ExecChildAt(ps, callNodeIdx, ffiBasePos + 2)
        If sigNode = -1 Then
            errText = "exec: CALL(DLL) signature token missing (" & LTrim(Str(UXB_FFI_ERR_BAD_SIGNATURE)) & ")"
            Return 0
        End If
        Dim signatureKind As String
        signatureKind = UCase(Trim(ps.ast.nodes(sigNode).kind))
        If signatureKind <> "KEYWORD_REF" And signatureKind <> "IDENT" And signatureKind <> "IDENTIFIER" And signatureKind <> "TYPE_REF" And signatureKind <> "VAR_REF" Then
            errText = "exec: CALL(DLL) signature token must be a type name (" & LTrim(Str(UXB_FFI_ERR_BAD_SIGNATURE)) & ")"
            Return 0
        End If

        Dim signatureText As String
        signatureText = UCase(Trim(ps.ast.nodes(sigNode).value))
        If ExecIsAllowedDllSignature(signatureText) = 0 Then
            errText = "exec: CALL(DLL) invalid signature token " & signatureText & " (" & LTrim(Str(UXB_FFI_ERR_BAD_SIGNATURE)) & ")"
            Return 0
        End If

        Dim callingConventionText As String
        callingConventionText = "CDECL"

        Dim argStartPos As Integer
        argStartPos = ffiBasePos + 3

        If ffiArgCount >= ffiBasePos + 4 Then
            Dim convNode As Integer
            convNode = ExecChildAt(ps, callNodeIdx, ffiBasePos + 3)
            If convNode <> -1 Then
                Dim convKind As String
                convKind = UCase(Trim(ps.ast.nodes(convNode).kind))
                Dim convCandidate As String
                convCandidate = UCase(Trim(ps.ast.nodes(convNode).value))
                If (convKind = "KEYWORD_REF" Or convKind = "IDENT" Or convKind = "IDENTIFIER" Or convKind = "TYPE_REF" Or convKind = "VAR_REF") And ExecIsDllCallingConvention(convCandidate) <> 0 Then
                    callingConventionText = convCandidate
                    argStartPos = ffiBasePos + 4
                ElseIf convKind = "KEYWORD_REF" Then
                    errText = "exec: CALL(DLL) invalid calling convention token " & convCandidate & " (" & LTrim(Str(UXB_FFI_ERR_BAD_SIGNATURE)) & ")"
                    Return 0
                End If
            End If
        End If

        Return ExecEvalDllCallCore(ps, es, callNodeIdx, dllName, symbolName, signatureText, callingConventionText, argStartPos, errText)
    End Select

    errText = "exec: unsupported call " & callKey
    Return 0
End Function

Private Function ExecCollectionGetHandleArg(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef callName As String, ByVal argPos As Integer, ByRef handleOut As Integer, ByRef errText As String) As Integer
    Dim nodeIdx As Integer
    nodeIdx = ExecChildAt(ps, callNodeIdx, argPos)
    If nodeIdx = -1 Then
        errText = "exec: " & callName & " handle arg missing"
        Return 0
    End If

    handleOut = ExecEvalNode(ps, es, nodeIdx, errText)
    If errText <> "" Then Return 0
    Return 1
End Function

Private Function ExecCollectionGetIntArg(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef callName As String, ByVal argPos As Integer, ByRef intOut As Integer, ByRef errText As String) As Integer
    Dim nodeIdx As Integer
    nodeIdx = ExecChildAt(ps, callNodeIdx, argPos)
    If nodeIdx = -1 Then
        errText = "exec: " & callName & " integer arg missing"
        Return 0
    End If

    intOut = ExecEvalNode(ps, es, nodeIdx, errText)
    If errText <> "" Then Return 0
    Return 1
End Function

Private Function ExecCollectionGetTextArg(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef callName As String, ByVal argPos As Integer, ByRef textOut As String, ByRef errText As String) As Integer
    Dim nodeIdx As Integer
    nodeIdx = ExecChildAt(ps, callNodeIdx, argPos)
    If nodeIdx = -1 Then
        errText = "exec: " & callName & " text arg missing"
        Return 0
    End If

    If ExecEvalNodeAsText(ps, es, nodeIdx, textOut, errText) = 0 Then Return 0
    Return 1
End Function

Private Function ExecCollectionGetValueArg(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef callName As String, ByVal argPos As Integer, ByRef valueOut As ExecValue, ByRef errText As String) As Integer
    Dim nodeIdx As Integer
    nodeIdx = ExecChildAt(ps, callNodeIdx, argPos)
    If nodeIdx = -1 Then
        errText = "exec: " & callName & " value arg missing"
        Return 0
    End If

    If ExecEvalExpression(ps, nodeIdx, es, valueOut, errText) = 0 Then Return 0
    Return 1
End Function

Private Function ExecEvalBuiltinCollectionList(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim argc As Integer
    argc = ExecChildCount(ps, callNodeIdx)

    Select Case callName
    Case "LIST_NEW"
        If argc <> 0 Then
            errText = "exec: LIST_NEW expects 0 arguments"
            Return 0
        End If
        Return ExecCollectionCreate("LIST")

    Case "LISTLEN"
        If argc <> 1 Then
            errText = "exec: LISTLEN expects 1 argument"
            Return 0
        End If

        Dim listHandleLen As Integer
        Dim listLen As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, listHandleLen, errText) = 0 Then Return 0
        If ExecListLen(listHandleLen, listLen, errText) = 0 Then Return 0
        Return listLen

    Case "LISTGET"
        If argc <> 2 Then
            errText = "exec: LISTGET expects 2 arguments"
            Return 0
        End If

        Dim listHandleGet As Integer
        Dim listIndexGet As Integer
        Dim listValue As ExecValue
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, listHandleGet, errText) = 0 Then Return 0
        If ExecCollectionGetIntArg(ps, es, callNodeIdx, callName, 1, listIndexGet, errText) = 0 Then Return 0
        If ExecListGet(listHandleGet, listIndexGet, listValue, errText) = 0 Then Return 0
        Return ExecValueToInteger(listValue)

    Case "LISTSET"
        If argc <> 3 Then
            errText = "exec: LISTSET expects 3 arguments"
            Return 0
        End If

        Dim listHandleSet As Integer
        Dim listIndexSet As Integer
        Dim listValueSet As ExecValue
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, listHandleSet, errText) = 0 Then Return 0
        If ExecCollectionGetIntArg(ps, es, callNodeIdx, callName, 1, listIndexSet, errText) = 0 Then Return 0
        If ExecCollectionGetValueArg(ps, es, callNodeIdx, callName, 2, listValueSet, errText) = 0 Then Return 0
        If ExecListSet(listHandleSet, listIndexSet, listValueSet, errText) = 0 Then Return 0
        Return -1

    Case "LISTADD"
        If argc <> 2 Then
            errText = "exec: LISTADD expects 2 arguments"
            Return 0
        End If

        Dim listHandleAdd As Integer
        Dim listValueAdd As ExecValue
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, listHandleAdd, errText) = 0 Then Return 0
        If ExecCollectionGetValueArg(ps, es, callNodeIdx, callName, 1, listValueAdd, errText) = 0 Then Return 0
        If ExecListAdd(listHandleAdd, listValueAdd, errText) = 0 Then Return 0
        Return -1

    Case "LISTREMOVE"
        If argc <> 2 Then
            errText = "exec: LISTREMOVE expects 2 arguments"
            Return 0
        End If

        Dim listHandleRemove As Integer
        Dim listIndexRemove As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, listHandleRemove, errText) = 0 Then Return 0
        If ExecCollectionGetIntArg(ps, es, callNodeIdx, callName, 1, listIndexRemove, errText) = 0 Then Return 0
        If ExecListRemove(listHandleRemove, listIndexRemove, errText) = 0 Then Return 0
        Return -1

    Case "LISTCLEAR"
        If argc <> 1 Then
            errText = "exec: LISTCLEAR expects 1 argument"
            Return 0
        End If

        Dim listHandleClear As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, listHandleClear, errText) = 0 Then Return 0
        If ExecListClear(listHandleClear, errText) = 0 Then Return 0
        Return -1
    End Select

    Return -2
End Function

Private Function ExecEvalBuiltinCollectionDict(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim argc As Integer
    argc = ExecChildCount(ps, callNodeIdx)

    Select Case callName

    Case "DICT_NEW"
        If argc <> 0 Then
            errText = "exec: DICT_NEW expects 0 arguments"
            Return 0
        End If
        Return ExecCollectionCreate("DICT")

    Case "DICTLEN"
        If argc <> 1 Then
            errText = "exec: DICTLEN expects 1 argument"
            Return 0
        End If

        Dim dictHandleLen As Integer
        Dim dictLen As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, dictHandleLen, errText) = 0 Then Return 0
        If ExecDictLen(dictHandleLen, dictLen, errText) = 0 Then Return 0
        Return dictLen

    Case "DICTHAS"
        If argc <> 2 Then
            errText = "exec: DICTHAS expects 2 arguments"
            Return 0
        End If

        Dim dictHandleHas As Integer
        Dim dictKeyHas As String
        Dim dictHasValue As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, dictHandleHas, errText) = 0 Then Return 0
        If ExecCollectionGetTextArg(ps, es, callNodeIdx, callName, 1, dictKeyHas, errText) = 0 Then Return 0
        If ExecDictHas(dictHandleHas, dictKeyHas, dictHasValue, errText) = 0 Then Return 0
        Return dictHasValue

    Case "DICTGET"
        If argc <> 2 Then
            errText = "exec: DICTGET expects 2 arguments"
            Return 0
        End If

        Dim dictHandleGet As Integer
        Dim dictKeyGet As String
        Dim dictValueGet As ExecValue
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, dictHandleGet, errText) = 0 Then Return 0
        If ExecCollectionGetTextArg(ps, es, callNodeIdx, callName, 1, dictKeyGet, errText) = 0 Then Return 0
        If ExecDictGet(dictHandleGet, dictKeyGet, dictValueGet, errText) = 0 Then Return 0
        Return ExecValueToInteger(dictValueGet)

    Case "DICTSET"
        If argc <> 3 Then
            errText = "exec: DICTSET expects 3 arguments"
            Return 0
        End If

        Dim dictHandleSet As Integer
        Dim dictKeySet As String
        Dim dictValueSet As ExecValue
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, dictHandleSet, errText) = 0 Then Return 0
        If ExecCollectionGetTextArg(ps, es, callNodeIdx, callName, 1, dictKeySet, errText) = 0 Then Return 0
        If ExecCollectionGetValueArg(ps, es, callNodeIdx, callName, 2, dictValueSet, errText) = 0 Then Return 0
        If ExecDictSet(dictHandleSet, dictKeySet, dictValueSet, errText) = 0 Then Return 0
        Return -1

    Case "DICTCLEAR"
        If argc <> 1 Then
            errText = "exec: DICTCLEAR expects 1 argument"
            Return 0
        End If

        Dim dictHandleClear As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, dictHandleClear, errText) = 0 Then Return 0
        If ExecDictClear(dictHandleClear, errText) = 0 Then Return 0
        Return -1
    End Select

    Return -2
End Function

Private Function ExecEvalBuiltinCollectionSet(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim argc As Integer
    argc = ExecChildCount(ps, callNodeIdx)

    Select Case callName

    Case "SET_NEW"
        If argc <> 0 Then
            errText = "exec: SET_NEW expects 0 arguments"
            Return 0
        End If
        Return ExecCollectionCreate("SET")

    Case "SETLEN"
        If argc <> 1 Then
            errText = "exec: SETLEN expects 1 argument"
            Return 0
        End If

        Dim setHandleLen As Integer
        Dim setLen As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, setHandleLen, errText) = 0 Then Return 0
        If ExecSetLen(setHandleLen, setLen, errText) = 0 Then Return 0
        Return setLen

    Case "SETHAS"
        If argc <> 2 Then
            errText = "exec: SETHAS expects 2 arguments"
            Return 0
        End If

        Dim setHandleHas As Integer
        Dim setKeyHas As String
        Dim setHasValue As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, setHandleHas, errText) = 0 Then Return 0
        If ExecCollectionGetTextArg(ps, es, callNodeIdx, callName, 1, setKeyHas, errText) = 0 Then Return 0
        If ExecSetHas(setHandleHas, setKeyHas, setHasValue, errText) = 0 Then Return 0
        Return setHasValue

    Case "SETADD"
        If argc <> 2 Then
            errText = "exec: SETADD expects 2 arguments"
            Return 0
        End If

        Dim setHandleAdd As Integer
        Dim setKeyAdd As String
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, setHandleAdd, errText) = 0 Then Return 0
        If ExecCollectionGetTextArg(ps, es, callNodeIdx, callName, 1, setKeyAdd, errText) = 0 Then Return 0
        If ExecSetAdd(setHandleAdd, setKeyAdd, errText) = 0 Then Return 0
        Return -1

    Case "SETREMOVE"
        If argc <> 2 Then
            errText = "exec: SETREMOVE expects 2 arguments"
            Return 0
        End If

        Dim setHandleRemove As Integer
        Dim setKeyRemove As String
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, setHandleRemove, errText) = 0 Then Return 0
        If ExecCollectionGetTextArg(ps, es, callNodeIdx, callName, 1, setKeyRemove, errText) = 0 Then Return 0
        If ExecSetRemove(setHandleRemove, setKeyRemove, errText) = 0 Then Return 0
        Return -1

    Case "SETCLEAR"
        If argc <> 1 Then
            errText = "exec: SETCLEAR expects 1 argument"
            Return 0
        End If

        Dim setHandleClear As Integer
        If ExecCollectionGetHandleArg(ps, es, callNodeIdx, callName, 0, setHandleClear, errText) = 0 Then Return 0
        If ExecSetClear(setHandleClear, errText) = 0 Then Return 0
        Return -1
    End Select

    Return -2
End Function

Private Function ExecEvalBuiltinCollectionCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim resultValue As Integer

    resultValue = ExecEvalBuiltinCollectionList(ps, es, callName, callNodeIdx, errText)
    If resultValue <> -2 Then Return resultValue
    If errText <> "" Then Return 0

    resultValue = ExecEvalBuiltinCollectionDict(ps, es, callName, callNodeIdx, errText)
    If resultValue <> -2 Then Return resultValue
    If errText <> "" Then Return 0

    resultValue = ExecEvalBuiltinCollectionSet(ps, es, callName, callNodeIdx, errText)
    If resultValue <> -2 Then Return resultValue
    If errText <> "" Then Return 0

    errText = "exec: unsupported call " & callName
    Return 0
End Function

Private Function ExecClassIsOrDerivesFrom(ByRef ps As ParseState, ByRef derivedRaw As String, ByRef baseRaw As String) As Integer
    Dim derivedName As String
    Dim baseName As String
    derivedName = UCase(Trim(derivedRaw))
    baseName = UCase(Trim(baseRaw))
    If derivedName = "" Or baseName = "" Then Return 0
    If derivedName = baseName Then Return 1

    Dim hop As Integer
    Dim curClass As String
    curClass = derivedName
    Do While curClass <> ""
        hop += 1
        If hop > 64 Then Exit Do

        Dim classNode As Integer
        classNode = ExecFindClassDeclNode(ps, curClass)
        If classNode = -1 Then Exit Do

        Dim baseNode As Integer
        baseNode = ExecFindChildByKind(ps, classNode, "CLASS_BASE_REF")
        If baseNode = -1 Then baseNode = ExecFindChildByKind(ps, classNode, "CLASS_EXTENDS")
        If baseNode = -1 Then Exit Do

        Dim nextBase As String
        nextBase = UCase(Trim(ps.ast.nodes(baseNode).value))
        If nextBase = "" Then Exit Do
        If nextBase = baseName Then Return 1

        curClass = nextBase
    Loop

    Return 0
End Function

Private Function ExecResolveInstanceOfObjectClass(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByVal objectAddr As Integer, ByRef classOut As String) As Integer
    classOut = ""

    If objectAddr <> 0 Then
        If ExecResolveRuntimeClassByObjectAddr(CULngInt(objectAddr), classOut) <> 0 Then
            classOut = UCase(Trim(classOut))
            If classOut <> "" Then Return 1
        End If
    End If

    Dim objNode As Integer
    objNode = ExecChildAt(ps, callNodeIdx, 0)
    If objNode = -1 Then Return 0

    If UCase(ps.ast.nodes(objNode).kind) = "IDENT" Then
        Dim objVarIdx As Integer
        objVarIdx = ExecFindVar(es, ps.ast.nodes(objNode).value)
        If objVarIdx <> -1 Then
            Dim runtimeClass As String
            runtimeClass = UCase(Trim(es.vars(objVarIdx).runtimeClassType))
            If runtimeClass <> "" Then
                classOut = runtimeClass
                Return 1
            End If

            Dim declClass As String
            declClass = UCase(Trim(es.vars(objVarIdx).declType))
            If declClass <> "" And ExecFindClassDeclNode(ps, declClass) <> -1 Then
                classOut = declClass
                Return 1
            End If
        End If
    End If

    Return 0
End Function

Private Function ExecEvalBuiltinLayoutCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "SIZEOF"
        Dim sizeofArgNode As Integer
        sizeofArgNode = ExecChildAt(ps, callNodeIdx, 0)
        If sizeofArgNode <> -1 And UCase(Trim(ps.ast.nodes(sizeofArgNode).kind)) = "IDENT" Then
            Dim arrayInfo As UXBArrayMemoryInfo
            Dim arrayErr As String
            If UXBFindArrayMemoryInfo(ps, ps.ast.nodes(sizeofArgNode).value, arrayInfo, arrayErr) = 0 Then
                errText = "exec: SIZEOF(array) failed " & arrayErr
                Return 0
            End If
            If arrayInfo.found <> 0 Then
                If arrayInfo.dynamicBounds <> 0 Then
                    errText = "exec: SIZEOF(array) requires compile-time array bounds"
                    Return 0
                End If
                Return CInt(arrayInfo.byteLength)
            End If
            ' Not a declared array -- it may still be a type name (STRUCT/UNION/TYPE/
            ' CLASS) written as a bare identifier; fall through below instead of
            ' failing here. (Found 2026-09-06: same regression as the semantic-pass
            ' validator in layout_path_and_intrinsic.fbs -- array support was added
            ' with no fallback to the type-name path.)
        End If

        Dim sizeofType As String
        If ExecBuiltinArgAsTypeName(ps, callNodeIdx, callName, sizeofType, errText) = 0 Then Return 0

        Dim sizeofOut As Integer
        Dim sizeofErr As String
        If TypeLayoutSizeOf(ps, sizeofType, sizeofOut, sizeofErr) = 0 Then
            errText = "exec: SIZEOF failed " & sizeofErr
            Return 0
        End If
        Return sizeofOut

    Case "OFFSETOF"
        Dim offsetofType As String
        If ExecBuiltinArgAsTypeName(ps, callNodeIdx, callName, offsetofType, errText) = 0 Then Return 0

        Dim p1 As Integer
        p1 = ExecChildAt(ps, callNodeIdx, 1)
        If p1 = -1 Or UCase(ps.ast.nodes(p1).kind) <> "STRING" Then
            errText = "exec: OFFSETOF expects string path"
            Return 0
        End If

        Dim offsetofOut As Integer
        Dim offsetofErr As String
        If TypeLayoutOffsetOf(ps, offsetofType, ps.ast.nodes(p1).value, offsetofOut, offsetofErr) = 0 Then
            errText = "exec: OFFSETOF failed " & offsetofErr
            Return 0
        End If
        Return offsetofOut

    Case "INSTANCEOF"
        If ExecChildCount(ps, callNodeIdx) <> 2 Then
            errText = "exec: INSTANCEOF expects object and class"
            Return 0
        End If

        Dim objectAddr As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, objectAddr, errText, 0) = 0 Then Return 0
        If objectAddr = 0 Then Return 0

        Dim classNode As Integer
        classNode = ExecChildAt(ps, callNodeIdx, 1)
        If classNode = -1 Then
            errText = "exec: INSTANCEOF class arg missing"
            Return 0
        End If

        Dim classKind As String
        classKind = UCase(ps.ast.nodes(classNode).kind)
        If classKind <> "IDENT" And classKind <> "KEYWORD_REF" And classKind <> "STRING" Then
            errText = "exec: INSTANCEOF expects class name"
            Return 0
        End If

        Dim targetClass As String
        targetClass = UCase(Trim(ps.ast.nodes(classNode).value))
        If targetClass = "" Then
            errText = "exec: INSTANCEOF class name empty"
            Return 0
        End If
        If ExecFindClassDeclNode(ps, targetClass) = -1 Then
            errText = "exec: INSTANCEOF unknown class " & targetClass
            Return 0
        End If

        Dim objectClass As String
        If ExecResolveInstanceOfObjectClass(ps, es, callNodeIdx, objectAddr, objectClass) = 0 Then Return 0
        If objectClass = "" Then Return 0

        If ExecClassIsOrDerivesFrom(ps, objectClass, targetClass) <> 0 Then Return -1
        Return 0
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

Private Function ExecBuiltinArgAsNumericFloat(ByRef ps As ParseState, ByRef es As ExecState, ByVal callNodeIdx As Integer, ByRef callName As String, ByRef valueOut As Double, ByRef errText As String) As Integer
    Dim argNode As Integer
    If ExecBuiltinGetArgNode(ps, callNodeIdx, callName, argNode, errText) = 0 Then Return 0

    Dim value As ExecValue
    If ExecEvalExpression(ps, argNode, es, value, errText) = 0 Then Return 0
    valueOut = ExecValueToFloat(value)
    Return 1
End Function

Private Function ExecEvalBuiltinScalarCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "BOOLEAN", "BOOL", "I8", "U8", "I16", "U16", "I32", "U32", "PTR"
        Dim castValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, castValue, errText, 1) = 0 Then Return 0
        Select Case callName
        Case "BOOLEAN", "BOOL": Return IIf(castValue <> 0, -1, 0)
        Case "U8": Return castValue And &hFF
        Case "I8"
            castValue And= &hFF
            If (castValue And &h80) <> 0 Then castValue -= &h100
            Return castValue
        Case "U16": Return castValue And &hFFFF
        Case "I16"
            castValue And= &hFFFF
            If (castValue And &h8000) <> 0 Then castValue -= &h10000
            Return castValue
        Case Else: Return castValue
        End Select

    Case "I64", "U64", "F32", "F64"
        errText = "exec: typed scalar conversion requires ExecEvalExpression: " & callName
        Return 0

    Case "LEN"
        Dim lenText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, callName, lenText, errText) = 0 Then Return 0
        Return Len(lenText)

    Case "ABS"
        Dim absValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, absValue, errText, 1) = 0 Then Return 0
        Return Abs(absValue)

    Case "INT"
        Dim intValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, intValue, errText, 1) = 0 Then Return 0
        Return CInt(Int(intValue))

    Case "SGN"
        Dim sgnValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, sgnValue, errText, 1) = 0 Then Return 0
        If sgnValue < 0 Then Return -1
        If sgnValue > 0 Then Return 1
        Return 0

    Case "VAL"
        Dim valText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, callName, valText, errText) = 0 Then Return 0
        Return ValInt(valText)

    Case "ASC"
        Dim ascText As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, callName, ascText, errText) = 0 Then Return 0
        If Len(ascText) = 0 Then
            errText = "exec: ASC empty string"
            Return 0
        End If
        Return Asc(Left(ascText, 1))

    Case "CINT"
        Dim cintValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, cintValue, errText, 1) = 0 Then Return 0
        Return CInt(cintValue)

    Case "CLNG"
        Dim clngValue As Double
        If ExecBuiltinArgAsNumericFloat(ps, es, callNodeIdx, callName, clngValue, errText) = 0 Then Return 0
        Return CInt(CLngInt(clngValue))

    Case "CDBL"
        Dim cdblValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, cdblValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(CDbl(cdblValue))

    Case "CSNG"
        Dim csngValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, csngValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(CSng(csngValue))

    Case "FIX"
        Dim fixValue As Double
        If ExecBuiltinArgAsNumericFloat(ps, es, callNodeIdx, callName, fixValue, errText) = 0 Then Return 0
        Return ExecClampI32(Fix(fixValue))

    Case "SQR"
        Dim sqrValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, sqrValue, errText, 1) = 0 Then Return 0
        If sqrValue < 0 Then
            errText = "exec: SQR domain error"
            Return 0
        End If
        Return ExecClampI32(Sqr(CDbl(sqrValue)))

    Case "SIN"
        Dim sinValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, sinValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(Sin(CDbl(sinValue)))

    Case "COS"
        Dim cosValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, cosValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(Cos(CDbl(cosValue)))

    Case "TAN"
        Dim tanValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, tanValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(Tan(CDbl(tanValue)))

    Case "ATN"
        Dim atnValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, atnValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(Atn(CDbl(atnValue)))

    Case "EXP"
        Dim expValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, expValue, errText, 1) = 0 Then Return 0
        Return ExecClampI32(Exp(CDbl(expValue)))

    Case "LOG"
        Dim logValue As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, logValue, errText, 1) = 0 Then Return 0
        If logValue <= 0 Then
            errText = "exec: LOG domain error"
            Return 0
        End If
        Return ExecClampI32(Log(CDbl(logValue)))
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

' ADIM50 compatibility bridge:
' Text builtins are primarily consumed through text helpers (ExecEvalNodeAsText / ExecTryEvalCallExprAsText).
' This category function preserves the historical contract symbol for cross-layer references.
Private Function ExecEvalBuiltinTextCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "LEN"
        Dim lenTextCompat As String
        If ExecBuiltinArgAsText(ps, es, callNodeIdx, callName, lenTextCompat, errText) = 0 Then Return 0
        Return Len(lenTextCompat)

    Case "INSTR"
        Dim instrArgcCompat As Integer
        instrArgcCompat = ExecChildCount(ps, callNodeIdx)
        If instrArgcCompat < 2 Or instrArgcCompat > 3 Then
            errText = "exec: INSTR expects 2 or 3 arguments"
            Return 0
        End If

        Dim instrStartCompat As Integer
        Dim instrHayCompat As String
        Dim instrNeedleCompat As String
        If instrArgcCompat = 2 Then
            instrStartCompat = 1
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 0), instrHayCompat, errText) = 0 Then Return 0
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 1), instrNeedleCompat, errText) = 0 Then Return 0
        Else
            instrStartCompat = ExecEvalNode(ps, es, ExecChildAt(ps, callNodeIdx, 0), errText)
            If errText <> "" Then Return 0
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 1), instrHayCompat, errText) = 0 Then Return 0
            If ExecEvalNodeAsText(ps, es, ExecChildAt(ps, callNodeIdx, 2), instrNeedleCompat, errText) = 0 Then Return 0
        End If

        Return InStr(instrStartCompat, instrHayCompat, instrNeedleCompat)
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

Private Function ExecEvalBuiltinTimeRandomCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "RND"
        Dim rndArgc As Integer
        rndArgc = ExecChildCount(ps, callNodeIdx)

        ' S-163: tamsayi baglaminda RND [0,1) degerinin tamsayi kismidir (0); uretec yine ilerler
        ' (tipli yol ile ayni dizi). Onceki `* 2147483647` olceklemesi kilavuza aykiriydi.
        Dim rndValue As Double
        If rndArgc = 0 Then
            rndValue = UXBRngRnd(ExecCurrentTaskKey(), 0, 0)
        Else
            Dim rndSeedArg As Integer
            If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, rndSeedArg, errText, 1) = 0 Then Return 0
            rndValue = UXBRngRnd(ExecCurrentTaskKey(), 1, CDbl(rndSeedArg))
        End If

        Return ExecClampI32(Int(rndValue))

    Case "TIMER"
        Dim timerArgc As Integer
        timerArgc = ExecChildCount(ps, callNodeIdx)

        If timerArgc = 0 Then
            Return ExecClampI32(Timer)
        ElseIf timerArgc = 1 Then
            Dim tu0 As Integer
            tu0 = ExecChildAt(ps, callNodeIdx, 0)
            If tu0 = -1 Or UCase(ps.ast.nodes(tu0).kind) <> "STRING" Then
                errText = "exec: TIMER(unit) expects string unit"
                Return 0
            End If

            Dim scale1 As Double
            If ExecTimerUnitScale(ps.ast.nodes(tu0).value, scale1) = 0 Then
                errText = "exec: invalid TIMER unit"
                Return 0
            End If

            Return ExecClampI32(Timer * scale1)
        ElseIf timerArgc = 3 Then
            Dim t0 As Integer
            Dim t1 As Integer
            Dim t2 As Integer
            t0 = ExecChildAt(ps, callNodeIdx, 0)
            t1 = ExecChildAt(ps, callNodeIdx, 1)
            t2 = ExecChildAt(ps, callNodeIdx, 2)
            If t0 = -1 Or t1 = -1 Or t2 = -1 Then
                errText = "exec: TIMER(start,end,unit) args missing"
                Return 0
            End If
            If UCase(ps.ast.nodes(t2).kind) <> "STRING" Then
                errText = "exec: TIMER(start,end,unit) expects string unit"
                Return 0
            End If

            Dim startValue As Integer
            Dim endValue As Integer
            startValue = ExecEvalNode(ps, es, t0, errText)
            If errText <> "" Then Return 0
            endValue = ExecEvalNode(ps, es, t1, errText)
            If errText <> "" Then Return 0

            Dim scale3 As Double
            If ExecTimerUnitScale(ps.ast.nodes(t2).value, scale3) = 0 Then
                errText = "exec: invalid TIMER unit"
                Return 0
            End If

            Return ExecClampI32((CDbl(endValue) - CDbl(startValue)) * scale3)
        End If

        errText = "exec: TIMER expects 0, 1 or 3 arguments"
        Return 0
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

Private Function ExecEvalBuiltinFileCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "LOF"
        Dim lofHandle As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, lofHandle, errText, 1) = 0 Then Return 0

        If lofHandle < 1 Or lofHandle > 255 Or es.fileIo.channels(lofHandle).inUse = 0 Then
            errText = "exec: LOF channel not open"
            Return 0
        End If

        Err = 0
        Dim lofOut As LongInt
        lofOut = Lof(lofHandle)
        If Err <> 0 Then
            errText = "exec: LOF failed " & ExecFormatFileError(es.fileIo)
            Return 0
        End If

        Return ExecClampI32(CDbl(lofOut))

    Case "EOF"
        Dim eofHandle As Integer
        If ExecBuiltinArgAsInt(ps, es, callNodeIdx, callName, eofHandle, errText, 1) = 0 Then Return 0

        If eofHandle < 1 Or eofHandle > 255 Or es.fileIo.channels(eofHandle).inUse = 0 Then
            errText = "exec: EOF channel not open"
            Return 0
        End If

        If Eof(eofHandle) Then Return -1 Else Return 0
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

Private Function ExecEvalBuiltinKeyboardCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "INKEY", "GETKEY"
        Dim keyArgc As Integer
        keyArgc = ExecChildCount(ps, callNodeIdx)

        If callName = "GETKEY" Then
            If keyArgc <> 0 Then
                errText = "exec: GETKEY expects 0 arguments"
                Return 0
            End If
        Else
            If keyArgc < 1 Or keyArgc > 2 Then
                errText = "exec: INKEY expects 1 or 2 arguments"
                Return 0
            End If

            Dim keyFlagsNode As Integer
            keyFlagsNode = ExecChildAt(ps, callNodeIdx, 0)
            If keyFlagsNode = -1 Then
                errText = "exec: INKEY arg missing"
                Return 0
            End If

            Dim keyFlags As Integer
            keyFlags = ExecEvalNode(ps, es, keyFlagsNode, errText)
            If errText <> "" Then Return 0
        End If

        Dim keyValue As Integer
        keyValue = 0
        If ExecDebugKeyQueuePop(keyValue) = 0 Then keyValue = 0

        If callName = "INKEY" And keyArgc = 2 Then
            Dim stateNode As Integer
            stateNode = ExecChildAt(ps, callNodeIdx, 1)
            If stateNode = -1 Then
                errText = "exec: INKEY state arg missing"
                Return 0
            End If

            If UCase(ps.ast.nodes(stateNode).kind) <> "IDENT" Then
                errText = "exec: INKEY state target must be variable"
                Return 0
            End If

            If keyValue <> 0 Then
                ExecSetVar es, ps.ast.nodes(stateNode).value, 1
            Else
                ExecSetVar es, ps.ast.nodes(stateNode).value, 0
            End If
        End If

        Return keyValue
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

Private Function ExecEvalBuiltinPeekCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim modeOffset As Integer = 0
    Dim peekMode As String = ""
    Dim firstPeekNode As Integer = ExecChildAt(ps, callNodeIdx, 0)
    If firstPeekNode <> -1 And UCase(ps.ast.nodes(firstPeekNode).kind) = "KEYWORD_REF" Then
        Dim peekModeName As String = UCase(Trim(ps.ast.nodes(firstPeekNode).value))
        If peekModeName = "NATIVE" Then peekMode = "NATIVE": modeOffset = 1
        If peekModeName = "VIRTUAL" Then peekMode = "VIRTUAL": modeOffset = 1
    End If
    ' S-069: AUTO -- pointer-typed address means NATIVE (see UXBMemoryAddrIsPointer).
    If peekMode = "" Then
        If UXBMemoryAddrIsPointer(ps, ExecChildAt(ps, callNodeIdx, modeOffset)) <> 0 Then peekMode = "NATIVE"
    End If
    Select Case callName
    Case "PEEKB"
        Dim a0 As Integer
        a0 = ExecChildAt(ps, callNodeIdx, modeOffset)
        If a0 = -1 Then
            errText = "exec: PEEKB arg missing"
            Return 0
        End If
        Dim addr As Integer
        addr = ExecEvalNode(ps, es, a0, errText)
        If errText <> "" Then Return 0
        If peekMode = "NATIVE" Then
            ' S-057-class bug: ExecNativePeekB returns the sentinel -1 on a
            ' failed IsBadReadPtr check, but a real byte at a valid address
            ' can never legitimately equal -1 as this Integer-typed result,
            ' so a range check BEFORE the read (not "was the result -1?"
            ' afterwards) is the only way to tell a real failure from a real
            ' value -- matching the write side (ExecRunPokeBStmt), which
            ' already does this correctly for NATIVE POKEB.
            If ExecNativeAddrReadable(CUInt(addr), 1) = 0 Then
                errText = "exec: NATIVE PEEKB out of range" & UXBMemRefReason()
                Return 0
            End If
            Return ExecNativePeekB(CUInt(addr))
        End If
        If VMemInRange(CUInt(addr), 1) = 0 Then
            errText = "exec: PEEKB out of range"
            Return 0
        End If
        Return VMemPeekB(CUInt(addr))

    Case "PEEKW"
        Dim w0 As Integer
        w0 = ExecChildAt(ps, callNodeIdx, modeOffset)
        If w0 = -1 Then
            errText = "exec: PEEKW arg missing"
            Return 0
        End If
        Dim addrW As Integer
        addrW = ExecEvalNode(ps, es, w0, errText)
        If errText <> "" Then Return 0
        If peekMode = "NATIVE" Then
            If ExecNativeAddrReadable(CUInt(addrW), 2) = 0 Then
                errText = "exec: NATIVE PEEKW out of range" & UXBMemRefReason()
                Return 0
            End If
            Return ExecNativePeekW(CUInt(addrW))
        End If
        If VMemInRange(CUInt(addrW), 2) = 0 Then
            errText = "exec: PEEKW out of range"
            Return 0
        End If
        Return VMemPeekW(CUInt(addrW))

    Case "PEEK", "PEEKD"
        Dim d0 As Integer
        d0 = ExecChildAt(ps, callNodeIdx, modeOffset)
        If d0 = -1 Then
            errText = "exec: " & callName & " arg missing"
            Return 0
        End If
        Dim addrD As Integer
        addrD = ExecEvalNode(ps, es, d0, errText)
        If errText <> "" Then Return 0
        If peekMode = "NATIVE" Then
            If ExecNativeAddrReadable(CUInt(addrD), 4) = 0 Then
                errText = "exec: NATIVE " & callName & " out of range" & UXBMemRefReason()
                Return 0
            End If
            Return ExecNativePeekD(CUInt(addrD))
        End If
        If VMemInRange(CUInt(addrD), 4) = 0 Then
            errText = "exec: " & callName & " out of range"
            Return 0
        End If
        Return VMemPeekD(CUInt(addrD))

    Case "PEEKQ"
        ' S-055: Q (64-bit) memory family, parallel to PEEK/PEEKD above.
        Dim q0 As Integer
        q0 = ExecChildAt(ps, callNodeIdx, modeOffset)
        If q0 = -1 Then
            errText = "exec: " & callName & " arg missing"
            Return 0
        End If
        Dim addrQ As Integer
        addrQ = ExecEvalNode(ps, es, q0, errText)
        If errText <> "" Then Return 0
        If peekMode = "NATIVE" Then
            If ExecNativeAddrReadable(CUInt(addrQ), 8) = 0 Then
                errText = "exec: NATIVE " & callName & " out of range" & UXBMemRefReason()
                Return 0
            End If
            Return ExecNativePeekQ(CUInt(addrQ))
        End If
        If VMemInRange(CUInt(addrQ), 8) = 0 Then
            errText = "exec: " & callName & " out of range"
            Return 0
        End If
        Return VMemPeekQ(CUInt(addrQ))
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function

' S-101 (Mete decision 2026-09-20): LBOUND(array [, dimension]) / UBOUND(array [, dimension]).
' Dimension is 1-based, default 1. A one-dimensional array reports its CURRENT bounds (REDIM and
' array parameters included: the parameter is bound to the caller's array with the same bounds);
' the bounds of a several-dimensional array come from its (compile-time constant) declaration -
' the same layout ExecResolveFlatArrayIndex indexes with.
Private Function ExecEvalBuiltinArrayBoundsCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Dim wantUpper As Integer
    wantUpper = IIf(callName = "UBOUND", 1, 0)
    Dim argCount As Integer
    argCount = ExecChildCount(ps, callNodeIdx)
    If argCount < 1 Or argCount > 2 Then
        errText = "exec: " & callName & " expects (array [, dimension])"
        Return 0
    End If

    Dim arrayNode As Integer
    arrayNode = ExecChildAt(ps, callNodeIdx, 0)
    Dim arrayKind As String
    arrayKind = UCase(Trim(ps.ast.nodes(arrayNode).kind))
    If arrayKind <> "IDENT" And arrayKind <> "IDENTIFIER" And arrayKind <> "KEYWORD_REF" Then
        errText = "exec: " & callName & " needs an array variable as its first argument"
        Return 0
    End If
    Dim arrayName As String
    arrayName = UCase(Trim(ps.ast.nodes(arrayNode).value))

    Dim dimNo As Integer
    dimNo = 1
    If argCount = 2 Then
        Dim dimNode As Integer
        dimNode = ExecChildAt(ps, callNodeIdx, 1)
        If UCase(Trim(ps.ast.nodes(dimNode).kind)) <> "NUMBER" Then
            errText = "exec: " & callName & " dimension must be an integer literal"
            Return 0
        End If
        dimNo = ValInt(Trim(ps.ast.nodes(dimNode).value))
    End If

    Dim varIdx As Integer
    varIdx = ExecFindVar(es, arrayName)
    If varIdx < 0 Or varIdx >= es.count Then
        errText = "exec: " & callName & ": " & arrayName & " is not an array"
        Return 0
    End If
    If es.vars(varIdx).isArray = 0 Then
        errText = "exec: " & callName & ": " & arrayName & " is not an array"
        Return 0
    End If

    ' A several-dimensional array is one flat array at run time (arrayLower/arrayUpper describe the
    ' flat storage), so its dimensions and bounds are read from the declaration, exactly the layout
    ' ExecResolveFlatArrayIndex indexes with.
    Dim boundsNode As Integer
    boundsNode = ExecArrayDeclBoundsNode(ps, arrayName)
    Dim dimCount As Integer
    dimCount = 1
    If boundsNode <> -1 Then
        If ExecNodeChildCount(ps, boundsNode) > 1 Then dimCount = ExecNodeChildCount(ps, boundsNode)
    End If
    If dimNo < 1 Or dimNo > dimCount Then
        errText = "exec: " & callName & " dimension " & LTrim(Str(dimNo)) & " is out of range: array " & arrayName & " has " & LTrim(Str(dimCount)) & " dimension(s)"
        Return 0
    End If

    If dimCount = 1 Then
        Return IIf(wantUpper <> 0, es.vars(varIdx).arrayUpper, es.vars(varIdx).arrayLower)
    End If

    Dim boundNode As Integer
    boundNode = ps.ast.nodes(boundsNode).firstChild
    Dim k As Integer
    k = 1
    Do While boundNode <> -1 And k < dimNo
        boundNode = ps.ast.nodes(boundNode).nextSibling
        k += 1
    Loop
    Dim lowerOut As Integer, upperOut As Integer
    If ExecArrayDimConstBound(ps, boundNode, lowerOut, upperOut, errText) = 0 Then Return 0
    Return IIf(wantUpper <> 0, upperOut, lowerOut)
End Function

Private Function ExecEvalBuiltinPointerCategory(ByRef ps As ParseState, ByRef es As ExecState, ByVal callName As String, ByVal callNodeIdx As Integer, ByRef errText As String) As Integer
    Select Case callName
    Case "VARPTR"
        Dim v0 As Integer
        v0 = ExecChildAt(ps, callNodeIdx, 0)
        If v0 = -1 Then
            errText = "exec: VARPTR arg missing"
            Return 0
        End If

        Dim argNode As ASTNode
        argNode = ps.ast.nodes(v0)
        If UCase(argNode.kind) <> "IDENT" Then
            errText = "exec: VARPTR requires identifier, got " & argNode.kind
            Return 0
        End If

        Dim identUpper As String
        identUpper = UCase(Trim(argNode.value))

        ' NATIVE memory (S-036): for plain scalars/arrays, VARPTR returns the
        ' real address of the variable's own backing storage (see
        ' ExecNativeFieldAddrForDeclType) instead of the legacy fake VM
        ' bookkeeping address. Class/interface/OBJECT/TYPE-aggregate targets
        ' and THIS/ME keep the existing es.vars().addr-based scheme untouched.
        Dim varIdx As Integer
        varIdx = ExecFindVar(es, identUpper)
        If varIdx <> -1 And identUpper <> "THIS" And identUpper <> "ME" Then
            If es.vars(varIdx).isArray <> 0 Then
                If ExecDeclTypeIsNativeScalar(es.vars(varIdx).declType) <> 0 Then
                    Dim arrId As Integer
                    arrId = es.vars(varIdx).arrayId
                    If arrId < 0 Or arrId >= es.arrayCount Then
                        errText = "exec: VARPTR array not initialized"
                        Return 0
                    End If
                    If es.arrays(arrId).totalElements <= 0 Then
                        errText = "exec: VARPTR array has no elements"
                        Return 0
                    End If
                    If es.arrays(arrId).isNativeScalar = 0 Then
                        errText = "exec: VARPTR array storage not initialized as native scalar"
                        Return 0
                    End If
                    ' rawData is the array's one real, tightly-packed backing
                    ' buffer (see ExecArrayResizeVar) -- its real elemStride
                    ' means VARPTR(arr) + i*elemStride correctly reaches
                    ' element i, unlike elements() (one large ExecValue per
                    ' element, stride != the declared type's real SIZEOF).
                    Dim arrNativeAddr As UInteger
                    arrNativeAddr = CULngInt(@es.arrays(arrId).rawData(0))
                    Return CInt(arrNativeAddr)
                End If
            ElseIf ExecDeclTypeIsNativeScalar(es.vars(varIdx).declType) <> 0 Then
                ' S-071: VARPTR of a scalar is the address of its raw,
                ' declared-WIDTH cell (ExecVar.pinCell), not of one of the
                ' ExecValue's separate int/u64/float fields -- which field is
                ' "live" depends on the runtime type of the last assignment,
                ' so those addresses read as 0 / lost writes for I64, U32,
                ' U64, PTR and F32. The variable is pinned: FindVar refreshes
                ' its value from the cell before every read and every write
                ' stores back into it.
                Dim pinTypeText As String = UCase(Trim(es.vars(varIdx).declType))
                If Left(pinTypeText, 5) = "TYPE_" Then pinTypeText = Mid(pinTypeText, 6)
                If pinTypeText = "" Then pinTypeText = "I32"
                Dim pinWidthValue As Integer = ExecPinWidth(pinTypeText)
                If pinWidthValue = 0 Then
                    errText = "exec: VARPTR: no native scalar layout for type " & pinTypeText & " (" & identUpper & ")"
                    Return 0
                End If
                If es.vars(varIdx).pinned = 0 Then
                    es.vars(varIdx).pinType = pinTypeText
                    es.vars(varIdx).pinWidth = pinWidthValue
                    ExecVarPinStore es, varIdx
                    es.vars(varIdx).pinned = 1
                End If
                Dim scalarNativeAddr As UInteger = CULngInt(@es.vars(varIdx).pinCell(0))
                Return CInt(scalarNativeAddr)
            End If
        End If

        Dim varAddr As UInteger
        If ExecResolveThisMeIdentAddr(es, argNode.value, varAddr, errText) = 0 Then Return 0
        Return CInt(varAddr)

    Case "SADD"
        Dim s0 As Integer
        s0 = ExecChildAt(ps, callNodeIdx, 0)
        If s0 = -1 Then
            errText = "exec: SADD arg missing"
            Return 0
        End If

        ' S-076: the REAL address of the string's NUL-terminated data (see
        ' common/string_pin.fbs). This used to return `&h20000000 Or hash(name)` -- an
        ' address with no data behind it, so PEEKB(SADD(s)) failed as "out of range".
        Dim sadVal As ExecValue
        If ExecEvalExpression(ps, s0, es, sadVal, errText) = 0 Then Return 0
        If UCase(Trim(sadVal.valueType)) <> "STRING" Then
            errText = "exec: SADD requires a STRING argument"
            Return 0
        End If
        Dim sadAddr As ULongInt
        If UXBStrPinAddress(sadVal.stringValue, sadAddr, errText) = 0 Then Return 0
        Return CInt(sadAddr)

    Case "LPTR"
        Dim l0 As Integer
        l0 = ExecChildAt(ps, callNodeIdx, 0)
        If l0 = -1 Then
            errText = "exec: LPTR arg missing"
            Return 0
        End If

        Dim lNode As ASTNode
        lNode = ps.ast.nodes(l0)
        Dim lKind As String
        lKind = UCase(lNode.kind)
        If lKind <> "IDENT" And lKind <> "KEYWORD_REF" Then
            errText = "exec: LPTR requires IDENT/KEYWORD_REF, got " & lNode.kind
            Return 0
        End If

        Dim labelName As String
        labelName = UCase(Trim(lNode.value))
        If labelName = "" Then
            errText = "exec: LPTR requires non-empty label"
            Return 0
        End If

        ' S-076: a label has no address in an interpreter. The old `&h30000000 Or hash`
        ' value pointed at nothing (a placeholder); refuse exactly like the MIR
        ' interpreter does. Native x64 returns the real code address.
        errText = "exec: LPTR requires native x64 (an interpreter has no code address to return)"
        Return 0

    Case "CODEPTR"
        Dim c0 As Integer
        c0 = ExecChildAt(ps, callNodeIdx, 0)
        If c0 = -1 Then
            errText = "exec: CODEPTR arg missing"
            Return 0
        End If

        Dim cNode As ASTNode
        cNode = ps.ast.nodes(c0)
        Dim cKind As String
        cKind = UCase(cNode.kind)
        If cKind <> "IDENT" And cKind <> "KEYWORD_REF" Then
            errText = "exec: CODEPTR requires IDENT/KEYWORD_REF, got " & cNode.kind
            Return 0
        End If

        Dim routineName As String
        routineName = UCase(Trim(cNode.value))
        If routineName = "" Then
            errText = "exec: CODEPTR requires non-empty routine name"
            Return 0
        End If

        ' S-076: same refusal as LPTR -- see above. (uxgsl callbacks use CODEPTR natively.)
        errText = "exec: CODEPTR requires native x64 (an interpreter has no code address to return)"
        Return 0
    End Select

    errText = "exec: unsupported call " & callName
    Return 0
End Function
