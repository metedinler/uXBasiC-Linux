Sub UXBOutputContractReadCli(ByRef p As UXBOutputContractPaths)
    UXBOutputContractInit p
    GetArgValue("--tokens-json-out", p.tokensJsonOutPath)
    If p.tokensJsonOutPath = "" Then GetArgValue("--token-json-out", p.tokensJsonOutPath)
    GetArgValue("--lexer-diagnostics-json-out", p.lexerDiagnosticsJsonOutPath)
    GetArgValue("--preprocessed-out", p.preprocessedOutPath)
    GetArgValue("--parser-diagnostics-json-out", p.parserDiagnosticsJsonOutPath)
    GetArgValue("--symbol-table-json-out", p.symbolTableJsonOutPath)
    GetArgValue("--type-table-json-out", p.typeTableJsonOutPath)
    GetArgValue("--layout-report-json-out", p.layoutReportJsonOutPath)
    GetArgValue("--hir-inventory-json-out", p.hirInventoryJsonOutPath)
    GetArgValue("--semantic-json-out", p.semanticJsonOutPath)
    GetArgValue("--semantic-diagnostics-json-out", p.semanticDiagnosticsJsonOutPath)
    GetArgValue("--mir-opt-report-json-out", p.mirOptReportJsonOutPath)
    GetArgValue("--stdout-out", p.stdoutOutPath)
    GetArgValue("--stderr-out", p.stderrOutPath)
    GetArgValue("--runtime-trace-json-out", p.runtimeTraceJsonOutPath)
    GetArgValue("--runtime-route-matrix-json-out", p.runtimeRouteMatrixJsonOutPath)
    GetArgValue("--backend-report-json-out", p.backendReportJsonOutPath)
    GetArgValue("--js-out", p.jsOutPath)
    GetArgValue("--js-runtime-out", p.jsRuntimeOutPath)
    GetArgValue("--wat-out", p.watOutPath)
    If p.watOutPath = "" Then GetArgValue("--wasm-wat-out", p.watOutPath)
    GetArgValue("--wasm-out", p.wasmOutPath)
    GetArgValue("--html-out", p.htmlOutPath)
    GetArgValue("--manifest-out", p.manifestOutPath)

    If GetArgValue("--run-id", p.runId) = 0 Then p.runId = UXBArtifactDefaultRunId()
    Dim artifactRootBase As String
    artifactRootBase = ""

    ' YAMA 1.1: Tek cikti kok politikasi.
    ' --out-root yeni kanonik addir. --artifact-root eski komutlar icin uyumlu alias olarak kalir.
    If GetArgValue("--out-root", artifactRootBase) = 0 Then
        If GetArgValue("--artifact-root", artifactRootBase) = 0 Then artifactRootBase = UXBArtifactDefaultBuildRoot()
    End If

    ' Kullanici karari: --out-root/--artifact-root bir genel build kokudur.
    ' Resmi cikti kok formu: <kok>/<run_id>/<dosya_tipi>/.
    ' JSON: <kok>/<run_id>/json; ASM: <kok>/<run_id>/asm; EXE: <kok>/<run_id>/exe.
    p.buildRoot = UXBArtifactBuildRootForBaseAndRun(artifactRootBase, p.runId)
    UXBSemanticStep3ConfigureReports p.buildRoot & "/logs"
    p.jsonRoot = UXBArtifactRootForBaseAndRun(artifactRootBase, p.runId)
    p.artifactRoot = p.jsonRoot
    p.asmRoot = UXBArtifactSubRootForBaseAndRun(artifactRootBase, "asm", p.runId)
    p.objRoot = UXBArtifactSubRootForBaseAndRun(artifactRootBase, "obj", p.runId)
    p.exeRoot = UXBArtifactSubRootForBaseAndRun(artifactRootBase, "exe", p.runId)
    p.dllRoot = UXBArtifactSubRootForBaseAndRun(artifactRootBase, "dll", p.runId)
    p.webRoot = UXBArtifactSubRootForBaseAndRun(artifactRootBase, "web", p.runId)
    p.outRootBase = artifactRootBase

    If GetArgValue("--run-manifest-json-out", p.runManifestJsonOutPath) = 0 Then p.runManifestJsonOutPath = p.artifactRoot & "/run_manifest.json"
    If GetArgValue("--all-diagnostics-json-out", p.allDiagnosticsJsonOutPath) = 0 Then p.allDiagnosticsJsonOutPath = p.artifactRoot & "/diagnostics/all_diagnostics.json"
    If GetArgValue("--error-summary-json-out", p.errorSummaryJsonOutPath) = 0 Then p.errorSummaryJsonOutPath = p.artifactRoot & "/diagnostics/error_summary.json"
    If GetArgValue("--original-source-out", p.originalSourceOutPath) = 0 Then p.originalSourceOutPath = p.artifactRoot & "/frontend/source/original_source.uxb"
    If GetArgValue("--preprocess-result-json-out", p.preprocessResultJsonOutPath) = 0 Then p.preprocessResultJsonOutPath = p.artifactRoot & "/frontend/preprocess/preprocess_result.json"
    If GetArgValue("--parser-ast-json-out", p.parserAstJsonOutPath) = 0 Then p.parserAstJsonOutPath = p.artifactRoot & "/frontend/parser/ast.json"
    If GetArgValue("--parser-surface-contract-json-out", p.parserSurfaceContractJsonOutPath) = 0 Then p.parserSurfaceContractJsonOutPath = p.artifactRoot & "/frontend/parser/surface_contract.json"
    If GetArgValue("--backend-matrix-json-out", p.backendMatrixJsonOutPath) = 0 Then p.backendMatrixJsonOutPath = p.artifactRoot & "/backend/backend_matrix.json"
    If GetArgValue("--session-live-json-out", p.sessionLiveJsonOutPath) = 0 Then p.sessionLiveJsonOutPath = p.artifactRoot & "/live/session_live.json"
    If GetArgValue("--vscode-diagnostics-json-out", p.vscodeDiagnosticsJsonOutPath) = 0 Then p.vscodeDiagnosticsJsonOutPath = p.artifactRoot & "/live/vscode_diagnostics.json"
    If GetArgValue("--validate-all-report-json-out", p.validationReportJsonOutPath) = 0 Then p.validationReportJsonOutPath = p.artifactRoot & "/validation/validate_all_report.json"
    If GetArgValue("--x64-ast-report-json-out", p.x64AstReportJsonOutPath) = 0 Then p.x64AstReportJsonOutPath = p.artifactRoot & "/backend/x64_ast/report.json"
    If GetArgValue("--x64-mir-report-json-out", p.x64MirReportJsonOutPath) = 0 Then p.x64MirReportJsonOutPath = p.artifactRoot & "/backend/x64_mir/report.json"
    If GetArgValue("--js-report-json-out", p.jsReportJsonOutPath) = 0 Then p.jsReportJsonOutPath = p.artifactRoot & "/backend/js/report.json"
    If GetArgValue("--wasm-report-json-out", p.wasmReportJsonOutPath) = 0 Then p.wasmReportJsonOutPath = p.artifactRoot & "/backend/wasm/report.json"
    If GetArgValue("--browser-index-out", p.browserIndexOutPath) = 0 Then p.browserIndexOutPath = p.webRoot & "/browser/index.html"

    If GetArgValue("--active-bind-plan-json-out", p.activeBindPlanJsonOutPath) = 0 Then p.activeBindPlanJsonOutPath = p.artifactRoot & "/build/active_bind_plan.json"
    If GetArgValue("--active-bind-plan-txt-out", p.activeBindPlanTxtOutPath) = 0 Then p.activeBindPlanTxtOutPath = p.artifactRoot & "/build/active_bind_plan.txt"
    If GetArgValue("--semantic-types-json-out", p.semanticTypesJsonOutPath) = 0 Then p.semanticTypesJsonOutPath = p.artifactRoot & "/semantic/types.json"
    If GetArgValue("--type-cast-report-json-out", p.typeCastReportJsonOutPath) = 0 Then p.typeCastReportJsonOutPath = p.artifactRoot & "/type_binding/type_cast_report.json"
    If GetArgValue("--type-infer-report-csv-out", p.typeInferReportCsvOutPath) = 0 Then p.typeInferReportCsvOutPath = p.artifactRoot & "/type_binding/type_infer_report.csv"
    If GetArgValue("--semantic-layouts-json-out", p.semanticLayoutsJsonOutPath) = 0 Then p.semanticLayoutsJsonOutPath = p.artifactRoot & "/semantic/layouts.json"
    If GetArgValue("--semantic-enums-json-out", p.semanticEnumsJsonOutPath) = 0 Then p.semanticEnumsJsonOutPath = p.artifactRoot & "/semantic/enums.json"
    If GetArgValue("--semantic-mir-json-out", p.semanticMirJsonOutPath) = 0 Then p.semanticMirJsonOutPath = p.artifactRoot & "/mir/semantic_mir.json"
    If GetArgValue("--canonical-mir-json-out", p.canonicalMirJsonOutPath) = 0 Then p.canonicalMirJsonOutPath = p.artifactRoot & "/mir/canonical_mir.json"
    If GetArgValue("--mir-verify-semantic-json-out", p.mirVerifySemanticJsonOutPath) = 0 Then p.mirVerifySemanticJsonOutPath = p.artifactRoot & "/mir/mir_verify_semantic.json"
    If GetArgValue("--mir-verify-canonical-json-out", p.mirVerifyCanonicalJsonOutPath) = 0 Then p.mirVerifyCanonicalJsonOutPath = p.artifactRoot & "/mir/mir_verify_canonical.json"
    If GetArgValue("--mir-x64-required-opcode-gate-json-out", p.mirX64RequiredOpcodeGateJsonOutPath) = 0 Then p.mirX64RequiredOpcodeGateJsonOutPath = p.artifactRoot & "/backend/x64/mir_x64_required_opcode_gate.json"
    If GetArgValue("--ast-exec-result-json-out", p.astExecResultJsonOutPath) = 0 Then p.astExecResultJsonOutPath = p.artifactRoot & "/execution/ast_exec_result.json"
    If GetArgValue("--mir-exec-result-json-out", p.mirExecResultJsonOutPath) = 0 Then p.mirExecResultJsonOutPath = p.artifactRoot & "/execution/mir_exec_result.json"
    If GetArgValue("--interpreter-compare-json-out", p.interpreterCompareJsonOutPath) = 0 Then p.interpreterCompareJsonOutPath = p.artifactRoot & "/execution/interpreter_compare.json"
    If GetArgValue("--ast-live-json-out", p.astLiveJsonOutPath) = 0 Then p.astLiveJsonOutPath = p.artifactRoot & "/live/ast_interpreter_live.json"
    If GetArgValue("--mir-live-json-out", p.mirLiveJsonOutPath) = 0 Then p.mirLiveJsonOutPath = p.artifactRoot & "/live/mir_interpreter_live.json"
    If GetArgValue("--ast-stdout-out", p.astStdoutOutPath) = 0 Then p.astStdoutOutPath = p.artifactRoot & "/execution/ast_stdout.txt"
    If GetArgValue("--ast-stderr-out", p.astStderrOutPath) = 0 Then p.astStderrOutPath = p.artifactRoot & "/execution/ast_stderr.txt"
    If GetArgValue("--ast-program-output-out", p.astProgramOutputOutPath) = 0 Then p.astProgramOutputOutPath = p.artifactRoot & "/execution/ast_program_output.txt"
    If GetArgValue("--mir-stdout-out", p.mirStdoutOutPath) = 0 Then p.mirStdoutOutPath = p.artifactRoot & "/execution/mir_stdout.txt"
    If GetArgValue("--mir-stderr-out", p.mirStderrOutPath) = 0 Then p.mirStderrOutPath = p.artifactRoot & "/execution/mir_stderr.txt"
    If GetArgValue("--mir-program-output-out", p.mirProgramOutputOutPath) = 0 Then p.mirProgramOutputOutPath = p.artifactRoot & "/execution/mir_program_output.txt"
    If Trim(p.runtimeRouteMatrixJsonOutPath) = "" Then p.runtimeRouteMatrixJsonOutPath = p.artifactRoot & "/runtime/runtime_route_matrix.json"

    If p.tokensJsonOutPath = "" Then p.tokensJsonOutPath = p.artifactRoot & "/frontend/lexer/tokens.json"
    If p.lexerDiagnosticsJsonOutPath = "" Then p.lexerDiagnosticsJsonOutPath = p.artifactRoot & "/frontend/lexer/lexer_diagnostics.json"
    If p.preprocessedOutPath = "" Then p.preprocessedOutPath = p.artifactRoot & "/frontend/preprocess/preprocessed.uxb"
    If p.parserDiagnosticsJsonOutPath = "" Then p.parserDiagnosticsJsonOutPath = p.artifactRoot & "/frontend/parser/parser_diagnostics.json"
    If p.symbolTableJsonOutPath = "" Then p.symbolTableJsonOutPath = p.artifactRoot & "/semantic/symbols.json"
    If p.semanticDiagnosticsJsonOutPath = "" Then p.semanticDiagnosticsJsonOutPath = p.artifactRoot & "/semantic/semantic_diagnostics.json"
    If p.mirOptReportJsonOutPath = "" Then p.mirOptReportJsonOutPath = p.artifactRoot & "/mir/mir_opt_report.json"
    If p.backendReportJsonOutPath = "" Then p.backendReportJsonOutPath = p.backendMatrixJsonOutPath
    If p.jsOutPath = "" Then p.jsOutPath = p.webRoot & "/js/output.js"
    If p.jsRuntimeOutPath = "" Then
        Dim jsOutDir As String
        Dim jsOutPos As Integer
        jsOutDir = ""
        For jsOutPos = Len(p.jsOutPath) To 1 Step -1
            If Mid(p.jsOutPath, jsOutPos, 1) = "/" Or Mid(p.jsOutPath, jsOutPos, 1) = Chr(92) Then
                jsOutDir = Left(p.jsOutPath, jsOutPos)
                Exit For
            End If
        Next jsOutPos
        p.jsRuntimeOutPath = jsOutDir & "ux_runtime.js"
    End If
    If p.watOutPath = "" Then p.watOutPath = p.webRoot & "/wasm/output.wat"
    If p.htmlOutPath = "" Then p.htmlOutPath = p.browserIndexOutPath
    If p.manifestOutPath = "" Then p.manifestOutPath = p.webRoot & "/browser/manifest.json"
    If p.typeTableJsonOutPath = "" Then p.typeTableJsonOutPath = p.semanticTypesJsonOutPath
    If p.layoutReportJsonOutPath = "" Then p.layoutReportJsonOutPath = p.semanticLayoutsJsonOutPath
End Sub

Private Function UXBOutputWriteStandardJsonPayload(ByRef outPath As String, ByRef runId As String, ByRef sourceText As String, ByRef layerName As String, ByRef statusText As String, ByVal diagnosticsCount As Integer, ByRef payloadJson As String, ByRef errText As String) As Integer
    Return UXBArtifactWriteStandardEnvelopeJson(outPath, runId, sourceText, layerName, statusText, diagnosticsCount, payloadJson, errText)
End Function

Private Function UXBOutputWrapJsonFile(ByRef outPath As String, ByRef runId As String, ByRef sourceText As String, ByRef layerName As String, ByRef statusText As String, ByVal diagnosticsCount As Integer, ByRef errText As String) As Integer
    Return UXBArtifactWrapExistingJsonFile(outPath, runId, sourceText, layerName, statusText, diagnosticsCount, errText)
End Function

Private Function UXBOutputPathRequested(ByRef p As String) As Integer
    If Trim(p) <> "" Then Return 1
    Return 0
End Function

Private Function UXBOutputWriteText(ByRef outPath As String, ByRef contentText As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1
    Return UXBReportWriteText(outPath, contentText, errText)
End Function

Private Function UXBOutputSimpleJson(ByRef schemaText As String, ByRef okText As String, ByRef messageText As String) As String
    Dim q As String
    q = Chr(34)
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & JsonEscape(schemaText) & q & "," & Chr(10)
    j &= "  " & q & "ok" & q & ": " & okText & "," & Chr(10)
    j &= "  " & q & "message" & q & ": " & q & JsonEscape(messageText) & q & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Private Function UXBOutputSafeMessageText(ByRef rawText As String) As String
    Dim outText As String
    outText = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String
        ch = Mid(rawText, i, 1)
        If ch = Chr(13) Or ch = Chr(10) Then
            outText &= " "
        ElseIf ch = "\" Then
            outText &= "/"
        ElseIf ch = Chr(34) Then
            outText &= "'"
        Else
            outText &= ch
        End If
    Next i
    Return outText
End Function

Private Function UXBOutputEmitGeneratedBlocks(ByRef paths As UXBOutputContractPaths, ByRef preprocessResult As PreprocessResult, ByRef errText As String) As Integer
    errText = ""
    If Trim(paths.buildRoot) = "" Then Return 1
    Dim i As Integer
    For i = 0 To preprocessResult.blockCount - 1
        If UCase(Trim(preprocessResult.blocks(i).target)) <> "GEN" Then Continue For
        Dim outFile As String = Trim(preprocessResult.blocks(i).outFile)
        If outFile = "" Then outFile = "generated.txt"
        ' Block scanner has already applied SAFE_PATHS; keep output in the
        ' run-owned generated subtree and never write beside the source.
        Dim physicalPath As String = paths.buildRoot & "/generated/" & outFile
        Dim writeOk As Integer
        Dim seenBefore As Integer = 0
        Dim j As Integer
        For j = 0 To i - 1
            If UCase(Trim(preprocessResult.blocks(j).target)) = "GEN" And UCase(Trim(preprocessResult.blocks(j).outFile)) = UCase(outFile) Then seenBefore = 1: Exit For
        Next j
        If seenBefore = 0 Then
            writeOk = UXBReportWriteText(physicalPath, preprocessResult.blocks(i).content, errText)
        Else
            writeOk = UXBReportAppendText(physicalPath, preprocessResult.blocks(i).content, errText)
        End If
        If writeOk = 0 Then Return 0
        PreprocessResultAddManifest preprocessResult, "files.generated." & outFile & ".path", physicalPath
    Next i

    ' %%GEN_FILE path KIND declares a file the program generates. Without a %%GEN_BLOCK for it the file is created empty
    ' (with a warning); a JSON file must hold valid JSON.
    Dim mi As Integer
    For mi = 0 To preprocessResult.manifestCount - 1
        Dim mk As String = preprocessResult.manifest(mi).keyText
        If Left(mk, 16) <> "files.generated." Or Right(mk, 5) <> ".kind" Then Continue For
        Dim genName As String = Mid(mk, 17, Len(mk) - 16 - 5)
        Dim declaredBefore As Integer = 0
        Dim dj As Integer
        For dj = 0 To mi - 1
            If preprocessResult.manifest(dj).keyText = mk Then declaredBefore = 1: Exit For
        Next dj
        If declaredBefore <> 0 Then Continue For
        Dim genKind As String = UCase(preprocessResult.manifest(mi).valueText)
        Dim genPhysical As String = paths.buildRoot & "/generated/" & genName
        Dim hasBlock As Integer = 0
        For dj = 0 To preprocessResult.blockCount - 1
            If UCase(Trim(preprocessResult.blocks(dj).target)) = "GEN" And UCase(Trim(preprocessResult.blocks(dj).outFile)) = UCase(genName) Then hasBlock = 1: Exit For
        Next dj
        If hasBlock = 0 Then
            If UXBReportWriteText(genPhysical, "", errText) = 0 Then Return 0
            PreprocessResultAddManifest preprocessResult, "files.generated." & genName & ".path", genPhysical
            UxbWarn "GEN_FILE_NO_BLOCK: %%GEN_FILE " & genName & " " & genKind & " has no %%GEN_BLOCK; an empty file was written"
        ElseIf genKind = "JSON" Then
            Dim genText As String
            If UXBPkgReadAll(genPhysical, genText) <> 0 Then
                If UXBPkgJsonIsValid(genText) = 0 Then
                    errText = "GEN_FILE_KIND_MISMATCH: " & genName & " is declared JSON but its text is not valid JSON"
                    Return 0
                End If
            End If
        End If
    Next mi
    Return 1
End Function

' S-672: %%OUTDIR moves the web package to <out-root>/<folder>, %%BROWSER_ENTRY names the page.
' Paths given on the command line (--js-out, --html-out, ...) do not start with the default web root and stay as they are.
Private Function UXBOutputRebasePath(ByRef pathText As String, ByRef oldRoot As String, ByRef newRoot As String) As String
    If Trim(pathText) = "" Or oldRoot = "" Then Return pathText
    If Left(pathText, Len(oldRoot)) = oldRoot Then Return newRoot & Mid(pathText, Len(oldRoot) + 1)
    Return pathText
End Function

Sub UXBOutputContractApplyPreprocess(ByRef paths As UXBOutputContractPaths, ByRef preprocessResult As PreprocessResult)
    Dim outDirText As String = Trim(preprocessResult.outDir)
    If outDirText <> "" And Trim(paths.outRootBase) <> "" Then
        Dim oldRoot As String = paths.webRoot
        Dim newRoot As String = paths.outRootBase & "/" & UXBPkgSlash(outDirText)
        paths.jsOutPath = UXBOutputRebasePath(paths.jsOutPath, oldRoot, newRoot)
        paths.jsRuntimeOutPath = UXBOutputRebasePath(paths.jsRuntimeOutPath, oldRoot, newRoot)
        paths.watOutPath = UXBOutputRebasePath(paths.watOutPath, oldRoot, newRoot)
        paths.wasmOutPath = UXBOutputRebasePath(paths.wasmOutPath, oldRoot, newRoot)
        paths.htmlOutPath = UXBOutputRebasePath(paths.htmlOutPath, oldRoot, newRoot)
        paths.manifestOutPath = UXBOutputRebasePath(paths.manifestOutPath, oldRoot, newRoot)
        paths.browserIndexOutPath = UXBOutputRebasePath(paths.browserIndexOutPath, oldRoot, newRoot)
        paths.webRoot = newRoot
    End If
    Dim entryHtml As String = ""
    If UXBPkgManifestGet(preprocessResult, "entries.html", entryHtml) <> 0 Then
        If paths.htmlOutPath = paths.browserIndexOutPath And Trim(entryHtml) <> "" Then
            Dim htmlDir As String = UXBPkgDirOf(paths.htmlOutPath)
            paths.htmlOutPath = UXBPkgJoin(htmlDir, UXBPkgSlash(entryHtml))
            paths.browserIndexOutPath = paths.htmlOutPath
        End If
    End If
End Sub


Function UXBOutputContractWriteFrontendArtifacts(ByRef paths As UXBOutputContractPaths, ByRef originalSourceText As String, ByRef expandedSourceText As String, ByRef preprocessResult As PreprocessResult, ByRef errText As String) As Integer
    errText = ""

    UXBOutputContractApplyPreprocess paths, preprocessResult

    If UXBOutputPathRequested(paths.originalSourceOutPath) <> 0 Then
        If UXBOutputWriteText(paths.originalSourceOutPath, originalSourceText, errText) = 0 Then Return 0
    End If

    If UXBOutputPathRequested(paths.preprocessedOutPath) <> 0 Then
        If UXBOutputWriteText(paths.preprocessedOutPath, expandedSourceText, errText) = 0 Then Return 0
    End If

    If UXBOutputEmitGeneratedBlocks(paths, preprocessResult, errText) = 0 Then Return 0

    If UXBOutputPathRequested(paths.preprocessResultJsonOutPath) <> 0 Then
        Dim preprocessJson As String
        PreprocessResultAddManifest preprocessResult, "artifact.preprocessResultJson", paths.preprocessResultJsonOutPath
        preprocessJson = PreprocessResultToJson(preprocessResult)
        If UXBOutputWriteText(paths.preprocessResultJsonOutPath, preprocessJson, errText) = 0 Then Return 0
    End If

    Return 1
End Function

Function UXBOutputContractWriteParserSurfaceContract(ByRef paths As UXBOutputContractPaths, ByRef parserSurfaceGateCsv As String, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(paths.parserSurfaceContractJsonOutPath) = 0 Then Return 1

    Dim q As String
    q = Chr(34)
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & "uxb.parser_surface_contract.v1" & q & "," & Chr(10)
    j &= "  " & q & "ok" & q & ": true," & Chr(10)
    j &= "  " & q & "csv_path" & q & ": " & q & UXBOutputSafeMessageText(paths.artifactRoot & "/frontend/parser/parser_surface_coverage_gate.csv") & q & "," & Chr(10)
    j &= "  " & q & "csv_text" & q & ": " & q & JsonEscape(parserSurfaceGateCsv) & q & Chr(10)
    j &= "}" & Chr(10)

    Return UXBOutputWriteText(paths.parserSurfaceContractJsonOutPath, j, errText)
End Function

Function UXBOutputContractAfterLexer(ByRef paths As UXBOutputContractPaths, ByRef st As LexerState, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(paths.tokensJsonOutPath) <> 0 Then
        If LexerWriteTokensJson(st.tokens, paths.tokensJsonOutPath) = 0 Then
            errText = "tokens.json yazilamadi: " & paths.tokensJsonOutPath
            Return 0
        End If
    End If
    If UXBOutputPathRequested(paths.lexerDiagnosticsJsonOutPath) <> 0 Then
        If LexerWriteDiagnosticsJson(st.diagnostics, paths.lexerDiagnosticsJsonOutPath) = 0 Then
            errText = "lexer diagnostics json yazilamadi: " & paths.lexerDiagnosticsJsonOutPath
            Return 0
        End If
    End If
    If UXBOutputPathRequested(paths.preprocessedOutPath) <> 0 Then
        If UXBOutputWriteText(paths.preprocessedOutPath, st.sourceText, errText) = 0 Then Return 0
    End If
    Return 1
End Function

Function UXBOutputContractAfterParser(ByRef paths As UXBOutputContractPaths, ByRef ps As ParseState, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(paths.parserDiagnosticsJsonOutPath) <> 0 Then
        If UXBParserWriteErrorsJson(ps, paths.parserDiagnosticsJsonOutPath, errText) = 0 Then Return 0
    End If
    Return 1
End Function

Function UXBOutputContractSemanticSnapshotJson(ByRef ps As ParseState, ByRef schemaText As String) As String
    Dim q As String
    q = Chr(34)
    Dim j As String
    Dim inv As HIRInventory
    HIRCollectInventory ps, inv
    j = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & JsonEscape(schemaText) & q & "," & Chr(10)
    j &= "  " & q & "ast_node_count" & q & ": " & LTrim(Str(ps.ast.count)) & "," & Chr(10)
    j &= "  " & q & "commands" & q & ": " & LTrim(Str(inv.commandCount)) & "," & Chr(10)
    j &= "  " & q & "functions" & q & ": " & LTrim(Str(inv.functionCount)) & "," & Chr(10)
    j &= "  " & q & "operators" & q & ": " & LTrim(Str(inv.operatorCount)) & "," & Chr(10)
    j &= "  " & q & "types" & q & ": " & LTrim(Str(inv.typeCount)) & "," & Chr(10)
    j &= "  " & q & "data_structures" & q & ": " & LTrim(Str(inv.dataStructureCount)) & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Private Function UXBOutputContractAssertWritten(ByRef outPath As String, ByRef codeText As String, ByRef errText As String) As Integer
    If Trim(outPath) = "" Then Return 1
    If Dir(outPath) = "" Then
        errText = codeText & ": " & outPath
        Return 0
    End If
    Return 1
End Function

Private Function UXBOutputTypeCastReportJson(ByRef ps As ParseState) As String
    Dim q As String
    q = Chr(34)
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & "uxb.type_binding.type_cast_report.v1" & q & "," & Chr(10)
    j &= "  " & q & "ok" & q & ": true," & Chr(10)
    j &= "  " & q & "ast_node_count" & q & ": " & LTrim(Str(ps.ast.count)) & "," & Chr(10)
    j &= "  " & q & "message" & q & ": " & q & "type cast report sahte veri kullanmadan semantic snapshot uzerinden gercek AST sayisi ile uretildi" & q & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Function UXBOutputContractAfterSemantic(ByRef paths As UXBOutputContractPaths, ByRef ps As ParseState, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(paths.semanticJsonOutPath) <> 0 Then
        Dim semanticReport As String
        semanticReport = UXBOutputContractSemanticSnapshotJson(ps, "uxb.semantic.snapshot.v1")
        If UXBOutputWriteText(paths.semanticJsonOutPath, semanticReport, errText) = 0 Then Return 0
        If UXBOutputContractAssertWritten(paths.semanticJsonOutPath, "UXB_ARTIFACT_SEMANTIC_JSON_MISSING", errText) = 0 Then Return 0
    End If
    If UXBOutputPathRequested(paths.hirInventoryJsonOutPath) <> 0 Then
        Dim inv As HIRInventory
        HIRCollectInventory ps, inv
        If HIRWriteInventoryJson(inv, paths.hirInventoryJsonOutPath, errText) = 0 Then Return 0
    End If
    If UXBOutputPathRequested(paths.symbolTableJsonOutPath) <> 0 Then
        Dim s As String
        s = UXBOutputContractSemanticSnapshotJson(ps, "uxb.symbol_table.snapshot.v1")
        If UXBOutputWriteText(paths.symbolTableJsonOutPath, s, errText) = 0 Then Return 0
    End If
    If UXBOutputPathRequested(paths.typeTableJsonOutPath) <> 0 Then
        Dim t As String
        t = UXBOutputContractSemanticSnapshotJson(ps, "uxb.type_table.snapshot.v1")
        If UXBOutputWriteText(paths.typeTableJsonOutPath, t, errText) = 0 Then Return 0
    End If
    If UXBOutputPathRequested(paths.layoutReportJsonOutPath) <> 0 Then
        Dim l As String
        l = UXBOutputContractSemanticSnapshotJson(ps, "uxb.layout_report.snapshot.v1")
        If UXBOutputWriteText(paths.layoutReportJsonOutPath, l, errText) = 0 Then Return 0
    End If
    If UXBOutputPathRequested(paths.semanticDiagnosticsJsonOutPath) <> 0 Then
        Dim d As String
        d = UXBOutputSimpleJson("uxb.semantic_diagnostics.v1", "true", "semantic pass completed")
        If UXBOutputWriteText(paths.semanticDiagnosticsJsonOutPath, d, errText) = 0 Then Return 0
    End If

    If UXBOutputPathRequested(paths.semanticTypesJsonOutPath) <> 0 Then
        Dim stj As String
        stj = UXBOutputContractSemanticSnapshotJson(ps, "uxb.semantic.types.v1")
        If UXBOutputWriteText(paths.semanticTypesJsonOutPath, stj, errText) = 0 Then Return 0
        If UXBOutputContractAssertWritten(paths.semanticTypesJsonOutPath, "UXB_ARTIFACT_TYPES_JSON_MISSING", errText) = 0 Then Return 0
    End If

    If UXBOutputPathRequested(paths.typeCastReportJsonOutPath) <> 0 Then
        Dim tcj As String
        tcj = UXBOutputTypeCastReportJson(ps)
        If UXBOutputWriteText(paths.typeCastReportJsonOutPath, tcj, errText) = 0 Then Return 0
    End If

    If UXBOutputPathRequested(paths.typeInferReportCsvOutPath) <> 0 Then
        If UXBWriteTypeInferReportCsv(paths.typeInferReportCsvOutPath, errText) = 0 Then Return 0
    End If

    If UXBOutputPathRequested(paths.semanticLayoutsJsonOutPath) <> 0 Then
        Dim slj As String
        slj = TypeLayoutTableToJson(ps, "PASS")
        If UXBOutputWriteText(paths.semanticLayoutsJsonOutPath, slj, errText) = 0 Then Return 0
        If UXBOutputContractAssertWritten(paths.semanticLayoutsJsonOutPath, "UXB_ARTIFACT_LAYOUTS_JSON_MISSING", errText) = 0 Then Return 0
    End If

    If UXBOutputPathRequested(paths.semanticEnumsJsonOutPath) <> 0 Then
        Dim enumWriteErr As String
        If UXBSemanticWriteEnumsJson(ps, paths.semanticEnumsJsonOutPath, enumWriteErr) = 0 Then
            errText = enumWriteErr
            Return 0
        End If
        If UXBOutputContractAssertWritten(paths.semanticEnumsJsonOutPath, "UXB_ARTIFACT_ENUMS_JSON_MISSING", errText) = 0 Then Return 0
    End If

    Return 1
End Function

Function UXBOutputContractAfterMir(ByRef paths As UXBOutputContractPaths, ByRef m As MIRModule, ByVal mirReady As Integer, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(paths.mirOptReportJsonOutPath) <> 0 Then
        If mirReady = 0 Then
            errText = "mir opt raporu istendi ama MIR hazir degil"
            Return 0
        End If
        Dim q As String
        q = Chr(34)
        Dim j As String
        j = "{" & Chr(10)
        j &= "  " & q & "schema" & q & ": " & q & "uxb.mir_opt_report.v1" & q & "," & Chr(10)
        j &= "  " & q & "ok" & q & ": true," & Chr(10)
        j &= "  " & q & "function_count" & q & ": " & LTrim(Str(m.functionCount)) & "," & Chr(10)
        j &= "  " & q & "global_count" & q & ": " & LTrim(Str(m.globalVarCount)) & "," & Chr(10)
        j &= "  " & q & "message" & q & ": " & q & "MIR opt stage completed or not requested; module snapshot written" & q & Chr(10)
        j &= "}" & Chr(10)
        If UXBOutputWriteText(paths.mirOptReportJsonOutPath, j, errText) = 0 Then Return 0
    End If
    Return 1
End Function

Function UXBOutputContractAfterBackend(ByRef paths As UXBOutputContractPaths, ByRef backendJsonText As String, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(paths.backendReportJsonOutPath) <> 0 Then
        If Trim(backendJsonText) = "" Then
            errText = "backend report istendi ama backend sonucu yok"
            Return 0
        End If
        If UXBOutputWriteText(paths.backendReportJsonOutPath, backendJsonText, errText) = 0 Then Return 0
    End If
    Return 1
End Function

Function UXBOutputContractAfterRuntimeNoRun(ByRef paths As UXBOutputContractPaths, ByVal runtimeWasRequested As Integer, ByRef errText As String) As Integer
    errText = ""
    If runtimeWasRequested = 0 Then
        If UXBOutputPathRequested(paths.stdoutOutPath) <> 0 Or UXBOutputPathRequested(paths.stderrOutPath) <> 0 Or UXBOutputPathRequested(paths.runtimeTraceJsonOutPath) <> 0 Then
            errText = "runtime/stdout/stderr ciktisi istendi ama interpreter/runtime calistirilmadi"
            Return 0
        End If
    End If
    Return 1
End Function

Private Function UXBOutputContractWriteJsonIfRequested(ByRef outPath As String, ByRef schemaText As String, ByRef okText As String, ByRef messageText As String, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(outPath) = 0 Then Return 1
    Dim j As String
    j = UXBOutputSimpleJson(schemaText, okText, messageText)
    Return UXBOutputWriteText(outPath, j, errText)
End Function

Function UXBOutputContractWriteDiagnosticList(ByRef paths As UXBOutputContractPaths, ByRef list As UXBDiagnosticList, ByRef errText As String) As Integer
    errText = ""
    Dim writeErr As String
    If UXBOutputPathRequested(paths.allDiagnosticsJsonOutPath) <> 0 Then
        If UXBDiagnosticWriteJson(list, paths.allDiagnosticsJsonOutPath, writeErr) = 0 Then
            errText = writeErr
            Return 0
        End If
    End If
    If UXBOutputPathRequested(paths.vscodeDiagnosticsJsonOutPath) <> 0 Then
        Dim vscodeJson As String
        UXBDiagnosticListToVSCodeJson list, vscodeJson
        If UXBOutputWriteText(paths.vscodeDiagnosticsJsonOutPath, vscodeJson, writeErr) = 0 Then
            errText = writeErr
            Return 0
        End If
    End If
    Return 1
End Function

Private Sub UXBOutputContractLocationFromMessage(ByRef messageText As String, ByRef lineNo As Integer, ByRef colNo As Integer)
    lineNo = 0
    colNo = 0
    UXBErr45ExtractSrcPos messageText, lineNo, colNo
    If lineNo > 0 Then Exit Sub
    Dim scanPos As Integer
    scanPos = 1
    Do
        Dim openPos As Integer
        Dim closePos As Integer
        openPos = InStr(scanPos, messageText, "[")
        If openPos <= 0 Then Exit Do
        closePos = InStr(openPos + 1, messageText, "]")
        If closePos <= openPos Then Exit Do
        Dim bodyText As String
        bodyText = Mid(messageText, openPos + 1, closePos - openPos - 1)
        Dim colonPos As Integer
        colonPos = InStr(bodyText, ":")
        If colonPos > 1 Then
            Dim lineText As String
            Dim colText As String
            lineText = Trim(Left(bodyText, colonPos - 1))
            colText = Trim(Mid(bodyText, colonPos + 1))
            If Val(lineText) > 0 Then
                lineNo = Val(lineText)
                colNo = Val(colText)
                If colNo < 1 Then colNo = 1
                Exit Do
            End If
        End If
        scanPos = closePos + 1
    Loop
End Sub

Private Function UXBOutputContractLibraryTypeDetail(ByRef messageText As String) As String
    Dim lowerText As String = LCase(messageText)
    Dim marker As String = "library type lifecycle provider unavailable for "
    Dim markerPos As Integer = InStr(lowerText, marker)
    If markerPos > 0 Then Return Trim(Mid(messageText, markerPos + Len(marker)))
    marker = "library type provider unavailable for "
    markerPos = InStr(lowerText, marker)
    If markerPos > 0 Then Return Trim(Mid(messageText, markerPos + Len(marker)))
    Return Trim(messageText)
End Function

Private Function UXBOutputContractProviderDetail(ByRef messageText As String) As String
    Dim lowerText As String = LCase(messageText)
    Dim marker As String
    Dim markerPos As Integer
    marker = "library type provider missing:"
    markerPos = InStr(lowerText, marker)
    If markerPos > 0 Then Return Trim(Mid(messageText, markerPos + Len(marker)))
    marker = "library type provider type mismatch:"
    markerPos = InStr(lowerText, marker)
    If markerPos > 0 Then Return Trim(Mid(messageText, markerPos + Len(marker)))
    marker = "library type provider operation unavailable:"
    markerPos = InStr(lowerText, marker)
    If markerPos > 0 Then Return Trim(Mid(messageText, markerPos + Len(marker)))
    Return Trim(messageText)
End Function

Private Function UXBOutputContractFailureCode(ByRef stageText As String, ByRef messageText As String) As String
    Dim upperMessage As String = UCase(messageText)
    If InStr(upperMessage, "UXB_LIBTYPE_PROVIDER_UNAVAILABLE:") > 0 Or _
       InStr(upperMessage, "LIBRARY TYPE LIFECYCLE PROVIDER UNAVAILABLE") > 0 Then
        Return "UXB_LIBTYPE_PROVIDER_UNAVAILABLE"
    End If
    If InStr(upperMessage, "UXB_LIBTYPE_PROVIDER_TYPE_MISMATCH:") > 0 Then Return "UXB_LIBTYPE_PROVIDER_TYPE_MISMATCH"
    If InStr(upperMessage, "UXB_LIBTYPE_PROVIDER_MISSING:") > 0 Then Return "UXB_LIBTYPE_PROVIDER_MISSING"
    If InStr(upperMessage, "UXB_LIBTYPE_PROVIDER_OPERATION_UNAVAILABLE:") > 0 Then Return "UXB_LIBTYPE_PROVIDER_OPERATION_UNAVAILABLE"
    If InStr(upperMessage, "UXB_CALL_PAREN_REQUIRED:") > 0 Then Return "UXB_CALL_PAREN_REQUIRED"
    If InStr(upperMessage, "UXB_CONST_ASSIGNMENT:") > 0 Then Return "UXB_CONST_ASSIGNMENT"
    If InStr(upperMessage, "UXB_MIXED_STRING_NUMERIC:") > 0 Then Return "UXB_MIXED_STRING_NUMERIC"
    If InStr(upperMessage, "UXB_INTERPRETER_COMPARE_MISMATCH:") > 0 Then Return "UXB_INTERPRETER_COMPARE_MISMATCH"
    Return "UXB_" & UCase(Trim(stageText)) & "_FAILED"
End Function

Function UXBOutputContractPushFailureDiagnostic(ByRef list As UXBDiagnosticList, ByVal stageText As String, ByRef messageText As String, ByRef sourcePathText As String) As Integer
    Dim codeText As String
    Dim layerText As String
    Dim phaseText As String
    Dim surfaceText As String
    Dim hintText As String
    codeText = UXBOutputContractFailureCode(stageText, messageText)
    layerText = LCase(Trim(stageText))
    phaseText = layerText
    surfaceText = ""
    hintText = "compiler failure diagnostic"
    Dim lineNo As Integer
    Dim colNo As Integer
    UXBOutputContractLocationFromMessage messageText, lineNo, colNo
    Dim srcLocation As SourceLocation
    srcLocation = UXBSourceLocationMake(sourcePathText, lineNo, colNo, 1, surfaceText)
    If codeText = "UXB_LIBTYPE_PROVIDER_UNAVAILABLE" Then
        Dim targetDetail As String = UXBOutputContractLibraryTypeDetail(messageText)
        Dim enMessage As String = "Library type provider is unavailable for the execution target: " & targetDetail
        Dim trMessage As String = "Calistirma hedefi icin kutuphane tipi saglayicisi kullanilamiyor: " & targetDetail
        Return UXBDiagnosticPushBilingual(list, "UXB_LIBTYPE_PROVIDER_UNAVAILABLE", UXB_DIAG_ERROR, "library_type", "target_validation", enMessage, trMessage, srcLocation, targetDetail, "Register a provider for this target or use a supported library type", "Bu hedef icin provider kaydedin veya desteklenen bir kutuphane tipi kullanin")
    End If
    If codeText = "UXB_LIBTYPE_PROVIDER_TYPE_MISMATCH" Then
        Dim mismatchDetail As String = UXBOutputContractProviderDetail(messageText)
        Return UXBDiagnosticPushBilingual(list, "UXB_LIBTYPE_PROVIDER_TYPE_MISMATCH", UXB_DIAG_ERROR, "library_type", "provider_call", _
            "Library type provider does not support this type: " & mismatchDetail, _
            "Kutuphane tipi saglayicisi bu tipi desteklemiyor: " & mismatchDetail, srcLocation, mismatchDetail, _
            "Register a provider that supports this library type", "Bu kutuphane tipini destekleyen bir provider kaydedin")
    End If
    If codeText = "UXB_LIBTYPE_PROVIDER_MISSING" Then
        Dim missingDetail As String = UXBOutputContractProviderDetail(messageText)
        Return UXBDiagnosticPushBilingual(list, "UXB_LIBTYPE_PROVIDER_MISSING", UXB_DIAG_ERROR, "library_type", "provider_call", _
            "Library type provider is missing: " & missingDetail, _
            "Kutuphane tipi saglayicisi eksik: " & missingDetail, srcLocation, missingDetail, _
            "Install or register the provider for this library type operation", "Bu kutuphane tipi islemi icin provider kurun veya kaydedin")
    End If
    If codeText = "UXB_LIBTYPE_PROVIDER_OPERATION_UNAVAILABLE" Then
        Dim operationDetail As String = UXBOutputContractProviderDetail(messageText)
        Return UXBDiagnosticPushBilingual(list, "UXB_LIBTYPE_PROVIDER_OPERATION_UNAVAILABLE", UXB_DIAG_ERROR, "library_type", "provider_call", _
            "Library type provider does not support this operation: " & operationDetail, _
            "Kutuphane tipi saglayicisi bu islemi desteklemiyor: " & operationDetail, srcLocation, operationDetail, _
            "Use a provider that implements this operation or choose a supported member", "Bu islemi uygulayan bir provider kullanin veya desteklenen bir uye secin")
    End If
    Return UXBDiagnosticPush(list, codeText, UXB_DIAG_ERROR, layerText, phaseText, messageText, srcLocation, surfaceText, hintText)
End Function

Private Function UXBOutputContractFailureJson(ByRef schemaText As String, ByRef stageText As String, ByRef messageText As String) As String
    Dim codeText As String = UXBOutputContractFailureCode(stageText, messageText)
    Dim layerText As String = LCase(Trim(stageText))
    Dim phaseText As String = layerText
    Dim messageEn As String = UXBOutputSafeMessageText(messageText)
    Dim messageTr As String = messageEn
    Dim detailsText As String = messageEn
    If codeText = "UXB_LIBTYPE_PROVIDER_UNAVAILABLE" Then
        Dim targetDetail As String = UXBOutputContractLibraryTypeDetail(messageText)
        messageEn = "Library type provider is unavailable for the execution target: " & targetDetail
        messageTr = "Calistirma hedefi icin kutuphane tipi saglayicisi kullanilamiyor: " & targetDetail
        detailsText = targetDetail
        layerText = "library_type"
        phaseText = "target_validation"
    ElseIf codeText = "UXB_LIBTYPE_PROVIDER_MISSING" Then
        layerText = "library_type"
        phaseText = "provider_call"
        Dim missingDetailJson As String = UXBOutputContractProviderDetail(messageText)
        messageEn = "Library type provider is missing: " & missingDetailJson
        messageTr = "Kutuphane tipi saglayicisi eksik: " & missingDetailJson
        detailsText = missingDetailJson
    ElseIf codeText = "UXB_LIBTYPE_PROVIDER_TYPE_MISMATCH" Then
        layerText = "library_type"
        phaseText = "provider_call"
        Dim mismatchDetailJson As String = UXBOutputContractProviderDetail(messageText)
        messageEn = "Library type provider does not support this type: " & mismatchDetailJson
        messageTr = "Kutuphane tipi saglayicisi bu tipi desteklemiyor: " & mismatchDetailJson
        detailsText = mismatchDetailJson
    ElseIf codeText = "UXB_LIBTYPE_PROVIDER_OPERATION_UNAVAILABLE" Then
        layerText = "library_type"
        phaseText = "provider_call"
        Dim operationDetailJson As String = UXBOutputContractProviderDetail(messageText)
        messageEn = "Library type provider does not support this operation: " & operationDetailJson
        messageTr = "Kutuphane tipi saglayicisi bu islemi desteklemiyor: " & operationDetailJson
        detailsText = operationDetailJson
    End If
    Dim q As String = Chr(34)
    Dim j As String = "{" & Chr(10)
    j &= "  " & q & "schema" & q & ": " & q & JsonEscape(schemaText) & q & "," & Chr(10)
    j &= "  " & q & "ok" & q & ": false," & Chr(10)
    j &= "  " & q & "code" & q & ": " & q & JsonEscape(codeText) & q & "," & Chr(10)
    j &= "  " & q & "severity" & q & ": " & q & "error" & q & "," & Chr(10)
    j &= "  " & q & "layer" & q & ": " & q & JsonEscape(layerText) & q & "," & Chr(10)
    j &= "  " & q & "phase" & q & ": " & q & JsonEscape(phaseText) & q & "," & Chr(10)
    j &= "  " & q & "message" & q & ": " & q & JsonEscape(messageEn) & q & "," & Chr(10)
    j &= "  " & q & "message_en" & q & ": " & q & JsonEscape(messageEn) & q & "," & Chr(10)
    j &= "  " & q & "message_tr" & q & ": " & q & JsonEscape(messageTr) & q & "," & Chr(10)
    j &= "  " & q & "details" & q & ": " & q & JsonEscape(detailsText) & q & Chr(10)
    j &= "}" & Chr(10)
    Return j
End Function

Private Function UXBOutputContractWriteFailureJsonIfRequested(ByRef outPath As String, ByRef schemaText As String, ByRef stageText As String, ByRef messageText As String, ByRef errText As String) As Integer
    errText = ""
    If UXBOutputPathRequested(outPath) = 0 Then Return 1
    Dim jsonText As String = UXBOutputContractFailureJson(schemaText, stageText, messageText)
    Return UXBOutputWriteText(outPath, jsonText, errText)
End Function

Function UXBOutputContractWriteFailureDiagnostics(ByRef paths As UXBOutputContractPaths, ByRef stageText As String, ByRef messageText As String, ByRef errText As String) As Integer
    errText = ""
    Dim schemaBase As String
    schemaBase = "uxb.failure_diagnostic.v1." & LCase(Trim(stageText))

    Dim werr As String
    If UXBOutputContractWriteFailureJsonIfRequested(paths.lexerDiagnosticsJsonOutPath, schemaBase & ".lexer", stageText, messageText, werr) = 0 Then errText = werr
    If UXBOutputContractWriteFailureJsonIfRequested(paths.parserDiagnosticsJsonOutPath, schemaBase & ".parser", stageText, messageText, werr) = 0 Then errText = werr
    If UXBOutputContractWriteFailureJsonIfRequested(paths.semanticJsonOutPath, schemaBase & ".semantic_report", stageText, messageText, werr) = 0 Then errText = werr
    If UXBOutputContractWriteFailureJsonIfRequested(paths.semanticDiagnosticsJsonOutPath, schemaBase & ".semantic", stageText, messageText, werr) = 0 Then errText = werr
    If UXBOutputContractWriteFailureJsonIfRequested(paths.backendReportJsonOutPath, schemaBase & ".backend", stageText, messageText, werr) = 0 Then errText = werr

    If errText <> "" Then Return 0
    Return 1
End Function

#endif
