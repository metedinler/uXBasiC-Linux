#include once "layout_shared_core.fbs"
#include once "layout_path_resolution.fbs"

Private Function TryExtractTypeNameArg(ByRef ps As ParseState, ByVal callNode As Integer, ByVal argPos As Integer, ByRef typeNameOut As String) As Integer
    Dim argNode As Integer
    argNode = LayoutChildAt(ps, callNode, argPos)
    If argNode = -1 Then Return 0

    Select Case UCase(ps.ast.nodes(argNode).kind)
    Case "IDENT", "KEYWORD_REF"
        typeNameOut = ps.ast.nodes(argNode).value
        Return 1
    End Select

    Return 0
End Function

Private Function MemoryAccessWidthBytes(ByRef opName As String) As Integer
    Select Case UCase(opName)
    Case "PEEKB", "POKEB"
        Return 1
    Case "PEEKW", "POKEW"
        Return 2
    Case "PEEK", "PEEKD", "POKED", "POKE"
        Return 4
    Case "PEEKQ", "POKEQ"
        Return 8
    End Select

    Return 0
End Function

Private Function FindOffsetOfCallInExpr(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)

    If UCase(n.kind) = "CALL_EXPR" And UCase(n.value) = "OFFSETOF" Then Return nodeIdx

    If n.left <> -1 Then
        Dim fLeft As Integer
        fLeft = FindOffsetOfCallInExpr(ps, n.left)
        If fLeft <> -1 Then Return fLeft
    End If

    If n.right <> -1 Then
        Dim fRight As Integer
        fRight = FindOffsetOfCallInExpr(ps, n.right)
        If fRight <> -1 Then Return fRight
    End If

    Dim ch As Integer
    ch = n.firstChild
    Do While ch <> -1
        Dim fChild As Integer
        fChild = FindOffsetOfCallInExpr(ps, ch)
        If fChild <> -1 Then Return fChild
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return -1
End Function

Private Function ValidateMemWidthAgainstOffsetOf(ByRef ps As ParseState, ByVal addrExprNode As Integer, ByRef opName As String, ByRef errOut As String) As Integer
    Dim offsetCall As Integer
    offsetCall = FindOffsetOfCallInExpr(ps, addrExprNode)
    If offsetCall = -1 Then Return 1

    Dim baseType As String
    Dim pathNode As Integer
    Dim offBytes As Integer
    Dim targetTypeName As String
    Dim targetSize As Integer
    Dim pathText As String

    If TryExtractTypeNameArg(ps, offsetCall, 0, baseType) = 0 Then
        errOut = "OFFSETOF expects a type name as first argument"
        Return 0
    End If

    pathNode = LayoutChildAt(ps, offsetCall, 1)
    If pathNode = -1 Or UCase(ps.ast.nodes(pathNode).kind) <> "STRING" Then
        errOut = "OFFSETOF expects a string path as second argument"
        Return 0
    End If
    pathText = ps.ast.nodes(pathNode).value

    If TypeLayoutResolvePath(ps, baseType, pathText, offBytes, targetTypeName, targetSize, errOut) = 0 Then
        Return 0
    End If

    Dim expectedWidth As Integer
    expectedWidth = MemoryAccessWidthBytes(opName)
    If expectedWidth = 0 Then Return 1

    If targetSize <> expectedWidth Then
        errOut = UCase(opName) & " width mismatch: expected=" & LTrim(Str(expectedWidth)) & _
                 " got=" & LTrim(Str(targetSize)) & _
                 " fieldType=" & UCase(targetTypeName) & _
                 " path=" & UCase(baseType) & "." & pathText
        Return 0
    End If

    Return 1
End Function

Private Function MemoryModeChildOffset(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim firstNode As Integer
    firstNode = LayoutChildAt(ps, nodeIdx, 0)
    If firstNode = -1 Then Return 0
    If UCase(ps.ast.nodes(firstNode).kind) <> "KEYWORD_REF" Then Return 0
    Dim modeName As String
    modeName = UCase(Trim(ps.ast.nodes(firstNode).value))
    If modeName = "VIRTUAL" Or modeName = "NATIVE" Then Return 1
    Return 0
End Function

Function ValidateLayoutIntrinsicSemantics(ByRef ps As ParseState, ByVal deferClassArrayShape As Integer = 0) As Integer
    Dim i As Integer

    For i = 0 To ps.ast.count - 1
        Dim nKind As String
        nKind = UCase(ps.ast.nodes(i).kind)

        If nKind = "CALL_EXPR" Then
            Dim callName As String
            callName = UCase(ps.ast.nodes(i).value)

            If callName = "SIZEOF" Then
                Dim tName As String
                Dim sz As Integer
                Dim errText As String

                Dim sizeofArgNode As Integer
                Dim sizeofResolvedAsArray As Integer
                sizeofResolvedAsArray = 0
                sizeofArgNode = LayoutChildAt(ps, i, 0)
                If sizeofArgNode <> -1 And UCase(Trim(ps.ast.nodes(sizeofArgNode).kind)) = "IDENT" Then
                    Dim deferParameterShape As Integer = 0
                    If deferClassArrayShape <> 0 Then
                        For parameter As Integer = 0 To ps.ast.count - 1
                            If ps.ast.nodes(parameter).kind <> "PARAM_DECL" Then Continue For
                            If UCase(ps.ast.nodes(parameter).value) <> UCase(ps.ast.nodes(sizeofArgNode).value) Then Continue For
                            Dim part As Integer = ps.ast.nodes(parameter).firstChild
                            Do While part >= 0
                                If ps.ast.nodes(part).kind = "TYPE_REF" Then
                                    Dim parameterType As String = ps.ast.nodes(part).value
                                    If Right(parameterType, 2) = "[]" Then
                                        Dim classLayout As Integer = FindTypeLayoutIndex(Left(parameterType, Len(parameterType)-2))
                                        If classLayout >= 0 AndAlso UCase(gTypeLayouts(classLayout).recordKind) = "CLASS" Then deferParameterShape = 1
                                    End If
                                End If
                                part = ps.ast.nodes(part).nextSibling
                            Loop
                        Next parameter
                    End If
                    If deferParameterShape <> 0 Then Continue For
                    Dim arrayInfo As UXBArrayMemoryInfo
                    Dim arrayErr As String
                    If UXBFindArrayMemoryInfo(ps, ps.ast.nodes(sizeofArgNode).value, arrayInfo, arrayErr) = 0 Then
                        ' Parsing precedes CLASS shape normalization. Defer this
                        ' specific case to the mandatory semantic/layout gate;
                        ' it runs again after SIZEOF becomes the source byte size.
                        If deferClassArrayShape <> 0 And arrayInfo.found <> 0 And arrayErr = "memory-ref currently requires a one-dimensional array" Then
                            Dim classLayout As Integer = FindTypeLayoutIndex(arrayInfo.elementType)
                            If classLayout >= 0 AndAlso UCase(gTypeLayouts(classLayout).recordKind) = "CLASS" Then Continue For
                        End If
                        ps.lastError = "SIZEOF(array) failed: " & arrayErr
                        Return 0
                    End If
                    If arrayInfo.found <> 0 Then
                        sizeofResolvedAsArray = 1
                        If arrayInfo.dynamicBounds <> 0 Then
                            If deferClassArrayShape <> 0 Then
                                Dim classLayout As Integer = FindTypeLayoutIndex(arrayInfo.elementType)
                                If classLayout >= 0 AndAlso UCase(gTypeLayouts(classLayout).recordKind) = "CLASS" Then Continue For
                            End If
                            ps.lastError = "SIZEOF(array) requires compile-time array bounds"
                            Return 0
                        End If
                        sz = CInt(arrayInfo.byteLength)
                    End If
                    ' If the identifier isn't a declared array, it may still be a type
                    ' name (STRUCT/UNION/TYPE/CLASS) written as a bare identifier --
                    ' fall through to the type-name path below instead of failing here.
                    ' (Found 2026-09-06: a plain SIZEOF(TypeName) was rejected outright
                    ' once array support was added, with no fallback -- a regression.)
                End If
                If sizeofResolvedAsArray = 0 Then
                    If TryExtractTypeNameArg(ps, i, 0, tName) = 0 Then
                        ps.lastError = "SIZEOF expects a type name or array identifier"
                        Return 0
                    End If
                    If TypeLayoutSizeOf(ps, tName, sz, errText) = 0 Then
                        ps.lastError = errText
                        Return 0
                    End If
                End If
            ElseIf callName = "OFFSETOF" Then
                Dim baseType As String
                Dim pathNode As Integer
                Dim off As Integer
                Dim errText2 As String

                If TryExtractTypeNameArg(ps, i, 0, baseType) = 0 Then
                    ps.lastError = "OFFSETOF expects a type name as first argument"
                    Return 0
                End If

                pathNode = LayoutChildAt(ps, i, 1)
                If pathNode = -1 Or UCase(ps.ast.nodes(pathNode).kind) <> "STRING" Then
                    ps.lastError = "OFFSETOF expects a string path as second argument"
                    Return 0
                End If

                If TypeLayoutOffsetOf(ps, baseType, ps.ast.nodes(pathNode).value, off, errText2) = 0 Then
                    ps.lastError = errText2
                    Return 0
                End If
            ElseIf callName = "PEEK" Or callName = "PEEKB" Or callName = "PEEKW" Or callName = "PEEKD" Or callName = "PEEKQ" Then
                Dim addrNode As Integer
                Dim errText3 As String
                addrNode = LayoutChildAt(ps, i, MemoryModeChildOffset(ps, i))
                If addrNode = -1 Then
                    ps.lastError = callName & " address argument missing"
                    Return 0
                End If
                If ValidateMemWidthAgainstOffsetOf(ps, addrNode, callName, errText3) = 0 Then
                    ps.lastError = errText3
                    Return 0
                End If
            End If
        ElseIf nKind = "POKEB_STMT" Or nKind = "POKEW_STMT" Or nKind = "POKED_STMT" Or nKind = "POKEQ_STMT" Then
            Dim stmtName As String
            Dim addrNode2 As Integer
            Dim errText4 As String

            If nKind = "POKEB_STMT" Then
                stmtName = "POKEB"
            ElseIf nKind = "POKEW_STMT" Then
                stmtName = "POKEW"
            ElseIf nKind = "POKED_STMT" Then
                stmtName = "POKED"
            Else
                stmtName = "POKEQ"
            End If

            addrNode2 = LayoutChildAt(ps, i, MemoryModeChildOffset(ps, i))
            If addrNode2 <> -1 Then
                If ValidateMemWidthAgainstOffsetOf(ps, addrNode2, stmtName, errText4) = 0 Then
                    ps.lastError = errText4
                    Return 0
                End If
            End If
        End If
    Next i

    Return 1
End Function
