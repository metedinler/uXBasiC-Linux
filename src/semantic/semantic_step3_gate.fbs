Declare Function Step3NodeDeclaredType(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef typeOut As String) As Integer

' The CLI output contract owns report locations. Embedded semantic users do
' not request reports unless they explicitly configure a destination.
Dim Shared gUXBStep3ReportRoot As String

Sub UXBSemanticStep3ConfigureReports(ByRef reportRoot As String)
    gUXBStep3ReportRoot = reportRoot
End Sub

Private Function Step3NodeKind(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return ""
    Return UCase(Trim(ps.ast.nodes(nodeIdx).kind))
End Function

Private Function Step3ParentKind(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return ""
    Dim p As Integer = ps.ast.nodes(nodeIdx).parent
    If p < 0 Or p >= ps.ast.count Then Return ""
    Return Step3NodeKind(ps, p)
End Function

Private Function Step3ChildAt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal childPos As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1
    Dim i As Integer = 0
    Dim ch As Integer = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If i = childPos Then Return ch
        i += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return -1
End Function

Private Function Step3FindChildByKind(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal kindText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1
    Dim targetKind As String = UCase(Trim(kindText))
    Dim ch As Integer = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If Step3NodeKind(ps, ch) = targetKind Then Return ch
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return -1
End Function

Private Function Step3HasNamedNode(ByRef ps As ParseState, ByRef kindText As String, ByRef nameText As String) As Integer
    Dim targetKind As String
    targetKind = UCase(Trim(kindText))
    Dim targetName As String
    targetName = UCase(Trim(nameText))
    If targetName = "" Then Return 0

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) = targetKind Then
            If UCase(Trim(ps.ast.nodes(i).value)) = targetName Then Return 1
        End If
    Next i
    Return 0
End Function

Private Function Step3HasConstDeclAnyScopeFix6(ByRef ps As ParseState, ByRef nameRaw As String) As Integer
    ' FIX6_RUNTIME_SEMANTIC_20260610:
    ' Include edilmiş CONST sembolü lexical resolver'da görünmezse AST üzerinde son güvenli kontrol.
    Dim target As String
    target = UCase(Trim(nameRaw))
    If target = "" Then Return 0
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) = "CONST_DECL" Or Step3NodeKind(ps, i) = "CONST_STMT" Then
            If UCase(Trim(ps.ast.nodes(i).value)) = target Then Return 1
        End If
    Next i
    Return 0
End Function

Private Function Step3ValidateSlotControlTarget(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef errText As String) As Integer
    Dim laneKind As String
    laneKind = UCase(Trim(ps.ast.nodes(nodeIdx).value))
    Dim targetExpr As Integer
    targetExpr = Step3ChildAt(ps, nodeIdx, 0)
    If targetExpr = -1 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "slot target missing", errText)

    If Step3NodeKind(ps, targetExpr) <> "IDENT" And Step3NodeKind(ps, targetExpr) <> "IDENTIFIER" Then
        Return UXBSemanticFail(SEM_E_INVALID_CALL, "slot target must be ident", errText)
    End If

    Dim targetName As String
    targetName = Trim(ps.ast.nodes(targetExpr).value)

    Select Case laneKind
    Case "THREAD"
        If Step3HasNamedNode(ps, "THREAD_STMT", targetName) = 0 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "unknown thread target: " & targetName, errText)
    Case "EVENT"
        If Step3HasNamedNode(ps, "EVENT_STMT", targetName) = 0 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "unknown event target: " & targetName, errText)
    Case "PIPE"
        If Step3HasNamedNode(ps, "PIPE_STMT", targetName) = 0 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "unknown pipe target: " & targetName, errText)
    Case "PARALEL"
        If Step3HasNamedNode(ps, "PARALEL_STMT", targetName) = 0 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "unknown paralel target: " & targetName, errText)
    End Select

    Dim slotExpr As Integer
    slotExpr = Step3ChildAt(ps, nodeIdx, 1)
    If slotExpr <> -1 Then
        If Step3NodeKind(ps, slotExpr) = "NUMBER" Then
            Dim slotNo As Integer
            slotNo = ValInt(ps.ast.nodes(slotExpr).value)
            If slotNo < 0 Or slotNo > 255 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "slot index out of range: " & ps.ast.nodes(slotExpr).value, errText)
        End If
    End If

    Return 1
End Function

' S-611 (2026-10-17): a class MEMBER routine (method, constructor, destructor, operator, property accessor, interface method) owns a scope of
' its own, nested in the class scope (UXBStep3ScopeParentSet): its parameters and locals no longer share one scope with every other member.
' Must stay identical to UXBStep3InferScopeForNode (type_infer_expr.fbs), which finds the scope of a use site.
Private Function Step3ScopeForNode(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim p As Integer = nodeIdx
    Do While p >= 0 And p < ps.ast.count
        Dim k As String = Step3NodeKind(ps, p)
        Select Case k
        Case "FUNCTION_STMT", "SUB_STMT", "CLASS_STMT", "TYPE_STMT", "ENUM_STMT", "INTERFACE_STMT", "MODULE_STMT", "NAMESPACE_STMT", _
             "CLASS_METHOD_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", "CLASS_OPERATOR_DECL", "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "INTERFACE_METHOD_DECL"
            Return p + 1
        End Select
        p = ps.ast.nodes(p).parent
    Loop
    Return 0
End Function

' The scope a member routine's NAME belongs to: the scope of its container (class / interface), not the member's own scope.
Private Function Step3ScopeForMemberDecl(ByRef ps As ParseState, ByVal memberNode As Integer) As Integer
    If memberNode < 0 Or memberNode >= ps.ast.count Then Return 0
    Dim containerNode As Integer = ps.ast.nodes(memberNode).parent
    If containerNode < 0 Or containerNode >= ps.ast.count Then Return 0
    Return Step3ScopeForNode(ps, containerNode)
End Function

Private Function Step3FindOwnerNode(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Return UXBAstFindOwner(ps, nodeIdx)
End Function

Private Function Step3FindAncestorClassNode(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    Dim p As Integer
    p = nodeIdx
    Dim guard As Integer
    guard = 0
    Do While p >= 0 And p < ps.ast.count
        If ps.ast.nodes(p).parent <> -1 Then Exit Do
        Dim owner As Integer
        owner = Step3FindOwnerNode(ps, p)
        If owner = -1 Or owner = p Then Exit Do
        p = owner
        guard += 1
        If guard > ps.ast.count Then Exit Do
    Loop
    Do While p >= 0 And p < ps.ast.count
        If Step3NodeKind(ps, p) = "CLASS_STMT" Then Return p
        p = ps.ast.nodes(p).parent
    Loop
    Return -1
End Function

Private Function Step3ImplicitClassFieldExists(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef fieldName As String) As Integer
    Dim classNode As Integer
    classNode = Step3FindAncestorClassNode(ps, nodeIdx)
    If classNode = -1 Then Return 0

    Dim target As String
    target = UCase(Trim(fieldName))
    Dim ch As Integer
    ch = ps.ast.nodes(classNode).firstChild
    Do While ch <> -1
        Dim ck As String
        ck = Step3NodeKind(ps, ch)
        If ck = "CLASS_FIELD" Or ck = "CLASS_PROPERTY_DECL" Then
            If UCase(Trim(ps.ast.nodes(ch).value)) = target Then Return 1
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Function Step3ImplicitClassFieldType(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef fieldName As String, ByRef typeOut As String) As Integer
    typeOut = ""
    Dim classNode As Integer
    classNode = Step3FindAncestorClassNode(ps, nodeIdx)
    If classNode = -1 Then Return 0

    Dim target As String
    target = UCase(Trim(fieldName))
    Dim ch As Integer
    ch = ps.ast.nodes(classNode).firstChild
    Do While ch <> -1
        Dim ck As String
        ck = Step3NodeKind(ps, ch)
        If ck = "CLASS_FIELD" Or ck = "CLASS_PROPERTY_DECL" Then
            If UCase(Trim(ps.ast.nodes(ch).value)) = target Then
                If Step3NodeDeclaredType(ps, ch, typeOut) <> 0 Then Return 1
                typeOut = TYPE_OBJECT
                Return 1
            End If
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Function Step3NodeDeclaredType(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef typeOut As String) As Integer
    typeOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    If Trim(ps.ast.nodes(nodeIdx).typeName) <> "" Then typeOut = UXBStep3TypeCanonical(ps.ast.nodes(nodeIdx).typeName): Return 1
    Dim tNode As Integer = Step3FindChildByKind(ps, nodeIdx, "TYPE_REF")
    If tNode <> -1 Then
        typeOut = UXBStep3TypeCanonical(ps.ast.nodes(tNode).value)
        Return IIf(Trim(typeOut) <> "", 1, 0)
    End If
    Return 0
End Function

Private Function Step3InferNodeDeclaredOrInitializerType(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef typeOut As String, ByRef errText As String) As Integer
    If Step3NodeDeclaredType(ps, nodeIdx, typeOut) <> 0 Then
        typeOut = UXBStep3TypeCanonical(typeOut)
        ps.ast.nodes(nodeIdx).typeName = typeOut
        errText = ""
        Return 1
    End If
    Dim initIdx As Integer = Step3FindChildByKind(ps, nodeIdx, "INIT_EXPR")
    If initIdx = -1 Then initIdx = Step3ChildAt(ps, nodeIdx, 0)
    ' S-139: the parser keeps a CONST_DECL's initializer in .left, not as a child, so an untyped
    ' `CONST K = 5` fell through to TYPE_OBJECT below and `flags AND K` / `flags OR K` /
    ' `K AND 3` were rejected ("integer or Boolean operands required for bit logic").
    If initIdx = -1 And Step3NodeKind(ps, nodeIdx) = "CONST_DECL" Then initIdx = ps.ast.nodes(nodeIdx).left
    If initIdx <> -1 Then
        If UXBAstContractIsExpressionNode(Step3NodeKind(ps, initIdx)) <> 0 Then
            If UXBStep3InferExprType(ps, initIdx, typeOut, errText) = 0 Then Return 0
            typeOut = UXBStep3TypeCanonical(typeOut)
            ps.ast.nodes(nodeIdx).typeName = typeOut
            errText = ""
            Return 1
        End If
    End If
    typeOut = TYPE_OBJECT
    ps.ast.nodes(nodeIdx).typeName = typeOut
    errText = ""
    Return 1
End Function


Private Function Step3NodeIsDescendantOf(ByRef ps As ParseState, ByVal ancestorIdx As Integer, ByVal nodeIdx As Integer) As Integer
    If ancestorIdx < 0 Or ancestorIdx >= ps.ast.count Then Return 0
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    If ancestorIdx = nodeIdx Then Return 1

    Dim ch As Integer
    ch = ps.ast.nodes(ancestorIdx).firstChild
    Do While ch <> -1
        If Step3NodeIsDescendantOf(ps, ch, nodeIdx) <> 0 Then Return 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If ps.ast.nodes(ancestorIdx).left <> -1 Then
        If Step3NodeIsDescendantOf(ps, ps.ast.nodes(ancestorIdx).left, nodeIdx) <> 0 Then Return 1
    End If
    If ps.ast.nodes(ancestorIdx).right <> -1 Then
        If Step3NodeIsDescendantOf(ps, ps.ast.nodes(ancestorIdx).right, nodeIdx) <> 0 Then Return 1
    End If

    Return 0
End Function

Private Function Step3ChildPosition(ByRef ps As ParseState, ByVal parentIdx As Integer, ByVal childIdx As Integer) As Integer
    If parentIdx < 0 Or parentIdx >= ps.ast.count Then Return -1
    Dim childOrdinal As Integer
    childOrdinal = 0
    Dim ch As Integer
    ch = ps.ast.nodes(parentIdx).firstChild
    Do While ch <> -1
        If ch = childIdx Then Return childOrdinal
        If Step3NodeIsDescendantOf(ps, ch, childIdx) <> 0 Then Return childOrdinal
        childOrdinal += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return -1
End Function

Private Function Step3FfiSignatureTokenOk(ByVal rawText As String) As Integer
    Dim s As String
    s = UCase(Trim(rawText))
    Select Case s
    Case "VOID", "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "PTR", "STRPTR", "BYREF"
        Return 1
    End Select
    Return 0
End Function

Private Function Step3FfiConventionTokenOk(ByVal rawText As String) As Integer
    Dim s As String
    s = UCase(Trim(rawText))
    Select Case s
    Case "CDECL", "STDCALL"
        Return 1
    End Select
    Return 0
End Function

Private Function Step3IsFfiCallExpr(ByRef ps As ParseState, ByVal callIdx As Integer, ByRef basePosOut As Integer, ByRef markerOut As String) As Integer
    basePosOut = -1
    markerOut = ""
    If callIdx < 0 Or callIdx >= ps.ast.count Then Return 0
    If UCase(Trim(ps.ast.nodes(callIdx).kind)) <> "CALL_EXPR" Then Return 0

    Dim callName As String
    callName = UCase(Trim(ps.ast.nodes(callIdx).value))
    Select Case callName
    Case "DLL", "API"
        basePosOut = 0
        markerOut = callName
        Return 1
    Case "CALL"
        Dim markerNode As Integer
        markerNode = Step3ChildAt(ps, callIdx, 0)
        If markerNode = -1 Then Return 0
        Dim markerKind As String
        Dim markerValue As String
        markerKind = UCase(Trim(ps.ast.nodes(markerNode).kind))
        markerValue = UCase(Trim(ps.ast.nodes(markerNode).value))
        If (markerKind = "IDENT" Or markerKind = "IDENTIFIER" Or markerKind = "KEYWORD_REF") And (markerValue = "DLL" Or markerValue = "API") Then
            basePosOut = 1
            markerOut = markerValue
            Return 1
        End If
    End Select
    Return 0
End Function

Private Function Step3FindNearestOwnerCall(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1

    Dim walkIdx As Integer
    walkIdx = ps.ast.nodes(nodeIdx).parent
    Dim guard As Integer
    guard = 0
    Do While walkIdx >= 0 And walkIdx < ps.ast.count
        Dim basePosProbe As Integer
        Dim markerProbe As String
        If Step3IsFfiCallExpr(ps, walkIdx, basePosProbe, markerProbe) <> 0 Then Return walkIdx
        walkIdx = ps.ast.nodes(walkIdx).parent
        guard += 1
        If guard > ps.ast.count Then Exit Do
    Loop

    Dim ownerIdx As Integer
    ownerIdx = Step3FindOwnerNode(ps, nodeIdx)
    guard = 0
    Do While ownerIdx >= 0 And ownerIdx < ps.ast.count
        Dim basePosOwner As Integer
        Dim markerOwner As String
        If Step3IsFfiCallExpr(ps, ownerIdx, basePosOwner, markerOwner) <> 0 Then Return ownerIdx
        If ps.ast.nodes(ownerIdx).parent <> -1 Then
            ownerIdx = ps.ast.nodes(ownerIdx).parent
        Else
            Dim nextOwner As Integer
            nextOwner = Step3FindOwnerNode(ps, ownerIdx)
            If nextOwner = -1 Or nextOwner = ownerIdx Then Exit Do
            ownerIdx = nextOwner
        End If
        guard += 1
        If guard > ps.ast.count Then Exit Do
    Loop

    Return -1
End Function



Private Function Step3IsFfiTypeListText(ByVal rawText As String) As Integer
    Dim s As String
    s = UCase(Trim(rawText))
    If s = "" Then Return 0
    If InStr(s, ",") > 0 Then Return 1
    If Step3FfiSignatureTokenOk(s) <> 0 And s <> "VOID" And s <> "BYREF" Then Return 1
    Return 0
End Function

Private Function Step3IsFfiCallMetadataNode(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim parentIdx As Integer
    parentIdx = Step3FindNearestOwnerCall(ps, nodeIdx)
    If parentIdx < 0 Or parentIdx >= ps.ast.count Then Return 0

    Dim basePos As Integer
    Dim markerText As String
    If Step3IsFfiCallExpr(ps, parentIdx, basePos, markerText) = 0 Then Return 0

    Dim childOrdinal As Integer
    childOrdinal = Step3ChildPosition(ps, parentIdx, nodeIdx)
    If childOrdinal < 0 Then Return 0

    Dim nodeKindText As String
    Dim nodeValueText As String
    nodeKindText = UCase(Trim(ps.ast.nodes(nodeIdx).kind))
    nodeValueText = UCase(Trim(ps.ast.nodes(nodeIdx).value))

    ' CALL(DLL, ...) / CALL(API, ...) marker itself is not a variable.
    If basePos = 1 And childOrdinal = 0 Then Return 1

    ' Library and symbol are metadata string literals.
    If childOrdinal = basePos Then Return 1
    If childOrdinal = basePos + 1 Then Return 1

    ' Return signature is metadata: I32/F64/PTR/STRPTR/VOID/etc.
    If childOrdinal = basePos + 2 Then
        If Step3FfiSignatureTokenOk(nodeValueText) <> 0 Then Return 1
        Return 1
    End If

    ' Optional calling convention keyword: CDECL/STDCALL.
    If childOrdinal = basePos + 3 Then
        If Step3FfiConventionTokenOk(nodeValueText) <> 0 Then Return 1
        If nodeKindText = "STRING" And Step3IsFfiTypeListText(ps.ast.nodes(nodeIdx).value) <> 0 Then Return 1
    End If

    ' Optional explicit type-list string after convention. Runtime arguments after this point must still be checked.
    If childOrdinal = basePos + 4 Then
        If nodeKindText = "STRING" And Step3IsFfiTypeListText(ps.ast.nodes(nodeIdx).value) <> 0 Then Return 1
    End If

    Return 0
End Function

Private Function Step3AstNodeIsRuntimeExpression(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If UCase(Trim(ps.ast.nodes(nodeIdx).role)) = "DEFTYPE_RANGE_METADATA" Then Return 0
    Dim k As String = Step3NodeKind(ps, nodeIdx)
    If Step3IsFfiCallMetadataNode(ps, nodeIdx) <> 0 Then Return 0
    Dim ownerIdx As Integer
    ownerIdx = Step3FindOwnerNode(ps, nodeIdx)
    If ownerIdx <> -1 Then
        If Step3NodeKind(ps, ownerIdx) = "BINARY" And Trim(ps.ast.nodes(ownerIdx).op) = "|>" And ps.ast.nodes(ownerIdx).right = nodeIdx Then Return 0
    End If
    ' ADIM36+: declaration/container nodes must never flow into expression inference.
    If InStr(k, "_STMT") > 0 Then Return 0
    Select Case k
    Case "DIM_DECL", "CONST_DECL", "PARAM_DECL", "CLASS_FIELD_DECL", "CLASS_METHOD_DECL", "TYPE_REF", "RETURN_TYPE", "MODE_REF", "USING_ITEM", "ALIAS_TARGET"
        Return 0
    End Select
    If UXBAstContractIsExpressionNode(k) = 0 Then Return 0
    If UXBAstContractIsCompileTimeNode(k) <> 0 Then Return 0
    Dim pk As String = Step3ParentKind(ps, nodeIdx)
    Select Case pk
    Case "TYPE_REF", "RETURN_TYPE", "DIM_BOUNDS", "ALIAS_TARGET", "USING_ITEM", "CLASS_FLAG", "CLASS_FIELD_FLAG", "CLASS_METHOD_FLAG", "CLASS_PROPERTY_FLAG", "MODE_REF", _
         "EVENT_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT", "SLOT_STMT", "SLOT_TABLE_STMT", "SLOT_BIND_ENTRY", "SLOT_CONTROL_STMT", "TRIGGER_STMT", "SLOT_HEADER_ARGS"
        Return 0
    End Select
    Return 1
End Function

Private Function Step3StringEndsWithCI(ByRef textValue As String, ByRef suffixValue As String) As Integer
    If Len(textValue) < Len(suffixValue) Then Return 0
    Return LCase(Right(textValue, Len(suffixValue))) = LCase(suffixValue)
End Function

Private Function Step3IsLibraryTypeManifestPath(ByRef pathText As String) As Integer
    Dim p As String
    p = Trim(pathText)
    If p = "" Then Return 0
    If Step3StringEndsWithCI(p, ".library_type.json") <> 0 Then Return 1
    Return 0
End Function

Private Function Step3LoadLibraryTypeManifestIncludes(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) = "INCLUDE_STMT" Then
            If UCase(Trim(ps.ast.nodes(i).op)) <> "LIBTYPE" Then GoTo Step3NextLibraryTypeInclude
            Dim ch As Integer
            ch = ps.ast.nodes(i).firstChild
            Do While ch <> -1
                If Step3NodeKind(ps, ch) = "STRING" Then
                    Dim manifestPath As String
                    manifestPath = Trim(ps.ast.nodes(ch).value)
                    If Step3IsLibraryTypeManifestPath(manifestPath) <> 0 Then
                        Dim resolvedPath As String
                        resolvedPath = UXBLibraryTypeResolveManifestPath(manifestPath, ps.ast.nodes(i).sourceFile)
                        Dim loadErr As String
                        Dim contractIdx As Integer
                        contractIdx = UXBLibraryTypeRegistryLoadManifestFile(resolvedPath, loadErr)
                        If contractIdx < 0 Then
                            Return UXBSemanticFail(SEM_E_UNKNOWN_TYPE, "library type manifest include failed: " & manifestPath & " resolved " & resolvedPath & " (" & loadErr & ")", errText)
                        End If
                        If UXBLibraryTypeRequireValueTransfer(gUXBLibraryTypes(contractIdx), loadErr) = 0 Then
                            Return UXBSemanticFail(SEM_E_UNKNOWN_TYPE, loadErr, errText)
                        End If
                    End If
                End If
                ch = ps.ast.nodes(ch).nextSibling
            Loop
        End If
Step3NextLibraryTypeInclude:
    Next i
    Return 1
End Function

Private Function Step3RegisterDeclaredTypes(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        Select Case k
        Case "TYPE_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then
                If UXBStep3RegisterTypeName("TYPE", ps.ast.nodes(i).value, errText) = -1 Then Return 0
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_TYPE, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_TYPE, ps.ast.nodes(i).value, 0, i, errText) = -1 Then Return 0
            End If
        Case "CLASS_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then
                If UXBStep3RegisterTypeName("CLASS", ps.ast.nodes(i).value, errText) = -1 Then Return 0
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_CLASS, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_CLASS, ps.ast.nodes(i).value, 0, i, errText) = -1 Then Return 0
            End If
        Case "INTERFACE_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then
                If UXBStep3RegisterTypeName("INTERFACE", ps.ast.nodes(i).value, errText) = -1 Then Return 0
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_INTERFACE, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_INTERFACE, ps.ast.nodes(i).value, 0, i, errText) = -1 Then Return 0
            End If
        Case "ENUM_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then
                If UXBStep3RegisterTypeName("ENUM", ps.ast.nodes(i).value, errText) = -1 Then Return 0
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_ENUM, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_ENUM, ps.ast.nodes(i).value, 0, i, errText) = -1 Then Return 0
            End If
        End Select
    Next i
    Return 1
End Function

Private Function Step3BindRoutineSymbol(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByVal kindText As String, ByRef errText As String) As Integer
    If Trim(ps.ast.nodes(nodeIdx).value) = "" Then Return 1
    If UXBStep3SymbolFindExact(ps.ast.nodes(nodeIdx).value, kindText, 0) <> -1 Then Return 1
    Return IIf(UXBStep3SymbolAdd(ps.ast.nodes(nodeIdx).value, kindText, kindText, 0, nodeIdx, errText) <> -1, 1, 0)
End Function

Private Function Step3BindImplicitCatchVar(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef varName As String, ByRef typeName As String, ByRef errText As String) As Integer
    Dim normalizedName As String
    Dim normalizedType As String
    normalizedName = Trim(varName)
    normalizedType = UXBStep3TypeCanonical(typeName)
    If normalizedName = "" Then Return 1

    Dim existingType As String
    Dim lookupErr As String
    If UXBStep3VarTypeName(normalizedName, existingType, lookupErr) = 0 Then
        If UXBStep3DeclareVariable(normalizedName, normalizedType, 0, "", errText) = -1 Then Return 0
    ElseIf UXBStep3TypeCanonical(existingType) <> normalizedType Then
        Return UXBSemanticFail(SEM_E_TYPE_MISMATCH, "CATCH variable type mismatch: " & normalizedName & " expected " & normalizedType & " got " & existingType, errText)
    End If

    Dim scopeId As Integer
    scopeId = Step3ScopeForNode(ps, nodeIdx)
    If UXBStep3SymbolFindExact(normalizedName, SYM_VAR, scopeId) = -1 Then
        If UXBStep3SymbolAdd(normalizedName, SYM_VAR, normalizedType, scopeId, nodeIdx, errText) = -1 Then Return 0
    End If
    Return 1
End Function

Private Function Step3EnumBaseTypeOk(ByRef baseTypeText As String) As Integer
    Dim c As String
    c = UXBStep3TypeCanonical(baseTypeText)
    Select Case c
    Case TYPE_BOOL, TYPE_I8, TYPE_U8, TYPE_I16, TYPE_U16, TYPE_I32, TYPE_U32, TYPE_I64, TYPE_U64
        Return 1
    End Select
    Return 0
End Function

Private Function Step3EnumDigitValue(ByRef ch As String) As Integer
    Dim u As String
    u = UCase(ch)
    If u >= "0" And u <= "9" Then Return Asc(u) - Asc("0")
    If u >= "A" And u <= "F" Then Return 10 + Asc(u) - Asc("A")
    Return -1
End Function

Private Function Step3EnumParseIntegerLiteral(ByRef rawText As String, ByRef outValue As LongInt) As Integer
    Dim t As String
    t = UCase(Trim(rawText))
    If t = "" Then Return 0

    Dim signValue As LongInt
    signValue = 1
    If Left(t, 1) = "-" Then
        signValue = -1
        t = Mid(t, 2)
    ElseIf Left(t, 1) = "+" Then
        t = Mid(t, 2)
    End If
    If t = "" Then Return 0
    If UXBNumberLiteralIsFloat(t) <> 0 Then Return 0

    Dim baseValue As Integer
    baseValue = 10
    If Left(t, 2) = "&H" Then
        baseValue = 16
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "0X" Then
        baseValue = 16
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "&O" Then
        baseValue = 8
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "0O" Then
        baseValue = 8
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "%B" Or Left(t, 2) = "&B" Then
        baseValue = 2
        t = Mid(t, 3)
    ElseIf Left(t, 2) = "0B" Then
        baseValue = 2
        t = Mid(t, 3)
    End If
    If t = "" Then Return 0

    Dim acc As ULongInt = 0
    Dim limit As ULongInt = IIf(signValue < 0, &h8000000000000000ULL, &hFFFFFFFFFFFFFFFFULL)
    Dim sawDigit As Integer = 0
    For i As Integer = 1 To Len(t)
        Dim ch As String = Mid(t, i, 1)
        If ch = "_" Then Continue For
        Dim digit As Integer = Step3EnumDigitValue(ch)
        If digit < 0 Or digit >= baseValue Then Return 0
        If acc > (limit - CULngInt(digit)) \ CULngInt(baseValue) Then Return 0
        acc = acc * CULngInt(baseValue) + CULngInt(digit)
        sawDigit = 1
    Next i
    If sawDigit = 0 Then Return 0
    If signValue < 0 Then acc = 0ULL - acc
    outValue = CLngInt(acc)
    Return 1
End Function

Private Function Step3EnumConstExprToInt(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef outValue As LongInt) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    Dim k As String
    k = Step3NodeKind(ps, nodeIdx)
    If k = "NUMBER" Then
        Return Step3EnumParseIntegerLiteral(ps.ast.nodes(nodeIdx).value, outValue)
    End If
    If k = "UNARY" Or k = "UNARY_EXPR" Then
        If Trim(ps.ast.nodes(nodeIdx).op) = "-" Or Trim(ps.ast.nodes(nodeIdx).value) = "-" Then
            Dim ch As Integer
            ch = Step3ChildAt(ps, nodeIdx, 0)
            If ch = -1 Then ch = ps.ast.nodes(nodeIdx).left
            If Step3EnumConstExprToInt(ps, ch, outValue) <> 0 Then
                outValue = -outValue
                Return 1
            End If
        End If
    End If
    Return 0
End Function

Private Function Step3EnumItemExplicitValue(ByRef ps As ParseState, ByVal itemNode As Integer) As Integer
    Dim ch As Integer
    ch = ps.ast.nodes(itemNode).firstChild
    Do While ch <> -1
        If UCase(Trim(ps.ast.nodes(ch).role)) = "VALUE" Then Return ch
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return -1
End Function

Declare Function Step3IntegerLiteralFits(ByVal literalText As String, ByVal targetType As String) As Integer

Private Function Step3ValidateEnums(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim enumNode As Integer
    For enumNode = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, enumNode) = "ENUM_STMT" Then
            Dim enumName As String
            enumName = Trim(ps.ast.nodes(enumNode).value)
            If enumName = "" Then Return UXBSemanticFail(SEM_E_UNKNOWN_SYMBOL, "enum: name missing", errText)

            Dim baseNode As Integer
            baseNode = Step3FindChildByKind(ps, enumNode, "ENUM_BASE_TYPE")
            If baseNode <> -1 Then
                If Step3EnumBaseTypeOk(ps.ast.nodes(baseNode).value) = 0 Then
                    Return UXBSemanticFail(SEM_E_TYPE_MISMATCH, "enum: integer base type required for " & enumName, errText)
                End If
            End If

            Dim baseType As String = TYPE_I32
            If baseNode <> -1 Then baseType = UXBStep3TypeCanonical(ps.ast.nodes(baseNode).value)
            Dim bindingIdx As Integer = UXBStep3ResolveTypeIndex(enumName, errText)
            If bindingIdx < 0 Then Return 0
            gTypeBindings(bindingIdx).elemTypeName = UXBStep3TypeLegacyName(baseType)
            gTypeBindings(bindingIdx).sizeBytes = UXBStep3TypeSizeBytes(baseType)
            gTypeBindings(bindingIdx).alignBytes = UXBStep3TypeAlignBytes(baseType)
            gTypeBindings(bindingIdx).isSigned = IIf(baseType = TYPE_I8 Or baseType = TYPE_I16 Or baseType = TYPE_I32 Or baseType = TYPE_I64, 1, 0)

            Dim nextValue As LongInt
            Dim nextValueOverflow As Integer = 0
            nextValue = 0
            Dim itemNode As Integer
            itemNode = ps.ast.nodes(enumNode).firstChild
            Do While itemNode <> -1
                If Step3NodeKind(ps, itemNode) = "ENUM_ITEM" Then
                    Dim itemName As String
                    itemName = Trim(ps.ast.nodes(itemNode).value)
                    If itemName = "" Then Return UXBSemanticFail(SEM_E_UNKNOWN_SYMBOL, "enum: item name missing in " & enumName, errText)

                    Dim compareNode As Integer
                    compareNode = ps.ast.nodes(enumNode).firstChild
                    Do While compareNode <> itemNode And compareNode <> -1
                        If Step3NodeKind(ps, compareNode) = "ENUM_ITEM" Then
                            If UCase(Trim(ps.ast.nodes(compareNode).value)) = UCase(itemName) Then
                                Return UXBSemanticFail(SEM_E_DUPLICATE_SYMBOL, "enum: duplicate item " & enumName & "." & itemName, errText)
                            End If
                        End If
                        compareNode = ps.ast.nodes(compareNode).nextSibling
                    Loop

                    Dim effectiveValue As LongInt
                    effectiveValue = nextValue
                    Dim valueNode As Integer
                    valueNode = Step3EnumItemExplicitValue(ps, itemNode)
                    If valueNode <> -1 Then
                        If Step3EnumConstExprToInt(ps, valueNode, effectiveValue) = 0 Then
                            Return UXBSemanticFail(SEM_E_TYPE_MISMATCH, "enum: numeric constant value required for " & enumName & "." & itemName, errText)
                        End If
                    End If

                    Dim explicitlyNegative As Integer = 0
                    If valueNode >= 0 Then
                        explicitlyNegative = IIf(Left(Trim(ps.ast.nodes(valueNode).value), 1) = "-" Or (UCase(ps.ast.nodes(valueNode).kind) = "UNARY" And ps.ast.nodes(valueNode).op = "-"), 1, 0)
                    ElseIf nextValueOverflow <> 0 Then
                        Return UXBSemanticFail(SEM_E_TYPE_MISMATCH, "enum: implicit value exceeds base type for " & enumName & "." & itemName, errText)
                    End If
                    Dim effectiveText As String = LTrim(Str(effectiveValue))
                    If baseType = TYPE_U64 Then effectiveText = LTrim(Str(CULngInt(effectiveValue)))
                    Dim baseUnsigned As Integer = IIf(baseType = TYPE_U8 Or baseType = TYPE_U16 Or baseType = TYPE_U32 Or baseType = TYPE_U64, 1, 0)
                    If (baseUnsigned <> 0 And explicitlyNegative <> 0 And effectiveValue <> 0) Or (baseUnsigned = 0 And effectiveValue < 0 And valueNode >= 0 And explicitlyNegative = 0) Or Step3IntegerLiteralFits(effectiveText, baseType) = 0 Then
                        Return UXBSemanticFail(SEM_E_TYPE_MISMATCH, "enum: value out of range for " & baseType & " in " & enumName & "." & itemName, errText)
                    End If

                    compareNode = ps.ast.nodes(enumNode).firstChild
                    Dim compareNextValue As LongInt
                    compareNextValue = 0
                    Do While compareNode <> itemNode And compareNode <> -1
                        If Step3NodeKind(ps, compareNode) = "ENUM_ITEM" Then
                            Dim compareValue As LongInt
                            compareValue = compareNextValue
                            Dim compareValueNode As Integer
                            compareValueNode = Step3EnumItemExplicitValue(ps, compareNode)
                            If compareValueNode <> -1 Then
                                If Step3EnumConstExprToInt(ps, compareValueNode, compareValue) = 0 Then
                                    Return UXBSemanticFail(SEM_E_TYPE_MISMATCH, "enum: numeric constant value required", errText)
                                End If
                            End If
                            If compareValue = effectiveValue Then
                                Return UXBSemanticFail(SEM_E_DUPLICATE_SYMBOL, "enum: duplicate value in " & enumName & " = " & LTrim(Str(effectiveValue)), errText)
                            End If
                            compareNextValue = compareValue + 1
                        End If
                        compareNode = ps.ast.nodes(compareNode).nextSibling
                    Loop

                    ps.ast.nodes(itemNode).op = effectiveText
                    ps.ast.nodes(itemNode).typeName = UCase(enumName)
                    Dim upperLimit As ULongInt = &h7FFFFFFFFFFFFFFFULL
                    Select Case baseType
                    Case TYPE_I8: upperLimit = 127ULL
                    Case TYPE_U8: upperLimit = 255ULL
                    Case TYPE_I16: upperLimit = 32767ULL
                    Case TYPE_U16: upperLimit = 65535ULL
                    Case TYPE_I32: upperLimit = 2147483647ULL
                    Case TYPE_U32: upperLimit = &hFFFFFFFFULL
                    Case TYPE_U64: upperLimit = &hFFFFFFFFFFFFFFFFULL
                    End Select
                    nextValueOverflow = IIf(CULngInt(effectiveValue) = upperLimit, 1, 0)
                    If nextValueOverflow = 0 Then nextValue = effectiveValue + 1
                End If
                itemNode = ps.ast.nodes(itemNode).nextSibling
            Loop
        End If
    Next enumNode
    Return 1
End Function

Private Function Step3BindDeclarations(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    ' S-611: every class member routine's scope nests in its container's scope (registered up front: declarations and lookups below need it)
    For i = 0 To ps.ast.count - 1
        Select Case Step3NodeKind(ps, i)
        Case "CLASS_METHOD_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", "CLASS_OPERATOR_DECL", "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "INTERFACE_METHOD_DECL"
            UXBStep3ScopeParentSet i + 1, Step3ScopeForMemberDecl(ps, i)
        End Select
    Next i
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        Select Case k
        Case "TYPE_REF", "RETURN_TYPE"
            If Trim(ps.ast.nodes(i).value) = "" Then Return UXBSemanticFail(SEM_E_UNKNOWN_TYPE, "empty type reference", errText)
            Dim c As String
            If UXBStep3TypeRegistryResolve(ps.ast.nodes(i).value, c, errText) = 0 Then Return 0
        Case "PARAM_DECL", "DIM_DECL", "DIM_STMT", "REDIM_DECL", "REDIM_STMT"
            Dim declType As String
            If Step3InferNodeDeclaredOrInitializerType(ps, i, declType, errText) = 0 Then Return 0
            If Trim(ps.ast.nodes(i).value) <> "" Then
                If UXBStep3DeclareVariable(ps.ast.nodes(i).value, declType, 0, "", errText) = -1 Then Return 0
                Dim symKind As String = IIf(k = "PARAM_DECL", SYM_PARAM, SYM_VAR)
                Dim scopeId As Integer = Step3ScopeForNode(ps, i)
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, symKind, scopeId) = -1 Then
                    If UXBStep3SymbolAdd(ps.ast.nodes(i).value, symKind, UXBStep3TypeCanonical(declType), scopeId, i, errText) = -1 Then Return 0
                End If
            End If
        Case "TYPE_FIELD", "CLASS_FIELD", "CLASS_PROPERTY_DECL"
            Dim fType As String
            If Step3InferNodeDeclaredOrInitializerType(ps, i, fType, errText) = 0 Then Return 0
            If Trim(ps.ast.nodes(i).value) <> "" Then
                Dim fieldKind As String = IIf(k = "TYPE_FIELD", SYM_TYPE_FIELD, SYM_CLASS_FIELD)
                Dim fieldScope As Integer = Step3ScopeForNode(ps, i)
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, fieldKind, fieldScope) = -1 Then
                    If UXBStep3SymbolAdd(ps.ast.nodes(i).value, fieldKind, UXBStep3TypeCanonical(fType), fieldScope, i, errText) = -1 Then Return 0
                End If
            End If
        Case "CONST_DECL", "CONST_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then
                Dim constType As String
                If Step3InferNodeDeclaredOrInitializerType(ps, i, constType, errText) = 0 Then Return 0
                If UXBStep3DeclareVariable(ps.ast.nodes(i).value, constType, 1, "", errText) = -1 Then Return 0
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_CONST, Step3ScopeForNode(ps, i)) = -1 Then
                    If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_CONST, UXBStep3TypeCanonical(constType), Step3ScopeForNode(ps, i), i, errText) = -1 Then Return 0
                End If
            End If
        Case "FUNCTION_STMT", "DECLARE_FUNCTION_STMT"
            If Step3BindRoutineSymbol(ps, i, SYM_FUNCTION, errText) = 0 Then Return 0
        Case "SUB_STMT", "DECLARE_SUB_STMT"
            If Step3BindRoutineSymbol(ps, i, SYM_SUB, errText) = 0 Then Return 0
        Case "CLASS_METHOD_DECL", "INTERFACE_METHOD_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", "CLASS_OPERATOR_DECL"
            If Trim(ps.ast.nodes(i).value) <> "" Then If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_CLASS_METHOD, Step3ScopeForMemberDecl(ps, i)) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_CLASS_METHOD, "METHOD", Step3ScopeForMemberDecl(ps, i), i, errText) = -1 Then Return 0
        Case "CLASS_PROPERTY_SET_STMT"
            Dim propertyNode As Integer = ps.ast.nodes(i).parent
            If propertyNode >= 0 AndAlso Step3NodeKind(ps, propertyNode) = "CLASS_PROPERTY_DECL" Then
                Dim propertyType As String
                If Step3InferNodeDeclaredOrInitializerType(ps, propertyNode, propertyType, errText) = 0 Then Return 0
                If UXBStep3SymbolFindExact("VALUE", SYM_PARAM, i + 1) = -1 Then
                    If UXBStep3SymbolAdd("VALUE", SYM_PARAM, UXBStep3TypeCanonical(propertyType), i + 1, i, errText) = -1 Then Return 0
                End If
            End If
        Case "CATCH_PART"
            Dim catchName As String
            Dim catchIntegerType As String
            Dim catchStringType As String
            catchName = Trim(ps.ast.nodes(i).value)
            catchIntegerType = TYPE_I32
            catchStringType = TYPE_STRING
            If catchName <> "" Then
                If Step3BindImplicitCatchVar(ps, i, catchName, catchIntegerType, errText) = 0 Then Return 0
            End If

            Dim catchSpecialPos As Integer
            Dim catchSpecialName As String
            Dim catchSpecialType As String
            For catchSpecialPos = 0 To 10
                Select Case catchSpecialPos
                Case 0: catchSpecialName = "__ERR_THROWN": catchSpecialType = catchIntegerType
                Case 1: catchSpecialName = "__ERR_CODE": catchSpecialType = catchIntegerType
                Case 2: catchSpecialName = "__ERR_LINE": catchSpecialType = catchIntegerType
                Case 3: catchSpecialName = "__ERR_COL": catchSpecialType = catchIntegerType
                Case 4: catchSpecialName = "__ERR_VALUE": catchSpecialType = catchIntegerType
                Case 5: catchSpecialName = "__ERR_IS_STRING": catchSpecialType = catchIntegerType
                Case 6: catchSpecialName = "__ERR_KIND": catchSpecialType = catchStringType
                Case 7: catchSpecialName = "__ERR_MESSAGE": catchSpecialType = catchStringType
                Case 8: catchSpecialName = "__ERR_ROUTINE": catchSpecialType = catchStringType
                Case 9: catchSpecialName = "__ERR_VALUE_TYPE": catchSpecialType = catchStringType
                Case Else: catchSpecialName = "__ERR_VALUE_TEXT": catchSpecialType = catchStringType
                End Select
                If Step3BindImplicitCatchVar(ps, i, catchSpecialName, catchSpecialType, errText) = 0 Then Return 0
            Next catchSpecialPos
        Case "ENUM_ITEM"
            If Trim(ps.ast.nodes(i).value) <> "" Then
                Dim enumScope As Integer
                enumScope = Step3ScopeForNode(ps, i)
                If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_CONST, enumScope) <> -1 Then
                    Return UXBSemanticFail(SEM_E_DUPLICATE_SYMBOL, "enum: symbol collision " & ps.ast.nodes(i).value, errText)
                End If
                If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_CONST, ps.ast.nodes(i).typeName, enumScope, i, errText) = -1 Then Return 0
            End If
        Case "LABEL_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_LABEL, Step3ScopeForNode(ps, i)) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_LABEL, "LABEL", Step3ScopeForNode(ps, i), i, errText) = -1 Then Return 0
        Case "MODULE_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_MODULE, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_MODULE, "MODULE", 0, i, errText) = -1 Then Return 0
        Case "NAMESPACE_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_NAMESPACE, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_NAMESPACE, "NAMESPACE", 0, i, errText) = -1 Then Return 0
        Case "IMPORT_STMT"
            If Trim(ps.ast.nodes(i).value) <> "" Then If UXBStep3SymbolFindExact(ps.ast.nodes(i).value, SYM_IMPORT, 0) = -1 Then If UXBStep3SymbolAdd(ps.ast.nodes(i).value, SYM_IMPORT, "IMPORT", 0, i, errText) = -1 Then Return 0
        Case "ASSIGN_STMT"
            ' ADIM44 compatibility: implicit variable declaration on first assignment.
            Dim lhsNode As Integer
            lhsNode = Step3ChildAt(ps, i, 0)
            If lhsNode = -1 Then lhsNode = ps.ast.nodes(i).left
            If lhsNode <> -1 Then
                Dim lhsKind As String
                lhsKind = Step3NodeKind(ps, lhsNode)
                If lhsKind = "IDENT" Or lhsKind = "IDENTIFIER" Or lhsKind = "KEYWORD_REF" Then
                    Dim lhsName As String
                    lhsName = Trim(ps.ast.nodes(lhsNode).value)
                    If lhsName <> "" Then
                        Dim existingAssignType As String
                        Dim existingAssignErr As String
                        Dim inferredAssignType As String
                        Dim assignScope As Integer
                        Dim existingAssignSymbol As Integer
                        assignScope = Step3ScopeForNode(ps, lhsNode)
                        existingAssignSymbol = UXBStep3SymbolFindExact(lhsName, "", assignScope)
                        inferredAssignType = TYPE_OBJECT
                        If existingAssignSymbol = -1 Then
                            Dim rhsNode As Integer
                            rhsNode = Step3ChildAt(ps, i, 1)
                            If rhsNode = -1 Then rhsNode = ps.ast.nodes(i).right
                            If rhsNode <> -1 Then
                                Dim inferErr As String
                                If UXBStep3InferExprType(ps, rhsNode, inferredAssignType, inferErr) = 0 Then inferredAssignType = TYPE_OBJECT
                            End If
                            If UXBStep3DeclareVariable(lhsName, inferredAssignType, 0, "", errText) = -1 Then Return 0
                        Else
                            inferredAssignType = gUXBStep3Symbols(existingAssignSymbol).typeName
                        End If
                        If UXBStep3SymbolFindExact(lhsName, SYM_VAR, assignScope) = -1 Then
                            If existingAssignSymbol = -1 Then
                                If UXBStep3SymbolAdd(lhsName, SYM_VAR, inferredAssignType, assignScope, lhsNode, errText) = -1 Then Return 0
                            End If
                        End If
                    End If
                End If
            End If
        Case "INPUT_FILE_STMT", "INPUTF_STMT", "INPUT_STMT"
            ' ADIM44 compatibility: INPUT targets can introduce implicit string vars.
            Dim inputStartPos As Integer
            inputStartPos = 0
            If k = "INPUT_FILE_STMT" Or k = "INPUTF_STMT" Then inputStartPos = 1
            Dim tPos As Integer
            tPos = inputStartPos
            Do
                Dim tNode As Integer
                tNode = Step3ChildAt(ps, i, tPos)
                If tNode = -1 Then Exit Do
                Dim tk As String
                tk = Step3NodeKind(ps, tNode)
                If tk = "IDENT" Or tk = "IDENTIFIER" Then
                    Dim targetName As String
                    targetName = Trim(ps.ast.nodes(tNode).value)
                    If targetName <> "" Then
                        Dim existingInputType As String
                        Dim existingInputErr As String
                        If UXBStep3VarTypeName(targetName, existingInputType, existingInputErr) = 0 Then
                            If UXBStep3DeclareVariable(targetName, TYPE_STRING, 0, "", errText) = -1 Then Return 0
                        End If
                        If UXBStep3SymbolFindExact(targetName, SYM_VAR, Step3ScopeForNode(ps, tNode)) = -1 Then
                            If UXBStep3SymbolAdd(targetName, SYM_VAR, TYPE_STRING, Step3ScopeForNode(ps, tNode), tNode, errText) = -1 Then Return 0
                        End If
                    End If
                End If
                tPos += 1
            Loop
        End Select
    Next i
    Return 1
End Function

' Validates every runtime expression node. The tree is not edited here, so the
' owner lookups (ast_owner_index.fbs) are tabulated once for the whole loop instead
' of scanning the entire AST per query.
Private Function Step3ValidateExpressionsCore(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3AstNodeIsRuntimeExpression(ps, i) <> 0 Then
            Dim exprKind As String
            exprKind = Step3NodeKind(ps, i)
            If exprKind = "IDENT" Or exprKind = "IDENTIFIER" Or exprKind = "KEYWORD_REF" Then
                Dim exprName As String
                exprName = UCase(Trim(ps.ast.nodes(i).value))
                If exprName = "BIGI" Or exprName = "BIGINT" Or exprName = "BIG_INTEGER" Then
                    GoTo Step3ExprNext
                End If
            End If
            Dim t As String
            If UXBStep3InferExprType(ps, i, t, errText) = 0 Then Return 0
            If UXBStep3TypeIsBlocked(t) <> 0 Then Return UXBSemanticFail(SEM_E_TYPE_UNKNOWN_LEAK, "blocked inferred type", errText)
        End If
Step3ExprNext:
    Next i
    Return 1
End Function

Private Function Step3ValidateExpressions(ByRef ps As ParseState, ByRef errText As String) As Integer
    UXBAstOwnerIndexBegin ps
    Dim ok As Integer = Step3ValidateExpressionsCore(ps, errText)
    UXBAstOwnerIndexEnd
    Return ok
End Function

Private Function Step3ValidateShellStmt(ByRef ps As ParseState, ByVal stmtIdx As Integer, ByRef errText As String) As Integer
    Dim seenNowait As Integer
    Dim seenTimeout As Integer
    Dim seenOutVar As Integer
    Dim seenErrVar As Integer
    Dim optionNames As String

    Dim ch As Integer
    ch = ps.ast.nodes(stmtIdx).firstChild
    If ch <> -1 Then ch = ps.ast.nodes(ch).nextSibling
    Do While ch <> -1
        If Step3NodeKind(ps, ch) = "SHELL_OPTION" Then
            Dim optionName As String
            optionName = UCase(Trim(ps.ast.nodes(ch).value))
            If InStr("|" & optionNames & "|", "|" & optionName & "|") > 0 Then
                Return UXBSemanticFail(SEM_E_INVALID_CALL, "duplicate SHELL option: " & optionName, errText)
            End If
            If optionNames <> "" Then optionNames &= "|"
            optionNames &= optionName

            Dim payload As Integer
            payload = Step3ChildAt(ps, ch, 0)
            If payload = -1 Then payload = ps.ast.nodes(ch).left

            Select Case optionName
            Case "NOWAIT"
                seenNowait = 1
            Case "TIMEOUT"
                seenTimeout = 1
                If payload = -1 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL TIMEOUT value missing", errText)
                Dim timeoutType As String
                If UXBStep3InferExprType(ps, payload, timeoutType, errText) = 0 Then Return 0
                If UXBStep3TypeIsInteger(timeoutType) = 0 Then
                    Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL TIMEOUT must be an integer", errText)
                End If
            Case "RUNPATH", "OUTPATH", "ERRPATH"
                If payload = -1 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL " & optionName & " value missing", errText)
                Dim pathType As String
                If UXBStep3InferExprType(ps, payload, pathType, errText) = 0 Then Return 0
                If UXBStep3TypeIsString(pathType) = 0 Then
                    Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL " & optionName & " must be STRING", errText)
                End If
            Case "OUTVAR", "ERRVAR"
                If optionName = "OUTVAR" Then seenOutVar = 1 Else seenErrVar = 1
                If payload = -1 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL " & optionName & " target missing", errText)
                Dim captureType As String
                If UXBStep3InferExprType(ps, payload, captureType, errText) = 0 Then Return 0
                If UXBStep3TypeIsString(captureType) = 0 Then
                    Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL " & optionName & " target must be STRING", errText)
                End If
            Case "CODEVAR"
                If payload = -1 Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL CODEVAR target missing", errText)
                Dim codeType As String
                If UXBStep3InferExprType(ps, payload, codeType, errText) = 0 Then Return 0
                If UXBStep3TypeIsInteger(codeType) = 0 Then
                    Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL CODEVAR target must be integer", errText)
                End If
            Case Else
                Return UXBSemanticFail(SEM_E_INVALID_CALL, "unsupported SHELL option: " & optionName, errText)
            End Select
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If seenNowait <> 0 And (seenOutVar <> 0 Or seenErrVar <> 0) Then
        Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL NOWAIT cannot use OUTVAR/ERRVAR; use OUTPATH/ERRPATH", errText)
    End If
    If seenNowait <> 0 And seenTimeout <> 0 Then
        Return UXBSemanticFail(SEM_E_INVALID_CALL, "SHELL NOWAIT cannot use TIMEOUT", errText)
    End If
    Return 1
End Function

' PRINT_ITEM expression nodes are detached from their owner statement in the
' compact AST (the expression is stored through PRINT_ITEM.left). Parameters
' remain direct children of the containing routine, so this narrow fallback
' preserves lexical validation without accepting arbitrary unknown names.
Private Function Step3ContainingRoutineHasFormalParam(ByRef ps As ParseState, ByVal statementNodeIdx As Integer, ByRef nameText As String) As Integer
    Dim wanted As String
    wanted = UCase(Trim(nameText))
    If wanted = "" Then Return 0

    Dim p As Integer
    p = statementNodeIdx
    Do While p >= 0 And p < ps.ast.count
        Dim k As String
        k = Step3NodeKind(ps, p)
        If k = "FUNCTION_STMT" Or k = "SUB_STMT" Then
            Dim ch As Integer
            ch = ps.ast.nodes(p).firstChild
            Do While ch <> -1
                If Step3NodeKind(ps, ch) = "PARAM_DECL" Then
                    If UCase(Trim(ps.ast.nodes(ch).value)) = wanted Then Return 1
                End If
                ch = ps.ast.nodes(ch).nextSibling
            Loop
            Return 0
        End If
        p = ps.ast.nodes(p).parent
    Loop
    Return 0
End Function

Private Function Step3ValidateStatements(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        If InStr(k, "_STMT") > 0 Then
            If UXBStep3CheckStatementType(k, errText) = 0 Then Return 0
        End If

        If k = "SLOT_CONTROL_STMT" Then
            If Step3ValidateSlotControlTarget(ps, i, errText) = 0 Then Return 0
        End If

        If k = "SHELL_STMT" Then
            If Step3ValidateShellStmt(ps, i, errText) = 0 Then Return 0
        End If

        If k = "GOTO_STMT" Or k = "GOSUB_STMT" Then
            Dim labelName As String
            labelName = Trim(ps.ast.nodes(i).value)
            If labelName = "" Then
                Dim labelTarget As Integer
                labelTarget = Step3ChildAt(ps, i, 0)
                If labelTarget <> -1 Then labelName = Trim(ps.ast.nodes(labelTarget).value)
            End If
            Dim labelScope As Integer
            labelScope = Step3ScopeForNode(ps, i)
            If labelName = "" OrElse (UXBStep3SymbolFindExact(labelName, SYM_LABEL, labelScope) = -1 AndAlso UXBStep3SymbolFindExact(labelName, SYM_LABEL, 0) = -1) Then
                Return UXBSemanticFail(SEM_E_UNKNOWN_SYMBOL, "unknown label: " & labelName, errText)
            End If
        End If

        If k = "PRINT_STMT" Or k = "PRINT_FILE_STMT" Then
            Dim ch As Integer = ps.ast.nodes(i).firstChild
            Do While ch <> -1
                Dim ck As String = Step3NodeKind(ps, ch)
                If ck = "PRINT_ITEM" Then
                    Dim exprIdx As Integer = Step3ChildAt(ps, ch, 0)
                    If exprIdx = -1 Then exprIdx = ps.ast.nodes(ch).left
                    If exprIdx <> -1 Then
                        Dim ek As String = Step3NodeKind(ps, exprIdx)
                        If ek = "IDENT" Or ek = "IDENTIFIER" Or ek = "KEYWORD_REF" Then
                            Dim symName As String = Trim(ps.ast.nodes(exprIdx).value)
                            If symName = "" Then symName = Trim(ps.ast.nodes(exprIdx).symbolName)
                            If symName <> "" Then
                                Dim symNameUpper As String
                                symNameUpper = UCase(Trim(symName))
                                If Not (symNameUpper = UXB_TASK_INPUT_NAME Or symNameUpper = UXB_TASK_RESULT_NAME Or symNameUpper = "THIS" Or symNameUpper = "ME" Or symNameUpper = "SUPER") Then
                                    Dim rr As UXBSymbolResolveResult
                                    ' A PRINT_ITEM owns its expression through the left link;
                                    ' that expression's parent is intentionally unset in the AST.
                                    ' Resolve from the statement scope, not from the detached child,
                                    ' so normal FUNCTION/SUB formal parameters remain visible.
                                    If UXBSymbolResolveAnyKindLexical(Step3ScopeForNode(ps, i), symName, rr) = 0 Then
                                        If Step3ContainingRoutineHasFormalParam(ps, i, symName) = 0 Then
                                            If Step3ImplicitClassFieldExists(ps, exprIdx, symName) = 0 Then
                                                If Step3HasConstDeclAnyScopeFix6(ps, symName) = 0 Then
                                                    Return UXBSemanticFail(SEM_E_UNKNOWN_SYMBOL, "unknown symbol: " & symName, errText)
                                                End If
                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                        Dim t As String
                        If UXBStep3InferExprType(ps, exprIdx, t, errText) = 0 Then Return 0
                        ' S-233: bir sinif ornegini dogrudan yazdirmak (PRINT nesne) motorlara gore 0, OBJECT#0, adres ya da
                        ' [object Object] verirdi. Artik: sinifta MAGIC TOSTRING (kalitimla gelen dahil) varsa oge STR(oge)'ye
                        ' yeniden yazilir (PRINT STR(nesne) ile ayni sonuc, altı yolda); yoksa anlasilir bir derleme hatasidir.
                        Dim printClass As String = UCase(Trim(t))
                        If printClass <> "" And printClass <> "OBJECT" And SemHasClassName(ps, printClass) <> 0 Then
                            Dim printMagicType As String
                            If UXBStep3ClassMethodReturnTypeInHierarchy(ps, printClass, "MAGIC_TOSTRING", printMagicType) = 0 Then
                                errText = "semantic: UXB_PRINT_OBJECT: PRINT cannot print an object of class " & printClass & "; define MAGIC TOSTRING in the class or print its fields [line " & LTrim(Str(ps.ast.nodes(i).lineNo)) & "]"
                                Return 0
                            End If
                            Dim printStrCall As Integer
                            printStrCall = ASTNewNode(ps.ast, "CALL_EXPR", "STR", "", ps.ast.nodes(exprIdx).lineNo, ps.ast.nodes(exprIdx).colNo, ps.ast.nodes(exprIdx).sourceFile)
                            If printStrCall < 0 Then errText = "semantic: PRINT object normalization allocation failed": Return 0
                            If Step3ChildAt(ps, ch, 0) = exprIdx Then
                                ps.ast.nodes(printStrCall).nextSibling = ps.ast.nodes(exprIdx).nextSibling
                                ps.ast.nodes(ch).firstChild = printStrCall
                                ps.ast.nodes(printStrCall).parent = ch
                            Else
                                ps.ast.nodes(ch).left = printStrCall
                            End If
                            ps.ast.nodes(exprIdx).nextSibling = -1
                            ps.ast.nodes(exprIdx).parent = -1
                            ASTAddChild ps.ast, printStrCall, exprIdx
                            If UXBStep3InferExprType(ps, printStrCall, t, errText) = 0 Then Return 0
                        End If
                    End If
                End If
                ch = ps.ast.nodes(ch).nextSibling
            Loop
        End If

        If k = "TRIGGER_STMT" Then
            Dim triggerKind As String
            triggerKind = UCase(Trim(ps.ast.nodes(i).value))
            If triggerKind = "EVENT" Then
                Dim trgNode As Integer
                trgNode = Step3ChildAt(ps, i, 0)
                If trgNode <> -1 Then
                    Dim trgName As String
                    trgName = Trim(ps.ast.nodes(trgNode).value)
                    If trgName <> "" Then
                        If Step3HasNamedNode(ps, "EVENT_STMT", trgName) = 0 Then
                            Return UXBSemanticFail(SEM_E_INVALID_CALL, "unknown event target: " & trgName, errText)
                        End If
                    End If
                End If
            End If
        End If

        If k = "POKEB_STMT" Or k = "POKEW_STMT" Or k = "POKED_STMT" Or k = "POKES_STMT" Then
            Dim addrNode As Integer
            addrNode = Step3ChildAt(ps, i, 0)
            If addrNode <> -1 Then
                If Step3NodeKind(ps, addrNode) = "NUMBER" Then
                    If Val(ps.ast.nodes(addrNode).value) < 0 Then
                        Return UXBSemanticFail(SEM_E_INVALID_CALL, "poke address must be non-negative", errText)
                    End If
                End If
            End If
        End If

        If k = "PRINT_FILE_STMT" Or (k = "PRINT_STMT" And UCase(Trim(ps.ast.nodes(i).op)) = "FILE") Then
            Dim hNode As Integer
            hNode = Step3ChildAt(ps, i, 0)
            If hNode <> -1 And Step3NodeKind(ps, hNode) = "NUMBER" Then
                Dim hNo As Integer
                hNo = ValInt(ps.ast.nodes(hNode).value)
                Dim openFound As Integer
                openFound = 0
                Dim j As Integer
                For j = 0 To ps.ast.count - 1
                    If Step3NodeKind(ps, j) = "OPEN_STMT" Then
                        Dim oh As Integer
                        oh = Step3ChildAt(ps, j, 2)
                        If oh <> -1 And Step3NodeKind(ps, oh) = "NUMBER" Then
                            If ValInt(ps.ast.nodes(oh).value) = hNo Then
                                openFound = 1
                                Exit For
                            End If
                        End If
                    End If
                Next j
                If openFound = 0 Then
                    Return UXBSemanticFail(SEM_E_INVALID_CALL, "print file handle not opened: #" & LTrim(Str(hNo)), errText)
                End If
            End If
        End If
    Next i
    Return 1
End Function

Private Function Step3ValidateCompoundAssignmentTypes(ByVal opTextRaw As String, ByVal leftTypeRaw As String, ByVal rightTypeRaw As String, ByRef errText As String) As Integer
    Dim opText As String
    Dim leftType As String
    Dim rightType As String
    opText = UCase(Trim(opTextRaw))
    leftType = UXBStep3TypeCanonical(leftTypeRaw)
    rightType = UXBStep3TypeCanonical(rightTypeRaw)

    Select Case opText
    Case "+="
        If UXBStep3TypeIsString(leftType) <> 0 Then
            ' S-521: `s = s + 7` UXB_MIXED_STRING_NUMERIC ile reddedilir; bilesik biçim `s += 7` de ayni kapidan gecmeli
            ' (eskiden hata vermiyor, MIR-x64 erisim ihlaliyle cokuyor, oteki yollar sayiyi sessizce birlestiriyordu).
            If UXBStep3TypeIsNumeric(rightType) <> 0 Then
                errText = "UXB_MIXED_STRING_NUMERIC: string and numeric operands cannot be mixed; use STR or VAL"
                Return 0
            End If
            errText = ""
            Return 1
        End If
        If UXBStep3TypeIsNumeric(leftType) = 0 Or UXBStep3TypeIsNumeric(rightType) = 0 Then
            errText = "type: numeric operands required for compound assignment " & opText
            Return 0
        End If
    Case "-=", "*=", "/=", "**="
        If UXBStep3TypeIsNumeric(leftType) = 0 Or UXBStep3TypeIsNumeric(rightType) = 0 Then
            errText = "type: numeric operands required for compound assignment " & opText
            Return 0
        End If
    Case "\=", "%=", "&=", "|=", "^=", "<<=", ">>=", "ROL=", "ROR="
        If UXBStep3TypeIsInteger(leftType) = 0 Or UXBStep3TypeIsInteger(rightType) = 0 Then
            errText = "type: integer operands required for compound assignment " & opText
            Return 0
        End If
    Case Else
        errText = "type: unsupported compound assignment operator " & opText
        Return 0
    End Select

    errText = ""
    Return 1
End Function

' S-148: DIM initializers are assignments too.  Keep their compatibility
' check in the same semantic gate as ordinary assignments so MIR lowering
' cannot silently store an expression of a different type.
Private Function Step3IntegerLiteralText(ByRef ps As ParseState, ByVal exprNode As Integer, ByRef literalText As String) As Integer
    If exprNode < 0 Or exprNode >= ps.ast.count Then Return 0
    Dim k As String = Step3NodeKind(ps, exprNode)
    If k = "NUMBER" Then
        ' S-564: the NULL / NOTHING literal is the NUMBER 0 for the engines but not an integer literal for the type rules
        ' (`i = NULL` must not be accepted as `i = 0`)
        If UCase(Trim(ps.ast.nodes(exprNode).typeName)) = TYPE_NULL Then Return 0
        literalText = Trim(ps.ast.nodes(exprNode).value)
        Return IIf(UXBNumberLiteralIsFloat(literalText) = 0, 1, 0)
    End If
    If k = "UNARY" Or k = "UNARY_EXPR" Then
        Dim opText As String = Trim(ps.ast.nodes(exprNode).op)
        If opText = "" Then opText = Trim(ps.ast.nodes(exprNode).value)
        If opText <> "+" And opText <> "-" Then Return 0
        Dim child As Integer = ps.ast.nodes(exprNode).left
        If child = -1 Then child = Step3ChildAt(ps, exprNode, 0)
        If Step3IntegerLiteralText(ps, child, literalText) = 0 Then Return 0
        If opText = "-" Then
            If Left(literalText, 1) = "-" Then
                literalText = Mid(literalText, 2)
            Else
                If Left(literalText, 1) = "+" Then literalText = Mid(literalText, 2)
                literalText = "-" & literalText
            End If
        End If
        Return 1
    End If
    Return 0
End Function

Private Function Step3IntegerLiteralFits(ByVal literalText As String, ByVal targetType As String) As Integer
    Dim t As String = UCase(Trim(literalText))
    Dim negative As Integer = 0
    If Left(t, 1) = "-" Then negative = 1: t = Mid(t, 2)
    If Left(t, 1) = "+" Then t = Mid(t, 2)
    Dim radix As ULongInt = 10
    Select Case Left(t, 2)
    Case "&H", "0X": radix = 16: t = Mid(t, 3)
    Case "&O", "0O": radix = 8: t = Mid(t, 3)
    Case "&B", "%B", "0B": radix = 2: t = Mid(t, 3)
    End Select
    If t = "" Then Return 0
    Dim magnitude As ULongInt = 0
    Dim digits As Integer = 0
    For literalPos As Integer = 1 To Len(t)
        Dim ch As String = Mid(t, literalPos, 1)
        If ch = "_" Then Continue For
        Dim digit As Integer = Step3EnumDigitValue(ch)
        If digit < 0 Then Return 0
        If CULngInt(digit) >= radix Then Return 0
        ' Compare before multiplication, including the exact U64 boundary.
        If magnitude > (&hFFFFFFFFFFFFFFFFULL - CULngInt(digit)) \ radix Then Return 0
        magnitude = magnitude * radix + CULngInt(digit)
        digits += 1
    Next literalPos
    If digits = 0 Then Return 0
    Dim limit As ULongInt
    Select Case UXBStep3TypeCanonical(targetType)
    Case TYPE_I8: limit = IIf(negative <> 0, 128ULL, 127ULL)
    Case TYPE_U8: limit = 255ULL
    Case TYPE_I16: limit = IIf(negative <> 0, 32768ULL, 32767ULL)
    Case TYPE_U16: limit = 65535ULL
    Case TYPE_I32: limit = IIf(negative <> 0, 2147483648ULL, 2147483647ULL)
    Case TYPE_U32: limit = &hFFFFFFFFULL
    Case TYPE_I64: limit = IIf(negative <> 0, &h8000000000000000ULL, &h7FFFFFFFFFFFFFFFULL)
    Case TYPE_U64: limit = &hFFFFFFFFFFFFFFFFULL
    Case Else: Return 0
    End Select
    Dim canonicalType As String = UXBStep3TypeCanonical(targetType)
    If Left(canonicalType, 6) = "TYPE_U" And negative <> 0 And magnitude <> 0 Then Return 0
    Return IIf(magnitude <= limit, 1, 0)
End Function

Private Function Step3CheckAssignmentExpression(ByRef ps As ParseState, ByVal targetType As String, ByVal actualType As String, ByVal exprNode As Integer, ByRef errText As String) As Integer
    Dim literalText As String
    Dim fixedIntegerTarget As Integer = 0
    Select Case UXBStep3TypeCanonical(targetType)
    Case TYPE_I8, TYPE_U8, TYPE_I16, TYPE_U16, TYPE_I32, TYPE_U32, TYPE_I64, TYPE_U64
        fixedIntegerTarget = 1
    End Select
    If fixedIntegerTarget <> 0 AndAlso Step3IntegerLiteralText(ps, exprNode, literalText) <> 0 Then
        If Step3IntegerLiteralFits(literalText, targetType) <> 0 Then errText = "": Return 1
        errText = "type: integer literal out of range for " & UXBStep3TypeCanonical(targetType) & ": " & literalText
        Return 0
    End If
    Return UXBStep3CheckAssignment(targetType, actualType, errText)
End Function

Private Function Step3ValidateDimInitializers(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) <> "DIM_DECL" Then Continue For

        Dim declaredType As String
        If Step3NodeDeclaredType(ps, i, declaredType) = 0 Then Continue For
        declaredType = UXBStep3TypeCanonical(declaredType)

        Dim initNode As Integer
        initNode = Step3FindChildByKind(ps, i, "INIT_EXPR")
        If initNode = -1 Then Continue For

        Dim initExpr As Integer
        initExpr = ps.ast.nodes(initNode).left
        If initExpr = -1 Then initExpr = Step3ChildAt(ps, initNode, 0)
        If initExpr = -1 Then
            errText = "type: DIM initializer expression missing for " & ps.ast.nodes(i).value
            Return 0
        End If

        Dim actualType As String
        If UXBStep3InferExprType(ps, initExpr, actualType, errText) = 0 Then Return 0
        actualType = UXBStep3TypeCanonical(actualType)

        ' Class assignment is nominal and directional; the generic coercion
        ' table deliberately does not encode inheritance/interface relations.
        If SemHasClassName(ps, actualType) <> 0 Then
            If SemHasClassName(ps, declaredType) <> 0 Or SemFindInterfaceNode(ps, declaredType) <> -1 Or declaredType = "OBJECT" Then
                If SemCanAssignClassType(ps, declaredType, actualType) = 0 Then
                    errText = "type: DIM initializer cannot convert " & actualType & " to " & declaredType
                    Return 0
                End If
            Else
                If Step3CheckAssignmentExpression(ps, declaredType, actualType, initExpr, errText) = 0 Then Return 0
            End If
        Else
            If Step3CheckAssignmentExpression(ps, declaredType, actualType, initExpr, errText) = 0 Then Return 0
        End If
    Next i
    Return 1
End Function

Private Function Step3ValidateAssignments(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) = "ASSIGN_STMT" Then
            Dim lhs As Integer = Step3ChildAt(ps, i, 0)
            Dim rhs As Integer = Step3ChildAt(ps, i, 1)
            If lhs = -1 Then lhs = ps.ast.nodes(i).left
            If rhs = -1 Then rhs = ps.ast.nodes(i).right
            If lhs <> -1 And rhs <> -1 Then
                Dim lhsKind As String
                lhsKind = Step3NodeKind(ps, lhs)
                If lhsKind = "IDENT" Or lhsKind = "IDENTIFIER" Or lhsKind = "KEYWORD_REF" Then
                    Dim constLhsName As String
                    constLhsName = Trim(ps.ast.nodes(lhs).value)
                    Dim constLhsResult As UXBSymbolResolveResult
                    ' Resolve the nearest symbol across all kinds first.  A
                    ' local DIM/parameter shadows an outer CONST; looking up
                    ' SYM_CONST alone would incorrectly skip that shadow.
                    If constLhsName <> "" And UXBSymbolResolveAnyKindLexical(Step3ScopeForNode(ps, lhs), constLhsName, constLhsResult) <> 0 AndAlso UCase(Trim(constLhsResult.kind)) = SYM_CONST Then
                        errText = "UXB_CONST_ASSIGNMENT: cannot assign to CONST " & constLhsName
                        Return 0
                    End If
                ElseIf lhsKind = "CALL_EXPR" Then
                    ' Indexed assignment is normally a mutable array write;
                    ' still reject it when the base name resolves to CONST.
                    Dim constCallName As String
                    constCallName = UCase(Trim(ps.ast.nodes(lhs).value))
                    Dim constCallResult As UXBSymbolResolveResult
                    If constCallName <> "" And UXBSymbolResolveAnyKindLexical(Step3ScopeForNode(ps, lhs), constCallName, constCallResult) <> 0 AndAlso UCase(Trim(constCallResult.kind)) = SYM_CONST Then
                        errText = "UXB_CONST_ASSIGNMENT: cannot assign to CONST " & constCallName
                        Return 0
                    End If
                End If
                If lhsKind = "CALL_EXPR" Then
                    Dim callName As String
                    callName = UCase(Trim(ps.ast.nodes(lhs).value))
                    If callName = "" Then callName = UCase(Trim(ps.ast.nodes(lhs).symbolName))
                    If callName = "" Then
                        errText = "assign: left side is not writable: CALL_EXPR"
                        Return 0
                    End If

                    Dim rr As UXBSymbolResolveResult
                    Dim scopeId As Integer
                    scopeId = Step3ScopeForNode(ps, lhs)
                    If UXBSymbolResolveAnyKindLexical(scopeId, callName, rr) = 0 Then
                        ' S-162: NAMESPACE dizisi (normallestirilmis nitelikli ad "NS.DIZI") ad alani kapsaminda
                        ' kayitli; sozcuksel arama disaridan bulamaz -- bildirimin kendisi yazilabilirligi kanitlar.
                        Dim nsDeclFound As Integer = 0
                        If InStr(callName, ".") > 0 Then
                            Dim nsd As Integer
                            For nsd = 0 To ps.ast.count - 1
                                If Step3NodeKind(ps, nsd) = "DIM_DECL" AndAlso UCase(Trim(ps.ast.nodes(nsd).value)) = callName Then nsDeclFound = 1: Exit For
                            Next nsd
                        End If
                        If nsDeclFound = 0 Then
                            errText = "assign: left side is not writable: CALL_EXPR"
                            Return 0
                        End If
                        Continue For
                    End If

                    Select Case UCase(Trim(rr.kind))
                    Case SYM_VAR, SYM_PARAM, SYM_TYPE_FIELD, SYM_CLASS_FIELD
                        ' CALL_EXPR array-index form (A(i)) writable.
                    Case Else
                        errText = "assign: left side is not writable: CALL_EXPR"
                        Return 0
                    End Select
                Else
                    If UXBStep3CheckAssignableNodeKind(lhsKind, errText) = 0 Then Return 0
                End If
                Dim lt As String, rt As String
                If UXBStep3InferExprType(ps, lhs, lt, errText) = 0 Then Return 0
                If UXBStep3InferExprType(ps, rhs, rt, errText) = 0 Then Return 0
                If UXBStep3TypeCanonical(lt) = TYPE_OBJECT Then
                    Dim lk As String
                    lk = Step3NodeKind(ps, lhs)
                    If lk = "IDENT" Or lk = "IDENTIFIER" Then
                        Dim contextName As String
                        contextName = UCase(Trim(ps.ast.nodes(lhs).value))
                        If contextName = UXB_TASK_INPUT_NAME Or contextName = UXB_TASK_RESULT_NAME Then
                            lt = rt
                        End If
                        Dim lFieldType As String
                        If Step3ImplicitClassFieldType(ps, lhs, ps.ast.nodes(lhs).value, lFieldType) <> 0 Then
                            lt = UXBStep3TypeCanonical(lFieldType)
                        End If
                    End If
                End If
                Dim assignOp As String
                assignOp = Trim(ps.ast.nodes(i).op)
                If assignOp = "" Or assignOp = "=" Or assignOp = "=+" Or assignOp = "=-" Then
                    ' Class/interface assignment is nominal and directional:
                    ' a derived instance may be viewed as its base/interface,
                    ' while the inverse conversion remains an error. The
                    ' generic TYPE_OBJECT rule cannot express that relation.
                    Dim classAssignmentHandled As Integer
                    classAssignmentHandled = 0
                    If SemHasClassName(ps, UCase(Trim(rt))) <> 0 Then
                        If SemHasClassName(ps, UCase(Trim(lt))) <> 0 Or SemFindInterfaceNode(ps, UCase(Trim(lt))) <> -1 Or UCase(Trim(lt)) = "OBJECT" Then
                            If SemCanAssignClassType(ps, UCase(Trim(lt)), UCase(Trim(rt))) = 0 Then
                                errText = "type: assignment cannot convert " & rt & " to " & lt
                                Return 0
                            End If
                            classAssignmentHandled = 1
                        End If
                    End If
                    If classAssignmentHandled = 0 Then
                        If Step3CheckAssignmentExpression(ps, lt, rt, rhs, errText) = 0 Then Return 0
                    End If
                Else
                    If Step3ValidateCompoundAssignmentTypes(assignOp, lt, rt, errText) = 0 Then Return 0
                End If
            End If
        End If
    Next i
    Return 1
End Function

Private Function Step3ValidateCallsAndReturns(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        If k = "CALL_STMT" Or k = "CALL_EXPR" Then
            If Trim(ps.ast.nodes(i).value) = "" Then Return UXBSemanticFail(SEM_E_INVALID_CALL, "empty call target", errText)

            Dim callName As String
            callName = UCase(Trim(ps.ast.nodes(i).value))
            If callName = "" Then callName = UCase(Trim(ps.ast.nodes(i).symbolName))
            If callName = "BIGINIT" Then
                Dim kNode As Integer
                kNode = Step3ChildAt(ps, i, 0)
                Dim vNode As Integer
                vNode = Step3ChildAt(ps, i, 1)
                If kNode <> -1 And vNode <> -1 Then
                    Dim kText As String
                    Dim vText As String
                    kText = UCase(Trim(ps.ast.nodes(kNode).value))
                    vText = Trim(ps.ast.nodes(vNode).value)
                    If kText = "BIGI" Or kText = "BIGINT" Or kText = "BIG_INTEGER" Then
                        If InStr(vText, ".") > 0 Then
                            Return UXBSemanticFail(SEM_E_INVALID_CALL, "BIGINT decimal string not allowed: " & vText, errText)
                        End If
                    End If
                End If
            End If
        ElseIf k = "RETURN_STMT" Then
            Dim child As Integer = Step3ChildAt(ps, i, 0)
            If child = -1 Then child = ps.ast.nodes(i).left
            If child <> -1 Then
                Dim rt As String
                If UXBStep3InferExprType(ps, child, rt, errText) = 0 Then Return 0
                Dim owner As Integer = UXBTaskEnclosingRoutine(ps, i)
                If owner <> -1 Then
                    Dim wanted As String
                    Dim retTypeNode As Integer = Step3FindChildByKind(ps, owner, "RETURN_TYPE")
                    ' Bare RETURN also serves GOSUB. Only value returns with an
                    ' explicit routine result declaration enter this type gate.
                    If retTypeNode <> -1 Then
                        wanted = UXBStep3TypeCanonical(ps.ast.nodes(retTypeNode).value)
                        If SemHasClassName(ps, UCase(rt)) <> 0 And (SemHasClassName(ps, UCase(wanted)) <> 0 Or SemFindInterfaceNode(ps, UCase(wanted)) <> -1 Or UCase(wanted) = "OBJECT") Then
                            If SemCanAssignClassType(ps, UCase(wanted), UCase(rt)) = 0 Then errText = "type: RETURN cannot convert " & rt & " to " & wanted: Return 0
                        Else
                            If Step3CheckAssignmentExpression(ps, wanted, rt, child, errText) = 0 Then
                                errText = "return: " & errText & " @" & LTrim(Str(ps.ast.nodes(i).lineNo)) & ":" & LTrim(Str(ps.ast.nodes(i).colNo))
                                Return 0
                            End If
                        End If
                    ElseIf Step3NodeKind(ps, owner) = "SUB_STMT" Or Step3NodeKind(ps, owner) = "CLASS_CONSTRUCTOR_DECL" Or Step3NodeKind(ps, owner) = "CLASS_DESTRUCTOR_DECL" Then
                        errText = "return: value returned from void routine"
                        Return 0
                    End If
                End If
            End If
        End If
    Next i
    Return 1
End Function

' S-577 (2026-10-16): the SUB / FUNCTION that a plain-name call resolves to; 0 or 2+ candidates -> -1 (never guess).
Private Function Step3FindUserRoutineForCall(ByRef ps As ParseState, ByRef callNameRaw As String) As Integer
    Dim wanted As String
    wanted = UCase(Trim(callNameRaw))
    If wanted = "" Or InStr(wanted, ".") > 0 Then Return -1
    Dim found As Integer
    found = -1
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Select Case Step3NodeKind(ps, i)
        Case "SUB_STMT", "FUNCTION_STMT"
            If UCase(Trim(ps.ast.nodes(i).value)) = wanted Then
                If found <> -1 Then Return -1
                found = i
            End If
        End Select
    Next i
    Return found
End Function

' S-577: nominal interface check for call arguments. A class object may be passed where an INTERFACE type is expected
' only if the class (or one of its bases) lists the interface in IMPLEMENTS. Without this the call passed the compile
' gate for a class that merely has methods with the interface's names, and then behaved differently on every engine
' (AST/MIR ran it; x64 "vtable slot has no native function", JS "vtable slot 0 is not bound", WASM UXB_VTABLE_SLOT_MISSING).
Private Function Step3ValidateInterfaceArguments(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = Step3NodeKind(ps, i)
        If k <> "CALL_STMT" And k <> "CALL_EXPR" Then Continue For

        Dim callee As Integer
        callee = Step3FindUserRoutineForCall(ps, ps.ast.nodes(i).value)
        If callee = -1 Then Continue For

        Dim argPos As Integer
        argPos = 0
        Dim ch As Integer
        ch = ps.ast.nodes(i).firstChild
        Do While ch <> -1
            Dim ck As String
            ck = Step3NodeKind(ps, ch)
            If ck <> "GENERIC_ARG" And ck <> "TYPE_ARG" Then
                Dim prm As Integer
                prm = -1
                Dim pc As Integer
                pc = ps.ast.nodes(callee).firstChild
                Dim pidx As Integer
                pidx = 0
                Do While pc <> -1
                    If Step3NodeKind(ps, pc) = "PARAM_DECL" Then
                        If pidx = argPos Then
                            prm = pc
                            Exit Do
                        End If
                        pidx += 1
                    End If
                    pc = ps.ast.nodes(pc).nextSibling
                Loop

                If prm <> -1 Then
                    Dim paramType As String
                    If Step3NodeDeclaredType(ps, prm, paramType) <> 0 Then
                        paramType = UCase(Trim(paramType))
                        If paramType <> "" Then
                            If SemFindInterfaceNode(ps, paramType) <> -1 Then
                                Dim argType As String
                                Dim argErr As String
                                argErr = ""
                                If UXBStep3InferExprType(ps, ch, argType, argErr) <> 0 Then
                                    argType = UCase(Trim(UXBStep3TypeCanonical(argType)))
                                    If SemHasClassName(ps, argType) <> 0 Then
                                        If SemCanAssignClassType(ps, paramType, argType) = 0 Then
                                            errText = "type: argument " & LTrim(Str(argPos + 1)) & " of " & UCase(Trim(ps.ast.nodes(i).value)) & ": class " & argType & " does not implement INTERFACE " & paramType
                                            Return 0
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If
                End If
                argPos += 1
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
    Next i
    Return 1
End Function

Private Function Step3ValidateFFI(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        If k = "INLINE_STMT" Then
            If SemStep3TargetAllowsNode(k, "X64", errText) = 0 Then Return UXBSemanticFail(SEM_E_NATIVE_ONLY_TARGET, errText, errText)
        End If
        If k = "CALL_STMT" Or k = "CALL_EXPR" Then
            Dim callName As String = UCase(Trim(ps.ast.nodes(i).value))
            If Left(callName, 4) = "DLL:" Or Left(callName, 4) = "API:" Then
                Dim sig As String = ps.ast.nodes(i).typeName
                If sig = "" Then sig = "I32"
                If UXBStep3CheckFFISignature(sig, errText) = 0 Then Return 0
            End If
        End If
    Next i
    Return 1
End Function

Private Function Step3ValidateTypeLeak(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        Dim v As String = UCase(Trim(ps.ast.nodes(i).value))
        Dim tn As String = UCase(Trim(ps.ast.nodes(i).typeName))
        If UXBStep3TypeIsBlocked(tn) <> 0 Then Return UXBSemanticFail(SEM_E_TYPE_ERROR_LEAK, "blocked node type", errText)
        If (k = "TYPE_REF" Or k = "RETURN_TYPE") And UXBStep3TypeIsBlocked(v) <> 0 Then Return UXBSemanticFail(SEM_E_TYPE_ERROR_LEAK, "blocked type reference", errText)
    Next i
    Return 1
End Function

Private Function Step3ValidateLayoutCoverage(ByRef ps As ParseState, ByRef errText As String) As Integer
    If UXBStep3LayoutBuild(ps, errText) = 0 Then Return 0
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String = Step3NodeKind(ps, i)
        If UXBAstContractIsLayoutNode(k) <> 0 Then
            If UXBStep3LayoutCheckNode(ps, i, errText) = 0 Then Return UXBSemanticFail(SEM_E_MISSING_LAYOUT, errText, errText)
        End If
    Next i
    Return 1
End Function

Private Function Step3ValidateContractCoverage(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If SemStep3ContractAllowsNode(Step3NodeKind(ps, i), errText) = 0 Then Return 0
    Next i
    Return 1
End Function

Private Function Step3ValidateTargetCoverage(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If SemStep3TargetDecisionExists(Step3NodeKind(ps, i), errText) = 0 Then Return 0
    Next i
    Return 1
End Function

Private Function Step3JsonEscape(ByRef s As String) As String
    Dim outText As String
    outText = ""
    Dim i As Integer
    For i = 1 To Len(s)
        Dim ch As String
        ch = Mid(s, i, 1)
        Select Case ch
        Case "\"
            outText &= "\\"
        Case Chr(34)
            outText &= "\" & Chr(34)
        Case Chr(13)
            outText &= "\r"
        Case Chr(10)
            outText &= "\n"
        Case Chr(9)
            outText &= "\t"
        Case Else
            outText &= ch
        End Select
    Next i
    Return outText
End Function

Private Sub Step3AppendEnumItemsJson(ByRef ps As ParseState, ByVal enumNode As Integer, ByRef jsonOut As String)
    jsonOut &= Chr(34) & "items" & Chr(34) & ":["
    Dim firstItem As Integer
    firstItem = 1
    Dim ch As Integer
    ch = ps.ast.nodes(enumNode).firstChild
    Do While ch <> -1
        Dim ck As String
        ck = Step3NodeKind(ps, ch)
        If ck = "ENUM_ITEM" Then
            If firstItem = 0 Then jsonOut &= ","
            firstItem = 0
            jsonOut &= "{"
            jsonOut &= Chr(34) & "name" & Chr(34) & ":" & Chr(34) & Step3JsonEscape(ps.ast.nodes(ch).value) & Chr(34)
            Dim valNode As Integer
            valNode = Step3ChildAt(ps, ch, 0)
            If valNode <> -1 Then
                jsonOut &= "," & Chr(34) & "value_expr_kind" & Chr(34) & ":" & Chr(34) & Step3JsonEscape(ps.ast.nodes(valNode).kind) & Chr(34)
                jsonOut &= "," & Chr(34) & "value_expr_text" & Chr(34) & ":" & Chr(34) & Step3JsonEscape(ps.ast.nodes(valNode).value) & Chr(34)
            End If
            If Trim(ps.ast.nodes(ch).op) <> "" Then
                jsonOut &= "," & Chr(34) & "effective_value" & Chr(34) & ":" & Chr(34) & Step3JsonEscape(ps.ast.nodes(ch).op) & Chr(34)
            End If
            jsonOut &= "}"
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    jsonOut &= "]"
End Sub

Private Function Step3WriteEnumJson(ByRef ps As ParseState, ByRef outPath As String, ByRef errText As String) As Integer
    errText = ""
    Dim enumCount As Integer
    enumCount = 0
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) = "ENUM_STMT" Then enumCount += 1
    Next i

    Dim jsonOut As String
    jsonOut = "{"
    jsonOut &= Chr(34) & "schema_version" & Chr(34) & ":" & Chr(34) & "uxb.semantic.enums.v1" & Chr(34) & ","
    jsonOut &= Chr(34) & "layer_name" & Chr(34) & ":" & Chr(34) & "semantic" & Chr(34) & ","
    jsonOut &= Chr(34) & "status" & Chr(34) & ":" & Chr(34) & "ok" & Chr(34) & ","
    jsonOut &= Chr(34) & "enum_count" & Chr(34) & ":" & LTrim(Str(enumCount)) & ","
    jsonOut &= Chr(34) & "enums" & Chr(34) & ":["

    Dim firstEnum As Integer
    firstEnum = 1
    For i = 0 To ps.ast.count - 1
        If Step3NodeKind(ps, i) = "ENUM_STMT" Then
            If firstEnum = 0 Then jsonOut &= ","
            firstEnum = 0
            jsonOut &= "{"
            jsonOut &= Chr(34) & "name" & Chr(34) & ":" & Chr(34) & Step3JsonEscape(ps.ast.nodes(i).value) & Chr(34)
            Dim baseNode As Integer
            baseNode = Step3FindChildByKind(ps, i, "ENUM_BASE_TYPE")
            If baseNode <> -1 Then
                jsonOut &= "," & Chr(34) & "base_type" & Chr(34) & ":" & Chr(34) & Step3JsonEscape(ps.ast.nodes(baseNode).value) & Chr(34)
            End If
            jsonOut &= ","
            Step3AppendEnumItemsJson ps, i, jsonOut
            jsonOut &= "}"
        End If
    Next i

    jsonOut &= "]}"

    ' S-466 (ayni sinif): ust klasor yokken ciplak `Open` -exx altinda programi iptal ediyordu; ortak yazici klasoru olusturur.
    Dim writeErr As String
    If UXBReportWriteText(outPath, jsonOut, writeErr) = 0 Then
        errText = "semantic: enum json open failed " & outPath & " (" & writeErr & ")"
        Return 0
    End If
    Return 1
End Function

Function UXBSemanticWriteEnumsJson(ByRef ps As ParseState, ByRef outPath As String, ByRef errText As String) As Integer
    Return Step3WriteEnumJson(ps, outPath, errText)
End Function

Function SemStep3SemanticTypeLayoutGate(ByRef ps As ParseState, ByRef errText As String) As Integer
    errText = ""
    TypeBindingInit
    If Step3LoadLibraryTypeManifestIncludes(ps, errText) = 0 Then Return 0
    UXBStep3SymbolReset
    UXBStep3ScopeReset
    Dim ctx As UXBSemanticContext
    UXBSemanticContextInit(ctx, "X64")
    If Step3ValidateContractCoverage(ps, errText) = 0 Then Return 0
    If Step3RegisterDeclaredTypes(ps, errText) = 0 Then Return 0
    If Step3ValidateEnums(ps, errText) = 0 Then Return 0
    If Step3BindDeclarations(ps, errText) = 0 Then Return 0
    If Step3ValidateExpressions(ps, errText) = 0 Then Return 0
    If Step3ValidateStatements(ps, errText) = 0 Then Return 0
    If Step3ValidateDimInitializers(ps, errText) = 0 Then Return 0
    If Step3ValidateAssignments(ps, errText) = 0 Then Return 0
    If Step3ValidateCallsAndReturns(ps, errText) = 0 Then Return 0
    If Step3ValidateInterfaceArguments(ps, errText) = 0 Then Return 0
    If Step3ValidateFFI(ps, errText) = 0 Then Return 0
    If Step3ValidateTypeLeak(ps, errText) = 0 Then Return 0
    If Step3ValidateLayoutCoverage(ps, errText) = 0 Then Return 0
    If Step3ValidateTargetCoverage(ps, errText) = 0 Then Return 0

    Dim step5 As UXBSemanticStep5Result
    Dim step5Gate As UXBSemanticStep5GateResult
    Dim step5Err As String

    If UXBSemanticStep5Run(ps, step5, step5Err) = 0 Then
        errText = step5Err
        Return 0
    End If

    If UXBSemanticStep5GateCheck(step5, step5Gate) = 0 Then
        errText = step5Gate.errorsText
        Return 0
    End If

    If Trim(gUXBStep3ReportRoot) <> "" Then
        If UXBSemanticStep5WriteGateJson(step5, step5Gate, gUXBStep3ReportRoot & "/adim5_gate.json", errText) = 0 Then Return 0
        If UXBSemanticStep5WriteGateMarkdown(step5, step5Gate, gUXBStep3ReportRoot & "/adim5_gate.md", errText) = 0 Then Return 0
        If UXBSemanticStep5WriteTypeCsv(step5, gUXBStep3ReportRoot & "/adim5_type_table.csv", errText) = 0 Then Return 0
        If UXBSemanticStep5WriteLayoutCsv(step5, gUXBStep3ReportRoot & "/adim5_layout_report.csv", errText) = 0 Then Return 0
    End If
    ' semantic_enums.json artik UXBOutputContractAfterSemantic tarafindan build/<run_id>/json/semantic/enums.json altina yazilir.

    Return 1
End Function
#endif
