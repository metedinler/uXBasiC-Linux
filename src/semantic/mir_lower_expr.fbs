' Extracted MIRLowerExprNode

#include once "../parser/ast_namespace_const_lookup.fbs"
#include once "../parser/ast_enum_lookup.fbs"
#include once "../common/task_context_names.fbs"
#include once "library_type_contract.fbs"

' Dotted method-call MIR lowering. The RECEIVER_LIST contract keeps
' CALL_EXPR.left as receiver and firstChild as the argument list.
Declare Function MIRLowerExprNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueNameOut As String, ByRef errText As String) As Integer
' S-030 Faz 1B: TASK alici tipi ve TASK OF sonuc tipi, AST yorumlayicisi ve semantik
' kapiyla AYNI kuraldan gelir (type_binding/type_infer_expr.fbs, daha sonra derlenir).
#include once "../type_binding/type_infer_expr_decl.fbs"
Private Function MIRMemoryModeFromArgs(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef modeOut As String, ByRef argOffsetOut As Integer) As Integer
    modeOut = "AUTO"
    argOffsetOut = 0
    Dim firstNode As Integer
    firstNode = MIRChildAt(ps, nodeIdx, 0)
    If firstNode = -1 Then Return 1
    If UCase(ps.ast.nodes(firstNode).kind) = "KEYWORD_REF" Then
        Dim modeName As String
        modeName = UCase(Trim(ps.ast.nodes(firstNode).value))
        If modeName = "VIRTUAL" Or modeName = "NATIVE" Then
            modeOut = modeName
            argOffsetOut = 1
        End If
    End If
    ' S-069: no explicit mode -> AUTO resolves by the address expression's
    ' static type (UXBMemoryAddrIsPointer): pointer -> NATIVE, anything else
    ' stays AUTO, which every engine treats as the VIRTUAL sandbox.
    If modeOut = "AUTO" Then
        If UXBMemoryAddrIsPointer(ps, MIRChildAt(ps, nodeIdx, argOffsetOut)) <> 0 Then modeOut = "NATIVE"
    End If
    Return 1
End Function

Private Function MIRMemoryWidthForName(ByRef nameText As String) As Integer
    Select Case UCase(Trim(nameText))
    Case "PEEKB", "POKEB", "MEMCOPYB", "MEMFILLB": Return 1
    Case "PEEKW", "POKEW", "MEMCOPYW", "MEMFILLW": Return 2
    Case "PEEK", "PEEKD", "POKED", "POKE", "MEMCOPYD", "MEMFILLD": Return 4
    ' S-055: Q (64-bit) memory family, parallel to B/W/D above.
    Case "PEEKQ", "POKEQ", "MEMCOPYQ", "MEMFILLQ": Return 8
    End Select
    Return 0
End Function

Private Function MIRLibraryTypeOperandTypeName(ByRef ps As ParseState, ByRef module As MIRModule, ByVal fnIdx As Integer, ByVal nodeIdx As Integer, ByRef operandName As String, ByRef typeOut As String) As Integer
    typeOut = ""
    If MIRTryInferExprTypeName(ps, nodeIdx, typeOut) <> 0 Then
        typeOut = UCase(Trim(typeOut))
        If typeOut <> "" Then Return 1
    End If

    Dim key As String
    key = UCase(Trim(operandName))
    If key = "" Then Return 0

    Dim ai As Integer
    For ai = 0 To ps.ast.count - 1
        Dim ak As String
        ak = UCase(Trim(ps.ast.nodes(ai).kind))
        If ak <> "DIM_DECL" And ak <> "REDIM_DECL" And ak <> "PARAM_DECL" Then Continue For
        If UCase(Trim(ps.ast.nodes(ai).value)) <> key Then Continue For

        Dim typeNode As Integer
        typeNode = MIRFindChildByKind(ps, ai, "RETURN_TYPE")
        If typeNode = -1 Then typeNode = MIRFindChildByKind(ps, ai, "TYPE_REF")
        If typeNode <> -1 Then
            typeOut = UCase(Trim(MIRCanonicalTypeName(ps.ast.nodes(typeNode).value)))
            If typeOut <> "" Then Return 1
        End If
    Next ai

    If fnIdx >= 0 And fnIdx < module.functionCount Then
        Dim pi As Integer
        For pi = 0 To module.functions(fnIdx).paramVarCount - 1
            If UCase(Trim(module.functions(fnIdx).paramVars(pi))) = key Then
                typeOut = UCase(Trim(module.functions(fnIdx).paramVarTypes(pi)))
                Return IIf(typeOut <> "", 1, 0)
            End If
        Next pi

        Dim li As Integer
        For li = 0 To module.functions(fnIdx).localVarCount - 1
            If UCase(Trim(module.functions(fnIdx).localVars(li))) = key Then
                typeOut = UCase(Trim(module.functions(fnIdx).localVarTypes(li)))
                Return IIf(typeOut <> "", 1, 0)
            End If
        Next li
    End If

    Dim gi As Integer
    For gi = 0 To module.globalVarCount - 1
        If UCase(Trim(module.globalVars(gi))) = key Then
            typeOut = UCase(Trim(module.globalVarTypes(gi)))
            Return IIf(typeOut <> "", 1, 0)
        End If
    Next gi

    Return 0
End Function

' B3: only these provider calls hand a fresh or explicitly retained value to
' the caller. NORMALIZE is intentionally excluded: it mutates and returns its
' source payload, so a later BYVAL/RETURN boundary still needs TYPE.COPY.
Private Function MIRManagedCallProducesOwnedTransfer(ByRef ps As ParseState, ByVal nodeIdx As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    If UCase(Trim(ps.ast.nodes(nodeIdx).kind)) <> "CALL_EXPR" Then Return 0

    Dim ownerIdx As Integer
    Dim typeName As String
    Dim memberName As String
    If UXBLibraryTypeFindCallOwner(ps.ast.nodes(nodeIdx).value, ownerIdx, typeName, memberName) <> 0 Then
        Select Case UCase(Trim(memberName))
        Case "CONSTRUCT", "COPY", "CLONE", "RETAIN"
            Return 1
        Case Else
            Return 0
        End Select
    End If

    ' User FUNCTION results are lowered through their declared RETURN type;
    ' the return boundary below provides the managed transfer.
    Return 1
End Function

' B3: a managed value passed to a default (BYVAL) parameter needs its own
' language-level value before the callee starts.  Provider-produced call
' results already represent a fresh/owned transfer, so copying those again
' would change the provider's ownership count without adding semantic value.
Private Function MIRPrepareManagedByValArgument(ByRef ps As ParseState, ByVal argNode As Integer, ByVal paramTypeRaw As String, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef argName As String, ByRef errText As String) As Integer
    Dim paramType As String
    paramType = UCase(Trim(MIRCanonicalTypeName(paramTypeRaw)))
    If paramType = "" Or UXBLibraryTypeNeedsManagedCopy(paramType) = 0 Then Return 1

    If argNode < 0 Or argNode >= ps.ast.count Then Return 1
    Dim sourceKind As String
    sourceKind = UCase(Trim(ps.ast.nodes(argNode).kind))
    If sourceKind = "CALL_EXPR" And MIRManagedCallProducesOwnedTransfer(ps, argNode) <> 0 Then Return 1

    Dim transferMember As String
    transferMember = UXBLibraryTypeManagedTransferMember(paramType)
    If transferMember = "" Then Return 0
    Dim copyTemp As String
    copyTemp = MIRNextTemp(tempSeed)
    MIRSetCurrentSourceFromAstNode ps, argNode
    MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, copyTemp, 2, paramType & "." & transferMember, argName
    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, paramType
    argName = copyTemp
    Return 1
End Function

Private Function MIRPrepareManagedReturnValue(ByRef ps As ParseState, ByVal exprNode As Integer, ByVal returnTypeRaw As String, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueName As String, ByRef errText As String) As Integer
    Dim returnType As String
    returnType = UCase(Trim(MIRCanonicalTypeName(returnTypeRaw)))
    ' A numeric return is an assignment to the declared result slot. Carry
    ' the conversion in MIR so both interpreters and backends see its type.
    If exprNode >= 0 And exprNode < ps.ast.count And UXBStep3TypeIsNumeric(returnType) <> 0 Then
        Dim sourceType As String
        If UXBStep3InferExprType(ps, exprNode, sourceType, errText) = 0 Then Return 0
        If UXBStep3TypeCanonical(sourceType) <> UXBStep3TypeCanonical(returnType) Then
            Dim castTemp As String = MIRNextTemp(tempSeed)
            MIRSetCurrentSourceFromAstNode ps, exprNode
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CAST, castTemp, 1, valueName
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, returnType
            valueName = castTemp
        End If
    End If
    If returnType = "" Or UXBLibraryTypeNeedsManagedCopy(returnType) = 0 Then Return 1

    If exprNode < 0 Or exprNode >= ps.ast.count Then Return 1
    Dim sourceKind As String
    sourceKind = UCase(Trim(ps.ast.nodes(exprNode).kind))
    If sourceKind = "CALL_EXPR" And MIRManagedCallProducesOwnedTransfer(ps, exprNode) <> 0 Then Return 1

    Dim transferMember As String
    transferMember = UXBLibraryTypeManagedTransferMember(returnType)
    If transferMember = "" Then Return 0
    Dim copyTemp As String
    copyTemp = MIRNextTemp(tempSeed)
    MIRSetCurrentSourceFromAstNode ps, exprNode
    MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, copyTemp, 2, returnType & "." & transferMember, valueName
    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, returnType
    valueName = copyTemp
    Return 1
End Function

Private Function MIRFindCallFunctionIndexLocal(ByRef module As MIRModule, ByRef callNameRaw As String) As Integer
    Dim wanted As String
    wanted = UCase(Trim(callNameRaw))
    If wanted = "" Then Return -1

    Dim i As Integer
    For i = 0 To module.functionCount - 1
        If UCase(Trim(module.functions(i).name)) = wanted Then Return i
    Next i
    Return -1
End Function

Private Function MIRLowerArraySizeOfCall(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByVal blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueNameOut As String, ByRef handledOut As Integer, ByRef errText As String) As Integer
    handledOut = 0
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 1
    If UCase(Trim(ps.ast.nodes(nodeIdx).kind)) <> "CALL_EXPR" Then Return 1
    If UCase(Trim(ps.ast.nodes(nodeIdx).value)) <> "SIZEOF" Then Return 1
    Dim argNode As Integer = MIRChildAt(ps, nodeIdx, 0)
    If argNode = -1 Then Return 1
    Dim argKind As String = UCase(Trim(ps.ast.nodes(argNode).kind))
    If argKind <> "IDENT" And argKind <> "KEYWORD_REF" Then Return 1

    Dim info As UXBArrayMemoryInfo
    Dim infoErr As String
    If UXBFindArrayMemoryInfo(ps, ps.ast.nodes(argNode).value, info, infoErr) = 0 Then errText = infoErr: Return 0
    If info.found = 0 Then
        ' S-079: SIZEOF(<type name>) is a compile-time constant. It used to be
        ' left as a host call that canonical-MIR answered from its OWN table
        ' (I8/U16 -> 4, F80/TYPE -> unknown) and native x64 never bound at all
        ' ("MIR host call is not bound: SIZEOF"). The layout module the AST
        ' interpreter already uses is the single source: fold it to a constant.
        Dim sizeofTypeText As String = Trim(ps.ast.nodes(argNode).value)
        Dim foldedSize As Integer
        Dim foldedErr As String
        If sizeofTypeText <> "" Then
            If TypeLayoutSizeOf(ps, sizeofTypeText, foldedSize, foldedErr) <> 0 Then
                valueNameOut = MIRNextTemp(tempSeed)
                MIRSetCurrentSourceFromAstNode ps, nodeIdx
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, valueNameOut, 1, LTrim(Str(foldedSize))
                MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "I64"
                handledOut = 1
            End If
        End If
        Return 1
    End If
    handledOut = 1
    If info.dynamicBounds <> 0 Then
        errText = "mir: SIZEOF(array) requires compile-time array bounds: " & info.nameText
        Return 0
    End If

    valueNameOut = MIRNextTemp(tempSeed)
    MIRSetCurrentSourceFromAstNode ps, nodeIdx
    MIRAppendInstruction module, fnIdx, blkIdx, "MIR_ARRAY_SIZEOF", valueNameOut, 3, info.nameText, LTrim(Str(info.elementBytes)), LTrim(Str(info.elementCount))
    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "I64"
    Return 1
End Function

Private Function MIRMethodLeafName(ByRef callNameRaw As String) As String
    Dim s As String
    s = UCase(Trim(callNameRaw))
    If s = "" Then Return ""

    Dim i As Integer
    For i = Len(s) To 1 Step -1
        If Mid(s, i, 1) = "." Then
            If i >= Len(s) Then Return ""
            Return UCase(Trim(Mid(s, i + 1)))
        End If
    Next i

    Return s
End Function

Private Function MIRResolveNamespaceRoutineCall(ByRef ps As ParseState, ByRef callNameRaw As String, ByRef targetNameOut As String) As Integer
    targetNameOut = ""
    Dim callName As String
    callName = UCase(Trim(callNameRaw))
    Dim dotPos As Integer
    dotPos = InStr(callName, ".")
    If dotPos <= 1 Or dotPos >= Len(callName) Then Return 0

    Dim ownerName As String
    Dim routineName As String
    ownerName = Trim(Left(callName, dotPos - 1))
    routineName = Trim(Mid(callName, dotPos + 1))
    If ownerName = "" Or routineName = "" Or InStr(routineName, ".") > 0 Then Return 0

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim containerKind As String
        containerKind = UCase(Trim(ps.ast.nodes(i).kind))
        If containerKind <> "NAMESPACE_STMT" And containerKind <> "MODULE_STMT" Then Continue For
        If UCase(Trim(ps.ast.nodes(i).value)) <> ownerName Then Continue For

        Dim ch As Integer
        ch = ps.ast.nodes(i).firstChild
        Do While ch <> -1
            Dim routineKind As String
            routineKind = UCase(Trim(ps.ast.nodes(ch).kind))
            If routineKind = "SUB_STMT" Or routineKind = "FUNCTION_STMT" Or routineKind = "DECLARE_SUB_STMT" Or routineKind = "DECLARE_FUNCTION_STMT" Then
                If UCase(Trim(ps.ast.nodes(ch).value)) = routineName Then
                    targetNameOut = ownerName & "_" & routineName
                    Return 1
                End If
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
    Next i
    Return 0
End Function

' S-141: inside a NAMESPACE (or MODULE) an unqualified call to a routine of that same namespace
' resolves to it. Only `ns.Routine(...)` and USING imports were resolved, so `Both(v) = Twice(v) + 1`
' inside `NAMESPACE nsk` was a call to a routine named TWICE that does not exist: the AST engine
' happened to find it dynamically, canonical-MIR failed at run time ("no bound implementation:
' RT_LIBRARY_CALL"), native x64 refused to build ("neither a known runtime call nor a function in the
' MIR module") and legacy x64 failed to assemble. The namespace of the routine being lowered is kept
' in gMirCurrentNamespace (set by MIRLowerRoutineNode; expression nodes reached through left/right
' carry no parent link, so the AST cannot be walked upwards from a call node).

Private Function MIRResolveEnclosingNamespaceRoutineCall(ByRef ps As ParseState, ByRef callNameRaw As String, ByRef targetNameOut As String) As Integer
    targetNameOut = ""
    If gMirCurrentNamespace = "" Then Return 0
    Dim callName As String
    callName = UCase(Trim(callNameRaw))
    If callName = "" Or InStr(callName, ".") > 0 Then Return 0
    Return MIRResolveNamespaceRoutineCall(ps, gMirCurrentNamespace & "." & callName, targetNameOut)
End Function
Private Function MIRResolveUsingRoutineCall(ByRef ps As ParseState, ByRef callNameRaw As String, ByRef targetNameOut As String) As Integer
    targetNameOut = ""
    Dim callName As String
    callName = UCase(Trim(callNameRaw))
    If callName = "" Or InStr(callName, ".") > 0 Then Return 0

    ' A real top-level routine wins over names imported through USING.
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim directKind As String
        directKind = UCase(Trim(ps.ast.nodes(i).kind))
        If directKind = "FUNCTION_STMT" Or directKind = "SUB_STMT" Then
            If UCase(Trim(ps.ast.nodes(i).value)) = callName Then
                Dim directParent As Integer
                directParent = ps.ast.nodes(i).parent
                If directParent >= 0 Then
                    Dim directParentKind As String
                    directParentKind = UCase(Trim(ps.ast.nodes(directParent).kind))
                    If directParentKind <> "NAMESPACE_STMT" And directParentKind <> "MODULE_STMT" Then Return 0
                End If
            End If
        End If
    Next i

    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "USING_ITEM" Then Continue For
        Dim ownerName As String
        ownerName = UCase(Trim(ps.ast.nodes(i).value))
        If ownerName = "" Then Continue For

        Dim j As Integer
        For j = 0 To ps.ast.count - 1
            Dim routineKind As String
            routineKind = UCase(Trim(ps.ast.nodes(j).kind))
            If routineKind <> "FUNCTION_STMT" And routineKind <> "SUB_STMT" Then Continue For
            If UCase(Trim(ps.ast.nodes(j).value)) <> callName Then Continue For
            Dim parentIdx As Integer
            parentIdx = ps.ast.nodes(j).parent
            If parentIdx < 0 Or parentIdx >= ps.ast.count Then Continue For
            Dim parentKind As String
            parentKind = UCase(Trim(ps.ast.nodes(parentIdx).kind))
            If parentKind <> "NAMESPACE_STMT" And parentKind <> "MODULE_STMT" Then Continue For
            If UCase(Trim(ps.ast.nodes(parentIdx).value)) <> ownerName Then Continue For
            targetNameOut = ownerName & "_" & callName
            Return 1
        Next j
    Next i
    Return 0
End Function



' FIX14_CANONICAL_MAGIC_DISPATCH_20260611: MIR direct method target helper.
Private Function MIRResolveMethodRoutineNameFromType(ByRef ps As ParseState, ByRef receiverTypeRaw As String, ByRef methodNameRaw As String, ByRef routineNameOut As String) As Integer
    routineNameOut = ""
    Dim curClass As String
    curClass = UCase(Trim(receiverTypeRaw))
    Dim methodName As String
    methodName = UCase(Trim(methodNameRaw))
    If curClass = "" Or methodName = "" Then Return 0

    Dim fallbackName As String
    fallbackName = MIRMagicFallbackMethodName(methodName)

    Dim hop As Integer
    Do While curClass <> ""
        hop += 1
        If hop > 64 Then Exit Do

        Dim classNode As Integer
        classNode = -1
        Dim i As Integer
        For i = 0 To ps.ast.count - 1
            If UCase(Trim(ps.ast.nodes(i).kind)) = "CLASS_STMT" Then
                If UCase(Trim(ps.ast.nodes(i).value)) = curClass Then
                    classNode = i
                    Exit For
                End If
            End If
        Next i
        If classNode = -1 Then Exit Do

        Dim pass As Integer
        For pass = 0 To 1
            Dim wanted As String
            wanted = IIf(pass = 0, methodName, fallbackName)
            If wanted = "" Then Continue For

            Dim ch As Integer
            ch = ps.ast.nodes(classNode).firstChild
            Do While ch <> -1
                If UCase(Trim(ps.ast.nodes(ch).kind)) = "CLASS_METHOD_DECL" Then
                    If UCase(Trim(ps.ast.nodes(ch).value)) = wanted Then
                        routineNameOut = curClass & "_" & wanted
                        Return 1
                    End If
                End If
                ch = ps.ast.nodes(ch).nextSibling
            Loop
        Next pass

        Dim baseNode As Integer
        baseNode = MIRFindChildByKind(ps, classNode, "CLASS_BASE_REF")
        If baseNode = -1 Then Exit Do
        curClass = UCase(Trim(ps.ast.nodes(baseNode).value))
    Loop
    Return 0
End Function

Private Function MIRFieldPathFirstIdent(ByRef pathText As String) As String
    Dim i As Integer
    Dim outText As String
    For i = 1 To Len(pathText)
        Dim ch As String
        ch = Mid(pathText, i, 1)
        If ch = "." Or ch = "(" Or ch = " " Or ch = Chr(9) Then Exit For
        outText &= ch
    Next i
    Return UCase(Trim(outText))
End Function

Private Function MIRFindPropertyInHierarchy(ByRef ps As ParseState, ByRef classNameRaw As String, ByRef propertyNameRaw As String, ByRef ownerOut As String, ByRef propertyNodeOut As Integer) As Integer
    ownerOut = ""
    propertyNodeOut = -1
    Dim memberName As String
    memberName = MIRFieldPathFirstIdent(propertyNameRaw)
    If memberName = "" Then Return 0
    Return MIRFindClassMemberInHierarchy(ps, classNameRaw, memberName, ownerOut, propertyNodeOut)
End Function

Private Function MIRFindStaticMethodInHierarchy(ByRef ps As ParseState, ByRef classNameRaw As String, ByRef methodNameRaw As String, ByRef ownerOut As String, ByRef methodNodeOut As Integer) As Integer
    ownerOut = ""
    methodNodeOut = -1
    Dim curClass As String
    curClass = UCase(Trim(classNameRaw))
    Dim methodName As String
    methodName = UCase(Trim(methodNameRaw))
    Dim hop As Integer
    Do While curClass <> ""
        hop += 1
        If hop > 64 Then Exit Do
        Dim classNode As Integer
        classNode = MIRFindClassDeclNode(ps, curClass)
        If classNode = -1 Then Exit Do
        Dim ch As Integer
        ch = ps.ast.nodes(classNode).firstChild
        Do While ch <> -1
            If UCase(Trim(ps.ast.nodes(ch).kind)) = "CLASS_METHOD_DECL" Then
                If UCase(Trim(ps.ast.nodes(ch).value)) = methodName Then
                    ownerOut = curClass
                    methodNodeOut = ch
                    Return IIf(MIRClassMethodHasFlag(ps, ch, "STATIC") <> 0, 1, -1)
                End If
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
        Dim baseNode As Integer
        baseNode = MIRFindChildByKind(ps, classNode, "CLASS_BASE_REF")
        If baseNode = -1 Then Exit Do
        curClass = UCase(Trim(ps.ast.nodes(baseNode).value))
    Loop
    Return 0
End Function

' Declared return type (canonical, "" when the method is a SUB / has no declared type / is not found)
' of `methodName` on `receiverTypeRaw`: the class hierarchy is walked up through CLASS_BASE_REF, and an
' interface receiver is looked up among its INTERFACE_METHOD_DECL members.
Private Function MIRMethodDeclaredReturnType(ByRef ps As ParseState, ByRef receiverTypeRaw As String, ByRef methodNameRaw As String) As String
    Dim receiverType As String = UCase(Trim(receiverTypeRaw))
    Dim methodName As String = UCase(Trim(methodNameRaw))
    If receiverType = "" Or methodName = "" Then Return ""

    Dim methodNode As Integer = -1
    Dim ownerType As String
    MIRFindStaticMethodInHierarchy ps, receiverType, methodName, ownerType, methodNode

    If methodNode = -1 Then
        Dim ii As Integer
        For ii = 0 To ps.ast.count - 1
            If UCase(Trim(ps.ast.nodes(ii).kind)) <> "INTERFACE_STMT" Then Continue For
            If UCase(Trim(ps.ast.nodes(ii).value)) <> receiverType Then Continue For
            Dim im As Integer = ps.ast.nodes(ii).firstChild
            Do While im <> -1
                If UCase(Trim(ps.ast.nodes(im).kind)) = "INTERFACE_METHOD_DECL" Then
                    If UCase(Trim(ps.ast.nodes(im).value)) = methodName Then methodNode = im: Exit Do
                End If
                im = ps.ast.nodes(im).nextSibling
            Loop
            Exit For
        Next ii
    End If
    If methodNode = -1 Then Return ""

    ' the parser stores a method's / interface method's declared return type as a RETURN_TYPE child
    Dim retTypeNode As Integer = MIRFindChildByKind(ps, methodNode, "RETURN_TYPE")
    If retTypeNode = -1 Then Return ""
    Return MIRCanonicalTypeName(ps.ast.nodes(retTypeNode).value)
End Function

' S-484: does the function being lowered receive a hidden THIS parameter (a method, operator, constructor, destructor or property accessor)?
Private Function MIRFunctionHasThisParam(ByRef module As MIRModule, ByVal fnIdx As Integer) As Integer
    If fnIdx < 0 Or fnIdx >= module.functionCount Then Return 0
    Dim pi As Integer
    For pi = 0 To module.functions(fnIdx).paramVarCount - 1
        If UCase(Trim(module.functions(fnIdx).paramVars(pi))) = "THIS" Then Return 1
    Next pi
    Return 0
End Function

' S-270: an unqualified name inside a routine of a NAMESPACE/MODULE may be a CONST of that container (CONST SINIR = 5 ... RETURN SINIR).
' Qualified uses (geo.SINIR) were already resolved by lowering the initializer at the use site; the bare name fell through to a plain
' variable read (MIR 0, native garbage, JS undefined, WASM unbound local). Returns the CONST initializer node, -1 when the name is not one:
' a parameter or local of the running routine shadows the CONST, and the search climbs through enclosing containers.
Private Function MIRFindContainerConstInit(ByRef ps As ParseState, ByRef module As MIRModule, ByVal fnIdx As Integer, ByVal identNode As Integer, ByRef nameRaw As String) As Integer
    Dim wanted As String = UCase(Trim(nameRaw))
    If wanted = "" Or identNode < 0 Or identNode >= ps.ast.count Then Return -1
    If fnIdx >= 0 And fnIdx < module.functionCount Then
        Dim bi As Integer
        For bi = 0 To module.functions(fnIdx).paramVarCount - 1
            If UCase(Trim(module.functions(fnIdx).paramVars(bi))) = wanted Then Return -1
        Next bi
        For bi = 0 To module.functions(fnIdx).localVarCount - 1
            If UCase(Trim(module.functions(fnIdx).localVars(bi))) = wanted Then Return -1
        Next bi
    End If
    Dim anc As Integer = ps.ast.nodes(identNode).parent
    Do While anc >= 0 And anc < ps.ast.count
        Dim ancKind As String = UCase(Trim(ps.ast.nodes(anc).kind))
        If ancKind = "NAMESPACE_STMT" Or ancKind = "MODULE_STMT" Then
            Dim constDecl As Integer, constInit As Integer
            If UXBAstFindNamespaceConstDecl(ps.ast, ps.ast.nodes(anc).value, wanted, constDecl, constInit) <> 0 Then Return constInit
        End If
        anc = ps.ast.nodes(anc).parent
    Loop
    Return -1
End Function

Private Function MIRIsClassNameExpr(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef classNameOut As String) As Integer
    classNameOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0
    Dim k As String
    k = UCase(Trim(ps.ast.nodes(nodeIdx).kind))
    If k <> "IDENT" And k <> "KEYWORD_REF" Then Return 0
    Dim candidate As String
    candidate = UCase(Trim(ps.ast.nodes(nodeIdx).value))
    If candidate = "" Then Return 0
    If MIRFindClassDeclNode(ps, candidate) = -1 Then Return 0
    classNameOut = candidate
    Return 1
End Function

Private Function MIRNormalizeMethodTargetFromReceiver(ByRef ps As ParseState, ByVal receiverNodeIdx As Integer, ByRef methodNameRaw As String, ByRef targetNameOut As String, ByRef receiverTypeOut As String, ByRef errText As String) As Integer
    targetNameOut = ""
    receiverTypeOut = ""

    Dim methodName As String
    methodName = UCase(Trim(methodNameRaw))
    If methodName = "" Then Return 0

    If MIRTryInferExprTypeName(ps, receiverNodeIdx, receiverTypeOut) = 0 Then Return 0
    receiverTypeOut = UCase(Trim(receiverTypeOut))
    If receiverTypeOut = "" Then Return 0

    Dim interfaceNode As Integer
    interfaceNode = -1
    Dim ii As Integer
    For ii = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(ii).kind)) = "INTERFACE_STMT" And UCase(Trim(ps.ast.nodes(ii).value)) = receiverTypeOut Then
            interfaceNode = ii
            Exit For
        End If
    Next ii
    If interfaceNode <> -1 Then
        Dim interfaceSlot As Integer
        interfaceSlot = -1
        If MIRFindInterfaceMethodSlot(ps, receiverTypeOut, methodName, interfaceSlot) = 0 Then
            errText = "mir: interface method slot not found " & receiverTypeOut & "." & methodName
            Return 0
        End If
        targetNameOut = "__VT_SLOT__:" & receiverTypeOut & ":" & LTrim(Str(interfaceSlot))
        Return 1
    End If

    ' S-484 (2026-10-17): THIS.m() is a DIRECT call of the implementation visible from the class that contains the call
    ' (the receiver's static type, walking up the bases); ME.m(), the bare m() the front end rewrites to ME.m(), and every
    ' other receiver dispatch through the vtable when the method owns a slot (design: THIS vs ME in UXB OPP SISTEMI TASARIM).
    Dim receiverIsThis As Integer
    receiverIsThis = 0
    If receiverNodeIdx >= 0 And receiverNodeIdx < ps.ast.count Then
        Dim receiverKindText As String
        receiverKindText = UCase(Trim(ps.ast.nodes(receiverNodeIdx).kind))
        If receiverKindText = "IDENT" Or receiverKindText = "KEYWORD_REF" Then
            If UCase(Trim(ps.ast.nodes(receiverNodeIdx).value)) = "THIS" Then receiverIsThis = 1
        End If
    End If

    Dim slotIdx As Integer
    slotIdx = -1
    If receiverIsThis = 0 Then
        If MIRFindMethodSlotInClass(ps, receiverTypeOut, methodName, slotIdx) <> 0 And slotIdx >= 0 Then
            targetNameOut = "__VT_SLOT__:" & receiverTypeOut & ":" & LTrim(Str(slotIdx))
            Return 1
        End If
    End If

    If MIRResolveMethodRoutineNameFromType(ps, receiverTypeOut, methodName, targetNameOut) <> 0 Then Return 1

    targetNameOut = receiverTypeOut & "_" & methodName
    Return 1
End Function

Private Function MIRAppendMethodCallInstruction(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef resultNameOut As String, ByRef errText As String) As Integer
    resultNameOut = ""
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)
    If UCase(Trim(n.kind)) <> "CALL_EXPR" Then Return 0
    If n.left = -1 Then Return 0

    Dim legacyCallName As String
    legacyCallName = UCase(Trim(n.value))
    If InStr(legacyCallName, ".") = 0 Then Return 0

    Dim methodName As String
    methodName = MIRMethodLeafName(legacyCallName)
    If methodName = "" Then
        errText = "mir: METHOD_CALL method name missing"
        Return 0
    End If

    Dim receiverName As String
    Dim methodTarget As String
    Dim receiverType As String
    Dim classReceiverName As String
    Dim staticMethodState As Integer
    staticMethodState = 0

    If MIRIsClassNameExpr(ps, n.left, classReceiverName) <> 0 Then
        Dim staticOwner As String
        Dim staticMethodNode As Integer
        staticMethodState = MIRFindStaticMethodInHierarchy(ps, classReceiverName, methodName, staticOwner, staticMethodNode)
        If staticMethodState = 1 Then
            receiverName = ""
            receiverType = classReceiverName
            methodTarget = staticOwner & "_" & methodName
        ElseIf staticMethodState = -1 Then
            errText = "mir: instance method cannot be called through class name " & classReceiverName & "." & methodName
            Return 0
        Else
            errText = "mir: static method not found " & classReceiverName & "." & methodName
            Return 0
        End If
    Else
        If MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, receiverName, errText) = 0 Then Return 0
        Dim receiverIsSuper As Integer
        receiverIsSuper = 0
        Dim receiverKindText As String
        receiverKindText = UCase(Trim(ps.ast.nodes(n.left).kind))
        If receiverKindText = "IDENT" Or receiverKindText = "KEYWORD_REF" Then
            If UCase(Trim(ps.ast.nodes(n.left).value)) = "SUPER" Then receiverIsSuper = 1
        End If
        If receiverIsSuper <> 0 Then
            ' S-037: SUPER.m() is a NON-virtual call to the BASE class's implementation.
            ' The receiver's type was never resolved (it fell back to OBJECT, target
            ' `OBJECT_SPEAK`, which exists nowhere: interpreter "method target not found",
            ' native "neither a known runtime call nor a function"), and resolving it as
            ' an ordinary base-typed receiver would be wrong too: that is a VIRTUAL call, which
            ' would dispatch to the override that is calling SUPER (endless recursion).
            If MIRResolveFieldRootType(ps, n.left, "SUPER", receiverType) = 0 Then
                errText = "mir: SUPER used outside a derived class method: " & methodName
                Return 0
            End If
            receiverType = UCase(Trim(receiverType))
            If UCase(Trim(methodName)) = "CONSTRUCTOR" Then
                ' S-485 / S-487 (P0.2): SUPER.CONSTRUCTOR(args) is the base-class constructor call the front end wrote (semantic_base_ctor.fbs):
                ' a direct call of the base class's constructor routine, which has the same ABI as a method (THIS first).
                methodTarget = receiverType & "_CTOR"
            ElseIf MIRResolveMethodRoutineNameFromType(ps, receiverType, methodName, methodTarget) = 0 Then
                errText = "mir: SUPER method not found in base class " & receiverType & ": " & methodName
                Return 0
            End If
        ElseIf MIRNormalizeMethodTargetFromReceiver(ps, n.left, methodName, methodTarget, receiverType, errText) = 0 Then
            If errText = "" Then errText = "mir: unresolved METHOD_CALL target " & methodName
            Return 0
        End If
        If receiverIsSuper = 0 Then
            ' S-608 (2026-10-17): `x.Iki()` where Iki is a STATIC method of x's class: the call needs no object. The receiver expression was
            ' lowered above (its side effects stay), but it is not passed: the static routine has no hidden THIS parameter, so a passed
            ' receiver shifted the arguments (native x64: "user function arg count mismatch").
            Dim instStaticOwner As String
            Dim instStaticNode As Integer
            If MIRFindStaticMethodInHierarchy(ps, receiverType, methodName, instStaticOwner, instStaticNode) = 1 Then
                methodTarget = instStaticOwner & "_" & methodName
                receiverName = ""
            End If
        End If
    End If

    Dim childCount As Integer
    childCount = MIRChildCount(ps, nodeIdx)

    Dim t As String
    t = MIRNextTemp(tempSeed)

    Dim a1 As String, a2 As String, a3 As String, a4 As String, a5 As String, a6 As String, a7 As String, a8 As String
    Dim a9 As String, a10 As String, a11 As String, a12 As String, a13 As String, a14 As String, a15 As String, a16 As String

    ' Operand sozlesmesi:
    '   METHOD_CALL result, target, receiver, method_leaf, receiver_type, arg1, arg2, ...
    a1 = methodTarget
    a2 = receiverName
    a3 = methodName
    a4 = receiverType

    Dim idx As Integer
    idx = 5

    Dim ch As Integer
    ch = n.firstChild
    Do While ch <> -1
        Dim argName As String
        If MIRLowerExprNode(ps, ch, module, fnIdx, blkIdx, tempSeed, argName, errText) = 0 Then Return 0

        Select Case idx
        Case 5: a5 = argName
        Case 6: a6 = argName
        Case 7: a7 = argName
        Case 8: a8 = argName
        Case 9: a9 = argName
        Case 10: a10 = argName
        Case 11: a11 = argName
        Case 12: a12 = argName
        Case 13: a13 = argName
        Case 14: a14 = argName
        Case 15: a15 = argName
        Case 16: a16 = argName
        Case Else
            errText = "mir: METHOD_CALL arguman sayisi limiti asildi"
            Return 0
        End Select

        idx += 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Dim methodOpcode As String
    If Left(UCase(Trim(methodTarget)), 12) = "__VT_SLOT__:" Then
        methodOpcode = MIR_OP_VIRTUAL_CALL
    Else
        methodOpcode = "MIR_METHOD_CALL"
    End If
    MIRAppendInstruction module, fnIdx, blkIdx, methodOpcode, t, childCount + 4, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16
    ' The call's result carries the method's DECLARED return type. Without it the value is untyped
    ' (registry default TYPE_RUNTIME) and a consumer that picks its behaviour from the static type -
    ' PRINT on native x64 - printed a STRING result as an integer (the pointer).
    Dim methodReturnType As String = MIRMethodDeclaredReturnType(ps, receiverType, methodName)
    If methodReturnType <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, methodReturnType
    resultNameOut = t
    Return 1
End Function

' ---------------------------------------------------------------------------
' S-030 Faz 1B (Mete K7, 2026-09-24): canonical MIR gorev sozlesmesi.
' Tutamac tabanli tiplerin (LIST_NEW/LISTADD) yerlesik kalibiyla, Mete'nin
' verdigi adlarla adlandirilmis kanonik MIR_CALL'lar:
'   TASK_SPAWN(laneRutin, tur, gorevAdi, sonucTipi, arg1..)   -> TASK tutamaci
'   TASK_WAIT(t) TASK_CANCEL(t)                              -> deger yok
'   TASK_JOIN(t) TASK_RESULT(t)                              -> sonuc (hata/iptal cagirana)
'   TASK_STATUS(t) TASK_ERROR(t)                             -> STRING
'   TASK_GROUP_CREATE()                                      -> TASKGROUP tutamaci
'   TASK_GROUP_ADD(g, t) TASK_GROUP_JOIN(g)                   -> deger yok
' Anlam AST referans uygulamasiyla (exec_task_handle.fbs) birebir; motor bu
' adlari kendi saglayicisina baglar (MIR yorumlayicisi: mir_interp_task.fbs;
' native x64 Faz 2'ye kadar ACIK red). Alici tipi, AST yorumlayicisinin da
' kullandigi UXBStep3InferExprType ile belirlenir -- kural tek.
' ---------------------------------------------------------------------------
Private Function MIRTaskReceiverKind(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return ""
    Dim inferred As String
    Dim inferErr As String
    If UXBStep3InferExprType(ps, nodeIdx, inferred, inferErr) <> 0 Then
        inferred = UCase(Trim(UXBStep3TypeCanonical(inferred)))
        If inferred = TYPE_TASK Then Return "TASK"
        If inferred = TYPE_TASKGROUP Then Return "TASKGROUP"
    End If
    ' Tip kapisi calismamis yollarda (ornek `uxb mir`) step3 tablolari bos olabilir; o zaman
    ' bildirime dayali MIR cozumlemesi kullanilir -- ayni kaynak (DIM/PARAM TYPE_REF).
    Dim declared As String
    If MIRTryInferExprTypeName(ps, nodeIdx, declared) <> 0 Then
        declared = UCase(Trim(declared))
        If declared = "TASK" Then Return "TASK"
        If declared = "TASKGROUP" Then Return "TASKGROUP"
    End If
    Return ""
End Function

Private Function MIRLowerSpawnExpr(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueNameOut As String, ByRef errText As String) As Integer
    Dim callIdx As Integer
    callIdx = ps.ast.nodes(nodeIdx).left
    If callIdx = -1 Then
        errText = "mir: SPAWN gorev cagrisi eksik"
        Return 0
    End If
    Dim taskName As String
    taskName = UCase(Trim(ps.ast.nodes(callIdx).value))

    ' Hedef bildirimi: tur (THREAD/PARALEL) ve istege bagli sonuc tipi (S-149).
    Dim laneKind As String
    Dim resultType As String
    Dim declIdx As Integer = -1
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim dk As String
        dk = UCase(Trim(ps.ast.nodes(i).kind))
        If dk <> "THREAD_STMT" And dk <> "PARALEL_STMT" Then Continue For
        If UCase(Trim(ps.ast.nodes(i).value)) <> taskName And UCase(Trim(ps.ast.nodes(i).symbolName)) <> taskName Then Continue For
        declIdx = i
        laneKind = IIf(dk = "THREAD_STMT", "THREAD", "PARALEL")
        Exit For
    Next i
    If declIdx = -1 Then
        errText = "mir: SPAWN hedefi THREAD/PARALEL olarak bulunamadi: " & taskName
        Return 0
    End If
    Dim retNode As Integer
    retNode = MIRFindChildByKind(ps, declIdx, "RETURN_TYPE")
    If retNode <> -1 Then resultType = MIRCanonicalTypeName(ps.ast.nodes(retNode).value)

    Dim a(1 To 16) As String
    a(1) = "TASK_SPAWN"
    a(2) = Chr(34) & "__SLOTLANE_" & laneKind & "_" & MIRSlotSafeName(ps.ast.nodes(declIdx).value) & Chr(34)
    a(3) = Chr(34) & laneKind & Chr(34)
    a(4) = Chr(34) & taskName & Chr(34)
    a(5) = Chr(34) & resultType & Chr(34)
    Dim argPos As Integer = 5
    Dim ch As Integer
    ch = ps.ast.nodes(callIdx).firstChild
    Do While ch <> -1
        argPos += 1
        If argPos > 16 Then
            errText = "mir: SPAWN arguman sayisi limiti asildi (en fazla 11)"
            Return 0
        End If
        If MIRLowerExprNode(ps, ch, module, fnIdx, blkIdx, tempSeed, a(argPos), errText) = 0 Then Return 0
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Dim t As String
    t = MIRNextTemp(tempSeed)
    MIRSetCurrentSourceFromAstNode ps, nodeIdx
    MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, t, argPos, a(1), a(2), a(3), a(4), a(5), a(6), a(7), a(8), a(9), a(10), a(11), a(12), a(13), a(14), a(15), a(16)
    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "TASK"
    valueNameOut = t
    Return 1
End Function

' TASK/TASKGROUP alicili uye: metot (CALL_EXPR `t.JOIN()`) ya da alan (FIELD_EXPR `t.STATUS`).
' argsParentIdx: metot argumanlarini tasiyan CALL_EXPR (alan icin -1).
Private Function MIRLowerTaskMember(ByRef ps As ParseState, ByVal receiverIdx As Integer, ByRef receiverKind As String, ByRef memberRaw As String, ByVal argsParentIdx As Integer, ByVal isMethod As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueNameOut As String, ByRef errText As String) As Integer
    Dim member As String
    member = UCase(Trim(memberRaw))
    Dim callName As String
    Dim wantArgs As Integer = 0
    Dim resultMeta As String

    If receiverKind = "TASK" Then
        If isMethod <> 0 Then
            Select Case member
            Case "WAIT": callName = "TASK_WAIT"
            Case "JOIN": callName = "TASK_JOIN"
            Case "CANCEL": callName = "TASK_CANCEL"
            End Select
        Else
            Select Case member
            Case "STATUS": callName = "TASK_STATUS": resultMeta = "STRING"
            Case "RESULT": callName = "TASK_RESULT"
            Case "ERRORTEXT": callName = "TASK_ERROR": resultMeta = "STRING"
            End Select
        End If
    Else
        If isMethod <> 0 Then
            Select Case member
            Case "ADD": callName = "TASK_GROUP_ADD": wantArgs = 1
            Case "JOIN": callName = "TASK_GROUP_JOIN"
            Case "JOINALL"
                errText = "mir: TASKGROUP.JOINALL() henuz desteklenmiyor (S-147: LIST sonuc sozlesmesi) -- TASKGROUP.JOIN() ile bekleyip her uyenin .RESULT alanini okuyun"
                Return 0
            End Select
        End If
    End If
    If callName = "" Then
        errText = "mir: " & receiverKind & " uzerinde bilinmeyen " & IIf(isMethod <> 0, "metot", "alan") & ": " & member
        Return 0
    End If

    Dim argCount As Integer = 0
    If argsParentIdx <> -1 Then argCount = MIRChildCount(ps, argsParentIdx)
    If argCount <> wantArgs Then
        errText = "mir: " & receiverKind & "." & member & "() " & LTrim(Str(wantArgs)) & " arguman ister, gelen " & LTrim(Str(argCount))
        Return 0
    End If

    Dim receiverName As String
    If MIRLowerExprNode(ps, receiverIdx, module, fnIdx, blkIdx, tempSeed, receiverName, errText) = 0 Then Return 0
    Dim argName As String
    If wantArgs = 1 Then
        If MIRLowerExprNode(ps, MIRChildAt(ps, argsParentIdx, 0), module, fnIdx, blkIdx, tempSeed, argName, errText) = 0 Then Return 0
    End If

    ' JOIN/RESULT: TASK OF <tip> ise sonuc o tipte (S-149); tipsiz TASK'ta metadata yok.
    If callName = "TASK_JOIN" Or callName = "TASK_RESULT" Then
        Dim isTask As Integer
        Dim declared As String
        declared = UXBTaskExprResultType(ps, receiverIdx, isTask)
        If isTask <> 0 And declared <> "" Then resultMeta = MIRCanonicalTypeName(declared)
    End If

    Dim t As String
    t = MIRNextTemp(tempSeed)
    If wantArgs = 1 Then
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, t, 3, callName, receiverName, argName
    Else
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, t, 2, callName, receiverName
    End If
    If resultMeta <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, resultMeta
    valueNameOut = t
    Return 1
End Function

Declare Function UXBAtomicDeclFor(ByRef ps As ParseState, ByVal nameRaw As String, ByVal useNodeIdx As Integer) As Integer
Declare Function UXBAtomicDeclType(ByRef ps As ParseState, ByVal declNode As Integer) As String

' S-146 Model D: ATOMIC alicili metot -> kanonik `CALL ATOMIC_<M> <degisken> [arg...]`.
' Islenen 0 DEGISKENIN ADIDIR (deger degil): motor dogrudan depo uzerinde atomik islem yapar
' (native: lock xadd / xchg / lock cmpxchg). Senkron gecisi bu buyrugu ortak depo erisimi sayar.
' handledOut = 0: alici ATOMIC degil (baska yol denesin).
Private Function MIRLowerAtomicMember(ByRef ps As ParseState, ByVal callIdx As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueNameOut As String, ByRef handledOut As Integer, ByRef errText As String) As Integer
    handledOut = 0
    Dim recv As Integer = ps.ast.nodes(callIdx).left
    If recv < 0 Then Return 1
    Dim rk As String = UCase(Trim(ps.ast.nodes(recv).kind))
    If rk <> "IDENT" And rk <> "IDENTIFIER" Then Return 1
    Dim decl As Integer = UXBAtomicDeclFor(ps, ps.ast.nodes(recv).value, recv)
    If decl = -1 Then Return 1
    handledOut = 1
    Dim member As String = UCase(MIRMethodLeafName(Trim(ps.ast.nodes(callIdx).value)))
    Dim resultMeta As String = MIRCanonicalTypeName(UXBAtomicDeclType(ps, decl))
    If member = "CAS" Then resultMeta = "I32"
    Dim ops(0 To 3) As String
    ops(0) = "ATOMIC_" & member
    ops(1) = Trim(ps.ast.nodes(recv).value)
    Dim argc As Integer = MIRChildCount(ps, callIdx)
    If argc > 2 Then
        errText = "mir: ATOMIC ." & member & " en fazla 2 arguman alir"
        Return 0
    End If
    Dim i As Integer
    For i = 0 To argc - 1
        If MIRLowerExprNode(ps, MIRChildAt(ps, callIdx, i), module, fnIdx, blkIdx, tempSeed, ops(2 + i), errText) = 0 Then Return 0
    Next i
    Dim t As String = MIRNextTemp(tempSeed)
    MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, t, 2 + argc, ops(0), ops(1), ops(2), ops(3)
    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, resultMeta
    valueNameOut = t
    Return 1
End Function

Private Function MIRLowerExprNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef module As MIRModule, ByVal fnIdx As Integer, ByRef blkIdx As Integer, ByRef tempSeed As Integer, ByRef valueNameOut As String, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then
        errText = "mir: invalid expr node"
        Return 0
    End If
    MIRSetCurrentSourceFromAstNode ps, nodeIdx

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)
    Dim k As String
    k = UCase(n.kind)

    If k = "NUMBER" Or k = "STRING" Then
        Dim t As String
        t = MIRNextTemp(tempSeed)
        Dim cText As String
        If k = "STRING" Then
            cText = Chr(34) & n.value & Chr(34)
        Else
            cText = Trim(n.value)
        End If
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, t, 1, cText
        Dim literalType As String
        If k = "STRING" Then
            literalType = "STRING"
        ElseIf UCase(Trim(n.typeName)) = "TYPE_NULL" Then
            ' S-564: the NULL / NOTHING literal (the front end rewrote the identifier to the NUMBER 0): a null pointer / object reference
            literalType = "PTR"
        ElseIf UXBNumberLiteralIsFloat(cText) <> 0 Then
            literalType = "F64"
        Else
            literalType = "I64"
        End If
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, literalType
        valueNameOut = t
        Return 1
    End If

    If k = "BOOLEAN" Then
        Dim boolTemp As String
        boolTemp = MIRNextTemp(tempSeed)
        Dim boolText As String
        boolText = UCase(Trim(n.value))
        If boolText = "TRUE" Or boolText = "1" Or boolText = "-1" Then
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, boolTemp, 1, "-1"
        Else
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, boolTemp, 1, "0"
        End If
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "BOOLEAN"
        valueNameOut = boolTemp
        Return 1
    End If

    If k = "KEYWORD_REF" Then
        Dim kwName As String
        kwName = UCase(Trim(n.value))
        ' TASKIN/TASKOUT are ordinary identifiers, not keywords, so they never
        ' arrive here -- only THIS/ME do.  INPUT stays a keyword because it is
        ' the console statement; it is deliberately NOT accepted as a task
        ' context name any more, so an old "PRINT INPUT" fails loudly instead
        ' of silently reading a value that no longer lands there.
        If kwName = "THIS" Or kwName = "ME" Then
            If kwName = "ME" And MIRFunctionHasThisParam(module, fnIdx) <> 0 Then
                valueNameOut = "THIS"
                Return 1
            End If
            valueNameOut = MIRNormalizeTaskResultAlias(module, fnIdx, kwName)
            Return 1
        End If

        If kwName = "TRUE" Then
            Dim trueTemp As String
            trueTemp = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, trueTemp, 1, "-1"
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "BOOLEAN"
            valueNameOut = trueTemp
            Return 1
        End If

        If kwName = "FALSE" Then
            Dim falseTemp As String
            falseTemp = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, falseTemp, 1, "0"
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "BOOLEAN"
            valueNameOut = falseTemp
            Return 1
        End If

        If kwName = "NULL" Or kwName = "NOTHING" Then
            Dim nullTemp As String
            nullTemp = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, nullTemp, 1, "0"
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "PTR"
            valueNameOut = nullTemp
            Return 1
        End If

        Dim kwTemp As String
        kwTemp = MIRNextTemp(tempSeed)
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, kwTemp, 1, Chr(34) & n.value & Chr(34)
        valueNameOut = kwTemp
        Return 1
    End If

    If k = "IDENT" Then
        ' S-484 (2026-10-17): `ME` is the receiver of the running member = its THIS parameter. The MIR interpreter only aliased ME for
        ' method and constructor calls, so a bare call rewritten to ME.m() inside a destructor or a MAGIC operator body read a null
        ' receiver ("method call on a null object reference"). Mapping it here makes every call path (and every backend) see THIS.
        If UCase(Trim(n.value)) = "ME" And MIRFunctionHasThisParam(module, fnIdx) <> 0 Then
            valueNameOut = "THIS"
            Return 1
        End If
        Dim containerConstInit As Integer = MIRFindContainerConstInit(ps, module, fnIdx, nodeIdx, n.value)
        If containerConstInit <> -1 Then Return MIRLowerExprNode(ps, containerConstInit, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
        valueNameOut = MIRNormalizeTaskResultAlias(module, fnIdx, n.value)
        Return 1
    End If

    If k = "UNARY" Then
        Dim unaryNode As Integer
        unaryNode = n.left
        If unaryNode = -1 Then unaryNode = n.right
        If unaryNode = -1 Then
            errText = "mir: unary operand missing"
            Return 0
        End If

        Dim rhsName As String
        If MIRLowerExprNode(ps, unaryNode, module, fnIdx, blkIdx, tempSeed, rhsName, errText) = 0 Then Return 0

        Dim opu As String
        opu = UCase(Trim(n.op))
        Dim t As String
        t = MIRNextTemp(tempSeed)

        If opu = "NOT" Or opu = "BNOT" Or opu = "~" Then
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_NOT, t, 1, rhsName
            Dim unaryResultType As String
            unaryResultType = UCase(Trim(n.typeName))
            If unaryResultType = "" Then unaryResultType = "I64"
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, unaryResultType
            valueNameOut = t
            Return 1
        End If

        If opu = "LNOT" Or opu = "!" Then
            Dim zeroTemp As String
            zeroTemp = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, zeroTemp, 1, "0"
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_EQ, t, 2, rhsName, zeroTemp
            valueNameOut = t
            Return 1
        End If

        If opu = "-" Then
            Dim negOp As String
            negOp = MIR_OP_NEG
            Dim rkind As Integer
            rkind = MIRInferExprFloatKind(ps, unaryNode)
            If rkind = MIR_UXF_F80 Then
                errText = "mir: F80 arithmetic not supported"
                Return 0
            End If
            If rkind <> MIR_UXF_UNKNOWN Then negOp = MIR_OP_FNEG
            MIRAppendInstruction module, fnIdx, blkIdx, negOp, t, 1, rhsName
            ' S-088: the negation carries its static type (a U32 result wraps modulo 2^32).
            ' A comparison is BOOLEAN, but arithmetic negation of its -1/0 value
            ' is an integer expression.  Keeping BOOL here makes native MIR-x64
            ' canonicalize the resulting 1 back to Boolean -1 (S-505).
            Dim negResultType As String
            negResultType = UCase(Trim(n.typeName))
            If negResultType = "BOOL" Or negResultType = "BOOLEAN" Then negResultType = "I64"
            If negResultType <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, negResultType
            valueNameOut = t
            Return 1
        End If

        valueNameOut = rhsName
        Return 1
    End If

    If k = "INCDEC_EXPR" Or k = "INCDEC_STMT" Then
        If n.left = -1 Then
            errText = "mir: INCDEC expression target missing"
            Return 0
        End If

        Dim incTarget As String
        Dim incSource As String
        Dim incOldName As String
        Dim incNewName As String
        Dim incOne As String
        Dim incIndexName As String
        Dim incIndexed As Integer
        Dim incArrayElemType As String
        Dim incStoredType As String
        If UXBStep3InferExprType(ps, n.left, incStoredType, errText) = 0 Then Return 0
        Dim incArrayField As Integer, incArrayName As String, incMember As String
        Dim incReceiver As String, incFieldOffset As Integer, incFieldSize As Integer
        incIndexed = 0

        If UCase(ps.ast.nodes(n.left).kind) = "IDENT" Then
            incTarget = MIRNormalizeTaskResultAlias(module, fnIdx, ps.ast.nodes(n.left).value)
            incSource = incTarget
        ElseIf UCase(ps.ast.nodes(n.left).kind) = "FIELD_EXPR" Then
            ' S-130: same target handling as the INCDEC statement form: read the field through the regular
            ' field-read lowering (MIR_FIELD_LOAD for a class field) and write it back below
            If MIRBuildFieldPath(ps, n.left, incTarget, errText) = 0 Then Return 0
            If MIRNormalizeFieldPathForAccess(ps, n.left, incTarget, 1, errText) = 0 Then Return 0
            Dim receiverNode As Integer = ps.ast.nodes(n.left).left
            If receiverNode >= 0 AndAlso UCase(ps.ast.nodes(receiverNode).kind) = "CALL_EXPR" Then
                incArrayName = ps.ast.nodes(receiverNode).value
                If MIRIsKnownArray(module, incArrayName) <> 0 Then
                    incArrayField = 1
                    If MIRLowerFlatArrayIndex(ps, receiverNode, incArrayName, module, fnIdx, blkIdx, tempSeed, incIndexName, errText) = 0 Then Return 0
                    incMember = ps.ast.nodes(n.left).value
                    incArrayElemType = MIRArrayElementTypeOf(module, incArrayName)
                    Dim fieldErr As String, fieldType As String
                    If TypeLayoutResolvePath(ps, incArrayElemType, incMember, incFieldOffset, fieldType, incFieldSize, fieldErr) = 0 Then errText = "mir: INCDEC field layout: " & fieldErr: Return 0
                    incSource = MIRNextTemp(tempSeed)
                    If MIRFindClassDeclNode(ps, incArrayElemType) <> -1 Then
                        incReceiver = MIRNextTemp(tempSeed)
                        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_INDEXED, incReceiver, 2, incArrayName, incIndexName
                        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incArrayElemType
                        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_FIELD_LOAD, incSource, 3, incReceiver, incMember, LTrim(Str(incFieldOffset))
                    Else
                        MIRAppendInstruction module, fnIdx, blkIdx, "MIR_ARRAY_FIELD_LOAD", incSource, 6, incArrayName, incIndexName, incMember, incArrayElemType, LTrim(Str(incFieldOffset)), LTrim(Str(incFieldSize))
                    End If
                End If
            End If
            If incArrayField = 0 Then
                If MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, incSource, errText) = 0 Then Return 0
            End If
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incStoredType
        ElseIf UCase(ps.ast.nodes(n.left).kind) = "CALL_EXPR" And InStr(ps.ast.nodes(n.left).value, ".") = 0 And MIRIsKnownArray(module, ps.ast.nodes(n.left).value) <> 0 And MIRChildCount(ps, n.left) >= 1 Then
            incTarget = ps.ast.nodes(n.left).value
            If MIRLowerFlatArrayIndex(ps, n.left, incTarget, module, fnIdx, blkIdx, tempSeed, incIndexName, errText) = 0 Then Return 0
            incSource = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_INDEXED, incSource, 2, incTarget, incIndexName
            incArrayElemType = MIRArrayElementTypeOf(module, incTarget)
            If UCase(Trim(incArrayElemType)) <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incArrayElemType
            incIndexed = 1
        Else
            errText = "mir: INCDEC expression target must be ident, field, or indexed array"
            Return 0
        End If

        incOldName = MIRNextTemp(tempSeed)
        If UCase(ps.ast.nodes(n.left).kind) = "FIELD_EXPR" Then
            ' MIRLowerExprNode already materialized FIELD_EXPR (including UNION overlay
            ' fields) into incSource. Loading that temporary as a variable would turn
            ' the value into a pseudo-name such as __T6 and lose the field semantics.
            incOldName = incSource
        Else
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_VAR, incOldName, 1, incSource
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incStoredType
        End If
        incOne = MIRNextTemp(tempSeed)
        Dim incKind As Integer
        ' The resolved lvalue type is authoritative, including TYPE and
        ' indexed CLASS fields whose textual root is not a scalar symbol.
        Select Case MIRCanonicalTypeName(incStoredType)
        Case "F32": incKind = MIR_UXF_F32
        Case "F64": incKind = MIR_UXF_F64
        Case "F80": incKind = MIR_UXF_F80
        Case Else: incKind = MIR_UXF_UNKNOWN
        End Select
        If incKind = MIR_UXF_F80 Then
            errText = "mir: F80 arithmetic not supported"
            Return 0
        End If
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, incOne, 1, IIf(incKind <> MIR_UXF_UNKNOWN, "1.0", "1")
        incNewName = MIRNextTemp(tempSeed)
        If Trim(n.op) = "--" Then
            MIRAppendInstruction module, fnIdx, blkIdx, IIf(incKind <> MIR_UXF_UNKNOWN, MIR_OP_FSUB, MIR_OP_SUB), incNewName, 2, incOldName, incOne
        Else
            MIRAppendInstruction module, fnIdx, blkIdx, IIf(incKind <> MIR_UXF_UNKNOWN, MIR_OP_FADD, MIR_OP_ADD), incNewName, 2, incOldName, incOne
        End If

        ' Both the write and prefix result have the target's storage type.
        ' Carry the conversion in shared MIR; no backend-specific narrow fix.
        Dim incStoredName As String = MIRNextTemp(tempSeed)
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CAST, incStoredName, 1, incNewName
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incStoredType
        incNewName = incStoredName

        If incArrayField <> 0 Then
            If incReceiver <> "" Then
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_FIELD_STORE, "", 4, incReceiver, incMember, incNewName, LTrim(Str(incFieldOffset))
            Else
                MIRAppendInstruction module, fnIdx, blkIdx, "MIR_ARRAY_FIELD_STORE", "", 7, incArrayName, incIndexName, incMember, incNewName, incArrayElemType, LTrim(Str(incFieldOffset)), LTrim(Str(incFieldSize))
            End If
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incStoredType
        ElseIf incIndexed <> 0 Then
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_INDEXED, "", 3, incTarget, incIndexName, incNewName
            If UCase(Trim(incArrayElemType)) <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, incArrayElemType
        ElseIf UCase(ps.ast.nodes(n.left).kind) = "FIELD_EXPR" Then
            Dim propertyStore As Integer = MIRTryEmitPropertySetterCall(ps, n.left, incNewName, module, fnIdx, blkIdx, tempSeed, errText)
            If propertyStore = 0 Then Return 0
            If propertyStore < 0 Then
            Dim unionStoreIncExpr As Integer
            unionStoreIncExpr = MIRTryEmitUnionFieldStore(ps, n.left, incTarget, incNewName, "=", module, fnIdx, blkIdx, tempSeed, errText)
            If unionStoreIncExpr = 0 Then Return 0
            If unionStoreIncExpr > 0 Then
                ' The canonical UNION store owns the write; do not fall through to
                ' the class/pseudo-variable fallback below.
            Else
            ' S-130: a per-object class field is written with MIR_FIELD_STORE
            Dim classStoreIncExpr As Integer
            classStoreIncExpr = MIRTryEmitClassFieldStore(ps, n.left, incTarget, incNewName, module, fnIdx, blkIdx, errText)
            If classStoreIncExpr = 0 Then Return 0
            If classStoreIncExpr < 0 Then MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, incTarget, 1, incNewName
            End If
            End If

        Else
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, incTarget, 1, incNewName
        End If

        If UCase(Trim(n.value)) = "POST" Then
            valueNameOut = incOldName
        Else
            valueNameOut = incNewName
        End If
        Return 1
    End If

    If k = "BINARY" Then
        If n.op = "|>" Then
            If n.right = -1 Then
                errText = "mir: pipe target missing"
                Return 0
            End If

            Dim pipeInputName As String
            If MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, pipeInputName, errText) = 0 Then Return 0

            Dim pipeTargetKind As String
            pipeTargetKind = UCase(ps.ast.nodes(n.right).kind)
            If pipeTargetKind <> "IDENT" And pipeTargetKind <> "KEYWORD_REF" Then
                errText = "mir: |> target must be identifier"
                Return 0
            End If

            Dim pipeResult As String
            pipeResult = MIRNextTemp(tempSeed)
            Dim pipeTargetName As String
            pipeTargetName = UCase(Trim(ps.ast.nodes(n.right).value))
            Dim pipeDeclFound As Integer
            Dim pipeDeclIdx As Integer
            For pipeDeclIdx = 0 To ps.ast.count - 1
                If UCase(Trim(ps.ast.nodes(pipeDeclIdx).kind)) = "PIPE_STMT" And _
                   UCase(Trim(ps.ast.nodes(pipeDeclIdx).value)) = pipeTargetName Then
                    pipeDeclFound = 1
                    Exit For
                End If
            Next pipeDeclIdx

            If pipeDeclFound <> 0 Then
                Dim pipeKindName As String
                pipeKindName = MIRNextTemp(tempSeed)
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, pipeKindName, 1, Chr(34) & "PIPE" & Chr(34)
                Dim pipeTargetLiteral As String
                pipeTargetLiteral = MIRNextTemp(tempSeed)
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, pipeTargetLiteral, 1, Chr(34) & pipeTargetName & Chr(34)
                Dim pipeRoutineName As String
                pipeRoutineName = "__SLOTLANE_PIPE_" & MIRSlotSafeName(pipeTargetName)
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, pipeResult, 2, pipeRoutineName, pipeInputName
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, UXB_TASK_RESULT_NAME, 1, pipeResult
            Else
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, pipeResult, 2, pipeTargetName, pipeInputName
            End If
            valueNameOut = pipeResult
            Return 1
        End If

        Dim logicOpText As String
        logicOpText = UCase(Trim(n.op))

        If logicOpText = "&&" Or logicOpText = "ANDALSO" Or logicOpText = "||" Or logicOpText = "ORELSE" Then
            Dim leftName As String
            If MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, leftName, errText) = 0 Then Return 0

            Dim leftBool As String
            MIREnsureBoolVar module, fnIdx, blkIdx, tempSeed, leftName, leftBool

            Dim rhsBlock As Integer
            Dim shortBlock As Integer
            Dim endBlock As Integer
            rhsBlock = MIRAllocBlock(module, fnIdx)
            shortBlock = MIRAllocBlock(module, fnIdx)
            endBlock = MIRAllocBlock(module, fnIdx)

            Dim resultTemp As String
            resultTemp = MIRNextTemp(tempSeed)

            If logicOpText = "&&" Or logicOpText = "ANDALSO" Then
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JNZ, "", 2, leftBool, LTrim(Str(rhsBlock))
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(shortBlock))

                blkIdx = shortBlock
                Dim falseName As String
                falseName = MIRNextTemp(tempSeed)
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, falseName, 1, "0"
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, resultTemp, 1, falseName
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(endBlock))

                blkIdx = rhsBlock
                Dim rightAndName As String
                If MIRLowerExprNode(ps, n.right, module, fnIdx, blkIdx, tempSeed, rightAndName, errText) = 0 Then Return 0
                Dim rightAndBool As String
                MIREnsureBoolVar module, fnIdx, blkIdx, tempSeed, rightAndName, rightAndBool
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, resultTemp, 1, rightAndBool
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(endBlock))
            Else
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JNZ, "", 2, leftBool, LTrim(Str(shortBlock))
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(rhsBlock))

                blkIdx = shortBlock
                Dim trueName As String
                trueName = MIRNextTemp(tempSeed)
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, trueName, 1, "-1"
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, resultTemp, 1, trueName
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(endBlock))

                blkIdx = rhsBlock
                Dim rightOrName As String
                If MIRLowerExprNode(ps, n.right, module, fnIdx, blkIdx, tempSeed, rightOrName, errText) = 0 Then Return 0
                Dim rightOrBool As String
                MIREnsureBoolVar module, fnIdx, blkIdx, tempSeed, rightOrName, rightOrBool
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, resultTemp, 1, rightOrBool
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(endBlock))
            End If

            blkIdx = endBlock
            valueNameOut = resultTemp
            Return 1
        End If

        Dim lName As String
        Dim rName As String
        If MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, lName, errText) = 0 Then Return 0
        If MIRLowerExprNode(ps, n.right, module, fnIdx, blkIdx, tempSeed, rName, errText) = 0 Then Return 0

        Dim libLeftType As String
        Dim libRightType As String
        If MIRLibraryTypeOperandTypeName(ps, module, fnIdx, n.left, lName, libLeftType) <> 0 And MIRLibraryTypeOperandTypeName(ps, module, fnIdx, n.right, rName, libRightType) <> 0 Then
            Dim libResultType As String
            Dim libCallName As String
            If UXBLibraryTypeResolveBinaryOperator(libLeftType, n.op, libRightType, libResultType, libCallName) <> 0 Then
                Dim libOpTemp As String
                libOpTemp = MIRNextTemp(tempSeed)
                MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, libOpTemp, 3, UCase(Trim(libCallName)), lName, rName
                MIRSetCurrentSourceFromAstNode ps, nodeIdx
                MIRSetLastInstructionMetadata module, fnIdx, blkIdx, UCase(Trim(libResultType))
                valueNameOut = libOpTemp
                Return 1
            End If
        End If

        Dim opSuffix As String
        If MIROperatorTokenToRoutineSuffix(n.op, opSuffix) <> 0 Then
            Dim lhsType As String
            If MIRTryInferExprTypeName(ps, n.left, lhsType) <> 0 Then
                lhsType = UCase(Trim(lhsType))
                If lhsType <> "" And MIRFindClassDeclNode(ps, lhsType) <> -1 Then
                    Dim ownerType As String
                    Dim candidateSuffix As String
                    If MIRResolveOperatorOwnerType(ps, lhsType, opSuffix, ownerType, candidateSuffix) <> 0 Then
                        Dim opCallName As String
                        opCallName = UCase(Trim(ownerType & "_" & candidateSuffix))
                        Dim opTemp As String
                        opTemp = MIRNextTemp(tempSeed)
                        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, opTemp, 3, opCallName, lName, rName
                        Dim opResultType As String, opTypeError As String
                        If UXBStep3InferExprType(ps, nodeIdx, opResultType, opTypeError) <> 0 Then
                            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, MIRCanonicalTypeName(opResultType)
                        End If
                        valueNameOut = opTemp
                        Return 1
                    End If
                End If
            End If
        End If

        Dim bop As String
        Dim preferFloatKind As Integer
        preferFloatKind = MIRInferExprFloatKind(ps, nodeIdx)
        If preferFloatKind = MIR_UXF_F80 Then
            errText = "mir: F80 arithmetic not supported"
            Return 0
        End If
        If MIRMapBinaryOpcode(n.op, IIf(preferFloatKind <> MIR_UXF_UNKNOWN, 1, 0), bop) = 0 Then
            errText = "mir: unsupported binary op " & n.op
            Return 0
        End If
        If bop = MIR_OP_SHR Then
            Dim shiftLeftType As String
            If MIRTryInferExprTypeName(ps, n.left, shiftLeftType) <> 0 Then
                If MIRTypeNameIsUnsignedInteger(shiftLeftType) <> 0 Then bop = MIR_OP_USHR
            End If
        End If
        ' S-077: integer division, remainder and ordering are sign-dependent.
        ' When either operand is U64 the promoted operation is unsigned 64-bit
        ' (mixed I64/U64 -> U64), so pick the unsigned opcode. Float operands
        ' keep the ordinary opcode (they convert to floating point first).
        If preferFloatKind = MIR_UXF_UNKNOWN Then
            Dim unsignedBinaryDomain As Integer
            unsignedBinaryDomain = IIf(UXBExprIsU64(ps, n.left) <> 0 Or UXBExprIsU64(ps, n.right) <> 0, 1, 0)
            ' S-628: two unsigned operands also require unsigned ordering in
            ' the i32 WASM lane (U32's high bit is not a negative sign).
            ' Mixed signed/U32 operands retain the existing promotion rule.
            If unsignedBinaryDomain = 0 Then
                Dim unsignedLeftType As String, unsignedRightType As String
                If MIRTryInferExprTypeName(ps, n.left, unsignedLeftType) <> 0 And MIRTryInferExprTypeName(ps, n.right, unsignedRightType) <> 0 Then
                    If MIRTypeNameIsUnsignedInteger(unsignedLeftType) <> 0 And MIRTypeNameIsUnsignedInteger(unsignedRightType) <> 0 Then unsignedBinaryDomain = 1
                End If
            End If
            If unsignedBinaryDomain <> 0 Then
                Select Case bop
                Case MIR_OP_IDIV: bop = MIR_OP_UIDIV
                Case MIR_OP_MOD: bop = MIR_OP_UMOD
                Case MIR_OP_LT: bop = MIR_OP_ULT
                Case MIR_OP_LE: bop = MIR_OP_ULE
                Case MIR_OP_GT: bop = MIR_OP_UGT
                Case MIR_OP_GE: bop = MIR_OP_UGE
                End Select
            End If
        End If

        Dim t As String
        t = MIRNextTemp(tempSeed)
        MIRAppendInstruction module, fnIdx, blkIdx, bop, t, 2, lName, rName
        Dim binaryResultType As String
        ' The float-kind inference is the lowering-side source of truth for
        ' numeric operator precision. Semantic type metadata can still carry
        ' the legacy F64 default for an expression such as F32 * I32; allowing
        ' that default to overwrite the inferred F32 result widens the value
        ' before the backend sees it.
        ' Comparisons always produce the language Boolean value (-1/0).  The
        ' operand promotion above selects the comparison instruction's numeric
        ' domain, but must never leak that domain into the result metadata.  A
        ' float operand used to mark GE/LT/etc. as F64; MIR-x64 then stored the
        ' integer truth bit pattern as a floating value (NaN for TRUE).
        Select Case UCase(Trim(bop))
        Case "EQ", "NE", "LT", "LE", "GT", "GE", "ULT", "ULE", "UGT", "UGE"
            binaryResultType = "BOOLEAN"
        Case Else
            binaryResultType = ""
        End Select
        ' S-219: ROL/ROR are width-preserving integer operations.  The
        ' machine implementation may use a 64-bit scratch register, but the
        ' language result has the left operand's declared integer type.
        If binaryResultType = "" And (UCase(Trim(bop)) = "ROL" Or UCase(Trim(bop)) = "ROR") Then
            Dim rotateResultType As String
            If MIRTryInferExprTypeName(ps, n.left, rotateResultType) <> 0 Then
                rotateResultType = MIRCanonicalTypeName(rotateResultType)
                If UXBStep3TypeIsInteger(rotateResultType) <> 0 Then binaryResultType = rotateResultType
            End If
        End If
        If binaryResultType = "" And preferFloatKind = MIR_UXF_F32 Then
            binaryResultType = "F32"
        ElseIf binaryResultType = "" And preferFloatKind = MIR_UXF_F64 Then
            binaryResultType = "F64"
        ElseIf binaryResultType = "" Then
            binaryResultType = UCase(Trim(n.typeName))
        End If
        If binaryResultType = "" Then
            Select Case UCase(Trim(bop))
            Case "FADD", "FSUB", "FMUL", "FDIV", "FNEG"
                binaryResultType = "F64"
            Case "UIDIV", "UMOD"
                binaryResultType = "U64"
            Case "EQ", "NE", "LT", "LE", "GT", "GE", "ULT", "ULE", "UGT", "UGE"
                binaryResultType = "BOOLEAN"
            Case Else
                binaryResultType = "I64"
            End Select
        End If
        MIRSetCurrentSourceFromAstNode ps, nodeIdx
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, binaryResultType
        valueNameOut = t
        Return 1
    End If

    If k = "TERNARY_EXPR" Then
        Dim condName As String
        If MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, condName, errText) = 0 Then Return 0

        Dim condBool As String
        MIREnsureBoolVar module, fnIdx, blkIdx, tempSeed, condName, condBool

        Dim thenNode As Integer
        thenNode = MIRChildAt(ps, nodeIdx, 0)
        If thenNode = -1 Then
            errText = "mir: ternary true branch missing"
            Return 0
        End If

        Dim thenBlock As Integer
        Dim elseBlock As Integer
        Dim endBlock As Integer
        thenBlock = MIRAllocBlock(module, fnIdx)
        elseBlock = MIRAllocBlock(module, fnIdx)
        endBlock = MIRAllocBlock(module, fnIdx)

        Dim resultTemp As String
        resultTemp = MIRNextTemp(tempSeed)
        Dim conditionalType As String
        If UXBStep3InferExprType(ps, nodeIdx, conditionalType, errText) = 0 Then Return 0
        conditionalType = MIRCanonicalTypeName(conditionalType)

        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JNZ, "", 2, condBool, LTrim(Str(thenBlock))
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(elseBlock))

        blkIdx = thenBlock
        Dim thenValue As String
        If MIRLowerExprNode(ps, thenNode, module, fnIdx, blkIdx, tempSeed, thenValue, errText) = 0 Then Return 0
        If UXBStep3TypeIsNumeric(conditionalType) <> 0 Then
            Dim thenCast As String = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CAST, thenCast, 1, thenValue
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, conditionalType
            thenValue = thenCast
        End If
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, resultTemp, 1, thenValue
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, conditionalType
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(endBlock))

        blkIdx = elseBlock
        Dim elseValue As String
        If MIRLowerExprNode(ps, n.right, module, fnIdx, blkIdx, tempSeed, elseValue, errText) = 0 Then Return 0
        If UXBStep3TypeIsNumeric(conditionalType) <> 0 Then
            Dim elseCast As String = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CAST, elseCast, 1, elseValue
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, conditionalType
            elseValue = elseCast
        End If
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_STORE_VAR, resultTemp, 1, elseValue
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, conditionalType
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_JMP, "", 1, LTrim(Str(endBlock))

        blkIdx = endBlock
        valueNameOut = resultTemp
        Return 1
    End If

    If k = "CALL_EXPR" Then
        Dim callName As String
        Dim skipFirstCallChild As Integer
        Dim injectReceiver As Integer
        Dim receiverVar As String
        callName = UCase(Trim(n.value))

        ' S-030 Faz 1B: TASK/TASKGROUP alicili metot -> kanonik TASK_* cagrisi.
        If n.left <> -1 And InStr(callName, ".") > 0 Then
            Dim atomicHandled As Integer
            If MIRLowerAtomicMember(ps, nodeIdx, module, fnIdx, blkIdx, tempSeed, valueNameOut, atomicHandled, errText) = 0 Then Return 0
            If atomicHandled <> 0 Then Return 1
            Dim taskRecvKind As String
            taskRecvKind = MIRTaskReceiverKind(ps, n.left)
            If taskRecvKind <> "" Then
                Return MIRLowerTaskMember(ps, n.left, taskRecvKind, MIRMethodLeafName(callName), nodeIdx, 1, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
            End If
        End If

        Dim sizeofHandled As Integer
        If MIRLowerArraySizeOfCall(ps, nodeIdx, module, fnIdx, blkIdx, tempSeed, valueNameOut, sizeofHandled, errText) = 0 Then Return 0
        If sizeofHandled <> 0 Then Return 1

        Dim arrayBoundsHandled As Integer
        If MIRLowerArrayBoundsCall(ps, nodeIdx, module, fnIdx, blkIdx, tempSeed, valueNameOut, arrayBoundsHandled, errText) = 0 Then Return 0
        If arrayBoundsHandled <> 0 Then Return 1

        If callName = "VARPTR" Then
            ' S-049: VARPTR was never lowered at all -- every call fell through
            ' to the generic CALL_EXPR path, which the interpreter/x64 dispatch
            ' both treat as an unbound library call. The variable name is a
            ' compile-time reference (not a runtime value), so it goes through
            ' as a quoted literal operand, matching SETNEWOFFSET_STMT's own
            ' "IDENT name -> quoted literal" convention elsewhere in this file.
            If MIRChildCount(ps, nodeIdx) <> 1 Then errText = "mir: VARPTR expects exactly one identifier argument": Return 0
            Dim varptrArgNode As Integer
            varptrArgNode = MIRChildAt(ps, nodeIdx, 0)
            If UCase(Trim(ps.ast.nodes(varptrArgNode).kind)) <> "IDENT" Then errText = "mir: VARPTR requires identifier, got " & ps.ast.nodes(varptrArgNode).kind: Return 0
            Dim varptrTemp As String
            varptrTemp = MIRNextTemp(tempSeed)
            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, "MIR_VARPTR", varptrTemp, 1, Chr(34) & Trim(ps.ast.nodes(varptrArgNode).value) & Chr(34)
            valueNameOut = varptrTemp
            Return 1
        End If

        If callName = "PEEK" Or callName = "PEEKB" Or callName = "PEEKW" Or callName = "PEEKD" Or callName = "PEEKQ" Or callName = "PEEKS" Then
            Dim memMode As String
            Dim memArgOffset As Integer
            MIRMemoryModeFromArgs ps, nodeIdx, memMode, memArgOffset
            Dim memArgCount As Integer
            memArgCount = MIRChildCount(ps, nodeIdx) - memArgOffset
            If callName = "PEEKS" Then
                If memArgCount <> 2 Then
                    errText = "mir: PEEKS expects address,length"
                    Return 0
                End If
            ElseIf memArgCount <> 1 Then
                errText = "mir: " & callName & " expects address"
                Return 0
            End If

            Dim memAddrNode As Integer
            memAddrNode = MIRChildAt(ps, nodeIdx, memArgOffset)
            Dim memAddrName As String
            If MIRLowerExprNode(ps, memAddrNode, module, fnIdx, blkIdx, tempSeed, memAddrName, errText) = 0 Then Return 0

            If callName = "PEEKS" Then
                Dim seqLenNode As Integer
                seqLenNode = MIRChildAt(ps, nodeIdx, memArgOffset + 1)
                Dim seqLenName As String
                If MIRLowerExprNode(ps, seqLenNode, module, fnIdx, blkIdx, tempSeed, seqLenName, errText) = 0 Then Return 0
                Dim seqTemp As String
                seqTemp = MIRNextTemp(tempSeed)
                MIRSetCurrentSourceFromAstNode ps, nodeIdx
                MIRAppendInstruction module, fnIdx, blkIdx, "MIR_MEMORY_READ_SEQUENCE", seqTemp, 3, memMode, memAddrName, seqLenName
                MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "STRING"
                valueNameOut = seqTemp
                Return 1
            End If

            Dim memWidth As Integer
            memWidth = MIRMemoryWidthForName(callName)
            If memWidth <= 0 Then errText = "mir: unsupported memory read width " & callName: Return 0
            ' S-021/S-049: literal width operand instead of a temp+LOAD_CONST
            ' indirection -- the x64 emitter resolves this operand with a
            ' plain Val(), which returns 0 (a false "unsupported width") for
            ' a temp name. See the MEMCOPY_STMT lowering case for the same fix.
            Dim peekTemp As String
            peekTemp = MIRNextTemp(tempSeed)
            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, "MIR_MEMORY_LOAD", peekTemp, 3, memMode, memAddrName, LTrim(Str(memWidth))
            ' S-061: PEEKB/PEEKW/PEEKD read raw bytes with NO sign bit of their
            ' own -- like every other BASIC dialect's PEEK family, the result is
            ' the plain magnitude (0..255 / 0..65535 / 0..4294967295), never a
            ' negative number. The AST and canonical-MIR interpreters already
            ' return it this way unconditionally (mir_interp_memory.fbs's
            ' MIR_MEMORY_LOAD handler ignores this metadata entirely and just
            ' returns the zero-extended magnitude) -- but native x64's
            ' MIRX64StoreRegToVar narrows/sign-extends a result temp according
            ' to exactly this tag (MIRX64NormalizeRegForType), so tagging it
            ' I8/I16/I32 (signed) made native x64 the odd one out: PEEKB(a
            ' byte holding 255) printed -1 instead of 255, same for
            ' PEEKW/PEEKD. Tag unsigned instead so native x64's store path
            ' zero-extends (movzx/mov e??,e??) like the other two engines,
            ' matching Mete's decision (unsigned, matching classic BASIC PEEK).
            ' S-055: width=8 (PEEKQ) tagged U64 -- MIRX64NormalizeRegForType
            ' emits nothing for 64-bit types (a full register is already the
            ' whole value, no narrowing/sign-extension possible), so this is
            ' a no-op on the store path, same as the interpreters' own
            ' unconditional zero-extended-magnitude behavior.
            Dim peekWidthTag As String
            Select Case memWidth
            Case 8: peekWidthTag = "U64"
            Case 4: peekWidthTag = "U32"
            Case 2: peekWidthTag = "U16"
            Case Else: peekWidthTag = "U8"
            End Select
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, peekWidthTag
            valueNameOut = peekTemp
            Return 1
        End If

        skipFirstCallChild = 0
        injectReceiver = 0
        receiverVar = ""

        Dim scalarCastType As String
        scalarCastType = MIRCanonicalTypeName(callName)
        Select Case scalarCastType
        Case "BOOLEAN", "BOOL", "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "PTR"
            If MIRChildCount(ps, nodeIdx) <> 1 Then
                errText = "mir: " & callName & " conversion expects exactly one argument"
                Return 0
            End If
            If scalarCastType = "BOOL" Then scalarCastType = "BOOLEAN"
            Dim scalarSourceName As String
            If MIRLowerExprNode(ps, MIRChildAt(ps, nodeIdx, 0), module, fnIdx, blkIdx, tempSeed, scalarSourceName, errText) = 0 Then Return 0
            Dim scalarResultName As String
            scalarResultName = MIRNextTemp(tempSeed)
            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CAST, scalarResultName, 1, scalarSourceName
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, scalarCastType
            valueNameOut = scalarResultName
            Return 1
        End Select

        Dim namespaceCallTarget As String
        Dim isNamespaceCall As Integer
        namespaceCallTarget = ""
        isNamespaceCall = MIRResolveNamespaceRoutineCall(ps, callName, namespaceCallTarget)
        If isNamespaceCall <> 0 Then callName = namespaceCallTarget
        If isNamespaceCall = 0 Then
            isNamespaceCall = MIRResolveEnclosingNamespaceRoutineCall(ps, callName, namespaceCallTarget)
            If isNamespaceCall <> 0 Then callName = namespaceCallTarget
        End If
        If isNamespaceCall = 0 Then
            isNamespaceCall = MIRResolveUsingRoutineCall(ps, callName, namespaceCallTarget)
            If isNamespaceCall <> 0 Then callName = namespaceCallTarget
        End If

        If callName = "OFFSETOF" Then
            If MIRChildCount(ps, nodeIdx) <> 2 Then
                errText = "mir: OFFSETOF expects two arguments"
                Return 0
            End If

            Dim typeNode As Integer
            Dim pathNode As Integer
            typeNode = MIRChildAt(ps, nodeIdx, 0)
            pathNode = MIRChildAt(ps, nodeIdx, 1)
            If typeNode = -1 Or pathNode = -1 Then
                errText = "mir: OFFSETOF arguments missing"
                Return 0
            End If

            Dim typeKind As String
            Dim pathKind As String
            typeKind = UCase(ps.ast.nodes(typeNode).kind)
            pathKind = UCase(ps.ast.nodes(pathNode).kind)
            If typeKind <> "IDENT" And typeKind <> "KEYWORD_REF" Then
                errText = "mir: OFFSETOF first argument must be type name"
                Return 0
            End If
            If pathKind <> "STRING" Then
                errText = "mir: OFFSETOF second argument must be string path"
                Return 0
            End If

            Dim offValue As Integer
            Dim offErr As String
            If TypeLayoutOffsetOf(ps, ps.ast.nodes(typeNode).value, ps.ast.nodes(pathNode).value, offValue, offErr) = 0 Then
                errText = "mir: OFFSETOF resolve failed " & offErr
                Return 0
            End If

            Dim offTemp As String
            offTemp = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, offTemp, 1, LTrim(Str(offValue))
            valueNameOut = offTemp
            Return 1
        End If

        If callName = "CODEPTR" Or callName = "LPTR" Then
            ' CODEPTR(routineName)/LPTR(routineName) need the raw identifier
            ' TEXT, not a lowered/evaluated expression -- the x64 backend
            ' resolves it to either a local variable's stack offset or a
            ' declared SUB/FUNCTION's code label (MIRX64EmitAddressLikeOpcode
            ' in mir_x64_opcode_surface_emitters.fbs). Without this explicit
            ' case, callName never matches a known builtin/user function
            ' below and silently falls through to a generic runtime
            ' HOST_CALL("CODEPTR", ...) that always returns a fixed dummy
            ' value instead of a real address.
            Dim ptrArgNode As Integer
            ptrArgNode = MIRChildAt(ps, nodeIdx, 0)
            If ptrArgNode = -1 Then
                errText = "mir: " & callName & " expects an identifier argument"
                Return 0
            End If
            Dim ptrArgKind As String
            ptrArgKind = UCase(Trim(ps.ast.nodes(ptrArgNode).kind))
            If ptrArgKind <> "IDENT" And ptrArgKind <> "KEYWORD_REF" Then
                errText = "mir: " & callName & " expects an identifier argument"
                Return 0
            End If
            Dim ptrArgName As String
            ptrArgName = Trim(ps.ast.nodes(ptrArgNode).value)
            If ptrArgName = "" Then
                errText = "mir: " & callName & " expects a non-empty identifier argument"
                Return 0
            End If
            Dim ptrTemp As String
            ptrTemp = MIRNextTemp(tempSeed)
            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, callName, ptrTemp, 1, ptrArgName
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, "PTR"
            valueNameOut = ptrTemp
            Return 1
        End If

        If (InStr(callName, ".") = 0 Or MIRIsNamespaceVarName(callName) <> 0) And MIRIsKnownArray(module, callName) <> 0 And MIRChildCount(ps, nodeIdx) >= 1 Then
            Dim indexName As String
            Dim loadTemp As String
            If MIRLowerFlatArrayIndex(ps, nodeIdx, callName, module, fnIdx, blkIdx, tempSeed, indexName, errText) = 0 Then Return 0
            loadTemp = MIRNextTemp(tempSeed)
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_INDEXED, loadTemp, 2, callName, indexName
            Dim indexedElementType As String
            indexedElementType = MIRArrayElementTypeOf(module, callName)
            If UCase(Trim(indexedElementType)) <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, indexedElementType
            valueNameOut = loadTemp
            Return 1
        End If

        Dim libCallOwner As Integer, libCallType As String, libCallMember As String, libCallResult As String
        If UXBLibraryTypeFindCallOwner(callName, libCallOwner, libCallType, libCallMember) <> 0 Then
            If UXBLibraryTypeResolveCallName(callName, libCallOwner, libCallType, libCallMember, libCallResult) = 0 Then
                errText = "library type member not declared: " & callName
                Return 0
            End If
            isNamespaceCall = 1
        End If
        If isNamespaceCall = 0 And n.left <> -1 And InStr(callName, ".") > 0 Then
            Dim methodCallTemp As String
            If MIRAppendMethodCallInstruction(ps, nodeIdx, module, fnIdx, blkIdx, tempSeed, methodCallTemp, errText) = 0 Then Return 0
            valueNameOut = methodCallTemp
            Return 1
        End If

        If isNamespaceCall = 0 And InStr(callName, ".") > 0 Then
            Dim loweredCallName As String
            If MIRResolveMethodCallRoute(ps, nodeIdx, callName, loweredCallName, injectReceiver, receiverVar) <> 0 Then
                callName = loweredCallName
            End If
        End If

        If callName = "CALL" And n.firstChild <> -1 Then
            Dim markerKind As String
            Dim markerValue As String
            markerKind = UCase(Trim(ps.ast.nodes(n.firstChild).kind))
            markerValue = UCase(Trim(ps.ast.nodes(n.firstChild).value))
            If (markerKind = "IDENT" Or markerKind = "KEYWORD_REF") And markerValue = "DLL" Then
                callName = "DLL"
                skipFirstCallChild = 1
            ElseIf (markerKind = "IDENT" Or markerKind = "KEYWORD_REF") And markerValue = "API" Then
                callName = "API"
                skipFirstCallChild = 1
            End If
        End If

        Dim ffiStubId As Integer
        Dim ffiArgStart As Integer
        Dim callResultType As String
        ffiStubId = 0
        ffiArgStart = 0
        callResultType = libCallResult
        If callName = "DLL" Or callName = "API" Then
            ffiStubId = MIRFfiCallOrdinal(ps, nodeIdx)
            Dim ffiBasePos As Integer
            ffiBasePos = IIf(skipFirstCallChild <> 0, 1, 0)
            Dim ffiReturnNode As Integer
            ffiReturnNode = MIRChildAt(ps, nodeIdx, ffiBasePos + 2)
            Dim ffiChildStart As Integer = ffiBasePos + 3
            If ffiReturnNode <> -1 Then
                Dim ffiReturnKind As String = UCase(Trim(ps.ast.nodes(ffiReturnNode).kind))
                Dim ffiReturnToken As String = UCase(Trim(ps.ast.nodes(ffiReturnNode).value))
                If ffiReturnKind = "KEYWORD_REF" Or ffiReturnKind = "IDENT" Or ffiReturnKind = "IDENTIFIER" Or ffiReturnKind = "TYPE_REF" Or ffiReturnKind = "VAR_REF" Then
                    Select Case ffiReturnToken
                    Case "CDECL", "STDCALL", "FASTCALL", "THISCALL", "WINAPI"
                        callResultType = "VOID"
                    Case Else
                        callResultType = MIRCanonicalTypeName(ffiReturnToken)
                    End Select
                Else
                    ffiChildStart = ffiBasePos + 2
                    Dim ffiSymbolNode As Integer = MIRChildAt(ps, nodeIdx, ffiBasePos + 1)
                    If ffiSymbolNode <> -1 Then MIRFindFunctionReturnType ps, ps.ast.nodes(ffiSymbolNode).value, callResultType
                    If callResultType = "" Then callResultType = "VOID"
                End If
            End If
            Dim ffiConventionNode As Integer = MIRChildAt(ps, nodeIdx, ffiChildStart)
            If ffiChildStart = ffiBasePos + 3 And ffiConventionNode <> -1 Then
                If UCase(Trim(ps.ast.nodes(ffiConventionNode).kind)) = "KEYWORD_REF" Then
                    Select Case UCase(Trim(ps.ast.nodes(ffiConventionNode).value))
                    Case "CDECL", "STDCALL", "FASTCALL", "THISCALL", "WINAPI"
                        ffiChildStart += 1
                    End Select
                End If
            End If
            Dim ffiTypeListNode As Integer
            ffiTypeListNode = MIRChildAt(ps, nodeIdx, ffiChildStart)
            If ffiTypeListNode <> -1 Then
                If UCase(Trim(ps.ast.nodes(ffiTypeListNode).kind)) = "STRING" Then
                    If MIRLooksLikeFfiArgTypeList(ps.ast.nodes(ffiTypeListNode).value) <> 0 Then ffiChildStart += 1
                End If
            End If
            ' Operand zero is the callee; the CALL marker is omitted.
            ffiArgStart = ffiChildStart - ffiBasePos + 1
        Else
            If callResultType = "" Then MIRFindFunctionReturnType ps, callName, callResultType
            If callResultType = "" Then
                Select Case callName
                Case "ABS", "CDBL", "VAL", "SQR", "SQRT", "SIN", "COS", "TAN", "ATN", "EXP", "LOG", "RND", "TIMER", "INPUTF"
                    callResultType = "F64"
                Case "CSNG"
                    callResultType = "F32"
                End Select
            End If
        End If

        Dim childCount As Integer
        childCount = 0
        Dim ch As Integer
        ch = n.firstChild
        Do While ch <> -1
            If skipFirstCallChild = 0 Or ch <> n.firstChild Then childCount += 1
            ch = ps.ast.nodes(ch).nextSibling
        Loop

        If injectReceiver <> 0 Then childCount += 1

        Dim t As String
        t = MIRNextTemp(tempSeed)

        Dim callFunctionIndex As Integer
        callFunctionIndex = MIRFindCallFunctionIndexLocal(module, callName)
        Dim callParamIndex As Integer
        callParamIndex = 0

        If childCount = 0 Then
            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, t, 1, callName
        Else
            Dim a1 As String, a2 As String, a3 As String, a4 As String, a5 As String, a6 As String, a7 As String, a8 As String
            Dim a9 As String, a10 As String, a11 As String, a12 As String, a13 As String, a14 As String, a15 As String, a16 As String
            a1 = callName
            Dim idx As Integer
            idx = 2

            If injectReceiver <> 0 Then
                a2 = receiverVar
                idx = 3
                callParamIndex = 1
            End If

            ch = n.firstChild
            Do While ch <> -1
                If skipFirstCallChild <> 0 And ch = n.firstChild Then
                    ch = ps.ast.nodes(ch).nextSibling
                    Continue Do
                End If
                Dim argName As String
                Dim argKind As String
                argKind = UCase(Trim(ps.ast.nodes(ch).kind))
                If (callName = "LEN" Or callName = "ASC" Or callName = "VAL") And argKind = "STRING" Then
                    argName = Chr(34) & ps.ast.nodes(ch).value & Chr(34)
                Else
                    If MIRLowerExprNode(ps, ch, module, fnIdx, blkIdx, tempSeed, argName, errText) = 0 Then Return 0
                End If
                If callFunctionIndex >= 0 AndAlso callParamIndex < module.functions(callFunctionIndex).paramVarCount Then
                    If callParamIndex > UBound(module.functions(callFunctionIndex).paramByRef) OrElse module.functions(callFunctionIndex).paramByRef(callParamIndex) = 0 Then
                        If MIRPrepareManagedByValArgument(ps, ch, module.functions(callFunctionIndex).paramVarTypes(callParamIndex), module, fnIdx, blkIdx, tempSeed, argName, errText) = 0 Then Return 0
                    End If
                End If
                Select Case idx
                Case 2: a2 = argName
                Case 3: a3 = argName
                Case 4: a4 = argName
                Case 5: a5 = argName
                Case 6: a6 = argName
                Case 7: a7 = argName
                Case 8: a8 = argName
                Case 9: a9 = argName
                Case 10: a10 = argName
                Case 11: a11 = argName
                Case 12: a12 = argName
                Case 13: a13 = argName
                Case 14: a14 = argName
                Case 15: a15 = argName
                Case 16: a16 = argName
                Case Else
                    errText = "mir: CALL arguman sayisi limiti asildi"
                    Return 0
                End Select
                idx += 1
                callParamIndex += 1
                ch = ps.ast.nodes(ch).nextSibling
            Loop

            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_CALL, t, childCount + 1, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16
        End If
        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, callResultType, ffiStubId, ffiArgStart

        valueNameOut = t
        Return 1
    End If

    If k = "FIELD_EXPR" Then
        ' S-030 Faz 1B: TASK .STATUS/.RESULT/.ERRORTEXT -> TASK_STATUS/TASK_RESULT/TASK_ERROR.
        Dim taskFieldRecv As Integer
        taskFieldRecv = n.left
        If taskFieldRecv = -1 Then taskFieldRecv = n.firstChild
        If taskFieldRecv <> -1 Then
            Dim taskFieldKind As String
            taskFieldKind = MIRTaskReceiverKind(ps, taskFieldRecv)
            If taskFieldKind <> "" Then
                Dim taskFieldName As String
                taskFieldName = Trim(n.value)
                If taskFieldName = "" And n.right <> -1 Then taskFieldName = Trim(ps.ast.nodes(n.right).value)
                Return MIRLowerTaskMember(ps, taskFieldRecv, taskFieldKind, taskFieldName, -1, 0, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
            End If
        End If

        Dim namespaceConstDecl As Integer
        Dim namespaceConstInit As Integer
        If UXBAstResolveNamespaceConstField(ps.ast, nodeIdx, namespaceConstDecl, namespaceConstInit) <> 0 Then
            Return MIRLowerExprNode(ps, namespaceConstInit, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
        End If

        Dim enumValue As String, enumBaseType As String, enumHandled As Integer
        If UXBAstResolveEnumConstant(ps.ast, nodeIdx, enumValue, enumBaseType, enumHandled, errText) = 0 Then Return 0
        If enumHandled <> 0 Then
            Dim enumTemp As String = MIRNextTemp(tempSeed)
            MIRSetCurrentSourceFromAstNode ps, nodeIdx
            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_CONST, enumTemp, 1, enumValue
            MIRSetLastInstructionMetadata module, fnIdx, blkIdx, enumBaseType
            valueNameOut = enumTemp
            Return 1
        End If

        Dim fieldPath As String
        If MIRBuildFieldPath(ps, nodeIdx, fieldPath, errText) = 0 Then Return 0

        Dim dotPos As Integer
        dotPos = InStr(fieldPath, ".")
        If dotPos > 1 Then
            Dim rootName As String
            Dim memberPath As String
            rootName = UCase(Trim(Left(fieldPath, dotPos - 1)))
            memberPath = Trim(Mid(fieldPath, dotPos + 1))

            If rootName <> "" And memberPath <> "" Then
                Dim rootType As String
                If MIRResolveFieldRootType(ps, nodeIdx, rootName, rootType) = 0 Then
                    If MIRFindClassDeclNode(ps, rootName) <> -1 Then
                        rootType = rootName
                    ElseIf (rootName = "THIS" Or rootName = "ME") And fnIdx >= 0 And fnIdx < module.functionCount Then
                        Dim fnName As String
                        fnName = UCase(Trim(module.functions(fnIdx).name))
                        Dim sepPos As Integer
                        sepPos = InStr(fnName, "_")
                        If sepPos > 1 Then
                            Dim classCandidate As String
                            classCandidate = Left(fnName, sepPos - 1)
                            If MIRFindClassDeclNode(ps, classCandidate) <> -1 Then
                                rootType = classCandidate
                            End If
                        End If
                    End If
                End If

                ' The class method body can be represented outside the AST
                ' class subtree. In that case the generated MIR function name
                ' (OWNER_METHOD) is the authoritative lexical receiver owner.
                If (rootName = "THIS" Or rootName = "ME" Or rootName = "SUPER") And fnIdx >= 0 And fnIdx < module.functionCount Then
                    Dim ownerFnName As String
                    ownerFnName = UCase(Trim(module.functions(fnIdx).name))
                    Dim ownerSep As Integer
                    ownerSep = InStr(ownerFnName, "_")
                    If ownerSep > 1 Then
                        rootType = Left(ownerFnName, ownerSep - 1)
                        If rootName = "SUPER" Then
                            Dim ownerBase As String
                            If MIRGetClassBaseTypeName(ps, rootType, ownerBase) <> 0 Then rootType = UCase(Trim(ownerBase))
                        End If
                    End If
                End If

                If rootType <> "" Then
                    Dim getterName As String
                    Dim propertyType As String
                    If MIRResolvePropertyAccessorRoutine(ps, nodeIdx, rootType, memberPath, "GET", getterName, propertyType) <> 0 Then
                        Dim recvName As String
                        Dim recvNode As Integer
                        recvNode = n.left
                        Dim staticProperty As Integer
                        staticProperty = 0
                        Dim propertyNode As Integer
                        Dim propertyOwner As String
                        If MIRFindPropertyInHierarchy(ps, rootType, memberPath, propertyOwner, propertyNode) <> 0 Then
                            staticProperty = MIRClassPropertyHasFlag(ps, propertyNode, "STATIC")
                        End If

                        Dim staticOwnerType As String
                        If staticProperty <> 0 AndAlso MIRIsClassNameExpr(ps, n.left, staticOwnerType) <> 0 Then
                            recvName = ""
                        ElseIf recvNode = -1 Then
                            recvName = rootName
                        Else
                            If MIRLowerExprNode(ps, recvNode, module, fnIdx, blkIdx, tempSeed, recvName, errText) = 0 Then Return 0
                        End If

                        Dim callTemp As String
                        callTemp = MIRNextTemp(tempSeed)
                        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_METHOD_CALL, callTemp, 4, UCase(Trim(getterName)), recvName, MIRFieldPathFirstIdent(memberPath), rootType
                        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, propertyType
                        valueNameOut = callTemp
                        Return 1
                    End If
                End If
            End If
        End If

        If MIRNormalizeFieldPathForAccess(ps, nodeIdx, fieldPath, 0, errText) = 0 Then Return 0

        Dim fieldDot As Integer
        fieldDot = InStr(fieldPath, ".")
        If fieldDot > 1 Then
            Dim fieldRoot As String
            Dim fieldMemberPath As String
            fieldRoot = UCase(Trim(Left(fieldPath, fieldDot - 1)))
            fieldMemberPath = Trim(Mid(fieldPath, fieldDot + 1))
            Dim fieldRootType As String
            Dim fieldFinalType As String
            Dim fieldFinalNode As Integer
            Dim fieldOwnerType As String
            If MIRResolveFieldRootType(ps, nodeIdx, fieldRoot, fieldRootType) <> 0 Then
                Dim unionFieldType As String
                Dim unionFieldOffset As Integer
                Dim unionFieldSize As Integer
                Dim unionFieldErr As String
                Dim unionFieldRv As Integer
                unionFieldRv = MIRTryResolveUnionFieldLayout(ps, fieldRootType, fieldMemberPath, unionFieldType, unionFieldOffset, unionFieldSize, unionFieldErr)
                If unionFieldRv < 0 Then
                    errText = unionFieldErr
                    Return 0
                End If
                If unionFieldRv > 0 Then
                    Dim unionLoadTemp As String
                    unionLoadTemp = MIRNextTemp(tempSeed)
                    MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_UNION_FIELD_LOAD, unionLoadTemp, 5, fieldRoot, fieldMemberPath, LTrim(Str(unionFieldOffset)), LTrim(Str(unionFieldSize)), unionFieldType
                    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, unionFieldType
                    valueNameOut = unionLoadTemp
                    Return 1
                End If
                If MIRResolveFieldPathTypeOwner(ps, fieldRootType, fieldMemberPath, fieldFinalType, fieldFinalNode, fieldOwnerType) <> 0 Then
                    If fieldFinalNode >= 0 And UCase(Trim(ps.ast.nodes(fieldFinalNode).kind)) = "CLASS_FIELD" Then
                        If MIRClassFieldHasFlag(ps, fieldFinalNode, "STATIC") = 0 Then
                            Dim fieldOffset As Integer
                            Dim fieldOffsetErr As String
                            If TypeLayoutOffsetOf(ps, fieldRootType, fieldMemberPath, fieldOffset, fieldOffsetErr) = 0 Then
                                errText = "mir: class field offset resolve failed " & fieldOffsetErr
                                Return 0
                            End If
                            Dim tField As String
                            tField = MIRNextTemp(tempSeed)
                            MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_FIELD_LOAD, tField, 3, fieldRoot, fieldMemberPath, LTrim(Str(fieldOffset))
                            ' The load's result type is the FIELD's declared type (without it the registry
                            ' default of the opcode group, TYPE_OBJECT, is stamped: a never-written field of a
                            ' new object then read as an empty value in the MIR interpreter).
                            If UCase(Trim(fieldFinalType)) <> "" Then MIRSetLastInstructionMetadata module, fnIdx, blkIdx, UCase(Trim(fieldFinalType))
                            valueNameOut = tField
                            Return 1
                        End If
                    End If
                End If
            End If
        End If

        ' S-050: array-of-TYPE field read with a runtime index (pts(i).X).
        ' Falling straight to the generic "LOAD_VAR fieldPath" fallback below
        ' would bake the index EXPRESSION'S TEXT (e.g. the literal string
        ' "I"), not its runtime value, into a compile-time pseudo-variable
        ' name like "PTS(I).X" -- correct by coincidence only when the index
        ' happens to be a literal. Detect an indexed-known-array base here
        ' and route through the real heap array+object model instead (see
        ' MIR_ARRAY_FIELD_LOAD in mir_interp_array_object.fbs).
        If n.left <> -1 And UCase(Trim(ps.ast.nodes(n.left).kind)) = "CALL_EXPR" Then
            Dim arrFieldArrName As String
            arrFieldArrName = ps.ast.nodes(n.left).value
            If (InStr(arrFieldArrName, ".") = 0 Or MIRIsNamespaceVarName(arrFieldArrName) <> 0) And MIRIsKnownArray(module, arrFieldArrName) <> 0 And MIRChildCount(ps, n.left) = 1 Then
                Dim arrFieldIdxExpr As Integer
                arrFieldIdxExpr = MIRChildAt(ps, n.left, 0)
                Dim arrFieldIdxName As String
                If MIRLowerExprNode(ps, arrFieldIdxExpr, module, fnIdx, blkIdx, tempSeed, arrFieldIdxName, errText) = 0 Then Return 0
                Dim arrFieldMemberName As String
                arrFieldMemberName = UCase(Trim(n.value))
                Dim arrFieldElemType As String
                arrFieldElemType = MIRArrayElementTypeOf(module, arrFieldArrName)
                Dim arrFieldTemp As String
                arrFieldTemp = MIRNextTemp(tempSeed)
                Dim arrFieldOffsetTmp As Integer
                Dim arrFieldSizeTmp As Integer
                Dim arrFieldFieldType As String
                Dim arrFieldTypeErr As String
                If TypeLayoutResolvePath(ps, arrFieldElemType, arrFieldMemberName, arrFieldOffsetTmp, arrFieldFieldType, arrFieldSizeTmp, arrFieldTypeErr) <> 0 Then
                    If MIRFindClassDeclNode(ps, arrFieldElemType) <> -1 Then
                        Dim afReadReceiver As String = MIRNextTemp(tempSeed)
                        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_INDEXED, afReadReceiver, 2, arrFieldArrName, arrFieldIdxName
                        MIRSetLastInstructionMetadata module, fnIdx, blkIdx, arrFieldElemType
                        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_FIELD_LOAD, arrFieldTemp, 3, afReadReceiver, arrFieldMemberName, LTrim(Str(arrFieldOffsetTmp))
                    Else
                    MIRAppendInstruction module, fnIdx, blkIdx, "MIR_ARRAY_FIELD_LOAD", arrFieldTemp, 6, arrFieldArrName, arrFieldIdxName, arrFieldMemberName, arrFieldElemType, LTrim(Str(arrFieldOffsetTmp)), LTrim(Str(arrFieldSizeTmp))
                    End If
                    MIRSetLastInstructionMetadata module, fnIdx, blkIdx, arrFieldFieldType
                Else
                    errText = "mir: array field layout resolve failed " & arrFieldTypeErr
                    Return 0
                End If
                valueNameOut = arrFieldTemp
                Return 1
            End If
        End If

        Dim t As String
        t = MIRNextTemp(tempSeed)
        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_LOAD_VAR, t, 1, fieldPath
        valueNameOut = t
        Return 1
    End If

    ' S-030 Faz 1B: SPAWN artik genel "sol dugumu indir" yoluna (sessizce siradan
    ' CALL <hedef>) DUSMEZ; kanonik TASK_SPAWN olur.
    If k = "SPAWN_EXPR" Then
        Return MIRLowerSpawnExpr(ps, nodeIdx, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
    End If

    If k = "NEW_EXPR" Then
        Dim className As String
        className = UCase(Trim(n.value))
        If className = "" Then
            errText = "mir: NEW class type missing"
            Return 0
        End If

        Dim t As String
        t = MIRNextTemp(tempSeed)

        Dim classSize As Integer
        Dim classSizeErr As String
        If TypeLayoutSizeOf(ps, className, classSize, classSizeErr) = 0 Then
            errText = "mir: NEW class layout resolve failed " & classSizeErr
            Return 0
        End If
        If classSize < 8 Then classSize = 8

        Dim a1 As String, a2 As String, a3 As String, a4 As String, a5 As String, a6 As String, a7 As String, a8 As String, a9 As String
        a1 = className
        a2 = LTrim(Str(classSize))

        Dim argCount As Integer
        argCount = 2

        Dim ch As Integer
        ch = n.firstChild
        Do While ch <> -1
            Dim argName As String
            If MIRLowerExprNode(ps, ch, module, fnIdx, blkIdx, tempSeed, argName, errText) = 0 Then Return 0

            argCount += 1
            Select Case argCount
            Case 3: a3 = argName
            Case 4: a4 = argName
            Case 5: a5 = argName
            Case 6: a6 = argName
            Case 7: a7 = argName
            Case 8: a8 = argName
            Case 9: a9 = argName
            Case Else
                errText = "mir: NEW arguman sayisi limiti asildi"
                Return 0
            End Select

            ch = ps.ast.nodes(ch).nextSibling
        Loop

        MIRAppendInstruction module, fnIdx, blkIdx, MIR_OP_OBJECT_NEW, t, argCount, a1, a2, a3, a4, a5, a6, a7, a8, a9
        valueNameOut = t
        Return 1
    End If

    If n.left <> -1 Then
        Dim leftKind As String
        leftKind = UCase(Trim(ps.ast.nodes(n.left).kind))
        If Right(leftKind, 5) <> "_STMT" And leftKind <> "EXIT" And leftKind <> "CONTINUE" Then
            Return MIRLowerExprNode(ps, n.left, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
        End If
    End If

    If n.firstChild <> -1 Then
        Dim firstExpr As Integer
        firstExpr = n.firstChild
        Do While firstExpr <> -1
            Dim fk As String
            fk = UCase(Trim(ps.ast.nodes(firstExpr).kind))
            If Right(fk, 5) <> "_STMT" And fk <> "EXIT" And fk <> "CONTINUE" Then Exit Do
            firstExpr = ps.ast.nodes(firstExpr).nextSibling
        Loop
        If firstExpr <> -1 Then
            Return MIRLowerExprNode(ps, firstExpr, module, fnIdx, blkIdx, tempSeed, valueNameOut, errText)
        End If
    End If

    errText = "mir: unsupported expr kind " & n.kind
    Return 0
End Function
