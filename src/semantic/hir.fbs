    Next i
    jsonOut &= "]"
    If addComma <> 0 Then jsonOut &= ","
    jsonOut &= Chr(10)
End Sub

Function HIRInventoryToJson(ByRef inv As HIRInventory, ByRef jsonOut As String) As Integer
    jsonOut = "{" & Chr(10)
    HIRAppendJsonArrayCommands jsonOut, 1, inv
    HIRAppendJsonArrayFunctions jsonOut, 1, inv
    HIRAppendJsonArrayOperators jsonOut, 1, inv
    HIRAppendJsonArrayTypes jsonOut, 1, inv
    HIRAppendJsonArrayDataStructures jsonOut, 0, inv
    jsonOut &= "}" & Chr(10)
    Return 1
End Function

Function HIRWriteInventoryJson(ByRef inv As HIRInventory, ByRef outPath As String, ByRef errText As String) As Integer
    Dim jsonText As String
    If HIRInventoryToJson(inv, jsonText) = 0 Then
        errText = "hir: json conversion failed"
        Return 0
    End If

    ' S-466 (ayni sinif): ust klasor yokken ciplak `Open` -exx altinda programi iptal ediyordu; ortak yazici klasoru olusturur.
    Dim writeErr As String
    If UXBReportWriteText(outPath, jsonText, writeErr) = 0 Then
        errText = "hir: json write open failed " & outPath & " (" & writeErr & ")"
        Return 0
    End If

    errText = ""
    Return 1
End Function

Private Function HIRScopeLookupCurrent(ByRef ss As ScopeStack, ByRef needleName As String) As Integer
    If ss.depth < 0 Then Return -1
    Return SymbolTableLookup(ss.scopes(ss.depth), needleName)
End Function

Private Function HIRScopeLookupEntry(ByRef ss As ScopeStack, ByRef needleName As String, ByRef entryOut As SymbolEntry) As Integer
    Dim level As Integer
    For level = ss.depth To 0 Step -1
        Dim idx As Integer
        idx = SymbolTableLookup(ss.scopes(level), needleName)
        If idx <> -1 Then
            entryOut = ss.scopes(level).entries(idx)
            Return 1
        End If
    Next
    Return 0
End Function

Private Function HIRFindChildByKind(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef kindText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return -1

    Dim want As String
    want = UCase(Trim(kindText))
    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If UCase(Trim(ps.ast.nodes(ch).kind)) = want Then Return ch
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return -1
End Function

Private Function HIRExtractDeclType(ByRef ps As ParseState, ByVal declNode As Integer, ByRef typeOut As String) As Integer
    typeOut = ""
    If declNode < 0 Or declNode >= ps.ast.count Then Return 0

    Dim typeNode As Integer
    typeNode = HIRFindChildByKind(ps, declNode, "TYPE_REF")
    If typeNode = -1 Then Return 0

    typeOut = UCase(Trim(ps.ast.nodes(typeNode).value))
    If typeOut = "" Then Return 0
    Return 1
End Function

Private Function HIRRegisterSymbol(ByRef ss As ScopeStack, ByRef nameRaw As String, ByRef kindRaw As String, ByRef typeRaw As String, ByVal enforceUnique As Integer, ByRef errText As String) As Integer
    Dim symbolName As String
    symbolName = UCase(Trim(nameRaw))
    If symbolName = "" Then
        errText = "hir: bos sembol adi"
        Return 0
    End If

    If enforceUnique <> 0 Then
        If HIRScopeLookupCurrent(ss, symbolName) <> -1 Then
            errText = "hir: ayni scope icinde tekrar eden sembol " & symbolName
            Return 0
        End If
    End If

    If ss.scopes(ss.depth).count >= 256 Then
        errText = "hir: symbol table kapasitesi dolu"
        Return 0
    End If

    Dim entry As SymbolEntry
    entry.name = symbolName
    entry.kind = UCase(Trim(kindRaw))
    entry.typeName = UCase(Trim(typeRaw))
    entry.scopeLevel = ss.depth
    entry.addr = 0
    entry.isConst = IIf(entry.kind = "CONST", 1, 0)
    entry.isArray = 0
    entry.bounds = ""
    SymbolTableAdd ss.scopes(ss.depth), entry
    Return 1
End Function

Private Function HIRMaybeRegisterDecl(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef ss As ScopeStack, ByRef errText As String) As Integer
    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)
    Dim k As String
    k = UCase(Trim(n.kind))

    Select Case k
    Case "DIM_DECL"
        Dim dimType As String
        If HIRExtractDeclType(ps, nodeIdx, dimType) = 0 Then
            errText = "hir: DIM deklarasyonunda TYPE_REF eksik"
            Return 0
        End If
        If HIRRegisterSymbol(ss, n.value, "VAR", dimType, 1, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).typeName = dimType
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1

    Case "CONST_DECL"
        If HIRRegisterSymbol(ss, n.value, "CONST", "CONST", 1, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1

    Case "PARAM_DECL"
        Dim paramType As String
        If HIRExtractDeclType(ps, nodeIdx, paramType) = 0 Then
            errText = "hir: PARAM deklarasyonunda TYPE_REF eksik"
            Return 0
        End If
        If HIRRegisterSymbol(ss, n.value, "PARAM", paramType, 1, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).typeName = paramType
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1

    Case "SUB_STMT", "FUNCTION_STMT", "DECLARE_SUB_STMT", "DECLARE_FUNCTION_STMT"
        If HIRRegisterSymbol(ss, n.value, "ROUTINE", "PROC", 0, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1

    Case "TYPE_STMT"
        If HIRRegisterSymbol(ss, n.value, "TYPE", UCase(Trim(n.value)), 0, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1

    Case "CLASS_STMT"
        If HIRRegisterSymbol(ss, n.value, "CLASS", UCase(Trim(n.value)), 0, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1

    Case "INTERFACE_STMT"
        If HIRRegisterSymbol(ss, n.value, "INTERFACE", UCase(Trim(n.value)), 0, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1
    Case "ENUM_STMT"
        If HIRRegisterSymbol(ss, n.value, "ENUM", UCase(Trim(n.value)), 0, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        Return 1
    Case "ENUM_ITEM"
        If HIRRegisterSymbol(ss, n.value, "CONST", "I32", 1, errText) = 0 Then Return 0
        ps.ast.nodes(nodeIdx).symbolName = UCase(Trim(n.value))
        ps.ast.nodes(nodeIdx).typeName = "I32"
        Return 1
    End Select

    Return 1
End Function

Private Sub HIRAnnotateIdentifier(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef ss As ScopeStack)
    Dim k As String
    k = UCase(Trim(ps.ast.nodes(nodeIdx).kind))
    If k <> "IDENT" And k <> "IDENTIFIER" Then Exit Sub

    Dim symbolName As String
    symbolName = UCase(Trim(ps.ast.nodes(nodeIdx).value))
    If symbolName = "" Then Exit Sub

    Dim found As SymbolEntry
    If HIRScopeLookupEntry(ss, symbolName, found) = 0 Then Exit Sub

    ps.ast.nodes(nodeIdx).symbolName = found.name
    If Trim(ps.ast.nodes(nodeIdx).typeName) = "" Then
        ps.ast.nodes(nodeIdx).typeName = found.typeName
    End If
End Sub

Private Function HIRNodeStartsScope(ByRef kindRaw As String) As Integer
    Dim k As String
    k = UCase(Trim(kindRaw))
    Select Case k
    Case "PROGRAM", "NAMESPACE_STMT", "MODULE_STMT", "MAIN_STMT", "SUB_STMT", "FUNCTION_STMT", "CLASS_STMT", "TYPE_STMT", "ENUM_STMT", "INTERFACE_STMT", "EVENT_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT"
        Return 1
    End Select
    Return 0
End Function

Private Function HIRAnalyzeNode(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef ss As ScopeStack, ByRef errText As String) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 1

    If HIRMaybeRegisterDecl(ps, nodeIdx, ss, errText) = 0 Then Return 0
    HIRAnnotateIdentifier ps, nodeIdx, ss

    Dim pushScope As Integer
    pushScope = HIRNodeStartsScope(ps.ast.nodes(nodeIdx).kind)
    If pushScope <> 0 Then ScopePush ss

    If ps.ast.nodes(nodeIdx).left <> -1 Then
        If HIRAnalyzeNode(ps, ps.ast.nodes(nodeIdx).left, ss, errText) = 0 Then Return 0
    End If
    If ps.ast.nodes(nodeIdx).right <> -1 Then
        If HIRAnalyzeNode(ps, ps.ast.nodes(nodeIdx).right, ss, errText) = 0 Then Return 0
    End If

    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        If HIRAnalyzeNode(ps, ch, ss, errText) = 0 Then Return 0
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    If pushScope <> 0 Then ScopePop ss
    Return 1
End Function

Function HIRSemanticAnalyze(ByRef ps As ParseState, ByRef errText As String) As Integer
    errText = ""

    If ps.rootNode = -1 Or ps.ast.count = 0 Then
        errText = "hir: bos AST"
        Return 0
    End If

    If HIRBuildBridgeAfterSemantic(ps, gHIRBridge, errText) = 0 Then Return 0
    If HIRPrepareMirLowering(ps, gHIRBridge, errText) = 0 Then Return 0

    Return 1
End Function


' ADIM07: canonical HIR surface contract bridge.
#include once "../surface/uxb_surface_layer_bridge.fbs"
Function UXBHIRSurfaceContractStatus(ByRef surfaceText As String) As String
    Dim layerText As String = "HIR"
    Select Case UCase(Trim(surfaceText))
    Case "ABS": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "ASC": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "ATN": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "CDBL": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "CHR": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "CINT": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "CLNG": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "COS": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "CSNG": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "DECORATOR": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "EOF": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "EVENT": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "EXP": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "FIX": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "GETKEY": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "INKEY": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "INLINE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "INT": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "LCASE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "LEN": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "LOF": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "LOG": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "LTRIM": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "MAGIC": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "MID": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "MIXIN": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "OFF": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "ON": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "OVERRIDE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "PARALEL": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "PARALEL": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "PIPE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "RANDOMIZE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "RND": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "RTRIM": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SETSTRINGSIZE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SGN": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "MAGIC": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SIN": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SLOT": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SPACE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SQR": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "SQRT": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "STR": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "STRPTR": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "TAN": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "THREAD": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "THREAD": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "TIMER": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "TRUE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "FALSE": Return UXBSurfaceLayerStatus(surfaceText, layerText)
    Case "ZERO": Return UXBSurfaceLayerStatus(surfaceText, layerText)
