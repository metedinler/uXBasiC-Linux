#ifndef UXB_MIR_VERIFICATION_GATE_JSON_FBS
#define UXB_MIR_VERIFICATION_GATE_JSON_FBS

#include once "mir_verification_gate.fbs"
#include once "../common/report_writer.fbs"

Private Function UXBMIRGateJsonEscape(ByVal rawText As String) As String
    Dim s As String = ""
    Dim i As Integer
    For i = 1 To Len(rawText)
        Dim ch As String = Mid(rawText, i, 1)
        Select Case ch
        Case Chr(34): s &= "\" & Chr(34)
        Case "\": s &= "\\"
        Case Chr(10): s &= "\n"
        Case Chr(13): s &= "\r"
        Case Else: s &= ch
        End Select
    Next i
    Return s
End Function

Function UXBMIRGateResultToJson(ByRef r As UXBMIRGateResult) As String
    Dim j As String
    j = "{" & Chr(10)
    j &= "  " & Chr(34) & "ok" & Chr(34) & ": " & IIf(r.ok <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "builder_ok" & Chr(34) & ": " & IIf(r.builderOk <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "storage_ok" & Chr(34) & ": " & IIf(r.storageOk <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "verifier_ok" & Chr(34) & ": " & IIf(r.verifierOk <> 0, "true", "false") & "," & Chr(10)
    j &= "  " & Chr(34) & "builder_checked" & Chr(34) & ": " & LTrim(Str(r.builderResult.checkedCount)) & "," & Chr(10)
    j &= "  " & Chr(34) & "storage_missing_type" & Chr(34) & ": " & LTrim(Str(r.storageResult.missingTypeCount)) & "," & Chr(10)
    j &= "  " & Chr(34) & "verify_errors" & Chr(34) & ": " & LTrim(Str(r.verifyResult.errorCount)) & "," & Chr(10)
    j &= "  " & Chr(34) & "errors" & Chr(34) & ": " & Chr(34) & UXBMIRGateJsonEscape(r.errorsText) & Chr(34) & Chr(10)
    j &= "}"
    Return j
End Function

Function UXBMIRWriteGateJson(ByRef r As UXBMIRGateResult, ByVal outPath As String, ByRef errText As String) As Integer
    errText = ""
    If Trim(outPath) = "" Then Return 1
    Dim contentText As String = UXBMIRGateResultToJson(r) & Chr(10)
    Return UXBReportWriteText(outPath, contentText, errText)
End Function

#endif
