' Extracted tail for semantic_pass modular split
#include once "semantic_implicit_this.fbs"
#include once "semantic_null_literal.fbs"
Private Function SemScopedRoutineName(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef routineNameRaw As String) As String
    Dim routineName As String
    routineName = UCase(Trim(routineNameRaw))
    If routineName = "" Or InStr(routineName, ".") > 0 Then Return routineName

    Dim p As Integer
    If nodeIdx >= 0 And nodeIdx < ps.ast.count Then p = ps.ast.nodes(nodeIdx).parent Else p = -1
    Do While p >= 0 And p < ps.ast.count
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(p).kind))
        If k = "NAMESPACE_STMT" Or k = "MODULE_STMT" Then
            Dim ownerName As String
            ownerName = UCase(Trim(ps.ast.nodes(p).value))
            If ownerName <> "" Then Return ownerName & "." & routineName
        End If
        p = ps.ast.nodes(p).parent
    Loop
    Return routineName
End Function

Private Function SemRoutineTypeSpec(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    Dim specText As String = UCase(Trim(ps.ast.nodes(nodeIdx).value))
    Dim ch As Integer = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        specText &= "[" & UCase(Trim(ps.ast.nodes(ch).kind)) & ":" & SemRoutineTypeSpec(ps, ch) & "]"
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return specText
End Function

Private Function SemRoutineSignature(ByRef ps As ParseState, ByVal nodeIdx As Integer) As String
    Dim signature As String
    signature = IIf(InStr(UCase(ps.ast.nodes(nodeIdx).kind), "FUNCTION") > 0, "FUNCTION", "SUB")
    Dim ch As Integer = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        Dim ck As String = UCase(Trim(ps.ast.nodes(ch).kind))
        If ck = "PARAM_DECL" Then
            Dim paramMode As String = UCase(Trim(ps.ast.nodes(ch).op))
            If paramMode = "" Then paramMode = "BYVAL"
            signature &= "|" & paramMode
            Dim typeChild As Integer = ps.ast.nodes(ch).firstChild
            Do While typeChild <> -1
                signature &= ":" & SemRoutineTypeSpec(ps, typeChild)
                typeChild = ps.ast.nodes(typeChild).nextSibling
            Loop
        ElseIf ck = "RETURN_TYPE" Or ck = "GENERIC_PARAM" Then
            signature &= "|" & ck & ":" & SemRoutineTypeSpec(ps, ch)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return signature
End Function

Private Function SemOverloadQualifiedName(ByVal original As String, ByRef leafName As String) As String
    For p As Integer = Len(original) To 1 Step -1
        If Mid(original, p, 1) = "." Then Return Left(original, p) & leafName
    Next p
    Return leafName
End Function

' Keep the function-name result variable consistent with the bound routine.
' Explicit parameters/local declarations of the same name still win (S-612).
Private Sub SemRenameOverloadResult(ByRef ps As ParseState, ByVal routineNode As Integer, ByRef oldName As String, ByRef newName As String)
    For n As Integer = 0 To ps.ast.count - 1
        Dim k As String = UCase(ps.ast.nodes(n).kind)
        If k <> "IDENT" And k <> "IDENTIFIER" Then Continue For
        If UCase(Trim(ps.ast.nodes(n).value)) <> oldName Then Continue For
        If UXBTaskEnclosingRoutine(ps, n) <> routineNode Then Continue For
        Dim localDecl As Integer = StiFindDeclAny(ps, oldName, n)
        If localDecl >= 0 AndAlso UXBTaskEnclosingRoutine(ps, localDecl) = routineNode Then Continue For
        ps.ast.nodes(n).value = newName
    Next n
End Sub

Private Function SemValidateOverloadResolution(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim names() As String
    Dim arities() As Integer
    Dim genericArities() As Integer
    Dim signatureNodes() As Integer
    Dim seenDeclaration() As Integer
    Dim seenDefinition() As Integer
    Dim loweredNames() As String
    Dim sigCount As Integer
    Dim i As Integer

    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(ps.ast.nodes(i).kind)
        If k = "SUB_STMT" Or k = "FUNCTION_STMT" Or k = "DECLARE_SUB_STMT" Or k = "DECLARE_FUNCTION_STMT" Then
            Dim nameKey As String
            nameKey = SemScopedRoutineName(ps, i, ps.ast.nodes(i).value)

            Dim argc As Integer
            argc = SemCountRoutineParams(ps, i)
            Dim gargc As Integer
            gargc = SemCountRoutineGenericParams(ps, i)

            Dim j As Integer
            Dim isDeclaration As Integer = IIf(Left(k, 8) = "DECLARE_", 1, 0)
            Dim mergedPair As Integer = 0
            For j = 0 To sigCount - 1
                If names(j) = nameKey And arities(j) = argc And genericArities(j) = gargc Then
                    If (isDeclaration <> 0 And seenDeclaration(j) = 0) Or (isDeclaration = 0 And seenDefinition(j) = 0) Then
                        Dim previousNode As Integer = signatureNodes(j)
                        If InStr(UCase(ps.ast.nodes(i).typeName), "LIB=") = 0 And InStr(UCase(ps.ast.nodes(previousNode).typeName), "LIB=") = 0 Then
                            If SemRoutineSignature(ps, previousNode) <> SemRoutineSignature(ps, i) Then
                                errText = "semantic: declaration signature mismatch " & nameKey
                                Return 0
                            End If
                            If isDeclaration <> 0 Then seenDeclaration(j) = 1 Else seenDefinition(j) = 1
                            mergedPair = 1
                            Exit For
                        End If
                    End If
                    errText = "semantic: duplicate overload signature " & nameKey & "(" & Str(argc) & ")"
                    Return 0
                End If
            Next j
            If mergedPair <> 0 Then Continue For

            If sigCount = 0 Then
                ReDim names(0)
                ReDim arities(0)
                ReDim genericArities(0)
                ReDim signatureNodes(0)
                ReDim seenDeclaration(0)
                ReDim seenDefinition(0)
            Else
                ReDim Preserve names(sigCount)
                ReDim Preserve arities(sigCount)
                ReDim Preserve genericArities(sigCount)
                ReDim Preserve signatureNodes(sigCount)
                ReDim Preserve seenDeclaration(sigCount)
                ReDim Preserve seenDefinition(sigCount)
            End If

            names(sigCount) = nameKey
            arities(sigCount) = argc
            genericArities(sigCount) = gargc
            signatureNodes(sigCount) = i
            seenDeclaration(sigCount) = isDeclaration
            seenDefinition(sigCount) = IIf(isDeclaration = 0, 1, 0)
            sigCount += 1
        End If
    Next i

    ' S-223: bind local arity overloads once in the shared front end. Backends
    ' consume ordinary, distinct routines instead of each inventing a resolver.
    If sigCount > 0 Then ReDim loweredNames(sigCount - 1)
    Dim hasOverloads As Integer = 0
    For i = 0 To sigCount - 1
        If seenDefinition(i) = 0 Then Continue For
        Dim declNode As Integer = signatureNodes(i)
        If InStr(UCase(ps.ast.nodes(declNode).typeName), "LIB=") > 0 Then Continue For
        Dim conv As String = UCase(Trim(ps.ast.nodes(declNode).op))
        If conv = "CDECL" Or conv = "STDCALL" Then Continue For
        For j As Integer = 0 To sigCount - 1
            If names(i) <> names(j) Or seenDefinition(j) = 0 Then Continue For
            If arities(i) = arities(j) And genericArities(i) = genericArities(j) Then Continue For
            Dim leaf As String = UCase(Trim(ps.ast.nodes(declNode).value))
            For p As Integer = Len(leaf) To 1 Step -1
                If Mid(leaf, p, 1) = "." Then leaf = Mid(leaf, p + 1): Exit For
            Next p
            loweredNames(i) = "__UXB_OVERLOAD_" & LTrim(Str(arities(i))) & "_G" & LTrim(Str(genericArities(i))) & "_" & leaf
            hasOverloads = 1
            Exit For
        Next j
    Next i

    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(ps.ast.nodes(i).kind)
        If k = "CALL_STMT" Or k = "CALL_EXPR" Then
            Dim callName As String
            callName = SemScopedRoutineName(ps, i, ps.ast.nodes(i).value)

            Dim callArgc As Integer
            callArgc = SemCountCallArgs(ps, i)
            Dim callGenericArgc As Integer
            callGenericArgc = SemCountCallGenericArgs(ps, i)

            Dim seenByName As Integer
            Dim matched As Integer
            Dim matchedSlot As Integer = -1
            Dim j As Integer
            For j = 0 To sigCount - 1
                If names(j) = callName Then
                    seenByName += 1

                    If arities(j) = callArgc Then
                        If callGenericArgc = 0 Or genericArities(j) = callGenericArgc Then
                            matched += 1
                            matchedSlot = j
                        End If
                    End If
                End If
            Next j

            ' An unqualified call in a namespace can fall back to a root
            ' routine, just as ordinary namespace resolution already does.
            Dim rawCall As String = UCase(Trim(ps.ast.nodes(i).value))
            If seenByName = 0 And InStr(rawCall, ".") = 0 And rawCall <> callName Then
                For j = 0 To sigCount - 1
                    If names(j) <> rawCall Then Continue For
                    seenByName += 1
                    If arities(j) = callArgc And (callGenericArgc = 0 Or genericArities(j) = callGenericArgc) Then
                        matched += 1: matchedSlot = j
                    End If
                Next j
            End If

            If seenByName = 0 Then Continue For

            If matched = 0 Then
                errText = "semantic: no matching overload for " & callName & " with " & Str(callArgc) & " argument(s)"
                Return 0
            End If

            If matched > 1 Then
                errText = "semantic: ambiguous overload call " & callName & " with " & Str(callArgc) & " argument(s)"
                Return 0
            End If
            If matchedSlot >= 0 AndAlso loweredNames(matchedSlot) <> "" Then
                Dim previousName As String = UCase(Trim(ps.ast.nodes(i).value))
                Dim symbolName As String = UCase(Trim(ps.ast.nodes(i).symbolName))
                ps.ast.nodes(i).value = SemOverloadQualifiedName(previousName, loweredNames(matchedSlot))
                If symbolName = previousName Or symbolName = callName Then ps.ast.nodes(i).symbolName = SemOverloadQualifiedName(symbolName, loweredNames(matchedSlot))
            End If
        End If
    Next i

    If hasOverloads <> 0 Then
        For i = 0 To ps.ast.count - 1
            Dim kind As String = UCase(ps.ast.nodes(i).kind)
            If kind <> "SUB_STMT" And kind <> "FUNCTION_STMT" And kind <> "DECLARE_SUB_STMT" And kind <> "DECLARE_FUNCTION_STMT" Then Continue For
            Dim scopedName As String = SemScopedRoutineName(ps, i, ps.ast.nodes(i).value)
            Dim arity As Integer = SemCountRoutineParams(ps, i)
            Dim genericArity As Integer = SemCountRoutineGenericParams(ps, i)
            For slot As Integer = 0 To sigCount - 1
                If loweredNames(slot) = "" Or names(slot) <> scopedName Or arities(slot) <> arity Or genericArities(slot) <> genericArity Then Continue For
                Dim previousName As String = UCase(Trim(ps.ast.nodes(i).value))
                If kind = "FUNCTION_STMT" Then SemRenameOverloadResult ps, i, previousName, loweredNames(slot)
                Dim symbolName As String = UCase(Trim(ps.ast.nodes(i).symbolName))
                ps.ast.nodes(i).value = SemOverloadQualifiedName(previousName, loweredNames(slot))
                If symbolName = previousName Or symbolName = scopedName Then ps.ast.nodes(i).symbolName = SemOverloadQualifiedName(symbolName, loweredNames(slot))
                Exit For
            Next slot
        Next i
        ' Renaming does not change node count; invalidate name/type caches by
        ' the existing AST epoch rather than leaving stale declaration keys.
        gUxbAstEpoch += 1
    End If
    Return 1
End Function

Private Function SemTryEvalConstNumber(ByRef ps As ParseState, ByVal nodeIdx As Integer, ByRef valueOut As Double, ByRef isIntOut As Integer) As Integer
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Return 0

    Dim n As ASTNode
    n = ps.ast.nodes(nodeIdx)
    Dim k As String
    k = UCase(n.kind)

    If k = "NUMBER" Then
        Dim t As String
        t = Trim(n.value)
        If t = "" Then Return 0

        valueOut = Val(t)
        ' Default numeric literal kind: treat as floating point (F64) by default.
        ' This makes plain literals (e.g. 123) be considered floats unless context forces integer.
        isIntOut = 0
        Return 1
    End If

    If k = "UNARY" Then
        Dim rv As Double
        Dim ri As Integer
        Dim unaryNode As Integer
        unaryNode = n.left
        If unaryNode = -1 Then unaryNode = n.right
        If SemTryEvalConstNumber(ps, unaryNode, rv, ri) = 0 Then Return 0

        Dim opText As String
        opText = UCase(Trim(n.op))
        Select Case opText
        Case "+"
            valueOut = rv
            isIntOut = ri
            Return 1
        Case "-"
            valueOut = -rv
            isIntOut = ri
            Return 1
        Case "LNOT", "!"
            valueOut = IIf(rv = 0, -1, 0)
            isIntOut = 1
            Return 1
        Case "NOT", "BNOT", "~"
            valueOut = Not CLngInt(rv)
            isIntOut = 1
            Return 1
        End Select

        Return 0
    End If

    If k = "BINARY" Then
        Dim lv As Double
        Dim li As Integer
        Dim rv As Double
        Dim ri As Integer
        If SemTryEvalConstNumber(ps, n.left, lv, li) = 0 Then Return 0
        If SemTryEvalConstNumber(ps, n.right, rv, ri) = 0 Then Return 0

        Dim opText As String
        opText = UCase(Trim(n.op))

        Select Case opText
        Case "+"
            valueOut = lv + rv
            isIntOut = li And ri
            Return 1
        Case "-"
            valueOut = lv - rv
            isIntOut = li And ri
            Return 1
        Case "*"
            valueOut = lv * rv
            isIntOut = li And ri
            Return 1
        Case "/"
            If rv = 0 Then Return 0
            valueOut = lv / rv
            isIntOut = 0
            Return 1
        Case "**", "POW"
            valueOut = lv ^ rv
            isIntOut = 0
            Return 1
        Case "\", "%", "MOD"
            ' S-078: integer folding is 64-bit (CLng is 32-bit: `3000000000 \ 7`
            ' overflowed before it was ever divided). A divisor that truncates to 0
            ' or -1 is left to the runtime instead of risking a host trap here.
            If rv = 0 Then Return 0
            If CLngInt(rv) = 0 Or CLngInt(rv) = -1 Then Return 0
            If opText = "\" Then
                valueOut = CLngInt(lv) \ CLngInt(rv)
            Else
                valueOut = CLngInt(lv) Mod CLngInt(rv)
            End If
            isIntOut = 1
            Return 1
        Case "&"
            valueOut = CLngInt(lv) And CLngInt(rv)
            isIntOut = 1
            Return 1
        Case "|"
            valueOut = CLngInt(lv) Or CLngInt(rv)
            isIntOut = 1
            Return 1
        Case "AND"
            valueOut = CLngInt(lv) And CLngInt(rv)
            isIntOut = 1
            Return 1
        Case "OR"
            valueOut = CLngInt(lv) Or CLngInt(rv)
            isIntOut = 1
            Return 1
        Case "&&", "ANDALSO"
            valueOut = IIf((CLngInt(lv) <> 0) And (CLngInt(rv) <> 0), -1, 0)
            isIntOut = 1
            Return 1
        Case "||", "ORELSE"
            valueOut = IIf((CLngInt(lv) <> 0) Or (CLngInt(rv) <> 0), -1, 0)
            isIntOut = 1
            Return 1
        Case "XOR"
            valueOut = CLngInt(lv) Xor CLngInt(rv)
            isIntOut = 1
            Return 1
        Case "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB"
            Dim aMask As LongInt
            Dim bMask As LongInt
            aMask = CLngInt(lv)
            bMask = CLngInt(rv)
            Select Case opText
            Case "NAND": valueOut = Not (aMask And bMask)
            Case "NOR": valueOut = Not (aMask Or bMask)
            Case "XNOR": valueOut = Not (aMask Xor bMask)
            Case "IMP": valueOut = (Not aMask) Or bMask
            Case "CIMP": valueOut = aMask Or (Not bMask)
            Case "NIMP": valueOut = aMask And (Not bMask)
            Case "NCIMP": valueOut = (Not aMask) And bMask
            Case "IDA": valueOut = aMask
            Case "IDB": valueOut = bMask
            Case "NOTA": valueOut = Not aMask
            Case "NOTB": valueOut = Not bMask
            End Select
            isIntOut = 1
            Return 1
        Case "^"
            valueOut = CLngInt(lv) Xor CLngInt(rv)
            isIntOut = 1
            Return 1
        Case "<<", "SHL"
            ' S-078: 64-bit shift with the same count mask (63) as every engine.
            valueOut = CLngInt(lv) Shl CInt(CLngInt(rv) And 63)
            isIntOut = 1
            Return 1
        Case ">>", "SHR"
            valueOut = CLngInt(lv) Shr CInt(CLngInt(rv) And 63)
            isIntOut = 1
            Return 1
        Case "="
            valueOut = IIf(lv = rv, -1, 0)
            isIntOut = 1
            Return 1
        Case "=="
            valueOut = IIf(lv = rv, -1, 0)
            isIntOut = 1
            Return 1
        Case "<>"
            valueOut = IIf(lv <> rv, -1, 0)
            isIntOut = 1
            Return 1
        Case "!="
            valueOut = IIf(lv <> rv, -1, 0)
            isIntOut = 1
            Return 1
        Case "<"
            valueOut = IIf(lv < rv, -1, 0)
            isIntOut = 1
            Return 1
        Case ">"
            valueOut = IIf(lv > rv, -1, 0)
            isIntOut = 1
            Return 1
        Case "<="
            valueOut = IIf(lv <= rv, -1, 0)
            isIntOut = 1
            Return 1
        Case ">="
            valueOut = IIf(lv >= rv, -1, 0)
            isIntOut = 1
            Return 1
        End Select

        Return 0
    End If

    Return 0
End Function

Private Function SemConstNumberToText(ByVal valueIn As Double, ByVal asInt As Integer) As String
    If asInt <> 0 Then
        Return LTrim(Str(CLngInt(valueIn)))
    End If
    ' S-142b: lossless text (Str() keeps 16 digits, so `0.1 + 0.2` folded to the literal 0.3).
    Return UXBFloatToExactText(valueIn)
End Function

Private Sub SemFoldConstantsNode(ByRef ps As ParseState, ByVal nodeIdx As Integer)
    If nodeIdx < 0 Or nodeIdx >= ps.ast.count Then Exit Sub

    If ps.ast.nodes(nodeIdx).left <> -1 Then
        SemFoldConstantsNode ps, ps.ast.nodes(nodeIdx).left
    End If

    If ps.ast.nodes(nodeIdx).right <> -1 Then
        SemFoldConstantsNode ps, ps.ast.nodes(nodeIdx).right
    End If

    Dim ch As Integer
    ch = ps.ast.nodes(nodeIdx).firstChild
    Do While ch <> -1
        SemFoldConstantsNode ps, ch
        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Dim k As String
    k = UCase(ps.ast.nodes(nodeIdx).kind)
    If k = "UNARY" Then
        Dim unaryChild As Integer = ps.ast.nodes(nodeIdx).left
        If unaryChild = -1 Then unaryChild = ps.ast.nodes(nodeIdx).right
        Dim unaryOp As String = Trim(ps.ast.nodes(nodeIdx).op)
        If unaryChild >= 0 And unaryChild < ps.ast.count And (unaryOp = "-" Or unaryOp = "+") Then
            If UCase(ps.ast.nodes(unaryChild).kind) = "NUMBER" AndAlso UXBNumberLiteralIsFloat(ps.ast.nodes(unaryChild).value) = 0 Then
                ' Negating an integer literal is exact text, not a trip through
                ' Double (which rounded I64 minima and U64 values into exponents).
                Dim exactText As String = Trim(ps.ast.nodes(unaryChild).value)
                If unaryOp = "-" Then
                    If Left(exactText, 1) = "-" Then
                        exactText = Mid(exactText, 2)
                    Else
                        If Left(exactText, 1) = "+" Then exactText = Mid(exactText, 2)
                        exactText = "-" & exactText
                    End If
                End If
                ps.ast.nodes(nodeIdx).kind = "NUMBER"
                ps.ast.nodes(nodeIdx).value = exactText
                ps.ast.nodes(nodeIdx).op = ""
                ps.ast.nodes(nodeIdx).left = -1
                ps.ast.nodes(nodeIdx).right = -1
                ps.ast.nodes(nodeIdx).firstChild = -1
                Exit Sub
            End If
        End If
    End If
    If k = "BINARY" Or k = "UNARY" Then
        Dim foldedValue As Double
        Dim foldedInt As Integer
        If SemTryEvalConstNumber(ps, nodeIdx, foldedValue, foldedInt) <> 0 Then
            ps.ast.nodes(nodeIdx).kind = "NUMBER"
            ps.ast.nodes(nodeIdx).value = SemConstNumberToText(foldedValue, foldedInt)
            ps.ast.nodes(nodeIdx).op = ""
            ps.ast.nodes(nodeIdx).left = -1
            ps.ast.nodes(nodeIdx).right = -1
            ps.ast.nodes(nodeIdx).firstChild = -1
        End If
    End If
End Sub

Private Function SemFoldConstants(ByRef ps As ParseState, ByRef errText As String) As Integer
    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then
        errText = "semantic: invalid AST root for constant folding"
        Return 0
    End If

    SemFoldConstantsNode ps, ps.rootNode
    Return 1
End Function

Private Function SemIsHardTerminatorKind(ByRef kindRaw As String) As Integer
    Dim k As String
    k = UCase(Trim(kindRaw))
    Return IIf(k = "RETURN_STMT" Or k = "THROW_STMT" Or k = "END_STMT", 1, 0)
End Function

' S-568: dizi bildiriminde skaler baslangic degeri (`DIM a(2) AS I32 = 7`) sessizce yok sayiliyordu (AST, MIR, MIR-x64, JS);
' eski AST-x64 yalniz ilk elemani dolduruyor, WASM calisma aninda dusuyordu. Karar (varsayilan, docs/tasarim S-551 tasarimi V8):
' dizi bildirimindeki `= deger` ACIK RETTIR; diziyi bildirin ve elemanlara atayin.
Private Function SemValidateArrayScalarInitializers(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim arrDeclIdx As Integer
    Dim arrDeclChild As Integer
    Dim arrHasBounds As Integer
    Dim arrHasInit As Integer
    For arrDeclIdx = 0 To ps.ast.count - 1
        If UCase(ps.ast.nodes(arrDeclIdx).kind) <> "DIM_DECL" Then Continue For
        arrHasBounds = 0
        arrHasInit = 0
        arrDeclChild = ps.ast.nodes(arrDeclIdx).firstChild
        Do While arrDeclChild <> -1
            Select Case UCase(ps.ast.nodes(arrDeclChild).kind)
            Case "DIM_BOUNDS": arrHasBounds = 1
            Case "INIT_EXPR": arrHasInit = 1
            End Select
            arrDeclChild = ps.ast.nodes(arrDeclChild).nextSibling
        Loop
        If arrHasBounds <> 0 And arrHasInit <> 0 Then
            errText = "semantic: UXB_ARRAY_SCALAR_INITIALIZER: array " & ps.ast.nodes(arrDeclIdx).value & " cannot take a scalar initial value in its DIM; declare the array and assign its elements [line " & LTrim(Str(ps.ast.nodes(arrDeclIdx).lineNo)) & "]"
            Return 0
        End If
    Next arrDeclIdx
    Return 1
End Function

' S-567: programda kendisine GOTO / GOSUB ile atlayan bir deyim olan etiket, RETURN / THROW / END'ten sonra bile
' erisilebilirdir; erisilemez-kod denetimi etiketi atlama hedefi saymiyor ve gecerli `GOTO Son` ... `RETURN 1` ... `Son:`
' ... `RETURN 2` programlarini reddediyordu.
Private Function SemLabelIsJumpTarget(ByRef ps As ParseState, ByRef labelName As String) As Integer
    Dim wantLabel As String = UCase(Trim(labelName))
    If wantLabel = "" Then Return 0
    Dim jumpScan As Integer
    Dim jumpKind As String
    For jumpScan = 0 To ps.ast.count - 1
        jumpKind = UCase(ps.ast.nodes(jumpScan).kind)
        If jumpKind = "GOTO_STMT" Or jumpKind = "GOSUB_STMT" Then
            If UCase(Trim(ps.ast.nodes(jumpScan).value)) = wantLabel Then Return 1
        End If
    Next jumpScan
    Return 0
End Function

Private Function SemValidateReachabilityList(ByRef ps As ParseState, ByVal firstNode As Integer, ByRef errText As String) As Integer
    Dim terminated As Integer
    Dim termKind As String
    Dim ch As Integer

    ch = firstNode
    Do While ch <> -1
        Dim k As String
        k = UCase(ps.ast.nodes(ch).kind)

        If terminated <> 0 And k = "LABEL_STMT" Then
            If SemLabelIsJumpTarget(ps, ps.ast.nodes(ch).value) <> 0 Then terminated = 0
        End If

        If terminated <> 0 Then
            errText = "semantic: unreachable statement after " & termKind
            Return 0
        End If

        If SemIsHardTerminatorKind(k) <> 0 Then
            terminated = 1
            termKind = k
        End If

        ch = ps.ast.nodes(ch).nextSibling
    Loop

    Return 1
End Function

Private Function SemValidateReachability(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(ps.ast.nodes(i).kind)

        If k = "SUB_STMT" Or k = "FUNCTION_STMT" Then
            Dim ch As Integer
            ch = ps.ast.nodes(i).firstChild
            Do While ch <> -1
                Dim ck As String
                ck = UCase(ps.ast.nodes(ch).kind)
                If ck <> "PARAM_DECL" And ck <> "RETURN_TYPE" Then Exit Do
                ch = ps.ast.nodes(ch).nextSibling
            Loop

            If ch <> -1 Then
                If SemValidateReachabilityList(ps, ch, errText) = 0 Then Return 0
            End If
        ElseIf k = "TRY_BODY" Or k = "CATCH_PART" Or k = "FINALLY_PART" Or k = "ELSE_PART" Or k = "EACH_BODY" Then
            Dim firstBody As Integer
            firstBody = ps.ast.nodes(i).firstChild
            If firstBody <> -1 Then
                If SemValidateReachabilityList(ps, firstBody, errText) = 0 Then Return 0
            End If
        ElseIf k = "IF_STMT" Or k = "ELSEIF_PART" Then
            Dim bodyStart As Integer
            bodyStart = ps.ast.nodes(i).firstChild
            If bodyStart <> -1 Then bodyStart = ps.ast.nodes(bodyStart).nextSibling

            Dim terminated As Integer
            Dim termKind As String
            Dim st As Integer
            st = bodyStart
            Do While st <> -1
                Dim sk As String
                sk = UCase(ps.ast.nodes(st).kind)
                If sk = "ELSEIF_PART" Or sk = "ELSE_PART" Then Exit Do

                If terminated <> 0 And sk = "LABEL_STMT" Then
                    If SemLabelIsJumpTarget(ps, ps.ast.nodes(st).value) <> 0 Then terminated = 0   ' S-567
                End If

                If terminated <> 0 Then
                    errText = "semantic: unreachable statement after " & termKind
                    Return 0
                End If

                If SemIsHardTerminatorKind(sk) <> 0 Then
                    terminated = 1
                    termKind = sk
                End If

                st = ps.ast.nodes(st).nextSibling
            Loop
        End If
    Next i

    Return 1
End Function

' S-081: VARPTR(a(i)) = the address of element i = VARPTR(a) + (i - LBOUND) * stride.
' Rewriting the AST here (rather than teaching six engines a new address form) means
' the interpreters, native x64, the legacy backend, JS and WASM all see ordinary
' pointer arithmetic that already works (S-071: PTR + integer = PTR, byte-based).
' The bound and the element cell (stride, from the shared type ABI) are compile-time
' facts of the DIM; a multi-dimensional or dynamically bounded array is refused.
Private Function SemRewriteVarptrElementNodes(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim originalCount As Integer
    originalCount = ps.ast.count
    Dim i As Integer
    For i = 0 To originalCount - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "CALL_EXPR" Then Continue For
        If UCase(Trim(ps.ast.nodes(i).value)) <> "VARPTR" Then Continue For
        ' The parser only validates VARPTR in some statement shapes (`p = VARPTR(..)`);
        ' inside PRINT/IF/argument expressions the call arrived unchecked. Validate every
        ' occurrence here, where each CALL_EXPR node is visible whatever its context.
        Dim elemNode As Integer
        elemNode = ps.ast.nodes(i).firstChild
        If elemNode = -1 Or ps.ast.nodes(elemNode).nextSibling <> -1 Then
            errText = "semantic: VARPTR expects exactly 1 argument"
            Return 0
        End If
        Dim elemKind As String
        elemKind = UCase(Trim(ps.ast.nodes(elemNode).kind))
        If elemKind = "IDENT" Then Continue For
        If elemKind <> "CALL_EXPR" Then
            errText = "semantic: VARPTR expects an identifier or an array element argument"
            Return 0
        End If

        Dim arrayName As String
        arrayName = Trim(ps.ast.nodes(elemNode).value)
        If arrayName = "" Or InStr(arrayName, ".") > 0 Then Continue For

        Dim indexNode As Integer
        indexNode = ps.ast.nodes(elemNode).firstChild
        If indexNode = -1 Or ps.ast.nodes(indexNode).nextSibling <> -1 Then
            errText = "semantic: VARPTR(" & arrayName & "(...)) supports exactly one index"
            Return 0
        End If

        Dim arrInfo As UXBArrayMemoryInfo
        Dim arrErr As String
        If UXBFindArrayMemoryInfo(ps, arrayName, arrInfo, arrErr) = 0 Then
            errText = "semantic: VARPTR(" & arrayName & "(...)): " & arrErr
            Return 0
        End If
        If arrInfo.found = 0 Then
            errText = "semantic: VARPTR(" & arrayName & "(...)): " & arrayName & " is not a declared array"
            Return 0
        End If
        If arrInfo.dynamicBounds <> 0 Then
            errText = "semantic: VARPTR(" & arrayName & "(...)) requires compile-time array bounds"
            Return 0
        End If

        Dim ln As Integer
        Dim cn As Integer
        ln = ps.ast.nodes(i).lineNo
        cn = ps.ast.nodes(i).colNo

        ' base = VARPTR(array). The old `array(index)` node is reused as the IDENT so
        ' no orphan CALL_EXPR is left behind for the passes that walk every node.
        Dim baseCall As Integer
        baseCall = ASTNewNode(ps.ast, "CALL_EXPR", "VARPTR", "", ln, cn)
        ps.ast.nodes(elemNode).kind = "IDENT"
        ps.ast.nodes(elemNode).family = AST_FAMILY_EXPR
        ps.ast.nodes(elemNode).firstChild = -1
        ps.ast.nodes(elemNode).nextSibling = -1
        ps.ast.nodes(indexNode).parent = -1
        ASTAddChild ps.ast, baseCall, elemNode

        ' relative index = index - LBOUND (omitted when LBOUND = 0)
        Dim relIndex As Integer
        relIndex = indexNode
        If arrInfo.lowerBound <> 0 Then
            Dim lowerNum As Integer
            lowerNum = ASTNewNode(ps.ast, "NUMBER", LTrim(Str(arrInfo.lowerBound)), "", ln, cn)
            relIndex = ASTNewNode(ps.ast, "BINARY", "", "-", ln, cn)
            ASTSetLeft ps.ast, relIndex, indexNode
            ASTSetRight ps.ast, relIndex, lowerNum
        End If

        ' byte offset = relative index * stride
        Dim strideNum As Integer
        Dim offsetNode As Integer
        strideNum = ASTNewNode(ps.ast, "NUMBER", LTrim(Str(arrInfo.elementBytes)), "", ln, cn)
        offsetNode = ASTNewNode(ps.ast, "BINARY", "", "*", ln, cn)
        ASTSetLeft ps.ast, offsetNode, relIndex
        ASTSetRight ps.ast, offsetNode, strideNum

        ' the VARPTR call node itself becomes `base + offset`
        ps.ast.nodes(i).kind = "BINARY"
        ps.ast.nodes(i).value = ""
        ps.ast.nodes(i).op = "+"
        ps.ast.nodes(i).firstChild = -1
        ASTSetLeft ps.ast, i, baseCall
        ASTSetRight ps.ast, i, offsetNode
    Next i
    Return 1
End Function

' S-651: birim ozellikli TIMER bicimleri yalniz AST'de calisiyordu (MIR argumanlari yok sayiyor, native ve eski AST-x64
' cop deger veriyordu). Tanim: TIMER("birim") = TIMER * olcek; TIMER(baslangic, bitis, "birim") = (bitis - baslangic) * olcek.
' Birimler: ns us ms s min h day year (buyuk/kucuk harf farksiz, yalniz metin sabiti). Yeniden yazim ON UCTA yapildigi icin
' altı yolun hepsi ayni sade F64 aritmetigini gorur (VARPTR(a(i)) yeniden yazimiyla ayni yontem).
Private Function SemTimerUnitScale(ByRef unitText As String, ByRef opOut As String, ByRef scaleOut As String) As Integer
    Select Case LCase(Trim(unitText))
    Case "ns": opOut = "*": scaleOut = "1000000000.0"
    Case "us": opOut = "*": scaleOut = "1000000.0"
    Case "ms": opOut = "*": scaleOut = "1000.0"
    Case "s": opOut = "*": scaleOut = "1.0"
    Case "min": opOut = "/": scaleOut = "60.0"
    Case "h": opOut = "/": scaleOut = "3600.0"
    Case "day": opOut = "/": scaleOut = "86400.0"
    Case "year": opOut = "/": scaleOut = "31536000.0"
    Case Else: Return 0
    End Select
    Return 1
End Function

Private Function SemRewriteTimerUnitCalls(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim originalCount As Integer
    originalCount = ps.ast.count
    Dim argIds(0 To 3) As Integer
    Dim i As Integer
    For i = 0 To originalCount - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "CALL_EXPR" Then Continue For
        If UCase(Trim(ps.ast.nodes(i).value)) <> "TIMER" Then Continue For

        Dim argCount As Integer = 0
        Dim ch As Integer = ps.ast.nodes(i).firstChild
        Do While ch <> -1
            If argCount <= UBound(argIds) Then argIds(argCount) = ch
            argCount += 1
            ch = ps.ast.nodes(ch).nextSibling
        Loop
        If argCount = 0 Then Continue For

        Dim unitNode As Integer = -1
        If argCount = 1 Then unitNode = argIds(0)
        If argCount = 3 Then unitNode = argIds(2)
        If unitNode = -1 Then
            errText = "semantic: TIMER expects no argument, TIMER(""unit"") or TIMER(start, end, ""unit"")"
            Return 0
        End If
        If UCase(Trim(ps.ast.nodes(unitNode).kind)) <> "STRING" Then
            errText = "semantic: TIMER unit must be a string literal (ns, us, ms, s, min, h, day, year)"
            Return 0
        End If
        Dim opText As String
        Dim scaleText As String
        If SemTimerUnitScale(ps.ast.nodes(unitNode).value, opText, scaleText) = 0 Then
            errText = "semantic: invalid TIMER unit """ & ps.ast.nodes(unitNode).value & """ (ns, us, ms, s, min, h, day, year)"
            Return 0
        End If

        Dim ln As Integer = ps.ast.nodes(i).lineNo
        Dim cn As Integer = ps.ast.nodes(i).colNo
        ' birim dugumu olcek sabitine donusur (artik bir metin dugumu kalmaz)
        ps.ast.nodes(unitNode).kind = "NUMBER"
        ps.ast.nodes(unitNode).value = scaleText
        ps.ast.nodes(unitNode).op = ""
        ps.ast.nodes(unitNode).nextSibling = -1
        ps.ast.nodes(unitNode).parent = -1

        Dim leftExpr As Integer
        If argCount = 1 Then
            leftExpr = ASTNewNode(ps.ast, "CALL_EXPR", "TIMER", "", ln, cn)
        Else
            Dim startNode As Integer = argIds(0)
            Dim endNode As Integer = argIds(1)
            ps.ast.nodes(startNode).nextSibling = -1
            ps.ast.nodes(startNode).parent = -1
            ps.ast.nodes(endNode).nextSibling = -1
            ps.ast.nodes(endNode).parent = -1
            leftExpr = ASTNewNode(ps.ast, "BINARY", "", "-", ln, cn)
            ASTSetLeft ps.ast, leftExpr, endNode
            ASTSetRight ps.ast, leftExpr, startNode
        End If

        ' TIMER cagri dugumu kendisi `sol <islec> olcek` olur
        ps.ast.nodes(i).kind = "BINARY"
        ps.ast.nodes(i).value = ""
        ps.ast.nodes(i).op = opText
        ps.ast.nodes(i).firstChild = -1
        ASTSetLeft ps.ast, i, leftExpr
        ASTSetRight ps.ast, i, unitNode
    Next i
    Return 1
End Function

' S-537: bir RETURN yalniz bir yordamin (FUNCTION, SUB, yontem, kurucu, yikici, ozellik, THREAD/PIPE/EVENT/PARALEL govdesi)
' icinde yordamdan/gorevden doner ya da programin ust duzeyinde bir GOSUB'tan doner. Programda HIC GOSUB yokken yordam
' disindaki RETURN bir hatadir (eskiden AST "RETURN used without GOSUB (9301)" ile duruyor, MIR, native, JS ve WASM sessizce
' bitiyordu). GOSUB varsa RETURN'un o anda bir GOSUB'tan gelip gelmedigi ancak calisma aninda bilinir ve motorlar ayni
' hatayi verir (AST "exec:", MIR "MIR:", native/JS/WASM kendi calisma ani).
Private Function SemValidateStrayReturns(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    ' S-710: a routine exit must never become a top-level GOSUB return,
    ' and EXIT SUB must not silently exit a FUNCTION/task body.
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "RETURN_STMT" Then Continue For
        Dim exitMode As String = UCase(Trim(ps.ast.nodes(i).op))
        Dim owner As Integer = UXBTaskEnclosingRoutine(ps, i)
        If exitMode = "SUB" Or exitMode = "FUNCTION" Then
            If owner < 0 Then
                errText = "semantic: EXIT " & exitMode & " requires a matching routine body"
                Return 0
            End If
            If UCase(Trim(ps.ast.nodes(owner).kind)) <> exitMode & "_STMT" Then
                errText = "semantic: EXIT " & exitMode & " requires a matching routine body"
                Return 0
            End If
        End If
        ' S-712: a valueless FUNCTION return reads its typed result variable,
        ' just like fallthrough. Lower through the ordinary expression return
        ' path so FINALLY snapshots and managed ownership cannot diverge.
        If owner >= 0 AndAlso UCase(Trim(ps.ast.nodes(owner).kind)) = "FUNCTION_STMT" Then
            If ps.ast.nodes(i).firstChild = -1 Then
                Dim resultName As String = ps.ast.nodes(owner).value
                Dim resultExpr As Integer = ASTNewNode(ps.ast, "IDENT", resultName, "", ps.ast.nodes(i).lineNo, ps.ast.nodes(i).colNo)
                ' The implicit result need not have an assignment declaration.
                ' Carry RETURN_TYPE, never the owner's SYM_FUNCTION tag.
                Dim resultType As String = "I64"
                Dim resultTypeNode As Integer = ps.ast.nodes(owner).firstChild
                Do While resultTypeNode >= 0
                    If UCase(Trim(ps.ast.nodes(resultTypeNode).kind)) = "RETURN_TYPE" Then
                        resultType = ps.ast.nodes(resultTypeNode).value
                        Exit Do
                    End If
                    resultTypeNode = ps.ast.nodes(resultTypeNode).nextSibling
                Loop
                ps.ast.nodes(resultExpr).typeName = resultType
                ASTAddChild ps.ast, i, resultExpr
                If exitMode = "" Then ps.ast.nodes(i).op = "BARE_FUNCTION_RETURN"
            End If
        End If
    Next i
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) = "GOSUB_STMT" Then Return 1
    Next i
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "RETURN_STMT" Then Continue For
        If UXBTaskEnclosingRoutine(ps, i) <> -1 Then Continue For
        errText = "semantic: RETURN used without GOSUB (9301): RETURN outside any SUB, FUNCTION or task body, and the program has no GOSUB [line " & LTrim(Str(ps.ast.nodes(i).lineNo)) & "]"
        Return 0
    Next i
    Return 1
End Function

' S-068: how a NAME is declared anywhere in the program: as an array (DIM/REDIM with
' bounds, or an `arr AS T[]` parameter) and/or as a scalar. Name-based on purpose: a
' CALL node inside a PRINT item has no parent link (see Step3ContainingRoutineHasFormalParam),
' so lexical scope is not available here -- callers therefore only act on the
' unambiguous cases (declared as an array and never as a scalar, or the reverse).
Private Sub SemClassifyArrayName(ByRef ps As ParseState, ByRef nameText As String, ByRef arrayElemType As String, ByRef sawArray As Integer, ByRef sawScalar As Integer)
    arrayElemType = ""
    sawArray = 0
    sawScalar = 0
    Dim target As String
    target = UCase(Trim(nameText))
    If target = "" Then Exit Sub
    ' TUR4/S-111: reuse the declaration-name index and its AST-order
    ' contract; fall back to the original scan if it is unavailable.
    Dim useIndex As Integer = UXBAstNameIndexEnsure(ps)
    Dim entry As Integer = -1
    If useIndex <> 0 Then entry = UXBAstNameIndexFirst(0, target)
    Dim i As Integer = 0
    Do
        Dim d As Integer
        If useIndex <> 0 Then
            If entry = -1 Then Exit Do
            d = UXBAstNameIndexNode(entry)
            entry = UXBAstNameIndexNext(entry)
        Else
            If i >= ps.ast.count Then Exit Do
            d = i
            i += 1
        End If
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(d).kind))
        If k <> "DIM_DECL" And k <> "REDIM_DECL" And k <> "PARAM_DECL" Then Continue Do
        If UCase(Trim(ps.ast.nodes(d).value)) <> target Then Continue Do
        Dim typeText As String
        Dim hasBounds As Integer
        typeText = ""
        hasBounds = 0
        Dim ch As Integer
        ch = ps.ast.nodes(d).firstChild
        Do While ch <> -1
            Dim ck As String
            ck = UCase(Trim(ps.ast.nodes(ch).kind))
            If ck = "TYPE_REF" And typeText = "" Then typeText = UCase(Trim(ps.ast.nodes(ch).value))
            If ck = "DIM_BOUNDS" Then hasBounds = 1
            ch = ps.ast.nodes(ch).nextSibling
        Loop
        If Right(typeText, 2) = "[]" Then
            If sawArray = 0 Then arrayElemType = Left(typeText, Len(typeText) - 2)
            sawArray = 1
        ElseIf hasBounds <> 0 Then
            If sawArray = 0 Then arrayElemType = typeText
            sawArray = 1
        Else
            sawScalar = 1
        End If
    Loop
End Sub

' S-068: an `arr AS T[]` parameter must receive an array of element type T, and an
' array must not be passed for a scalar parameter. Before this only the AST interpreter
' checked the first at run time; MIR reported "array index not available", and passing
' an F64 array for I32[] or an array for a scalar parameter silently produced 0.
Private Function SemValidateArrayArguments(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(i).kind))
        If k <> "CALL_EXPR" And k <> "CALL_STMT" Then Continue For
        Dim calleeName As String
        calleeName = UCase(Trim(ps.ast.nodes(i).value))
        If calleeName = "" Or InStr(calleeName, ".") > 0 Then Continue For

        Dim routineNode As Integer
        routineNode = -1
        Dim r As Integer
        For r = 0 To ps.ast.count - 1
            Dim rk As String
            rk = UCase(Trim(ps.ast.nodes(r).kind))
            If rk = "FUNCTION_STMT" Or rk = "SUB_STMT" Then
                If UCase(Trim(ps.ast.nodes(r).value)) = calleeName Then
                    routineNode = r
                    Exit For
                End If
            End If
        Next r
        If routineNode = -1 Then Continue For

        Dim paramNode As Integer
        Dim argNode As Integer
        Dim argPos As Integer
        paramNode = ps.ast.nodes(routineNode).firstChild
        argNode = ps.ast.nodes(i).firstChild
        argPos = 0
        Do While paramNode <> -1 And argNode <> -1
            If UCase(Trim(ps.ast.nodes(paramNode).kind)) <> "PARAM_DECL" Then Exit Do
            argPos += 1

            Dim paramType As String
            paramType = ""
            Dim pc As Integer
            pc = ps.ast.nodes(paramNode).firstChild
            Do While pc <> -1
                If UCase(Trim(ps.ast.nodes(pc).kind)) = "TYPE_REF" Then
                    paramType = UCase(Trim(ps.ast.nodes(pc).value))
                    Exit Do
                End If
                pc = ps.ast.nodes(pc).nextSibling
            Loop

            Dim argKind As String
            argKind = UCase(Trim(ps.ast.nodes(argNode).kind))
            Dim argName As String
            argName = Trim(ps.ast.nodes(argNode).value)
            Dim sawArray As Integer
            Dim sawScalar As Integer
            Dim argElemType As String

            If Right(paramType, 2) = "[]" Then
                Dim wantElem As String
                wantElem = UXBStep3TypeCanonical(Left(paramType, Len(paramType) - 2))
                If argKind <> "IDENT" And argKind <> "IDENTIFIER" Then
                    errText = "semantic: " & calleeName & " argument " & LTrim(Str(argPos)) & ": array parameter " & Trim(ps.ast.nodes(paramNode).value) & " needs an array variable"
                    Return 0
                End If
                SemClassifyArrayName ps, argName, argElemType, sawArray, sawScalar
                If sawArray = 0 Then
                    errText = "semantic: " & calleeName & " argument " & LTrim(Str(argPos)) & ": " & argName & " is not an array (parameter " & Trim(ps.ast.nodes(paramNode).value) & " is " & paramType & ")"
                    Return 0
                End If
                If UXBStep3TypeCanonical(argElemType) <> wantElem Then
                    errText = "semantic: " & calleeName & " argument " & LTrim(Str(argPos)) & ": array " & argName & " has element type " & argElemType & ", parameter " & Trim(ps.ast.nodes(paramNode).value) & " needs " & Left(paramType, Len(paramType) - 2)
                    Return 0
                End If
            ElseIf paramType <> "" And (argKind = "IDENT" Or argKind = "IDENTIFIER") Then
                SemClassifyArrayName ps, argName, argElemType, sawArray, sawScalar
                If sawArray <> 0 And sawScalar = 0 Then
                    errText = "semantic: " & calleeName & " argument " & LTrim(Str(argPos)) & ": array " & argName & " cannot be passed to non-array parameter " & Trim(ps.ast.nodes(paramNode).value) & " (" & paramType & ")"
                    Return 0
                End If
            End If

            paramNode = ps.ast.nodes(paramNode).nextSibling
            argNode = ps.ast.nodes(argNode).nextSibling
        Loop
    Next i
    Return 1
End Function

' S-101 (Mete decision 2026-09-20): LBOUND(array [, dimension]) / UBOUND(array [, dimension]).
' One rule for every engine: the first argument names an array (DIM/REDIM with bounds, or an
' `arr AS T[]` parameter), the optional dimension is an integer LITERAL >= 1 (counted from 1)
' that must exist in the array's declaration.
Private Function SemValidateArrayBoundsCalls(ByRef ps As ParseState, ByRef errText As String) As Integer
    ' TUR4/S-111: determine routine presence once, not once per call.
    ' S-288's routine-name policy and existing namespace lookup remain
    ' unchanged by this performance patch.
    Dim hasUserLBound As Integer = 0, hasUserUBound As Integer = 0
    Dim r As Integer
    For r = 0 To ps.ast.count - 1
        Dim rk As String = UCase(Trim(ps.ast.nodes(r).kind))
        If rk <> "FUNCTION_STMT" And rk <> "SUB_STMT" Then Continue For
        Dim rn As String = UCase(Trim(ps.ast.nodes(r).value))
        If rn = "LBOUND" Then hasUserLBound = 1
        If rn = "UBOUND" Then hasUserUBound = 1
        If hasUserLBound <> 0 And hasUserUBound <> 0 Then Exit For
    Next r
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "CALL_EXPR" Then Continue For
        Dim calleeName As String
        calleeName = UCase(Trim(ps.ast.nodes(i).value))
        If calleeName <> "LBOUND" And calleeName <> "UBOUND" Then Continue For

        If (calleeName = "LBOUND" And hasUserLBound <> 0) Or _
           (calleeName = "UBOUND" And hasUserUBound <> 0) Then Continue For

        Dim argCount As Integer
        argCount = 0
        Dim ch As Integer
        ch = ps.ast.nodes(i).firstChild
        Do While ch <> -1
            argCount += 1
            ch = ps.ast.nodes(ch).nextSibling
        Loop
        If argCount < 1 Or argCount > 2 Then
            errText = "semantic: " & calleeName & " expects (array [, dimension])"
            Return 0
        End If

        Dim arrayNode As Integer
        arrayNode = ps.ast.nodes(i).firstChild
        Dim arrayKind As String
        arrayKind = UCase(Trim(ps.ast.nodes(arrayNode).kind))
        If arrayKind <> "IDENT" And arrayKind <> "IDENTIFIER" And arrayKind <> "KEYWORD_REF" Then
            errText = "semantic: " & calleeName & " needs an array variable as its first argument"
            Return 0
        End If
        Dim arrayName As String
        arrayName = Trim(ps.ast.nodes(arrayNode).value)
        Dim elemType As String
        Dim sawArray As Integer
        Dim sawScalar As Integer
        SemClassifyArrayName ps, arrayName, elemType, sawArray, sawScalar
        If sawArray = 0 Then
            errText = "semantic: " & calleeName & ": " & arrayName & " is not an array"
            Return 0
        End If

        If argCount = 2 Then
            Dim dimNode As Integer
            dimNode = ps.ast.nodes(arrayNode).nextSibling
            If UCase(Trim(ps.ast.nodes(dimNode).kind)) <> "NUMBER" Then
                errText = "semantic: " & calleeName & " dimension must be an integer literal"
                Return 0
            End If
            Dim dimNo As Integer
            If UXBArrayDimensionLiteral(ps.ast.nodes(dimNode).value, dimNo) = 0 Then
                errText = "semantic: " & calleeName & " dimension must be a positive integer literal in range 1..2147483647"
                Return 0
            End If
            ' how many dimensions does the array have? (a `T[]` parameter has one)
            Dim dimCount As Integer
            dimCount = 1
            ' TUR9/S-111: reuse the same declaration index and AST order;
            ' never allocate a second name table for dimension counting.
            Dim dimUseIndex As Integer = UXBAstNameIndexEnsure(ps)
            Dim dimEntry As Integer = -1
            Dim dimName As String = UCase(Trim(arrayName))
            If dimUseIndex <> 0 Then dimEntry = UXBAstNameIndexFirst(0, dimName)
            Dim dimScan As Integer = 0
            Do
                Dim d As Integer
                If dimUseIndex <> 0 Then
                    If dimEntry = -1 Then Exit Do
                    d = UXBAstNameIndexNode(dimEntry)
                    dimEntry = UXBAstNameIndexNext(dimEntry)
                Else
                    If dimScan >= ps.ast.count Then Exit Do
                    d = dimScan
                    dimScan += 1
                End If
                Dim dk As String
                dk = UCase(Trim(ps.ast.nodes(d).kind))
                If dk <> "DIM_DECL" And dk <> "REDIM_DECL" Then Continue Do
                If UCase(Trim(ps.ast.nodes(d).value)) <> dimName Then Continue Do
                Dim bch As Integer
                bch = ps.ast.nodes(d).firstChild
                Do While bch <> -1
                    If UCase(Trim(ps.ast.nodes(bch).kind)) = "DIM_BOUNDS" Then
                        Dim bc As Integer
                        bc = 0
                        Dim bx As Integer
                        bx = ps.ast.nodes(bch).firstChild
                        Do While bx <> -1
                            bc += 1
                            bx = ps.ast.nodes(bx).nextSibling
                        Loop
                        If bc > dimCount Then dimCount = bc
                    End If
                    bch = ps.ast.nodes(bch).nextSibling
                Loop
            Loop
            If dimNo > dimCount Then
                errText = "semantic: " & calleeName & " dimension " & LTrim(Str(dimNo)) & " is out of range: array " & arrayName & " has " & LTrim(Str(dimCount)) & " dimension(s)"
                Return 0
            End If
        End If
    Next i
    Return 1
End Function

' S-107 (Mete decision 2026-09-20): `FOR EACH x IN 10, 20, 30` (a list of scalar VALUES) stays, but a
' comma list that names an array or a LIST/DICT/SET/CLASS variable (`FOR EACH v IN a, b`) is a compile
' error: each of them used to be taken as one "value" (AST printed 0|0, canonical-MIR the array
' handles ARRAY#0|ARRAY#1 - both silently wrong). Combining sources is left to future CHAIN/ZIP
' library iterators; one source at a time is iterated as itself (`FOR EACH v IN a`).
Private Function SemValidateEachSources(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(i).kind))
        If k <> "FOR_EACH_STMT" And k <> "DO_EACH_STMT" Then Continue For
        Dim itemsNode As Integer
        itemsNode = ps.ast.nodes(i).firstChild
        If itemsNode = -1 Then Continue For

        Dim itemCount As Integer
        itemCount = 0
        Dim ch As Integer
        ch = ps.ast.nodes(itemsNode).firstChild
        Do While ch <> -1
            itemCount += 1
            ch = ps.ast.nodes(ch).nextSibling
        Loop
        If itemCount < 2 Then Continue For

        ch = ps.ast.nodes(itemsNode).firstChild
        Do While ch <> -1
            Dim ik As String
            ik = UCase(Trim(ps.ast.nodes(ch).kind))
            If ik = "IDENT" Or ik = "IDENTIFIER" Or ik = "VAR" Or ik = "VAR_REF" Then
                Dim srcName As String
                srcName = Trim(ps.ast.nodes(ch).value)
                Dim elemType As String
                Dim sawArray As Integer
                Dim sawScalar As Integer
                SemClassifyArrayName ps, srcName, elemType, sawArray, sawScalar
                Dim declType As String
                declType = ""
                UXBFindDeclaredTypeForMemoryOperand ps, srcName, declType
                declType = UCase(Trim(declType))
                Dim what As String
                what = ""
                If sawArray <> 0 And sawScalar = 0 Then
                    what = "array"
                ElseIf declType = "LIST" Or declType = "DICT" Or declType = "SET" Then
                    what = declType
                End If
                If what <> "" Then
                    errText = "semantic: " & IIf(k = "FOR_EACH_STMT", "FOR EACH", "DO EACH") & ": " & srcName & " is a " & what & "; a comma-separated EACH list holds scalar values only (iterate one source at a time: `" & IIf(k = "FOR_EACH_STMT", "FOR EACH", "DO EACH") & " v IN " & srcName & "`)"
                    Return 0
                End If
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
    Next i
    Return 1
End Function

' S-030: `SPAWN Worker(...)`'in hedefi, adiyla cagrilan (dogrudan bir CALL_EXPR,
' nokta/metot cagrisi DEGIL) bir THREAD veya PARALEL gorevi olmali. Calisma
' zamani (exec_task_handle.fbs::ExecRunSpawnExpr) bunu zaten kendi basina
' guvenle reddediyor, ama derleme zamaninda net bir hata daha iyi bir
' deneyimdir -- ayni satirda kalan diger tum yanlislar (BYREF parametre,
' dizi parametre) zaten AYRI, onceden var olan denetimlerden geciyor
' (THREAD/PARALEL govde derleme kapisinin kendisi).
Private Function SemFindTaskDeclNodeByName(ByRef ps As ParseState, ByRef nameRaw As String, ByRef kindOut As String) As Integer
    Dim wanted As String
    wanted = UCase(Trim(nameRaw))
    kindOut = ""
    If wanted = "" Then Return -1

    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(i).kind))
        Select Case k
        Case "EVENT_STMT", "THREAD_STMT", "PARALEL_STMT", "PIPE_STMT", "FUNCTION_STMT", "SUB_STMT"
            Dim v As String
            v = UCase(Trim(ps.ast.nodes(i).value))
            Dim q As String
            q = UCase(Trim(ps.ast.nodes(i).symbolName))
            If v = wanted Or q = wanted Then
                kindOut = k
                Return i
            End If
        End Select
    Next i
    Return -1
End Function

Private Function SemValidateSpawnCalls(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "SPAWN_EXPR" Then Continue For

        Dim callExprIdx As Integer
        callExprIdx = ps.ast.nodes(i).left
        If callExprIdx = -1 Or UCase(Trim(ps.ast.nodes(callExprIdx).kind)) <> "CALL_EXPR" Then
            errText = "semantic: SPAWN: gorev cagrisi bekleniyor, ornek: SPAWN Worker(x)"
            Return 0
        End If
        If ps.ast.nodes(callExprIdx).left <> -1 Then
            errText = "semantic: SPAWN: hedef adlandirilmis bir THREAD/PARALEL gorevi olmali; metot/nokta cagrisi olamaz"
            Return 0
        End If

        Dim taskName As String
        taskName = Trim(ps.ast.nodes(callExprIdx).value)
        Dim declKind As String
        Dim declNode As Integer
        declNode = SemFindTaskDeclNodeByName(ps, taskName, declKind)
        If declNode = -1 Then
            errText = "semantic: SPAWN: hedef bulunamadi: " & taskName
            Return 0
        End If
        If declKind <> "THREAD_STMT" And declKind <> "PARALEL_STMT" Then
            errText = "semantic: SPAWN: hedef THREAD veya PARALEL gorevi olmali (EVENT/PIPE/FUNCTION/SUB zaten senkron -- SPAWN gerektirmez): " & taskName
            Return 0
        End If
    Next i
    Return 1
End Function

' S-149 (Mete, 2026-09-25): `TASK OF <tip>` uyumu. Tipli bir gorev tutamacina
' yalniz ayni sonuc tipini tasiyan bir TASK kaynagi baglanabilir: dogrudan
' `SPAWN Hedef(...)` (hedef THREAD/PARALEL `AS <tip>` bildirmeli), ayni tipte
' TASK OF degisken/dizi elemani/parametre, ya da `AS TASK OF <tip>` donduren
' FUNCTION. Tipsiz TASK -> TASK OF atamasi reddedilir (sonuc tipi dogrulanamaz);
' TASK OF -> tipsiz TASK serbesttir. Kapsam: DIM ilk degeri, atama (dizi elemani
' ve BASIC tarzi `FonksiyonAdi = ...` dahil), RETURN, kullanici SUB/FUNCTION
' cagri argumanlari. Kural (ifade -> sonuc tipi) type_infer_expr.fbs'teki
' UXBTaskExprResultType ile tip cikarimiyla ortaktir.
Private Function SemTaskOfCheckSource(ByRef ps As ParseState, ByVal exprIdx As Integer, ByRef wantedType As String, ByRef contextText As String, ByRef errText As String) As Integer
    If wantedType = "" Then Return 1
    Dim isTask As Integer
    Dim gotType As String
    gotType = UXBTaskExprResultType(ps, exprIdx, isTask)
    If isTask = 0 Then Return 1   ' TASK kaynagi degil: tip uyumsuzlugunu genel atama denetimi yakalar
    If gotType = "" Then
        errText = "semantic: " & contextText & ": TASK OF " & wantedType & " bekleniyor ama kaynak tipsiz bir TASK (sonuc tipi dogrulanamaz); hedef THREAD/PARALEL'e 'AS " & wantedType & "' ekleyin ya da hedefi tipsiz TASK yapin"
        Return 0
    End If
    If UCase(gotType) <> UCase(wantedType) Then
        errText = "semantic: " & contextText & ": TASK OF " & wantedType & " bekleniyor, kaynak TASK OF " & gotType
        Return 0
    End If
    Return 1
End Function

' TASK OF sonuc tipi: rutinin RETURN_TYPE'i TASK ise alt dugumunden, degilse "" (isTaskOut=0).
Private Function SemTaskOfRoutineReturn(ByRef ps As ParseState, ByVal routineIdx As Integer, ByRef isTaskOut As Integer) As String
    isTaskOut = 0
    If routineIdx < 0 Then Return ""
    Dim ch As Integer
    ch = ps.ast.nodes(routineIdx).firstChild
    Do While ch <> -1
        If UCase(Trim(ps.ast.nodes(ch).kind)) = "RETURN_TYPE" Then
            If UCase(Trim(ps.ast.nodes(ch).value)) <> "TASK" Then Return ""
            isTaskOut = 1
            Return UXBTaskOfResultTypeFromTypeNode(ps, ch)
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return ""
End Function

' `DIM g(3) AS TASK : g.JOIN()` -- dizi adi indekssiz TASK alicisi olamaz. Her motor
' ayni derleme hatasini verir (eskiden AST calisma aninda, MIR "NULL gorev" diyordu).
Private Function SemTaskArrayReceiverCheck(ByRef ps As ParseState, ByVal receiverIdx As Integer, ByRef errText As String) As Integer
    If receiverIdx < 0 Or receiverIdx >= ps.ast.count Then Return 1
    Dim rk As String
    rk = UCase(Trim(ps.ast.nodes(receiverIdx).kind))
    If rk <> "IDENT" And rk <> "IDENTIFIER" Then Return 1
    Dim declIdx As Integer
    declIdx = UXBTaskFindDeclForName(ps, ps.ast.nodes(receiverIdx).value, receiverIdx)
    If declIdx = -1 Then Return 1
    Dim dc As Integer
    dc = ps.ast.nodes(declIdx).firstChild
    Do While dc <> -1
        If UCase(Trim(ps.ast.nodes(dc).kind)) = "DIM_BOUNDS" Then
            errText = "semantic: TASK dizisi eleman indeksi olmadan alici olamaz: " & ps.ast.nodes(receiverIdx).value & " -- " & ps.ast.nodes(receiverIdx).value & "(i) yazin"
            Return 0
        End If
        dc = ps.ast.nodes(dc).nextSibling
    Loop
    Return 1
End Function

Private Function SemValidateTaskOfTypes(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(i).kind))
        Select Case k
        Case "DIM_DECL"
            Dim dimType As String
            dimType = UXBTaskOfResultTypeFromTypeNode(ps, UXBTaskDeclTypeNode(ps, i))
            If dimType = "" Then Continue For
            Dim dc As Integer
            dc = ps.ast.nodes(i).firstChild
            Do While dc <> -1
                If UCase(Trim(ps.ast.nodes(dc).kind)) = "INIT_EXPR" Then
                    If SemTaskOfCheckSource(ps, ps.ast.nodes(dc).left, dimType, "DIM " & ps.ast.nodes(i).value, errText) = 0 Then Return 0
                End If
                dc = ps.ast.nodes(dc).nextSibling
            Loop

        Case "ASSIGN_STMT"
            Dim lhs As Integer
            lhs = ps.ast.nodes(i).left
            If lhs = -1 Then Continue For
            Dim lhsKind As String
            lhsKind = UCase(Trim(ps.ast.nodes(lhs).kind))
            If lhsKind <> "IDENT" And lhsKind <> "IDENTIFIER" And lhsKind <> "CALL_EXPR" Then Continue For
            If lhsKind = "CALL_EXPR" AndAlso ps.ast.nodes(lhs).left <> -1 Then Continue For
            Dim lhsName As String
            lhsName = Trim(ps.ast.nodes(lhs).value)
            Dim wanted As String
            wanted = ""
            Dim lhsDecl As Integer
            lhsDecl = UXBTaskFindDeclForName(ps, lhsName, lhs)
            If lhsDecl <> -1 Then
                wanted = UXBTaskOfResultTypeFromTypeNode(ps, UXBTaskDeclTypeNode(ps, lhsDecl))
            Else
                ' BASIC tarzi donus: FUNCTION govdesinde `FonksiyonAdi = ifade`
                Dim ownerFn As Integer
                ownerFn = UXBTaskEnclosingRoutine(ps, i)
                If ownerFn <> -1 AndAlso UCase(Trim(ps.ast.nodes(ownerFn).kind)) = "FUNCTION_STMT" AndAlso UCase(Trim(ps.ast.nodes(ownerFn).value)) = UCase(lhsName) Then
                    Dim fnIsTask As Integer
                    wanted = SemTaskOfRoutineReturn(ps, ownerFn, fnIsTask)
                End If
            End If
            If SemTaskOfCheckSource(ps, ps.ast.nodes(i).right, wanted, "atama " & lhsName, errText) = 0 Then Return 0

        Case "RETURN_STMT"
            Dim retOwner As Integer
            retOwner = UXBTaskEnclosingRoutine(ps, i)
            If retOwner = -1 Then Continue For
            Dim retOwnerKind As String
            retOwnerKind = UCase(Trim(ps.ast.nodes(retOwner).kind))
            Dim retExpr As Integer
            retExpr = ps.ast.nodes(i).left
            If retExpr = -1 Then retExpr = ps.ast.nodes(i).firstChild
            If retOwnerKind = "FUNCTION_STMT" Then
                Dim retIsTask As Integer
                Dim retWanted As String
                retWanted = SemTaskOfRoutineReturn(ps, retOwner, retIsTask)
                If retIsTask <> 0 And retExpr <> -1 Then
                    If SemTaskOfCheckSource(ps, retExpr, retWanted, "FUNCTION " & ps.ast.nodes(retOwner).value & " RETURN", errText) = 0 Then Return 0
                End If
            ElseIf retOwnerKind = "THREAD_STMT" Or retOwnerKind = "PARALEL_STMT" Then
                ' Donus tipi bildiren gorev degersiz RETURN ile bitemez: TASK OF sonucu tanimsiz kalirdi.
                Dim laneRet As Integer
                laneRet = ps.ast.nodes(retOwner).firstChild
                Do While laneRet <> -1
                    If UCase(Trim(ps.ast.nodes(laneRet).kind)) = "RETURN_TYPE" Then
                        If retExpr = -1 Then
                            errText = "semantic: " & IIf(retOwnerKind = "THREAD_STMT", "THREAD", "PARALEL") & " " & ps.ast.nodes(retOwner).value & " AS " & ps.ast.nodes(laneRet).value & " bildiriyor; RETURN bir deger dondurmeli"
                            Return 0
                        End If
                        Exit Do
                    End If
                    laneRet = ps.ast.nodes(laneRet).nextSibling
                Loop
            End If

        Case "FIELD_EXPR"
            If SemTaskArrayReceiverCheck(ps, ps.ast.nodes(i).left, errText) = 0 Then Return 0

        Case "CALL_EXPR", "CALL_STMT"
            If ps.ast.nodes(i).left <> -1 Then
                ' metot cagrisi: TASK dizisi indekssiz alici olamaz
                If SemTaskArrayReceiverCheck(ps, ps.ast.nodes(i).left, errText) = 0 Then Return 0
                Continue For
            End If
            Dim callName As String
            callName = UCase(Trim(ps.ast.nodes(i).value))
            If callName = "" Then Continue For
            Dim ri As Integer
            For ri = 0 To ps.ast.count - 1
                Dim rk As String
                rk = UCase(Trim(ps.ast.nodes(ri).kind))
                If rk <> "FUNCTION_STMT" And rk <> "SUB_STMT" Then Continue For
                If UCase(Trim(ps.ast.nodes(ri).value)) <> callName Then Continue For
                Dim pNode As Integer
                pNode = ps.ast.nodes(ri).firstChild
                Dim argNode As Integer
                argNode = ps.ast.nodes(i).firstChild
                Do While pNode <> -1 And argNode <> -1
                    If UCase(Trim(ps.ast.nodes(pNode).kind)) <> "PARAM_DECL" Then Exit Do
                    Dim paramWanted As String
                    paramWanted = UXBTaskOfResultTypeFromTypeNode(ps, UXBTaskDeclTypeNode(ps, pNode))
                    If SemTaskOfCheckSource(ps, argNode, paramWanted, callName & " parametresi " & ps.ast.nodes(pNode).value, errText) = 0 Then Return 0
                    pNode = ps.ast.nodes(pNode).nextSibling
                    argNode = ps.ast.nodes(argNode).nextSibling
                Loop
                Exit For
            Next ri
        End Select
    Next i
    Return 1
End Function

' S-067: `MAIN` belongs to the `MAIN ... END MAIN` program-entry block, and the compiler
' names its own top-level driver function "MAIN" internally. A user routine of that
' name used to collide with it: native x64 and canonical-MIR ran the user's SUB as the
' PROGRAM (top-level code never ran), the AST interpreter ignored it, and the legacy
' backend failed to assemble. It cannot even be called (`MAIN()` is a parse error), so
' the name is simply reserved -- one clear error instead of five different behaviours.
Private Function SemValidateReservedRoutineNames(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(i).kind))
        If k <> "SUB_STMT" And k <> "FUNCTION_STMT" Then Continue For
        If UCase(Trim(ps.ast.nodes(i).value)) = "MAIN" Then
            errText = "semantic: MAIN is reserved for the MAIN ... END MAIN program-entry block and cannot name a " & IIf(k = "SUB_STMT", "SUB", "FUNCTION")
            Return 0
        End If
    Next i
    Return 1
End Function

' S-106: a variable (DIM/REDIM), parameter or constant may not carry the name of a CLASS or
' INTERFACE (case-insensitive). `CLASS B ... DIM b AS B = NEW B() : b.F()` made every engine
' read `b.F()` as a call THROUGH THE CLASS NAME ("instance method cannot be called through
' class name B.F" / "non-virtual base dispatch blocked"). Types and variables share one name
' space (as in FreeBASIC's "Duplicated definition"), so the declaration is refused with one
' clear message. Mete's decision (2026-09-21): compile error. Field/method names live inside
' the class and are not affected.
Private Function SemValidateVariableClassNameConflicts(ByRef ps As ParseState, ByRef errText As String) As Integer
    If UXBAstNameIndexEnsure(ps) = 0 Then Return 1
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        Dim k As String
        k = UCase(Trim(ps.ast.nodes(i).kind))
        If k <> "DIM_DECL" And k <> "REDIM_DECL" And k <> "PARAM_DECL" And k <> "CONST_DECL" Then Continue For
        Dim nm As String
        nm = UCase(Trim(ps.ast.nodes(i).value))
        If nm = "" Then Continue For
        Dim what As String
        what = ""
        If UXBAstNameIndexFirst(2, nm) <> -1 Then what = "CLASS"
        If what = "" Then
            If UXBAstNameIndexFirst(4, nm) <> -1 Then what = "INTERFACE"
        End If
        If what <> "" Then
            errText = "semantic: " & IIf(k = "PARAM_DECL", "parameter ", IIf(k = "CONST_DECL", "constant ", "variable ")) & nm & " conflicts with " & what & " " & nm & " (type and variable names share one name space; rename the " & IIf(k = "PARAM_DECL", "parameter", IIf(k = "CONST_DECL", "constant", "variable")) & ") [line " & LTrim(Str(ps.ast.nodes(i).lineNo)) & "]"
            Return 0
        End If
    Next i
    Return 1
End Function

' S-212: a name can be declared once per scope. The AST engine refused the second `DIM a` of a frame at run time ("DIM: duplicate variable"); canonical MIR
' and native x64 accepted it silently and kept using one slot. The check is the sure case only: two declarations that are direct children of the SAME
' container (routine body, MAIN, namespace/module, program top level) - nested blocks (IF/FOR/...) are not examined, so a name reused in sibling branches is
' never refused. A routine parameter and a DIM of the same name in that routine's own body count as duplicates (the AST frame holds both).
Private Function SemDimScopeContainer(ByRef ps As ParseState, ByVal declNode As Integer) As Integer
    Dim stmtNode As Integer = ps.ast.nodes(declNode).parent
    If stmtNode < 0 Or stmtNode >= ps.ast.count Then Return -1
    Dim container As Integer = IIf(UCase(Trim(ps.ast.nodes(declNode).kind)) = "PARAM_DECL", stmtNode, ps.ast.nodes(stmtNode).parent)
    If container < 0 Or container >= ps.ast.count Then Return -1
    Select Case UCase(Trim(ps.ast.nodes(container).kind))
    Case "SUB_STMT", "FUNCTION_STMT", "MAIN_STMT", "CLASS_METHOD_DECL", "CLASS_CONSTRUCTOR_DECL", "CLASS_DESTRUCTOR_DECL", "CLASS_OPERATOR_DECL", _
         "CLASS_PROPERTY_GET_STMT", "CLASS_PROPERTY_SET_STMT", "THREAD_STMT", "EVENT_STMT", "PIPE_STMT", "PARALEL_STMT", "NAMESPACE_STMT", "MODULE_STMT"
        Return container
    End Select
    If container = ps.rootNode Then Return container
    Return -1
End Function

Private Function SemValidateDuplicateDims(ByRef ps As ParseState, ByRef errText As String) As Integer
    If UXBAstNameIndexEnsure(ps) = 0 Then Return 1
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "DIM_DECL" Then Continue For
        Dim nm As String = UCase(Trim(ps.ast.nodes(i).value))
        If nm = "" Then Continue For
        Dim myScope As Integer = SemDimScopeContainer(ps, i)
        If myScope = -1 Then Continue For
        Dim e As Integer = UXBAstNameIndexFirst(0, nm)
        Do While e <> -1
            Dim other As Integer = UXBAstNameIndexNode(e)
            If other >= i Then Exit Do
            Dim otherKind As String = UCase(Trim(ps.ast.nodes(other).kind))
            If otherKind = "DIM_DECL" Or otherKind = "PARAM_DECL" Then
                If SemDimScopeContainer(ps, other) = myScope Then
                    errText = "semantic: duplicate variable " & nm & " (already declared at line " & LTrim(Str(ps.ast.nodes(other).lineNo)) & "; a name can be declared once per scope, use REDIM to resize an array or choose another name) [line " & LTrim(Str(ps.ast.nodes(i).lineNo)) & "]"
                    Return 0
                End If
            End If
            e = UXBAstNameIndexNext(e)
        Loop
    Next i
    Return 1
End Function

' S-037: is `targetNode` anywhere inside the subtree of `rootNode`? Expression nodes of a
' PRINT item hang off PRINT_ITEM.left with no parent link, so the walk follows left/right
' as well as the child list.
Private Function SemNodeInSubtree(ByRef ps As ParseState, ByVal rootNode As Integer, ByVal targetNode As Integer, ByVal depthLeft As Integer) As Integer
    If rootNode < 0 Or rootNode >= ps.ast.count Or depthLeft < 0 Then Return 0
    If rootNode = targetNode Then Return 1
    If ps.ast.nodes(rootNode).left <> -1 Then
        If SemNodeInSubtree(ps, ps.ast.nodes(rootNode).left, targetNode, depthLeft - 1) <> 0 Then Return 1
    End If
    If ps.ast.nodes(rootNode).right <> -1 Then
        If SemNodeInSubtree(ps, ps.ast.nodes(rootNode).right, targetNode, depthLeft - 1) <> 0 Then Return 1
    End If
    Dim ch As Integer
    ch = ps.ast.nodes(rootNode).firstChild
    Do While ch <> -1
        If SemNodeInSubtree(ps, ch, targetNode, depthLeft - 1) <> 0 Then Return 1
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 0
End Function

Private Function SemClassDerivesFrom(ByRef ps As ParseState, ByRef derivedNameRaw As String, ByRef baseNameRaw As String) As Integer
    Dim cur As String
    Dim wanted As String
    cur = UCase(Trim(derivedNameRaw))
    wanted = UCase(Trim(baseNameRaw))
    Dim hop As Integer
    For hop = 0 To 64
        If cur = "" Then Return 0
        If cur = wanted Then Return 1
        Dim classNode As Integer
        classNode = SemFindClassNode(ps, cur)
        If classNode = -1 Then Return 0
        Dim nextBase As String
        nextBase = ""
        Dim ch As Integer
        ch = ps.ast.nodes(classNode).firstChild
        Do While ch <> -1
            If UCase(Trim(ps.ast.nodes(ch).kind)) = "CLASS_BASE_REF" Then
                nextBase = UCase(Trim(ps.ast.nodes(ch).value))
                Exit Do
            End If
            ch = ps.ast.nodes(ch).nextSibling
        Loop
        cur = nextBase
    Next hop
    Return 0
End Function

' S-037: an EXPLICITLY declared PRIVATE / PROTECTED method could be called from anywhere by
' canonical-MIR, native x64 and the legacy backend; only the AST interpreter refused it, and
' only at run time. Enforce it once, at compile time, for every engine. (Members with NO access
' marker are deliberately not judged here: the AST interpreter treats them as PRIVATE while
' the other engines allow them -- the default is an open design decision, see S-105.)
Private Function SemValidateExplicitMethodAccess(ByRef ps As ParseState, ByRef errText As String) As Integer
    Dim i As Integer
    For i = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "CALL_EXPR" And UCase(Trim(ps.ast.nodes(i).kind)) <> "CALL_STMT" Then Continue For
        Dim ownerName As String
        Dim methodName As String
        If SemSplitMethodCallName(ps.ast.nodes(i).value, ownerName, methodName) = 0 Then Continue For
        ownerName = UCase(Trim(ownerName))
        methodName = UCase(Trim(methodName))
        If ownerName = "" Or methodName = "" Or ownerName = "THIS" Or ownerName = "ME" Or ownerName = "SUPER" Then Continue For
        If InStr(ownerName, ".") > 0 Then Continue For

        Dim ownerType As String
        If SemFindDimDeclTypeByName(ps, ownerName, ownerType) = 0 Then Continue For
        ownerType = UCase(Trim(ownerType))
        If SemFindClassNode(ps, ownerType) = -1 Then Continue For

        ' find the method along the base chain
        Dim declClass As String
        Dim methodNode As Integer
        declClass = ownerType
        methodNode = -1
        Dim hop As Integer
        For hop = 0 To 64
            Dim classNode As Integer
            classNode = SemFindClassNode(ps, declClass)
            If classNode = -1 Then Exit For
            Dim member As Integer
            member = ps.ast.nodes(classNode).firstChild
            Dim nextBase As String
            nextBase = ""
            Do While member <> -1
                Dim mk As String
                mk = UCase(Trim(ps.ast.nodes(member).kind))
                If mk = "CLASS_METHOD_DECL" And UCase(Trim(ps.ast.nodes(member).value)) = methodName Then
                    methodNode = member
                    Exit Do
                End If
                If mk = "CLASS_BASE_REF" Then nextBase = UCase(Trim(ps.ast.nodes(member).value))
                member = ps.ast.nodes(member).nextSibling
            Loop
            If methodNode <> -1 Then Exit For
            If nextBase = "" Then Exit For
            declClass = nextBase
        Next hop
        If methodNode = -1 Then Continue For

        Dim accessText As String
        accessText = ""
        Dim ac As Integer
        ac = ps.ast.nodes(methodNode).firstChild
        Do While ac <> -1
            If UCase(Trim(ps.ast.nodes(ac).kind)) = "CLASS_ACCESS" Then
                accessText = UCase(Trim(ps.ast.nodes(ac).value))
                If accessText <> "" Then Exit Do
            End If
            ac = ps.ast.nodes(ac).nextSibling
        Loop
        If accessText <> "PRIVATE" And accessText <> "PROTECTED" Then Continue For

        ' where is the call? inside the declaring class (or, for PROTECTED, a derived one)
        Dim allowed As Integer
        allowed = 0
        Dim c As Integer
        For c = 0 To ps.ast.count - 1
            If UCase(Trim(ps.ast.nodes(c).kind)) <> "CLASS_STMT" Then Continue For
            If SemNodeInSubtree(ps, c, i, 64) = 0 Then Continue For
            Dim insideClass As String
            insideClass = UCase(Trim(ps.ast.nodes(c).value))
            If insideClass = declClass Then allowed = 1: Exit For
            If accessText = "PROTECTED" And SemClassDerivesFrom(ps, insideClass, declClass) <> 0 Then allowed = 1: Exit For
        Next c
        If allowed = 0 Then
            errText = "semantic: " & accessText & " method " & declClass & "." & methodName & " cannot be called from outside " & IIf(accessText = "PRIVATE", "its class", "its class hierarchy")
            Return 0
        End If
    Next i
    Return 1
End Function

' S-104 (Mete's decision, 2026-09-20): a program has ONE of two shapes -- (A) no explicit
' MAIN: the top-level statements are the program body; (B) an explicit MAIN ... END MAIN:
' that block is the ONLY program body, so an EXECUTABLE top-level statement outside it
' (before or after) is a compile error instead of running on some engines and being
' skipped on others. Declarations (TYPE, CLASS, INTERFACE, ENUM, SUB, FUNCTION, DECLARE,
' MODULE, NAMESPACE, CONST, global DIM, ALIAS/IMPORT/INCLUDE/USING, DEFxxx, task routines)
' stay legal anywhere.
Private Function SemIsExecutableTopLevelKind(ByRef kindUpper As String) As Integer
    Select Case kindUpper
    Case "ASSIGN_STMT", "EXPR_STMT", "PRINT_STMT", "INPUT_STMT", "INPUT_FILE_STMT", "INPUTF_STMT", _
         "IF_STMT", "SELECT_STMT", "FOR_STMT", "FOR_EACH_STMT", "DO_STMT", "DO_EACH_STMT", "EXIT_STMT", "CONTINUE_STMT", _
         "RETURN_STMT", "GOTO_STMT", "GOSUB_STMT", "LABEL_STMT", "CALL_STMT", "CALL_DLL_STMT", "CALL_API_STMT", _
         "TRY_STMT", "THROW_STMT", "ASSERT_STMT", "END_STMT", "RANDOMIZE_STMT", "INCDEC_STMT", _
         "OPEN_STMT", "CLOSE_STMT", "GET_STMT", "PUT_STMT", "SEEK_STMT", "LOCATE_STMT", "COLOR_STMT", "CLS_STMT", _
         "DELETE_STMT", "SETSTRINGSIZE_STMT", "POKEB_STMT", "POKEW_STMT", "POKED_STMT", "POKEQ_STMT", "POKES_STMT", _
         "MEMCOPYB_STMT", "MEMCOPYW_STMT", "MEMCOPYD_STMT", "MEMCOPYQ_STMT", "MEMFILLB_STMT", "MEMFILLW_STMT", _
         "MEMFILLD_STMT", "MEMFILLQ_STMT", "SETNEWOFFSET_STMT", "INLINE_STMT", "SHELL_STMT", "TRIGGER_STMT", _
         "SLOT_CONTROL_STMT", "REDIM_STMT", "VIRTUAL_STMT"
        Return 1
    End Select
    Return 0
End Function

Private Function SemValidateMainBlockExclusive(ByRef ps As ParseState, ByRef errText As String) As Integer
    If ps.rootNode < 0 Or ps.rootNode >= ps.ast.count Then Return 1
    Dim ch As Integer
    Dim hasMain As Integer = 0
    ch = ps.ast.nodes(ps.rootNode).firstChild
    Do While ch <> -1
        If UCase(Trim(ps.ast.nodes(ch).kind)) = "MAIN_STMT" Then
            hasMain = 1
            Exit Do
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    If hasMain = 0 Then Return 1

    ch = ps.ast.nodes(ps.rootNode).firstChild
    Do While ch <> -1
        Dim kindUpper As String = UCase(Trim(ps.ast.nodes(ch).kind))
        If SemIsExecutableTopLevelKind(kindUpper) <> 0 Then
            errText = "semantic: MAIN: executable top-level statement outside explicit MAIN block (" & kindUpper & " at line " & LTrim(Str(ps.ast.nodes(ch).lineNo)) & "); with MAIN ... END MAIN, the block is the only program body"
            Return 0
        End If
        ch = ps.ast.nodes(ch).nextSibling
    Loop
    Return 1
End Function

Private Function SemNormalizeIffCalls(ByRef ps As ParseState, ByRef errText As String) As Integer
    For i As Integer = 0 To ps.ast.count - 1
        If UCase(Trim(ps.ast.nodes(i).kind)) <> "CALL_EXPR" Then Continue For
        If UCase(Trim(ps.ast.nodes(i).value)) <> "IFF" Then Continue For
        If SemChildCount(ps, i) <> 3 Then
            errText = "semantic: UXB_IFF_ARGUMENT_COUNT: IFF requires exactly three arguments (condition,true,false); got " & LTrim(Str(SemChildCount(ps, i)))
            errText &= " @" & LTrim(Str(ps.ast.nodes(i).lineNo)) & ":" & LTrim(Str(ps.ast.nodes(i).colNo))
            Return 0
        End If
        Dim conditionNode As Integer = SemChildAt(ps, i, 0)
        Dim trueNode As Integer = SemChildAt(ps, i, 1)
        Dim falseNode As Integer = SemChildAt(ps, i, 2)
        ' Reuse the lazy conditional-expression contract on every engine.
        ' Infix IFF remains a BINARY logical-equivalence operator.
        ps.ast.nodes(conditionNode).nextSibling = -1
        ps.ast.nodes(trueNode).nextSibling = -1
        ps.ast.nodes(falseNode).nextSibling = -1
        ps.ast.nodes(i).kind = "TERNARY_EXPR"
        ps.ast.nodes(i).op = "IFF"
        ps.ast.nodes(i).typeName = ""
        ps.ast.nodes(i).firstChild = trueNode
        ASTSetLeft ps.ast, i, conditionNode
        ASTSetRight ps.ast, i, falseNode
        ps.ast.nodes(trueNode).parent = i
    Next i
    Return 1
End Function

#include once "semantic_static_locals.fbs"
#include once "semantic_mid_assignment.fbs"
#include once "semantic_delete_lvalue.fbs"
#include once "semantic_class_array_shape.fbs"
#include once "semantic_class_array_dynamic.fbs"
#include once "semantic_file_handle.fbs"
#include once "semantic_base_ctor.fbs"
#include once "semantic_declare.fbs"
#include once "semantic_using_ambiguity.fbs"
#include once "semantic_undefined_call.fbs"

Function SemanticAnalyze(ByRef ps As ParseState, ByRef errText As String) As Integer
    errText = ""

    If ps.rootNode = -1 Or ps.ast.count = 0 Then
        errText = "semantic: bos AST"
        Return 0
    End If

    If SemNormalizeStaticLocals(ps, errText) = 0 Then Return 0
    If SemNormalizeMidAssignments(ps, errText) = 0 Then Return 0
    ' S-564: NULL / NOTHING identifiers become the typed literal 0 for every engine
    If SemNormalizeNullLiterals(ps, errText) = 0 Then Return 0

    If SemValidateReservedRoutineNames(ps, errText) = 0 Then Return 0
    If SemValidateVariableClassNameConflicts(ps, errText) = 0 Then Return 0
    If SemValidateDuplicateDims(ps, errText) = 0 Then Return 0
    If SemValidateMainBlockExclusive(ps, errText) = 0 Then Return 0
    If SemNormalizeIffCalls(ps, errText) = 0 Then Return 0
    ' S-119: bare field / method names in member bodies become THIS.<name> for every engine
    If SemRewriteImplicitThis(ps, errText) = 0 Then Return 0
    If SemNormalizeDynamicClassArrays(ps, errText) = 0 Then Return 0
    If SemNormalizeMultidimClassArrays(ps, errText) = 0 Then Return 0
    ' S-548 / S-549: FREEFILE, FILE_HANDLE (OPEN ... AS handle, CLOSE handle) and the channel ledger behind them (runs after the implicit-THIS step so class fields are THIS.<name>)
    If SemNormalizeFileHandles(ps, errText) = 0 Then Return 0
    ' S-544 / Mete 2026-10-28: optional DECLARE, including forward calls.
    ' An explicit local declaration still needs a matching definition.
    If SemValidateOptionalDeclareContracts(ps, errText) = 0 Then Return 0
    ' S-271 / Mete K3 2026-10-28: a name declared by two USING namespaces needs a qualified call (runs before the overload binder renames routines)
    If SemValidateUsingAmbiguity(ps, errText) = 0 Then Return 0
    ' S-329 / Mete K1 2026-10-28: a call of a name declared nowhere (no routine, variable or built-in) is one compile error on every engine
    If SemValidateUndefinedRoutineCalls(ps, errText) = 0 Then Return 0
    If SemValidateOverloadResolution(ps, errText) = 0 Then Return 0
    ' S-615: DELETE of an object field becomes a block that destroys the object and empties the field (needs the THIS.field form from the step above)
    If SemNormalizeClassArrayCompoundTargets(ps, errText) = 0 Then Return 0
    If SemNormalizeDeleteFieldTargets(ps, errText) = 0 Then Return 0
    ' S-485 / S-487: SUPER(...) and the implicit base constructor call become explicit SUPER.CONSTRUCTOR(...) statements in the constructor bodies
    If SemNormalizeBaseConstructorCalls(ps, errText) = 0 Then Return 0
    If SemRewriteVarptrElementNodes(ps, errText) = 0 Then Return 0
    If SemRewriteTimerUnitCalls(ps, errText) = 0 Then Return 0   ' S-651
    If SemValidateStrayReturns(ps, errText) = 0 Then Return 0   ' S-537
    If SemRewriteRotateAssignments(ps, errText) = 0 Then Return 0   ' S-520
    If SemValidateTypeRefs(ps, errText) = 0 Then Return 0
    If SemValidateClassMixinDecoratorContracts(ps, errText) = 0 Then Return 0
    If SemValidateCallNodes(ps, errText) = 0 Then Return 0
    If SemValidateArrayArguments(ps, errText) = 0 Then Return 0
    If SemValidateArrayBoundsCalls(ps, errText) = 0 Then Return 0
    If SemValidateEachSources(ps, errText) = 0 Then Return 0
    If SemValidateSpawnCalls(ps, errText) = 0 Then Return 0
    If SemValidateTaskOfTypes(ps, errText) = 0 Then Return 0
    If SemValidateExplicitMethodAccess(ps, errText) = 0 Then Return 0
    If SemValidateImportNodes(ps, errText) = 0 Then Return 0
    If SemValidateInputNodes(ps, errText) = 0 Then Return 0
    If SemValidateSlotLaneNodes(ps, errText) = 0 Then Return 0
    If SemValidateIfSelectNodes(ps, errText) = 0 Then Return 0
    If SemValidateErrorFlowNodes(ps, errText) = 0 Then Return 0
    If SemValidateRoutineNodes(ps, errText) = 0 Then Return 0
    If SemValidateConstNodes(ps, errText) = 0 Then Return 0
    If SemValidateNewExprNodes(ps, errText) = 0 Then Return 0
    If SemValidateDimClassInitializers(ps, errText) = 0 Then Return 0
    If SemValidateArrayScalarInitializers(ps, errText) = 0 Then Return 0   ' S-568
    If SemValidateClassAssignments(ps, errText) = 0 Then Return 0
    If SemValidateDeleteNodes(ps, errText) = 0 Then Return 0
    If SemFoldConstants(ps, errText) = 0 Then Return 0
    If SemValidateReachability(ps, errText) = 0 Then Return 0
    If SemValidateThisMeUsage(ps, errText) = 0 Then Return 0
    If SemValidateConstructorMeVirtualCalls(ps, errText) = 0 Then Return 0
    If SemValidateStaticMemberReceiverUsage(ps, errText) = 0 Then Return 0
    If SemValidateClassNameCalls(ps, errText) = 0 Then Return 0
    If SemValidateClassModifierContracts(ps, errText) = 0 Then Return 0
    If SemValidateInheritedFieldHiding(ps, errText) = 0 Then Return 0
    If SemValidateClassPropertyContracts(ps, errText) = 0 Then Return 0
    If SemValidateClassOperatorContracts(ps, errText) = 0 Then Return 0
    If SemValidateClassMagicMethodContracts(ps, errText) = 0 Then Return 0
    If SemValidateClassOverrideContracts(ps, errText) = 0 Then Return 0
    If SemValidateInterfaceContracts(ps, errText) = 0 Then Return 0
    If SemAssignVtableSlots(ps, errText) = 0 Then Return 0

    Dim step3Err As String
    If SemStep3SemanticTypeLayoutGate(ps, step3Err) = 0 Then
        errText = "semantic-step3: " & step3Err
        Return 0
    End If

    ' S-146 (D6): SPAWN sinirinda gorev izolasyonu -- tip cikarimi hazir olduktan sonra.
    If SemValidateSpawnIsolation(ps, errText) = 0 Then Return 0

    Return 1
End Function


