' uXBasic type binding state used by semantic/runtime hand-off.

#include once "layout/layout_shared_core.fbs"
#include once "library_type_contract.fbs"

Type TypeBinding
    typeKind As String
    typeName As String
    sizeBytes As Integer
    alignBytes As Integer
    isSigned As Integer
    isFloat As Integer
    isArray As Integer
    arrayDims As Integer
    elemTypeName As String
    isClass As Integer
    isCollection As Integer
    collectionKind As String
    isTask As Integer
End Type

Type VarBinding
    varName As String
    typeIdx As Integer
    isConst As Integer
    constValue As String
    storageAddr As ULongInt
    isGlobal As Integer
End Type

Dim Shared gTypeBindings() As TypeBinding
Dim Shared gTypeBindingCount As Integer
Dim Shared gVarBindings() As VarBinding
Dim Shared gVarBindingCount As Integer

Private Function TypeBindingCanonical(ByRef rawKind As String) As String
    Dim k As String
    k = UCase(Trim(rawKind))

    Select Case k
    Case "BYTE"
        Return "I8"
    Case "UBYTE"
        Return "U8"
    Case "SHORT"
        Return "I16"
    Case "USHORT"
        Return "U16"
    Case "INTEGER", "LONG"
        Return "I32"
    Case "UINTEGER", "ULONG"
        Return "U32"
    Case "LONGINT"
        Return "I64"
    Case "ULONGINT"
        Return "U64"
    Case "F80", "EXTENDED", "EXT"
        Return "F80"
    Case "F128", "FLOAT128", "QUAD"
        Return "F128"
    Case "BIGF", "BIGFLOAT"
        Return "BIGF"
    Case "BIGD", "BIGDECIMAL"
        Return "BIGD"
    Case "BALL"
        Return "BALL"
    Case "BIGI", "BIGINT", "BIG_INTEGER", "BIGINTEGER"
        Return "BIGINT"
    Case "DOUBLE", "DBL", "DBLE"
        Return "F64"
    Case "VARIANT", "VAR", "ANY", "ANYREF"
        Return "TYPE"
    Case "PTR"
        Return "POINTER"
    Case "SINGLE", "SNG", "SNGLE"
        Return "F32"
    End Select

    Return k
End Function

Private Function TypeBindingPointerSize() As Integer
    Return 8
End Function

Private Function TypeBindingFindByKey(ByRef kindName As String, ByRef typeName As String) As Integer
    Dim i As Integer
    For i = 0 To gTypeBindingCount - 1
        If gTypeBindings(i).typeKind = kindName AndAlso gTypeBindings(i).typeName = typeName Then
            Return i
        End If
    Next i

    Return -1
End Function

Private Function VarBindingFindByName(ByRef varName As String) As Integer
    Dim nameKey As String
    nameKey = UCase(Trim(varName))

    Dim i As Integer
    For i = 0 To gVarBindingCount - 1
        If UCase(gVarBindings(i).varName) = nameKey Then
            Return i
        End If
    Next i

    Return -1
End Function

Sub TypeBindingInit()
    gTypeBindingCount = 0
    gVarBindingCount = 0
    UXBLibraryTypeRegistryInit
    Dim libTypeErr As String
    UXBLibraryTypeEnsureReferenceSet libTypeErr
End Sub

Function TypeBindingCreate(ByRef typeKind As String, ByRef typeName As String) As TypeBinding
    Dim tb As TypeBinding
    Dim k As String
    Dim ptrSize As Integer

    k = TypeBindingCanonical(typeKind)
    ptrSize = TypeBindingPointerSize()

    tb.typeKind = k
    tb.typeName = UCase(Trim(typeName))
    tb.sizeBytes = 0
    tb.alignBytes = 1
    tb.isSigned = 0
    tb.isFloat = 0
    tb.isArray = 0
    tb.arrayDims = 0
    tb.elemTypeName = ""
    tb.isClass = 0
    tb.isCollection = 0
    tb.collectionKind = ""
    tb.isTask = 0

    Select Case k
    Case "I8", "U8"
        tb.sizeBytes = 1
        tb.alignBytes = 1
        tb.isSigned = IIf(k = "I8", 1, 0)
    Case "I16", "U16"
        tb.sizeBytes = 2
        tb.alignBytes = 2
        tb.isSigned = IIf(k = "I16", 1, 0)
    Case "I32", "U32"
        tb.sizeBytes = 4
        tb.alignBytes = 4
        tb.isSigned = IIf(k = "I32", 1, 0)
    Case "I64", "U64"
        tb.sizeBytes = 8
        tb.alignBytes = 8
        tb.isSigned = IIf(k = "I64", 1, 0)
    Case "F32"
        tb.sizeBytes = 4
        tb.alignBytes = 4
        tb.isFloat = 1
    Case "F64"
        tb.sizeBytes = 8
        tb.alignBytes = 8
        tb.isFloat = 1
    Case "F80"
        tb.sizeBytes = 10
        tb.alignBytes = 8
        tb.isFloat = 1
    Case "F128"
        tb.sizeBytes = 16
        tb.alignBytes = 8
        tb.isFloat = 1
    Case "BIGF", "BIGD", "BALL"
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
        tb.isFloat = 1
    Case "BIGINT"
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
        tb.isSigned = 1
    Case "BOOLEAN"
        tb.sizeBytes = 1
        tb.alignBytes = 1
        tb.isSigned = 1
    Case "STRING", "REF", "POINTER"
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
    Case "ARRAY"
        tb.isArray = 1
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
    Case "TYPE"
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
    Case "CLASS", "INTERFACE"
        tb.isClass = 1
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
    Case "LIST", "DICT", "SET"
        tb.isCollection = 1
        tb.collectionKind = k
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
    Case "TASK", "TASKGROUP", "MUTEX"
        ' S-030: opak gorev tutamaci -- CLASS referansiyla ayni ABI (tek pointer),
        ' ama isClass DEGIL: metot/alan cozumlemesi kullanici sinifi tablosundan
        ' degil, TASK'a ozel sabit uye kumesinden (STATUS/WAIT/JOIN/CANCEL/RESULT/
        ' ERRORTEXT, TASKGROUP icin ADD/JOIN/JOINALL) gecer.
        tb.isTask = 1
        tb.sizeBytes = ptrSize
        tb.alignBytes = ptrSize
    End Select

    Return tb
End Function

Private Function TypeBindingAdd() As Integer
    If gTypeBindingCount = 0 Then
        ReDim gTypeBindings(0)
    Else
        ReDim Preserve gTypeBindings(gTypeBindingCount)
    End If

    Dim idx As Integer
    idx = gTypeBindingCount
    gTypeBindingCount += 1
    Return idx
End Function

Private Function VarBindingAdd() As Integer
    If gVarBindingCount = 0 Then
        ReDim gVarBindings(0)
    Else
        ReDim Preserve gVarBindings(gVarBindingCount)
    End If

    Dim idx As Integer
    idx = gVarBindingCount
    gVarBindingCount += 1
    Return idx
End Function

Function TypeBindingResolve(ByRef typeName As String, ByRef errText As String) As Integer
    Dim canonical As String
    canonical = TypeBindingCanonical(typeName)

    If Len(canonical) > 2 AndAlso Right(canonical, 2) = "[]" Then
        Dim elementType As String
        elementType = Left(canonical, Len(canonical) - 2)
        Dim elementIdx As Integer
        elementIdx = TypeBindingResolve(elementType, errText)
        If elementIdx = -1 Then Return -1

        Dim arrayIdx As Integer
        arrayIdx = TypeBindingFindByKey("ARRAY", elementType)
        If arrayIdx <> -1 Then Return arrayIdx
        arrayIdx = TypeBindingAdd()
        gTypeBindings(arrayIdx) = TypeBindingCreate("ARRAY", elementType)
        gTypeBindings(arrayIdx).isArray = 1
        gTypeBindings(arrayIdx).arrayDims = 1
        gTypeBindings(arrayIdx).elemTypeName = elementType
        gTypeBindings(arrayIdx).sizeBytes = TypeBindingPointerSize()
        gTypeBindings(arrayIdx).alignBytes = TypeBindingPointerSize()
        Return arrayIdx
    End If

    Select Case canonical
    Case "I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64", "F32", "F64", "F80", "F128", "BIGF", "BIGD", "BALL", "BIGINT", "BOOLEAN", "STRING", "ARRAY", "TYPE", "CLASS", "INTERFACE", "LIST", "DICT", "SET", "REF", "POINTER", "TASK", "TASKGROUP", "MUTEX"
        Dim existing As Integer
        existing = TypeBindingFindByKey(canonical, "")
        If existing <> -1 Then Return existing

        Dim idx As Integer
        idx = TypeBindingAdd()
        gTypeBindings(idx) = TypeBindingCreate(canonical, "")
        Return idx
    End Select

    Dim userName As String
    userName = UCase(Trim(typeName))
    If userName = "" Then
        errText = "type: empty type name"
        Return -1
    End If

    Dim userIdx As Integer
    userIdx = TypeBindingFindByKey("TYPE", userName)
    If userIdx <> -1 Then Return userIdx

    userIdx = TypeBindingFindByKey("CLASS", userName)
    If userIdx <> -1 Then Return userIdx

    userIdx = TypeBindingFindByKey("INTERFACE", userName)
    If userIdx <> -1 Then Return userIdx

    userIdx = TypeBindingFindByKey("ENUM", userName)
    If userIdx <> -1 Then Return userIdx

    Dim libIdx As Integer
    libIdx = UXBLibraryTypeRegistryFind(userName)
    If libIdx <> -1 Then
        userIdx = TypeBindingAdd()
        gTypeBindings(userIdx) = TypeBindingCreate("TYPE", userName)
        gTypeBindings(userIdx).sizeBytes = gUXBLibraryTypes(libIdx).sizeBytes
        gTypeBindings(userIdx).alignBytes = gUXBLibraryTypes(libIdx).alignBytes
        Return userIdx
    End If

    errText = "type: unknown type '" & typeName & "'"
    Return -1
End Function

Function TypeBindingRegisterUserType(ByRef kindRaw As String, ByRef typeNameRaw As String, ByRef errText As String) As Integer
    Dim k As String
    Dim n As String
    k = UCase(Trim(kindRaw))
    n = UCase(Trim(typeNameRaw))

    If n = "" Then
        errText = "type: user type name empty"
        Return -1
    End If

    If k <> "TYPE" And k <> "CLASS" And k <> "INTERFACE" And k <> "ENUM" Then
        errText = "type: unsupported user kind '" & kindRaw & "'"
        Return -1
    End If

    Dim existing As Integer
    existing = TypeBindingFindByKey(k, n)
    If existing <> -1 Then Return existing

    Dim idx As Integer
    idx = TypeBindingAdd()
    gTypeBindings(idx) = TypeBindingCreate(k, n)
    Return idx
End Function

Function VarBindingResolve(ByRef varName As String, ByRef errText As String) As Integer
    Dim i As Integer
    i = VarBindingFindByName(varName)
    If i <> -1 Then Return i

    errText = "var: unknown variable '" & varName & "'"
    Return -1
End Function

Function VarBindingCreate(ByRef varName As String, ByVal typeIdx As Integer, ByVal isConst As Integer, ByRef constValue As String, ByRef errText As String) As Integer
    Dim varKey As String
    varKey = UCase(Trim(varName))

    If varKey = "" Then
        errText = "var: empty variable name"
        Return -1
    End If

    If typeIdx < 0 Or typeIdx >= gTypeBindingCount Then
        errText = "var: invalid type index"
        Return -1
    End If

    If VarBindingFindByName(varKey) <> -1 Then
        errText = "var: duplicate variable '" & varName & "'"
        Return -1
    End If

    Dim idx As Integer
    idx = VarBindingAdd()
    gVarBindings(idx).varName = varKey
    gVarBindings(idx).typeIdx = typeIdx
    gVarBindings(idx).isConst = isConst
    gVarBindings(idx).constValue = constValue
    gVarBindings(idx).storageAddr = 0
    gVarBindings(idx).isGlobal = 1

    Return idx
End Function

' UXB_C_ABI_RECORDS_20260728: replace the old pointer-sized user TYPE placeholder
' after the semantic layout table has concrete STRUCT/UNION sizes.
Sub TypeBindingRefreshUserLayouts()
    Dim i As Integer
    For i = 0 To gTypeBindingCount - 1
        If gTypeBindings(i).typeKind = "TYPE" And Trim(gTypeBindings(i).typeName) <> "" Then
            Dim sizeBytes As Integer
            Dim alignBytes As Integer
            Dim recordKind As String
            Dim abiKind As String
            Dim packBytes As Integer
            Dim explicitAlign As Integer
            If TypeLayoutDescribeGlobal(gTypeBindings(i).typeName, sizeBytes, alignBytes, recordKind, abiKind, packBytes, explicitAlign) <> 0 Then
                gTypeBindings(i).sizeBytes = sizeBytes
                gTypeBindings(i).alignBytes = alignBytes
            End If
        End If
    Next i
End Sub
