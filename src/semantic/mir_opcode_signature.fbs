#ifndef UXB_MIR_OPCODE_SIGNATURE_FBS
#define UXB_MIR_OPCODE_SIGNATURE_FBS

#include once "mir_operand_role.fbs"
#include once "../mir/mir_registry.fbs"

Type MIROpcodeSignature
    opcode As String
    minOps As Integer
    maxOps As Integer
    roles(0 To 15) As Integer
    resultRequired As Integer
    allowVariadic As Integer
End Type

Sub MIROpcodeSignatureInit(ByRef sig As MIROpcodeSignature, ByVal opcodeText As String)
    sig.opcode = UCase(Trim(opcodeText))
    sig.minOps = 0
    sig.maxOps = 0
    sig.resultRequired = 0
    sig.allowVariadic = 0
    Dim i As Integer
    For i = 0 To 15
        sig.roles(i) = MIR_OPR_UNKNOWN
    Next i
End Sub

Function MIROpcodeGetSignature(ByVal opcodeText As String, ByRef sig As MIROpcodeSignature) As Integer
    Dim op As String
    op = UCase(Trim(opcodeText))
    MIROpcodeSignatureInit sig, op

    Select Case op
    Case "LOAD_CONST"
        sig.minOps = 1: sig.maxOps = 1: sig.resultRequired = 1: sig.roles(0) = MIR_OPR_CONST: Return 1
    Case "LOAD_VAR"
        sig.minOps = 1: sig.maxOps = 1: sig.resultRequired = 1: sig.roles(0) = MIR_OPR_VAR: Return 1
    Case "STORE_VAR"
        sig.minOps = 1: sig.maxOps = 1: sig.resultRequired = 1: sig.roles(0) = MIR_OPR_SOURCE: Return 1
    Case "LOAD_INDEXED"
        sig.minOps = 2: sig.maxOps = 2: sig.resultRequired = 1: sig.roles(0) = MIR_OPR_ARRAY_NAME: sig.roles(1) = MIR_OPR_INDEX: Return 1
    Case "STORE_INDEXED"
        sig.minOps = 3: sig.maxOps = 3: sig.resultRequired = 0: sig.roles(0) = MIR_OPR_ARRAY_NAME: sig.roles(1) = MIR_OPR_INDEX: sig.roles(2) = MIR_OPR_SOURCE: Return 1
    Case "ADD", "SUB", "MUL", "DIV", "IDIV", "MOD", "POW", "FADD", "FSUB", "FMUL", "FDIV", "EQ", "NE", "LT", "LE", "GT", "GE", "AND", "OR", "XOR", "NAND", "NOR", "XNOR", "IMP", "CIMP", "NIMP", "NCIMP", "IDA", "IDB", "NOTA", "NOTB", "SHL", "SHR", "USHR", "UIDIV", "UMOD", "ULT", "ULE", "UGT", "UGE", "ROL", "ROR"
        sig.minOps = 2: sig.maxOps = 2: sig.resultRequired = 1: sig.roles(0) = MIR_OPR_VALUE: sig.roles(1) = MIR_OPR_VALUE: Return 1
    Case "NEG", "FNEG", "NOT", "BNOT"
        sig.minOps = 1: sig.maxOps = 1: sig.resultRequired = 1: sig.roles(0) = MIR_OPR_VALUE: Return 1
    Case "JMP"
        sig.minOps = 1: sig.maxOps = 1: sig.resultRequired = 0: sig.roles(0) = MIR_OPR_LABEL: Return 1
    Case "JZ", "JNZ"
        sig.minOps = 2: sig.maxOps = 2: sig.resultRequired = 0: sig.roles(0) = MIR_OPR_CONDITION: sig.roles(1) = MIR_OPR_LABEL: Return 1
    ' ABI10_MIR_CALL16_FFI10_FIX_20260706: operand slots are 0..15 => max operandCount is 16.
    Case "CALL", "CALL_RUNTIME"
        sig.minOps = 1: sig.maxOps = 16: sig.resultRequired = 0: sig.allowVariadic = 1: sig.roles(0) = MIR_OPR_FUNCTION: Return 1
    Case "METHOD_CALL", "MIR_METHOD_CALL", "VIRTUAL_CALL", "MIR_VIRTUAL_CALL"
        sig.minOps = 4: sig.maxOps = 16: sig.resultRequired = 0: sig.allowVariadic = 1
        sig.roles(0) = MIR_OPR_TARGET: sig.roles(1) = MIR_OPR_OBJECT_NAME
        sig.roles(2) = MIR_OPR_FIELD_NAME: sig.roles(3) = MIR_OPR_TYPE_NAME
        Return 1
    Case "MIR_OBJECT_NEW", "OBJECT_NEW"
        sig.minOps = 2: sig.maxOps = 16: sig.resultRequired = 1: sig.allowVariadic = 1
        sig.roles(0) = MIR_OPR_TYPE_NAME: sig.roles(1) = MIR_OPR_CONST
        Return 1
    Case "MIR_FIELD_LOAD", "FIELD_LOAD", "LOAD_FIELD"
        sig.minOps = 3: sig.maxOps = 3: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_OBJECT_NAME: sig.roles(1) = MIR_OPR_FIELD_NAME: sig.roles(2) = MIR_OPR_CONST
        Return 1
    Case "MIR_FIELD_STORE", "FIELD_STORE", "STORE_FIELD"
        sig.minOps = 4: sig.maxOps = 4: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_OBJECT_NAME: sig.roles(1) = MIR_OPR_FIELD_NAME: sig.roles(2) = MIR_OPR_VALUE: sig.roles(3) = MIR_OPR_CONST
        Return 1
    Case "MIR_UNION_FIELD_LOAD"
        sig.minOps = 5: sig.maxOps = 5: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_OBJECT_NAME: sig.roles(1) = MIR_OPR_FIELD_NAME: sig.roles(2) = MIR_OPR_CONST: sig.roles(3) = MIR_OPR_CONST: sig.roles(4) = MIR_OPR_TYPE_NAME
        Return 1
    Case "MIR_UNION_FIELD_STORE"
        sig.minOps = 6: sig.maxOps = 6: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_OBJECT_NAME: sig.roles(1) = MIR_OPR_FIELD_NAME: sig.roles(2) = MIR_OPR_VALUE: sig.roles(3) = MIR_OPR_CONST: sig.roles(4) = MIR_OPR_CONST: sig.roles(5) = MIR_OPR_TYPE_NAME
        Return 1
    Case "MIR_MEMORY_LOAD", "MIR_MEM_LOAD", "MIR_PEEK", "PEEK"
        sig.minOps = 3: sig.maxOps = 3: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_VALUE: sig.roles(2) = MIR_OPR_CONST
        Return 1
    Case "MIR_MEMORY_STORE", "MIR_MEM_STORE", "MIR_POKE", "POKE"
        sig.minOps = 4: sig.maxOps = 4: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_VALUE: sig.roles(2) = MIR_OPR_VALUE: sig.roles(3) = MIR_OPR_CONST
        Return 1
    Case "MIR_MEMORY_COPY", "MIR_MEM_COPY", "MEMCOPY"
        sig.minOps = 5: sig.maxOps = 5: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_VALUE: sig.roles(2) = MIR_OPR_VALUE: sig.roles(3) = MIR_OPR_VALUE: sig.roles(4) = MIR_OPR_CONST
        Return 1
    Case "MIR_MEMORY_FILL", "MIR_MEM_FILL", "MEMFILL"
        sig.minOps = 5: sig.maxOps = 5: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_VALUE: sig.roles(2) = MIR_OPR_VALUE: sig.roles(3) = MIR_OPR_VALUE: sig.roles(4) = MIR_OPR_CONST
        Return 1
    Case "MIR_MEMORY_READ_SEQUENCE", "PEEKS"
        sig.minOps = 3: sig.maxOps = 3: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_VALUE: sig.roles(2) = MIR_OPR_VALUE
        Return 1
    Case "MIR_MEMORY_WRITE_SEQUENCE", "POKES"
        sig.minOps = 4: sig.maxOps = 4: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_VALUE: sig.roles(2) = MIR_OPR_VALUE: sig.roles(3) = MIR_OPR_VALUE
        Return 1
    Case "MIR_MEMORY_REF"
        sig.minOps = 4: sig.maxOps = 4: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_TYPE_NAME: sig.roles(1) = MIR_OPR_VAR: sig.roles(2) = MIR_OPR_CONST: sig.roles(3) = MIR_OPR_CONST
        Return 1
    Case "MIR_VIRTUAL_INIT"
        sig.minOps = 2: sig.maxOps = 2: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_CONST: sig.roles(1) = MIR_OPR_CONST
        Return 1
    Case "MIR_ARRAY_SIZEOF"
        sig.minOps = 3: sig.maxOps = 3: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_ARRAY_NAME: sig.roles(1) = MIR_OPR_CONST: sig.roles(2) = MIR_OPR_CONST
        Return 1
    ' S-101: LBOUND/UBOUND of an array whose bounds are only known at run time (REDIM'd 1-D array,
    ' array parameter): operands are (array name, dimension). Static bounds are folded to LOAD_CONST.
    Case "MIR_ARRAY_LBOUND", "MIR_ARRAY_UBOUND"
        sig.minOps = 2: sig.maxOps = 2: sig.resultRequired = 1
        sig.roles(0) = MIR_OPR_ARRAY_NAME: sig.roles(1) = MIR_OPR_CONST
        Return 1
    Case "MIR_DELETE_OBJECT", "DELETE_OBJECT"
        sig.minOps = 1: sig.maxOps = 1: sig.resultRequired = 0
        sig.roles(0) = MIR_OPR_OBJECT_NAME
        Return 1
    Case "CALL_DLL", "CALL_API"
        sig.minOps = 4: sig.maxOps = 16: sig.resultRequired = 0: sig.allowVariadic = 1
        sig.roles(0) = MIR_OPR_DLL_NAME: sig.roles(1) = MIR_OPR_API_NAME: sig.roles(2) = MIR_OPR_ABI: sig.roles(3) = MIR_OPR_SIGNATURE
        Return 1
    Case "RET", "RETURN"
        sig.minOps = 0: sig.maxOps = 1: sig.resultRequired = 0: sig.roles(0) = MIR_OPR_VALUE: Return 1
    Case "DIM", "REDIM", "CONST", "DEF_TYPE", "SETSTRINGSIZE", "LABEL", "NEW"
        sig.minOps = 0: sig.maxOps = 16: sig.resultRequired = 0: sig.allowVariadic = 1: Return 1
    End Select

    ' Fallback: registry knows opcode, but no strict operand contract yet.
    If UXBMIRStep4OpcodeKnown(op) <> 0 Then
        sig.minOps = 0: sig.maxOps = 16: sig.resultRequired = 0: sig.allowVariadic = 1
        Return 1
    End If

    Return 0
End Function

#endif
