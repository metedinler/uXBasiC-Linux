' uXBasic MIR model/opcode/declaration surface
#include once "../common/source_location.fbs"

Type MIRIRInstruction
    opcode As String  ' LOAD, STORE, ADD, SUB, MUL, DIV, CALL, JMP, JZ, JNZ, RET, etc.
    operands(0 To 15) As String  ' Operand listesi (variable names, constants, labels)
    operandCount As Integer
    result As String  ' Result variable name (for assignments)
    blockId As Integer  ' Which block this belongs to
    srcLoc As SourceLocation
    comment As String
    flags As Integer
    resultType As String
    ffiStubId As Integer
    ffiArgStart As Integer
    stmtSeq As Integer  ' S-146 Model D: ureten deyimin sira numarasi (senkron gecisi deyim sinirini buradan bilir)
    bareReturn As Integer  ' Source RETURN without expression: may resume this activation's GOSUB.
    tryTargetPlus1 As Integer  ' S-160: buyruk uretilirken etkin TRY'nin CATCH/FINALLY blogu + 1 (0 = TRY disi)
End Type

Type MIRBasicBlock
    id As Integer
    instructions(Any) As MIRIRInstruction
    instructionCount As Integer
    predecessors(Any) As Integer  ' Block IDs that can jump here
    predecessorCount As Integer
    successors(Any) As Integer  ' Block IDs this can jump to
    successorCount As Integer
    isEntry As Integer  ' 1 if this is entry block
    isExit As Integer   ' 1 if this is exit block
End Type

Type MIRFunction
    name As String
    blocks(Any) As MIRBasicBlock
    blockCount As Integer
    entryBlock As Integer
    localVars(Any) As String  ' Local variable names
    localVarTypes(Any) As String
    localVarCount As Integer
    paramVars(Any) As String  ' Parameter variable names
    paramVarTypes(Any) As String
    paramByRef(Any) As Integer  ' 1 = BYREF parameter (caller passes an address, not a value)
    paramVarCount As Integer
    returnType As String
    srcLoc As SourceLocation
End Type

Type MIRModule
    functions(Any) As MIRFunction
    functionCount As Integer
    globalVars(Any) As String
    globalVarTypes(Any) As String
    globalVarIsArray(Any) As Integer
    globalVarCount As Integer
    sourceFiles(Any) As String
    sourceFileCount As Integer
    vtableClassNames(Any) As String
    vtableClassSlotCounts(Any) As Integer
    vtableClassSlotStart(Any) As Integer
    vtableClassSizeBytes(Any) As Integer
    vtableClassBaseNames(Any) As String
    vtableClassCtorFunctionIndex(Any) As Integer
    vtableClassCtorParamCount(Any) As Integer
    vtableClassDtorFunctionIndex(Any) As Integer
    vtableClassCount As Integer

    vtableInterfaceNames(Any) As String
    vtableInterfaceMethodNames(Any) As String
    vtableInterfaceSlotBase As Integer
    vtableInterfaceSlotCount As Integer

    vtableEntryKeys(Any) As String
    vtableEntrySlots(Any) As Integer
    vtableEntryClassIndex(Any) As Integer
    vtableEntryFunctionIndex(Any) As Integer
    vtableEntryCount As Integer
End Type

Type MIRValue
    valueType As String  ' INTEGER, FLOAT, STRING, ARRAY, NULL
    intValue As LongInt
    floatValue As Double
    stringValue As String
    arrayId As Integer
    arrayLower As Integer
    arraySize As Integer
End Type

Type MIRArrayStorage
    lowerBound As Integer
    elementCount As Integer
    elements(Any) As MIRValue
End Type

Type MIRVarBinding
    nameText As String
    value As MIRValue
End Type

Declare Function MIRLoadLibraryA Lib "kernel32" Alias "LoadLibraryA" (ByVal lpLibFileName As ZString Ptr) As Any Ptr
Declare Function MIRGetProcAddress Lib "kernel32" Alias "GetProcAddress" (ByVal hModule As Any Ptr, ByVal lpProcName As ZString Ptr) As Any Ptr
Type MIRFnNoArgU64 As Function Cdecl () As ULongInt
Type MIRFnArg1U64 As Function Cdecl (ByVal a0 As ULongInt) As ULongInt
Type MIRFnArg2U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt) As ULongInt
Type MIRFnArg3U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt) As ULongInt
Type MIRFnArg4U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt) As ULongInt
Type MIRFnArg5U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt, ByVal a4 As ULongInt) As ULongInt
Type MIRFnArg6U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt, ByVal a4 As ULongInt, ByVal a5 As ULongInt) As ULongInt
Type MIRFnArg7U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt, ByVal a4 As ULongInt, ByVal a5 As ULongInt, ByVal a6 As ULongInt) As ULongInt
Type MIRFnArg8U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt, ByVal a4 As ULongInt, ByVal a5 As ULongInt, ByVal a6 As ULongInt, ByVal a7 As ULongInt) As ULongInt
' ABI10_MIR_CALL16_FFI10_FIX_20260706: MIR interpreter ABI10 integer/pointer calls need 9/10 Win64 slots.
Type MIRFnArg9U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt, ByVal a4 As ULongInt, ByVal a5 As ULongInt, ByVal a6 As ULongInt, ByVal a7 As ULongInt, ByVal a8 As ULongInt) As ULongInt
Type MIRFnArg10U64 As Function Cdecl (ByVal a0 As ULongInt, ByVal a1 As ULongInt, ByVal a2 As ULongInt, ByVal a3 As ULongInt, ByVal a4 As ULongInt, ByVal a5 As ULongInt, ByVal a6 As ULongInt, ByVal a7 As ULongInt, ByVal a8 As ULongInt, ByVal a9 As ULongInt) As ULongInt
Type MIRFnNoArgU32Cdecl As Function Cdecl () As UInteger
Type MIRFnArg1U32Cdecl As Function Cdecl (ByVal a0 As UInteger) As UInteger
Type MIRFnArg2U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger) As UInteger
Type MIRFnArg3U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger) As UInteger
Type MIRFnArg4U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger) As UInteger
Type MIRFnArg5U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger) As UInteger
Type MIRFnArg6U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger, ByVal a5 As UInteger) As UInteger
Type MIRFnArg7U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger, ByVal a5 As UInteger, ByVal a6 As UInteger) As UInteger
Type MIRFnArg8U32Cdecl As Function Cdecl (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger, ByVal a5 As UInteger, ByVal a6 As UInteger, ByVal a7 As UInteger) As UInteger
Type MIRFnNoArgU32StdCall As Function StdCall () As UInteger
Type MIRFnArg1U32StdCall As Function StdCall (ByVal a0 As UInteger) As UInteger
Type MIRFnArg2U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger) As UInteger
Type MIRFnArg3U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger) As UInteger
Type MIRFnArg4U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger) As UInteger
Type MIRFnArg5U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger) As UInteger
Type MIRFnArg6U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger, ByVal a5 As UInteger) As UInteger
Type MIRFnArg7U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger, ByVal a5 As UInteger, ByVal a6 As UInteger) As UInteger
Type MIRFnArg8U32StdCall As Function StdCall (ByVal a0 As UInteger, ByVal a1 As UInteger, ByVal a2 As UInteger, ByVal a3 As UInteger, ByVal a4 As UInteger, ByVal a5 As UInteger, ByVal a6 As UInteger, ByVal a7 As UInteger) As UInteger

Type MIREvaluatorState
    module As MIRModule
    currentFunction As Integer  ' Index in module.functions
    currentBlock As Integer     ' Index in function.blocks
    currentInstruction As Integer ' Index in block.instructions
    varValues(Any) As MIRVarBinding  ' Variable name -> value mapping
    varCount As Integer
    arrays(Any) As MIRArrayStorage
    arrayCount As Integer
    callStack(Any) As Integer   ' Function call stack (return addresses)
    callStackDepth As Integer
    exitRequested As Integer
End Type

Dim Shared gMirInstr As MIRIRInstruction

Dim Shared gMIRCurrentSource As SourceLocation
' S-146 Model D: her MIRLowerTopLevelStmt cagrisi yeni sira numarasi alir; ic deyimden donuste
' ust deyiminki geri yuklenir (dongu artirimi gibi ust deyim kodu ust deyimin numarasini tasir).
Dim Shared gMIRCurrentStmtSeq As Integer
Dim Shared gMIRStmtSeqCounter As Integer

Sub MIRSetCurrentSource(ByRef srcLoc As SourceLocation)
    gMIRCurrentSource = srcLoc
End Sub

Sub MIRSetCurrentSourceFromParts(ByVal filePathText As String, ByVal lineValue As Integer, ByVal colValue As Integer, ByVal lengthValue As Integer = 0, ByVal lexemeText As String = "", ByVal offsetValue As Integer = 0)
    gMIRCurrentSource = UXBSourceLocationMake(filePathText, lineValue, colValue, lengthValue, lexemeText, offsetValue)
End Sub

Function MIRGetSourceLine(ByRef inst As MIRIRInstruction) As String
    Return UXBSourceLocationLine(inst.srcLoc)
End Function

Function MIRInstructionHasSource(ByRef inst As MIRIRInstruction) As Integer
    Return UXBSourceLocationHasData(inst.srcLoc)
End Function

Dim Shared gMirLowerLoopType(Any) As String
Dim Shared gMirLowerLoopBreak(Any) As Integer
Dim Shared gMirLowerLoopContinue(Any) As Integer
Dim Shared gMirLowerLoopDepth As Integer

Dim Shared gMirLowerTryTarget(Any) As Integer
Dim Shared gMirLowerTryDepth As Integer

