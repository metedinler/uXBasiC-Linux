' Extracted tail of main program entry flow
If execMemMode Then
    UxbTraceBegin "EXECMEM", interpreterBackend
    UXBLayerEventBegin "INTERPRETER", sourcePath

    Dim runtimeServiceErr As String
    If UXBRuntimeServiceGateValidateAll(runtimeServiceErr) = 0 Then
        UXBLayerEventDiagnostic "INTERPRETER", "UXB_RUNTIME_SERVICE_SIGNATURE_MISMATCH", runtimeServiceErr
        UXBLayerEventEnd "INTERPRETER", "fail", runtimeServiceErr
        UxbError "Runtime service gate basarisiz: " & LocalizeErrorMessage(runtimeServiceErr)
        UxbTraceEnd "EXECMEM", "FAIL", runtimeServiceErr
        End 24
    End If

    Dim astRan As Integer
    Dim mirRan As Integer
    Dim astStatus As String
    Dim mirStatus As String
    Dim astOutput As String
    Dim mirOutput As String
    Dim astStdErr As String
    Dim mirStdErr As String
    Dim astResultType As String
    Dim mirResultType As String
    Dim astReturnText As String
    Dim mirReturnText As String
    Dim astErrText As String
    Dim mirErrText As String
    Dim astRuntimeCalls As Integer
    Dim mirRuntimeCalls As Integer
    astRuntimeCalls = 0
    mirRuntimeCalls = 0
    astRan = 0
    mirRan = 0
    astStatus = "SKIPPED"
    mirStatus = "SKIPPED"
    astOutput = ""
    mirOutput = ""
    astStdErr = ""
    mirStdErr = ""
    astResultType = ""
    mirResultType = ""
    astReturnText = ""
    mirReturnText = ""
    astErrText = ""
    mirErrText = ""

    If interpreterBackend = "AST" Or interpreterBackend = "BOTH" Then
        UXBLayerEventBegin "AST_INTERPRETER", sourcePath
        Dim astLiveJsonStart As String
        astLiveJsonStart = UXBInterpreterLiveJson("AST_INTERPRETER", sourcePath, "start", "RUNNING", "", "", "", "", "", 0, 0, 0, "")
        If UXBInterpreterWriteArtifact(outputContractPaths.astLiveJsonOutPath, astLiveJsonStart, outputContractErr) = 0 Then
            UxbError "AST live JSON yazilamadi: " & outputContractErr
            End 22
        End If
        UxbConsoleReset
        Dim execErr As String
        Dim execRunOk As Integer
        execRunOk = ExecRunMemoryProgram(ps, execErr)
        ' S-030 K5: okunmamis gorev hatasi sessiz kaybolmaz -- program basarili bitse de basarisiz sayilir.
        If execRunOk <> 0 Then
            If ExecTaskUnreadErrors(execErr) <> 0 Then execRunOk = 0
        End If
        If execRunOk = 0 Then
            astStatus = "FAIL"
            astErrText = execErr
            astStdErr = execErr
            UXBLayerEventDiagnostic "AST_INTERPRETER", "UXB_AST_INTERPRETER_FAILED", execErr
            UXBLayerEventEnd "AST_INTERPRETER", "fail", execErr
            ' Artifactlar yazilsin diye hata cikisi blok sonunda verilir.
        Else
            astStatus = "PASS"
            UXBLayerEventEnd "AST_INTERPRETER", "ok", "ast memory execution complete"
        End If
        astRan = 1
        astOutput = gUxbConsole.outputText
        astRuntimeCalls = 0
        astResultType = "AST_RUNTIME"
        astReturnText = astStatus
        UxbTraceMetric "EXECMEM", "ast_runtime", astStatus

        Dim astExecJson As String
        astExecJson = UXBInterpreterExecResultJson("AST_INTERPRETER", sourcePath, astStatus, astOutput, astStdErr, astOutput, astResultType, astReturnText, astRuntimeCalls, astErrText)
        If UXBInterpreterWriteArtifact(outputContractPaths.astExecResultJsonOutPath, astExecJson, outputContractErr) = 0 Then
            UxbError "AST interpreter JSON yazilamadi: " & outputContractErr
            End 22
        End If
        If UXBInterpreterWriteTextArtifact(outputContractPaths.astStdoutOutPath, astOutput, outputContractErr) = 0 Then
            UxbError "AST stdout yazilamadi: " & outputContractErr
            End 22
        End If
        If UXBInterpreterWriteTextArtifact(outputContractPaths.astStderrOutPath, astStdErr, outputContractErr) = 0 Then
            UxbError "AST stderr yazilamadi: " & outputContractErr
            End 22
        End If
        If UXBInterpreterWriteTextArtifact(outputContractPaths.astProgramOutputOutPath, astOutput, outputContractErr) = 0 Then
            UxbError "AST program_output yazilamadi: " & outputContractErr
            End 22
        End If
        ' ABI10_GENERIC_EXEC_OUTPUT_FIX_20260711:
        ' Generic --stdout-out/--stderr-out/--program-output-out must also be
        ' fulfilled by execmem AST runs.  Some runners intentionally use the
        ' generic contract instead of --ast-stdout-out.
        If Trim(outputContractPaths.stdoutOutPath) <> "" Then
            If UXBInterpreterWriteTextArtifact(outputContractPaths.stdoutOutPath, astOutput, outputContractErr) = 0 Then
                UxbError "AST generic stdout yazilamadi: " & outputContractErr
                End 22
            End If
        End If
        If Trim(outputContractPaths.stderrOutPath) <> "" Then
            If UXBInterpreterWriteTextArtifact(outputContractPaths.stderrOutPath, astStdErr, outputContractErr) = 0 Then
                UxbError "AST generic stderr yazilamadi: " & outputContractErr
                End 22
            End If
        End If
        If Trim(programOutputOutPath) <> "" Then
            If UXBInterpreterWriteTextArtifact(programOutputOutPath, astOutput, outputContractErr) = 0 Then
                UxbError "AST generic program_output yazilamadi: " & outputContractErr
                End 22
            End If
        End If
        Dim astLiveJsonDone As String
        astLiveJsonDone = UXBInterpreterLiveJson("AST_INTERPRETER", sourcePath, "done", astStatus, astOutput, astStdErr, astOutput, astResultType, astReturnText, astRuntimeCalls, 1, 1, astErrText)
        If UXBInterpreterWriteArtifact(outputContractPaths.astLiveJsonOutPath, astLiveJsonDone, outputContractErr) = 0 Then
            UxbError "AST live JSON yazilamadi: " & outputContractErr
            End 22
        End If
    End If

    If interpreterBackend = "MIR" Or interpreterBackend = "BOTH" Then
        UXBLayerEventBegin "MIR_INTERPRETER", sourcePath
        Dim mirLiveJsonStart As String
        mirLiveJsonStart = UXBInterpreterLiveJson("MIR_INTERPRETER", sourcePath, "start", "RUNNING", "", "", "", "", "", 0, 0, 0, "")
        If UXBInterpreterWriteArtifact(outputContractPaths.mirLiveJsonOutPath, mirLiveJsonStart, outputContractErr) = 0 Then
            UxbError "MIR live JSON yazilamadi: " & outputContractErr
            End 22
        End If
        Dim mirRunErr As String
        Dim mirResult As MIRValue

        If mirModuleReady = 0 Then
            mirStatus = "FAIL"
            mirErrText = "MIR backend secili ama MIR module hazirlanamadi"
            mirStdErr = mirErrText
            UXBLayerEventDiagnostic "MIR_INTERPRETER", "UXB_MIR_NOT_READY", mirErrText
            UXBLayerEventEnd "MIR_INTERPRETER", "fail", mirErrText
            ' Artifactlar yazilsin diye hata cikisi blok sonunda verilir.
        Else
            Dim canonicalRun As UXBSemanticToCanonicalMIRBridgeResult
            If UXBSemanticMIRToCanonicalMIR(mirModule, canonicalRun, mirRunErr, 1) = 0 Then
                mirStatus = "FAIL"
                mirErrText = mirRunErr
                mirStdErr = mirRunErr
                UXBLayerEventDiagnostic "MIR_INTERPRETER", "UXB_MIR_CANONICAL_BRIDGE_FAILED", mirRunErr
                UXBLayerEventEnd "MIR_INTERPRETER", "fail", mirRunErr
                ' Artifactlar yazilsin diye hata cikisi blok sonunda verilir.
            Else
                Dim mirInterpCtx As UXBInterpContext
                ' The run path never reads the per-instruction trace, but every trace
                ' event ReDim-Preserves an array of string-carrying records (O(n) per
                ' event): with it on, a 2000-iteration loop took ~50 s. Off here.
                UXBInterpContextInit mirInterpCtx, "native", 0
                ' S-074: a pure MIR run streams PRINT output as it happens (like the
                ' AST interpreter) instead of printing the collected text at the end.
                If interpreterBackend = "MIR" Then mirInterpCtx.runtime.liveEcho = 1
                Dim mirInterpResult As UXBInterpResult
                mirInterpResult = UXBMIRInterpRunInstructions(canonicalRun.instructions(), canonicalRun.instructionCount, mirInterpCtx, mirRunErr)
                If mirInterpResult.statusText <> "PASS" Then
                    mirStatus = "FAIL"
                    mirErrText = mirRunErr
                    If mirErrText = "" Then mirErrText = mirInterpResult.errorText
                    mirOutput = mirInterpResult.stdoutText
                    mirStdErr = mirInterpResult.stderrText
                    mirRuntimeCalls = mirInterpResult.runtimeServiceCalls
                    UXBLayerEventDiagnostic "MIR_INTERPRETER", "UXB_MIR_INTERPRETER_FAILED", mirErrText
                    UXBLayerEventEnd "MIR_INTERPRETER", "fail", mirErrText
                    ' Artifactlar yazilsin diye hata cikisi blok sonunda verilir.
                Else
                    mirStatus = "PASS"
                    mirOutput = mirInterpResult.stdoutText
                    mirStdErr = mirInterpResult.stderrText
                    mirRuntimeCalls = mirInterpResult.runtimeServiceCalls
                    mirResultType = mirInterpResult.returnValue.typeName
                    If Trim(mirResultType) = "" Then mirResultType = mirInterpResult.returnValue.kind
                    mirReturnText = UXBInterpValueToString(mirInterpResult.returnValue)
                    UXBLayerEventEnd "MIR_INTERPRETER", "ok", "mir state/dispatch execution complete"
                End If
            End If
        End If
        mirRan = 1
        UxbTraceMetric "EXECMEM", "mir_result_type", mirResultType

        Dim mirExecJson As String
        mirExecJson = UXBInterpreterExecResultJson("MIR_INTERPRETER", sourcePath, mirStatus, mirOutput, mirStdErr, mirOutput, mirResultType, mirReturnText, mirRuntimeCalls, mirErrText)
        If UXBInterpreterWriteArtifact(outputContractPaths.mirExecResultJsonOutPath, mirExecJson, outputContractErr) = 0 Then
            UxbError "MIR interpreter JSON yazilamadi: " & outputContractErr
            End 22
        End If
        If UXBInterpreterWriteTextArtifact(outputContractPaths.mirStdoutOutPath, mirOutput, outputContractErr) = 0 Then
            UxbError "MIR stdout yazilamadi: " & outputContractErr
            End 22
        End If
        If UXBInterpreterWriteTextArtifact(outputContractPaths.mirStderrOutPath, mirStdErr, outputContractErr) = 0 Then
            UxbError "MIR stderr yazilamadi: " & outputContractErr
            End 22
        End If
        If UXBInterpreterWriteTextArtifact(outputContractPaths.mirProgramOutputOutPath, mirOutput, outputContractErr) = 0 Then
            UxbError "MIR program_output yazilamadi: " & outputContractErr
            End 22
        End If
        ' ABI10_GENERIC_EXEC_OUTPUT_FIX_20260711:
        ' The MIR interpreter keeps stdout in UXBInterpResult instead of the
        ' global runtime console.  Mirror it to the generic output contract so
        ' --stdout-out/--program-output-out based smoke tests see PASS_ABI10.
        If Trim(outputContractPaths.stdoutOutPath) <> "" Then
            If UXBInterpreterWriteTextArtifact(outputContractPaths.stdoutOutPath, mirOutput, outputContractErr) = 0 Then
                UxbError "MIR generic stdout yazilamadi: " & outputContractErr
                End 22
            End If
        End If
        If Trim(outputContractPaths.stderrOutPath) <> "" Then
            If UXBInterpreterWriteTextArtifact(outputContractPaths.stderrOutPath, mirStdErr, outputContractErr) = 0 Then
                UxbError "MIR generic stderr yazilamadi: " & outputContractErr
                End 22
            End If
        End If
        If Trim(programOutputOutPath) <> "" Then
            If UXBInterpreterWriteTextArtifact(programOutputOutPath, mirOutput, outputContractErr) = 0 Then
                UxbError "MIR generic program_output yazilamadi: " & outputContractErr
                End 22
            End If
        End If
        Dim mirLiveJsonDone As String
        mirLiveJsonDone = UXBInterpreterLiveJson("MIR_INTERPRETER", sourcePath, "done", mirStatus, mirOutput, mirStdErr, mirOutput, mirResultType, mirReturnText, mirRuntimeCalls, 1, 1, mirErrText)
        If UXBInterpreterWriteArtifact(outputContractPaths.mirLiveJsonOutPath, mirLiveJsonDone, outputContractErr) = 0 Then
            UxbError "MIR live JSON yazilamadi: " & outputContractErr
            End 22
        End If
    End If

    If interpreterBackend = "BOTH" Then
        Dim compareJson As String
        compareJson = UXBInterpreterCompareJson(sourcePath, astStatus, mirStatus, astOutput, mirOutput, astResultType, mirResultType, astReturnText, mirReturnText)
        If UXBInterpreterWriteArtifact(outputContractPaths.interpreterCompareJsonOutPath, compareJson, outputContractErr) = 0 Then
            UxbError "Interpreter compare JSON yazilamadi: " & outputContractErr
            End 22
        End If
    End If

    Dim runtimeTraceJson As String
    Dim runtimeTracePath As String
    runtimeTracePath = outputContractPaths.artifactRoot & "/execution/runtime_trace.json"
    If Trim(outputContractPaths.runtimeTraceJsonOutPath) <> "" Then runtimeTracePath = outputContractPaths.runtimeTraceJsonOutPath
    runtimeTraceJson = UXBInterpreterRuntimeTraceJson(sourcePath, interpreterBackend, astRan, mirRan, astStatus, mirStatus)
    If UXBInterpreterWriteArtifact(runtimeTracePath, runtimeTraceJson, outputContractErr) = 0 Then
        UxbError "runtime_trace.json yazilamadi: " & outputContractErr
        End 22
    End If

    If interpreterBackend = "AST" And astStatus <> "PASS" Then
        UXBLayerEventEnd "INTERPRETER", "fail", astErrText
        UxbTraceEnd "EXECMEM", "FAIL", astErrText
        UxbError "AST interpreter basarisiz: " & LocalizeErrorMessage(astErrText)
        End 5
    End If

    If interpreterBackend = "MIR" And mirStatus <> "PASS" Then
        UXBLayerEventEnd "INTERPRETER", "fail", mirErrText
        UxbTraceEnd "EXECMEM", "FAIL", mirErrText
        ' S-074: the output printed before the error is already on screen (live
        ' echo above), exactly like the AST path.
        UxbError "MIR interpreter basarisiz: " & LocalizeErrorMessage(mirErrText)
        End 13
    End If

    If interpreterBackend = "BOTH" Then
        If astStatus <> "PASS" Or mirStatus <> "PASS" Then
            UXBLayerEventEnd "INTERPRETER", "fail", "AST/MIR interpreter comparison prerequisite failed"
            UxbTraceEnd "EXECMEM", "FAIL", "AST/MIR interpreter comparison prerequisite failed"
            UxbError "AST/MIR interpreter BOTH modu basarisiz: AST=" & astStatus & " MIR=" & mirStatus
            End 25
        End If
    End If


    Dim executionSuccessMessage As String
    executionSuccessMessage = UXBMessageText("UXB_EXECUTION_SUCCEEDED", "Bellek yurutme basarili", "Execution completed successfully")
    UxbInfo executionSuccessMessage
    UXBLayerEventEnd "INTERPRETER", "ok", "memory execution complete"
    UxbTraceEnd "EXECMEM", "OK", "memory execution complete"
End If

If interopMode Then
    UxbTraceBegin "INTEROP", "interop artifacts"
    UXBLayerEventBegin "IMPORT_RESOLVE", sourcePath
    Dim manifest As InteropManifest
    Dim interopErr As String

    If ResolveInteropManifestForSource(sourcePath, manifest, interopErr) = 0 Then
        UXBLayerEventDiagnostic "IMPORT_RESOLVE", "UXB_IMPORT_RESOLVE_FAILED", interopErr
        UXBLayerEventEnd "IMPORT_RESOLVE", "fail", interopErr
        UxbError "Baglanti cozumleme basarisiz: " & LocalizeErrorMessage(interopErr)
        End 3
    End If

    If EmitInteropArtifacts(manifest, outputContractPaths.buildRoot & "/interop/" & outputContractPaths.runId, interopErr) = 0 Then
        UXBLayerEventDiagnostic "IMPORT_RESOLVE", "UXB_IMPORT_ARTIFACT_FAILED", interopErr
        UXBLayerEventEnd "IMPORT_RESOLVE", "fail", interopErr
        UxbError "Baglanti cikti yazimi basarisiz: " & LocalizeErrorMessage(interopErr)
        End 4
    End If

    If FfiX64BackendEmitArtifacts(ps, outputContractPaths.buildRoot & "/interop/" & outputContractPaths.runId, interopErr) = 0 Then
        UXBLayerEventDiagnostic "FFI_EMIT", "UXB_FFI_X64_EMIT_FAILED", interopErr
        UXBLayerEventEnd "FFI_EMIT", "fail", interopErr
        UxbError "FFI x64 codegen cikti yazimi basarisiz: " & LocalizeErrorMessage(interopErr)
        End 4
    End If

    ' x86 backend retired: old x86 FFI artifact emitter is intentionally omitted here.
    ' The old x86 files live under src/retired/x86 and are not active build inputs.
    UxbTraceOutput "FFI_EMIT", "x86", "retired"

    If debugMode Then
        UxbInfo "Interop include sayisi: " & Str(manifest.includeCount)
        UxbInfo "Interop import sayisi: " & Str(manifest.importCount)
    End If
    UxbTraceOutput "INTEROP", "interop_dir", outputContractPaths.buildRoot & "/interop/" & outputContractPaths.runId
    UXBLayerEventEnd "IMPORT_RESOLVE", "ok", "interop artifacts emitted"
    UXBLayerEventEnd "FFI_EMIT", "ok", "interop backend artifacts emitted"
    UxbTraceEnd "INTEROP", "OK", "interop artifacts emitted"
End If

If x64EmitMode Then
    UxbTraceBegin "X64_EMIT", x64OutPath
    UXBLayerEventBegin IIf(x64PolicyId = UXB_X64_POLICY_MIR, "MIR_X64_CODEGEN", "X64_AST_CODEGEN"), x64OutPath
    Dim asmText As String
    Dim codegenErr As String

    If x64BothMode <> 0 Then
        UXBLayerEventBegin "X64_AST_CODEGEN", x64AstOutPath
        If GenerateX64Code(ps, asmText, codegenErr) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_EMIT_FAILED", codegenErr
            UXBLayerEventEnd "X64_AST_CODEGEN", "fail", codegenErr
            UxbError "x64 AST NASM codegen basarisiz: " & LocalizeErrorMessage(codegenErr)
            UxbTraceEnd "X64_EMIT", "FAIL", codegenErr
            End 6
        End If
        If SaveTextFile(x64AstOutPath, asmText) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_WRITE_FAILED", "write failed: " & x64AstOutPath
            UXBLayerEventEnd "X64_AST_CODEGEN", "fail", "write failed: " & x64AstOutPath
            UxbError "x64 AST NASM cikti dosyasi yazilamadi: " & x64AstOutPath
            UxbTraceEnd "X64_EMIT", "FAIL", "write failed: " & x64AstOutPath
            End 7
        End If
        Dim x64AstReportErr As String
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64AstReportJsonOutPath, "X64_AST", x64AstOutPath, "PASS", "", x64AstReportErr) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_REPORT_WRITE_FAILED", x64AstReportErr
            UxbError "x64 AST raporu yazilamadi: " & x64AstReportErr
            End 7
        End If

        If MIRX64EmitModule(mirModule, x64MirOutPath, codegenErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_EMIT_FAILED", codegenErr
            UXBLayerEventEnd "MIR_X64_CODEGEN", "fail", codegenErr
            UxbError "MIR x64 NASM codegen basarisiz: " & LocalizeErrorMessage(codegenErr)
            UxbTraceEnd "X64_EMIT", "FAIL", codegenErr
            End 6
        End If
        Dim x64MirReportErr As String
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64MirReportJsonOutPath, "X64_MIR", x64MirOutPath, "PASS", "", x64MirReportErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_REPORT_WRITE_FAILED", x64MirReportErr
            UxbError "x64 MIR raporu yazilamadi: " & x64MirReportErr
            End 7
        End If

        Dim x64CompareReportPath As String
        Dim x64CompareStatus As String
        Dim x64CompareErr As String
        x64CompareReportPath = outputContractPaths.artifactRoot & "/backend/x64_compare/report.json"
        UXBLayerEventBegin "X64_COMPARE", x64CompareReportPath
        If UXBX64CompareAsmFiles(x64AstOutPath, x64MirOutPath, x64CompareReportPath, x64CompareStatus, x64CompareErr) = 0 Then
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_AST_MIR_COMPARE_FAILED", x64CompareErr
            UXBLayerEventEnd "X64_COMPARE", "fail", x64CompareErr
            UxbError "x64 AST/MIR compare raporu yazilamadi: " & LocalizeErrorMessage(x64CompareErr)
            UxbTraceEnd "X64_EMIT", "FAIL", x64CompareErr
            End 26
        End If
        If x64CompareStatus <> "PASS" Then
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_AST_MIR_ASM_DIFF", x64CompareErr
        End If
        UxbTraceOutput "X64_EMIT", "x64_compare_report", x64CompareReportPath
        If x64CompareStatus = "PASS" Then
            UXBLayerEventEnd "X64_COMPARE", "ok", "AST/MIR asm exact match"
        Else
            UXBLayerEventEnd "X64_COMPARE", "warn", x64CompareErr
        End If

        UxbInfo "x64 AST NASM cikti yazildi: " & x64AstOutPath
        UxbInfo "x64 MIR NASM cikti yazildi: " & x64MirOutPath
        UxbTraceOutput "X64_EMIT", "x64_ast_asm", x64AstOutPath
        UxbTraceOutput "X64_EMIT", "x64_mir_asm", x64MirOutPath
        UXBLayerEventEnd "X64_AST_CODEGEN", "ok", "ast asm emitted"
        UXBLayerEventEnd "MIR_X64_CODEGEN", "ok", "mir asm emitted"
        UxbTraceEnd "X64_EMIT", "OK", "ast+mir asm emitted"
    Else
    ' Route emit-only NASM generation through the same direct path used by
    ' --codegen so emit/build stay on one proven code path.
    If codegenSourceMode = "MIR" Then
        If x64PolicyId = UXB_X64_POLICY_MIR Then
            UxbInfo "Codegen route: MIR verified -> MIR emitter"
        Else
            UxbInfo "Codegen route: MIR verified -> AST emitter"
        End If
    End If
    If x64PolicyId = UXB_X64_POLICY_MIR Then
        If MIRX64EmitModule(mirModule, x64OutPath, codegenErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_EMIT_FAILED", codegenErr
            UXBLayerEventEnd "MIR_X64_CODEGEN", "fail", codegenErr
            UxbError "MIR x64 NASM codegen basarisiz: " & LocalizeErrorMessage(codegenErr)
            UxbTraceEnd "X64_EMIT", "FAIL", codegenErr
            End 6
        End If
    Else
        If GenerateX64Code(ps, asmText, codegenErr) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_EMIT_FAILED", codegenErr
            UXBLayerEventEnd "X64_AST_CODEGEN", "fail", codegenErr
            UxbError "x64 NASM codegen basarisiz: " & LocalizeErrorMessage(codegenErr)
            UxbTraceEnd "X64_EMIT", "FAIL", codegenErr
            End 6
        End If

        If SaveTextFile(x64OutPath, asmText) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_WRITE_FAILED", "write failed: " & x64OutPath
            UXBLayerEventEnd "X64_AST_CODEGEN", "fail", "write failed: " & x64OutPath
            UxbError "x64 NASM cikti dosyasi yazilamadi: " & x64OutPath
            UxbTraceEnd "X64_EMIT", "FAIL", "write failed: " & x64OutPath
            End 7
        End If
    End If

    Dim x64SingleReportErr As String
    If x64PolicyId = UXB_X64_POLICY_MIR Then
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64MirReportJsonOutPath, "X64_MIR", x64OutPath, "PASS", "", x64SingleReportErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_REPORT_WRITE_FAILED", x64SingleReportErr
            UxbError "x64 MIR raporu yazilamadi: " & x64SingleReportErr
            End 7
        End If
    Else
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64AstReportJsonOutPath, "X64_AST", x64OutPath, "PASS", "", x64SingleReportErr) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_REPORT_WRITE_FAILED", x64SingleReportErr
            UxbError "x64 AST raporu yazilamadi: " & x64SingleReportErr
            End 7
        End If
    End If

    If debugMode Then
        UxbInfo "x64 NASM cikti yazildi: " & x64OutPath
    End If
    UxbTraceOutput "X64_EMIT", "asm", x64OutPath
    UXBLayerEventEnd IIf(x64PolicyId = UXB_X64_POLICY_MIR, "MIR_X64_CODEGEN", "X64_AST_CODEGEN"), "ok", "asm emitted"
    UxbTraceEnd "X64_EMIT", "OK", "asm emitted"
    End If
End If

If codegenMode Then
    UxbTraceBegin "X64_CODEGEN", x64OutPath
    UXBLayerEventBegin IIf(x64PolicyId = UXB_X64_POLICY_MIR, "MIR_X64_CODEGEN", "X64_AST_CODEGEN"), x64OutPath
    Dim codegenAsmText As String
    Dim codegenAsmErr As String

    If codegenSourceMode = "MIR" Then
        If x64PolicyId = UXB_X64_POLICY_MIR Then
            UxbInfo "Codegen route: MIR verified -> MIR emitter"
        Else
            UxbInfo "Codegen route: MIR verified -> AST emitter"
        End If
    End If
    If x64PolicyId = UXB_X64_POLICY_MIR Then
        If MIRX64EmitModule(mirModule, x64OutPath, codegenAsmErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_CODEGEN_FAILED", codegenAsmErr
            UXBLayerEventEnd "MIR_X64_CODEGEN", "fail", codegenAsmErr
            UxbError "MIR x64 codegen basarisiz: " & LocalizeErrorMessage(codegenAsmErr)
            UxbTraceEnd "X64_CODEGEN", "FAIL", codegenAsmErr
            End 6
        End If
    Else
        If GenerateX64Code(ps, codegenAsmText, codegenAsmErr) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_CODEGEN_FAILED", codegenAsmErr
            UXBLayerEventEnd "X64_AST_CODEGEN", "fail", codegenAsmErr
            UxbError "x64 codegen basarisiz: " & LocalizeErrorMessage(codegenAsmErr)
            UxbTraceEnd "X64_CODEGEN", "FAIL", codegenAsmErr
            End 6
        End If

        If SaveTextFile(x64OutPath, codegenAsmText) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_CODEGEN_WRITE_FAILED", "write failed: " & x64OutPath
            UXBLayerEventEnd "X64_AST_CODEGEN", "fail", "write failed: " & x64OutPath
            UxbError "x64 codegen cikti dosyasi yazilamadi: " & x64OutPath
            UxbTraceEnd "X64_CODEGEN", "FAIL", "write failed: " & x64OutPath
            End 7
        End If
    End If

    Dim x64CodegenReportErr As String
    If x64PolicyId = UXB_X64_POLICY_MIR Then
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64MirReportJsonOutPath, "X64_MIR", x64OutPath, "PASS", "", x64CodegenReportErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_REPORT_WRITE_FAILED", x64CodegenReportErr
            UxbError "x64 MIR raporu yazilamadi: " & x64CodegenReportErr
            End 7
        End If
    Else
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64AstReportJsonOutPath, "X64_AST", x64OutPath, "PASS", "", x64CodegenReportErr) = 0 Then
            UXBLayerEventDiagnostic "X64_AST_CODEGEN", "UXB_X64_AST_REPORT_WRITE_FAILED", x64CodegenReportErr
            UxbError "x64 AST raporu yazilamadi: " & x64CodegenReportErr
            End 7
        End If
    End If

    UxbInfo "x64 codegen cikti yazildi: " & x64OutPath
    UxbTraceOutput "X64_CODEGEN", "asm", x64OutPath
    UXBLayerEventEnd IIf(x64PolicyId = UXB_X64_POLICY_MIR, "MIR_X64_CODEGEN", "X64_AST_CODEGEN"), "ok", "codegen asm emitted"
    UxbTraceEnd "X64_CODEGEN", "OK", "codegen asm emitted"
End If

If x64BuildMode Then
    UxbTraceBegin "X64_BUILD", x64BuildOutPath
    UXBLayerEventBegin "X64_BUILD", x64BuildOutPath
    Dim x64BuildErr As String
    Dim x64BuildExternalMirOnly As Integer
    Dim x64BuildStatus As String
    Dim x64BuildDiagnostics As String
    x64BuildExternalMirOnly = 0
    x64BuildStatus = "PASS"
    x64BuildDiagnostics = ""

    If codegenSourceMode = "MIR" And x64PolicyId = UXB_X64_POLICY_MIR Then
        If MIRX64EmitModule(mirModule, x64MirOutPath, x64BuildErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_EMIT_FAILED", x64BuildErr
            UXBLayerEventEnd "X64_BUILD", "fail", x64BuildErr
            UxbError "MIR x64 NASM codegen basarisiz: " & LocalizeErrorMessage(x64BuildErr)
            UxbTraceEnd "X64_BUILD", "FAIL", x64BuildErr
            End 14
        End If

        Dim x64BuildMirAsmText As String
        If X64BuildLoadTextFile(x64MirOutPath, x64BuildMirAsmText, x64BuildErr) = 0 Then
            UXBLayerEventDiagnostic "X64_BUILD", "UXB_MIR_X64_ASM_READ_FAILED", x64BuildErr
            UXBLayerEventEnd "X64_BUILD", "fail", x64BuildErr
            UxbError "MIR x64 NASM cikti dosyasi okunamadi: " & LocalizeErrorMessage(x64BuildErr)
            UxbTraceEnd "X64_BUILD", "FAIL", x64BuildErr
            End 14
        End If
        If X64BuildRunArtifactsFromAsmNamed(ps, x64BuildSourcePath, x64BuildOutPath, x64BuildExeFileName, x64BuildMirAsmText, x64BuildErr) = 0 Then
            UXBLayerEventDiagnostic "X64_BUILD", "UXB_MIR_X64_BUILD_FAILED", x64BuildErr
            UXBLayerEventEnd "X64_BUILD", "fail", x64BuildErr
            UxbError "MIR x64 build basarisiz: " & LocalizeErrorMessage(x64BuildErr)
            UxbTraceEnd "X64_BUILD", "FAIL", x64BuildErr
            End 14
        End If
        Dim x64BuildMirReportErr As String
        If UXBX64WriteAsmRouteReport(outputContractPaths.x64MirReportJsonOutPath, "X64_MIR", x64BuildOutPath & "/program.asm", "PASS", "", x64BuildMirReportErr) = 0 Then
            UXBLayerEventDiagnostic "MIR_X64_CODEGEN", "UXB_MIR_X64_REPORT_WRITE_FAILED", x64BuildMirReportErr
            UxbError "x64 MIR raporu yazilamadi: " & x64BuildMirReportErr
            End 14
        End If
        UxbInfo "MIR x64 build tamamlandi: " & x64BuildExePath
    Else
        If codegenSourceMode = "MIR" Then UxbInfo "Build route: MIR verified -> AST emitter -> x64 pipeline"
        If X64BuildRunArtifactsNamed(ps, x64BuildSourcePath, x64BuildOutPath, x64BuildExeFileName, x64BuildErr) = 0 Then
            UXBLayerEventDiagnostic "X64_BUILD", "UXB_X64_BUILD_FAILED", x64BuildErr
            UXBLayerEventEnd "X64_BUILD", "fail", x64BuildErr
            UxbError "x64 build basarisiz: " & LocalizeErrorMessage(x64BuildErr)
            UxbTraceEnd "X64_BUILD", "FAIL", x64BuildErr
            End 14
        End If
        UxbInfo "x64 build tamamlandi: " & x64BuildExePath
    End If

    ' S-025: `bld --x64-mode BOTH` used to silently build only the MIR-x64 route
    ' (x64PolicyId is forced to MIR whenever BOTH is requested) and never attempt
    ' any comparison at all -- "BOTH" did not build both. This builds the second
    ' (AST-direct) route into its own directory and compares real, executed
    ' output against the primary MIR-x64 build already produced above. A
    ' mismatch is reported (not fatal to the build, matching the --emit-x64-nasm
    ' BOTH precedent below) so the user still gets their exe either way.
    If x64BothMode <> 0 Then
        UXBLayerEventBegin "X64_COMPARE", x64BuildOutPath & "\both_compare"
        Dim x64BothMirAsmText As String
        Dim x64BothAstAsmText As String
        Dim x64BothErr As String

        If X64BuildLoadTextFile(x64MirOutPath, x64BothMirAsmText, x64BothErr) = 0 Then
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_BOTH_MIR_ASM_READ_FAILED", x64BothErr
            UXBLayerEventEnd "X64_COMPARE", "fail", x64BothErr
            UxbError "x64 BOTH: MIR NASM ciktisi okunamadi: " & LocalizeErrorMessage(x64BothErr)
            End 14
        End If
        If GenerateX64Code(ps, x64BothAstAsmText, x64BothErr) = 0 Then
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_BOTH_AST_EMIT_FAILED", x64BothErr
            UXBLayerEventEnd "X64_COMPARE", "fail", x64BothErr
            UxbError "x64 BOTH: AST NASM codegen basarisiz: " & LocalizeErrorMessage(x64BothErr)
            End 14
        End If
        If SaveTextFile(x64AstOutPath, x64BothAstAsmText) = 0 Then
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_BOTH_AST_WRITE_FAILED", "write failed: " & x64AstOutPath
            UXBLayerEventEnd "X64_COMPARE", "fail", "write failed: " & x64AstOutPath
            UxbError "x64 BOTH: AST NASM ciktisi yazilamadi: " & x64AstOutPath
            End 14
        End If

        Dim x64BothCompareStatus As String
        Dim x64BothReportPath As String
        x64BothReportPath = outputContractPaths.artifactRoot & "/backend/x64_compare/real_execution_report.json"
        Dim x64BothCompareOk As Integer
        x64BothCompareOk = UXBX64CompareRealExecution(ps, x64BuildSourcePath, x64AstOutPath, x64BothAstAsmText, x64MirOutPath, x64BothMirAsmText, x64BuildOutPath & "\both_compare", x64BothReportPath, x64BothCompareStatus, x64BothErr)
        If x64BothCompareOk = 0 And x64BothCompareStatus = "ERROR" Then
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_BOTH_COMPARE_ERROR", x64BothErr
            UXBLayerEventEnd "X64_COMPARE", "fail", x64BothErr
            UxbError "x64 BOTH karsilastirma raporu yazilamadi: " & LocalizeErrorMessage(x64BothErr)
            End 26
        End If
        UxbTraceOutput "X64_BUILD", "x64_both_compare_report", x64BothReportPath
        If x64BothCompareStatus = "PASS" Then
            UxbInfo "x64 BOTH: AST ve MIR rotalari gercekten calistirildi, cikti birebir eslesti"
            UXBLayerEventEnd "X64_COMPARE", "ok", "AST/MIR real execution match"
        Else
            UxbInfo "UYARI: x64 BOTH: AST/MIR calisma zamani ciktisi farkli veya biri basarisiz oldu - detay: " & x64BothReportPath
            UXBLayerEventDiagnostic "X64_COMPARE", "UXB_X64_BOTH_EXECUTION_DIFF", x64BothErr
            UXBLayerEventEnd "X64_COMPARE", "warn", x64BothErr
        End If
    End If

    Dim x64BuildManifestPath As String
    Dim x64BuildManifestErr As String
    Dim x64ExeManifest As UXBExeArtifactManifest
    UXBExeArtifactManifestInit x64ExeManifest
    x64ExeManifest.sourceFile = x64BuildSourcePath
    x64ExeManifest.asmPath = x64BuildOutPath & "/program.asm"
    x64ExeManifest.objPath = x64BuildOutPath & "/obj/program.obj"
    x64ExeManifest.exePath = x64BuildExePath
    x64ExeManifest.nasmCommand = "%UXB_ASM_CMD% -f win64 program.asm -o obj/program.obj"
    x64ExeManifest.freebasicCommand = "%UXB_LINK_CMD% @program_link_args.rsp -o " & x64BuildExeFileName
    x64ExeManifest.linkScriptPath = x64BuildOutPath & "/link_program.bat"
    x64ExeManifest.linkRspPath = x64BuildOutPath & "/program_link_args.rsp"
    x64ExeManifest.buildProgramScriptPath = x64BuildOutPath & "/build_program.bat"
    x64ExeManifest.buildAllScriptPath = x64BuildOutPath & "/build_all.bat"
    x64ExeManifest.target = "X64"
    If codegenSourceMode = "MIR" And x64PolicyId = UXB_X64_POLICY_MIR Then
        x64ExeManifest.backendRoute = "MIR_X64_BUILD"
    ElseIf codegenSourceMode = "MIR" Then
        x64ExeManifest.backendRoute = "MIR_VERIFIED_TO_X64_AST_BUILD"
    Else
        x64ExeManifest.backendRoute = "X64_AST_BUILD"
    End If
    x64ExeManifest.status = x64BuildStatus
    x64ExeManifest.diagnostics = x64BuildDiagnostics
    x64BuildManifestPath = outputContractPaths.artifactRoot & "/backend/x64/exe_artifact_manifest.json"
    If UXBWriteExeArtifactManifest(x64BuildManifestPath, outputContractPaths.runId, sourceText, x64ExeManifest, x64BuildManifestErr) = 0 Then
        UXBLayerEventDiagnostic "X64_BUILD", "UXB_X64_BUILD_MANIFEST_WRITE_FAILED", x64BuildManifestErr
        UxbError "x64 exe artifact manifest yazilamadi: " & x64BuildManifestErr
        End 14
    End If
    UxbTraceOutput "X64_BUILD", "exe_artifact_manifest", x64BuildManifestPath
    UxbTraceOutput "X64_BUILD", "exe", x64BuildExePath
    UXBLayerEventEnd "X64_BUILD", "ok", "x64 build complete"
    UxbTraceEnd "X64_BUILD", "OK", "x64 build complete"
End If

If x64EmitMode <> 0 Or codegenMode <> 0 Or x64BuildMode <> 0 Then
    Dim x64BackendResult As UXBBackendResult
    x64BackendResult = UXBBackendResultMake(UXB_TARGET_X64)
    If x64BuildMode <> 0 Then
        UXBBackendResultPass x64BackendResult, x64BuildExePath, "x64 executable built and verified"
        x64BackendResult.auxPath = x64BuildOutPath & "/program.asm"
    Else
        UXBBackendResultPass x64BackendResult, x64OutPath, "x64 NASM emitted"
    End If
    If UXBOutputContractAfterBackend(outputContractPaths, UXBBackendResultToJson(x64BackendResult), outputContractErr) = 0 Then
        UxbError outputContractErr
        End 22
    End If
End If

Dim As String selected
Dim As Integer n
n = LegacyGetCommands(sourceText, 0, selected)
If debugMode Then
    UxbInfo "Legacy ayrim sayisi: " & Str(n)
    UxbInfo "Legacy parcasi[0]: " & selected
End If

If Trim(runReportJsonOutPath) <> "" Or Trim(artifactReportJsonOutPath) <> "" Then
    Dim runReportJson As String
    runReportJson = BuildRunReportJson( _
        sourcePath, _
        runSemanticPass, _
        mirModuleReady, _
        interpreterBackend, _
        execMemMode, _
        interopMode, _
        x64EmitMode, _
        codegenMode, _
        x64BuildMode, _
        codegenSourceMode, _
        astJsonOutPath, _
        inventoryJsonOutPath, _
        pipelineJsonOutPath, _
        mirOpcodesJsonOutPath, _
        x64OutPath, _
        x64BuildOutPath, _
        x64CodegenPolicy, _
        "uxb.run_report.v1" _
    )

    If Trim(runReportJsonOutPath) <> "" Then
        UxbTraceBegin "RUN_REPORT", runReportJsonOutPath
        If SaveTextFile(runReportJsonOutPath, runReportJson) = 0 Then
            UxbError "Calisma raporu JSON yazilamadi: " & runReportJsonOutPath
            UxbTraceEnd "RUN_REPORT", "FAIL", "write failed: " & runReportJsonOutPath
            End 15
        End If
        UxbTraceOutput "RUN_REPORT", "run_report", runReportJsonOutPath
        UxbTraceEnd "RUN_REPORT", "OK", "run report json written"
    End If

    If Trim(artifactReportJsonOutPath) <> "" Then
        Dim artifactReportJson As String
        artifactReportJson = BuildRunReportJson( _
            sourcePath, _
            runSemanticPass, _
            mirModuleReady, _
            interpreterBackend, _
            execMemMode, _
            interopMode, _
            x64EmitMode, _
            codegenMode, _
            x64BuildMode, _
            codegenSourceMode, _
            astJsonOutPath, _
            inventoryJsonOutPath, _
            pipelineJsonOutPath, _
            mirOpcodesJsonOutPath, _
            x64OutPath, _
            x64BuildOutPath, _
            x64CodegenPolicy, _
            "uxb.artifact_report.v1" _
        )
        UxbTraceBegin "ARTIFACT_REPORT", artifactReportJsonOutPath
        If SaveTextFile(artifactReportJsonOutPath, artifactReportJson) = 0 Then
            UxbError "Artifact raporu JSON yazilamadi: " & artifactReportJsonOutPath
            UxbTraceEnd "ARTIFACT_REPORT", "FAIL", "write failed: " & artifactReportJsonOutPath
            End 15
        End If
        UxbTraceOutput "ARTIFACT_REPORT", "artifact_report", artifactReportJsonOutPath
        UxbTraceEnd "ARTIFACT_REPORT", "OK", "artifact report json written"
    End If
End If

Dim consoleFlushErr As String
' MIR output artifacts are written from the interpreter result above. Flushing
' the unused AST console here would truncate those files to zero bytes.
If execMemMode = 0 Or UCase(Trim(interpreterBackend)) = "AST" Then
    If UxbConsoleFlushOutputs(consoleFlushErr) = 0 Then
        UxbError consoleFlushErr
        End 16
    End If
End If

Dim finalSourceMap As UXBSourceMapList
UXBSourceMapInit finalSourceMap
Dim finalAdim16 As UXBAdim16GateResult
Dim finalAdim16Err As String
If UXBAdim16RunDiagnosticsGate(frontendDiagnostics, finalSourceMap, finalAdim16) = 0 Then
    UXBAdim16WriteGateReports finalAdim16, outputContractPaths.artifactRoot & "/reports/adim16_diagnostics_gate.json", outputContractPaths.artifactRoot & "/reports/adim16_diagnostics_gate.md", finalAdim16Err
    UxbError "ADIM16 diagnostics/source mapping gate basarisiz: " & finalAdim16.errorsText
    End 28
End If
If UXBAdim16WriteGateReports(finalAdim16, outputContractPaths.artifactRoot & "/reports/adim16_diagnostics_gate.json", outputContractPaths.artifactRoot & "/reports/adim16_diagnostics_gate.md", finalAdim16Err) = 0 Then
    UxbError "ADIM16 gate raporu yazilamadi: " & finalAdim16Err
    End 28
End If

UxbTraceFinish 0
End 0
