
' ADIM41 main CLI bridge snippet
' Include önerisi:
'   #include once "cli/cli_registry_adim41.fbs"
'   #include once "cli/cli_output_contract_adim41.fbs"
'
' main.bas / main_program_entry.fbs içinde argüman normalize aşamasında çağrılmalıdır.

Function UXBNormalizeCliArgAdim41(ByRef argText As String, ByRef normalizedOut As String, ByRef errText As String) As Integer
    normalizedOut = argText
    errText = ""

    Dim optionKey As String
    Dim inlineSuffix As String
    Dim eqPos As Integer
    optionKey = argText
    inlineSuffix = ""
    eqPos = InStr(argText, "=")
    If eqPos > 0 Then
        optionKey = Left(argText, eqPos - 1)
        inlineSuffix = Mid(argText, eqPos)
    End If

    ' Removed selector aliases must not become ignored positional arguments.
    Select Case LCase(optionKey)
    Case "b28", "b30", "-b28", "-b30"
        errText = "Preprocessor selector CLI option removed: " & argText
        Return 0
    End Select

    Dim canonical As String
    If UXBCliRemovedTurkishAliasAdim41(optionKey, canonical) <> 0 Then
        errText = "Turkce CLI alias kaldirildi: " & argText & ". Kullan: " & canonical
        Return 0
    End If

    If Left(optionKey, 2) = "--" Then
        ' YAMA 1.1 FIX: --out-root yeni kanonik cikti kokudur.
        ' Registry eski kalirsa bile CLI kapisinda reddedilmemelidir.
        If LCase(Trim(optionKey)) = "--out-root" Then
            normalizedOut = optionKey & inlineSuffix
            Return 1
        End If
        If UXBCliLongKnownAdim41(optionKey) = 0 Then
            errText = "Bilinmeyen CLI secenegi: " & argText
            Return 0
        End If
        normalizedOut = optionKey & inlineSuffix
        Return 1
    End If

    ' 3 harfli komut formu: uxb tjs main.uxb --out out/tokens.json
    If Len(argText) = 3 Then
        Dim longName As String
        longName = UXBCliShortToLongAdim41(argText)
        If longName <> "" Then
            normalizedOut = longName
            Return 1
        End If
    End If

    Return 1
End Function
