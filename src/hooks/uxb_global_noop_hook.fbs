#ifndef __UXB_HOOK_GLOBAL_NOOP__
#define __UXB_HOOK_GLOBAL_NOOP__

Const UXB_HOOK_ENABLED As Integer = 0
Const UXB_HOOK_TRACE_ENABLED As Integer = 0

Private Sub UxbHookNoop(ByRef msgText As String)
    ' Intentionally no-op; reserved for future tracing.
End Sub

#macro UXB_HOOK_TRACE(MSG)
    If UXB_HOOK_TRACE_ENABLED <> 0 Then
        Dim __uxb_hook_msg As String
        __uxb_hook_msg = MSG
        UxbHookNoop(__uxb_hook_msg)
    End If
#endmacro

#endif

